{:kotoba.lang.product-defaults/schema :kotoba.lang.product-defaults/v1
 :kotoba.lang.product-defaults/authority "kotoba-lang/kotoba-lang"
 :as-of "2026-08-30"
 :rule
 {:default-means "The boundary is active without an opt-in compatibility mode."
  :ready-means "A bounded path is implemented and named; unsupported surfaces fail closed."
  :direction-means "An engineering target with published gates, not a universal present-tense claim."
  :no-absolute-claims #{:unlimited-physical-storage :zero-copies-everywhere
                        :universal-speed-rank :agi-achieved :unhackable}}
 :claims
 [{:id :build-run-security
   :status :direction-measured
   :headline "Build faster. Run faster. Keep the boundary."
   :body "Kotoba publishes compiler-startup, developer-loop, native-runtime, and workload-domain measurements with exact-result checks. Current speed ranks remain withheld until their quiet-host gates pass; security admission is never removed to win a timing."
   :evidence ["bench/public-compile-comparison/latest.json"
              "bench/public-runtime-comparison/latest.json"
              "bench/public-end-to-end-comparison/latest.json"
              "bench/public-domain-comparison/latest.json"]}
  {:id :storage
   :status :ready-bounded
   :headline "Storage without a language ceiling."
   :body "Kotobase uses content identity, range reads, immutable history, and provider-neutral storage. Physical capacity, tenancy, retention, cost, replication, and execution budgets remain explicit; this is not an infinite-disk claim."
   :evidence ["https://github.com/kotoba-lang/kotobase"
              "https://github.com/net-kotobase/lake"]}
  {:id :post-quantum
   :status :default
   :headline "Post-quantum cryptography by default."
   :body "Every new Kotoba cryptographic boundary must name ML-KEM or ML-DSA evidence and reject a classical-only downgrade. Existing Passkeys, transport, implementations, and key custody remain separately qualified boundaries."
   :evidence ["security/cryptographic-boundaries.edn"]}
  {:id :auth
   :status :default
   :headline "Authentication present. Authority denied by default."
   :body "Passkey identity belongs at the control boundary. A verified identity still receives no filesystem, network, storage, model, secret, payment, or GPU authority until an explicit scoped grant survives local policy and host checks."
   :evidence ["lang/safety-claims.edn" "lang/capability-semantics.edn"]}
  {:id :delegation
   :status :ready-bounded
   :headline "Flexible delegation that can only narrow."
   :body "Requested, delegated, local-policy, resource, and target scopes intersect. Delegation can be composed and attenuated, but cannot mint ambient authority or widen its issuer's grant."
   :evidence ["lang/capability-semantics.edn" "lang/elaboration-pipeline.edn"]}
  {:id :web3
   :status :ready-bounded
   :headline "Web3 ready, chain-neutral at the root."
   :body "A stable Kotoba Principal and Passkey controller are primary. CAIP-10 accounts, ERC-1271, and ERC-6492 are explicit linked-account proofs; a wallet address never silently becomes storage or execution authority."
   :evidence ["README.md#web3-first-identity"]}
  {:id :zero-copy
   :status :implemented-partial
   :headline "Zero-copy where ownership permits; one copy where a boundary requires it."
   :body "Columnar byte views retain vector, direct ByteBuffer, and Uint8Array backing. Arrow projection can keep uncompressed buffers columnar through the authorized Kotobase lake path. Network ingress, decompression, GPU upload, and immutable persistent updates remain named copy boundaries."
   :evidence ["https://github.com/kotoba-lang/columnar/pull/2"
              "https://github.com/kotoba-lang/org-apache-arrow/pull/1"
              "https://github.com/net-kotobase/lake/pull/3"]}
  {:id :cpu-gpu
   :status :implemented-partial
   :headline "Arrow-shaped CPU data. Device-native GPU kernels."
   :body "An uncompressed, non-nullable Arrow float32 column now retains one ArrayBuffer through its borrowed Uint8Array and Float32Array CPU views, then crosses the GPU ownership boundary with one measured WebGPU upload. On Apple M4, Num executed the kernel on Metal and returned one four-byte scalar. Nullable columns, other Arrow dtypes, SIMD-codegen proof, unified-memory upload removal, and universal accelerator qualification remain pending."
   :evidence ["https://github.com/kotoba-lang/org-apache-arrow"
              "https://github.com/kotoba-lang/num/pull/24"]}
  {:id :ai-first
   :status :default
   :headline "AI first. Agent-safe by default."
   :body "Kotoba is designed for programs written or operated by AI agents and bots. The stronger the model, the more important explicit effects, finite resources, capability confinement, receipts, and host enforcement become."
   :evidence ["lang/surface-status.edn" "lang/safety-claims.edn"]}
  {:id :agi-ready
   :status :direction
   :headline "AGI-ready boundaries, not an AGI claim."
   :body "The architecture is intended to keep authority explicit as models become more capable. Kotoba does not claim that AGI exists here, that generated programs are trustworthy, or that confinement removes the compiler, runtime, provider, key-custody, and OS trusted computing base."
   :evidence ["lang/safety-claims.edn"]}]
 :implementation-boundaries
 {:amu
  {:landed ["copy-free native UTF-8 substring views"
            "copy-free vector append when the source slice ends at the arena top"
            "typed accelerator KIR with WGSL, CUDA C, and Metal emission"]
   :copies ["persistent dynamic f64 vector updates"
            "selected canonical ABI results across ownership boundaries"]}
  :kotobase
  {:landed ["range reads" "authorized borrowed Arrow buffers"]
   :copies ["network ingress" "decompression" "durable-provider writes"]}
  :gpu
  {:landed ["WGSL device kernels" "device-side full-softmax sampling"
            "bounded token-id readback"
            "Arrow float32 to Metal with one measured WebGPU upload"]
   :copies ["host-to-device upload unless unified memory is proven and qualified"]}}}
