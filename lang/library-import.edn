{:kotoba.library-import/version 1
 :authority "kotoba-lang/kotoba-lang"
 :portable-profile "lib/library-import/deps.edn"
 :source-catalog-owner "kotoba-lang/kotoba"
 :canonical-prefix "kotoba"
 :dns-authority? false
 :resolution {:names :exact-case-sensitive :aliases :explicit-one-hop
              :collisions :reject-whole-catalog :unknown :refuse
              :canonical-path "lib/<id>" :source-paths :relative-no-traversal
              :signed-lock-rewriting? false}
 :public-cli {:discover "kotoba library import <ID-or-alias>... [--json]"
              :execute "kotoba run <source.cljk> --runtime sci --library <ID-or-alias>... [--json]"
              :default-runtime :checked-kotoba
              :implicit-sci-fallback? false}
 :imports {:package-id :catalog-selection :source-api :declared-entry-namespaces
           :namespace-rewriting? false
           :example "--library kotoba-lang/coll selects kotoba.coll; require [kotoba.coll :as coll] or the retained [kotoba.lang.coll :as coll]"}
 :compatibility {:runtime :sci :reader :cljs :source-extensions [".cljk" ".cljc" ".cljs"]
                 :entry :declared-ns-function :arguments :edn
                 :host-authority :local-script :capability-sandbox? false
                 :kotoba-source? false :q9-native-qualified? false
                 :signed-release-admission? false
                 :policy-or-package-flags :refuse}
 :effects {:discover :local-source-metadata-read
           :execute :explicit-local-script-execution
           :network-discovery :none}}
