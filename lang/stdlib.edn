  :backends #{:compiler :kotoba-wasm :kotoba-cljs}
  :backend-evidence
  {:kotoba-wasm "lang/conformance/stdlib/basic.kotoba compiled to wasm32-kotoba-v1 and returned 9n (2026-09-01)"
   :compiler "kotoba.lang.stdlib-conformance-test executes the two modules on the KIR backend"
   :kotoba-cljs :not-measured}}
