{:kotoba.cli.adapter-matrix/version 1
 :kotoba.cli.adapter-matrix/wbs "T9.1"
 :kotoba.cli.adapter-matrix/note
 "Current native execution qualification for the 12 public commands. Historical
  hosted adapters are migration inputs, not fallback routes or proof. The
  contract describes the full command and option surface; request parsing,
  plans and individual lower-level native operations do not qualify a command."

 :hosts
 {:compiler-cli {:repo "kotoba-lang/amu"
                 :entry "bin/amu"
                 :invoke "selfhost-built native image"}
  :public-kotoba {:repo "kotoba-lang/kotoba"
                  :entry "bin/kotoba"
                  :note "The complete native public command dispatcher is pending"}
  :not-implemented {:note "No qualified native execution adapter"}}

 :commands
 {:id {:contract-tier :m2
       :adapters [{:host :not-implemented :status :contract-only
                   :gaps ["native enrollment ceremony and proof-bound controller result"]}]}
  :run {:contract-tier :m1
        :adapters [{:host :compiler-cli :status :partial
                    :implements ["execute a compiled native image"]
                    :gaps ["public source and expression dispatch" "argument and library imports"]}]}
  :compile {:contract-tier :m1
            :adapters [{:host :compiler-cli :status :partial
                        :implements ["native source compilation for admitted targets"]
                        :gaps ["public web/wasm command adapter" "project and package output semantics"]}]}
  :check {:contract-tier :m2
          :adapters [{:host :compiler-cli :status :partial
                      :implements ["native source and pinned project admission"]
                      :gaps ["public package, lock and CLI-contract modes"]}]}
  :graph {:contract-tier :m1
          :adapters [{:host :not-implemented :status :contract-only
                      :gaps ["native connect/query/transact/pull/status with bounded storage"]}]}
  :git {:contract-tier :m1
        :adapters [{:host :not-implemented :status :contract-only
                    :gaps ["native init/status/commit/sync provider and authority boundary"]}]}
  :rad {:contract-tier :m1
        :adapters [{:host :not-implemented :status :contract-only
                    :gaps ["native new/build/test/export project lifecycle"]}]}
  :build {:contract-tier :m2
          :adapters [{:host :compiler-cli :status :partial
                      :implements ["locked source graph compilation on the adopted core"]
                      :gaps ["native public project adapter" "all declared target artifacts"]}]}
  :test {:contract-tier :m2
         :adapters [{:host :not-implemented :status :contract-only
                     :gaps ["native public project test discovery, execution and result"]}]}
  :deploy {:contract-tier :m1
           :adapters [{:host :not-implemented :status :contract-only
                       :gaps ["native plan/apply/status/rollback and receipt authority"]}]}
  :library {:contract-tier :m2
            :adapters [{:host :compiler-cli :status :partial
                        :implements ["CID-pinned source block and lock replay"]
                        :gaps ["public import/inspect/publish execution and signed admission"]}]}
  :hinshitsu {:contract-tier :m1
              :adapters [{:host :not-implemented :status :contract-only
                          :gaps ["native evidence/gate/coverage/mokushi execution"]}]}}

 :native-controller {:roles [:amu-selfhost :kotoba-native]
                     :all-12-request-parse true
                     :all-12-command-execution-qualified false
                     :evidence "kotoba-lang/kotoba PR #761; native main CI 40069837809"
                     :note "The parser proves vocabulary and refusals; its result is a request."}}
