{:kotoba.cli.adapter-matrix/version 1
 :kotoba.cli.adapter-matrix/wbs "T9.1"
 :kotoba.cli.adapter-matrix/note
 "Maps lang/cli.edn public command ids to host adapters. Contract remains
  data-first; this matrix records implementation readiness (M1→M2) without
  inventing a second CLI surface."

 :hosts
 {:compiler-cli
  {:repo "kotoba-lang/amu"
   :entry "kotoba.compiler.cli/-main"
   :invoke "clojure -M:run <command> …"}
  :public-kotoba
  {:repo "kotoba-lang/kotoba"
   :entry "native/public CLI"
   :note "Release binary; may lag contract options"}
  :not-implemented
  {:note "Contract vocabulary only; no production adapter yet"}}

 :commands
 {:id
  {:contract-tier :m2
   :adapters [{:host :public-kotoba
               :status :implemented
               :implements ["chain-neutral principal id creation"
                            "Passkey/WebAuthn enrollment plan"
                            "explicit CAIP-10 smart-account links"
                            "compatibility did:pkh account aliases"]
               :note "No chain is implicit. Base exists only as eip155:8453. Passkey ceremony and ERC-1271/6492 proof occur at qualified relying services; neither authentication nor an account link grants a capability."}]}
  :run
  {:contract-tier :m1
   :adapters
   [{:host :compiler-cli
     :status :partial
     :implements ["run signed.kexe" "native execute path"]
     :gaps ["-e expr compile-and-run sugar as primary pure path"
            "source-path multi-root for pure .kotoba run without kexe"]}
    {:host :public-kotoba :status :partial :implements ["compile-and-run"]}]}
  :compile
  {:contract-tier :m1
   :adapters
   [{:host :compiler-cli
     :status :implemented
     :implements ["compile --target wasm|x86_64|…"]
     :gaps []}
    {:host :public-kotoba :status :implemented}]}
  :check
  {:contract-tier :m2
   :adapters
   [{:host :compiler-cli
     :status :implemented
     :implements ["check" "--profile pure-product" "--json" "human diagnostics"]
     :evidence "compiler#420 ADR 0170"
     :gaps ["contract :kind package/source modes beyond frontend admit"]}]}
  :graph
  {:contract-tier :m1
   :adapters [{:host :public-kotoba
               :status :implemented
               :implements ["graph connect/query/transact/pull/status over kgraph"]
               :note "--db remains a handle alias; the command id is graph, not datomic"}]}
  :git
  {:contract-tier :m1
   :adapters [{:host :not-implemented :status :contract-only
               :note "ops git kit is provider-side, not public CLI yet"}]}
  :rad
  {:contract-tier :m1
   :adapters [{:host :not-implemented :status :contract-only}]}
  :deploy
  {:contract-tier :m1
   :adapters [{:host :public-kotoba
               :status :implemented
               :implements ["deploy plan/apply/status/rollback"]
               :note "Local receipts at file:/path or named dirs. Compute reside is murakumo:<node> / fleet:<node> via injected process (clojure -M -m murakumo.core deploy). Not Deno Deploy or Cloudflare."}]}
  :hinshitsu
  {:contract-tier :m1
   :adapters [{:host :not-implemented :status :contract-only}]}}

 :compiler-extra
 {:test {:status :implemented :wbs "T9.3" :evidence "compiler#421"
         :invoke "clojure -M:run test <file.kotoba>"}
  :fuel-estimate {:status :implemented :wbs "T7.3" :evidence "compiler#419"
                  :invoke "clojure -M:fuel-estimate <file.kotoba>"}
  :security-packaging
  {:status :implemented
   :commands [:keygen :sign :verify-signed :receipt :coverage :package-aiueos-boot]
   :note "compiler CLI security/packaging surface; outside public 9-id contract"}}}
