(ns cloud-kotoba-dds.theme
  "The default design tokens and document defaults of a Kotoba app — ONE
   place, so kotoba.cloud, app.itonami.cloud and the next product resolve
   the same `--hig-*` to the same values and start from the same document
   (owner direction 2026-09-16: 「app.itonami.cloud の uiux, design token を
   cloud-kotoba-dds のデフォルトに」「kotoba.cloud の uiux を app.itonami.cloud
   の uiux token に合わせて」).

   Measured that day: app.itonami.cloud computed its `--hig-*` from the
   jp-go-dds bridge (DADS key blue #0017c1, DADS neutrals, Noto Sans JP,
   rem-calc spacing — the same values kotoba.cloud had) but DECLARED 117
   tokens where kotoba.cloud declared 71, because its legacy HIG layer still
   answered the 46 the bridge left out (text weight / family, display1-3,
   the six palette members). The bridge carries all of them now
   (jp-go-dds 9fd79a8, 128 entries), so `tokens` here IS the contract: a
   view written against any --hig-* renders the same on every host.

   What this namespace owns:
     tokens      the contract, as data (jp-go-dds.tokens/hig->dads)
     chrome-css  the document defaults the bots app set by hand: box-sizing,
                 body on the grouped background in --hig-font-text, the
                 focus ring in --hig-color-tint, form controls inheriting
     css         everything this library ships at the token level and the
                 app-shell level, in cascade order: skin (bridge + a11y) →
                 the --ck-* layer (cloud-kotoba-dds.tokens) → chrome →
                 behavior layer → shell / switch / menu / status / sheet /
                 code / console / catalog. Chat / bots / graph stay opt-in
                 (cloud-kotoba-dds.styles, graph-workbench) — they are
                 workspaces, not defaults.
     stylesheet  (stylesheet dds-css) → the ONE external stylesheet a host
                 serves: DADS vendored css + its dark mirror (jp-go-dds.dark,
                 the shinkansen theme contract's data-theme override) + css
     scripts     the files a host ships next to it, by name — script-src
                 'self' hosts cannot inline: shinkansen.js (the interaction
                 runtime: actions, theme/set, locale/set), behavior.js,
                 shell.js, switch.js; and theme.js for <head> (the stored
                 choice before paint)
     head        the <head> entries a shinkansen document starts with:
                 viewport meta, theme.js first, the stylesheet, the scripts
                 deferred

   Theme: light / dark / system is the shinkansen contract
   (shinkansen.theme: `data-theme` on <html>, absent = the OS decides).
   The default is `system` — app.itonami.cloud's `html{color-scheme:light}`
   was the legacy layer's, and the bots app on this library already
   follows the contract (cloud-itonami-app PR #362)."
  (:require [jp-go-dds.tokens :as tokens]
            [jp-go-dds.behavior :as behavior]
            [jp-go-dds.dark :as dark]
            [shinkansen.theme :as sk-theme]
            [shinkansen.viewport :as viewport]
            [shinkansen.interaction :as interaction]
            [cloud-kotoba-dds.tokens :as ck]
            [cloud-kotoba-dds.menu :as menu]
            [cloud-kotoba-dds.status :as status]
            [cloud-kotoba-dds.shell :as shell]
            [cloud-kotoba-dds.switch :as switch]
            [cloud-kotoba-dds.sheet :as sheet]
            [cloud-kotoba-dds.code :as code]
            [cloud-kotoba-dds.console :as console]
            [cloud-kotoba-dds.catalog :as catalog]))

(def tokens
  "The `--hig-*` contract every Kotoba app resolves — jp-go-dds's bridge.
   128 entries: colour, palette (16), text (11 styles × size / line-height /
   weight / family + display1-3), spacing, radius, font, motion, layers,
   breakpoints."
  tokens/hig->dads)

(def motion tokens/motion)
(def layers tokens/layers)
(def breakpoints tokens/breakpoints)

(def chrome-css
  "Document defaults, on the contract — what app.itonami.cloud's bots app
   set by hand (box-sizing, grouped background, focus ring) and every host
   re-derived. An app's own css comes after and may override any of it."
  (str
   "*,*::before,*::after{box-sizing:border-box}"
   "html{-webkit-text-size-adjust:100%}"
   "body{margin:0;background:var(--hig-color-system-grouped-background);color:var(--hig-color-label);font-family:var(--hig-font-text);font-size:var(--hig-text-body-font-size);line-height:var(--hig-text-body-line-height);overflow-x:hidden}"
   "button,input,select,textarea{font:inherit;color:inherit}"
   ":focus-visible{outline:2px solid var(--hig-color-tint);outline-offset:2px;border-radius:var(--hig-radius-xs)}"
   "@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}"))

(def css
  "The library's stylesheet at the token level and the app-shell level, in
   cascade order. Emit AFTER the DADS vendored css (and its dark mirror)."
  (str tokens/skin-css "\n"
       ck/css "\n"
       chrome-css "\n"
       behavior/css "\n"
       shell/css "\n"
       switch/css "\n"
       ;; the λ theme toggle's own mark (switch/lambda-toggle, 2026-09-16)
       switch/lambda-css "\n"
       menu/css "\n"
       status/css "\n"
       sheet/css "\n"
       code/css "\n"
       console/css "\n"
       catalog/css "\n"))

(defn stylesheet
  "The ONE external stylesheet a host serves (/css/site.css and the like):
   the DADS vendored css the host reads from its resources, the dark mirror
   over it, then `css`. Nothing product-specific; append the app's css."
  [dds-css]
  (str dds-css "\n" (dark/dark-css dds-css) "\n" css))

(def scripts
  "The files a host ships, by name — script-src 'self' hosts cannot inline.
   theme.js goes in <head> (blocking, before paint); the rest deferred."
  {"theme.js" sk-theme/head-script
   "shinkansen.js" interaction/runtime
   "behavior.js" behavior/script
   "shell.js" shell/script
   "switch.js" switch/script
   "menu.js" menu/script
   "status.js" status/script})

(def deferred-scripts
  "The order the deferred scripts load in — the interaction runtime first
   (switch.js hydrates through it), the behavior layer, then the shell."
  ["shinkansen.js" "behavior.js" "shell.js" "switch.js" "menu.js" "status.js"])

(defn head
  "<head> entries for a shinkansen document on this theme:
   `{:base \"/js/\" :stylesheet \"/css/site.css\"}` → the viewport meta,
   theme.js (blocking, the stored choice before paint), the stylesheet link,
   and the deferred scripts in `deferred-scripts` order. A host adds its
   title / description / canonical around these."
  [{:keys [base stylesheet] :or {base "/js/" stylesheet "/css/site.css"}}]
  (into [[:meta {:name "viewport" :content "width=device-width, initial-scale=1, viewport-fit=cover"}]
         [:meta {:name "color-scheme" :content "light dark"}]
         [:script {:src (str base "theme.js")}]
         [:link {:rel "stylesheet" :href stylesheet}]]
        (map (fn [f] [:script {:src (str base f) :defer true}]) deferred-scripts)))

(def viewport-meta viewport/viewport-meta)
