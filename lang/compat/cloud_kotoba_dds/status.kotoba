(ns cloud-kotoba-dds.status
  "The status line — what an app says after an action (「保存しました。」,
   「送信できませんでした。」) — as one component and one runtime.

   Measured 2026-09-16: cloud-itonami-app sets 85 status texts by writing
   `textContent` into a handful of `<p>` elements, each with its own class
   and its own idea of tone and lifetime. The shape is the same every time:
   a live region the assistive tech announces, a tone, and a message that
   either stays (a failure the person must act on) or goes (a confirmation).

     hiccup  (status/line {:id \"x\" :label \"操作の結果\"})
     runtime cloudKotobaStatus.say(el, text, {tone, ttl})
             tone: 'info' (default) | 'ok' | 'warn' | 'error'
             ttl:  ms until the line clears; default 6000 for ok/info,
                   0 (stays) for warn/error. say(el, '') clears.
             cloudKotobaStatus.clear(el)

   The element is `role=status aria-live=polite` and rendered EMPTY by the
   server (an empty status is `:empty` and takes no space): a status that
   is on the page at load is idle-pending theatre (shinkansen.audit
   :idle-pending). Styles read cloud-kotoba-dds.tokens."
  (:require [kotoba.lang.text :as str]))

(defn line
  "The live region. `:label` is its accessible name; `:attrs` merge on."
  [{:keys [id label attrs]}]
  [:p (merge {:class "ck-status" :role "status" :aria-live "polite"
              :data-ck-status "line" :aria-label label}
             (when id {:id id}) attrs)])

(def css
  (str
   ".ck-status{margin:0;min-height:0;color:var(--ck-text-muted);font-size:var(--hig-text-footnote-font-size);line-height:1.5;transition:opacity var(--ck-motion) ease}"
   ".ck-status:empty{display:none}"
   ".ck-status[data-tone=ok]{color:var(--ck-success)}"
   ".ck-status[data-tone=warn]{color:var(--ck-warning)}"
   ".ck-status[data-tone=error]{color:var(--ck-danger)}"))

(def script
  (str
   "(function(global){'use strict';var timers=new WeakMap();"
   "function clear(el){if(!el)return;var t=timers.get(el);if(t){clearTimeout(t);timers.delete(el);}el.textContent='';el.removeAttribute('data-tone');}"
   "function say(el,text,opts){if(!el)return;opts=opts||{};clear(el);text=text==null?'':String(text);if(!text)return;"
   "var tone=opts.tone||'info';el.dataset.tone=tone;el.textContent=text;"
   "var ttl=opts.ttl!=null?opts.ttl:((tone==='ok'||tone==='info')?6000:0);"
   "if(ttl>0){timers.set(el,setTimeout(function(){if(el.textContent===text)clear(el);},ttl));}}"
   "global.cloudKotobaStatus=Object.freeze({say:say,clear:clear});"
   "})(globalThis);"))
