(ns cloud-kotoba-dds.menu
  "Context / floating menu — the pattern every product wrote for itself
   (owner instruction 2026-09-16: 「interaction は共通コンポーネント化して」).

   Measured before: cloud-itonami-app's rail menu (interaction.js
   openBotsRailMenu, ~170 lines) built the list, drew each icon, positioned
   the menu at the pointer, clamped it to the viewport, and closed it on
   outside pointerdown / Escape / scroll — all product-neutral. What IS the
   product's — the items and what they do — stays with the host.

   Two entrances:

     hiccup  (menu/floating {:id … :label … :items […]}) — a server-rendered
             menu the host reveals; items name actions in the shinkansen
             vocabulary (data-action / data-params).
     runtime cloudKotobaMenu.open({items, at | anchor, label}) — a menu
             built from data at the pointer, for right-click / long-press.
             An item is {label, icon, danger, onSelect} or {label, icon,
             action, params} (dispatched through shinkansen) or 'separator'.
             Returns the menu element; cloudKotobaMenu.close() closes it.

   Both carry `data-chrome=\"float\"` (shinkansen.audit :chrome-layers),
   role=menu / menuitem, arrow-key and Home/End navigation, Escape and
   outside-pointerdown close, scroll close, and focus returned to the
   opener. Icons are 24×24 stroke paths (`icon` = the `d` attribute), the
   same shape the itonami rail menu drew. Styles read cloud-kotoba-dds.tokens."
  (:require [kotoba.lang.text :as str]
            [shinkansen.interaction :as interaction]))

(defn icon
  "A 24×24 stroke icon from a path `d`."
  [d]
  [:svg {:class "ck-menu__icon" :viewBox "0 0 24 24" :aria-hidden "true"}
   [:path {:d d :fill "none" :stroke "currentColor" :stroke-width "1.75"
           :stroke-linecap "round" :stroke-linejoin "round"}]])

(defn- item-node [{:keys [label icon-path action params danger? attrs href]}]
  (let [tag (if href :a :button)
        base (cond-> {:class (str "ck-menu__item" (when danger? " ck-menu__item--danger"))
                      :role "menuitem" :tabindex "-1"}
               (not href) (assoc :type "button")
               href (assoc :href href))]
    [:li {:role "none"}
     (into [tag (merge base (when action (interaction/action-attrs action params)) attrs)]
           (cond-> []
             icon-path (conj (icon icon-path))
             true (conj [:span label])))]))

(defn floating
  "A server-rendered floating menu, hidden until the host opens it
   (`cloudKotobaMenu.show(el, {at|anchor})`). `:items` are maps
   ({:label :icon-path :action :params :danger? :href :attrs}) or
   `:separator`."
  [{:keys [id label items attrs]}]
  (into [:ul (merge {:class "ck-menu" :role "menu" :aria-label label :hidden true
                     :data-chrome "float" :data-ck-menu "menu"}
                    (when id {:id id}) attrs)]
        (map (fn [it] (if (= it :separator)
                        [:li {:class "ck-menu__sep" :role "separator"}]
                        (item-node it)))
             items)))

(def css
  (str
   ".ck-menu{position:fixed;left:0;top:0;z-index:var(--ck-layer-float);min-width:16rem;max-width:min(22rem,calc(100vw - 1rem));margin:0;padding:var(--hig-spacing-1) 0;list-style:none;"
   "border:1px solid var(--ck-surface-border);border-radius:var(--ck-radius-md);background:var(--ck-surface-raised);color:var(--ck-text);box-shadow:var(--ck-shadow-float)}"
   ".ck-menu[hidden]{display:none}"
   ".ck-menu__item{display:flex;align-items:center;gap:var(--hig-spacing-3);width:100%;min-height:2.75rem;padding:var(--hig-spacing-2) var(--hig-spacing-4);border:0;background:transparent;color:inherit;font:inherit;text-align:start;text-decoration:none;cursor:pointer}"
   ".ck-menu__item:hover,.ck-menu__item:focus-visible{background:var(--ck-surface-hover);outline:none}"
   ".ck-menu__item--danger{color:var(--ck-danger)}"
   ".ck-menu__icon{width:1.25rem;height:1.25rem;flex:none}"
   ".ck-menu__sep{height:1px;margin:var(--hig-spacing-1) var(--hig-spacing-3);border:0;background:var(--ck-surface-border)}"))

(def script
  "The runtime: `globalThis.cloudKotobaMenu = {open, show, close}`.
     open({items, at:{x,y} | anchor:Element, label}) builds and shows
     show(el, {at | anchor})                          positions an existing menu
     close()                                          closes the open one
   Requires shinkansen.interaction/runtime for {action, params} items."
  (str
   "(function(global){'use strict';"
   "var current=null,opener=null;"
   "function el(tag,cls){var n=document.createElement(tag);if(cls)n.className=cls;return n;}"
   "function icon(d){var s=document.createElementNS('http://www.w3.org/2000/svg','svg');s.setAttribute('viewBox','0 0 24 24');s.setAttribute('aria-hidden','true');s.setAttribute('class','ck-menu__icon');"
   "var p=document.createElementNS('http://www.w3.org/2000/svg','path');p.setAttribute('d',d);p.setAttribute('fill','none');p.setAttribute('stroke','currentColor');p.setAttribute('stroke-width','1.75');p.setAttribute('stroke-linecap','round');p.setAttribute('stroke-linejoin','round');s.append(p);return s;}"
   "function items(menu){return Array.prototype.slice.call(menu.querySelectorAll('[role=menuitem]'));}"
   "function close(){if(!current)return;var m=current;current=null;m.hidden=true;if(m.dataset.ckMenuBuilt==='true')m.remove();if(opener&&opener.focus){try{opener.focus();}catch(e){}}opener=null;}"
   "function place(menu,opts){var x=8,y=8;if(opts&&opts.at){x=opts.at.x;y=opts.at.y;}else if(opts&&opts.anchor){var r=opts.anchor.getBoundingClientRect();x=r.left;y=r.bottom;}"
   "menu.hidden=false;var b=menu.getBoundingClientRect();"
   "menu.style.left=Math.min(Math.max(8,x),window.innerWidth-b.width-8)+'px';menu.style.top=Math.min(Math.max(8,y),window.innerHeight-b.height-8)+'px';}"
   "function show(menu,opts){close();opener=(opts&&opts.opener)||document.activeElement;current=menu;place(menu,opts);var first=items(menu)[0];if(first)first.focus();return menu;}"
   "function open(spec){var menu=el('ul','ck-menu');menu.setAttribute('role','menu');menu.setAttribute('data-chrome','float');menu.dataset.ckMenu='menu';menu.dataset.ckMenuBuilt='true';if(spec.label)menu.setAttribute('aria-label',spec.label);"
   "(spec.items||[]).forEach(function(it){if(it==='separator'||it===':separator'){var s=el('li','ck-menu__sep');s.setAttribute('role','separator');menu.append(s);return;}"
   "var li=el('li');li.setAttribute('role','none');var b=el(it.href?'a':'button','ck-menu__item'+(it.danger?' ck-menu__item--danger':''));"
   "if(it.href)b.setAttribute('href',it.href);else b.type='button';b.setAttribute('role','menuitem');b.tabIndex=-1;"
   "if(it.action){b.setAttribute('data-action',it.action);if(it.params)b.setAttribute('data-params',JSON.stringify(it.params));}"
   "if(it.icon)b.append(icon(it.icon));var t=el('span');t.textContent=it.label||'';b.append(t);"
   "if(it.onSelect)b.addEventListener('click',function(ev){ev.stopPropagation();close();Promise.resolve().then(function(){return it.onSelect(ev);}).catch(function(err){if(spec.onError)spec.onError(err);});});"
   "else b.addEventListener('click',function(){close();});"
   "li.append(b);menu.append(li);});"
   "document.body.append(menu);return show(menu,spec);}"
   "document.addEventListener('pointerdown',function(e){if(current&&!current.contains(e.target))close();});"
   ;; a chosen item closes the menu — after the shinkansen delegate (registered
   ;; earlier on the same document) has dispatched its action
   "document.addEventListener('click',function(e){if(!current)return;var it=e.target&&e.target.closest?e.target.closest('[role=menuitem]'):null;if(it&&current.contains(it))close();});"
   "document.addEventListener('keydown',function(e){if(!current)return;var list=items(current),i=list.indexOf(document.activeElement);"
   "if(e.key==='Escape'){e.preventDefault();close();}"
   "else if(e.key==='ArrowDown'){e.preventDefault();(list[(i+1)%list.length]||list[0]).focus();}"
   "else if(e.key==='ArrowUp'){e.preventDefault();(list[(i-1+list.length)%list.length]||list[list.length-1]).focus();}"
   "else if(e.key==='Home'){e.preventDefault();if(list[0])list[0].focus();}"
   "else if(e.key==='End'){e.preventDefault();if(list.length)list[list.length-1].focus();}});"
   "document.addEventListener('scroll',function(){close();},true);"
   "global.cloudKotobaMenu=Object.freeze({open:open,show:show,close:close});"
   "})(globalThis);"))
