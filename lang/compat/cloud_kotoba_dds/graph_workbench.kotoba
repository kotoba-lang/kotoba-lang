(ns cloud-kotoba-dds.graph-workbench
  "Shared GraphDB console extracted from net-kotobase/control-plane.
   Pure panel components plus a root-scoped browser controller. The host owns
   authentication, HTTP transport, billing, chrome and readiness claims."
  (:require [kotoba.lang.text :as str]
            [jp-go-dds.core :as dds]))

(def panels [{:id "overview" :label "概要"} {:id "graph" :label "ナレッジマップ"} {:id "ontology" :label "オントロジー"} {:id "datoms" :label "データム"} {:id "query" :label "クエリ"} {:id "pins" :label "Pins / CID"} {:id "keys" :label "Keys / 認可"} {:id "activity" :label "履歴"} {:id "plan" :label "設定"}])

(defn- t
  "Localized copy. :locale :en opts into the English text; anything else —
   including an absent :locale — keeps the Japanese source copy, so hosts that
   do not pass :locale render exactly what they rendered before."
  [options ja en]
  (if (= :en (:locale options)) en ja))

(def ^:private nav-labels-en
  "English nav labels for :locale :en. `panels` keeps its Japanese :label
   values for compatibility; view picks the label per locale."
  {"overview" "Overview"
   "graph" "Knowledge map"
   "ontology" "Ontology"
   "datoms" "Datoms"
   "query" "Query"
   "pins" "Pins / CID"
   "keys" "Keys & permissions"
   "activity" "Activity"
   "plan" "Settings"})

(def nsid-prefix
  "Must match kotobase.worker's own prefix; the console calls the same XRPC
  surface as any other client rather than a private admin API."
  "ai.gftd.apps.kotobase")

(def browser-source
  "Console wiring. DOM contract: every `data-field` is filled from the account
  status payload, `#audit-rows` / `#audit-more` are the audit table, and
  `#load-state` is the one place a failure becomes visible.
  Auth-gate: host.signInHref (default auth.kotoba.cloud return_to graph.kotoba.cloud),
  host.authGateState / setAuthGateState('not-signed-in'|'signed-in-empty'|null).
  Panel roots are `[data-panel][id]` so nested `[data-auth-gate][data-panel]` is not a route target."
  (str "
window.cloudKotobaGraph={mount:function(root,host){
  if(!root||!host||typeof host.request!=='function')throw new Error('Graph host request adapter required');
  var disposed=false, listeners=[], actualDocument=root.ownerDocument, actualWindow=actualDocument.defaultView;
  var signInHref=host.signInHref||'https://auth.kotoba.cloud/sign-in?return_to=https://graph.kotoba.cloud/';
  // Locale: the host wraps the workbench in a lang attribute (or the document
  // carries one). Absent or unknown defaults to Japanese; read once at mount.
  var mountLang=root.getAttribute('lang')||actualDocument.documentElement.lang||'';
  var isJa=!mountLang||mountLang.indexOf('ja')===0;
  function t(ja,en){return isJa?ja:en;}
  // Auth-gate states: not-signed-in | signed-in-empty only. Host owns session;
  // this helper paints [data-auth-gate] nodes and overview metric visibility.
  function setAuthGateState(state){
    var gates=root.querySelectorAll('[data-auth-gate]');
    var metrics=root.querySelectorAll('[data-overview-metrics]');
    var identity=root.querySelector('.kb-identity');
    var consoleEl=root.matches('.kb-console')?root:root.querySelector('.kb-console');
    if(state!=='not-signed-in'&&state!=='signed-in-empty'&&state!=null&&state!==''){
      throw new Error('auth-gate state must be not-signed-in or signed-in-empty');
    }
    if(consoleEl){
      if(state)consoleEl.setAttribute('data-auth',state); else consoleEl.removeAttribute('data-auth');
    }
    for(var i=0;i<gates.length;i++){
      var g=gates[i];
      if(!state){g.hidden=true;continue;}
      g.hidden=false;g.setAttribute('data-state',state);
      var primary=g.querySelector('[data-auth-gate-primary]');
      if(primary){
        if(state==='not-signed-in'){
          if(primary.tagName==='A')primary.setAttribute('href',signInHref);
        }else if(primary.tagName==='A'){
          // signed-in-empty must never keep a sign-in href on primary
          var href=primary.getAttribute('href')||'';
          if(href.indexOf('auth.kotoba.cloud/sign-in')!==-1||href===signInHref)primary.removeAttribute('href');
        }
      }
    }
    var hideMetrics=(state==='not-signed-in');
    for(var m=0;m<metrics.length;m++){
      metrics[m].setAttribute('aria-hidden',hideMetrics?'true':'false');
      if(hideMetrics)metrics[m].setAttribute('hidden',''); else metrics[m].removeAttribute('hidden');
    }
    if(identity){
      identity.setAttribute('aria-hidden',hideMetrics?'true':'false');
      if(hideMetrics)identity.setAttribute('hidden',''); else identity.removeAttribute('hidden');
    }
  }
  setAuthGateState(Object.prototype.hasOwnProperty.call(host,'authGateState')?host.authGateState:'not-signed-in');
  function listen(target,event,fn){target.addEventListener(event,fn);listeners.push([target,event,fn]);}
  var document={getElementById:function(id){return root.querySelector('[id='+JSON.stringify(id)+']');},
    querySelector:function(selector){return root.matches(selector)?root:root.querySelector(selector);},querySelectorAll:root.querySelectorAll.bind(root),
    createElement:actualDocument.createElement.bind(actualDocument),createElementNS:actualDocument.createElementNS.bind(actualDocument),
    addEventListener:function(e,f){listen(root,e,f);},dispatchEvent:root.dispatchEvent.bind(root),body:actualDocument.body};
  var window={addEventListener:function(e,f){listen(actualWindow,e,f);}};
  function fetch(path,options){if(disposed)return Promise.reject(new Error('disconnected'));return Promise.resolve().then(function(){return host.request(path,options);}).then(function(r){if(disposed)throw new Error('disconnected');return r;});}
  var prefix=host.hashPrefix||'';
  function route(){var hash=location.hash.slice(1);return prefix?(hash.indexOf(prefix)===0?hash.slice(prefix.length):'overview'):hash;}
  root.querySelectorAll('[data-tab]').forEach(function(a){a.href='#'+prefix+a.getAttribute('href').slice(1);});
  var NSID='" nsid-prefix "';
  function set(name,v){
    var els=document.querySelectorAll('[data-field=\"'+name+'\"]');
    for(var i=0;i<els.length;i++){els[i].textContent=v;}
  }
  function state(msg,bad){
    var el=document.getElementById('load-state');
    if(!el)return; el.textContent=msg||''; el.setAttribute('data-bad',bad?'1':'0');
  }
  function bytes(n){
    if(typeof n!=='number'||!isFinite(n))return '—';
    var u=['B','KiB','MiB','GiB','TiB'],i=0,v=n;
    while(v>=1024&&i<u.length-1){v=v/1024;i++;}
    return (i===0?v:v.toFixed(1))+' '+u[i];
  }
  function num(n){return (typeof n==='number'&&isFinite(n))?String(n):'—';}
  function text(el,value){el.textContent=(value===undefined||value===null||value==='')?'—':String(value);}

  // Same tenant-bound XRPC surface every other client calls. credentials are
  // the tenant session cookie; nothing here embeds a secret.
  function xrpc(method,body,authorization){
    var headers={'content-type':'application/json'};
    if(authorization)headers.authorization=/^(Biscuit|CACAO|Bearer)\\s+/.test(authorization)?authorization:('Biscuit '+authorization);
    return fetch('/xrpc/'+NSID+'.'+method,{
      method:'POST',headers:headers,
      credentials:'include',body:JSON.stringify(body||{})
    }).then(function(r){
      if(r.status===401){throw new Error('unauthorized');}
      return r.text().then(function(raw){
        var payload=null;try{payload=raw?JSON.parse(raw):null;}catch(e){}
        if(!r.ok){
          var detail=payload&&(payload.message||payload.error||payload.code);
          throw new Error('HTTP '+r.status+(detail?' — '+String(detail):''));
        }
        return payload===null?{}:payload;
      });
    });
  }
  function store(method,body){
    return fetch('/xrpc/net.kotobase.store.'+method,{method:'POST',
      headers:{'content-type':'application/json'},credentials:'include',body:JSON.stringify(body||{})
    }).then(function(r){if(r.status===401)throw new Error('unauthorized');if(!r.ok)throw new Error('HTTP '+r.status);return r.json();});
  }

  function loadUsage(){
    state(t('テナントを読み込んでいます…','Loading your tenant…'),false);
    return xrpc('usageGet',{}).then(function(d){
      set('tier', d.tier||d.plan||'—');
      set('used-pins', num(d.used_pins!==undefined?d.used_pins:d.usedPins));
      set('quota-pins', num(d.quota_pins!==undefined?d.quota_pins:d.quotaPins));
      set('remaining-pins', num(d.remainingPins));
      set('used-bytes', bytes(d.used_bytes!==undefined?d.used_bytes:d.usedBytes));
      set('quota-bytes', bytes(d.quota_bytes!==undefined?d.quota_bytes:d.quotaBytes));
      set('remaining-bytes', bytes(d.remainingBytes));
      set('pinned', num(d.pinnedCount));
      set('pinning', num(d.pinningCount));
      set('failed', num(d.failedCount));
      set('tenant', d.tenantDid||d.tenant_did||'—');
      document.dispatchEvent(new Event('kb:tenant-ready'));
      state('',false);
    });
  }

  // Content-addressed data browser. A pin's request id is mutable control
  // state; its CID is the canonical immutable identity, so the CID is the
  // primary link and opens the same-origin /ipld/<cid> byte route.
  function pinCard(record){
    record=record||{};
    var pin=record.pin||record, cid=pin.cid||record.cid||'',
        article=document.createElement('article');
    article.className='kb-pin';
    var head=document.createElement('div');head.className='kb-pin-head';
    var title=document.createElement('strong');text(title,pin.name||cid||t('名前のないpin','Unnamed pin'));head.appendChild(title);
    var badge=document.createElement('span');badge.className='kb-badge';text(badge,record.status||pin.status);head.appendChild(badge);
    article.appendChild(head);
    if(cid){
      var link=document.createElement('a');link.className='kb-cid';
      link.href=host.blockHref?host.blockHref(cid):('/ipld/'+encodeURIComponent(cid));link.textContent=cid;
      link.setAttribute('aria-label',t('不変のIPLDブロックを開く ','Open immutable IPLD block ')+cid);article.appendChild(link);
      var copy=document.createElement('button');copy.type='button';copy.className='kb-copy';copy.textContent=t('CIDをコピー','Copy CID');
      copy.addEventListener('click',function(){
        if(navigator.clipboard&&navigator.clipboard.writeText){
          navigator.clipboard.writeText(cid).then(function(){copy.textContent=t('コピーしました','Copied');});
        }
      });article.appendChild(copy);
    }
    var meta=document.createElement('p');meta.className='kb-footnote kb-mut';
    text(meta,(record.created||record.created_at||pin.created||pin.created_at||'')+
              ((record.requestid||record.pin_id)?(' · '+(record.requestid||record.pin_id)):''));
    article.appendChild(meta);return article;
  }
  function loadPins(){
    var holder=document.getElementById('pin-list'), status=document.getElementById('pins-state');
    if(!holder)return Promise.resolve();status.textContent=t('CIDを読み込んでいます…','Loading CIDs…');
    return fetch('/pins?limit=100',{credentials:'include'}).then(function(r){
      if(r.status===401)throw new Error('unauthorized');if(!r.ok)throw new Error('HTTP '+r.status);return r.json();
    }).then(function(d){
      holder.textContent='';var rows=(d&&d.results)||[];
      if(!rows.length){var empty=document.createElement('p');empty.textContent=t('まだpinされたCIDはありません。GraphDBのcontent identityはCIDです。','No pinned CIDs yet. The GraphDB content identity is the CID.');holder.appendChild(empty);}
      for(var i=0;i<rows.length;i++)holder.appendChild(pinCard(rows[i]));
      set('pin-count',num(d&&d.count));status.textContent=(d&&d.storage_mode)?t('ストレージ: ','Storage: ')+d.storage_mode:'';
    }).catch(function(e){status.textContent=e.message==='unauthorized'?t('セッションの有効期限が切れました。','Your session expired.'):t('CID一覧を読み込めませんでした（'+e.message+'）。','Could not load the CID list ('+e.message+').');status.setAttribute('data-bad','1');});
  }

  var cursor=null;
  function row(r){
    var tr=document.createElement('tr');
    function td(t){var e=document.createElement('td');e.textContent=(t===undefined||t===null||t==='')?'—':String(t);tr.appendChild(e);}
    td(r.ts?new Date(r.ts).toISOString():'—');
    td(r.action); td(r.outcome); td(r.country); td(r.request_id);
    return tr;
  }
  function loadAudit(){
    var url='/v1/audit?limit=50'+(cursor?('&cursor='+encodeURIComponent(cursor)):'');
    return fetch(url,{credentials:'include'}).then(function(r){
      if(r.status===401){throw new Error('unauthorized');}
      if(!r.ok){throw new Error('HTTP '+r.status);}
      return r.json();
    }).then(function(d){
      var tb=document.getElementById('audit-rows');
      var rows=(d&&d.data)||[];
      for(var i=0;i<rows.length;i++){tb.appendChild(row(rows[i]));}
      if(rows.length===0&&!tb.hasChildNodes()){
        var tr=document.createElement('tr');var td=document.createElement('td');
        td.setAttribute('colspan','5');
        // 'no receipts yet' is a different fact from 'we could not read them',
        // so it is said in words rather than left as an empty table.
        td.textContent=t('このtenantのreceiptはまだ記録されていません。','No receipts recorded yet for this tenant.');
        tr.appendChild(td);tb.appendChild(tr);
      }
      cursor=d&&d.cursor;
      var more=document.getElementById('audit-more');
      if(more){more.style.display=cursor?'':'none';}
    });
  }

  function boot(){
    loadUsage().then(function(){
        // Tenant payload arrived — leave honesty to live data-fields; clear gate.
        setAuthGateState(Object.prototype.hasOwnProperty.call(host,'authGateStateAfterLoad')?host.authGateStateAfterLoad:null);
      }).catch(function(e){
        if(e&&e.message==='unauthorized'){
          setAuthGateState('not-signed-in');
          state(t('セッションの有効期限が切れました。再度サインインするとこのconsoleを表示できます。','Your session expired. Sign in again to see this console.'),true);
        }else{
          // Signed-in transport but empty/error: do not invent zeros; gate may stay honest.
          if(host.authGateState!=='not-signed-in')setAuthGateState(host.authGateState||'signed-in-empty');
          state(t('テナントデータを読み込めませんでした（'+((e&&e.message)||'error')+'）。下の値は0ではなく不明です。','Could not load tenant data ('+((e&&e.message)||'error')+'). The values below are NOT zero — they are unknown.'),true);
        }
      });
    loadPins();
    loadAudit().catch(function(e){
      var el=document.getElementById('audit-state');if(el){el.textContent=t('監査ログを読み込めませんでした（'+((e&&e.message)||'error')+'）。','Could not load the audit log ('+((e&&e.message)||'error')+').');el.setAttribute('data-bad','1');}
    });
  }
  var more=document.getElementById('audit-more');
  if(more){more.addEventListener('click',function(){loadAudit().catch(function(){});});}
  // Stripe returns here after checkout; say which outcome happened.
  try{
    var q=new URLSearchParams(location.search).get('billing');
    if(q==='success'){state(t('チェックアウトが完了しました。Stripeがサブスクリプションを確認するとプランが更新されます。','Checkout completed. Your plan updates once Stripe confirms the subscription.'),false);}
    else if(q==='cancel'){state(t('チェックアウトをキャンセルしました。課金は発生していません。','Checkout cancelled. Nothing was charged.'),false);}
  }catch(e){}
  boot();

  // One document, nine workbench panels. Hash navigation is linkable and
  // back-button friendly; no panel change reloads the page or loses query
  // results. Before JS runs every section remains visible. Older hashes
  // from the previous IA still resolve.
  (function(){
    var tabs=document.querySelectorAll('[data-tab]'),panels=document.querySelectorAll('[data-panel][id]');
    var aliases={data:'overview',table:'datoms',write:'keys',identity:'keys',recovery:'plan'};
    function show(id){
      if(aliases[id])id=aliases[id];
      if(!Array.prototype.some.call(panels,function(p){return p.id===id;}))id='overview';
      for(var i=0;i<panels.length;i++)panels[i].hidden=panels[i].id!==id;
      for(var j=0;j<tabs.length;j++)tabs[j].setAttribute('aria-current',tabs[j].getAttribute('href')==='#'+prefix+id?'page':'false');
      document.querySelector('.kb-console').setAttribute('data-spa-ready','1');
    }
    for(var i=0;i<tabs.length;i++)tabs[i].addEventListener('click',function(e){e.preventDefault();var id=this.getAttribute('href').slice(1+prefix.length);history.pushState(null,'','#'+prefix+id);show(id);actualWindow.dispatchEvent(new Event('hashchange'));});
    window.addEventListener('popstate',function(){show(route()||'overview');});
    window.addEventListener('hashchange',function(){show(route()||'overview');});
    show(route()||'overview');
    document.querySelectorAll('[data-language-selector-item]').forEach(function(a){a.addEventListener('click',function(){a.hash=location.hash;});});
  })();

  // Durable database catalog. Create and tombstone call the real tenant-bound
  // Datomic management routes; the list is persisted as IPLD documents in
  // TENANT_STATE. A tombstone is deliberately not described as deletion.
  (function(){
    var body=document.getElementById('db-list-rows'),stateEl=document.getElementById('db-state'),
        createInput=document.getElementById('db-create-name'),createButton=document.getElementById('db-create'),
        confirmBox=document.getElementById('db-tombstone-confirm'),confirmInput=document.getElementById('db-tombstone-name'),
        confirmButton=document.getElementById('db-tombstone-run'),cancelButton=document.getElementById('db-tombstone-cancel'),selected='';
    if(!body)return;
    function dbState(msg,bad){stateEl.textContent=msg||'';stateEl.setAttribute('data-bad',bad?'1':'0');}
    function useDatabase(name){var fields=document.querySelectorAll('[data-explore-db],#q-db');for(var i=0;i<fields.length;i++)fields[i].value=name;location.hash=prefix+'graph';var loadButton=document.querySelector('#graph [data-explore-load]');if(loadButton)setTimeout(function(){loadButton.click();},0);}
    // The catalog is the pick-list for every database field (datalist), and
    // an empty field starts on the first usable database, so a panel opened
    // from the nav is ready to load without typing a handle.
    function offer(databases){var list=document.getElementById('kb-db-options');if(!list)return;list.textContent='';var usable=databases.filter(function(db){return db.kind!=='system'&&db.status!=='tombstoned'&&db.db_name;});
      usable.forEach(function(db){var o=document.createElement('option');o.value=db.db_name;list.appendChild(o);});
      if(usable.length){var fields=document.querySelectorAll('[data-explore-db],#q-db');for(var i=0;i<fields.length;i++)if(!fields[i].value)fields[i].value=usable[0].db_name;}}
    function action(label,kind,handler){var b=document.createElement('button');b.type='button';b.className='kb-inline-action';b.textContent=label;b.setAttribute('data-kind',kind);b.addEventListener('click',handler);return b;}
    function render(databases){
      body.textContent='';for(var i=0;i<databases.length;i++){(function(db){var tr=document.createElement('tr');
        var name=document.createElement('th');name.scope='row';if(db.kind!=='system'&&db.status!=='tombstoned'){var opener=action(db.db_name,'open',function(){useDatabase(db.db_name);});opener.className='kb-db-open';opener.title=t('開く','Explore');name.appendChild(opener);}else{name.textContent=db.db_name;}tr.appendChild(name);
        var kind=document.createElement('td');kind.textContent=db.kind||'user';tr.appendChild(kind);
        var status=document.createElement('td');var badge=document.createElement('span');badge.className='kb-badge';badge.textContent=db.status||'active';status.appendChild(badge);tr.appendChild(status);
        var cid=document.createElement('td');var link=document.createElement('a');link.href=host.blockHref?host.blockHref(db.graph||''):('/ipld/'+encodeURIComponent(db.graph||''));link.textContent=db.graph||'—';link.title=db.graph||'';cid.appendChild(link);tr.appendChild(cid);
        var actions=document.createElement('td');actions.className='kb-row-actions';
        if(db.kind==='system'){var note=document.createElement('span');note.className='kb-footnote';note.textContent=t('カタログのみ','Catalog only');note.title=t('system catalogの項目はtenantのクエリ用databaseではありません。','System catalog entries are not tenant query databases.');actions.appendChild(note);}
        else if(db.status!=='tombstoned')actions.appendChild(action(t('開く','Explore'),'use',function(){useDatabase(db.db_name);}));
        if(db.kind!=='system'&&db.status!=='tombstoned')actions.appendChild(action(t('アーカイブ','Archive'),'tombstone',function(){selected=db.db_name;document.getElementById('db-tombstone-target').textContent=selected;confirmInput.value='';confirmButton.disabled=true;confirmBox.hidden=false;confirmInput.focus();}));
        if(db.kind!=='system'&&db.status==='tombstoned')actions.appendChild(action(t('復元','Restore'),'restore',function(){dbState(t('データベースを復元中…','Restoring database…'),false);xrpc('datomic.restoreDatabase',{db_name:db.db_name}).then(load).catch(function(e){dbState(t('データベースを復元できません（'+e.message+'）。','Could not restore database ('+e.message+').'),true);});}));
        tr.appendChild(actions);body.appendChild(tr);})(databases[i]);}
      set('database-count',String(databases.length));offer(databases);
      var empty=document.getElementById('db-list-empty');if(empty)empty.hidden=databases.length!==0;
    }
    function load(){dbState(t('データベースを読み込んでいます…','Loading databases…'),false);return xrpc('datomic.listDatabases',{}).then(function(d){render((d&&d.databases)||[]);dbState('',false);}).catch(function(e){dbState(t('データベースカタログを読み込めませんでした（'+e.message+'）。','Could not load database catalog ('+e.message+').'),true);});}
    createButton.addEventListener('click',function(){var name=createInput.value.trim();if(!name){dbState(t('データベース名を入力してください。','Enter a database name.'),true);createInput.focus();return;}createButton.disabled=true;dbState(t('データベースを作成しています…','Creating database…'),false);xrpc('datomic.createDatabase',{db_name:name}).then(function(){createInput.value='';return load();}).catch(function(e){dbState(t('データベースを作成できません（'+e.message+'）。','Could not create database ('+e.message+').'),true);}).then(function(){createButton.disabled=false;});});
    confirmInput.addEventListener('input',function(){confirmButton.disabled=confirmInput.value!==selected;});
    cancelButton.addEventListener('click',function(){confirmBox.hidden=true;confirmButton.disabled=true;selected='';});
    confirmButton.addEventListener('click',function(){if(!selected||confirmInput.value!==selected)return;confirmButton.disabled=true;dbState(t('アーカイブしています…','Archiving…'),false);xrpc('datomic.deleteDatabase',{db_name:selected}).then(function(){confirmBox.hidden=true;selected='';return load();}).catch(function(e){dbState(t('アーカイブできません（'+e.message+'）。','Could not archive ('+e.message+').'),true);}).then(function(){confirmButton.disabled=false;});});
    load();
  })();

  // Bounded data explorer. One tenant-bound Datalog read feeds both the table
  // and graph views so switching representations never changes the snapshot.
  // It deliberately caps results: this is an inspection surface, not a claim
  // that a browser can lay out an unbounded production graph.
  (function(){
    var rows=[], lastDb='', lastGraph={nodes:[],edges:[]}, graphView=[0,0,900,560], defaultQuery='{:find [?e ?a ?v]\\n :where [[?e ?a ?v]]\\n :limit ';
    var dbs=document.querySelectorAll('[data-explore-db]'), limits=document.querySelectorAll('[data-explore-limit]');
    var states=document.querySelectorAll('[data-explore-state]'), filters=document.querySelectorAll('[data-explore-filter]');
    function each(xs,f){for(var i=0;i<xs.length;i++)f(xs[i],i);}
    function say(msg,bad){each(states,function(el){el.textContent=msg||'';el.setAttribute('data-bad',bad?'1':'0');});}
    function syncInputs(db,limit){each(dbs,function(el){el.value=db;});each(limits,function(el){el.value=String(limit);});}
    function value(v){if(v===undefined||v===null)return '—';if(typeof v==='string')return v;try{return JSON.stringify(v);}catch(e){return String(v);}}
    function triple(r){
      if(Array.isArray(r))return [r[0],r[1],r[2]];
      if(r&&typeof r==='object')return [r.e!==undefined?r.e:(r.entity!==undefined?r.entity:r.subject),r.a!==undefined?r.a:(r.attribute!==undefined?r.attribute:r.predicate),r.v!==undefined?r.v:(r.value!==undefined?r.value:r.object)];
      return [r,'',''];
    }
    function filtered(){var q='';each(filters,function(el){if(el.value.trim())q=el.value.trim().toLowerCase();});each(filters,function(el){el.value=q;});return q?rows.filter(function(r){return value(r).toLowerCase().indexOf(q)!==-1;}):rows.slice();}
    function renderTable(){
      var body=document.getElementById('table-view-rows'), empty=document.getElementById('table-view-empty');if(!body)return;
      body.textContent='';var shown=filtered();empty.hidden=shown.length!==0;
      for(var i=0;i<shown.length;i++){var tri=triple(shown[i]),tr=document.createElement('tr');
        var named=km.byId[value(tri[0])],target=(typeof tri[2]==='number'||typeof tri[2]==='string')&&value(tri[2])!==value(tri[0])?km.byId[value(tri[2])]:null;
        for(var j=0;j<3;j++){var td=document.createElement('td'),cell=value(tri[j]);if(j===0&&named&&named.label!=='#'+named.id)cell=named.label+' #'+value(tri[0]);if(j===2&&target)cell='→ '+target.label+' #'+value(tri[2]);if(typeof tri[j]==='string'&&/^b[a-z2-7]{30,}$/.test(tri[j])){var link=document.createElement('a');link.href=host.blockHref?host.blockHref(tri[j]):('/ipld/'+encodeURIComponent(tri[j]));link.textContent=cell;td.appendChild(link);}else{td.textContent=cell;}tr.appendChild(td);}body.appendChild(tr);
      }
      set('table-visible',String(shown.length));set('table-total',String(rows.length));
      var exportButton=document.getElementById('table-export');if(exportButton)exportButton.disabled=shown.length===0;
    }
    // Knowledge model (2026-09-25): the loaded facts grouped into kinds of
    // things (by attribute namespace), each thing named by its name-like
    // attribute, linked where a value is another loaded thing. Everything
    // here is inferred from the loaded window and the views say so.
    var km={kinds:[],byKind:Object.create(null),byId:Object.create(null),entities:[],links:[]},focus={kind:'',entity:''};
    // Exploration canvas (2026-09-25): selecting a thing adds it and its
    // neighbours; selecting a thing already on the canvas expands it in
    // place. A small force layout places them; a dragged node stays put.
    var canvas={nodes:[],byId:Object.create(null)},CX=450,CY=280,MAXN=150;
    function canvasAdd(en,near){if(canvas.byId[en.id])return canvas.byId[en.id];var i=canvas.nodes.length,ang=i*2.39996,r=near?60:18*Math.sqrt(i);
      var n={id:en.id,entity:en,x:(near?near.x:CX)+Math.cos(ang)*r,y:(near?near.y:CY)+Math.sin(ang)*r,vx:0,vy:0,pinned:false};canvas.nodes.push(n);canvas.byId[en.id]=n;return n;}
    function canvasExpand(en){var c=canvasAdd(en);en.out.concat(en.inc).slice(0,40).forEach(function(l){var other=l.from===en?l.to:l.from;if(canvas.nodes.length<MAXN)canvasAdd(other,c);});}
    function canvasReset(en){canvas={nodes:[],byId:Object.create(null)};var c=canvasAdd(en);c.x=CX;c.y=CY;canvasExpand(en);}
    function canvasEdges(){var out=[];canvas.nodes.forEach(function(n){n.entity.out.forEach(function(l){var to=canvas.byId[l.to.id];if(to&&to!==n)out.push({from:n,to:to,label:l.attr});});});return out;}
    function relax(steps){var ns=canvas.nodes,es=canvasEdges();
      for(var s=0;s<steps;s++){
        for(var i=0;i<ns.length;i++){var a=ns[i];for(var j=i+1;j<ns.length;j++){var b=ns[j],dx=a.x-b.x,dy=a.y-b.y,d2=dx*dx+dy*dy+.01,d=Math.sqrt(d2),f=6400/d2;a.vx+=dx/d*f;a.vy+=dy/d*f;b.vx-=dx/d*f;b.vy-=dy/d*f;}}
        es.forEach(function(e){var dx=e.to.x-e.from.x,dy=e.to.y-e.from.y,d=Math.sqrt(dx*dx+dy*dy)||1,f=(d-190)*.03;e.from.vx+=dx/d*f;e.from.vy+=dy/d*f;e.to.vx-=dx/d*f;e.to.vy-=dy/d*f;});
        ns.forEach(function(n){if(n.pinned){n.vx=0;n.vy=0;return;}n.vx+=(CX-n.x)*.004;n.vy+=(CY-n.y)*.004;n.vx*=.55;n.vy*=.55;n.x+=Math.max(-24,Math.min(24,n.vx));n.y+=Math.max(-24,Math.min(24,n.vy));});}}
    function fitView(){if(!canvas.nodes.length)return;var x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;canvas.nodes.forEach(function(n){x0=Math.min(x0,n.x);y0=Math.min(y0,n.y);x1=Math.max(x1,n.x);y1=Math.max(y1,n.y);});
      var svgEl=document.getElementById('graph-view-svg'),box=svgEl&&svgEl.getBoundingClientRect(),rw=(box&&box.width)||560,ratio=box&&box.width&&box.height?box.width/box.height:900/560,pad=70,w=Math.max(x1-x0+2*pad,420),h=Math.max(y1-y0+2*pad,260);
      // labels keep their screen size, so widen the frame by each label's half width in view units
      var sc=w/rw,half=function(n){var l=clip(n.entity.label,20),px=0;for(var i=0;i<l.length;i++)px+=l.charCodeAt(i)>255?14:8;return px/2+22;};
      canvas.nodes.forEach(function(n){x0=Math.min(x0,n.x-half(n)*sc+pad);x1=Math.max(x1,n.x+half(n)*sc-pad);});w=Math.max(x1-x0+2*pad,420);if(w/h>ratio)h=w/ratio;else w=h*ratio;graphView=[(x0+x1)/2-w/2,(y0+y1)/2-h/2,w,h];}
    var labelKeys=['name','title','label','display-name','displayName','ident','summary','text','content','email','url'];
    function attrName(a){a=value(a);return a.charAt(0)===':'?a.slice(1):a;}
    function kindOf(a){var n=attrName(a),i=n.indexOf('/');return i>0?n.slice(0,i):'';}
    function shortAttr(a){var n=attrName(a),i=n.indexOf('/');return i>0?n.slice(i+1):n;}
    function isCid(v){return typeof v==='string'&&/^b[a-z2-7]{30,}$/.test(v);}
    function vtype(f){if(f.ref)return 'ref';var v=f.v;if(v===null||v===undefined)return 'null';if(Array.isArray(v))return 'list';if(isCid(v))return 'cid';return typeof v;}
    function typeLabel(x){return ({ref:t('参照','link'),string:t('文字列','text'),number:t('数値','number'),boolean:t('真偽','yes/no'),list:t('リスト','list'),cid:'CID',object:t('構造体','map'),'null':t('空','empty')})[x]||x;}
    function buildModel(){
      var shown=filtered(),byId=Object.create(null),order=[],links=[],kinds=Object.create(null),list=[];
      shown.forEach(function(r){var tri=triple(r),id=value(tri[0]);if(!byId[id]){byId[id]={id:id,raw:tri[0],facts:[],kind:'',label:'',out:[],inc:[]};order.push(byId[id]);}byId[id].facts.push({a:attrName(tri[1]),short:shortAttr(tri[1]),kind:kindOf(tri[1]),v:tri[2]});});
      order.forEach(function(en){var votes=Object.create(null),best='',bn=0;
        en.facts.forEach(function(f){if(f.kind&&f.kind!=='db'){votes[f.kind]=(votes[f.kind]||0)+1;if(votes[f.kind]>bn){bn=votes[f.kind];best=f.kind;}}});
        en.kind=best||t('その他','other');
        for(var k=0;k<labelKeys.length&&!en.label;k++)en.facts.forEach(function(f){if(!en.label&&f.short===labelKeys[k]&&typeof f.v==='string'&&f.v)en.label=f.v;});
        if(!en.label)en.facts.forEach(function(f){if(!en.label&&typeof f.v==='string'&&f.v&&f.v.length<80&&!isCid(f.v))en.label=f.v;});
        if(!en.label)en.label='#'+en.id;});
      order.forEach(function(en){en.facts.forEach(function(f){var target=(typeof f.v==='number'||typeof f.v==='string')?byId[value(f.v)]:null;
        if(target&&target!==en){f.ref=target;var l={from:en,to:target,attr:f.short};links.push(l);en.out.push(l);target.inc.push(l);}});});
      order.forEach(function(en){var k=kinds[en.kind];if(!k){k=kinds[en.kind]={name:en.kind,entities:[],attrs:Object.create(null),attrOrder:[],rel:Object.create(null),relOrder:[]};list.push(k);}k.entities.push(en);
        var seen=Object.create(null);en.facts.forEach(function(f){var s=k.attrs[f.short];if(!s){s=k.attrs[f.short]={name:f.short,full:f.a,count:0,entities:0,types:Object.create(null),targets:Object.create(null)};k.attrOrder.push(s);}
          s.count++;if(!seen[f.short]){seen[f.short]=1;s.entities++;}s.types[vtype(f)]=1;if(f.ref)s.targets[f.ref.kind]=1;});});
      links.forEach(function(l){var key=l.attr+'|'+l.to.kind,k=kinds[l.from.kind],r=k.rel[key];if(!r){r=k.rel[key]={from:l.from.kind,to:l.to.kind,attr:l.attr,count:0};k.relOrder.push(r);}r.count++;});
      list.forEach(function(k){k.attrOrder.sort(function(a,b){return b.entities-a.entities;});});
      list.sort(function(a,b){return b.entities.length-a.entities.length;});
      list.forEach(function(k,i){k.index=i;});
      km={kinds:list,byKind:kinds,byId:byId,entities:order,links:links};
      canvas.nodes=canvas.nodes.filter(function(n){return byId[n.id];});canvas.byId=Object.create(null);canvas.nodes.forEach(function(n){n.entity=byId[n.id];canvas.byId[n.id]=n;});
      if(focus.entity&&!byId[focus.entity])focus.entity='';if(focus.kind&&!kinds[focus.kind])focus.kind='';
    }
    function node(tag,cls,text){var x=document.createElement(tag);if(cls)x.className=cls;if(text!==undefined)x.textContent=text;return x;}
    function entityButton(en,cls){var b=node('button',cls||'kb-km-link',en.label);b.type='button';b.title=en.kind+' #'+en.id;b.addEventListener('click',function(){showEntity(en.id);});return b;}
    function showKind(name){focus.kind=name;focus.entity='';graphView=[0,0,900,560];renderKnowledge();if(typeof applyGraphView==='function')applyGraphView();}
    function showEntity(id,keepFocus){var en=km.byId[id];if(!en)return;var wasOnCanvas=!!(focus.entity&&canvas.byId[id]);focus.entity=id;focus.kind=en.kind;
      if(wasOnCanvas)canvasExpand(en);else canvasReset(en);relax(220);fitView();renderKnowledge();if(typeof applyGraphView==='function')applyGraphView();
      if(!keepFocus){var box=document.getElementById('km-entity');if(box)box.focus({preventScroll:true});}
      ensureEntity(en).then(function(changed){if(!changed||focus.entity!==id)return;render();var fresh=km.byId[id];if(fresh){canvasExpand(fresh);relax(160);fitView();renderKnowledge();applyGraphView();}});}
    function showAll(){focus.kind='';focus.entity='';graphView=[0,0,900,560];renderKnowledge();if(typeof applyGraphView==='function')applyGraphView();}
    function valueCell(f){if(f.ref)return entityButton(f.ref);if(isCid(f.v)){var a=node('a','kb-cid-inline',f.v);a.href=host.blockHref?host.blockHref(f.v):('/ipld/'+encodeURIComponent(f.v));return a;}return node('span','',value(f.v));}
    function renderKnowledge(){
      var summary=document.getElementById('km-summary');if(!summary)return;
      var n=km.entities.length;
      summary.textContent=n?t(km.kinds.length+' 種類・'+n+' 件のもの・'+km.links.length+' 件のつながり（読み込んだ '+rows.length+' 件の事実から推定）',
                             km.kinds.length+' kinds · '+n+' things · '+km.links.length+' connections (inferred from '+rows.length+' loaded facts)'):'';
      set('graph-nodes',String(n));set('graph-edges',String(km.links.length));
      document.getElementById('graph-view-empty').hidden=n!==0||!rows.length&&!lastDb;document.getElementById('km-body').hidden=n===0;
      renderKinds();
      // breadcrumb: where the map is looking
      var crumbs=document.getElementById('km-crumbs');crumbs.textContent='';
      var all=node('button','kb-km-link',t('全体','Everything'));all.type='button';all.addEventListener('click',showAll);crumbs.appendChild(all);
      if(focus.kind){crumbs.appendChild(node('span','kb-km-sep','›'));var kb=node('button','kb-km-link',focus.kind);kb.type='button';kb.addEventListener('click',function(){showKind(focus.kind);});crumbs.appendChild(kb);}
      if(focus.entity){crumbs.appendChild(node('span','kb-km-sep','›'));crumbs.appendChild(node('span','',km.byId[focus.entity].label));}
      drawMap();renderFocusList();renderEntity();renderSearch();
      var reset=document.getElementById('km-canvas-reset');if(reset)reset.hidden=!focus.entity;
    }
    // kinds: one card per kind of thing, with examples a person can read,
    // its count in the window and in the whole database
    function wholeLine(name){var c=whole.counts[name];if(!c)return '';if(c.pending)return t('DB 全体: 集計中…','Whole database: counting…');if(c.err)return t('DB 全体: 集計できません','Whole database: could not count');return t('DB 全体: '+c.n.toLocaleString()+' 件','Whole database: '+c.n.toLocaleString());}
    function renderKinds(){
      var kindsEl=document.getElementById('km-kinds');if(!kindsEl)return;kindsEl.textContent='';
      km.kinds.forEach(function(k){var card=node('button','kb-km-kind kb-km-c'+(k.index%6));card.type='button';card.setAttribute('aria-pressed',focus.kind===k.name?'true':'false');
        card.appendChild(node('strong','kb-km-kind-name',k.name));card.appendChild(node('span','kb-km-kind-count',t('読み込み範囲 '+k.entities.length+' 件',k.entities.length+' loaded')));var wl=wholeLine(k.name);if(wl)card.appendChild(node('span','kb-km-kind-whole',wl));
        card.appendChild(node('span','kb-km-kind-attrs',k.attrOrder.slice(0,4).map(function(a){return a.name;}).join(' · ')));
        card.appendChild(node('span','kb-km-kind-examples',t('例: ','e.g. ')+k.entities.slice(0,3).map(function(en){return en.label.length>24?en.label.slice(0,23)+'…':en.label;}).join(t('、',', '))));
        card.addEventListener('click',function(){focus.kind===k.name&&!focus.entity?showAll():showKind(k.name);});kindsEl.appendChild(card);});
      schemaOnlyKinds().forEach(function(x,i){var card=node('button','kb-km-kind kb-km-kind--unloaded kb-km-c'+((km.kinds.length+i)%6));card.type='button';
        card.appendChild(node('strong','kb-km-kind-name',x.name));card.appendChild(node('span','kb-km-kind-count',t('読み込み範囲外','Not in the loaded window')));var wl=wholeLine(x.name);if(wl)card.appendChild(node('span','kb-km-kind-whole',wl));
        card.appendChild(node('span','kb-km-kind-examples',t('選ぶと読み込みます','Select to load')));card.addEventListener('click',function(){loadKind(x.name,x.attr);});kindsEl.appendChild(card);});
    }
    function renderFocusList(){
      var box=document.getElementById('km-list'),title=document.getElementById('km-list-title');box.textContent='';
      var k=focus.kind?km.byKind[focus.kind]:null;document.getElementById('km-list-wrap').hidden=!k||!!focus.entity;if(!k)return;
      title.textContent=t(k.name+'（'+k.entities.length+' 件）',k.name+' ('+k.entities.length+')');
      k.entities.slice(0,200).forEach(function(en){var li=node('li');li.appendChild(entityButton(en));var extra=en.facts.filter(function(f){return typeof f.v!=='object'&&!f.ref&&value(f.v)!==en.label;}).slice(0,2).map(function(f){return f.short+': '+value(f.v);}).join(' · ');if(extra)li.appendChild(node('span','kb-footnote kb-mut',' '+extra));box.appendChild(li);});
    }
    function renderEntity(){
      var box=document.getElementById('km-entity'),sel=document.getElementById('graph-selection'),rowsEl=document.getElementById('graph-selection-rows');
      rowsEl.textContent='';var en=focus.entity?km.byId[focus.entity]:null;box.hidden=!en;
      if(!en){sel.textContent=focus.kind?t(focus.kind+' を選択中','Showing '+focus.kind):t('種類かノードを選ぶと、そのものの内容とつながりが表示されます。','Pick a kind or a node to see what it holds and how it connects.');return;}
      sel.textContent=en.label;document.getElementById('km-entity-kind').textContent=en.kind+' · #'+en.id;
      en.facts.forEach(function(f){var tr=node('tr'),th=node('th','',f.short);th.scope='row';th.title=f.a;tr.appendChild(th);var td=node('td');td.appendChild(valueCell(f));tr.appendChild(td);rowsEl.appendChild(tr);});
      var inc=document.getElementById('km-incoming');inc.textContent='';document.getElementById('km-incoming-wrap').hidden=!en.inc.length;
      en.inc.slice(0,100).forEach(function(l){var li=node('li');li.appendChild(entityButton(l.from));li.appendChild(node('span','kb-footnote kb-mut',' ('+l.from.kind+') — '+l.attr));inc.appendChild(li);});
    }
    var NS='http://www.w3.org/2000/svg';
    function el(name,attrs,txt){var x=document.createElementNS(NS,name);for(var k in attrs)x.setAttribute(k,attrs[k]);if(txt!==undefined)x.textContent=txt;return x;}
    function clip(s,n){return s.length>n?s.slice(0,n-1)+'…':s;}
    function drawMap(){
      var svg=document.getElementById('graph-view-svg'),list=document.getElementById('graph-view-list');if(!svg||!list)return;
      while(svg.firstChild)svg.removeChild(svg.firstChild);list.textContent='';
      var defs=el('defs',{}),marker=el('marker',{id:'kb-km-arrow',viewBox:'0 0 10 10',refX:'10',refY:'5',markerWidth:'7',markerHeight:'7',orient:'auto-start-reverse'});marker.appendChild(el('path',{d:'M0 0L10 5L0 10z',class:'kb-km-arrow'}));defs.appendChild(marker);svg.appendChild(defs);
      var nodes=[],edges=[],cx=450,cy=280,rx=330,ry=190;
      if(focus.entity){
        // the exploration canvas: every thing selected so far and its neighbours
        canvas.nodes.forEach(function(n){nodes.push({id:n.id,label:n.entity.label,kind:n.entity.kind,r:n.id===focus.entity?26:17,center:n.id===focus.entity,entity:n.entity,x:n.x,y:n.y,pinned:n.pinned});});
        var at=Object.create(null);nodes.forEach(function(n){at[n.id]=n;});
        canvasEdges().forEach(function(e){edges.push({from:at[e.from.id],to:at[e.to.id],label:e.label});});
      }else{
        // the shape of the knowledge: kinds, sized by count, joined by relations
        var max=1;km.kinds.forEach(function(k){max=Math.max(max,k.entities.length);});
        km.kinds.slice(0,24).forEach(function(k,i,arr){var ang=Math.PI*2*i/arr.length-Math.PI/2,one=arr.length===1;nodes.push({id:k.name,label:k.name,sub:t(k.entities.length+' 件',String(k.entities.length)),kind:k.name,r:18+28*Math.sqrt(k.entities.length/max),x:one?cx:cx+Math.cos(ang)*rx,y:one?cy:cy+Math.sin(ang)*ry});});
        var byName=Object.create(null);nodes.forEach(function(n){byName[n.id]=n;});
        km.kinds.forEach(function(k){k.relOrder.forEach(function(r){if(byName[r.from]&&byName[r.to])edges.push({from:byName[r.from],to:byName[r.to],label:r.attr+(r.count>1?' ×'+r.count:'')});});});
      }
      edges.forEach(function(e){list.appendChild(node('li','',e.from.label+' — '+e.label+' → '+e.to.label));
        if(e.from===e.to){var s=e.from;svg.appendChild(el('path',{d:'M'+(s.x-8)+' '+(s.y-s.r)+' C'+(s.x-40)+' '+(s.y-s.r-60)+' '+(s.x+40)+' '+(s.y-s.r-60)+' '+(s.x+8)+' '+(s.y-s.r),class:'kb-graph-edge','marker-end':'url(#kb-km-arrow)',fill:'none'}));svg.appendChild(el('text',{x:s.x,y:s.y-s.r-48,'text-anchor':'middle',class:'kb-graph-edge-label'},clip(e.label,22)));return;}
        var dx=e.to.x-e.from.x,dy=e.to.y-e.from.y,d=Math.sqrt(dx*dx+dy*dy)||1,ux=dx/d,uy=dy/d;
        var x1=e.from.x+ux*e.from.r,y1=e.from.y+uy*e.from.r,x2=e.to.x-ux*(e.to.r+3),y2=e.to.y-uy*(e.to.r+3);
        svg.appendChild(el('line',{x1:x1,y1:y1,x2:x2,y2:y2,class:'kb-graph-edge','marker-end':'url(#kb-km-arrow)'}));
        var lab=el('text',{x:(x1+x2)/2,y:(y1+y2)/2-4,'text-anchor':'middle',class:'kb-graph-edge-label'},clip(e.label,22));lab.appendChild(el('title',{},e.label));svg.appendChild(lab);});
      nodes.forEach(function(nd){var k=km.byKind[nd.kind],g=el('g',{class:'kb-graph-node kb-km-c'+((k?k.index:0)%6)+(nd.center?' kb-km-center':'')+(nd.pinned?' kb-km-pinned':''),tabindex:'0',role:'listitem','data-id':nd.entity?nd.id:'','aria-label':nd.label+(nd.sub?' '+nd.sub:'')});
        g.appendChild(el('circle',{cx:nd.x,cy:nd.y,r:nd.r}));var tx=el('text',{x:nd.x,y:nd.y+nd.r+16,'text-anchor':'middle'},clip(nd.label,20));tx.appendChild(el('title',{},nd.label));g.appendChild(tx);
        if(nd.sub)g.appendChild(el('text',{x:nd.x,y:nd.y+5,'text-anchor':'middle',class:'kb-km-count'},nd.sub));
        if(focus.kind&&!focus.entity&&nd.id===focus.kind)g.setAttribute('data-selected','true');
        function pick(){if(nd.entity){showEntity(nd.entity.id,true);}else{showKind(nd.id);}}
        g.addEventListener('click',function(){if(suppressClick){suppressClick=false;return;}pick();});g.addEventListener('keydown',function(ev){if(ev.key==='Enter'||ev.key===' '){ev.preventDefault();pick();}});svg.appendChild(g);});
      lastGraph={nodes:nodes,edges:edges};
    }
    // drag a node to place it; a press that does not move is a selection
    var dragNode=null,dragFrom=null,suppressClick=false;
    function toSvg(e){var svg=document.getElementById('graph-view-svg'),pt=svg.createSVGPoint();pt.x=e.clientX;pt.y=e.clientY;return pt.matrixTransform(svg.getScreenCTM().inverse());}
    (function(){var svg=document.getElementById('graph-view-svg');if(!svg)return;
      svg.addEventListener('pointerdown',function(e){var g=e.target.closest('.kb-graph-node');var id=g&&g.getAttribute('data-id');if(!id||!canvas.byId[id])return;dragNode=canvas.byId[id];dragFrom={x:e.clientX,y:e.clientY,moved:false,pointer:e.pointerId};});
      svg.addEventListener('pointermove',function(e){if(!dragNode)return;if(!dragFrom.moved&&Math.abs(e.clientX-dragFrom.x)+Math.abs(e.clientY-dragFrom.y)<5)return;if(!dragFrom.moved){dragFrom.moved=true;try{svg.setPointerCapture(dragFrom.pointer);}catch(err){}}var p=toSvg(e);dragNode.x=p.x;dragNode.y=p.y;dragNode.pinned=true;drawMap();});
      function end(){if(dragNode&&dragFrom.moved)suppressClick=true;dragNode=null;}
      svg.addEventListener('pointerup',end);svg.addEventListener('pointercancel',end);})();
    // search: things in the loaded window by name or any text value
    function searchLocal(q){q=q.trim().toLowerCase();if(!q)return [];var hits=[];km.entities.forEach(function(en){if(hits.length>=12)return;var why='';if(en.label.toLowerCase().indexOf(q)!==-1)why=en.label;else en.facts.forEach(function(f){if(!why&&typeof f.v==='string'&&f.v.toLowerCase().indexOf(q)!==-1)why=f.short+': '+f.v;});if(why)hits.push({en:en,why:why});});return hits;}
    function renderSearch(){var input=document.getElementById('km-search'),box=document.getElementById('km-search-results');if(!input||!box)return;box.textContent='';var q=input.value;if(!q.trim()){box.hidden=true;return;}
      var hits=searchLocal(q);box.hidden=false;
      if(!hits.length){box.appendChild(node('li','kb-footnote kb-mut',t('読み込んだ範囲には見つかりません。','Not found in the loaded facts.')));}
      var extra=node('li'),wb=node('button','kb-km-link',t('DB 全体で「'+q.trim()+'」を探す','Search the whole database for “'+q.trim()+'”'));wb.type='button';wb.addEventListener('click',function(){searchWhole(q);});extra.appendChild(wb);var st=node('span','kb-footnote kb-mut',' ');st.id='km-search-whole-state';extra.appendChild(st);
      hits.forEach(function(h){var li=node('li');li.appendChild(entityButton(h.en));li.appendChild(node('span','kb-footnote kb-mut',' '+h.en.kind+(h.why!==h.en.label?' · '+clip(h.why,60):'')));box.appendChild(li);});box.appendChild(extra);}
    (function(){var input=document.getElementById('km-search');if(!input)return;input.addEventListener('input',renderSearch);
      input.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();var first=searchLocal(input.value)[0];if(first)showEntity(first.en.id);}if(e.key==='Escape'){input.value='';renderSearch();}});
      var reset=document.getElementById('km-canvas-reset');if(reset)reset.addEventListener('click',function(){var en=focus.entity&&km.byId[focus.entity];if(en){canvasReset(en);relax(220);fitView();renderKnowledge();applyGraphView();}});})();
    // Server reads (2026-09-25). kotobase's query gate refuses a clause with
    // neither the entity nor the attribute bound, so [[?e ?a ?v]] never runs.
    // The window is an index read (datomic.datoms :eavt, whole entities);
    // whole-database counts and search are Datalog with the attribute bound.
    function readDatoms(db,index,components,limit){return xrpc('datomic.datoms',{db_name:db,index:index,components_edn:components,limit:limit}).then(function(d){if(d&&d.ok===false)throw new Error(d.message||d.error||'datoms refused');var r=(d&&(d.datoms||d.rows))||[];return Array.isArray(r)?r:[];});}
    function readQ(db,edn){return xrpc('datomic.q',{db_name:db,query_edn:edn}).then(function(d){if(d&&d.ok===false)throw new Error(d.message||d.error||'query refused');var r=(d&&(d.rows||d.result))||d;return Array.isArray(r)?r:[];});}
    function kw(a){a=attrName(a);var parts=a.split('/');return parts.length<=2&&parts.every(function(p){return /^[A-Za-z0-9._*+!?<>=-]+$/.test(p);})?':'+a:null;}
    function first(r){return Array.isArray(r)?r[0]:r;}
    function tripleKey(tri){return value(tri[0])+'|'+attrName(tri[1])+'|'+value(tri[2]);}
    function merge(extra){var seen=Object.create(null),added=0;rows.forEach(function(r){seen[tripleKey(triple(r))]=1;});extra.forEach(function(r){var k=tripleKey(triple(r));if(!seen[k]){seen[k]=1;rows.push(r);added++;}});return added;}
    var whole={db:'',counts:Object.create(null),schema:[]},enrichGen=0,fetched=Object.create(null);
    function kindAttrs(){var m=Object.create(null);km.kinds.forEach(function(k){if(k.attrOrder[0])m[k.name]=k.attrOrder[0].full;});whole.schema.forEach(function(a){var k=kindOf(a);if(k&&!m[k])m[k]=a;});return m;}
    function schemaOnlyKinds(){var seen=Object.create(null),out=[];km.kinds.forEach(function(k){seen[k.name]=1;});whole.schema.forEach(function(a){var k=kindOf(a);if(k&&!seen[k]){seen[k]=1;out.push({name:k,attr:a});}});return out;}
    function enrich(db){var gen=++enrichGen;whole={db:db,counts:Object.create(null),schema:[]};fetched=Object.create(null);
      readQ(db,'{:find [?i] :where [[?a :db/ident ?i]] :limit 5000}').then(function(r){if(gen!==enrichGen)return;
        whole.schema=r.map(function(x){return attrName(first(x));}).filter(function(a){var k=kindOf(a);return k&&k!=='db'&&k.indexOf('db.')!==0&&k!=='fressian';});}).catch(function(){})
      .then(function(){if(gen!==enrichGen)return;renderKnowledge();countKinds(db,gen);});}
    function countKinds(db,gen){var m=kindAttrs(),names=Object.keys(m),i=0;
      function next(){if(gen!==enrichGen||i>=names.length)return;var name=names[i++],a=kw(m[name]);if(!a){next();return;}whole.counts[name]={pending:true};
        readQ(db,'{:find [(count-distinct ?e)] :where [[?e '+a+' _]]}').then(function(r){whole.counts[name]={n:Number(first(r.length?r[0]:0))||0,attr:m[name]};})
          .catch(function(e){whole.counts[name]={err:String((e&&e.message)||e),attr:m[name]};}).then(function(){if(gen===enrichGen)renderKinds();next();});}
      next();next();next();}
    // a thing's facts beyond the window: everything it says, and every ref to it
    function ensureEntity(en){if(!lastDb||fetched[en.id])return Promise.resolve(false);fetched[en.id]=1;
      return Promise.all([readDatoms(lastDb,'eavt',[en.raw],500).catch(function(){return [];}),readDatoms(lastDb,'vaet',[en.raw],200).catch(function(){return [];})])
        .then(function(both){var added=merge(both[0].concat(both[1])),need=[],named=Object.create(null);
          // things that point here from outside the window arrive nameless: read their own facts too
          rows.forEach(function(x){var tr=triple(x);if(labelKeys.indexOf(shortAttr(tr[1]))!==-1)named[value(tr[0])]=1;});
          both[1].forEach(function(r){var e=triple(r)[0],k=value(e);if(need.length<20&&!named[k]&&!fetched[k]){named[k]=1;need.push(e);}});
          return Promise.all(need.map(function(e){return readDatoms(lastDb,'eavt',[e],100).catch(function(){return [];});}))
            .then(function(lists){added+=merge([].concat.apply([],lists));return added>0;});});}
    // a kind the window did not reach: list its members from the attribute index
    function loadKind(name,attr){if(!lastDb)return;say(t(name+' を読み込んでいます…','Loading '+name+'…'),false);
      readDatoms(lastDb,'aevt',[kw(attr)],200).then(function(r){merge(r);render();say('',false);showKind(name);}).catch(function(e){say(t('読み込めませんでした（'+e.message+'）。','Could not load ('+e.message+').'),true);});}
    // search the whole database through its name-like attributes
    function labelAttrs(){var out=[],seen=Object.create(null);function add(a){a=attrName(a);var s=a.indexOf('/')>0?a.slice(a.indexOf('/')+1):a;if(labelKeys.indexOf(s)!==-1&&!seen[a]&&kw(a)){seen[a]=1;out.push(a);}}
      km.kinds.forEach(function(k){k.attrOrder.forEach(function(x){add(x.full);});});whole.schema.forEach(add);return out;}
    function searchWhole(qtext){var attrs=labelAttrs(),needle=JSON.stringify(qtext.trim().toLowerCase()),box=document.getElementById('km-search-whole-state');
      if(!lastDb||!attrs.length){box.textContent=t('名前の項目が見つからないため、DB 全体は検索できません。','No name-like fields found, so the whole database cannot be searched.');return;}
      box.textContent=t('DB 全体を検索しています…','Searching the whole database…');
      Promise.all(attrs.map(function(a){return readQ(lastDb,'{:find [?e ?v] :where [[?e '+kw(a)+' ?v] [(lower-case ?v) ?l] [(includes? ?l '+needle+')]] :limit 20}').then(function(r){return r.map(function(x){return [x[0],':'+a,x[1]];});}).catch(function(){return [];});}))
        .then(function(lists){var hits=[].concat.apply([],lists);merge(hits);render();var st=document.getElementById('km-search-whole-state');if(st)st.textContent=t('DB 全体で '+hits.length+' 件見つかりました。','Found '+hits.length+' in the whole database.');});}
    function renderSchema(){
      var body=document.getElementById('schema-view-rows'),empty=document.getElementById('schema-view-empty');if(!body)return;body.textContent='';var attrs=0;
      km.kinds.forEach(function(k){var tr=node('tr'),th=node('th');th.scope='row';var b=node('button','kb-km-link',k.name);b.type='button';b.addEventListener('click',function(){location.hash=prefix+'graph';showKind(k.name);});th.appendChild(b);tr.appendChild(th);
        tr.appendChild(node('td','',String(k.entities.length)));
        var at=node('td'),ul=node('ul','kb-km-attrs');k.attrOrder.forEach(function(a){attrs++;var li=node('li');li.appendChild(node('code','',a.name));
          var ty=Object.keys(a.types).map(typeLabel).join('・'),tg=Object.keys(a.targets);li.appendChild(node('span','kb-footnote kb-mut',' '+ty+(tg.length?' → '+tg.join(', '):'')+' · '+Math.round(100*a.entities/k.entities.length)+'%'));li.title=a.full;ul.appendChild(li);});at.appendChild(ul);tr.appendChild(at);
        var rel=node('td');k.relOrder.forEach(function(r){rel.appendChild(node('div','',r.attr+' → '+r.to+' ('+r.count+')'));});if(!k.relOrder.length)rel.textContent='—';tr.appendChild(rel);body.appendChild(tr);});
      set('schema-attributes',String(attrs));set('schema-kinds',String(km.kinds.length));
      if(empty)empty.hidden=km.kinds.length!==0;
    }
    function renderGraph(){renderKnowledge();}
    function render(){buildModel();renderTable();renderSchema();renderGraph();}
    function load(source){
      var panel=source.closest('[data-panel]'),db=panel.querySelector('[data-explore-db]').value.trim(),limit=parseInt(panel.querySelector('[data-explore-limit]').value,10)||500;
      if(!db){say(t('データベース名を入力してください。','Enter a database name.'),true);panel.querySelector('[data-explore-db]').focus();return;}
      syncInputs(db,limit);lastDb=db;say(t('読み込んでいます…','Loading…'),false);each(document.querySelectorAll('[data-explore-load]'),function(b){b.disabled=true;});
      readDatoms(db,'eavt',[],limit).then(function(r){
        rows=r;render();say(rows.length?'':t('このデータベースにはまだ事実がありません。','This database has no facts yet.'),false);if(rows.length)enrich(db);
      }).catch(function(e){rows=[];render();say(e.message==='unauthorized'?t('セッションの有効期限が切れました。データを見るには再度サインインしてください。','Your session expired. Sign in again to explore data.'):t('データを読み込めませんでした（'+((e&&e.message)||'error')+'）。','Could not load data ('+((e&&e.message)||'error')+').'),true);}).then(function(){each(document.querySelectorAll('[data-explore-load]'),function(b){b.disabled=false;});});
    }
    each(document.querySelectorAll('[data-explore-load]'),function(b){b.addEventListener('click',function(){load(b);});});
    each(filters,function(f){f.addEventListener('input',function(){var v=f.value;each(filters,function(other){other.value=v;});render();});});
    var graphSvg=document.getElementById('graph-view-svg'),drag=null;
    function applyGraphView(){graphSvg.setAttribute('viewBox',graphView.join(' '));var w=graphSvg.getBoundingClientRect().width;if(!w)return;graphSvg.style.setProperty('--km-s',String(graphView[2]/w));}
    if(typeof ResizeObserver==='function')new ResizeObserver(function(){applyGraphView();}).observe(graphSvg);else window.addEventListener('resize',function(){applyGraphView();});
    function zoom(factor){var nw=graphView[2]*factor,nh=graphView[3]*factor;graphView[0]+=(graphView[2]-nw)/2;graphView[1]+=(graphView[3]-nh)/2;graphView[2]=nw;graphView[3]=nh;applyGraphView();}
    document.getElementById('graph-zoom-in').addEventListener('click',function(){zoom(.8);});document.getElementById('graph-zoom-out').addEventListener('click',function(){zoom(1.25);});document.getElementById('graph-reset').addEventListener('click',function(){graphView=[0,0,900,560];applyGraphView();});
    graphSvg.addEventListener('pointerdown',function(e){if(e.target.closest('.kb-graph-node'))return;drag={x:e.clientX,y:e.clientY,v:graphView.slice()};graphSvg.setPointerCapture(e.pointerId);});
    graphSvg.addEventListener('pointermove',function(e){if(!drag)return;var rect=graphSvg.getBoundingClientRect();graphView[0]=drag.v[0]-(e.clientX-drag.x)*drag.v[2]/rect.width;graphView[1]=drag.v[1]-(e.clientY-drag.y)*drag.v[3]/rect.height;applyGraphView();});
    graphSvg.addEventListener('pointerup',function(){drag=null;});graphSvg.addEventListener('pointercancel',function(){drag=null;});
    window.__kbGraphLayout=function(){return {database:lastDb,view_box:graphView.slice(),nodes:lastGraph.nodes.map(function(n){return {id:n.id,x:n.x,y:n.y};})};};
    window.__kbGraphCommunities=function(){var parent=Object.create(null);lastGraph.nodes.forEach(function(n){parent[n.id]=n.id;});
      function root(x){while(parent[x]!==x){parent[x]=parent[parent[x]];x=parent[x];}return x;}function join(a,b){a=root(a);b=root(b);if(a!==b)parent[b]=a;}
      lastGraph.edges.forEach(function(e){join(e.from.id,e.to.id);});var groups=Object.create(null);lastGraph.nodes.forEach(function(n){groups[root(n.id)]=1;});return Object.keys(groups).length;};
    var csv=document.getElementById('table-export');if(csv)csv.addEventListener('click',function(){
      if(!rows.length)return;function quote(v){var q=String.fromCharCode(34),s=value(v);if(/^[=+@-]/.test(s))s=String.fromCharCode(39)+s;return q+s.split(q).join(q+q)+q;}var lines=['Entity,Attribute,Value'];var shown=filtered();for(var i=0;i<shown.length;i++){lines.push(triple(shown[i]).map(quote).join(','));}
      var url=URL.createObjectURL(new Blob([lines.join('\\n')],{type:'text/csv;charset=utf-8'})),a=document.createElement('a');a.href=url;a.download=(lastDb||'kotobase')+'-datoms.csv';a.click();URL.revokeObjectURL(url);
    });
  })();

  // Query workbench. Datalog uses datomic.q; SQL, SPARQL and bounded Cypher
  // reads use kg.query. Both accept the same tenant session cookie. Writes
  // remain outside this console and require the stronger CACAO path.
  (function(){
    var db=document.getElementById('q-db'), lang=document.getElementById('q-lang'), edn=document.getElementById('q-edn'),
        run=document.getElementById('q-run'), out=document.getElementById('q-out'),
        st=document.getElementById('q-state'),links=document.getElementById('q-links'),historySelect=document.getElementById('q-history'),
        savedSelect=document.getElementById('q-saved'),saveName=document.getElementById('q-save-name'),historyItems=[],savedItems=[];
    if(!db||!lang||!edn||!run||!out) return;
    // See the :q-edn comment in admin-page/view — a textarea's content is a
    // child node, so the starter query is set here rather than as an attribute.
    edn.value='{:find [?e ?v]\\n :where [[?e :db/ident ?v]]\\n :limit 25}';
    var examples={datalog:'{:find [?e ?v]\\n :where [[?e :db/ident ?v]]\\n :limit 25}',sql:'SELECT e, a, v FROM datoms LIMIT 25',sparql:'SELECT ?s ?p ?o WHERE { ?s ?p ?o } LIMIT 25',cypher:'MATCH (n) RETURN n LIMIT 25'};
    function qstate(msg,bad){st.textContent=msg||'';st.setAttribute('data-bad',bad?'1':'0');}
    function fillSelect(select,items,placeholder){select.textContent='';var first=document.createElement('option');first.value='';first.textContent=placeholder;select.appendChild(first);for(var i=0;i<items.length;i++){var option=document.createElement('option');option.value=String(i);option.textContent=items[i].name;select.appendChild(option);}}
    function refreshSaved(){return xrpc('savedQuery.list',{}).then(function(d){savedItems=(d&&d.saved_queries)||[];fillSelect(savedSelect,savedItems,t('保存済みクエリを選択','Choose a saved query'));}).catch(function(e){savedItems=[];fillSelect(savedSelect,[],t('保存済みクエリは利用できません','Saved queries unavailable'));qstate(t('保存済みクエリを読み込めませんでした（'+e.message+'）。','Could not load saved queries ('+e.message+').'),true);});}
    function snapshot(name){return {name:name,db:db.value,lang:lang.value,query:edn.value};}
    function applySnapshot(item){if(!item)return;db.value=item.db||item.db_name||'';lang.value=item.lang||'datalog';edn.value=item.query||'';}
    function addHistory(){historyItems.unshift(snapshot(new Date().toLocaleTimeString()+' · '+(db.value||t('データベース','database'))+' · '+lang.value));historyItems=historyItems.slice(0,20);fillSelect(historySelect,historyItems,t('セッション履歴','Session history'));}
    function renderCidLinks(value){
      if(!links)return;links.textContent='';var found=JSON.stringify(value).match(/b[a-z2-7]{30,}/g)||[],seen={};
      for(var i=0;i<found.length;i++){var cid=found[i];if(seen[cid])continue;seen[cid]=1;var a=document.createElement('a');a.href=host.blockHref?host.blockHref(cid):('/ipld/'+encodeURIComponent(cid));a.textContent='IPLD '+cid;links.appendChild(a);}
    }
    lang.addEventListener('change',function(){edn.value=examples[lang.value]||examples.datalog;});
    run.addEventListener('click',function(){
      var name=(db.value||'').trim(), q=(edn.value||'').trim();
      // Which field is missing is said, because 'invalid input' sends the
      // operator looking at both.
      if(!name){qstate(t('データベース名を入力してください。','Enter a database name.'),true);db.focus();return;}
      if(!q){qstate(t('クエリを入力してください。','Enter a query.'),true);edn.focus();return;}
      run.disabled=true; qstate(t('実行中…','Running…'),false); out.textContent='';
      var request=lang.value==='datalog'
        ? xrpc('datomic.q',{db_name:name,query_edn:q})
        : xrpc('kg.query',{db_name:name,lang:lang.value,query:q});
      request
        .then(function(d){
          if(d&&d.ok===false)throw new Error(d.message||d.error||'query refused');
          var rows=(d&&(d.rows||d.result))||d;
          out.textContent=JSON.stringify(rows,null,2);
          renderCidLinks(d);
          addHistory();
          // A query that matched nothing is not a query that failed, and the
          // difference is invisible in an empty results pane.
          qstate((Array.isArray(rows)&&rows.length===0)?t('クエリを実行しました。一致する行はありません。','Query ran. No rows matched.'):t('クエリを実行しました。','Query ran.'),false);
        })
        .catch(function(e){
          var m=(e&&e.message)||'error';
          out.textContent='';if(links)links.textContent='';
          qstate(m==='unauthorized'
            ?t('セッションの有効期限が切れました。クエリを実行するには再度サインインしてください。','Your session expired. Sign in again to run queries.')
            :t('クエリが失敗しました（'+m+'）。何も読み込まれていません。','Query failed ('+m+'). Nothing was read.'),true);
        })
        .then(function(){run.disabled=false;});
    });
    historySelect.addEventListener('change',function(){applySnapshot(historyItems[parseInt(historySelect.value,10)]);});
    savedSelect.addEventListener('change',function(){applySnapshot(savedItems[parseInt(savedSelect.value,10)]);});
    document.getElementById('q-save').addEventListener('click',function(){var name=saveName.value.trim();if(!name){qstate(t('保存するクエリ名を入力してください。','Enter a saved query name.'),true);saveName.focus();return;}var item=snapshot(name);xrpc('savedQuery.save',{name:item.name,db_name:item.db,lang:item.lang,query:item.query}).then(function(){saveName.value='';return refreshSaved();}).then(function(){qstate(t('このtenantに保存しました。サインイン中の端末で利用できます。','Saved for this tenant and available across signed-in devices.'),false);}).catch(function(e){qstate(t('クエリを保存できません（'+e.message+'）。','Could not save query ('+e.message+').'),true);});});
    document.getElementById('q-delete-saved').addEventListener('click',function(){var item=savedItems[parseInt(savedSelect.value,10)];if(!item)return;xrpc('savedQuery.delete',{name:item.name}).then(refreshSaved).then(function(){qstate(t('保存済みクエリをTombstone化しました。それ以前のIPLD historyは残ります。','Saved query tombstoned; prior IPLD history remains.'),false);}).catch(function(e){qstate(t('保存済みクエリを削除できません（'+e.message+'）。','Could not remove saved query ('+e.message+').'),true);});});
    fillSelect(historySelect,[],t('セッション履歴','Session history'));document.addEventListener('kb:tenant-ready',refreshSaved);setTimeout(refreshSaved,0);
  })();

  // Enterprise operations. The delegated credential is kept only in this closure:
  // never a Web Storage API, never a URL, and never a persisted
  // query. Reloading the page forgets it.
  (function(){
    var cacao=document.getElementById('cacao-token');if(!cacao)return;
    document.getElementById('write-tx').value='[{:db/id \"entity-1\" :person/name \"Ada\"}]';
    document.getElementById('cypher-write-query').value='CREATE (n:Person {name: 1}) RETURN n';
    document.getElementById('migration-tx').value='[{:db/ident :person/name\\n  :db/valueType :db.type/string\\n  :db/cardinality :db.cardinality/one}]';
    function val(id){var e=document.getElementById(id);return e?e.value.trim():'';}
    function say(id,msg,bad){var e=document.getElementById(id);if(e){e.textContent=msg;e.setAttribute('data-bad',bad?'1':'0');}}
    function capability(){var token=cacao.value.trim();if(!token){cacao.focus();throw new Error(t('Biscuit authorizationを入力してください。','Enter a Biscuit authorization.'));}return token;}
    window.addEventListener('pagehide',function(){cacao.value='';});

    function transact(db,tx){return xrpc('datomic.transact',{db_name:db,tx_edn:tx},capability());}
    document.getElementById('row-write').addEventListener('click',function(){
      var button=this;try{button.disabled=true;say('write-state',t('Biscuitを検証してtransactionを実行中…','Verifying the Biscuit and running the transaction…'),false);
        transact(val('write-db'),val('write-tx')).then(function(d){say('write-state',t('Commit済み。basis '+(d.basis_cid||d.basis_t||'updated')+'。','Committed. basis '+(d.basis_cid||d.basis_t||'updated')+'.'),false);})
          .catch(function(e){say('write-state',t('Writeを拒否しました（'+e.message+'）。','Write refused ('+e.message+').'),true);}).then(function(){button.disabled=false;});
      }catch(e){button.disabled=false;say('write-state',e.message,true);}
    });
    document.getElementById('cypher-write').addEventListener('click',function(){
      var button=this,q=val('cypher-write-query');try{if(!/^CREATE\\b/i.test(q))throw new Error(t('このwrite面はCREATEだけを受け付けます。','This write plane accepts CREATE only.'));button.disabled=true;
        say('write-state',t('Biscuit scope・tenant ownership・CASを検証中…','Verifying Biscuit scope, tenant ownership and CAS…'),false);
        xrpc('kg.query',{db_name:val('write-db'),lang:'cypher',query:q},capability())
          .then(function(d){if(d&&d.ok===false)throw new Error(d.message||d.error);say('write-state',t('Cypher writeをcommitしました。','Cypher write committed.'),false);})
          .catch(function(e){say('write-state',t('Cypher writeを拒否しました（'+e.message+'）。','Cypher write refused ('+e.message+').'),true);}).then(function(){button.disabled=false;});
      }catch(e){button.disabled=false;say('write-state',e.message,true);}
    });

    function migrationRecord(status,result){return {name:val('migration-name'),database:val('migration-db'),tx_edn:val('migration-tx'),status:status,
      applied_at:status==='applied'?new Date().toISOString():null,result:result||null};}
    function migrationKey(){return val('migration-db')+'--'+val('migration-name');}
    document.getElementById('migration-plan').addEventListener('click',function(){
      var tx=val('migration-tx'),problems=[];if(!val('migration-name'))problems.push('name');if(!val('migration-db'))problems.push('database');
      if(!/^\\s*\\[/.test(tx)||tx.indexOf(':db/ident')<0)problems.push(t(':db/identを含むEDN vector','an EDN vector containing :db/ident'));
      if(/:db\\/retract|:db\\/retractEntity/.test(tx))problems.push(t('destructive retractは禁止','destructive retract is forbidden'));
      say('migration-state',problems.length?('Plan refused: '+problems.join(', ')): t('Plan valid: append-only schema transaction。ApplyにはCACAOが必要です。','Plan valid: append-only schema transaction. Applying requires CACAO.'),!!problems.length);
    });
    document.getElementById('migration-apply').addEventListener('click',function(){
      var button=this;try{button.disabled=true;transact(val('migration-db'),val('migration-tx')).then(function(result){
        return store('put',{coll:'admin-migrations-v1',key:migrationKey(),val:migrationRecord('applied',result)});
      }).then(function(d){say('migration-state',t('Applied。migration receipt CID: '+(d.cid||'—'),'Applied. migration receipt CID: '+(d.cid||'—')),false);})
        .catch(function(e){say('migration-state',t('Migrationを拒否しました（'+e.message+'）。','Migration refused ('+e.message+').'),true);}).then(function(){button.disabled=false;});
      }catch(e){button.disabled=false;say('migration-state',e.message,true);}
    });

    var keywords={datalog:[':find',':where',':in',':limit','pull','not','or'],sql:['SELECT','FROM','WHERE','JOIN','LEFT JOIN','GROUP BY','ORDER BY','CASE','WITH','EXPLAIN'],
      cypher:['MATCH','OPTIONAL MATCH','WHERE','WITH','RETURN','ORDER BY','SKIP','LIMIT','CREATE','CASE'],sparql:['SELECT','WHERE','OPTIONAL','FILTER','ORDER BY','LIMIT']};
    function suggestions(){var lang=document.getElementById('q-lang').value,box=document.getElementById('q-suggestions');box.textContent='';
      (keywords[lang]||[]).forEach(function(word){var b=document.createElement('button');b.type='button';b.className='kb-chip';b.textContent=word;
        b.addEventListener('click',function(){var q=document.getElementById('q-edn');q.setRangeText(word,q.selectionStart,q.selectionEnd,'end');q.focus();});box.appendChild(b);});}
    document.getElementById('q-lang').addEventListener('change',suggestions);suggestions();
    document.getElementById('q-diagnose').addEventListener('click',function(){
      var db=val('q-db'),lang=val('q-lang'),query=val('q-edn'),out=document.getElementById('q-plan-out');if(!db){say('q-state','Enter a database name.',true);return;}
      out.textContent=t('dbStatsを読み込んでいます…','Loading dbStats…');xrpc('datomic.dbStats',{db_name:db}).then(function(stats){
        var shape={mode:'diagnostic (not engine EXPLAIN/PROFILE)',language:lang,statement:/^\\s*CREATE\\b/i.test(query)?'write':'read',
          operators:(query.match(/\\b(JOIN|MATCH|OPTIONAL|GROUP BY|ORDER BY|WITH|SKIP|LIMIT|WHERE)\\b/ig)||[]),statistics:stats,
          warning:'operator timings and cardinality estimates are not exposed by the current engine API'};out.textContent=JSON.stringify(shape,null,2);
      }).catch(function(e){out.textContent=t('診断は利用できません: ','Diagnostics unavailable: ')+e.message;});
    });

    document.getElementById('layout-save').addEventListener('click',function(){var name=val('layout-name');if(!name){say('layout-state',t('レイアウト名を入力してください。','Enter a layout name.'),true);return;}
      var value=window.__kbGraphLayout?window.__kbGraphLayout():{viewBox:'0 0 900 560'};value.name=name;value.saved_at=new Date().toISOString();
      store('put',{coll:'admin-graph-layouts-v1',key:name,val:value}).then(function(d){say('layout-state',t('LayoutをIPLD CID '+d.cid+' に保存しました。','Saved the layout as IPLD CID '+d.cid+'.'),false);}).catch(function(e){say('layout-state',t('保存できません（'+e.message+'）。','Could not save ('+e.message+').'),true);});});
    document.getElementById('community-run').addEventListener('click',function(){if(window.__kbGraphCommunities){var n=window.__kbGraphCommunities();say('layout-state',t(n+' communitiesをloaded windowで検出しました（全graph解析ではありません）。',n+' communities detected in the loaded window (this is not a whole-graph analysis).'),false);}});

    document.getElementById('rbac-apply').addEventListener('click',function(){
      var subject=val('rbac-subject'),permission=val('rbac-permission'),id='grant-'+Date.now();
      if(subject.indexOf('did:')!==0||subject.length<10){say('identity-state',t('有効なsubject DIDを入力してください。','Enter a valid subject DID.'),true);return;}
      var tx='[{:db/id '+JSON.stringify(id)+' :kotobase.authority/grant-id '+JSON.stringify(id)+' :kotobase.authority/subject '+JSON.stringify(subject)+' :kotobase.authority/permission '+JSON.stringify(permission)+' :kotobase.authority/revoked? false}]';
      try{transact('__authority',tx).then(function(){say('identity-state',t('Grantをcanonical authority graphへcommitしました。新しいsigned frontier反映後に有効になります。','Grant committed to the canonical authority graph. It takes effect after the next signed frontier.'),false);})
        .catch(function(e){say('identity-state',t('Grantを拒否しました（'+e.message+'）。','Grant refused ('+e.message+').'),true);});}catch(e){say('identity-state',e.message,true);}
    });

    document.getElementById('backup-checkpoint').addEventListener('click',function(){var db=val('backup-db');say('backup-state',t('basisを取得中…','Reading the basis…'),false);
      xrpc('datomic.dbStats',{db_name:db}).then(function(stats){var checkpoint={database:db,created_at:new Date().toISOString(),basis_cid:stats.basis_cid||null,basis_t:stats.basis_t||null,stats:stats};
        return store('put',{coll:'admin-backup-checkpoints-v1',key:db+'--'+Date.now(),val:checkpoint});})
        .then(function(d){say('backup-state',t('Immutable checkpoint metadata CID '+d.cid+' を保存しました。','Saved immutable checkpoint metadata CID '+d.cid+'.'),false);})
        .catch(function(e){say('backup-state',t('Checkpointを作成できません（'+e.message+'）。','Could not create a checkpoint ('+e.message+').'),true);});});
    document.getElementById('recovery-drill').addEventListener('click',function(){var db=val('backup-db'),basisT=parseInt(val('backup-t'),10);if(!isFinite(basisT)){say('backup-state',t('basis_tを入力してください。','Enter a basis_t.'),true);return;}
      xrpc('datomic.asOf',{db_name:db,t:basisT}).then(function(d){say('backup-state',t('PITR read drill passed。basis '+(d.basis_cid||d.basis_t||basisT)+' を読み取り可能です。復元先databaseへのmaterializeはoperator runbookが必要です。','PITR read drill passed. basis '+(d.basis_cid||d.basis_t||basisT)+' is readable. Materializing into a restore-target database requires the operator runbook.'),false);})
        .catch(function(e){say('backup-state',t('Recovery drill failed（'+e.message+'）。','Recovery drill failed ('+e.message+').'),true);});});

    document.getElementById('audit-export').addEventListener('click',function(){fetch('/v1/audit/export',{credentials:'include'}).then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.blob();})
      .then(function(blob){var u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download='kotobase-audit.ndjson';a.click();URL.revokeObjectURL(u);})
      .catch(function(e){say('audit-state',t('Exportに失敗しました（'+e.message+'）。','Export failed ('+e.message+').'),true);});});

    var checks=[['skip-link',!!document.querySelector('.kb-skip')],['one-h1',document.querySelectorAll('h1').length===1],['live-regions',document.querySelectorAll('[aria-live]').length>=5],
      ['named-controls',Array.prototype.every.call(document.querySelectorAll('button,input,select,textarea'),function(e){return e.getAttribute('aria-label')||e.id||e.textContent.trim();})],
      ['graph-fallback',!!document.getElementById('graph-view-list')]];
    var list=document.getElementById('a11y-results');checks.forEach(function(c){var li=document.createElement('li');li.textContent=(c[1]?'PASS ':'FAIL ')+c[0];list.appendChild(li);});
  })();

  // Sign out. The session is revoked at the authn origin (POST /v1/logout,
  // which clears gftd_session on the kotobase.net parent domain) before the
  // browser leaves — a client-side redirect alone would leave a live session
  // behind on a shared machine. The origin arrives through the same runtime
  // slot /signup uses, so this document holds no hostname of its own.
  Array.prototype.forEach.call(document.querySelectorAll('[data-kb-signout]'),function(b){
    b.addEventListener('click',function(){
      b.disabled=true; state(t('サインアウトしています…','Signing out…'),false);
      Promise.resolve().then(function(){if(!host.signOut)throw new Error('Sign out is not configured');return host.signOut();})
        .then(function(){location.href='/';})
        .catch(function(){b.disabled=false;state(t('サインアウトできませんでした。接続を確認して再試行してください。','Could not sign out. Check your connection and retry.'),true);});
    });
  });
return {dispose:function(){disposed=true;listeners.forEach(function(x){x[0].removeEventListener(x[1],x[2]);});listeners=[];},setAuthGateState:setAuthGateState,signInHref:signInHref};
}};
"))

(def script
  "Drop authoring comments/indentation from the shipped inline program. The
  readable source remains above; the Worker document stays within its explicit
  byte budget instead of charging every request for comments."
  (-> browser-source
      (str/replace #"(?m)^\s*//.*\n" "")
      (str/replace #"(?m)^\s+" "")))

(def base-css
  (str
   ".kb-console{max-width:100%;}.kb-workbench-header{padding-block:1.25rem;}"
   ".kb-workbench-header .dads-heading{margin-block:0 .5rem;}"
   ".kb-workbench-header .kb-lead{font-size:1rem;max-width:none;}"
   ".kb-workbench-header p{margin-block:.5rem 0;}"
   ".kb-console .dds-ext-section{padding-block:1.25rem;}"
   ".kb-console .dds-ext-section>.dads-heading{margin-block:0 .75rem;}"
   ".kb-node-inspector{padding:1rem;border:1px solid var(--color-neutral-solid-gray-200);border-radius:.5rem;margin-block:1rem;overflow-wrap:anywhere;}"
   ".kb-graph-node[data-selected] circle{stroke:var(--color-key-700);stroke-width:5;}"
   ".kb-graph-node:focus-visible{outline:2px solid var(--color-key-700);}"
   ".kb-console .kb-footer{grid-column:1/-1;}"
   "@media(min-width:64rem){.kb-console{display:grid;grid-template-columns:12rem minmax(0,1fr);column-gap:1.5rem;padding-inline:1.5rem;}"
   ".kb-console>.kb-site-header,.kb-workbench-header{grid-column:1/-1;}"
   ".kb-console-nav{flex-direction:column;align-self:start;top:1rem;border:1px solid var(--color-neutral-solid-gray-200);border-radius:.5rem;padding:.5rem;}"
   ".kb-console-nav a{flex:none;justify-content:flex-start;padding-inline:1rem;text-align:start;}"
   ".kb-console-nav a[aria-current=page]{background:var(--color-neutral-solid-gray-50);box-shadow:inset .2rem 0 var(--color-key-700);}"
   ".kb-console-main{min-width:0;}.kb-console-main .dds-ext-section:first-child{padding-top:0;}"
   ".kb-console .kb-desktop-nav{margin-left:auto;}}"

   ".kb-metric{font-variant-numeric:tabular-nums;}\n"
   ".kb-auth-gate{margin-block:var(--hig-spacing-3,0.75rem);color:var(--ck-text,var(--hig-color-label));}\n"
   ".kb-auth-gate .dds-ext-card{border:1px solid var(--ck-surface-border,var(--color-neutral-solid-gray-200));border-radius:var(--ck-radius-md,var(--hig-radius-lg));background:var(--ck-surface-raised,var(--color-neutral-white));padding:var(--hig-spacing-4,1rem);}\n"
   ".kb-auth-gate[hidden],[data-overview-metrics][hidden],.kb-identity[hidden]{display:none;}\n"
   ".kb-console[data-auth=\"not-signed-in\"] [data-overview-metrics]{display:none;}\n"
   ".kb-console[data-auth=\"not-signed-in\"] .kb-identity{display:none;}\n"
   ".kb-skip{position:absolute;inset-inline-start:1rem;top:-5rem;z-index:100;padding:.75rem;background:var(--color-neutral-white);color:var(--color-neutral-solid-gray-900);}\n"
   ".kb-skip:focus{top:1rem;}\n"
   "[data-bad=\"1\"]{color:var(--color-semantic-error-1);}\n"
   ".kb-console-nav{position:sticky;top:0;z-index:10;display:flex;background:var(--color-neutral-white);"
   "color:var(--color-neutral-solid-gray-800);"
   "border-block:1px solid var(--color-neutral-solid-gray-200);overflow-x:auto;}\n"
   ".kb-console-nav a{min-height:3rem;min-width:6rem;flex:1;display:flex;align-items:center;justify-content:center;"
   "padding:.5rem .25rem;text-align:center;text-decoration:none;font-size:.8125rem;white-space:nowrap;"
   "color:inherit;}\n"
   ".kb-console-nav a[aria-current=\"page\"]{font-weight:700;color:var(--color-key-900);"
   "box-shadow:inset 0 -.2rem var(--color-key-700);}\n"
   ".kb-console-main{min-height:55vh;}\n"
   ".kb-console[data-spa-ready=\"1\"] [data-panel][hidden]{display:none;}\n"
   ".kb-identity{overflow-wrap:anywhere;}\n"
   ".kb-pin-list{display:grid;gap:.75rem;}\n"
   ".kb-pin{border:1px solid var(--color-neutral-solid-gray-200);border-radius:.5rem;padding:1rem;}\n"
   ".kb-pin-head{display:flex;gap:.75rem;align-items:center;justify-content:space-between;}\n"
   ".kb-badge{display:inline-flex;padding:.2rem .5rem;border-radius:999px;"
   "background:var(--color-primitive-green-50);color:var(--color-primitive-green-900);font-size:.75rem;}\n"
   ".kb-cid{display:block;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;"
   "overflow-wrap:anywhere;margin:.75rem 0;}\n"
   ".kb-copy{min-height:2.75rem;border:1px solid var(--color-key-700);border-radius:.25rem;"
   "background:var(--color-neutral-white);color:var(--color-key-900);padding:.5rem .75rem;}\n"
   ".kb-audit{width:100%;overflow-x:auto;display:block;}\n"
   ".kb-db-table{width:100%;border-collapse:collapse;}\n"
   ".kb-db-table th,.kb-db-table td{padding:.65rem;text-align:left;border-bottom:1px solid var(--color-neutral-solid-gray-200);}\n"
   ".kb-db-table td:nth-child(4){max-width:14rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;}\n"
   ".kb-row-actions{display:flex;gap:.5rem;flex-wrap:wrap;}\n"
   ".kb-inline-action{min-height:2.75rem;padding:.4rem .7rem;border:1px solid var(--color-key-700);border-radius:.25rem;background:var(--color-neutral-white);color:var(--color-key-900);}\n"
   ".kb-confirm{border-inline-start:.25rem solid var(--color-semantic-error-1);padding:1rem;margin-block:1rem;background:var(--color-neutral-solid-gray-50);}\n"
   ".kb-onboarding li{margin-block:.75rem;}\n"
   ".kb-km-summary{font-weight:600;margin-block:.75rem;}\n"
   ".kb-km-kinds{display:grid;grid-template-columns:repeat(auto-fill,minmax(13rem,1fr));gap:.75rem;margin-block:.75rem 1.25rem;}\n"
   ".kb-km-kind{display:grid;gap:.25rem;align-content:start;text-align:start;padding:.875rem 1rem;border:1px solid var(--color-neutral-solid-gray-200);border-inline-start:.35rem solid var(--km);border-radius:.5rem;background:var(--color-neutral-white);color:inherit;font:inherit;cursor:pointer;min-height:2.75rem;}\n"
   ".kb-km-kind:hover{background:var(--color-neutral-solid-gray-50);}.kb-km-kind[aria-pressed=true]{outline:2px solid var(--color-key-700);outline-offset:1px;}\n"
   ".kb-km-kind-name{font-size:1.0625rem;overflow-wrap:anywhere;}.kb-km-kind-count{font-variant-numeric:tabular-nums;font-weight:600;}\n"
   ".kb-km-kind-attrs,.kb-km-kind-examples{font-size:.8125rem;color:var(--color-neutral-solid-gray-700);overflow-wrap:anywhere;}\n"
   ".kb-km-c0{--km:var(--color-primitive-blue-600);--km-fill:var(--color-primitive-blue-100);}.kb-km-c1{--km:var(--color-primitive-green-600);--km-fill:var(--color-primitive-green-100);}.kb-km-c2{--km:var(--color-primitive-orange-600);--km-fill:var(--color-primitive-orange-100);}.kb-km-c3{--km:var(--color-primitive-purple-600);--km-fill:var(--color-primitive-purple-100);}.kb-km-c4{--km:var(--color-primitive-cyan-600);--km-fill:var(--color-primitive-cyan-100);}.kb-km-c5{--km:var(--color-primitive-magenta-600);--km-fill:var(--color-primitive-magenta-100);}\n"
   ".kb-km-crumbs{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;margin-block:.5rem;}.kb-km-sep{color:var(--color-neutral-solid-gray-600);}\n"
   ".kb-km-link{padding:0;border:0;background:none;font:inherit;color:var(--color-key-900);text-decoration:underline;cursor:pointer;min-height:2rem;text-align:start;overflow-wrap:anywhere;}\n"
   ".kb-km-layout{display:grid;gap:1rem;}.kb-km-map{min-width:0;}\n"
   ".kb-km-list{list-style:none;padding:0;margin:0;max-height:24rem;overflow:auto;}.kb-km-list li{padding-block:.25rem;border-bottom:1px solid var(--color-neutral-solid-gray-100);}\n"
   ".kb-data-table.kb-km-facts{min-width:0;}.kb-km-facts th{width:35%;font-weight:600;}.kb-km-facts td{overflow-wrap:anywhere;}.kb-graph .kb-graph-node text{font-size:calc(14px * var(--km-s,1));stroke-width:calc(3px * var(--km-s,1));}.kb-graph .kb-graph-edge-label{font-size:calc(12px * var(--km-s,1));stroke-width:calc(3px * var(--km-s,1));}.kb-graph .kb-km-count{font-size:calc(13px * var(--km-s,1));font-weight:700;}\n"
   ".kb-km-attrs code,.kb-km-summary code,.kb-console .kb-footnote code{font-family:var(--hig-font-mono,ui-monospace,SFMono-Regular,Menlo,monospace);font-size:.875rem;}.kb-km-attrs{list-style:none;padding:0;margin:0;}.kb-km-attrs li{padding-block:.125rem;}\n"
   ".kb-graph-node.kb-km-c0 circle,.kb-graph-node.kb-km-c1 circle,.kb-graph-node.kb-km-c2 circle,.kb-graph-node.kb-km-c3 circle,.kb-graph-node.kb-km-c4 circle,.kb-graph-node.kb-km-c5 circle{fill:var(--km-fill);stroke:var(--km);stroke-width:2;}\n"
   ".kb-km-center circle{stroke-width:4;}.kb-km-count{font-size:13px;font-weight:700;}.kb-km-arrow{fill:var(--color-neutral-solid-gray-500);}\n"
   ".kb-graph-node{cursor:pointer;}\n"
   ".kb-km-search{margin-block:.5rem 1rem;max-width:32rem;}.kb-km-results{border:1px solid var(--color-neutral-solid-gray-200);border-radius:.5rem;padding:.25rem .75rem;margin-top:.5rem;}\n"
   ".kb-km-map .kb-actions{display:flex;flex-wrap:wrap;gap:.25rem;}.kb-km-map .kb-actions .dads-button{width:auto;}@media(max-width:48rem){.kb-km-map .kb-graph{aspect-ratio:4/5;}}.kb-km-pinned circle{stroke-dasharray:4 3;}#km-canvas-reset[hidden],.kb-km-results[hidden]{display:none;}.kb-km-kind-whole{font-size:.8125rem;font-weight:600;}.kb-km-kind--unloaded{border-style:dashed;border-inline-start-style:solid;}\n"
   "@media(min-width:64rem){.kb-km-layout{grid-template-columns:minmax(0,3fr) minmax(16rem,2fr);align-items:start;}}\n"
   ".kb-about{margin-block:1.5rem;padding:1rem;border:1px solid var(--color-neutral-solid-gray-200);border-radius:.5rem;}\n"
   ".kb-about summary{cursor:pointer;font-weight:600;padding-block:.625rem;}\n"
   ".kb-about li{margin-block:.5rem;}\n"
   ".kb-workbench-header:not(:has(.dads-heading)){padding-block:0 .75rem;}\n"
   "@media(min-width:48rem){.kb-explore-controls.kb-db-create{grid-template-columns:auto auto;justify-content:start;}}\n"
   ".kb-explore-controls{display:grid;gap:.75rem;align-items:end;margin-bottom:1rem;}\n"
   ".kb-explore-controls>*{min-width:0;}\n"
   ".kb-db-open{padding:0;border:0;background:none;font:inherit;font-weight:700;color:var(--color-key-900);text-decoration:underline;cursor:pointer;min-height:2.75rem;text-align:start;overflow-wrap:break-word;}\n"
   ".kb-db-table .kb-badge,.kb-db-table .kb-inline-action{white-space:nowrap;}\n"
   ".kb-table-wrap,.kb-graph-wrap{overflow:auto;border:1px solid var(--color-neutral-solid-gray-200);border-radius:.5rem;}\n"
   ".kb-data-table{width:100%;min-width:42rem;border-collapse:collapse;}\n"
   ".kb-data-table th{position:sticky;top:0;background:var(--color-neutral-white);color:var(--color-neutral-solid-gray-900);z-index:1;}\n"
   ".kb-data-table th,.kb-data-table td{text-align:left;padding:.65rem;border-bottom:1px solid var(--color-neutral-solid-gray-200);max-width:30rem;overflow-wrap:anywhere;}\n"
   ".kb-graph-wrap{background:var(--color-neutral-white);color:var(--color-neutral-solid-gray-800);touch-action:pan-x pan-y;}\n"
   ".kb-graph{display:block;width:100%;min-height:18rem;aspect-ratio:900/560;touch-action:none;cursor:grab;}\n"
   ".kb-graph:active{cursor:grabbing;}\n"
   ".kb-graph-edge{stroke:var(--color-neutral-solid-gray-400);stroke-width:1.5;}\n"
   ".kb-graph-edge-label,.kb-graph-node text{font-size:12px;fill:var(--color-neutral-solid-gray-800);paint-order:stroke;stroke:var(--color-neutral-white);stroke-width:3px;}\n"
   ".kb-graph-node circle{fill:var(--color-key-100);stroke:var(--color-key-700);stroke-width:2;}\n"
   ".kb-graph-node--value circle{fill:var(--color-primitive-green-50);stroke:var(--color-primitive-green-700);}\n"
   ".kb-graph-list{max-height:12rem;overflow:auto;}\n"
   ".kb-schema-table{width:100%;min-width:32rem;}\n"
   ".kb-query-tools{display:grid;gap:1rem;margin-top:1rem;}\n"
   ".kb-query-layout{display:grid;gap:1rem;}\n"
   ".kb-result-links{display:grid;gap:.5rem;margin-block:.75rem;}\n"
   ".kb-result-links a{overflow-wrap:anywhere;}\n"
   ".kb-chips{display:flex;gap:.4rem;flex-wrap:wrap;margin-block:.5rem;}\n"
   ".kb-chip{min-height:2.5rem;padding:.35rem .65rem;border:1px solid var(--color-neutral-solid-gray-300);border-radius:999px;background:var(--color-neutral-white);}\n"
   ;; Result rows are wide and must not push the page sideways — the pane
   ;; scrolls inside itself.
   ".kb-out{max-height:24em;overflow:auto;white-space:pre;"
   "font-variant-numeric:tabular-nums;}\n"
   "@media(max-width:48rem){"
   ".dds-ext-container{padding-inline:max(1rem,env(safe-area-inset-left)) max(1rem,env(safe-area-inset-right));}"
   ".dds-ext-hero{padding-block:1.5rem 1rem;}"
   ".kb-actions{display:grid;grid-template-columns:1fr;width:100%;}"
   ".kb-actions .dads-button{width:100%;justify-content:center;}"
   ".kb-console-nav{margin-inline:-1rem;}"
   ".kb-db-table th:nth-child(2),.kb-db-table td:nth-child(2),.kb-db-table th:nth-child(4),.kb-db-table td:nth-child(4){display:none;}"
   ".kb-audit{font-size:.8125rem;}"
   "}\n"
   "@media(min-width:48rem){.kb-explore-controls{grid-template-columns:minmax(14rem,2fr) 8rem minmax(12rem,1fr) auto;}.kb-query-tools{grid-template-columns:1fr 1fr;}}\n"
   "@media(min-width:64rem){.kb-query-layout{grid-template-columns:minmax(20rem,2fr) minmax(18rem,1fr);}.kb-console-nav a[aria-current=page]{box-shadow:inset .2rem 0 var(--color-key-700);}}\n"))

(def page-css
  (str base-css
       ".kb-console .dds-ext-card,.kb-console .kb-query-layout>*{min-width:0;overflow-wrap:anywhere;}"
       ".kb-console .dads-input-text,.kb-console .dads-textarea,.kb-console .dads-select,.kb-console .dads-select__control{width:100%;min-width:0;}"
       ".kb-console input,.kb-console textarea,.kb-console select{max-width:100%;box-sizing:border-box;}"
       ".kb-console .kb-actions{display:flex;flex-wrap:wrap;gap:var(--hig-spacing-2);margin-block:var(--hig-spacing-2);}"
       ".kb-console pre{max-width:100%;overflow:auto;font-family:var(--hig-font-mono);white-space:pre-wrap;overflow-wrap:anywhere;}"
       ".kb-console .kb-code{font-family:var(--hig-font-mono);}"))

(def default-sign-in-href
  "Host default for graph.kotoba.cloud consumption. Mount may override via
   host.signInHref; :not-signed-in primary MUST use this (or the override)."
  "https://auth.kotoba.cloud/sign-in?return_to=https://graph.kotoba.cloud/")

(def auth-gate-defaults
  "Optional placeholders only — host owns JA/EN copy for production."
  {:not-signed-in {:title "Sign in to open GraphDB"
                   :body "Tenant metrics stay hidden until a session exists. No placeholder counts are shown."
                   :primary-label "Sign in"}
   :signed-in-empty {:title "Nothing to show here yet"
                     :body "You are signed in. This panel is empty until the host loads tenant data or a snapshot."
                     :primary-label "Continue"}})

(defn auth-gate
  "LOCKED empty-state contract shared with graph.kotoba.cloud.

   States ONLY: :not-signed-in | :signed-in-empty (no :loading).
   DOM: [data-auth-gate][data-panel=<id>][data-state=…],
        a|button[data-auth-gate-primary], optional [data-auth-gate-secondary].
   :not-signed-in primary MUST use sign-in href (default-sign-in-href).
   :signed-in-empty primary is a host action only — never a sign-in href."
  [{:keys [state panel title body primary secondary attrs]}]
  (let [state-kw (keyword state)]
    (when-not (#{:not-signed-in :signed-in-empty} state-kw)
      (throw (ex-info "auth-gate state must be :not-signed-in or :signed-in-empty"
                      {:state state})))
    (let [panel-id (name (or panel "overview"))
          defaults (get auth-gate-defaults state-kw)
          primary (or primary {})
          title (or title (:title defaults) "")
          body (or body (:body defaults) "")
          label (or (:label primary) (:primary-label defaults) "")
          href (:href primary)
          sign-in? (= state-kw :not-signed-in)
          resolved-href (when sign-in? (or href default-sign-in-href))
          action-href (when-not sign-in? href)
          primary-el (if sign-in?
                       (dds/button label {:type :solid-fill
                                          :href resolved-href
                                          :attrs {:data-auth-gate-primary true}})
                       (if action-href
                         (dds/button label {:type :solid-fill
                                            :href action-href
                                            :attrs {:data-auth-gate-primary true}})
                         (dds/button label {:type :solid-fill
                                            :attrs {:data-auth-gate-primary true
                                                    :type "button"}})))
          secondary-el (when secondary
                         (let [sec (if (map? secondary) secondary {:label (str secondary)})
                               sec-label (or (:label sec) "")
                               sec-href (:href sec)]
                           (cond-> [:span {:data-auth-gate-secondary true}]
                             sec-href (conj [:a {:href sec-href} sec-label])
                             (and (not sec-href) (seq sec-label)) (conj sec-label))))]
      [:div (merge {:data-auth-gate true
                  :data-panel panel-id
                  :data-state (name state-kw)
                  :class "kb-auth-gate"}
                 attrs)
     (dds/card
      (dds/heading 3 title {:size "20"})
      [:p body]
      (cond-> [:div {:class "kb-actions"} primary-el]
        secondary-el (conj secondary-el)))])))

(defn- panel-auth-gate
  "Default gate sibling for a workbench panel. Host copy via :auth-gate options."
  [panel-id options]
  (let [cfg (merge {:state :not-signed-in :panel panel-id}
                   (get options :auth-gate)
                   {:panel panel-id})]
    (auth-gate cfg)))

(defn- field
  "A value filled at runtime. Starts at `—` so an unfilled field is visibly
  unknown rather than plausibly zero."
  [name]
  [:strong {:class "kb-metric" :data-field name} "—"])

(defn- stat-card
  [title body & footnote]
  (dds/card
   (dds/heading 3 title {:size "20"})
   [:p body]
   (into [:p {:class "kb-footnote kb-mut"}] footnote)))

(defn- explore-controls
  [options prefix]
  [:div {:class "kb-explore-controls"}
   (dds/form-field
    {:label (t options "データベース" "Database") :for (str prefix "-db")
     :support (t options "一覧から選ぶか名前を入力。読み取りのみ。"
                 "Pick from the list or type a name. Read-only.")}
    (dds/input-text {:id (str prefix "-db") :data-explore-db true :list "kb-db-options"
                     :autocomplete "off" :placeholder "agent-memory"}))
   (dds/form-field
    {:label (t options "読み込む件数" "Facts to load") :for (str prefix "-limit")}
    (dds/select {:id (str prefix "-limit") :attrs {:data-explore-limit true} :value "500"}
                [["100" "100"] ["500" "500"] ["1000" "1000"]]))
   (dds/form-field
    {:label (t options "読み込んだ行を絞り込む" "Filter loaded rows") :for (str prefix "-filter")}
    (dds/input-text {:id (str prefix "-filter") :data-explore-filter true
                     :type "search" :autocomplete "off" :placeholder "entity, attribute, value"}))
   (dds/button (t options "読み込む" "Load") {:type :solid-fill
                            :attrs {:type "button" :data-explore-load true}})])

(defn overview-panel [options]
  ;; 2026-09-25 (kotoba-uiux, task-first): the database list is the task, so
  ;; it comes first and carries the one create action. Usage metrics follow;
  ;; how the store works (CID, archive keeps history, observed ontology,
  ;; writes need a capability) is one disclosure instead of two cards and a
  ;; three-step list that sat between the heading and the databases.
  [:div {:id "overview" :data-panel true}
     (panel-auth-gate "overview" options)
     (dds/section {:title (t options "データベース" "Databases")}
       (dds/card
        [:div {:class "kb-explore-controls kb-db-create"}
         (dds/form-field
          {:label (t options "新しいデータベース" "New database") :for "db-create-name"
           :support (t options "英数字とハイフンの短い名前（例: agent-memory）。"
                              "A short name of letters, digits and hyphens (e.g. agent-memory).")}
          (dds/input-text {:id "db-create-name" :autocomplete "off" :placeholder "agent-memory"}))
         (dds/button (t options "作成" "Create")
                   {:type :solid-fill :attrs {:id "db-create" :type "button"}})]
        [:p {:id "db-state" :class "kb-footnote" :data-bad "0" :aria-live "polite"} ""]
        [:p {:class "kb-footnote kb-mut"} [:strong (field "database-count")] (t options " 件" " databases")]
        [:div {:class "kb-table-wrap" :tabindex "0" :aria-label (t options "データベース一覧。小画面では横にスクロールしてください"
                              "Databases; scroll horizontally on small screens")}
         [:table {:class "kb-db-table"}
          [:thead [:tr [:th {:scope "col"} (t options "名前" "Name")]
            [:th {:scope "col"} (t options "種別" "Kind")]
            [:th {:scope "col"} (t options "状態" "Status")]
            [:th {:scope "col"} "CID"]
            [:th {:scope "col"} (t options "操作" "Actions")]]]
          [:tbody {:id "db-list-rows"}]]]
        [:p {:id "db-list-empty" :class "kb-footnote kb-mut" :hidden true}
         (t options "まだデータベースがありません。上で名前を入れて作成してください。"
                    "No databases yet. Enter a name above to create one.")]
        [:div {:id "db-tombstone-confirm" :class "kb-confirm" :hidden true}
         (dds/heading 3 (t options "アーカイブの確認" "Confirm archive") {:size "20"})
         [:p (t options "履歴は消えません。データベース "
                "History is kept. Database ")
             [:strong {:id "db-tombstone-target"} ""]
             (t options " を非アクティブにします（後で復元できます）。続けるにはデータベース名を入力してください。"
                        " becomes inactive (you can restore it later). Type the database name to continue.")]
         (dds/form-field {:label (t options "データベース名" "Database name") :for "db-tombstone-name"}
                         (dds/input-text {:id "db-tombstone-name" :autocomplete "off"}))
         [:div {:class "kb-actions"}
          (dds/button (t options "アーカイブ" "Archive") {:type :outline :attrs {:id "db-tombstone-run" :type "button" :disabled true}})
          (dds/button (t options "キャンセル" "Cancel") {:type :text :attrs {:id "db-tombstone-cancel" :type "button"}})]]))
     ;; Metric region: hidden / aria-hidden while :not-signed-in so data-field
     ;; tiles never present bare "—" as live values before a tenant session.
     [:div {:data-overview-metrics true :aria-hidden "true"}
      (dds/section {:title (t options "使用状況" "Usage")}
        (dds/grid {}
          (stat-card (t options "プラン" "Plan") (field "tier")
                     (t options "このワークスペースの契約。" "This workspace's plan."))
          (stat-card (t options "保存（Pin）" "Pins")
                     [:span (field "used-pins") " / " (field "quota-pins")]
                     (t options "残り " "Remaining ") (field "remaining-pins") (t options "。" "."))
          (stat-card (t options "容量" "Storage")
                     [:span (field "used-bytes") " / " (field "quota-bytes")]
                     (t options "残り " "Remaining ") (field "remaining-bytes") (t options "。" "."))
          (stat-card (t options "保存済み" "Pinned") (field "pinned") (t options "永続化済み。" "Persisted."))
          (stat-card (t options "保存中" "Pinning") (field "pinning")
                     (t options "処理待ちまたは処理中。" "Queued or in progress."))
          (stat-card (t options "失敗" "Failed") (field "failed")
                     (t options "0 以外なら確認が必要です。" "Anything other than 0 needs attention."))))]
     [:details {:class "kb-about"}
      [:summary (t options "このデータベースの仕組み" "How this database works")]
      [:ul
       [:li (t options "データはコンテンツアドレス（CID）で保存されます。名前は操作用の別名で、正本は CID です。"
               "Data is stored content-addressed. Names are working aliases; the CID is the canonical copy.")
        " " [:a {:href "#pins" :data-tab true} (t options "Pins / CID を見る" "See Pins / CID")]]
       [:li (t options "アーカイブは履歴を消しません。いつでも復元できます。"
               "Archiving never erases history; a database can be restored.")]
       [:li (t options "オントロジーは読み込んだデータから観測した属性と型です（宣言されたスキーマではありません）。"
               "The ontology is the attributes and types observed in loaded data, not a declared schema.")]
       [:li (t options "書き込みにはログインだけでなく、Keys / 認可で発行する明示的な権限が必要です。"
               "Writes need an explicit capability from Keys & permissions, not just the sign-in session.")]]]])

(defn graph-panel [options]
  ;; 2026-09-25: the knowledge map. Before this the panel drew raw datoms —
  ;; entity ids and values on one circle — which answered nothing about what
  ;; the database knows. Now: the kinds of things it holds (with counts and
  ;; readable examples), how kinds relate, one kind's members, and one
  ;; thing's facts and neighbours. Ids and old controls keep their names.
  [:div {:id "graph" :data-panel true}
     (panel-auth-gate "graph" options)
     (dds/section {:title (t options "ナレッジマップ" "Knowledge map")}
       (dds/card
        (explore-controls options "graph-view")
        [:p {:data-explore-state true :class "kb-footnote" :data-bad "0" :aria-live "polite"}
         (t options "データベースを選んで「読み込む」を押すと、何が入っているかがここに表示されます。"
                   "Pick a database and Load to see what it holds.")]
        [:p {:id "km-summary" :class "kb-km-summary" :aria-live "polite"}]
        [:p {:id "graph-view-empty" :hidden true}
         (t options "まだ表示できるものがありません。別のデータベースを選ぶか、読み込む件数を増やしてください。"
                    "Nothing to show yet. Pick another database or load more facts.")]
        [:div {:id "km-body" :hidden true}
         [:div {:class "kb-km-search"}
          (dds/form-field {:label (t options "名前や値で探す" "Find by name or value") :for "km-search"}
                          (dds/input-text {:id "km-search" :type "search" :autocomplete "off"
                                           :placeholder (t options "例: 川崎、graph" "e.g. Kawasaki, graph")}))
          [:ul {:id "km-search-results" :class "kb-km-list kb-km-results" :hidden true :aria-live "polite"}]]
         (dds/heading 3 (t options "入っているものの種類" "Kinds of things") {:size "20"})
         [:div {:id "km-kinds" :class "kb-km-kinds"}]
         [:nav {:id "km-crumbs" :class "kb-km-crumbs" :aria-label (t options "表示中の範囲" "Current view")}]
         [:div {:class "kb-km-layout"}
          [:div {:class "kb-km-map"}
           [:div {:class "kb-graph-wrap" :tabindex "0"
                  :aria-label (t options "種類とつながりの図。ノードを選ぶと詳しく表示します"
                                        "Map of kinds and connections; select a node for details")}
            [:svg {:id "graph-view-svg" :class "kb-graph" :viewBox "0 0 900 560" :role "list"
                   :aria-label (t options "種類とつながり" "Kinds and connections")}]]
           [:div {:class "kb-actions" :aria-label (t options "図の表示操作" "Map viewport controls")}
            (dds/button (t options "拡大" "Zoom in") {:type :text :size "sm" :attrs {:id "graph-zoom-in" :type "button"}})
            (dds/button (t options "縮小" "Zoom out") {:type :text :size "sm" :attrs {:id "graph-zoom-out" :type "button"}})
            (dds/button (t options "元に戻す" "Reset") {:type :text :size "sm" :attrs {:id "graph-reset" :type "button"}})
            (dds/button (t options "展開をやり直す" "Clear expansions") {:type :text :size "sm" :attrs {:id "km-canvas-reset" :type "button" :hidden true}})]
           [:p {:class "kb-footnote kb-mut"} (t options "ノードを選ぶとつながりを広げます。ドラッグで位置を固定できます。"
                                              "Select a node to expand its connections; drag to pin it.")]]
          [:aside {:class "kb-node-inspector" :aria-label (t options "選択中のもの" "Selection")}
           (dds/heading 3 [:span {:id "graph-selection" :aria-live "polite"}
                           (t options "種類かノードを選ぶと、そのものの内容とつながりが表示されます。"
                              "Pick a kind or a node to see what it holds and how it connects.")] {:size "20"})
           [:div {:id "km-list-wrap" :hidden true}
            [:p {:id "km-list-title" :class "kb-footnote kb-mut"}]
            [:ul {:id "km-list" :class "kb-km-list"}]]
           [:div {:id "km-entity" :hidden true :tabindex "-1"}
            [:p {:id "km-entity-kind" :class "kb-footnote kb-mut"}]
            [:table {:class "kb-data-table kb-km-facts"}
             [:thead [:tr [:th {:scope "col"} (t options "項目" "Field")] [:th {:scope "col"} (t options "値" "Value")]]]
             [:tbody {:id "graph-selection-rows"}]]
            [:div {:id "km-incoming-wrap" :hidden true}
             [:p {:class "kb-footnote kb-mut"} (t options "これを参照しているもの" "Referenced by")]
             [:ul {:id "km-incoming" :class "kb-km-list"}]]]]]]
        [:p {:class "kb-footnote kb-mut"}
         [:strong (field "graph-nodes")] (t options " 件のもの · " " things · ")
         [:strong (field "graph-edges")] (t options " 件のつながり。種類は属性の名前空間（例: " " connections. Kinds come from the attribute namespace (e.g. ")
         [:code ":paper/title"] (t options " → paper）、名前は name / title などの属性から推定しています。"
                                  " → paper); names come from attributes such as name or title.")]
        [:details {:class "kb-about"}
         [:summary (t options "詳しいツール" "More tools")]
         [:details
          [:summary (t options "読み上げ用のつながり一覧" "Accessible connection list")]
          [:ul {:id "graph-view-list" :class "kb-graph-list"}]]
         [:div {:class "kb-query-tools"}
          (dds/form-field {:label (t options "レイアウト名" "Layout name") :for "layout-name"}
                          (dds/input-text {:id "layout-name" :autocomplete "off" :placeholder "investigation-layout"}))
          [:div {:class "kb-actions"}
           (dds/button (t options "レイアウトを保存" "Save the layout") {:type :outline :attrs {:id "layout-save" :type "button"}})
           (dds/button (t options "まとまりを数える" "Count clusters") {:type :outline :attrs {:id "community-run" :type "button"}})]]
         [:p {:id "layout-state" :class "kb-footnote" :data-bad "0" :aria-live "polite"} ""]]))])

(defn ontology-panel [options]
  [:div {:id "ontology" :data-panel true}
     (panel-auth-gate "ontology" options)
     (dds/section {:title (t options "オントロジー（推定）" "Ontology (inferred)")}
       (dds/card
        [:p (t options "読み込んだ事実から、どんな種類のものが、どんな項目を持ち、何とつながっているかをまとめます。宣言されたスキーマではありません。"
                "What kinds of things the loaded facts describe, the fields each kind has, and what they link to. Inferred, not a declared schema.")]
        (explore-controls options "schema-view")
        [:p {:data-explore-state true :class "kb-footnote" :data-bad "0" :aria-live "polite"}
         (t options "データベースを選んで「読み込む」を押してください。" "Pick a database and Load.")]
        [:p [:strong (field "schema-kinds")] (t options " 種類 · " " kinds · ")
         [:strong (field "schema-attributes")] (t options " 項目" " fields")]
        [:p {:id "schema-view-empty"}
          (t options "まだ推定できるものはありません。" "Nothing to infer yet.")]
        [:div {:class "kb-table-wrap" :tabindex "0" :aria-label (t options "推定オントロジー" "Inferred ontology")}
         [:table {:class "kb-data-table kb-schema-table"}
          [:thead [:tr [:th {:scope "col"} (t options "種類" "Kind")]
            [:th {:scope "col"} (t options "件数" "Count")]
            [:th {:scope "col"} (t options "項目（型 · 持っている割合）" "Fields (type · share that have it)")]
            [:th {:scope "col"} (t options "つながり" "Links")]]]
          [:tbody {:id "schema-view-rows"}]]]))
     (dds/section {:title (t options "スキーママイグレーション / DDL · Controlled Beta"
                             "Schema migration / DDL · Controlled Beta")}
       (dds/card
        [:p (t options "append-only Datomic schema transactionをplanし、同じCACAO write planeで適用します。適用結果はtenant-isolated IPLD migration receiptとして保存します。宣言identを足す操作であり、上の推定表をオントロジーに昇格するものではありません。"
                "Plans an append-only Datomic schema transaction and applies it through the same CACAO write plane. The result is saved as a tenant-isolated IPLD migration receipt. This adds declared idents; it does not promote the inferred table above into an ontology.")]
        (dds/form-field {:label (t options "マイグレーション名" "Migration name") :for "migration-name"}
                        (dds/input-text {:id "migration-name" :autocomplete "off" :placeholder "20260815-person-name"}))
        (dds/form-field {:label (t options "データベース" "Database") :for "migration-db"}
                        (dds/input-text {:id "migration-db" :autocomplete "off" :placeholder "agent-memory"}))
        (dds/form-field {:label (t options "スキーマトランザクションEDN" "Schema transaction EDN") :for "migration-tx"}
                        (dds/textarea {:id "migration-tx" :rows 8 :spellcheck "false"}))
        [:div {:class "kb-actions"}
         (dds/button (t options "適用内容を確認" "Review the plan") {:type :outline :attrs {:id "migration-plan" :type "button"}})
         (dds/button (t options "適用" "Apply") {:type :solid-fill :attrs {:id "migration-apply" :type "button"}})]
        [:p {:id "migration-state" :class "kb-footnote" :data-bad "0" :aria-live "assertive"} ""]))])

(defn datoms-panel [options]
  [:div {:id "datoms" :data-panel true}
     (panel-auth-gate "datoms" options)
     (dds/section {:title (t options "データム · Beta" "Datoms · Beta")}
       (dds/card
        [:p (t options "datomをEntity・Attribute・Valueの3列で閲覧します。同じbounded snapshotをGraph viewerと共有します。"
                "Browses datoms as three columns: Entity, Attribute, Value. It shares the same bounded snapshot with the graph viewer.")]
        (explore-controls options "table-view")
        [:p {:data-explore-state true :class "kb-footnote" :data-bad "0" :aria-live "polite"}
         (t options "Databaseを指定してdatom snapshotを読み込んでください。"
                   "Specify a database to load a datom snapshot.")]
        [:div {:class "kb-table-wrap" :tabindex "0" :aria-label (t options "Datomテーブル。小画面では横にスクロールしてください"
                              "Datom table; scroll horizontally on small screens")}
         [:table {:class "kb-data-table"}
          [:thead [:tr [:th {:scope "col"} "Entity"] [:th {:scope "col"} "Attribute"] [:th {:scope "col"} "Value"]]]
          [:tbody {:id "table-view-rows"}]]]
        [:p {:id "table-view-empty" :hidden true}
          (t options "一致するdatomはありません。filterを消すか、別のdatabaseを読み込んでください。"
                     "No datoms match. Clear the filter or load a different database.")]
        [:div {:class "kb-actions"}
         (dds/button (t options "CSVをexport" "Export CSV") {:type :outline :attrs {:id "table-export" :type "button" :disabled true}})]
        [:p {:class "kb-footnote kb-mut"}
         (t options "表示 " "Showing ") (field "table-visible") " / " (field "table-total")
             (t options " rows。最大100 rowsのread-only previewです。row編集・server-side sortは未対応です。"
                        " rows. A read-only preview capped at 100 rows. Row editing and server-side sort are not supported.")]))])

(defn query-panel [options]
  [:div {:id "query" :data-panel true}
     (panel-auth-gate "query" options)
     (dds/section {:title (t options "クエリワークベンチ" "Query workbench")}
       [:div {:class "kb-query-layout"}
        (dds/card
         (dds/form-field
          {:label (t options "データベース" "Database") :for "q-db"
           :support (t options "tenant内のdatabase handle。例: agent-memory"
                              "A database handle within the tenant. Example: agent-memory")}
          (dds/input-text {:id "q-db" :name "q-db" :list "kb-db-options" :autocomplete "off" :placeholder "agent-memory"}))
         (dds/form-field
          {:label (t options "言語" "Language") :for "q-lang"}
          (dds/select {:id "q-lang" :name "q-lang" :value "datalog"}
                      [["datalog" "Datalog"] ["sql" "SQL"] ["cypher" "Cypher"] ["sparql" "SPARQL"]]))
         (dds/form-field
          {:label (t options "クエリ" "Query") :for "q-edn"
           :support (t options "このconsoleではread-onlyです。未対応構文はfail closedで拒否されます。"
                              "Read-only in this console. Unsupported syntax is refused fail-closed.")}
         (dds/textarea {:id "q-edn" :name "q-edn" :rows 8 :spellcheck "false"}))
         [:div {:id "q-suggestions" :class "kb-chips"
             :aria-label (t options "クエリ補完候補" "Query autocomplete suggestions")}]
         [:div {:class "kb-actions"}
          (dds/button (t options "実行" "Run") {:type :solid-fill :attrs {:id "q-run" :type "button"}})
          (dds/button (t options "診断" "Diagnose") {:type :outline :attrs {:id "q-diagnose" :type "button"}})]
         [:p {:id "q-state" :class "kb-footnote" :data-bad "0" :aria-live "polite"} ""])
        (dds/card
         (dds/heading 3 (t options "結果" "Result") {:size "20"})
         [:div {:id "q-links" :class "kb-result-links"}]
         [:pre {:id "q-out" :class "kb-out"}
              (t options "まだクエリを実行していません。" "No query has been run yet.")]) ]
       (dds/card
        (dds/heading 3 (t options "プランナー診断" "Planner diagnostics") {:size "20"})
        [:p {:class "kb-footnote kb-mut"} (t options "dbStatsとquery shapeを表示します。engine operator timing/cardinalityを返すEXPLAIN/PROFILEではありません。"
                   "Shows dbStats and the query shape. This is not EXPLAIN/PROFILE returning engine operator timing or cardinality.")]
        [:pre {:id "q-plan-out" :class "kb-out"}
              (t options "診断を実行してください。" "Run the diagnostics.")])
       [:div {:class "kb-query-tools"}
        (dds/card
         (dds/heading 3 (t options "セッション履歴" "Session history") {:size "20"})
         [:p {:class "kb-footnote kb-mut"} (t options "成功したqueryをこのtab内だけで最大20件保持します。browserを閉じると消えます。"
                   "Keeps up to 20 successful queries in this tab only. Closing the browser discards them.")]
         (dds/select {:id "q-history" :name "q-history"}
                    [["" (t options "セッション履歴" "Session history")]]))
        (dds/card
         (dds/heading 3 (t options "保存済みクエリ" "Saved queries") {:size "20"})
         [:p {:class "kb-footnote kb-mut"} (t options "明示的に保存したqueryだけを、tenant-isolated IPLD documentとして最大50件同期します。削除はhistoryを消さないtombstoneです。"
                   "Only explicitly saved queries are synced, up to 50, as tenant-isolated IPLD documents. Removal is a tombstone — it never erases history.")]
         (dds/form-field {:label (t options "保存するクエリ名" "Saved query name") :for "q-save-name"}
                         (dds/input-text {:id "q-save-name" :autocomplete "off" :placeholder "Recent entities"}))
         (dds/select {:id "q-saved" :name "q-saved"}
                    [["" (t options "保存済みクエリを選択" "Choose a saved query")]])
         [:div {:class "kb-actions"}
          (dds/button (t options "Queryを保存" "Save the query")
                     {:type :outline :attrs {:id "q-save" :type "button"}})
          (dds/button (t options "保存を削除" "Remove the saved query")
                     {:type :text :attrs {:id "q-delete-saved" :type "button"}})])] )
     (dds/section {}
       (dds/card
        [:p {:class "kb-footnote kb-mut"}
         (t options "Datalogは互換XRPC " "Datalog uses the compatible XRPC ")
         [:code {:class "kb-code"} "datomic.q"]
         (t options "、SQL/SPARQL/Cypherは " ", SQL/SPARQL/Cypher use ")
         [:code {:class "kb-code"} "kg.query"]
         (t options " を使用します。これはNeo4j wire protocolや完全なopenCypher互換を意味しません。"
                    ". That does not mean Neo4j wire protocol or full openCypher compatibility.")]))])

(defn pins-panel [options]
  [:div {:id "pins" :data-panel true}
     (dds/section {:title (t options "CID / IPLDデータ" "CID / IPLD data")}
       (dds/card
        [:p (t options "このtenantが保持するpinをCID中心で表示します。CIDリンクは "
                "This shows the pins held by this tenant, centered on CIDs. A CID link opens ")
         [:code {:class "kb-code"} "/ipld/{cid}"]
         (t options " のimmutable blockを開きます。名前やrequest idは管理用metadataで、content identityではありません。"
                    ", the immutable block. Names and request ids are operational metadata, not content identity.")]
        [:p [:strong (field "pin-count")] (t options " オブジェクト" " objects")]
        [:p {:id "pins-state" :class "kb-footnote kb-mut" :data-bad "0" :aria-live "polite"} ""]
        [:div {:id "pin-list" :class "kb-pin-list"}]))
     (dds/section {:title (t options "Hashリンク" "Hash links")}
       (dds/card
        [:p (t options "正本リンク: " "Canonical link: ") [:code {:class "kb-code"} "/ipld/{cid}"]]
        [:p {:class "kb-footnote kb-mut"} (t options "GETはCID検証済みのimmutable bytesです。DB名はtenant内のhandleであり、graph/commitのcanonical identityはCIDです。"
                   "GET returns CID-verified immutable bytes. A DB name is a handle within the tenant; the canonical identity of a graph or commit is its CID.")]))])

(defn keys-panel [options]
  [:div {:id "keys" :data-panel true}
     (dds/section {:title (t options "Keys / 認可" "Keys & permissions")}
       (dds/card
        [:p (t options "writeはsession cookieだけでは実行しません。Authnが発行した短命Biscuitをmemory内だけに保持し、backendのscope・tenant ownership・CAS検査へ渡します。"
                "Writes never run on the session cookie alone. The short-lived Biscuit issued by authn is kept in memory only and passed to the backend's scope, tenant ownership and CAS checks.")]
        (dds/form-field {:label (t options "Biscuit認可情報" "Biscuit authorization") :for "cacao-token"
                         :support (t options "保存・URL化・log出力をしません。pageを離れると破棄します。"
                                            "Never stored, put in a URL, or logged. It is discarded when you leave the page.")}
                        (dds/input-text {:id "cacao-token" :type "password" :autocomplete "off" :spellcheck "false"}))
        (dds/form-field {:label (t options "データベース" "Database") :for "write-db"}
                        (dds/input-text {:id "write-db" :autocomplete "off" :placeholder "agent-memory"}))
        (dds/form-field {:label (t options "DatomicトランザクションEDN" "Datomic transaction EDN") :for "write-tx"
                         :support (t options "row add/retractとschema transactionを明示的にreviewして実行します。"
                                            "Review row add/retract and schema transactions explicitly before running them.")}
                        (dds/textarea {:id "write-tx" :rows 6 :spellcheck "false"}))
        (dds/button (t options "Transactionを実行" "Run the transaction") {:type :solid-fill :attrs {:id "row-write" :type "button"}})
        (dds/form-field {:label "Cypher CREATE" :for "cypher-write-query"
                         :support (t options "bounded parserが受理するCREATEのみ。一般的なCypher write全体ではありません。"
                                            "Only CREATE statements the bounded parser accepts — not Cypher writes in general.")}
                        (dds/textarea {:id "cypher-write-query" :rows 4 :spellcheck "false"}))
        (dds/button (t options "Cypher writeを実行" "Run the Cypher write") {:type :outline :attrs {:id "cypher-write" :type "button"}})
        [:p {:id "write-state" :class "kb-footnote" :data-bad "0" :aria-live "assertive"} ""]))
     (dds/section {:title (t options "RBAC権限付与 · Controlled Beta"
                             "RBAC authority grants · Controlled Beta")}
       (dds/card
        [:p (t options "grantは通常のUI設定ではなく、content-addressed authority basisが参照する専用 "
                "A grant is not an ordinary UI setting: it is committed with CACAO to the dedicated ")
             [:code "__authority"]
             (t options " graphへCACAO付きでcommitします。"
                        " graph that the content-addressed authority basis references.")]
        (dds/form-field {:label (t options "サブジェクトDID" "Subject DID") :for "rbac-subject"}
                        (dds/input-text {:id "rbac-subject" :autocomplete "off" :placeholder "did:key:..."}))
        (dds/form-field {:label (t options "権限" "Permission") :for "rbac-permission"}
                        (dds/select {:id "rbac-permission"}
                                    [["data:read" "data:read"] ["data:write" "data:write"] ["audit:read" "audit:read"] ["audit:export" "audit:export"]]))
        (dds/button (t options "Grantをcommit" "Commit the grant")
                     {:type :solid-fill :attrs {:id "rbac-apply" :type "button"}})))])

(defn activity-panel [options]
  [:div {:id "activity" :data-panel true}
     (dds/section {:title (t options "監査ログ" "Audit log")}
       (dds/card
        [:p (t options "このtenantに対してedgeが処理したreceiptです。別tenantの履歴は表示されません。"
                "Receipts the edge processed for this tenant. No other tenant's history appears here.")]
        [:p {:id "audit-state" :class "kb-footnote" :data-bad "0" :aria-live "polite"} ""]
        [:table {:class "kb-audit"}
         [:thead [:tr [:th (t options "時刻 (UTC)" "Time (UTC)")]
                [:th (t options "操作" "Action")]
                [:th (t options "結果" "Outcome")]
                [:th (t options "国" "Country")]
                [:th (t options "リクエストID" "Request id")]]]
         [:tbody {:id "audit-rows"}]]
        [:div {:class "kb-actions"}
         (dds/button (t options "さらに読み込む" "Load more") {:type :outline :attrs {:id "audit-more" :style "display:none"}})
         (dds/button (t options "NDJSONをexport" "NDJSON export")
                     {:type :outline :attrs {:id "audit-export" :type "button"}})]))])

(defn plan-panel [options]
  [:div {:id "plan" :data-panel true}
     (dds/section {:title (t options "バックアップ / PITR操作 · Controlled Beta"
                             "Backup / PITR operations · Controlled Beta")}
       (dds/card
        [:p (t options "現在のcontent-addressed basisとdbStatsをimmutable checkpoint metadataとして保存し、basis_tのas-of readで復旧可能性を訓練します。破壊的overwriteは行いません。"
                "Saves the current content-addressed basis and dbStats as immutable checkpoint metadata, then drills recoverability with an as-of read at basis_t. No destructive overwrite happens.")]
        (dds/form-field {:label (t options "データベース" "Database") :for "backup-db"}
                        (dds/input-text {:id "backup-db" :autocomplete "off" :placeholder "agent-memory"}))
        (dds/form-field {:label (t options "訓練用basis_t" "basis_t for drill") :for "backup-t"}
                        (dds/input-text {:id "backup-t" :inputmode "numeric" :autocomplete "off"}))
        [:div {:class "kb-actions"}
         (dds/button (t options "Checkpointを記録" "Record a checkpoint") {:type :outline :attrs {:id "backup-checkpoint" :type "button"}})
         (dds/button (t options "PITR読み取り訓練" "PITR read drill")
                     {:type :solid-fill :attrs {:id "recovery-drill" :type "button"}})]
        [:p {:id "backup-state" :class "kb-footnote" :data-bad "0" :aria-live "assertive"} ""]
        [:p {:class "kb-footnote kb-mut"} (t options "新databaseへのmaterialize、RPO/RTOを伴うproduction restore orchestrationは未実装です。"
                   "Materializing into a new database, and production restore orchestration with RPO/RTO, are not implemented.")]))
     (:benchmark options)
     (dds/section {:title (t options "アクセシビリティ検証" "Accessibility validation")}
       (dds/card
        [:p (t options "このdocumentで実行したsemantic self-checkです。自動検査は実利用者テストの代替ではありません。"
                "A semantic self-check run on this document. Automated checks do not replace testing with real users.")]
        [:ul {:id "a11y-results"}]
        [:p {:class "kb-footnote kb-mut"} (t options "screen reader検証は未完了です。VoiceOver/NVDA/実利用者によるtask completion studyは未実施。実施者・日時・支援技術・失敗taskを監査証跡として残す必要があります。"
                   "Screen reader verification is incomplete. No task completion study with VoiceOver/NVDA or real users has been run. Who ran one, when, with which assistive technology, and which tasks failed must be kept as an audit record.")]))
     (:billing options)
     (:maturity options)])

(defn view
  ([] (view {}))
  ;; :intro? false (2026-09-25) — a host whose page heading already names the
  ;; workbench drops the workbench's own heading and lead (one fact, one home);
  ;; the tenant line and load state stay.
  ([{:keys [header footer title heading-level intro?] :or {intro? true} :as options}]
  [:div {:class "dds-ext-container kb-console"}
   [:a {:class "kb-skip" :href "#console-main"}
    (t options "管理画面の本文へ移動" "Skip to the console body")]
   ;; The Worker serves this document only after resolving a viewer.
   header
   [:header {:class "kb-workbench-header"}
    (when intro?
      (dds/heading (or heading-level 1) (or title (t options "GraphDBワークベンチ" "GraphDB workbench")) {:size "28"}))
    (when intro?
      [:p {:class "kb-lead"}
       (t options "データベースを選び、グラフ・表・クエリで中身を調べます。"
                  "Pick a database, then explore it as a graph, a table or a query.")])
    [:p {:class "kb-footnote kb-mut kb-identity"}
    (t options "テナント " "Tenant ") (field "tenant")]
    [:p {:id "load-state" :class "kb-footnote" :data-bad "0" :aria-live "polite"} ""]]

   (into [:nav {:class "kb-console-nav"
               :aria-label (t options "GraphDBワークベンチ" "GraphDB workbench")}]
         (map (fn [{:keys [id label]}]
                [:a {:href (str "#" id) :data-tab true}
                 (t options label (get nav-labels-en id label))])
              panels))

   [:main {:id "console-main" :class "kb-console-main" :tabindex "-1"}
    [:datalist {:id "kb-db-options"}]
    (overview-panel options)

    (graph-panel options)

    (ontology-panel options)

    (datoms-panel options)

    (query-panel options)

    (pins-panel options)

    (keys-panel options)

    (activity-panel options)

    (plan-panel options) ]

   footer
   ]))

