(ns cloud-kotoba-dds.tokens
  "The cloud-kotoba-dds design tokens — one layer every component in this
   library reads, above the jp-go-dds `--hig-*` bridge (owner instruction
   2026-09-16: 「design-token, component に落とし込んでいって」).

   jp-go-dds gives the primitives and the `--hig-*` contract; DADS is light,
   and `jp-go-dds.dark` inverts the ramps. What that inversion cannot give
   is a raised surface in dark — ground and card land on the same grey — so
   the Bots workspace lifted its surfaces with `light-dark()` over the
   `--dds-light-*` snapshot. That lift, the radii the rounded components
   share, the two chrome layers and the motion floor were about to be
   copied into the third component; they are tokens now, defined once on
   `:root` and read by `.ck-*` everywhere:

     --ck-surface-ground / -raised / -hover / -border
     --ck-text / --ck-text-muted / --ck-accent / --ck-danger
     --ck-radius-sm / -md / -lg / -pill
     --ck-layer-top / --ck-layer-float
     --ck-motion (0s under prefers-reduced-motion)
     --ck-shadow-float
     --ck-composer-max-height

   Every value is a `--hig-*` token, a DADS semantic token, or a derivation
   (`light-dark`, `color-mix`) over the snapshot — no colour literal here,
   counted by `test/tokens_test.cljk`. A host retunes the library by
   redefining these on `:root` (or on a subtree); it never redefines a
   component's rule. `--ck-bots-*` remain as aliases so bots-css consumers
   keep working.

   Load order: jp-go-dds css → `tokens/bridge-css` → this `css` → component css."
  (:require [kotoba.lang.text :as str]))

(def css
  (str
   ":root{"
   ;; surfaces — light: the DADS semantic surfaces; dark: lifted, derived
   "--ck-surface-ground:light-dark(var(--hig-color-system-grouped-background),color-mix(in srgb,var(--dds-light-neutral-solid-gray-900) 70%,var(--dds-light-neutral-black)));"
   "--ck-surface-raised:light-dark(var(--hig-color-system-background),var(--dds-light-neutral-solid-gray-900));"
   "--ck-surface-hover:light-dark(var(--hig-color-quaternary-system-fill),color-mix(in srgb,var(--dds-light-neutral-solid-gray-900) 60%,var(--dds-light-neutral-solid-gray-800)));"
   "--ck-surface-border:light-dark(var(--hig-color-separator),color-mix(in srgb,var(--dds-light-neutral-solid-gray-900) 45%,var(--dds-light-neutral-solid-gray-800)));"
   ;; text and accents
   "--ck-text:var(--hig-color-label);"
   "--ck-text-muted:var(--hig-color-secondary-label);"
   "--ck-accent:var(--hig-color-tint);"
   "--ck-danger:var(--color-semantic-error-1);"
   "--ck-success:var(--color-semantic-success-1);"
   "--ck-warning:var(--color-semantic-warning-orange-1);"
   ;; shape — the four radii of the current conversation-app generation
   ;; (controls ~12, cards ~20, the composer / sheets ~28, pills), mapped
   ;; onto the bridge's ramp: sm 10 / lg 20 / xl 28 / capsule (2026-09-16,
   ;; owner: 「grok bots や chat gpt のトンマナ、デザイントークンで」; until
   ;; then md was 14 and lg 20)
   "--ck-radius-sm:var(--hig-radius-sm);"
   "--ck-radius-md:var(--hig-radius-lg);"
   "--ck-radius-lg:var(--hig-radius-xl);"
   "--ck-radius-pill:var(--hig-radius-capsule);"
   ;; chrome layers (shinkansen.audit :chrome-layers: top bar / floating
   ;; menu) — the numbers are jp-go-dds's --hig-z-* (tokens/layers), read
   ;; here rather than restated (2026-09-16: 20 / 80 had been written
   ;; beside a bridge that says sticky 20 / float 40 / toast 80)
   "--ck-layer-top:var(--hig-z-sticky,20);"
   "--ck-layer-float:var(--hig-z-float,40);"
   ;; floating surfaces cast a shadow derived from the border colour
   "--ck-shadow-float:0 0.5rem 1.5rem color-mix(in srgb,var(--ck-surface-border) 60%,transparent);"
   ;; the composer's textarea grows with its text up to this, then scrolls
   ;; (cloud-kotoba-dds.composer; 12rem = the itonami composer's 192px cap)
   "--ck-composer-max-height:12rem;"
   ;; motion floor: a component that animates reads this and gets 0 under
   ;; reduced motion — the duration is --hig-motion-reveal (tokens/motion)
   "--ck-motion:var(--hig-motion-reveal,180ms);"
   "}"
   "@media(prefers-reduced-motion:reduce){:root{--ck-motion:0s}}"))

(def names
  "The token names this layer defines (for consumers' tests: a component
   stylesheet may read these and `--hig-*`, nothing else)."
  (vec (map second (re-seq #"(--ck-[a-z0-9-]+):" css))))
