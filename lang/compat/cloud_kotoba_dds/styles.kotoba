(ns cloud-kotoba-dds.styles)

(def css
  "The conversation pattern's stylesheet — the tone of the current
   generation of conversation apps, written as generation rules over the
   design tokens rather than as a look (owner direction 2026-09-16: 「grok
   bots や chat gpt のトンマナ、デザイントークンで layout」). What that
   family does, and what this sheet does with tokens:

     dark-first, one neutral ramp + one accent → --ck-surface-* / --ck-text*
                                                 / --ck-accent (light-dark)
     no dividing lines; grouping by surface elevation and space
                                               → no border between sidebar,
                                                 toolbar, thread, composer;
                                                 the composer is a raised card
     radii 12 / 20 / 28 / full                  → --ck-radius-sm / -md / -lg / -pill
     pill and circular controls                 → --ck-radius-pill; send is a circle
     4px grid                                   → --hig-spacing-*
     large type, generous space                 → --hig-text-* body / title2

   Hooks are unchanged (go-* classes, data-ck-chat parts, .chat-workspace /
   .chat-sidebar / .chat-item / .chat-account / .chat-policy): a host that
   rendered the previous sheet renders this one. New: a host may set
   `data-history=\"drawer\"` on .chat-workspace to keep the history as a
   drawer on every band (a console that already has its own sidebar shows
   one sidebar, not two). Load after jp-go-dds bridge-css and
   cloud-kotoba-dds.tokens/css. No colour literal, no px colour rule."
  (str
   "[hidden]{display:none!important}"
   ;; --- the shell: one surface, no frame -------------------------------
   ".go-shell{display:flex;flex-direction:column;height:calc(100dvh - 5rem);min-height:36rem;max-height:64rem;min-width:0;border:0;border-radius:var(--ck-radius-lg);background:var(--ck-surface-raised);color:var(--ck-text);overflow:hidden;font-size:var(--hig-text-body-font-size);line-height:1.6}"
   ".go-shell *{box-sizing:border-box}"
   ".go-shell button,.go-shell input,.go-shell select,.go-shell textarea{font:inherit;color:inherit}"
   ".go-shell :focus-visible{outline:2px solid var(--ck-accent);outline-offset:2px}"
   ;; --- toolbar: ghost controls, no rule underneath ---------------------
   ".go-toolbar,.go-model-row,.go-compose-actions{display:flex;align-items:center;gap:var(--hig-spacing-2);flex-wrap:wrap}"
   ".go-toolbar{justify-content:space-between;min-height:3.25rem;padding:var(--hig-spacing-2) var(--hig-spacing-4);padding-top:max(var(--hig-spacing-2),env(safe-area-inset-top))}"
   ".go-toolbar>span{min-width:0;overflow-wrap:anywhere;font-size:var(--hig-text-subheadline-font-size)}"
   ".go-toolbar button,.go-toolbar select,[data-ck-chat=history-toggle],[data-ck-chat=history-close],[data-ck-chat=settings-open]{min-height:2.75rem;padding:0 var(--hig-spacing-3);border:0;border-radius:var(--ck-radius-pill);background:transparent;color:var(--ck-text);cursor:pointer}"
   ".go-toolbar button:hover,[data-ck-chat=history-toggle]:hover,[data-ck-chat=settings-open]:hover{background:var(--ck-surface-hover)}"
   ".go-free{margin-inline-start:var(--hig-spacing-2);color:var(--ck-text-muted);font-size:var(--hig-text-caption1-font-size)}"
   ;; --- model: a chip, not a form field ---------------------------------
   ".go-model-row{font-size:var(--hig-text-footnote-font-size)}"
   ".go-model-row label{display:none}"
   ".go-model-row small{flex-basis:100%;margin:0;color:var(--ck-text-muted)}"
   ;; the native select, dressed as a chip (its own arrow stays: a drawn
   ;; arrow would need a colour literal or a data URI)
   "[data-ck-chat=model]{max-width:100%;min-width:0;min-height:2.5rem;padding:0 var(--hig-spacing-2) 0 var(--hig-spacing-3);border:0;border-radius:var(--ck-radius-pill);background:var(--ck-surface-raised);color:var(--ck-text);font-size:var(--hig-text-footnote-font-size);font-weight:600;cursor:pointer}"
   ;; --- the conversation ------------------------------------------------
   ".go-conversation{position:relative;flex:1;min-height:0;display:flex;flex-direction:column}"
   ".go-welcome{margin:auto;max-width:40rem;padding:var(--hig-spacing-6) var(--hig-spacing-4);text-align:center}"
   ".go-welcome h1{margin:0 0 var(--hig-spacing-2);font-size:var(--hig-text-title2-font-size);font-weight:600;letter-spacing:-.01em}"
   ".go-welcome p{margin:0 0 var(--hig-spacing-3);color:var(--ck-text-muted)}"
   ".go-welcome a{color:var(--ck-accent)}"
   ".go-mark{color:var(--ck-accent);font-size:var(--hig-text-large-title-font-size)}"
   "[data-ck-chat=messages]{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;padding:var(--hig-spacing-4) max(var(--hig-spacing-4),calc((100% - 46rem)/2));scrollbar-gutter:stable}"
   "[data-ck-chat=messages]:empty{flex:0;padding:0}"
   ".go-message{max-width:46rem;min-width:0;margin:0 auto var(--hig-spacing-5);overflow-wrap:anywhere}"
   ;; the person's turn is a bubble on the right; the answer is the page
   ;; itself (no bubble) — the reader's eye goes to the answer
   ".go-user{width:fit-content;max-width:min(38rem,85%);margin-inline-start:auto;margin-inline-end:0;padding:var(--hig-spacing-3) var(--hig-spacing-4);border-radius:var(--ck-radius-md);background:var(--ck-surface-hover)}"
   ".go-user .go-role{display:none}"
   ".go-role{display:block;margin-bottom:var(--hig-spacing-2);color:var(--ck-text-muted);font-size:var(--hig-text-footnote-font-size);font-weight:600}"
   ".go-text{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.7}"
   ".go-image{display:block;max-width:100%;height:auto;border-radius:var(--ck-radius-md)}"
   ".go-steps{display:flex;flex-wrap:wrap;gap:var(--hig-spacing-2);padding:0;list-style:none;color:var(--ck-text-muted);font-size:var(--hig-text-caption1-font-size)}"
   ".go-steps li{padding:var(--hig-spacing-1) var(--hig-spacing-3);border-radius:var(--ck-radius-pill);background:var(--ck-surface-hover)}"
   ".go-steps [data-state=current]{color:var(--ck-accent);font-weight:600}"
   ".go-steps [data-state=done]::before{content:'✓ '}"
   ".go-turn-status{color:var(--ck-text-muted);font-size:var(--hig-text-footnote-font-size)}"
   "[data-failed=true] .go-turn-status{color:var(--ck-danger)}"
   ".go-actions{display:flex;align-items:center;flex-wrap:wrap;gap:var(--hig-spacing-2);margin-block:var(--hig-spacing-3)}"
   ".go-actions small{flex-basis:100%;overflow-wrap:anywhere;color:var(--ck-text-muted)}"
   ".go-actions button{min-height:2.25rem;padding:0 var(--hig-spacing-3);border:0;border-radius:var(--ck-radius-pill);background:var(--ck-surface-hover);cursor:pointer}"
   ;; --- the composer: a raised card, the prompt inside, one row of controls
   ".go-composer{position:relative;flex-shrink:0;width:min(100% - 2 * var(--hig-spacing-4),46rem);margin:0 auto;margin-bottom:max(var(--hig-spacing-4),env(safe-area-inset-bottom));padding:var(--hig-spacing-2) var(--hig-spacing-3) var(--hig-spacing-2);border:0;border-radius:var(--ck-radius-lg);background:var(--ck-surface-hover);box-shadow:var(--ck-shadow-float)}"
   ".go-composer>label:first-child{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}"
   "[data-ck-chat=prompt]{display:block;width:100%;min-height:3.5rem;max-height:12rem;margin:0;padding:var(--hig-spacing-3) var(--hig-spacing-2);border:0;border-radius:0;background:transparent;color:var(--ck-text);font-size:var(--hig-text-body-font-size);line-height:1.6;resize:none;outline-offset:0}"
   "[data-ck-chat=prompt]::placeholder{color:var(--ck-text-muted)}"
   ;; the composer card carries the focus ring, not the field inside it
   ;; (the DADS textarea's own ring would draw a second frame)
   "[data-ck-chat=prompt]:focus,[data-ck-chat=prompt]:focus-visible{outline:none;box-shadow:none;border:0}"
   ".go-composer:has([data-ck-chat=prompt]:focus-visible){outline:2px solid var(--ck-accent);outline-offset:2px}"
   ".go-compose-actions{padding:0 var(--hig-spacing-1);flex-wrap:nowrap}"
   ".go-compose-actions small{margin-inline-start:auto;color:var(--ck-text-muted);font-size:var(--hig-text-caption1-font-size)}"
   ".go-compose-actions .go-model-row{flex:0 1 auto;max-width:calc(100% - 3.5rem);margin-inline-end:auto;padding:0}"
   ;; send: the circle at the right edge of the composer
   ".go-compose-actions button[type=submit],[data-ck-chat=send]{display:inline-flex;align-items:center;justify-content:center;min-width:2.5rem;min-height:2.5rem;margin-inline-start:auto;padding:0 var(--hig-spacing-3);border:0;border-radius:var(--ck-radius-pill);background:var(--ck-accent);color:var(--hig-color-system-background);font-weight:600;cursor:pointer}"
   ".go-compose-actions button[type=submit]:disabled,[data-ck-chat=send]:disabled{opacity:.5;cursor:default}"
   "[data-ck-chat=stop]{min-height:2.5rem;padding:0 var(--hig-spacing-3);border:0;border-radius:var(--ck-radius-pill);background:var(--ck-surface-raised);color:var(--ck-danger);font-weight:600;cursor:pointer}"
   ".go-consent{display:flex;gap:var(--hig-spacing-2);align-items:flex-start;color:var(--ck-text-muted);font-size:var(--hig-text-caption1-font-size);line-height:1.5}"
   ".go-consent input{flex-shrink:0;min-width:1.25rem;min-height:1.25rem}"
   "[data-ck-chat=status]{min-height:1.5em;margin:var(--hig-spacing-2) 0 0;color:var(--ck-text-muted);font-size:var(--hig-text-caption1-font-size)}"
   "[data-ck-chat=status]:empty{display:none}"
   "[data-ck-chat=usage]{margin:0;padding:var(--hig-spacing-1) var(--hig-spacing-4);color:var(--ck-text-muted);font-size:var(--hig-text-caption1-font-size);text-align:center}"
   ".go-latest{position:absolute;bottom:var(--hig-spacing-2);right:var(--hig-spacing-4)}"
   ".go-about{margin-block:var(--hig-spacing-5)}"
   ;; --- the policy / settings sheets: raised, rounded, no frame ---------
   ".chat-policy{max-width:min(40rem,calc(100vw - 2rem));max-height:80dvh;padding:var(--hig-spacing-5);border:0;border-radius:var(--ck-radius-lg);background:var(--ck-surface-raised);color:var(--ck-text);box-shadow:var(--ck-shadow-float);overflow:auto}"
   ".chat-policy button{min-height:2.75rem;border:0;border-radius:var(--ck-radius-pill);padding:0 var(--hig-spacing-4);background:var(--ck-surface-hover);cursor:pointer}"
   ".chat-policy::backdrop{background:color-mix(in srgb,var(--hig-color-label) 40%,transparent)}"
   ;; --- the workspace: history beside the conversation, or as a drawer --
   "body:has(.chat-workspace){overflow:hidden}"
   ".chat-workspace{position:relative;display:grid;grid-template-columns:16rem minmax(0,1fr);height:calc(100dvh - 4rem);max-width:none!important;margin:0!important;padding:0!important;background:var(--ck-surface-ground);color:var(--ck-text)}"
   ".chat-workspace .go-shell{height:100%;min-height:0;max-height:none;border-radius:0;background:var(--ck-surface-raised)}"
   ".chat-sidebar{display:flex;flex-direction:column;min-height:0;gap:var(--hig-spacing-1);padding:var(--hig-spacing-3);background:var(--ck-surface-ground);border:0}"
   ".chat-sidebar h2{margin:var(--hig-spacing-2) var(--hig-spacing-2) var(--hig-spacing-1);color:var(--ck-text-muted);font-size:var(--hig-text-caption1-font-size);font-weight:600}"
   ".chat-sidebar p{margin:0 var(--hig-spacing-2);color:var(--ck-text-muted);font-size:var(--hig-text-caption1-font-size)}"
   ".chat-sidebar button,.chat-sidebar a{display:flex;align-items:center;width:100%;min-height:2.75rem;padding:0 var(--hig-spacing-3);border:0;border-radius:var(--ck-radius-sm);background:transparent;color:var(--ck-text);font-size:var(--hig-text-subheadline-font-size);text-align:start;text-decoration:none;cursor:pointer}"
   ".chat-sidebar button:hover,.chat-sidebar a:hover{background:var(--ck-surface-hover)}"
   ".chat-sidebar button:disabled{opacity:.5;cursor:default}"
   ".chat-sidebar [data-ck-chat=new]{font-weight:600}"
   ".chat-sidebar nav,.chat-sidebar [data-ck-chat=list]{flex:1;min-height:0;overflow:auto}"
   ".chat-sidebar nav button{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}"
   ".chat-item{display:block;width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}"
   ".chat-item[aria-current=page],.chat-sidebar nav button[aria-current=true]{background:var(--ck-surface-hover)}"
   ".chat-account{max-width:14rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:var(--hig-text-footnote-font-size)}"
   ".chat-workspace .go-toolbar{flex-wrap:nowrap;min-height:3.25rem;padding:var(--hig-spacing-2) var(--hig-spacing-4)}"
   ".chat-workspace [data-ck-chat=title]{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:var(--hig-text-subheadline-font-size)}"
   ".chat-workspace [data-ck-chat=history-toggle],.chat-workspace [data-ck-chat=history-close]{display:none}"
   ;; the drawer form: history over the conversation on every band
   ".chat-workspace[data-history=drawer]{grid-template-columns:minmax(0,1fr)}"
   ".chat-workspace[data-history=drawer] .chat-sidebar{display:none;position:absolute;inset:0 auto 0 0;z-index:var(--ck-layer-float);width:min(20rem,100%);background:var(--ck-surface-raised);box-shadow:var(--ck-shadow-float)}"
   ".chat-workspace[data-history=drawer] .chat-sidebar.is-open{display:flex}"
   ".chat-workspace[data-history=drawer] [data-ck-chat=history-toggle],.chat-workspace[data-history=drawer] [data-ck-chat=history-close]{display:inline-flex}"
   ;; --- bands -----------------------------------------------------------
   "@media(max-width:47.99rem){"
   ".chat-workspace{grid-template-columns:minmax(0,1fr);height:calc(100dvh - 4rem)}"
   ".chat-sidebar{display:none;position:absolute;inset:0;z-index:var(--ck-layer-float);background:var(--ck-surface-raised)}"
   ".chat-sidebar.is-open{display:flex}"
   ".chat-workspace [data-ck-chat=history-toggle],.chat-workspace [data-ck-chat=history-close]{display:inline-flex}"
   ".chat-workspace .go-toolbar{padding:var(--hig-spacing-1) var(--hig-spacing-3)}"
   ".go-toolbar .go-free,.go-compose-actions small,.go-model-row small{display:none}"
   ".go-composer{width:calc(100% - 2 * var(--hig-spacing-3));margin-bottom:max(var(--hig-spacing-3),env(safe-area-inset-bottom))}"
   ".go-welcome{padding:var(--hig-spacing-4) var(--hig-spacing-3)}"
   ".go-welcome h1{font-size:var(--hig-text-title3-font-size)}"
   "[data-ck-chat=messages]{padding:var(--hig-spacing-3)}"
   ".chat-account{max-width:7rem}"
   "}"
   ;; the phone band: the composer's row keeps the chip and the send circle,
   ;; the toolbar's title yields first
   "@media(max-width:30rem){"
   ".chat-workspace [data-ck-chat=title]{display:none}"
   "[data-ck-chat=model]{max-width:9rem}"
   ".go-composer{width:calc(100% - 2 * var(--hig-spacing-2));padding:var(--hig-spacing-1) var(--hig-spacing-2)}"
   ".chat-workspace[data-history=drawer] .chat-sidebar,.chat-sidebar{width:100%}"
   "}"
   "@media(max-height:40rem){.go-shell{min-height:24rem}.go-welcome p,.go-welcome .go-mark{display:none}.go-welcome h1{font-size:var(--hig-text-title3-font-size)}}"))

(def bots-css
  "The Bots workspace pattern (`cloud-kotoba-dds.bots`). Load after the
   jp-go-dds token bridge and `cloud-kotoba-dds.tokens/css` (the surface
   tokens — ground / raised / hover / border, lifted in dark — live there
   since 2026-09-16; `--ck-bots-*` are aliases onto them). A host retunes the
   pattern by redefining the tokens, not by overriding rules. No colour
   literal here."
  (str
   ;; --- surface tokens ---------------------------------------------------
   ".ck-bots{"
   ;; surfaces are cloud-kotoba-dds.tokens; these names stay as aliases so
   ;; a host that retuned --ck-bots-* keeps its retune
   "--ck-bots-ground:var(--ck-surface-ground);"
   "--ck-bots-raised:var(--ck-surface-raised);"
   "--ck-bots-hover:var(--ck-surface-hover);"
   "--ck-bots-border:var(--ck-surface-border);"
   "--ck-bots-text:var(--ck-text);--ck-bots-muted:var(--ck-text-muted);--ck-bots-accent:var(--ck-accent);"
   "--ck-bots-radius:var(--ck-radius-sm);--ck-bots-radius-lg:var(--ck-radius-md);--ck-bots-radius-pill:var(--ck-radius-pill);"
   "--ck-bots-rail-width:19rem;"
   "display:grid;grid-template-columns:var(--ck-bots-rail-width) minmax(0,1fr);height:100%;min-height:0;color:var(--ck-bots-text);background:var(--ck-bots-ground);font-size:var(--hig-text-subheadline-font-size);line-height:1.6}"
   ".ck-bots *{box-sizing:border-box}"
   ".ck-bots button,.ck-bots input,.ck-bots textarea{font:inherit;color:inherit}"
   ".ck-bots :focus-visible{outline:2px solid var(--ck-bots-accent);outline-offset:2px}"
   ;; --- rail -------------------------------------------------------------
   ".ck-bots__rail{display:flex;flex-direction:column;min-height:0;gap:var(--hig-spacing-2);padding:var(--hig-spacing-3);background:var(--ck-bots-raised);border-inline-end:1px solid var(--ck-bots-border)}"
   ".ck-bots__search{position:relative;flex:none}"
   ".ck-bots__search-mark{position:absolute;inset-inline-start:var(--hig-spacing-3);top:50%;transform:translateY(-50%);color:var(--ck-bots-muted);pointer-events:none}"
   ".ck-bots__search-input{width:100%;min-height:2.75rem;padding:var(--hig-spacing-2) var(--hig-spacing-3) var(--hig-spacing-2) var(--hig-spacing-7);border:1px solid var(--ck-bots-border);border-radius:var(--ck-bots-radius);background:var(--ck-bots-hover);color:var(--ck-bots-text)}"
   ".ck-bots__search-input::placeholder{color:var(--ck-bots-muted)}"
   ".ck-bots__list{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;scrollbar-gutter:stable}"
   ".ck-bots__group{list-style:none;margin:0;padding:0}"
   ".ck-bots__group-label{position:sticky;top:0;z-index:1;margin:0;padding:var(--hig-spacing-2) var(--hig-spacing-2) var(--hig-spacing-1);background:var(--ck-bots-raised);color:var(--ck-bots-muted);font-size:var(--hig-text-caption1-font-size);font-weight:600}"
   ".ck-bots__row{margin:0;padding:0}"
   ".ck-bots__item{display:grid;grid-template-columns:2.5rem minmax(0,1fr) auto;align-items:center;gap:var(--hig-spacing-3);width:100%;min-height:3.5rem;padding:var(--hig-spacing-2) var(--hig-spacing-2);border:0;border-radius:var(--ck-bots-radius);background:transparent;text-align:start;cursor:pointer}"
   ".ck-bots__item:hover,.ck-bots__item.is-current{background:var(--ck-bots-hover)}"
   ".ck-bots__avatar{display:inline-flex;width:2.5rem;height:2.5rem;flex:none;align-items:center;justify-content:center;border-radius:var(--ck-bots-radius-pill)}"
   ".ck-bots__avatar>*{width:100%;height:100%}"
   ".ck-bots__copy{min-width:0}"
   ".ck-bots__headline{display:flex;align-items:baseline;gap:var(--hig-spacing-2)}"
   ".ck-bots__name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:700}"
   ".ck-bots__time{flex:none;color:var(--ck-bots-muted);font-size:var(--hig-text-caption1-font-size);font-variant-numeric:tabular-nums}"
   ".ck-bots__meta{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ck-bots-muted);font-size:var(--hig-text-footnote-font-size)}"
   ".ck-bots__dot{width:.5rem;height:.5rem;border-radius:var(--ck-bots-radius-pill);background:var(--ck-bots-accent)}"
   ;; --- pinned: faces over names, three across, above the list -----------
   ".ck-bots__pinned{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--hig-spacing-1);margin:0;padding:var(--hig-spacing-2) 0;max-height:13rem;overflow:auto;flex:none}"
   ".ck-bots__pinned[hidden]{display:none}"
   ".ck-bots__pinned .ck-bots__item{display:flex;flex-direction:column;align-items:center;gap:var(--hig-spacing-2);position:relative;padding:var(--hig-spacing-2) var(--hig-spacing-1);text-align:center}"
   ".ck-bots__pinned .ck-bots__avatar{width:3.75rem;height:3.75rem}"
   ".ck-bots__pinned .ck-bots__copy{width:100%}"
   ".ck-bots__pinned .ck-bots__headline{justify-content:center}"
   ".ck-bots__pinned .ck-bots__name{flex:none;max-width:100%;font-size:var(--hig-text-caption1-font-size);font-weight:500}"
   ".ck-bots__pinned .ck-bots__time,.ck-bots__pinned .ck-bots__meta{display:none}"
   ".ck-bots__pinned .ck-bots__dot{position:absolute;top:var(--hig-spacing-2);right:var(--hig-spacing-2)}"
   ".ck-bots__launcher{flex:none;margin-top:auto;padding-top:var(--hig-spacing-2);border-top:1px solid var(--ck-bots-border)}"
   ".ck-bots__launch{display:flex;align-items:center;gap:var(--hig-spacing-2);min-height:2.75rem;padding-inline:var(--hig-spacing-2);border-radius:var(--ck-bots-radius);color:inherit;text-decoration:none}"
   ".ck-bots__launch:hover{background:var(--ck-bots-hover)}"
   ".ck-bots__launch-mark{width:1.25rem;text-align:center;color:var(--ck-bots-muted)}"
   ;; --- main -------------------------------------------------------------
   ".ck-bots__main{display:flex;flex-direction:column;min-height:0;min-width:0;background:var(--ck-bots-ground)}"
   ".ck-bots__titlebar{display:flex;flex-wrap:wrap;align-items:center;gap:var(--hig-spacing-3);min-height:4rem;padding:var(--hig-spacing-3) var(--hig-spacing-5);background:var(--ck-bots-raised);border-bottom:1px solid var(--ck-bots-border)}"
   ".ck-bots__refs{flex:none}"
   ".ck-bots__identity{display:flex;align-items:center;gap:var(--hig-spacing-3);flex:1;min-width:0}"
   ".ck-bots__title-copy{min-width:0}"
   ".ck-bots__title-name{margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:var(--hig-text-headline-font-size);font-weight:700}"
   ".ck-bots__title-status{margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ck-bots-muted);font-size:var(--hig-text-footnote-font-size)}"
   ".ck-bots__actions{display:flex;align-items:center;gap:var(--hig-spacing-2);flex:none;margin-inline-start:auto}"
   ".ck-bots__chip{display:inline-flex;align-items:center;min-height:2rem;padding:0 var(--hig-spacing-3);border:1px solid var(--ck-bots-border);border-radius:var(--ck-bots-radius);background:var(--ck-bots-hover);font-size:var(--hig-text-footnote-font-size);font-weight:600;white-space:nowrap}"
   "button.ck-bots__chip{cursor:pointer}"
   ".ck-bots__action{min-height:2.75rem;padding:0 var(--hig-spacing-4);border:1px solid transparent;border-radius:var(--ck-bots-radius);background:var(--ck-bots-hover);font-weight:600;cursor:pointer;white-space:nowrap}"
   ".ck-bots__action--primary{background:var(--ck-bots-raised);border-color:var(--ck-bots-border)}"
   ".ck-bots__action:hover{border-color:var(--ck-bots-border)}"
   ".ck-bots__disclosure{flex:none;padding:0 var(--hig-spacing-5);border-bottom:1px solid var(--ck-bots-border);background:var(--ck-bots-raised)}"
   ".ck-bots__disclosure-summary{min-height:2.75rem;display:flex;align-items:center;gap:var(--hig-spacing-2);color:var(--ck-bots-muted);cursor:pointer;font-size:var(--hig-text-footnote-font-size)}"
   ".ck-bots__disclosure>:not(summary){padding-bottom:var(--hig-spacing-3)}"
   ".ck-bots__feed{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;padding:var(--hig-spacing-4) var(--hig-spacing-5);display:flex;flex-direction:column;gap:var(--hig-spacing-3)}"
   ".ck-bots__note{margin:0;text-align:center}"
   ".ck-bots__note>*{display:inline-flex;align-items:center;min-height:2rem;padding:0 var(--hig-spacing-3);border-radius:var(--ck-bots-radius);background:var(--ck-bots-hover);color:var(--ck-bots-muted);font-size:var(--hig-text-caption1-font-size)}"
   ".ck-bots__card{display:flex;flex-wrap:wrap;align-items:center;gap:var(--hig-spacing-2) var(--hig-spacing-3);padding:var(--hig-spacing-3) var(--hig-spacing-4);border:1px solid var(--ck-bots-border);border-radius:var(--ck-bots-radius-lg);background:var(--ck-bots-raised)}"
   ".ck-bots__card-title{margin:0;flex:none;font-size:var(--hig-text-subheadline-font-size);font-weight:700}"
   ".ck-bots__tag{display:inline-flex;align-items:center;min-height:1.5rem;padding:0 var(--hig-spacing-2);border-radius:var(--ck-bots-radius-pill);background:var(--ck-bots-hover);font-size:var(--hig-text-caption2-font-size);font-weight:600;white-space:nowrap}"
   ".ck-bots__tag[data-state=ok]{color:var(--color-semantic-success-1)}"
   ".ck-bots__tag[data-state=error]{color:var(--color-semantic-error-1)}"
   ".ck-bots__tag[data-state=warn]{color:var(--color-semantic-warning-orange-1)}"
   ".ck-bots__card-summary{flex:1 1 12rem;min-width:0;margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}"
   ".ck-bots__card-more{flex:none;margin-inline-start:auto;font-size:var(--hig-text-footnote-font-size)}"
   ".ck-bots__card-more>*{color:var(--ck-bots-accent);background:transparent;border:0;padding:var(--hig-spacing-2);min-height:2.75rem;cursor:pointer;text-decoration:none}"
   ".ck-bots__bubble{max-width:46rem;padding:var(--hig-spacing-3) var(--hig-spacing-4);border:1px solid var(--ck-bots-border);border-radius:var(--ck-bots-radius-lg);background:var(--ck-bots-raised);white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.7}"
   ".ck-bots__bubble[data-role=person]{margin-inline-start:auto;background:var(--ck-bots-accent);color:var(--hig-color-system-background);border-color:transparent}"
   ;; --- composer ---------------------------------------------------------
   ".ck-bots__composer{flex:none;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--hig-spacing-2) var(--hig-spacing-3);align-items:end;width:min(100%,52rem);margin-inline:auto;padding:var(--hig-spacing-3) var(--hig-spacing-5) max(var(--hig-spacing-4),env(safe-area-inset-bottom))}"
   ".ck-bots__prompt{grid-column:1;width:100%;min-height:5rem;max-height:40dvh;padding:var(--hig-spacing-3) var(--hig-spacing-4);border:1px solid var(--ck-bots-border);border-radius:var(--ck-bots-radius-lg);background:var(--ck-bots-raised);resize:vertical}"
   ".ck-bots__prompt::placeholder{color:var(--ck-bots-muted)}"
   ".ck-bots__send{grid-column:2;min-height:2.75rem;padding:0 var(--hig-spacing-4);border:1px solid var(--ck-bots-border);border-radius:var(--ck-bots-radius);background:var(--ck-bots-hover);font-weight:600;cursor:pointer;white-space:nowrap}"
   ".ck-bots__send:disabled{color:var(--ck-bots-muted);cursor:default}"
   ".ck-bots__stop{grid-column:2;min-height:2.75rem;padding:0 var(--hig-spacing-4);border:1px solid var(--ck-bots-border);border-radius:var(--ck-bots-radius);background:transparent;color:var(--ck-danger);font-weight:600;cursor:pointer;white-space:nowrap}"
   ".ck-bots__stop[hidden]{display:none}"
   ".ck-bots__hint{grid-column:1/-1;margin:0;color:var(--ck-bots-muted);font-size:var(--hig-text-caption1-font-size)}"
   ".ck-bots__rail-toggle{display:none;min-height:2.75rem;padding:0 var(--hig-spacing-3);border:1px solid var(--ck-bots-border);border-radius:var(--ck-bots-radius);background:var(--ck-bots-hover);cursor:pointer}"
   ;; --- fixed-rail variant: the rail is a fixed column, main scrolls beside it
   ;; (the itonami workspace, whose topbar offsets itself by the same width)
   "@media(min-width:48rem){"
   ".ck-bots--fixed-rail{display:block}"
   ".ck-bots--fixed-rail>.ck-bots__rail{position:fixed;inset:0 auto 0 0;width:var(--ck-bots-rail-width);z-index:41}"
   ".ck-bots--fixed-rail>.ck-bots__main{margin-inline-start:var(--ck-bots-rail-width);height:100%}"
   "}"
   ;; --- the narrow band: the rail is a sheet over the main column ----------
   "@media(max-width:47.99rem){"
   ".ck-bots{grid-template-columns:minmax(0,1fr)}"
   ".ck-bots__rail{display:none}"
   ".ck-bots.show-rail>.ck-bots__rail{display:flex}.ck-bots.show-rail>.ck-bots__main{display:none}"
   ".ck-bots__rail-toggle{display:inline-flex;align-items:center}"
   ".ck-bots__titlebar{padding:var(--hig-spacing-2) var(--hig-spacing-3);min-height:3.5rem}"
   ".ck-bots__title-name{font-size:var(--hig-text-subheadline-font-size)}"
   ".ck-bots__actions{gap:var(--hig-spacing-1)}"
   ".ck-bots__feed{padding:var(--hig-spacing-3)}"
   ".ck-bots__composer{padding:var(--hig-spacing-2) var(--hig-spacing-3) max(var(--hig-spacing-3),env(safe-area-inset-bottom))}"
   ".ck-bots__hint{display:none}"
   ".ck-bots__card-summary{white-space:normal;flex-basis:100%}"
   "}"
   ;; --- phones: one column of rows, the titlebar wraps, the prompt is shorter
   "@media(max-width:30rem){"
   ".ck-bots__item{grid-template-columns:2.25rem minmax(0,1fr) auto;min-height:3.25rem}"
   ".ck-bots__avatar{width:2.25rem;height:2.25rem}"
   ".ck-bots__actions{flex-wrap:wrap;margin-inline-start:0;width:100%}"
   ".ck-bots__prompt{min-height:4rem}"
   ".ck-bots__send{min-width:4rem}"
   "}"
   "@media(prefers-reduced-motion:reduce){.ck-bots *{transition:none;animation:none}}"))
