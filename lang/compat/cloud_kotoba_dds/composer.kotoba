(ns cloud-kotoba-dds.composer
  "The composer's behaviour — how a person writes to a Bot — as one runtime
   over the bots pattern's markup (owner instruction 2026-09-16: 「1, 2, 3,
   4」 wave 1 of the interaction cutover).

   Measured before, in cloud-itonami-app interaction.js (resizeBotsInput and
   the keydown / input listeners around it): the textarea grew with its text
   to a 192px cap, Enter inserted a newline and ⌘/Ctrl+Enter sent — guarded
   against IME composition (`isComposing`, keyCode 229, the guard every
   Japanese composer needs and every product rewrites), the send button was
   disabled while empty or while the shell was busy and read 「追加で伝える」
   while a run was active, the stop button appeared only then, and Escape
   stopped the run. None of that names a product. One thing changed on the
   way in: send is NOT greyed while the prompt is empty — shinkansen.audit
   :idle-disabled measures a disabled control in the idle document as a
   control that tells the person nothing (the example scored 98.8 with it,
   100 without), so an empty submit is a no-op the host ignores and send is
   disabled only while the host is busy. What does — what
   \"running\" means, where the text goes, what stop calls — stays with the
   host, behind two shinkansen actions and two predicates.

     markup  cloud-kotoba-dds.bots: composer / prompt / send / stop /
             composer-hint — `form` below assembles them
     actions bots/send   (the form's submit — the host reads the text)
             bots/stop   (the stop button)
     runtime cloudKotobaComposer.attach(form, {running, busy, escape})
             → {refresh, clear, value, focus, input, send, stop, form}
             running(): a run is active (send reads data-label-more, stop shows)
             busy():    the host is busy (send disabled, stop shows)
             an empty prompt does not disable send (see above); ⌘⏎ on an
             empty prompt does nothing
             escape:    Escape outside a <dialog> clicks stop (default true)
             refresh(): re-derive the three states; the host calls it when
                        its predicates change

   The two send labels are attributes (`data-label-send` / `data-label-more`)
   so a render-time locale table translates them like any attribute; the
   runtime carries no word. The autosize cap is the token
   --ck-composer-max-height (read from the prompt's computed max-height)."
  (:require [kotoba.lang.text :as str]
            [cloud-kotoba-dds.bots :as bots]))

(defn form
  "The composer assembled: `:id` the form, `:input-id` the prompt (the
   label's `for`), `:label` (visually hidden), `:placeholder`, `:help`, the
   labels `:send-label` / `:more-label` / `:stop-label`, `:maxlength`,
   `:rows` (default 2); `:attrs` / `:input-attrs` / `:send-attrs` /
   `:stop-attrs` merge on their element."
  [{:keys [id input-id label placeholder help send-label more-label stop-label
           maxlength rows attrs input-attrs send-attrs stop-attrs]
    :or {send-label "送信" more-label "追加で伝える" stop-label "中止" rows 2}}]
  (let [help-id (str input-id "-help")]
    (bots/composer (merge {:id id :data-ck-composer "autosize"} attrs)
      [:label {:for input-id :class "dads-visually-hidden"} label]
      (bots/prompt (merge {:id input-id :rows rows :autocomplete "off"}
                          (when placeholder {:placeholder placeholder})
                          (when maxlength {:maxlength maxlength})
                          (when help {:aria-describedby help-id})
                          input-attrs))
      (bots/send (merge {:data-label-send send-label :data-label-more more-label}
                        send-attrs)
                 send-label)
      (bots/stop (or stop-attrs {}) stop-label)
      (when help (bots/composer-hint {:id help-id} help)))))

(def css
  "Autosize turns the prompt's manual resize off and caps it at the token;
   the stop control sits where send does (the grid's second column) and
   both stay in one row on the narrow band."
  (str
   ".ck-bots__composer[data-ck-composer=autosize] .ck-bots__prompt{resize:none;min-height:0;max-height:var(--ck-composer-max-height);overflow:auto;field-sizing:content}"
   ".ck-bots__composer[data-ck-composer=autosize] .ck-bots__send,.ck-bots__composer[data-ck-composer=autosize] .ck-bots__stop{align-self:end}"
   ".dads-visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}"))

(def script
  (str
   "(function(global){'use strict';"
   "function attach(form,opts){if(!form)return null;opts=opts||{};"
   "var input=form.querySelector('[data-ck-bots=prompt]'),send=form.querySelector('[data-ck-bots=send]'),stop=form.querySelector('[data-ck-bots=stop]');"
   "if(!input||!send)throw new TypeError('composer: form needs [data-ck-bots=prompt] and [data-ck-bots=send]');"
   "var running=typeof opts.running==='function'?opts.running:function(){return false;};"
   "var busy=typeof opts.busy==='function'?opts.busy:function(){return false;};"
   "var labelSend=send.getAttribute('data-label-send')||send.textContent,labelMore=send.getAttribute('data-label-more')||labelSend;"
   "function maxHeight(){var v=parseFloat(getComputedStyle(input).maxHeight);return isFinite(v)&&v>0?v:Infinity;}"
   "function refresh(){input.style.height='auto';input.style.height=Math.min(input.scrollHeight,maxHeight())+'px';"
   "var r=!!running(),b=!!busy();send.disabled=b;send.textContent=r?labelMore:labelSend;if(stop)stop.hidden=!(r||b);return {running:r,busy:b};}"
   "input.addEventListener('input',refresh);"
   "input.addEventListener('keydown',function(ev){if(ev.key==='Enter'&&(ev.metaKey||ev.ctrlKey)&&!ev.isComposing&&ev.keyCode!==229){ev.preventDefault();if(!send.disabled&&input.value.trim())form.requestSubmit();}});"
   "if(stop&&opts.escape!==false){document.addEventListener('keydown',function(ev){if(ev.key!=='Escape'||ev.defaultPrevented)return;if(ev.target&&ev.target.closest&&ev.target.closest('dialog'))return;if(running()||busy())stop.click();});}"
   "refresh();"
   "return {refresh:refresh,clear:function(){input.value='';refresh();},value:function(){return input.value.trim();},focus:function(){input.focus();},input:input,send:send,stop:stop,form:form};}"
   "global.cloudKotobaComposer=Object.freeze({attach:attach});"
   "})(globalThis);"))
