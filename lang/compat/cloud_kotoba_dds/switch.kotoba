(ns cloud-kotoba-dds.switch
  "The two switches every product carries — theme (light / dark / system)
   and language — as shared components on the shinkansen contracts
   (owner instruction 2026-09-16: 「言語切り替え, dark, light, system theme
   switcher も統合」).

   `theme-switch` is a three-state segmented control naming `theme/set`
   (shinkansen.theme). The shinkansen runtime answers the action, paints the
   pressed state from `shinkansen.theme.onChange`, and keeps following the
   OS while `system` is chosen — the component carries no script of its own.

   `lambda-toggle` is the λ yin-yang mark of kotoba-lang.org
   (jp-go-dds.theme-toggle/control) as a two-state switch on the SAME
   contract (owner direction 2026-09-16: 「テーマ切り替えは kotoba-lang.org
   などで使っている lisp toggle を使って」): it shows the effective theme
   (`aria-checked` = dark), a click sets the other one explicitly through
   `shinkansen.theme.set`, and a stored choice is forgotten with `system`
   only by a host that offers it. The mark ships `hidden`; `script` reveals
   it once the runtime is there (a dead control is worse than none).

   `locale-switch` is a list of `a[hreflang]` links naming `locale/set`
   (shinkansen.locale): the runtime writes the negotiation cookie and
   follows the link's href, so the host/edge re-negotiates the document.
   `a[hreflang]` is what shinkansen.audit's :locale-path-links recognises
   as an explicit language switch, and what a crawler reads as alternates.

   Labels are the host's (`:labels` — the default set is Japanese, the
   document's language decides); ids and placement are the host's; the
   stylesheet (`css`) is on the --hig-* token contract, so both switches
   follow light and dark with the page."
  (:require [kotoba.lang.text :as str]
            [shinkansen.interaction :as interaction]
            [shinkansen.theme :as theme]
            [jp-go-dds.theme-toggle :as lambda]))

(def default-labels
  {:light "ライト" :dark "ダーク" :system "システム"
   :theme "表示テーマ" :language "言語"})

(defn theme-switch
  "`{:id :labels :attrs :current}` → a radiogroup of three buttons. `:current`
   (:light / :dark / :system, default :system) is the server-rendered state;
   the runtime repaints from the stored choice before anyone clicks."
  [{:keys [id labels attrs current] :or {current :system}}]
  (let [labels (merge default-labels labels)]
    ;; data-behavior=radiogroup: arrows move AND choose (jp-go-dds.behavior
    ;; clicks the next radio, so the runtime's theme/set fires) and the
    ;; roving tabindex follows aria-checked — ship behavior/script
    (into [:div (merge {:class "ck-switch ck-switch--theme" :role "radiogroup"
                        :aria-label (:theme labels) :data-ck-switch "theme"
                        :data-hydrate "theme-switch" :data-behavior "radiogroup"}
                       (when id {:id id}) attrs)]
          (for [mode theme/modes]
            [:button (merge {:type "button" :role "radio"
                             :class "ck-switch__option"
                             :aria-checked (if (= mode current) "true" "false")
                             :data-mode (name mode)}
                            (interaction/action-attrs :theme/set {:mode (name mode)}))
             (get labels mode)]))))

(defn lambda-toggle
  "The λ yin-yang theme toggle, on the shinkansen theme contract.
   `{:id :label :attrs}` — `:label` is the accessible name (default
   「ダークモード」); `:id` defaults to `kot-theme` (the mark's own css keys on
   it). Ship `lambda-css` and `script`."
  [{:keys [id label attrs] :or {id "kot-theme" label "ダークモード"}}]
  (let [[tag a & body] lambda/control]
    (into [tag (merge a {:id id :aria-label label :data-ck-switch "lambda" :data-hydrate "lambda-toggle"} attrs)]
          body)))

(def lambda-css
  "The mark's own stylesheet (jp-go-dds.theme-toggle/css) — keyed on
   #kot-theme; a host that renames the id restyles the mark itself."
  lambda/css)

(defn locale-switch
  "`{:id :labels :attrs :current :locales}` where `:locales` is
   `[{:locale \"ja\" :label \"日本語\" :href \"/\"} …]`. Each option is an
   `a[hreflang][lang]` naming `locale/set`; the current one is marked
   `aria-current=\"true\"`. `:href` defaults to the current page (`#` —
   the runtime then reloads)."
  [{:keys [id labels attrs current locales]}]
  (let [labels (merge default-labels labels)]
    (into [:nav (merge {:class "ck-switch ck-switch--locale" :aria-label (:language labels)
                        :data-ck-switch "locale"}
                       (when id {:id id}) attrs)]
          (for [{:keys [locale label href]} locales
                :let [locale (name locale)]]
            [:a (merge {:class "ck-switch__option" :href (or href "#")
                        :hreflang locale :lang locale
                        :aria-current (when (= locale (some-> current name)) "true")}
                       (interaction/action-attrs :locale/set {:locale locale}))
             (or label locale)]))))

(def css
  "Token-contract styles for both switches: a pill group, the chosen option
   raised. No colour literal."
  (str
   ".ck-switch{display:inline-flex;align-items:center;gap:2px;padding:2px;border:1px solid var(--ck-surface-border);border-radius:var(--ck-radius-pill);background:var(--ck-surface-hover)}"
   ".ck-switch__option{display:inline-flex;align-items:center;justify-content:center;min-height:2.25rem;padding:0 var(--hig-spacing-3);border:0;border-radius:var(--ck-radius-pill);background:transparent;color:var(--ck-text-muted);font:inherit;font-size:var(--hig-text-footnote-font-size);font-weight:600;text-decoration:none;cursor:pointer;white-space:nowrap;transition:background var(--ck-motion) ease}"
   ".ck-switch__option:hover{color:var(--ck-text)}"
   ".ck-switch__option[aria-checked=true],.ck-switch__option[aria-current=true]{background:var(--ck-surface-raised);color:var(--ck-text);box-shadow:0 1px 2px var(--ck-surface-border)}"
   ".ck-switch__option:focus-visible{outline:2px solid var(--ck-accent);outline-offset:2px}"
   "@media(max-width:30rem){.ck-switch__option{padding:0 var(--hig-spacing-2);min-height:2.75rem}}"))

(def script
  "Paints the theme switch from the runtime's state (server rendered
   `system`; the stored choice may differ) and keeps it painted across
   changes, including the OS flipping while in system. Requires
   shinkansen.interaction/runtime. One hydrate, no handlers of its own —
   `theme/set` is the runtime's."
  (str
   "(function(){if(!globalThis.shinkansen)return;"
   "function paint(){shinkansen.hydrate('theme-switch',function(root){"
   "shinkansen.theme.onChange(function(s){var opts=root.querySelectorAll('[data-mode]');"
   "for(var i=0;i<opts.length;i++){opts[i].setAttribute('aria-checked',opts[i].getAttribute('data-mode')===s.mode?'true':'false');}"
   "root.setAttribute('data-effective',s.effective);});});"
   ;; the λ toggle: shown once the runtime is here, painted from the
   ;; effective theme, a click sets the other explicitly
   "shinkansen.hydrate('lambda-toggle',function(el){el.hidden=false;"
   "shinkansen.theme.onChange(function(s){el.setAttribute('aria-checked',s.effective==='dark'?'true':'false');el.setAttribute('data-mode',s.mode);});"
   "el.addEventListener('click',function(){shinkansen.theme.set(shinkansen.theme.effective()==='dark'?'light':'dark');});});}"
   ;; a host may ship this in <head> (cloud-itonami-app does): hydrate once the
   ;; switch exists, not before — measured 2026-09-16, the switch stayed on
   ;; `system` after a dark dispatch because hydrate found no element yet
   "if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',paint);else paint();"
   "})();"))
