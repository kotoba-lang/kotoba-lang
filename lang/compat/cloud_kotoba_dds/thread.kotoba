(ns cloud-kotoba-dds.thread
  "The message thread's behaviour — the answer arriving as it streams — as
   one runtime over the bots pattern's feed and bubble (owner instruction
   2026-09-16: 「1, 2, 3, 4」 wave 2 of the interaction cutover).

   Measured before, in cloud-itonami-app interaction.js (readBotsStream and
   the submit handler around it): the client opened the run stream, read
   newline-delimited JSON frames by hand, appended `delta` content to a
   provisional bubble's markdown and re-rendered it, opened a fresh bubble
   after the person's follow-up on `followup-applied`, took the messages
   and the turn from `done`, threw on `error`. The reading is now
   shinkansen.streamRun (one reader for SSE and NDJSON); what is left here
   is the thread's own knowledge — a bubble has a role, a streaming answer
   is a bubble that grows — and nothing about Bots, phases or tools, which
   reach the host as frames.

     markup  cloud-kotoba-dds.bots: feed / bubble; `bubble` below adds the
             follow-up anchor
     runtime cloudKotobaThread.bubble(feed, {role, text, markdown, render, followupId})
               → the bubble element; feed may be null (a detached bubble the
               host mounts later — a run for a thread that is not on screen)
             cloudKotobaThread.run({feed, source, init, render, onFrame})
               → {promise, abort, bubble}
               source  URL or (init) => Promise<Response>  (shinkansen.streamRun)
               feed    element, or () => element|null (asked per frame, so a
                       thread that leaves the screen mid-run stops receiving
                       bubbles and one that returns gets them)
               render  (bubble, markdown) → paints the accumulated text
                       (default: textContent)
               frames  delta {content} → the bubble grows
                       followup-applied {followups:[{id}]} → a new bot bubble
                         after the last [data-followup-id] the frame names
                       done {messages, turn} → resolves {done:true, messages, turn}
                       error {message, turn} → rejects (error.turn set)
                       anything else → onFrame(frame, bubble) only
               close without done → resolves {done:false}
               abort(reason) → rejects with an AbortError-named error

   Roles are `data-role` (person / bot / …) — the host's vocabulary; the
   pattern styles the two it knows. Styles read cloud-kotoba-dds.tokens."
  (:require [kotoba.lang.text :as str]
            [cloud-kotoba-dds.bots :as bots]))

(defn bubble
  "A rendered bubble with the follow-up anchor: `:followup-id` marks the
   person's follow-up a streamed answer is placed after."
  [{:keys [role followup-id attrs]} & body]
  (apply bots/bubble {:role (or role :bot)
                      :attrs (merge (when followup-id {:data-followup-id followup-id}) attrs)}
         body))

(def css
  "What a streamed, markdown-rendered answer needs beyond bots-css: block
   typography inside the bubble, a person bubble as wide as its text, and
   the waiting shimmer of an empty bubble (motion 0 under reduced motion)."
  (str
   ".ck-bots__bubble> :first-child{margin-top:0}.ck-bots__bubble> :last-child{margin-bottom:0}"
   ".ck-bots__bubble p{margin:var(--hig-spacing-2) 0}"
   ".ck-bots__bubble ul,.ck-bots__bubble ol{margin:var(--hig-spacing-2) 0;padding-left:var(--hig-spacing-6)}"
   ".ck-bots__bubble li+li{margin-top:var(--hig-spacing-1)}"
   ".ck-bots__bubble pre{max-width:100%;overflow:auto;margin:var(--hig-spacing-2) 0;padding:var(--hig-spacing-3);border-radius:var(--ck-radius-sm);background:var(--ck-surface-ground);border:1px solid var(--ck-surface-border);white-space:pre}"
   ".ck-bots__bubble code{font-family:var(--hig-font-mono);font-size:var(--hig-text-footnote-font-size);padding:0 .25em;border-radius:var(--ck-radius-sm);background:var(--ck-surface-ground)}"
   ".ck-bots__bubble pre code{background:transparent;padding:0;color:inherit}"
   ".ck-bots__bubble blockquote{margin:var(--hig-spacing-2) 0;padding-left:var(--hig-spacing-3);border-left:3px solid var(--ck-surface-border);color:var(--ck-text-muted)}"
   ".ck-bots__bubble[data-role=person]{width:fit-content;max-width:min(46rem,85%)}"
   ".ck-bots__bubble:empty{min-height:2.75rem;min-width:4rem;background:linear-gradient(90deg,var(--ck-surface-raised),var(--ck-surface-hover),var(--ck-surface-raised));background-size:200% 100%;animation:ck-bubble-wait 1.2s linear infinite}"
   "@keyframes ck-bubble-wait{from{background-position:200% 0}to{background-position:-200% 0}}"
   "@media(prefers-reduced-motion:reduce){.ck-bots__bubble:empty{animation:none}}"))

(def script
  (str
   "(function(global){'use strict';"
   "function paintText(bubble,markdown){bubble.textContent=markdown;}"
   "function bubble(feed,opts){opts=opts||{};var b=document.createElement('div');b.className='ck-bots__bubble';b.dataset.role=opts.role||'bot';b.dataset.ckBots='bubble';"
   "if(opts.followupId)b.dataset.followupId=opts.followupId;"
   "if(opts.markdown!=null){b.dataset.markdown=opts.markdown;(opts.render||paintText)(b,opts.markdown);}else if(opts.text!=null)b.textContent=opts.text;"
   "if(feed)feed.appendChild(b);return b;}"
   "function run(o){o=o||{};if(!global.shinkansen||!global.shinkansen.streamRun)throw new TypeError('thread.run needs shinkansen.streamRun');"
   "var feedOf=typeof o.feed==='function'?o.feed:function(){return o.feed||null;};var render=o.render||paintText;"
   "var current=bubble(feedOf(),{role:'bot'});var settled=false,aborted=false,resolve,reject;"
   "function abortError(){var err=new Error('aborted');err.name='AbortError';return err;}"
   "var promise=new Promise(function(res,rej){resolve=res;reject=rej;});"
   "function finish(fn,v){if(settled)return;settled=true;fn(v);}"
   "var handle=global.shinkansen.streamRun(o.source,{"
   "onEvent:function(frame){if(!frame||typeof frame!=='object')return;"
   "if(frame.type==='delta'){var md=(current.dataset.markdown||'')+(frame.content||'');current.dataset.markdown=md;render(current,md);}"
   "else if(frame.type==='followup-applied'){var feed=feedOf();var ids=(frame.followups||[]).map(function(f){return f&&f.id;}).filter(Boolean);"
   "var anchor=null;if(feed){var nodes=feed.querySelectorAll('[data-followup-id]');for(var i=0;i<nodes.length;i++){if(ids.indexOf(nodes[i].dataset.followupId)>=0)anchor=nodes[i];}}"
   "current=bubble(null,{role:'bot'});if(feed){if(anchor)anchor.after(current);else feed.appendChild(current);}}"
   "else if(frame.type==='done'){finish(resolve,{done:true,messages:frame.messages||[],turn:frame.turn||null});}"
   "else if(frame.type==='error'){var err=new Error(frame.message||'stream error');err.turn=frame.turn||null;err.frame=frame;finish(reject,err);}"
   "if(o.onFrame)o.onFrame(frame,current);},"
   "onError:function(e){var err;if(aborted||(e&&e.aborted)){err=abortError();}else{err=new Error(e&&(e.error||('HTTP '+e.status))||'stream error');err.status=e&&e.status;err.response=e&&e.response;}finish(reject,err);},"
   ;; a body that ends quietly after abort() is still an abort — the host
   ;; asked for it; it must not read as 「途中で切れました」
   "onClose:function(){if(aborted)finish(reject,abortError());else finish(resolve,{done:false,messages:null,turn:null});}},o.init);"
   "return {promise:promise,abort:function(reason){aborted=true;handle.abort(reason);},bubble:function(){return current;}};}"
   "global.cloudKotobaThread=Object.freeze({bubble:bubble,run:run});"
   "})(globalThis);"))
