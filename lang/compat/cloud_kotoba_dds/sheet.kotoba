(ns cloud-kotoba-dds.sheet
  "The settings sheet — contracts.edn :settings-sheet, as a component
   (until 2026-09-16 it was a contract and a prototype only): a modal
   <dialog> on jp-go-dds.behavior (the platform's focus trap, Escape,
   focus return; the invoker pair for open / close), DADS modal-dialog
   markup, and the two shapes the contract names — a bottom sheet on the
   compact band, a centered dialog above it. Backdrop click does nothing
   (:backdrop-click :no-action); the close button and Escape close.

   Ship jp-go-dds.behavior/script; open it with
   `(dds/button label {:attrs (behavior/dialog-open-attrs id)})`."
  (:require [jp-go-dds.core :as dds]
            [jp-go-dds.tokens :as tokens]))

(defn settings-sheet
  "`{:id :heading :actions :close-label :attrs}` + body → the dialog.
   :actions are hiccup controls (give the closing one
   `behavior/dialog-close-attrs`)."
  [{:keys [id heading actions close-label attrs] :or {close-label "閉じる"}} & body]
  ;; the wrapper owns its class (jp-go-dds merges its own attrs last, so a
  ;; consumer cannot break a component's identity); the sheet's class is
  ;; appended after
  (-> (apply dds/modal-dialog
             {:id id :heading heading :actions actions :close-label close-label
              :attrs (merge {:data-sheet "settings"} attrs)}
             body)
      (update-in [1 :class] str " ck-sheet")))

(def css
  "Compact = bottom sheet (the dialog's flex column ends at the bottom, the
   panel is full-width with the top corners rounded, capped below the
   safe-area); above :sm the DADS centered dialog. Token-contract only;
   the band is --hig-breakpoint-sm's 640px."
  (str
   ".ck-sheet .dads-modal-dialog__dialog{max-block-size:calc(100dvh - var(--hig-spacing-8));overflow:auto}"
   "@media(max-width:" (:max-width (second tokens/breakpoints)) "px){"
   ".ck-sheet:modal{justify-content:flex-end;padding:0}"
   ".ck-sheet::before{display:none}.ck-sheet::after{block-size:env(safe-area-inset-bottom,0px);min-block-size:0;flex-shrink:0}"
   ".ck-sheet .dads-modal-dialog__dialog{inline-size:100%;max-inline-size:none;border-radius:var(--hig-radius-lg) var(--hig-radius-lg) 0 0;max-block-size:calc(100dvh - var(--hig-spacing-8))}"
   "}"))
