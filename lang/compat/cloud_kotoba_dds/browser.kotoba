(ns cloud-kotoba-dds.browser)
(def script "(function(global){\n'use strict';\nfunction createMessage({container,input,role,userLabel,stages}){\n if(!container||!Array.isArray(stages))throw new TypeError('container and stages are required');\n const doc=container.ownerDocument;\n function node(tag,cls,text){const n=doc.createElement(tag);n.className=cls;if(text!==undefined)n.textContent=text;return n;}\n const user=node('article','go-message go-user');user.append(node('span','go-role',userLabel),node('div','go-text',input));\n const answer=node('article','go-message go-assistant');answer.append(node('span','go-role',role));\n const steps=node('ol','go-steps');for(const stage of stages){const item=node('li','',stage.label);item.dataset.stage=stage.id;steps.append(item);}\n const live=node('p','go-turn-status');live.setAttribute('role','status');\n const output=node('div','go-text');const actions=node('div','go-actions');answer.append(steps,live,output,actions);container.append(user,answer);\n return {answer,steps,live,output,actions};\n}\nglobal.cloudKotobaChat=Object.freeze({createMessage});\n})(globalThis);\n")
