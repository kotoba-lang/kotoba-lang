(ns ipld.link
  "Lightweight explicit IPLD Link value and DAG-CBOR tag-42 adapter.

  Parsing or re-emitting an existing CID uses dependency-free base32 only. It
  does not load CID hashing, so canonical value consumers without storage or
  content-addressing authority need no npm hash implementation.

  The typed half (adr-2609242330 S1c): `link-tag-bytes` and `link-fragment`
  take the CID string itself and answer tag 42's content and the whole
  encoded tag-42 item through cbor.core's typed encoder. They are the Kotoba
  module (the `Link` record, its protocol and the `Tagged` adapters are host
  values: Kotoba has no value whose type is only known at run time), and on
  the hosts they write the bytes `(cbor/encode (link->tag (link cid)))`
  writes."
  {:kotoba/export [link-fragment link-tag-bytes]}
  (:require [cbor.core :as cbor] [multiformats.base32 :as base32] [kotoba.lang.text :as str]))

;; ── typed: a CID string to tag 42 ────────────────────────────────────────────

(defn link-tag-bytes
     "Tag 42's content for the base32 `b`-multibase CID string CID: the 0x00
     identity-multibase prefix, then the binary CID. Traps on a CID that is
     not `b`-prefixed (the hosts throw)."
     [cid :string] :vector-i64
     (do (assert (= 98 (string-code-point-at cid 0)))
         (into [0] (base32/decode (string-substring cid 1 (string-byte-length cid))))))

(defn link-fragment
  "The DAG-CBOR item for a link to CID: tag 42 around `link-tag-bytes`."
  [cid :string] :vector-i64
  (cbor/encode-tag 42 (cbor/encode-bytes (link-tag-bytes cid))))

;; ── host: the Link value and the Tagged adapters ─────────────────────────────
(def ^:private host-link-value "Link, ILink and the Tagged adapters are host values")
