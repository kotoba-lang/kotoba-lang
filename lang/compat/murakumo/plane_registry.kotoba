(ns murakumo.plane-registry
  "The plane registry of murakumo, the resource layer
(root ADR-2610101900 P2/P3; one plane = one mon).

A plane is a kind of work that runs on murakumo nodes. Each entry says what it
promises, how a result is checked, what it meters and in which unit it settles,
which public gate and token scope reach it, what a node needs to run it, and
whether the node's operator must opt in. Nodes and settlement are shared; gates,
scopes, verification rules and metering are per plane.

:core is not a plane: it is the resource layer itself (identity, enrollment,
capability, placement and lease, metering, receipts, fleet operations).

:plane/namespaces are namespace PREFIXES in this repo. Every namespace under src/
belongs to exactly one owner by longest prefix, and a prefix that matches nothing
is stale (both checked by test/murakumo/plane_test.cljk). That is the core split
of P2, as an enforced map rather than a file move: nothing moved, no behaviour
changed.

Read by murakumo.plane; served at murakumo.cloud/.well-known/murakumo-planes.json
(network-awai/cloud-murakumo) without :plane/namespaces. Settlement units: :kumo (compute), :yata (storage),
:en (awai gas) — planes meter, they do not mint (ADR-2610101900 decision 7).")

(def registry
  {:registry/version 1

   :core
   {:plane/namespaces ["murakumo"]                ; everything not claimed below
    :plane/repos ["kotoba-lang/murakumo" "network-awai/cloud-murakumo" "network-awai/cloud-murakumo-api"]}

   :planes
   [{:plane/id :inference
     :plane/name "murakumo inference"
     :plane/status :live
     :plane/gate {:host "api.murakumo.cloud" :scope "chat"}
     :plane/promise "OpenAI-compatible /v1 completions from fleet engines"
     :plane/metering :tokens
     :plane/settlement :kumo
     :plane/verification :poi-spot-reexecution
     :plane/requires #{:accelerator}
     :plane/opt-in? false
     :plane/engine-recorded-per-node? true          ; kotoba-inference | llama.cpp | ...
     :plane/namespaces ["murakumo.infer" "murakumo.poi" "murakumo.bench" "murakumo.model-setup"]
     :plane/repos ["kotoba-lang/inference" "network-awai/cloud-murakumo-api"]
     :plane/adr ["root ADR-2610101900" "ADR-261010 proof of inference"]}

    {:plane/id :generation
     :plane/name "generation"
     :plane/status :live
     :plane/gate {:host "generation.murakumo.cloud" :scope "generation"}
     :plane/promise "video, voice, music and image artifacts named by their sha256"
     :plane/metering :jobs
     :plane/settlement :kumo
     :plane/verification :artifact-hash
     :plane/requires #{:accelerator}
     :plane/opt-in? false
     :plane/namespaces ["murakumo.infer.media" "murakumo.infer.image-job" "murakumo.infer.image-native"
                        "murakumo.infer.image-worker" "murakumo.image-model"]
     :plane/repos ["kotoba-lang/cloud-murakumo-generation" "network-awai/cloud-murakumo"]
     :plane/adr ["root ADR-2610101900"]}

    {:plane/id :storage
     :plane/name "storage (yataverse bytes, kotobase datom/graph)"
     :plane/status :live
     :plane/gate {:host "yataverse.com" :scope "storage"}
     :plane/promise "content-addressed bytes, verified on every read and after every write"
     :plane/metering :gb-month
     :plane/settlement :yata
     :plane/verification :cid-recompute
     :plane/requires #{:disk}
     :plane/opt-in? false
     :plane/namespaces []
     :plane/repos ["kotoba-lang/yataverse" "kotoba-lang/yataverse-distribution" "cloud-kotoba/kotobase-ipfs"]
     :plane/adr ["root ADR-2609131630" "root ADR-2609151800"]}

    {:plane/id :web
     :plane/name "web"
     :plane/status :live
     :plane/gate {:host "web.murakumo.cloud" :scope "web"}
     :plane/promise "fetch, extract, crawl and search with signed node receipts"
     :plane/metering :pages
     :plane/settlement :kumo
     :plane/verification :cross-zone-refetch
     :plane/requires #{:egress}
     :plane/opt-in? true                            ; a node's internet egress is its operator's call
     :plane/namespaces ["murakumo.web"]
     :plane/repos ["network-awai/cloud-murakumo"]
     :plane/adr ["ADR-260929" "root ADR-2610101900"]}

    {:plane/id :jobs
     :plane/name "jobs"
     :plane/status :partial                         ; distributed CI/CD and WASM components exist, no public gate
     :plane/gate {:host "jobs.murakumo.cloud" :scope "jobs"}
     :plane/promise "deterministic work whose result any node can re-execute and compare"
     :plane/metering :cpu-seconds
     :plane/settlement :kumo
     :plane/verification :deterministic-reexecution
     :plane/requires #{:wasm}
     :plane/opt-in? false
     :plane/namespaces ["murakumo.ci" "murakumo.cd" "murakumo.blob" "murakumo.artifact-import"
                        "murakumo.artifact-protocol" "murakumo.artifact-remote" "murakumo.artifact-replication"
                        "murakumo.artifact-store" "murakumo.component-authority" "murakumo.component-authority-deploy"
                        "murakumo.component-authority-http" "murakumo.component-authority-store"
                        "murakumo.component-runtime-deploy" "murakumo.publisher"]
     :plane/repos ["kotoba-lang/kototama"]
     :plane/adr ["0001-murakumo-native-distributed-cicd" "root ADR-2610101900 P5"]}

    {:plane/id :lease
     :plane/name "lease"
     :plane/status :planned                         ; needs strong isolation and an escrow decision first
     :plane/gate {:host "lease.murakumo.cloud" :scope "lease"}
     :plane/promise "time on a declared machine (container/VM), not a checked result"
     :plane/metering :machine-hours
     :plane/settlement :kumo
     :plane/verification :none-reputation-and-escrow
     :plane/requires #{:accelerator :strong-isolation}
     :plane/opt-in? true
     :plane/namespaces []
     :plane/repos []
     :plane/adr ["root ADR-2610101900 P6"]}

    {:plane/id :app
     :plane/name "app (kotoba apps, one mon each)"
     :plane/status :planned
     :plane/gate {:host :app-own-apex :scope :app-defined}
     :plane/promise "an app's own validation rules on its own records"
     :plane/metering :operations
     :plane/settlement :en
     :plane/verification :mon-validation-rules
     :plane/requires #{}
     :plane/opt-in? false
     :plane/namespaces []
     :plane/repos ["kotoba-lang/kototama"]
     :plane/adr ["root ADR-2610082200"]}]})
