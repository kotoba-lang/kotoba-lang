(ns murakumo.mesh.install-cli
  "Run a mesh install plan on a node over SSH.

    kbb -cp src:resources -m murakumo.mesh.install-cli seed   --host root@100.x --node-name seed-a
    kbb -cp src:resources -m murakumo.mesh.install-cli joiner --host root@100.y --node-name node-b --token murakumo-mesh:v1:...
    ... --dry-run   print the script and run nothing

  The seed prints a join token; hand it to the joiner install. Exit 0 only when
  the node verified its own units active, 1 when it did not, 2 for bad input."
  (:require [kotoba.lang.text :as str]
            [murakumo.mesh.install :as install]
            [murakumo.ssh :as ssh]))

(defn run!
  "Install `role` on `host`. Returns {:ok? :out :err :join-token}."
  [host role opts {:keys [dry-run?]}]
  (let [{:keys [script stdin]} (install/plan role opts)]
    (if dry-run?
      {:ok? true :dry-run true :script script}
      (let [{:keys [exit out err]} (ssh/sh-in host (install/remote-command script) (or stdin ""))]
        {:ok? (zero? exit) :exit exit :out (str/trim (str out)) :err (str/trim (str err))
         :join-token (install/join-token-from-output out)}))))

(defn- parse-args [args]
  (loop [m {} [k v & more :as as] (rest args)]
    (if (empty? as)
      (assoc m :role (keyword (first args)))
      (case k
        "--dry-run" (recur (assoc m :dry-run? true) (rest as))
        "--host" (recur (assoc m :host v) more)
        "--node-name" (recur (assoc m :node-name v) more)
        "--token" (recur (assoc m :token v) more)
        "--phy" (recur (assoc m :phy v) more)
        "--iface" (recur (assoc m :iface v) more)
        "--frequency" (recur (assoc m :frequency (str v)) more)
        (throw (ex-info (str "unknown argument " k) {:arg k}))))))

(defn -main [& args]
  (let [{:keys [role host dry-run?] :as o}
        (try (parse-args args) (catch :default e (println (ex-message e)) nil))]
    (if-not (and o (#{:seed :joiner} role) (or host dry-run?) (:node-name o))
      (do (println "usage: install-cli seed|joiner --host H --node-name N [--token T] [--dry-run]")
          )
      (let [r (try (run! host role (dissoc o :role :host :dry-run?) {:dry-run? dry-run?})
                   (catch :default e {:ok? false :err (ex-message e)}))]
        (cond
          (:dry-run r) (println (:script r))
          (:ok? r) (do (println (:out r))
                       (when (= :seed role)
                         (println "\nHand this token to the joiner install:\n" (:join-token r))))
          :else (do (println "install failed:" (:err r))
                    ))))))
