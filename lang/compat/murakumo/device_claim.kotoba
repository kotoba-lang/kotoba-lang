(ns murakumo.device-claim
  "One device-side response to a buyer's short-lived ownership challenge.
  The node signs only the canonical grant.device-attest frame; the buyer's
  browser still finishes the claim. No operator credential reaches this path."
  (:require [grant.device-attest :as attest]
            ["node:crypto" :as crypto]))

(defn- challenge-path [site did]
  (str site "/api/devices/" (js/encodeURIComponent did) "/challenge"))

(defn- attest-path [site did]
  (str site "/api/devices/" (js/encodeURIComponent did) "/attest"))

(defn- read-json [response]
  (-> (.json response)
      (.then (fn [body] (js->clj body)))))

(defn- failure [outcome]
  (or (get attest/exit-codes outcome) 2))

(defn- submit-proof! [fetch-fn site id plan]
  (let [did (.-did id)
        input (attest/signing-input {:did did :endpoint site :nonce (:nonce plan)})]
    (if-not (string? input)
      {:outcome :malformed :exit-code 2}
      (let [signature (.toString
                       (.sign crypto nil (js/Buffer.from input "utf8")
                              (.-privateKey id)) "base64url")
            request (fetch-fn (attest-path site did)
                              #js {:method "POST" :redirect "error"
                                   :headers #js {"content-type" "application/json"}
                                   :body (js/JSON.stringify
                                          #js {:challenge (:challenge plan)
                                               :signature signature})
                                   :signal (js/AbortSignal.timeout 10000)})]
        (.catch
         (.then request
                (fn [answer]
                  (.then (read-json answer)
                         (fn [body]
                           (let [result (attest/interpret-attest
                                         {:status (.-status answer) :body body})
                                 outcome (:outcome result)]
                             {:outcome outcome :exit-code (failure outcome)})))))
         (fn [_] {:outcome :unreachable :exit-code 3}))))))

(defn- respond! [fetch-fn now-fn site id response body]
  (let [plan (attest/plan-poll {:status (.-status response)
                                :body body :now-ms (now-fn)})]
    (case (:action plan)
      :idle {:outcome :idle :exit-code 0}
      :skip {:outcome :skipped :exit-code 0}
      :sign (submit-proof! fetch-fn site id plan)
      {:outcome :malformed :exit-code 2})))

(defn once!
  "Return Promise<{:outcome :exit-code}>. `fetch-fn` and `now-fn` are injected
  so wire behavior can be tested without contacting a buyer or live device."
  [fetch-fn now-fn site id]
  (let [request (fetch-fn (challenge-path site (.-did id))
                          #js {:method "GET" :redirect "error"
                               :signal (js/AbortSignal.timeout 10000)})]
    (.catch
     (.then request
            (fn [response]
              (.then (read-json response)
                     (fn [body] (respond! fetch-fn now-fn site id response body)))))
     (fn [_] {:outcome :unreachable :exit-code 3}))))
