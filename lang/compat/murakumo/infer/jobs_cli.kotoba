(ns murakumo.infer.jobs-cli
  (:require [murakumo.infer.jobs :as jobs]
            [murakumo.infer.resident :as resident]
            [murakumo.infer.replicated-topology :as topo]
            ["node:fs" :as fs]))

(defn run-command [command args]
  (let [config-index (.indexOf (clj->js args) "--config")
        file (nth args (inc config-index) nil)
        _ (when (or (neg? config-index) (nil? file) (not= (+ config-index 2) (count args)))
            (throw (js/Error. "jobs submit ID INPUT.json --config FILE | jobs status ID --config FILE")))
        config (js->clj (js/JSON.parse (.readFileSync fs file "utf8")) :keywordize-keys true)
        token (resident/private-token (:token-file config))
        [id input-file] (take config-index args)
        _ (when-not (and (jobs/valid-id? id) (contains? #{"submit" "status"} command)
                         (= config-index (if (= command "submit") 2 1)))
            (throw (js/Error. "invalid jobs command")))
        endpoints (:endpoints config)
        _ (when-not (and (seq endpoints) (every? #(topo/endpoint? % (:allow-loopback? config false)) endpoints))
            (throw (js/Error. "jobs client needs declared Tailnet endpoints")))
        body (when (= command "submit") (js->clj (js/JSON.parse (.readFileSync fs input-file "utf8")) :keywordize-keys true))]
    (letfn [(attempt [urls]
              (if-let [url (first urls)]
                (-> (jobs/request! (str url "/jobs/" id) token (if body "POST" "GET") body 30000)
                    (.catch (fn [_] (attempt (rest urls)))))
                (js/Promise.reject (js/Error. "no job endpoint reached quorum; retry only with the same job ID"))))]
      (-> (attempt endpoints)
          (.then #(println (topo/encoded %)))))))
