(ns murakumo.node-console-qr
  "The one place the console needs an npm package: a QR encoder. Kept apart from `murakumo.node-console`
  so that namespace stays pure and testable without it."
  (:require [kotoba.lang.text :as str]
            ["qrcode-generator" :as qrcode-generator]))

(defn qr-lines
  "A QR code for `text` as lines of half-block characters (two modules per character row, a two-module
  quiet zone), or nil if it does not fit one."
  [text]
  (try
    (let [make (or (.-default qrcode-generator) qrcode-generator)
          qr (make 0 "L")]
      (.addData qr text)
      (.make qr)
      (vec (str/split-lines (.createASCII qr 1 2))))
    (catch :default _ nil)))
