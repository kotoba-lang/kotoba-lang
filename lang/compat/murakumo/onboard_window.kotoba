(ns murakumo.onboard-window
  "The provisioning window of a box that is being handed its Wi-Fi by sound (ADR-0243).

  Pure: a session map in, a session map out. The shell that listens and plays lives in
  `murakumo.onboard-device`; every rule that decides when the window is open lives here
  so it can be tested without a speaker.

  What the window does:

  - It is open for `ttl-ms` from the start, and no longer.
  - A message that opens receives the profile and ends the window. The box then checks
    whether it came online; if it did not (a mistyped passphrase), the shell starts a
    NEW window with a new code, so a wrong password does not strand the box.
  - A message that does not open is an attempt. The code is rotated after each one and
    the window closes after `max-attempts`, so the beacon cannot be used to guess at the
    label secret over the air.
  - Noise, or the box's own beacon heard back from its speaker, is not an attempt.")

(def default-ttl-ms (* 15 60 1000))
(def default-max-attempts 5)

(defn start
  "A new open window. `rand-code` is a function so a test can fix the code."
  [{:keys [now-ms ttl-ms max-attempts rand-code]
    :or {ttl-ms default-ttl-ms max-attempts default-max-attempts}}]
  {:state :open
   :code (rand-code)
   :attempts 0
   :max-attempts max-attempts
   :started-ms now-ms
   :deadline-ms (+ now-ms ttl-ms)})

(defn tick
  "Close an expired window. Nothing else changes with time: the code is not rotated by
  the clock, only by an attempt, so a person who is mid-way through typing a passphrase
  is not outrun by a beacon that changed under them."
  [session now-ms]
  (if (and (= :open (:state session)) (>= now-ms (:deadline-ms session)))
    (assoc session :state :closed :reason :timeout)
    session))

(defn heard
  "Apply what `murakumo.onboard/open` made of a heard message.

  Returns `{:session s :effect e}`, where `e` is one of
    :received       the profile opened; the session carries `:profile`
    :rotated        an attempt that did not open; the session carries a new `:code`
    :closed         that was the last permitted attempt
    nil             not an attempt (noise, the box's own beacon), nothing changed

  A closed or received session ignores everything: the window does not reopen itself."
  [session result rand-code]
  (cond
    (not= :open (:state session)) {:session session :effect nil}

    (and (map? result) (contains? result :ssid))
    {:session (assoc session :state :received :profile result) :effect :received}

    (= :not-a-profile (:error result)) {:session session :effect nil}

    :else
    (let [attempts (inc (:attempts session))]
      (if (>= attempts (:max-attempts session))
        {:session (assoc session :attempts attempts :state :closed :reason :too-many-attempts)
         :effect :closed}
        {:session (assoc session :attempts attempts :code (rand-code))
         :effect :rotated}))))

(defn open? [session] (= :open (:state session)))
