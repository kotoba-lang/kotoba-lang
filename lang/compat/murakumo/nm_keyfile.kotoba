(ns murakumo.nm-keyfile
  "A NetworkManager keyfile for a Wi-Fi profile that arrived by sound (ADR-0243).

  Pure: a profile and a UUID in, text or `{:error reason}` out. The keyfile is what
  carries the passphrase to NetworkManager, instead of an `nmcli ... password ...`
  argument that every user on the box could read in the process list; the caller writes
  it mode 0600 and asks NetworkManager to reload.

  A keyfile is line-oriented, so a value containing a newline would end its own line and
  let the rest be read as another setting. That is refused rather than escaped.")

(def ^:private key-mgmt {:wpa2-personal "wpa-psk" :wpa3-personal "sae"})

(defn- framing-safe? [s]
  (and (string? s) (not (re-find #"[\r\n]" s))))

(defn problem
  "Why this profile cannot be written as a keyfile, or nil."
  [{:keys [ssid security passphrase]}]
  (cond
    (not (contains? #{:open :wpa2-personal :wpa3-personal} security)) :unknown-security
    (not (framing-safe? ssid)) :ssid-not-framing-safe
    (and (not= :open security) (not (framing-safe? passphrase))) :passphrase-not-framing-safe
    :else nil))

(defn keyfile
  "The text of `murakumo-onboard.nmconnection`, or `{:error reason}`."
  [{:keys [ssid security passphrase] :as profile} uuid]
  (if-let [why (problem profile)]
    {:error why}
    (str "[connection]\n"
         "id=murakumo-onboard\n"
         "uuid=" uuid "\n"
         "type=wifi\n"
         "autoconnect=true\n"
         "\n[wifi]\n"
         "mode=infrastructure\n"
         "ssid=" ssid "\n"
         (when (not= :open security)
           (str "\n[wifi-security]\n"
                "key-mgmt=" (get key-mgmt security) "\n"
                "psk=" passphrase "\n"))
         "\n[ipv4]\nmethod=auto\n"
         "\n[ipv6]\nmethod=auto\n")))
