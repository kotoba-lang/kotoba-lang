(ns murakumo.plane
  "The plane registry (resources/murakumo/planes.edn; root ADR-2610101900 P2/P3).
  Pure.

  murakumo is the resource layer; a plane is a kind of work on its nodes with its
  own gate, token scope, verification rule and metering, settling in a shared unit.
  This namespace validates the registry, says which planes a node may run, and maps
  every namespace of this repo to exactly one owner (:core or a plane)."
  (:require [kotoba.lang.text :as text]))

(def statuses #{:live :partial :planned})
(def settlements #{:kumo :yata :en})
(def capabilities #{:accelerator :disk :egress :wasm :strong-isolation})

(def required-keys
  [:plane/id :plane/name :plane/status :plane/gate :plane/promise :plane/metering
   :plane/settlement :plane/verification :plane/requires :plane/opt-in? :plane/namespaces])

(defn- ns-name? [s] (boolean (and (string? s) (re-matches #"[a-z][a-z0-9-]*(\.[a-z][a-z0-9-]*)*" s))))

(defn plane-problems
  "Problems with one descriptor, as keywords; empty when it is valid."
  [p]
  (cond-> []
    (not (map? p)) (conj :plane/not-a-map)
    (and (map? p) (some #(not (contains? p %)) required-keys)) (conj :plane/missing-keys)
    (and (map? p) (not (keyword? (:plane/id p)))) (conj :plane/id)
    (and (map? p) (not (statuses (:plane/status p)))) (conj :plane/status)
    (and (map? p) (not (settlements (:plane/settlement p)))) (conj :plane/settlement)
    (and (map? p) (not (and (set? (:plane/requires p)) (every? capabilities (:plane/requires p)))))
    (conj :plane/requires)
    (and (map? p) (not (boolean? (:plane/opt-in? p)))) (conj :plane/opt-in?)
    (and (map? p) (not (and (vector? (:plane/namespaces p)) (every? ns-name? (:plane/namespaces p)))))
    (conj :plane/namespaces)
    (and (map? p) (not (and (map? (:plane/gate p)) (contains? (:plane/gate p) :host) (contains? (:plane/gate p) :scope))))
    (conj :plane/gate)))

(defn validate
  "{:ok registry} or {:refused {...}}. Ids and gate hosts must be unique: one plane,
  one subdomain."
  [{:keys [planes core] :as registry}]
  (let [per-plane (into {} (keep (fn [p] (let [ps (plane-problems p)] (when (seq ps) [(:plane/id p) ps])))) planes)
        ids (map :plane/id planes)
        hosts (filter string? (map (comp :host :plane/gate) planes))]
    (cond
      (not (and (vector? planes) (seq planes))) {:refused {:registry :no-planes}}
      (not (and (map? core) (every? ns-name? (:plane/namespaces core)))) {:refused {:registry :core}}
      (seq per-plane) {:refused per-plane}
      (not= (count ids) (count (distinct ids))) {:refused {:registry :duplicate-id}}
      (not= (count hosts) (count (distinct hosts))) {:refused {:registry :duplicate-gate-host}}
      :else {:ok registry})))

(defn by-id [registry id] (first (filter #(= id (:plane/id %)) (:planes registry))))

(defn eligible-planes
  "Planes a node may run: not :planned, every required capability present, and the
  node's operator has opted in where the plane asks for it.
  node = {:capabilities #{...} :opt-in #{plane-id ...}}."
  [registry {:keys [capabilities opt-in]}]
  (let [caps (set capabilities) opted (set opt-in)]
    (->> (:planes registry)
         (filter (fn [p] (and (not= :planned (:plane/status p))
                              (every? caps (:plane/requires p))
                              (or (not (:plane/opt-in? p)) (opted (:plane/id p))))))
         (mapv :plane/id))))

(defn- prefix-of? [prefix ns] (or (= prefix ns) (text/starts-with? ns (str prefix "."))))

(defn owner
  "The owner of namespace `ns`: the plane id whose prefix matches longest, :core for
  a core prefix, or nil when nothing matches."
  [registry ns]
  (let [claims (concat (for [p (:planes registry), pre (:plane/namespaces p)] [pre (:plane/id p)])
                       (for [pre (:plane/namespaces (:core registry))] [pre :core]))
        hits (filter (fn [[pre _]] (prefix-of? pre ns)) claims)]
    (when (seq hits)
      (second (last (sort-by (comp count first) hits))))))

(defn stale-prefixes
  "Prefixes in the registry that match none of `namespaces`."
  [registry namespaces]
  (vec (for [p (:planes registry), pre (:plane/namespaces p)
             :when (not-any? #(prefix-of? pre %) namespaces)]
         pre)))

(defn- json-key [k] (-> (name k) (text/replace "-" "_") (text/replace "?" "")))

(defn- json-val [v]
  (cond
    (keyword? v) (name v)
    (set? v) (vec (sort (map json-val v)))
    (sequential? v) (mapv json-val v)
    (map? v) (into (sorted-map) (map (fn [[k x]] [(json-key k) (json-val x)])) v)
    :else v))

(defn public-view
  "The registry as published (murakumo.cloud/.well-known/murakumo-planes.json):
  every plane without its namespace prefixes, which are this repo's internals.
  Keys and keyword values become strings; boolean keys lose the `?`."
  [registry]
  {"version" (:registry/version registry)
   "layer" "murakumo is the resource layer; planes share its nodes and settlement (root ADR-2610101900)"
   "planes" (mapv #(json-val (dissoc % :plane/namespaces)) (:planes registry))})
