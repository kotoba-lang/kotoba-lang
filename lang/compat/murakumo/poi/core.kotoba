(ns murakumo.poi.core
  "Proof of Inference integer rules (ADR-261010, 261010b, 261010c, 261010d).

  Host mirror of kotoba/poi_core.kotoba; parity is asserted by
  test/murakumo/poi_kotoba_parity_test.cljk. Units:
    VCU   micro-VCU (1 uVCU = 1 GFLOP of verified forward compute)
    KUMO  base units (1 KUMO = 1e6 base; the 2.1e15 total stays exact below
          2^53, so JS numbers and EDN carry it on every host)
    money micro-USD
  Era 0 runs from genesis to the first Bitcoin halving height after genesis;
  later eras are 210,000 Bitcoin blocks, so KUMO halves on Bitcoin's blocks.")

(def subsidy-total-base 1995000000000000)
(def mga-base 105000000000000)
(def halving-interval 210000)
(def maturity-blocks 144)
(def base-per-kumo 1000000)
(def bitcoin-halvings
  "Bitcoin halving heights from the next one on."
  (iterate #(+ % halving-interval) 1050000))

(defn next-bitcoin-halving
  "First Bitcoin halving height strictly above `height`."
  [height]
  (first (drop-while #(<= % height) bitcoin-halvings)))

(defn uvcu-text [{:keys [p-active-m t-in t-out cached] :or {cached 0}}]
  (quot (* 2 p-active-m (+ t-out (max 0 (- t-in cached)))) 1000))

(defn uvcu-diffusion [{:keys [p-m latent steps cfg] :or {cfg 1}}]
  (quot (* 2 p-m latent steps cfg) 1000))

(defn subsidy-r0 [{:keys [genesis next-halving]}]
  (let [l0 (- next-halving genesis)]
    (if (neg? l0) 0 (quot subsidy-total-base (+ l0 halving-interval)))))

(defn halve-n [{:keys [amount n]}]
  (loop [amount amount n n]
    (cond (< n 1) amount
          (< amount 1) 0
          :else (recur (quot amount 2) (dec n)))))

(defn subsidy-at [{:keys [height genesis next-halving]}]
  (let [r0 (subsidy-r0 {:genesis genesis :next-halving next-halving})]
    (cond (< height genesis) 0
          (< height next-halving) r0
          :else (halve-n {:amount r0
                          :n (inc (quot (- height next-halving) halving-interval))}))))

(defn treasury-cut [{:keys [subsidy height genesis]}]
  (if (< (- height genesis) halving-interval) (quot subsidy 10) 0))

(defn verification-cut [{:keys [subsidy]}]
  (quot (* subsidy 5) 100))

(defn production [split]
  (- (:subsidy split) (+ (treasury-cut split) (verification-cut split))))

(defn customer-pool [{:keys [production fees-uusd price-uusd lambda-num lambda-den]
                      :or {lambda-num 1 lambda-den 1}}]
  (if (or (< price-uusd 1) (< lambda-den 1))
    0
    (min production
         (quot (* fees-uusd lambda-num base-per-kumo) (* price-uusd lambda-den)))))

(defn capacity-pool [c]
  (- (:production c) (customer-pool c)))

(defn wash-unprofitable? [{:keys [s-bp c-bp fee e]}]
  (< (* s-bp (+ (* (- 10000 c-bp) fee) (* 10000 e)))
     (* 10000 10000 fee)))

(defn mature? [{:keys [settled now]}]
  (>= (- now settled) maturity-blocks))

(defn season0-points [{:keys [uvcu btc-proven]}]
  (if (pos? btc-proven) (quot (* uvcu 3) 2) uvcu))

(defn verify-pass? [{:keys [matched total min-num min-den]}]
  (and (pos? total) (>= (* matched min-den) (* total min-num))))

(defn split-subsidy
  "One block's subsidy split (ADR-261010b §4)."
  [{:keys [height genesis next-halving fees-uusd price-uusd]
    :or {fees-uusd 0 price-uusd 0}}]
  (let [subsidy (subsidy-at {:height height :genesis genesis :next-halving next-halving})
        split {:subsidy subsidy :height height :genesis genesis}
        prod (production split)
        pool {:production prod :fees-uusd fees-uusd :price-uusd price-uusd
              :lambda-num 1 :lambda-den 1}
        cust (customer-pool pool)]
    {:subsidy subsidy
     :treasury (treasury-cut split)
     :verification (verification-cut split)
     :production prod
     :customer-pool cust
     :capacity-pool (- prod cust)}))

(defn pro-rata
  "Floor-split `amount` over {k weight}; the remainder goes to the largest
  weight so the split conserves `amount` exactly."
  [amount weights]
  (let [total (reduce + 0 (vals weights))]
    (if (or (zero? total) (zero? amount))
      {}
      (let [floor (into {} (map (fn [[k w]] [k (quot (* amount w) total)]) weights))
            left (- amount (reduce + 0 (vals floor)))
            top (key (apply max-key val weights))]
        (update floor top + left)))))
