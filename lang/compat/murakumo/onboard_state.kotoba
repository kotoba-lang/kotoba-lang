(ns murakumo.onboard-state
  "The state directory of a box that is handed its Wi-Fi by sound (ADR-0243): the label
  secret printed on its label, the X25519 key that decrypts what it is sent, the encrypted
  message it received, and the marker that keeps it from beaconing after its claim.

  Kept apart from the listening loop so that what may be read, what is created private and
  what is deleted when the claim goes through can be tested without a sound card or a
  decoder."
  (:require [grant.acoustic-onboard :as ao]
            ["node:fs" :as fs] ["node:path" :as path] ["node:crypto" :as crypto]))

(def default-state-dir "/var/lib/murakumo/onboard")

;; ── the state directory ───────────────────────────────────────────────────

(defn- file [dir name] (.join path dir name))

(defn- read-private
  "The contents of a file that only its owner can read, or nil if absent. A file readable
  by others is refused rather than used: the label secret and the device key are secrets."
  [p]
  (when (.existsSync fs p)
    (let [fd (.openSync fs p (bit-or (.-O_RDONLY (.-constants fs)) (.-O_NOFOLLOW (.-constants fs))))]
      (try
        (let [st (.fstatSync fs fd)]
          (when (or (not (.isFile st)) (not= 0 (bit-and (.-mode st) 63)))
            (throw (js/Error. (str p " must be a private regular file (chmod 600)."))))
          (.readFileSync fs fd "utf8"))
        (finally (.closeSync fs fd))))))

(defn- write-private! [p text]
  (.mkdirSync fs (.dirname path p) #js {:recursive true :mode 448})
  (let [tmp (str p ".tmp-" (.toString (.randomBytes crypto 4) "hex"))]
    (.writeFileSync fs tmp text #js {:mode 384 :flag "wx"})
    (.renameSync fs tmp p)))

(defn label-secret
  "The box's label secret from its factory state, or `{:error reason}`. Without it the
  box cannot be provisioned this way and says so, instead of beaconing."
  [dir]
  (if (.existsSync fs (file dir "closed"))
    {:error :window-closed}
    (let [ls (some-> (read-private (file dir "label-secret")) .trim)]
      (cond
        (nil? ls) {:error :no-label-secret}
        (ao/label-secret-problem ls) {:error :bad-label-secret}
        :else {:label-secret ls}))))

(defn load-device-key!
  "The box's X25519 decryption key, created on first use and kept in a private file. It
  is a different key from the signing identity and never leaves the box; only its public
  half is broadcast."
  [dir]
  (let [p (file dir "device-key.pem")]
    (if-let [pem (read-private p)]
      (.createPrivateKey crypto pem)
      (let [pair (.generateKeyPairSync crypto "x25519")
            pem (.export (.-privateKey pair) #js {:format "pem" :type "pkcs8"})]
        (write-private! p pem)
        (.-privateKey pair)))))

(defn store-envelope!
  "Keep the received message as it arrived, encrypted. The passphrase is not written here."
  [dir {:keys [code fp message]}]
  (write-private! (file dir "envelope.json")
                  (js/JSON.stringify
                   (clj->js {:suite ao/suite :code code :fp fp
                             :message (.toString (js/Buffer.from (clj->js message)) "base64")
                             :received-at (.toISOString (js/Date.))}))))

(defn retire!
  "Called when the claim goes through. The label secret and the device key are no longer
  needed and are deleted; a marker keeps the box from beaconing again."
  [dir]
  (doseq [n ["label-secret" "device-key.pem" "envelope.json"]]
    (let [p (file dir n)] (when (.existsSync fs p) (.unlinkSync fs p))))
  (when (.existsSync fs dir) (.writeFileSync fs (file dir "closed") "" #js {:mode 384})))

