(ns murakumo.onboard
  "Seal and open the Wi-Fi profile that a headless box is handed by sound (ADR-0243).

  `grant.acoustic-onboard` decides the bytes: what is fed to HKDF, what the plaintext
  and the frame look like. This namespace is the part that needs a crypto library,
  and nothing else: X25519, HKDF-SHA256 and AES-256-GCM through node:crypto.

  Both directions live here because the PC helper seals and the box opens, and a
  disagreement between them is silent -- an envelope that opens nowhere. They are
  tested against the same golden vector as the browser's WebCrypto path
  (grant `test/vectors/acoustic-onboard.mjs`), so agreement is checked on bytes."
  (:require [grant.acoustic-onboard :as ao]
            [kotoba.bytes :as kbytes]
            ["node:crypto" :as crypto]))

(def ^:private pkcs8-x25519-prefix (js/Buffer.from "302e020100300506032b656e04220420" "hex"))
(def ^:private spki-x25519-prefix (js/Buffer.from "302a300506032b656e032100" "hex"))

(defn- buf [v] (js/Buffer.from (clj->js (vec v))))
(defn- ->vec [b] (vec (js/Array.from b)))

(defn- public-raw [^js private-key]
  (let [der (.export (.createPublicKey crypto private-key) #js {:format "der" :type "spki"})]
    (.subarray der (- (.-length der) 32))))

(defn- public-key-from-raw [^js raw]
  (.createPublicKey crypto #js {:key (js/Buffer.concat #js [spki-x25519-prefix raw])
                                :format "der" :type "spki"}))

(defn public-key-b64url
  "The 43-character base64url of a private key's public half: what the beacon carries."
  [^js private-key]
  (.toString (public-raw private-key) "base64url"))

(defn private-key-from-seed
  "A KeyObject from a 32-byte seed as hex. For vectors and tests; real keys are
  generated by `generate-device-key` and never leave the device."
  [seed-hex]
  (.createPrivateKey crypto #js {:key (js/Buffer.concat #js [pkcs8-x25519-prefix (js/Buffer.from seed-hex "hex")])
                                 :format "der" :type "pkcs8"}))

(defn generate-device-key
  "`{:private-key <KeyObject> :public-key <base64url, 43 chars>}`. The caller keeps
  the private half in a private file (mode 0600); only the public half is ever
  broadcast, in the beacon."
  []
  (let [pair (.generateKeyPairSync crypto "x25519")
        private-key (.-privateKey pair)]
    {:private-key private-key
     :public-key (.toString (public-raw private-key) "base64url")}))

(defn- derive-key-iv
  "HKDF-SHA256 over the X25519 shared secret, bound by `grant.acoustic-onboard/binding`."
  [shared binding]
  (let [okm (js/Buffer.from (.hkdfSync crypto "sha256" shared
                                       (js/Buffer.from (:salt binding) "utf8")
                                       (js/Buffer.from (:aad binding) "utf8")
                                       ao/hkdf-output-bytes))
        parts (ao/split-okm (->vec okm))]
    (when-not (:error parts)
      {:key (buf (:key parts)) :iv (buf (:iv parts))
       :aad (js/Buffer.from (:aad binding) "utf8")})))

(defn seal
  "The message a sender plays to the box, as a byte vector, or `{:error reason}`.

  `:device-key` is the box's public key from its beacon (base64url); `:code` and
  `:fp` come from the same beacon; `:label-secret` is read off the box's label;
  `:profile` is `{:ssid :security :passphrase}`. `:ephemeral-seed` (hex) exists so
  a vector can be reproduced; leave it out and a fresh key is made, as it must be
  for every real message, since the IV is derived and so never reused."
  [{:keys [device-key code fp label-secret profile ephemeral-seed]}]
  (let [binding (ao/binding {:code code :fp fp :label-secret label-secret})
        plaintext (ao/encode-plaintext profile)
        key-problem (ao/device-key-problem device-key)]
    (cond
      (:error binding) binding
      (:error plaintext) plaintext
      key-problem {:error key-problem}
      :else
      (let [ephemeral (if ephemeral-seed
                        (private-key-from-seed ephemeral-seed)
                        (:private-key (generate-device-key)))
            peer (public-key-from-raw (js/Buffer.from device-key "base64url"))
            shared (.diffieHellman crypto #js {:privateKey ephemeral :publicKey peer})
            {:keys [key iv aad]} (derive-key-iv shared binding)
            cipher (.createCipheriv crypto "aes-256-gcm" key iv)
            _ (.setAAD cipher aad)
            sealed (js/Buffer.concat #js [(.update cipher (buf plaintext)) (.final cipher)
                                          (.getAuthTag cipher)])]
        (ao/frame {:ephemeral-public-key (->vec (public-raw ephemeral))
                   :ciphertext (->vec sealed)})))))

(defn open
  "What a box makes of a heard message: the profile `{:ssid :security :passphrase}`,
  or `{:error reason}`. `:not-a-profile` for anything that is not one (a beacon
  heard back from its own speaker, noise); `:cannot-open` for a message that is
  one but does not open under this device key, session and label secret --
  tampered, replayed from another session, or sealed without the label secret.

  Applying the profile is a separate step that belongs to the platform."
  [{:keys [private-key code fp label-secret message]}]
  (let [binding (ao/binding {:code code :fp fp :label-secret label-secret})
        frame (ao/parse-frame message)]
    (cond
      (:error binding) binding
      (:error frame) frame
      :else
      (try
        (let [peer (public-key-from-raw (buf (:ephemeral-public-key frame)))
              shared (.diffieHellman crypto #js {:privateKey private-key :publicKey peer})
              {:keys [key iv aad]} (derive-key-iv shared binding)
              ct (buf (:ciphertext frame))
              n (.-length ct)
              decipher (.createDecipheriv crypto "aes-256-gcm" key iv)]
          (.setAAD decipher aad)
          (.setAuthTag decipher (.subarray ct (- n 16)))
          (let [plaintext (js/Buffer.concat #js [(.update decipher (.subarray ct 0 (- n 16)))
                                                 (.final decipher)])]
            (ao/decode-plaintext (->vec plaintext))))
        (catch :default _ {:error :cannot-open})))))

(defn device-fingerprint
  "The `fp` a beacon carries: the first 8 hex digits of SHA-256 of the device DID."
  [did]
  (subs (.digest (.update (.createHash crypto "sha256") did) "hex") 0 8))
