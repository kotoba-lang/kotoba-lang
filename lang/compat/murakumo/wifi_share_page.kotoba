(ns murakumo.wifi-share-page
  "The one page `murakumo node wifi-share` serves on localhost. It hears the box,
  asks the helper to seal, and plays the sealed bytes. It never sees the
  passphrase: sealing happens in the helper process."
  (:require [kotoba.lang.text :as str]))

(defn- script-string [s]
  ;; JSON quoting alone does not stop the HTML parser closing a script element.
  (-> (js/JSON.stringify s)
      (str/replace "<" "\\u003c")
      (str/replace ">" "\\u003e")
      (str/replace "&" "\\u0026")))

(def ^:private page-script
  "const $=s=>document.querySelector(s),T=new URLSearchParams(location.search).get('t');let ctx,gg,inst,dev=null,acked=false;
async function listen(onMsg){const st=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:false,noiseSuppression:false,autoGainControl:false}});
 const src=ctx.createMediaStreamSource(st),p=ctx.createScriptProcessor(4096,1,1);src.connect(p);p.connect(ctx.destination);
 p.onaudioprocess=e=>{const d=e.inputBuffer.getChannelData(0);let m=0;for(const x of d)m=Math.max(m,Math.abs(x));$('#lv').value=m;const o=gg.decode(inst,new Int8Array(new Float32Array(d).buffer));if(o&&o.length)onMsg(new Uint8Array(o));};}
function emit(bytes,vol){const w=gg.encode(inst,Uint8Array.from(bytes),gg.ProtocolId.GGWAVE_PROTOCOL_ULTRASOUND_FAST,vol),f=new Float32Array(w.buffer,w.byteOffset,w.byteLength/4);
 const fd=Math.floor(ctx.sampleRate*.04);for(let i=0;i<fd;i++){f[i]*=i/fd;f[f.length-1-i]*=i/fd;}const b=ctx.createBuffer(1,f.length,ctx.sampleRate);b.getChannelData(0).set(f);const s=ctx.createBufferSource();s.buffer=b;s.connect(ctx.destination);s.start();return f.length/ctx.sampleRate;}
$('#go').onclick=async()=>{try{ctx=new AudioContext();await ctx.resume();gg=await ggwave_factory();const pr=gg.getDefaultParameters();pr.sampleRateInp=ctx.sampleRate;pr.sampleRateOut=ctx.sampleRate;inst=gg.init(pr);
 await listen(m=>{const t=new TextDecoder().decode(m);const b=/^mk1\\|([A-Z0-9]{6})\\|([0-9a-f]{8})\\|([\\w-]{43})$/.exec(t);
  if(b&&!dev){dev={code:b[1],fp:b[2],key:b[3]};$('#code').textContent=dev.code;$('#dev').hidden=false;$('#st').className='ok';$('#st').textContent='端末を聞き取りました。コードが端末側の表示と合うか確かめてから送ってください。';}
  if(dev&&t==='ack|'+dev.code&&!acked){acked=true;$('#ws').className='ok';$('#ws').textContent='端末が音で受領を返しました。';}});
 $('#go').disabled=true;$('#st').textContent='聞き取り中…';}catch(e){$('#st').className='err';$('#st').textContent='マイクを使えません: '+e.message;}};
$('#send').onclick=async()=>{try{const r=await fetch('/seal?t='+T,{method:'POST',body:JSON.stringify(dev)});
 if(r.status===409)throw new Error('ラベルに書かれた端末ではありません(別の箱の音かもしれません)');if(!r.ok)throw new Error('ヘルパーが拒否しました');
 const {payload}=await r.json();const secs=emit(Uint8Array.from(atob(payload),c=>c.charCodeAt(0)),55);acked=false;$('#ws').className='';$('#ws').textContent='音で送信中('+secs.toFixed(0)+'秒)。端末が返す音を待っています。';}catch(e){$('#ws').className='err';$('#ws').textContent=e.message;}};")

(defn page
  "The HTML for one run. `ssid` is shown, never trusted as markup: it goes in
  through JSON, not into the HTML text."
  [ssid]
  (str "<!doctype html><html lang=\"ja\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Wi-Fi をこの PC から渡す</title>"
       "<style>:root{--bg:#f6f7f5;--fg:#16201c;--ac:#0b6e4f;--card:#fff;--line:#d8dedb;--bad:#b3261e}@media(prefers-color-scheme:dark){:root{--bg:#101614;--fg:#e6ece8;--ac:#58d3a0;--card:#18211e;--line:#2a3631;--bad:#ff8a80}}"
       "body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.5 -apple-system,system-ui,sans-serif;padding:20px 16px}main{max-width:34rem;margin:0 auto;display:grid;gap:14px}"
       ".card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px;display:grid;gap:10px}.code{font:700 2.2rem/1 ui-monospace,Menlo,monospace;letter-spacing:.1em}"
       "button{font:inherit;background:var(--ac);color:var(--bg);border:0;border-radius:8px;padding:12px 16px}button:disabled{opacity:.5}.ok{color:var(--ac);font-weight:600}.err{color:var(--bad);font-weight:600}small{opacity:.75}</style>"
       "<main><h1 style=\"font-size:1.2rem;margin:0\">Wi-Fi をこの PC から渡す</h1>"
       "<div class=\"card\"><small>渡すネットワーク</small><b id=\"ssid\"></b><small>パスワードはこの PC のヘルパーの中だけにあり、ブラウザには届きません。</small>"
       "<button id=\"go\">端末の音を聞き取る</button><meter id=\"lv\" min=\"0\" max=\"1\" value=\"0\" style=\"width:100%\"></meter><div id=\"st\">端末のスピーカーの近くで開始してください。</div></div>"
       "<div class=\"card\" id=\"dev\" hidden><small>聞き取った端末</small><div class=\"code\" id=\"code\"></div><button id=\"send\">この端末に Wi-Fi を音で渡す</button><div id=\"ws\"></div></div></main>"
       "<script src=\"/ggwave.js\"></script><script>document.getElementById('ssid').textContent=" (script-string ssid) ";" page-script "</script></html>"))
