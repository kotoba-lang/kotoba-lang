(ns murakumo.blob
  "Blob objects for the CI/CD bonsai repos, with the bytes kept OFF the datom
   plane.

   `bonsai.object/write-blob` asserts the raw bytes as the `:o` of a datom.
   arrangement refuses a byte array there when the db is persisted (its
   blinded key path cannot derive a stable token from one — before the
   refusal it silently keyed on the array's identity hash), and the workspace
   rule is that bytes belong to the content-addressed store, not to the datom
   plane. So a blob here is:

     - its identity: the same raw CIDv1 bonsai would assign (`cid`),
     - one datom in the repo db: `blob/size`, an integer, so the object is
       still visible to queries over the repo,
     - its bytes: returned beside the db as `{cid bytes}` and written to the
       store by `persist!` before the repo snapshot that references them.

   Trees and commits reference blobs by CID exactly as before, so a restored
   repo answers `read-commit` / `read-tree` unchanged; the blob bytes come
   from the store by CID."
  (:require [arrangement.core :as arr] [bonsai.repo :as repo] [multiformats.core :as mf]))

(defn cid
  "Raw CIDv1 of `bytes` — the identity bonsai.object/write-blob assigns."
  [bytes]
  (mf/cidv1-raw bytes))

(defn write
  "Record a blob in `db` without its bytes. Returns [db' cid]; the caller keeps
   `{cid bytes}` and hands it to `persist!`."
  [db bytes]
  (let [c (cid bytes)]
    [(arr/assert-quad db {:s c :p "blob/size" :o (count bytes)}) c]))

(defn put-all!
  "Write every blob in `blobs` ({cid bytes}) through `put!` (`(put! cid bytes)`).
   Call it before snapshotting a repo that references them."
  [put! blobs]
  (doseq [[c bytes] (sort-by key blobs)]
    (put! c bytes)))

(defn persist!
  "`put-all!` the blobs, then snapshot `db` with bonsai.repo/persist!.
   Returns the snapshot CID."
  [put! db blobs prev-cid]
  (put-all! put! blobs)
  (repo/persist! put! db prev-cid))

(defn then
  "Continue with a persist/restore result: `(f x)` on the JVM, after the
   Promise resolves on cljs (kbb), where arrangement's commit!/restore -- and
   so bonsai.repo/persist! and this ns's `persist!` -- return a js/Promise
   (Web Crypto is Promise-based). Code that continues after a snapshot goes
   through here so it reads the same on both hosts."
  [x f]
  )
