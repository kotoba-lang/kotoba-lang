(ns murakumo.node-console
  "What the box says about itself on its own screen: `murakumo node console`.

  A box that is still being set up has a screen (a monitor, a serial line, a VM's console) and no
  keyboard worth using, and a person standing in front of it with a phone. So the screen answers what
  that person needs, in the order they need it: *who is this*, *is it claimed*, *is it online*, *is it
  reporting*, and a QR code their phone can scan to add it to their account.

  `screen` is pure: a state map in, lines of text out, so what the screen says is tested as literals and
  the same text goes to a terminal, a log or a test. Gathering the state and drawing it are the thin
  shell around it.

  Two things this deliberately does not show. The claim QR is built from the label **without its onboarding
  secret** (`ls`): that secret exists to prove the person has the physical label, and printing it on a screen
  would hand it to anyone who can see the screen. And nothing here is a credential or an account name."
  (:require [kotoba.lang.text :as str]
            ["node:fs" :as fs] ["node:os" :as os] ["node:path" :as path]))

;; ── the claim link ────────────────────────────────────────────────────────

(defn label-fields
  "The `k=v` fields of a label payload (`aiueos:1;did=…;token=…`) as a map, from either the
  bare payload or the `…#claim?q=…` URL that carries it percent-encoded."
  [text]
  (let [raw (str/trim (str text))
        decoded (try (js/decodeURIComponent raw) (catch :default _ raw))
        payload (or (second (re-find #"q=(.*)$" decoded)) decoded)]
    (into {} (keep (fn [part]
                     (let [i (str/index-of part "=")]
                       (when (and i (pos? i)) [(subs part 0 i) (subs part (inc i))]))))
          (str/split payload #";"))))

(defn claim-url
  "The link a phone opens to claim this device, or nil when there is no usable label. Built from the
  label's fields **minus `ls`** (see the namespace doc), at `site`'s origin, in the same shape as the
  printed label's URL (`/#claim?q=<percent-encoded payload>`)."
  [label site]
  (let [fields (label-fields label)]
    (when (and (get fields "did") (get fields "token"))
      (let [payload (str "aiueos:1;"
                         (str/join ";" (for [[k v] fields :when (not (contains? #{"ls" "aiueos:1"} k))]
                                         (str k "=" v))))]
        (str (str/replace (str site) #"/+$" "") "/#claim?q=" (js/encodeURIComponent payload))))))

;; ── the screen ────────────────────────────────────────────────────────────

(defn short-did [did]
  (if (and (string? did) (> (count did) 30))
    (str (subs did 0 17) "…" (subs did (- (count did) 8)))
    (str did)))

(defn age-text
  "Coarse on purpose: a screen redrawn every few seconds that says `41 s` invites reading the number as
  precise."
  [age-s]
  (cond
    (nil? age-s) nil
    (< age-s 90) (str age-s " s ago")
    (< age-s 5400) (str (js/Math.round (/ age-s 60)) " min ago")
    :else (str (js/Math.round (/ age-s 3600)) " h ago")))

(defn claim-text
  "What a heartbeat's outcome says about the claim. `nil` outcome (never reported) is not a claim state."
  [outcome]
  (case outcome
    (:accepted :stale) "claimed"
    :not-claimed "waiting to be claimed"
    :rejected "the console did not accept this device's signature"
    :clock-ahead "the clock is ahead of the console's"
    :unreachable "cannot reach the console"
    :error "the console returned an error"
    "not known yet (no report has been sent)"))

(defn onboarding-text [onboarding]
  (case onboarding
    :retired "retired (the claim went through)"
    :ready "ready: can take Wi-Fi by sound until it is claimed"
    "not provisioned for Wi-Fi by sound"))

(defn- row [label value] (str " " (.padEnd label 11) value))

(defn- wrapped-rows
  "How many screen rows a line takes once the terminal wraps it."
  [line width]
  (max 1 (long (js/Math.ceil (/ (count line) (max 1 width))))))

(defn- sections
  "`{:status [...] :claim [...] :link [...]}`: the status block, the claim block with a QR (or what stands
  in for it), and the same claim block with the link as text."
  [{:keys [did fp site public-url now-ms width addresses reachable? heartbeat onboarding label qr-fn]}]
  (let [rule (apply str (repeat (dec width) "─"))
        age (when (and heartbeat (number? (:at-ms heartbeat)) (number? now-ms))
              (max 0 (js/Math.round (/ (- now-ms (:at-ms heartbeat)) 1000))))
        outcome (:outcome heartbeat)
        claimed? (contains? #{:accepted :stale} outcome)
        ;; the address a PHONE can reach: not necessarily the one this box talks to (a box in a VM or behind
        ;; a proxy talks to loopback, and a phone cannot)
        shown (or public-url site)
        url (claim-url label shown)
        candidate-qr (when (and url qr-fn (not claimed?)) (qr-fn url))
        ;; A QR wrapped by the terminal is not a scannable QR, even on a tall screen.
        qr (when (and candidate-qr (every? #(<= (+ 3 (count %)) width) candidate-qr)) candidate-qr)
        site* (str/replace (str shown) #"/+$" "")]
    {:status [(str " MURAKUMO NODE")
              rule
              (row "Device" (str (short-did did) (when fp (str "   (id " fp ")"))))
              (row "Claim" (claim-text outcome))
              (row "Network" (if (seq addresses)
                               (str/join ", " (for [{:keys [name address]} addresses] (str address " (" name ")")))
                               "no network address"))
              (row "Console" (str site (case reachable? true "  reachable" false "  unreachable" "")))
              (row "Heartbeat" (if heartbeat
                                 (str (name outcome) (when age (str " · " (age-text age))))
                                 "none yet"))
              (row "Wi-Fi" (onboarding-text onboarding))
              rule]
     :claim (cond
              claimed? [(str " This device belongs to an account. Manage it at " site* "/#devices")]
              qr (vec (concat [" To add this device to your account, scan with your phone:" ""]
                              (for [l qr] (str "   " l))
                              ["" (str " or open " site* "/#claim and paste the label text")]))
              url (cond-> [" Open this link on your phone to add the device:" (str "   " url)]
                    candidate-qr (conj " (this terminal is too narrow to draw the QR code)"))
              :else [" No label on this device, so there is nothing to scan."
                     " The factory writes it to <state-dir>/label."])
     :link (cond
             claimed? [(str " This device belongs to an account. Manage it at " site* "/#devices")]
             url [" Open this link on your phone to add the device:" (str "   " url)
                  " (this screen is too short to draw the QR code; make the terminal taller to see it)"]
             :else [" No label on this device, so there is nothing to scan."
                    " The factory writes it to <state-dir>/label."])}))

(defn screen
  "State -> lines of text (no colour, no cursor codes). `state`:
    :did :fp :site :now-ms :width
    :public-url the origin a phone opens for the claim link and #devices; defaults to :site
    :addresses  [{:name :address} …]
    :reachable? true / false / nil (not checked)
    :heartbeat  {:outcome kw :at-ms n} or nil
    :onboarding :ready / :retired / nil
    :label      the label text, or nil
    :qr-fn      text -> lines of a QR code, or nil (`murakumo.node-console-qr/qr-lines`); injected so this
                namespace needs no npm package and the text of the screen is testable
    :height     rows the terminal has, or nil for 'as many as it takes' (a log, a pipe, a test)
    :page       `:status` or `:qr`, used only when everything does not fit in `:height`

  A QR code is about 25 rows, so on a 24-row console the status and the QR cannot share a screen. Then the
  two are shown as pages, and the shell flips `:page`; if even the QR page is too tall, the link is shown as
  text and says why."
  [{:keys [width height page] :or {width 80} :as state}]
  (let [width (max 1 (min 120 width))
        {:keys [status claim link]} (sections (assoc state :width width))
        total (+ (count status) (reduce + (map #(wrapped-rows % width) claim)))]
    (vec
     (cond
       (or (nil? height) (<= total height)) (concat status claim)
       (= :qr page) (let [rows (reduce + (map #(wrapped-rows % width) claim))]
                      (if (<= rows height) claim link))
       :else (concat status [(str " (page 1 of 2: the claim code follows)")])))))

(defn frame
  "Lines -> one terminal frame: cursor home, each line cleared to its end, then clear below. Redrawing
  in place does not flicker the way clear-then-print does on a slow serial line."
  [lines]
  (str "\u001b[H" (str/join "" (for [l lines] (str l "\u001b[K\n"))) "\u001b[J"))

;; ── gathering ─────────────────────────────────────────────────────────────

(defn- read-text [p]
  (try (when (.existsSync fs p) (.readFileSync fs p "utf8")) (catch :default _ nil)))

(defn- read-json [p]
  (try (some-> (read-text p) js/JSON.parse (js->clj :keywordize-keys true)) (catch :default _ nil)))

(defn addresses
  "Non-loopback IPv4 addresses, which is what a person at the box wants to read out."
  []
  (vec (take 3 (for [[name infos] (js->clj (.networkInterfaces os))
                     info infos
                     :when (and (= "IPv4" (get info "family")) (not (get info "internal")))]
                 {:name name :address (get info "address")}))))

(defn heartbeat-status
  "The last result `murakumo node report` wrote, or nil. Read from a file so the console is passive: it
  never sends a second heartbeat of its own."
  [state-dir]
  (when-let [m (read-json (.join path state-dir "report-status.json"))]
    (when (and (string? (:outcome m)) (number? (:at-ms m)))
      {:outcome (keyword (:outcome m)) :at-ms (:at-ms m)})))

(defn onboarding-state [state-dir]
  (let [dir (.join path state-dir "onboard")]
    (cond
      (.existsSync fs (.join path dir "closed")) :retired
      (.existsSync fs (.join path dir "label-secret")) :ready
      :else nil)))

(defn reachable!
  "Promise of whether `site` answers at all within 3 s. Any HTTP response counts: this is about the network,
  not about whether the console likes us."
  [site]
  (-> (js/fetch site #js {:method "HEAD" :signal (js/AbortSignal.timeout 3000)})
      (.then (fn [_] true))
      (.catch (fn [_] false))))

(defn gather!
  "Promise of the state `screen` draws. `qr-fn` is passed through to it."
  [{:keys [state-dir site public-url did fp width qr-fn]}]
  (-> (reachable! site)
      (.then (fn [up?]
               {:did did :fp fp :site site :public-url public-url :now-ms (js/Date.now) :width width :qr-fn qr-fn
                :addresses (addresses) :reachable? up?
                :heartbeat (heartbeat-status state-dir)
                :onboarding (onboarding-state state-dir)
                :label (read-text (.join path state-dir "label"))}))))
