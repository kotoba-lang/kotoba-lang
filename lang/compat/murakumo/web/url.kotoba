(ns murakumo.web.url
  "URL parsing, normalisation and relative-reference resolution (RFC 3986 subset) shared by the
  worker (redirect Location) and the crawler (links). Pure."
  (:require [kotoba.lang.text :as text]))

;; --- URL normalisation / resolution ------------------------------------------

(def ^:private url-parts-re
  #"(?i)^(https?)://(\[[^\]]+\]|[^/?#:]+)(?::(\d+))?([^?#]*)(\?[^#]*)?(?:#.*)?$")

(defn parse-url [url]
  (when-let [[_ scheme host port path query] (re-matches url-parts-re (str url))]
    {:scheme (text/lower scheme) :host (text/lower host) :port port
     :path (if (empty? path) "/" path) :query (or query "")}))

(defn render [{:keys [scheme host port path query]}]
  (let [default? (or (nil? port) (empty? port)
                     (and (= scheme "http") (= port "80"))
                     (and (= scheme "https") (= port "443")))]
    (str scheme "://" host (when-not default? (str ":" port)) path query)))

(defn normalize-url
  "Lowercase scheme/host, drop fragment and default port, default path to /."
  [url]
  (some-> (parse-url url) render))

(defn- dot-segments [path]
  (let [segs (text/split path #"/" -1)
        out (reduce (fn [acc s]
                      (cond (= s ".") acc
                            (= s "..") (if (> (count acc) 1) (pop acc) acc)
                            :else (conj acc s)))
                    [] segs)
        out (if (contains? #{"." ".."} (last segs)) (conj out "") out)]
    (text/join "/" out)))

(def ^:private skipped-schemes #"(?i)^(mailto|javascript|tel|data|ftp|file|sms):")

(defn resolve-url
  "Resolve `href` against the absolute `base`. nil for fragments-only, non-web
  schemes, or anything that does not end up an http(s) URL."
  [base href]
  (let [href (text/trim (str href))
        b (parse-url base)]
    (cond
      (or (nil? b) (empty? href) (text/starts-with? href "#")
          (re-find skipped-schemes href)) nil
      (re-find #"(?i)^https?://" href) (normalize-url href)
      (text/starts-with? href "//") (normalize-url (str (:scheme b) ":" href))
      :else
      (let [origin (render (assoc b :path "" :query ""))
            [_ href-path rest-part] (re-matches #"^([^?#]*)([?#].*)?$" href)
            rest-part (or rest-part "")]
        (normalize-url
         (cond
           (text/starts-with? href "/") (str origin (dot-segments href-path) rest-part)
           (empty? href-path) (str origin (:path b) (if (text/starts-with? rest-part "?") rest-part (:query b)))
           :else (let [dir (subs (:path b) 0 (inc (.lastIndexOf (:path b) "/")))]
                   (str origin (dot-segments (str dir href-path)) rest-part))))))))
