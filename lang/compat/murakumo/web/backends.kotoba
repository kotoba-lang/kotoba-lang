(ns murakumo.web.backends
  "Pure response mappers for real search backends used by `:web/search` Phase 1
  (ADR-260929). Each takes the decoded JSON document and returns the neutral
  result shape [{:url :title :snippet}]; fetching lives in host.cljk. Result text
  is untrusted page-derived data and is cleaned again by murakumo.web.search."
  (:require [kotoba.lang.text :as text]))

(defn- strip-tags [s] (-> (str (or s "")) (text/replace #"<[^>]*>" "") text/trim))

(defn- decode [s]
  (-> s (text/replace "&quot;" "\"") (text/replace "&#039;" "'") (text/replace "&lt;" "<")
      (text/replace "&gt;" ">") (text/replace "&amp;" "&")))

(defn- title->path
  "Wikipedia article path: spaces to underscores, other unsafe characters
  percent-encoded as UTF-8."
  [title]
  (apply str
         (map (fn [c]
                (cond
                  (= c " ") "_"
                  (re-matches #"[A-Za-z0-9_.~()!*',:@/-]" c) c
                  :else (apply str (map #(str "%" (text/upper (text/pad-left (text/to-hex %) 2 "0")))
                                        (seq )))))
              (map str (seq title)))))

(defn wikipedia-results
  "MediaWiki `action=query&list=search` document -> results."
  [doc lang]
  (vec (for [{:keys [title snippet]} (get-in doc [:query :search])
             :when (seq title)]
         {:url (str "https://" lang ".wikipedia.org/wiki/" (title->path title))
          :title title
          :snippet (decode (strip-tags snippet))})))

(defn hn-results
  "Hacker News Algolia `search` document -> results (story URL, else the HN item page)."
  [doc]
  (vec (for [{:keys [title url objectID story_text]} (:hits doc)
             :let [u (if (seq url) url (str "https://news.ycombinator.com/item?id=" objectID))]
             :when (and (seq title) (seq objectID))]
         {:url u :title title :snippet (decode (strip-tags story_text))})))
