(ns murakumo.web.robots
  "robots.txt per RFC 9309: group selection by user-agent token, longest-match
  rule with allow winning ties, `*` and `$` in patterns, crawl-delay. Pure.

  Availability semantics live in `for-status`: 4xx means no restrictions,
  5xx / unreachable means complete disallow (the RFC's fail-closed choice)."
  (:require [kotoba.lang.text :as text]))

(def user-agent-token "murakumo-web")

(defn- clean-line [line]
  (text/trim (first (text/split line #"#" 2))))

(defn- parse-line [line]
  (let [l (clean-line line)
        i (.indexOf l ":")]
    (when (pos? i)
      [(text/lower (text/trim (subs l 0 i))) (text/trim (subs l (inc i)))])))

(defn- js-num [s]
  )

(defn parse
  "text -> [{:agents #{lower-token} :rules [{:allow? b :pattern s}] :delay-s n-or-nil}]
  A run of consecutive user-agent lines opens one group."
  [body]
  (let [body (text/replace (str body) #"^\uFEFF" "")
        lines (keep parse-line (text/split-lines body))]
    (loop [ls lines groups [] cur nil last-was-agent? false]
      (if-let [[field value] (first ls)]
        (cond
          (= field "user-agent")
          (if last-was-agent?
            (recur (rest ls) groups (update cur :agents conj (text/lower value)) true)
            (recur (rest ls) (cond-> groups cur (conj cur))
                   {:agents #{(text/lower value)} :rules [] :delay-s nil} true))

          (and cur (#{"allow" "disallow"} field))
          (recur (rest ls) groups
                 (update cur :rules conj {:allow? (= field "allow") :pattern value}) false)

          (and cur (= field "crawl-delay"))
          (recur (rest ls) groups
                 (assoc cur :delay-s (let [n (js-num value)] (when (and n (>= n 0)) n))) false)

          ;; Sitemap:, Host:, unknown fields: RFC 9309 ignores them; they neither
          ;; end a run of user-agent lines nor start a group
          :else (recur (rest ls) groups cur last-was-agent?))
        (cond-> groups cur (conj cur))))))

(def ^:private regex-specials (set (map str ".\\+?^${}()|[]/-")))

(defn- re-quote [s]
  (apply str (map (fn [c] (let [c (str c)] (if (regex-specials c) (str "\\" c) c))) s)))

(defn- pattern-regex [pattern]
  (let [anchored? (text/ends-with? pattern "$")
        p (if anchored? (subs pattern 0 (dec (count pattern))) pattern)
        star-end? (text/ends-with? p "*")
        body (text/join ".*" (map re-quote (text/split p #"\*" -1)))]
    (re-pattern (str "^" body (when (and anchored? (not star-end?)) "$")))))

(defn- rule-matches? [{:keys [pattern]} path-and-query]
  (and (seq pattern) (boolean (re-find (pattern-regex pattern) path-and-query))))

(defn- rules-for
  "Merge the rules of every group naming our token; else those of `*`."
  [groups token]
  (let [token (text/lower token)
        ;; RFC 9309: the product token matches its group case-insensitively and
        ;; exactly. An empty or partial value ("", "web", "m") is not us.
        named (filter #(contains? (:agents %) token) groups)
        chosen (if (seq named) named (filter #(contains? (:agents %) "*") groups))]
    {:rules (vec (mapcat :rules chosen))
     :delay-s (some :delay-s chosen)}))

(defn allowed?
  "groups, path-and-query (starts with /) -> boolean. Longest pattern wins; allow on a tie."
  ([groups path-and-query] (allowed? groups path-and-query user-agent-token))
  ([groups path-and-query token]
   (if (= "/robots.txt" path-and-query)
     true
     (let [{:keys [rules]} (rules-for groups token)
           hits (filter #(rule-matches? % path-and-query) rules)]
       (if (empty? hits)
         true
         (let [best (apply max (map #(count (:pattern %)) hits))
               top (filter #(= best (count (:pattern %))) hits)]
           (boolean (some :allow? top))))))))

(defn crawl-delay-ms
  "Crawl-delay in ms for our token, or nil."
  ([groups] (crawl-delay-ms groups user-agent-token))
  ([groups token]
   (when-let [d (:delay-s (rules-for groups token))]
     (long (* 1000 d)))))

(defn for-status
  "Robots policy from the HTTP outcome of GET /robots.txt.
  status 2xx -> parse body; 4xx -> allow all; anything else (5xx, transport
  failure = nil status) -> disallow all."
  [status body-text]
  (cond
    (and status (<= 200 status 299)) {:groups (parse body-text) :basis :parsed}
    (and status (<= 400 status 499)) {:groups [] :basis :unavailable-4xx}
    :else {:groups [{:agents #{"*"} :rules [{:allow? false :pattern "/"}] :delay-s nil}]
           :basis :unreachable-disallow-all}))
