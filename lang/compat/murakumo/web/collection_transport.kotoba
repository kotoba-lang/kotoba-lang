(ns murakumo.web.collection-transport
  "Collector adapters over the existing operator SSH/Modal transport. Node
  identity is checked against admission, never discovered and trusted anew."
  (:require [murakumo.web.collection :as c] [murakumo.web.dispatch :as dispatch] [murakumo.web.worker :as w]))

(defn require-node! [participant]
  (let [cfg (:transport-config participant) who (:ok (dispatch/call! cfg :whoami {}))]
    (c/require! (and (= (:node-did participant) (:node-did who))
                     (= (:public-key-hex participant) (:public-key-hex who))) :collection/node-key-changed)
    cfg))

(defn install-profile! [participant p]
  (let [cfg (require-node! participant) r (dispatch/call! cfg :collection-profile-put {:profile p})]
    (c/require! (= (c/cid p) (get-in r [:ok :profile-cid])) :collection/profile-install-failed)
    r))

(defn run-host! [participant lease]
  (let [cfg (require-node! participant)
        r (dispatch/call! (assoc cfg :timeout-ms 1200000) :collection-run lease)]
    (c/require! (:ok r) :collection/host-execution-failed)
    (:ok r)))

(defn get-block! [participant cid]
  (c/require! (c/cid? cid) :collection/block-cid)
  (let [r (dispatch/call! (:transport-config participant) :get {:cid cid})
        b64 (get-in r [:ok :base64])]
    (c/require! b64 :collection/node-block-unavailable)
    ))
