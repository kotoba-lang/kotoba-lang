(ns murakumo.web.collection-host
  "Node-local inference for the hosted profile. Credentials and configuration
  belong to the host, never to the assignment or model."
  (:require [murakumo.canonical :as canonical]
            [murakumo.web.collection :as c]
            [murakumo.web.worker :as w]
             [cljs.reader :as reader]))

(defn completion [response assignment-id]
  (let [usage (:usage response)]
    (c/require! (and (string? (:id response))
                     (c/natural? (:prompt_tokens usage)) (c/natural? (:completion_tokens usage)))
                :collection/inference-unmetered)
    {:collect? (= "collect" (some-> (get-in response [:choices 0 :message :content]) .trim))
     :inference-input-tokens (:prompt_tokens usage)
     :inference-output-tokens (:completion_tokens usage)
     :inference-receipt {:provider-response-id (:id response) :assignment-id assignment-id
                         :response-cid (c/cid response) :model (:model response) :usage usage}}))

(defn run-bot! [cfg put! p assignment]
  (let [{:keys [profile-cids supplier-did owner-did bot-id inference]} cfg
        {:keys [url model key-env max-tokens]} inference]
    (c/require! (and (set? profile-cids) (contains? profile-cids (c/cid p))
                     (= owner-did (:owner-did p)) (= bot-id (:bot-id p)) (c/did? supplier-did)
                     (string? model) (seq model) (c/positive? max-tokens) (<= max-tokens 1024)
                     ;; The collector host earns inference credit only for its
                     ;; own serving. Delegating to the public gateway must not
                     ;; credit the relay host for another provider's inference.
                     (string? url) (re-matches #"http://127\.0\.0\.1:[0-9]+/v1/chat/completions" url)
                     (or (nil? key-env) (and (string? key-env) (re-matches #"[A-Z][A-Z0-9_]+" key-env)))) :collection/host-config)
    ))

(defn run-once!
  "Node-side fence in addition to the coordinator lease. A duplicate successful
  request returns its cached signed result; an interrupted request is held.
  Conflicting payloads using the same assignment ID never execute."
  [directory lease run!]
  )
