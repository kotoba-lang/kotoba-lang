(ns inga-node.store
  "What survives a restart: this witness's own state, and the log everyone
  agreed about.

  `snapshot` includes safety state, not just a performance cache. It must
  be durable before votes leave. Losing it or rolling it back while reusing
  the witness key can permit equivocation; peer catch-up does not recover
  the last vote the witness sent. Only an unused identity may start cold.

  `committed` is the SHARED log — one file per `(ref, seq)`, which is the
  identity the ref plane arbitrates, so the same record committed by four
  leaders is one file. First write wins, because when two different records
  contend for one sequence the log's ORDER decided it and a later write would
  contradict the thing that decided.

  The committed files are projections, not consensus primitives. Snapshot
  durability is a precondition of the witness protocol, and depends on a
  filesystem honoring fsync and a single process owning this directory."
  (:require [kotoba.lang.text :as str] [kotoba.lang.edn :as edn] [inga-node.proof :as proof] ["node:fs" :as fs] ["node:path" :as path]))

(defn- ensure-dir! [d]
  (when-not (fs/existsSync d) (fs/mkdirSync d #js {:recursive true})))

(defn snapshot-path [data-dir] (path/join data-dir "snapshot.edn"))

(defn write-snapshot!
  "Write via a temp file and rename.

  A snapshot written in place is a snapshot that can be half a file when the
  process dies mid-write, and a half-read snapshot is refused by
  `inga.replica/resume` — which turns a crash into a witness that will not
  start. `rename` within one filesystem is atomic, so the file a reader sees
  is always a whole one. Flush the file before rename and the directory
  after rename; atomic visibility alone is not crash durability."
  [data-dir snap]
  (ensure-dir! data-dir)
  (let [f (snapshot-path data-dir)
        tmp (str f ".tmp")]
    (let [fd (fs/openSync tmp "w")]
      (try
        (fs/writeFileSync fd (pr-str snap) "utf8")
        (fs/fsyncSync fd)
        (finally (fs/closeSync fd))))
    (fs/renameSync tmp f)
    (let [fd (fs/openSync data-dir "r")]
      (try (fs/fsyncSync fd) (finally (fs/closeSync fd))))))

(defn read-snapshot
  "The stored snapshot, or nil on first boot. Corruption fails closed:
  discarding a vote watermark can make the same witness equivocate. The
  operator must restore its durable state, not reuse its key from genesis."
  [data-dir]
  (let [f (snapshot-path data-dir)]
    (when (fs/existsSync f)
      (let [snap (edn/read-string (fs/readFileSync f "utf8"))]
        (when-not (map? snap)
          (throw (ex-info "inga-node: snapshot is not a map" {})))
        snap))))

;; ── the shared committed log ────────────────────────────────────────────────

(defn- pad
  "Zero-padded to 12 digits so a LEXICOGRAPHIC listing is sequence order.

  `head-of` does not need this — it parses the number out of each filename
  and sorts numerically, so it is immune to `ls` putting 10 before 9. The
  padding is for everything that lists WITHOUT parsing: a human reading the
  directory, an object store's `list` (the shared-log sibling in
  `net-kotobase` pages through keys in lexicographic order), and any future
  consumer that assumes the obvious.

  Stated this way because the first version claimed the contiguous walk
  depended on it, and a test written against that claim passed with the
  padding removed — the claim was false and the test was checking something
  else."
  [n]
  (let [s (str n)]
    (str (str/join "" (repeat (max 0 (- 12 (count s))) "0")) s)))

;; A bounded replica snapshot cannot prove that an earlier record did not win
;; a ref. Keep every finalized block when a fresh chain explicitly opts in.
;; This is local custody for a future complete-prefix verifier, not authority
;; by itself: readers must check the chain and a signed certificate for its tip.
(defn- finalized-dir [data-dir] (path/join data-dir "finalized-blocks"))
(defn- finalized-path [data-dir height]
  (path/join (finalized-dir data-dir) (str (pad height) ".edn")))

(defn- archived-entry [data-dir height]
  (let [f (finalized-path data-dir height)]
    (when (fs/existsSync f)
      (let [v (edn/read-string (fs/readFileSync f "utf8"))]
        (when-not (map? v)
          (throw (ex-info "inga-node: malformed finalized archive entry" {:height height})))
        v))))

(defn- fsync-dir! [dir]
  (let [fd (fs/openSync dir "r")]
    (try (fs/fsyncSync fd) (finally (fs/closeSync fd)))))

(defn- archive-height [filename]
  (when-let [[_ digits] (re-matches #"([0-9]+)\.edn" filename)]
    (let [height (js/Number digits)]
      (when (and (js/Number.isSafeInteger height)
                 (= filename (str (pad height) ".edn")))
        height))))

(defn- quarantine-ahead!
  "Only a contiguous suffix above the durable snapshot may be moved. The
  process persists archive entries before the snapshot and ships votes only
  after both, so this suffix was never part of durable voting state. Move
  highest first: an interrupted quarantine leaves a shorter contiguous
  suffix that the next start can handle. Keep every byte for inspection."
  [data-dir expected ahead]
  (let [archive (finalized-dir data-dir)
        quarantine (fs/mkdtempSync (path/join data-dir "finalized-ahead-"))]
    (fs/chmodSync quarantine 0700)
    (fsync-dir! data-dir)
    (doseq [h (reverse ahead)]
      (fs/renameSync (finalized-path data-dir h)
                     (path/join quarantine (str (pad h) ".edn")))
      (fsync-dir! archive)
      (fsync-dir! quarantine))
    (.warn js/console
           (str "inga-node: preserved " (count ahead)
                " archive entries ahead of durable height " expected
                " in " quarantine))
    quarantine))

(defn verify-finalized-archive!
  "Fail closed when an opted-in witness lacks a contiguous archive from genesis
  through its snapshot's committed block. A fresh witness may start empty.
  A bounded, contiguous suffix above a PRESENT durable snapshot is preserved
  in a quarantine directory after the committed prefix is verified. No file
  at or below the snapshot height is repaired or discarded."
  [data-dir snap hash-fn]
  (let [dir (finalized-dir data-dir)
        expected (if (seq (:committed snap))
                   (:inga.block/height (peek (:committed snap))) -1)
        files (if (fs/existsSync dir) (vec (fs/readdirSync dir)) [])
        expected-files (set (map #(str (pad %) ".edn") (range (inc expected))))
        ahead-files (remove expected-files files)
        parsed-ahead (mapv archive-height ahead-files)
        ahead (when (every? some? parsed-ahead) (sort parsed-ahead))]
    (when (and snap (not (vector? (:committed snap))))
      (throw (ex-info "inga-node: snapshot has no committed archive anchor" {})))
    (when-not (and (= (count files) (+ (count expected-files) (count ahead)))
                   (every? (set files) expected-files)
                   (or (and (empty? ahead-files) (empty? ahead))
                       (and snap (<= (count ahead) 256)
                            (= (count ahead-files) (count ahead))
                            (= ahead (range (inc expected)
                                            (+ (inc expected) (count ahead)))))))
      (throw (ex-info "inga-node: finalized archive missing or ahead" {:expected expected})))
    (loop [h 0 previous nil]
      (when (<= h expected)
        (let [{:keys [block hash qc]} (archived-entry data-dir h)
              actual (when block (hash-fn block))]
          (when-not (and (= h (:inga.block/height block)) (= hash actual)
                         (or (zero? h) (= previous (:inga.block/parent-hash block)))
                         (or (nil? qc) (= hash (:inga.qc/block-hash qc))))
            (throw (ex-info "inga-node: invalid finalized archive chain" {:height h})))
          (recur (inc h) hash))))
    (when (nat-int? expected)
      (when-not (= (hash-fn (peek (:committed snap)))
                   (:hash (archived-entry data-dir expected)))
        (throw (ex-info "inga-node: finalized archive contradicts snapshot" {}))))
    (when (seq ahead)
      (quarantine-ahead! data-dir expected ahead)
      (when-not (= expected-files (set (fs/readdirSync dir)))
        (throw (ex-info "inga-node: finalized archive quarantine incomplete" {}))))
    expected))

(defn append-finalized!
  "Append newly committed blocks with any locally available certificates, in
  height order. A replica can learn a finalized block by sync before receiving
  that block's own QC; the complete-prefix verifier needs a certified tip, not
  a separate QC for every committed block. Missing parent, mismatched QC, or
  conflicting bytes refuses before snapshot durability. A partial archive
  after a crash is detected on restart."
  [data-dir blocks qcs hash-fn]
  (let [dir (finalized-dir data-dir)]
    (ensure-dir! dir)
    (doseq [block blocks]
      (let [h (:inga.block/height block)
            _ (when-not (nat-int? h)
                (throw (ex-info "inga-node: finalized archive invalid height" {:height h})))
            hash (hash-fn block)
            qc (get qcs hash)
            prev (when (pos? h) (archived-entry data-dir (dec h)))
            entry {:block block :hash hash :qc qc}
            f (finalized-path data-dir h)]
        (when-not (or (zero? h)
                      (= (:hash prev) (:inga.block/parent-hash block)))
          (throw (ex-info "inga-node: finalized archive missing parent"
                          {:height h})))
        (when-not (or (nil? qc) (= hash (:inga.qc/block-hash qc)))
          (throw (ex-info "inga-node: finalized archive mismatched certificate"
                          {:height h})))
        (if (fs/existsSync f)
          (when-not (= entry (archived-entry data-dir h))
            (throw (ex-info "inga-node: finalized archive conflict" {:height h})))
          (let [fd (fs/openSync f "wx" 0600)]
            (try
              (fs/writeFileSync fd (pr-str entry) "utf8")
              (fs/fsyncSync fd)
              (finally (fs/closeSync fd)))
            (let [parent (fs/openSync dir "r")]
              (try (fs/fsyncSync parent) (finally (fs/closeSync parent))))))))))

(defn finalized-range
  "Read one bounded, contiguous range from the locally verified archive.
  Refuse malformed requests; a missing or changed archived block is a storage
  fault, never an empty successful response. The receiving replica verifies
  each parent QC and the target QC before adopting these bytes."
  [data-dir from to committed hash-fn max-blocks]
  (when (and (nat-int? from) (nat-int? to) (<= from to committed)
             (pos-int? max-blocks) (<= (inc (- to from)) max-blocks))
    (let [anchor (when (pos? from) (archived-entry data-dir (dec from)))
          _ (when (and (pos? from)
                       (not= (:hash anchor) (some-> anchor :block hash-fn)))
              (throw (ex-info "inga-node: invalid sync archive anchor" {:height (dec from)})))
          entries (mapv #(archived-entry data-dir %) (range from (inc to)))]
      (loop [prev (:hash anchor) [entry & more] entries h from blocks []]
        (if-not entry
          (if (> h to) (vec blocks)
              (throw (ex-info "inga-node: missing sync archive block" {:height h})))
          (let [{:keys [block hash qc]} entry]
            (when-not (and (= h (:inga.block/height block))
                           (= hash (when block (hash-fn block)))
                           (or (zero? h) (= prev (:inga.block/parent-hash block)))
                           (or (nil? qc) (= hash (:inga.qc/block-hash qc))))
              (throw (ex-info "inga-node: invalid sync archive block" {:height h})))
            (recur hash more (inc h) (conj blocks block))))))))

(defn finalized-checkpoint
  "A fixed, certified tip for a paged reader. The committed block is read
  from disk, then its two direct descendants and the tip QC come from one
  replica state. A reader must verify every page from its trusted genesis
  through :committed-height, followed by these three blocks and :tip-qc.
  The checkpoint alone does not authenticate the earlier history."
  [data-dir state]
  (let [hash-fn (:hash-fn state)
        h (:inga.block/height (peek (:committed state)))]
    (when-not (nat-int? h)
      (throw (ex-info "inga-node: no finalized checkpoint" {})))
    (let [anchor (first (finalized-range data-dir h h h hash-fn 1))
          descendants (->> (:chain state)
                           (filter #(<= (inc h) (:inga.block/height %)))
                           (sort-by :inga.block/height)
                           (take 2) vec)
          blocks (into [anchor] descendants)
          tip (peek blocks)
          qc (get (:qcs state) (hash-fn tip))]
      (when-not (and (= 3 (count blocks)) qc
                     (every? true?
                             (for [[parent child] (partition 2 1 blocks)]
                               (and (= (inc (:inga.block/height parent))
                                       (:inga.block/height child))
                                    (= (hash-fn parent) (:inga.block/parent-hash child))
                                    (= (hash-fn parent)
                                       (get-in child [:inga.block/justify :inga.qc/block-hash])))))
                     (= (hash-fn tip) (:inga.qc/block-hash qc))
                     (= (:inga.block/height tip) (:inga.qc/height qc)))
        (throw (ex-info "inga-node: no certified finalized checkpoint" {})))
      {:committed-height h :blocks blocks :tip-qc qc})))

(defn finalized-prefix
  "Build a complete prefix from the immutable local archive plus the live
  certified tail. This is evidence for a separate verifier, not an authority
  decision. A missing file, fork, or absent tip certificate refuses."
  [data-dir state max-blocks]
  (let [hash-fn (:hash-fn state)
        committed (:inga.block/height (peek (:committed state)))]
    (when-not (and (pos-int? max-blocks) (nat-int? committed)
                   (< committed max-blocks))
      (throw (ex-info "inga-node: finalized prefix unavailable or too long" {})))
    (verify-finalized-archive! data-dir {:committed (vec (take-last 1 (:committed state)))} hash-fn)
    (let [archived (mapv #(-> (archived-entry data-dir %) :block)
                         (range (inc committed)))
          tail (->> (:chain state)
                    (filter #(< committed (:inga.block/height %)))
                    (sort-by :inga.block/height) vec)
          blocks (into archived tail)
          _ (when (> (count blocks) max-blocks)
              (throw (ex-info "inga-node: finalized prefix too long" {})))
          _ (doseq [[parent child] (partition 2 1 blocks)]
              (when-not (and (= (inc (:inga.block/height parent))
                                (:inga.block/height child))
                             (= (hash-fn parent) (:inga.block/parent-hash child)))
                (throw (ex-info "inga-node: finalized prefix tail mismatch" {}))))
          certified (last (keep-indexed
                           (fn [i block]
                             (when-let [qc (get (:qcs state) (hash-fn block))]
                               [i qc])) blocks))]
      (when-not certified
        (throw (ex-info "inga-node: finalized prefix has no certified tip" {})))
      (let [[i qc] certified]
        {:blocks (subvec blocks 0 (inc i)) :tip-qc qc}))))

(defn decode-proposal
  "A proposal string back into a head record, or nil.

  Total: a proposal this node cannot read is skipped rather than thrown from.
  The log is shared and another consumer may put its own proposals in it —
  engi's are transfer CIDs — and a ref plane that dies on someone else's
  entry is a ref plane one other tenant can stop."
  [s]
  (try
    (let [m (js->clj (js/JSON.parse s))]
      (when (and (map? m) (get m "ref") (get m "seq") (get m "cid")) m))
    (catch :default _ nil)))

(defn- record-path [data-dir rec]
  (path/join data-dir "committed"
             (js/encodeURIComponent (get rec "ref"))
             (str (pad (get rec "seq")) ".json")))

(defn- proof-path [data-dir rec]
  ;; A directory of its own, not a `<seq>.proof.json` beside the record.
  ;; `head-of` derives a sequence with `parseInt`, which stops at the first
  ;; non-digit, so `000000000000.proof` parses as 0 and a proof file would
  ;; masquerade as the genesis record.
  ;;
  ;; **EDN, not JSON.** A proof is the one value here whose exact shape is
  ;; load-bearing: `:inga.block/proposals` and `:inga.qc/block-hash` are
  ;; QUALIFIED keywords and `:inga.qc/witnesses` is a SET. `clj->js` writes a
  ;; keyword by its `name` alone, so a JSON round trip silently returns
  ;; `:proposals` and `:block-hash` and the certificate then names no block at
  ;; all. Measured: the first version of this did exactly that, and every
  ;; proof failed `:block-not-certified` with an empty hash.
  (path/join data-dir "proofs"
             (js/encodeURIComponent (get rec "ref"))
             (str (pad (get rec "seq")) ".edn")))

(defn- write-proof-if-available!
  "Fill a proof sidecar once this replica can see the block certificate.

  Record durability and certificate visibility can land on adjacent
  three-chain transitions. An existing record therefore must not suppress a
  later proof write."
  [data-dir block rec qcs hash-fn]
  (when-let [qc (and hash-fn qcs (get qcs (hash-fn block)))]
    (let [pf (proof-path data-dir rec)]
      (when-not (fs/existsSync pf)
        (ensure-dir! (path/dirname pf))
        (fs/writeFileSync pf (proof/encode {:block block :qc qc}) "utf8")))))

(defn sink-blocks!
  "Write every head record in `blocks` that is not already logged, and beside
  it the proof that it was committed. Returns how many records were created.

  `qcs` is the certificate map keyed by block hash, and `hash-fn` the
  deployment's own — `inga.commitment` verifies a record by MEMBERSHIP (this
  record is in this block, this block's hash is the one the certificate
  names), because inga's witnesses sign a vote payload over a block hash and
  never the head record itself. Without the block and the certificate, a
  reader can only take this node's word for the log, which is the one thing
  `inga.ref` exists not to do.

  Both are optional. A caller with no certificates writes records exactly as
  before and readers fall back to trusting the host — worse, and still
  working, rather than a node that refuses to log."
  ([data-dir blocks] (sink-blocks! data-dir blocks nil nil))
  ([data-dir blocks qcs hash-fn] (sink-blocks! data-dir blocks qcs hash-fn (constantly true)))
  ;; `admit?` (inga.writer/admit) drops a record before it can take a
  ;; sequence file. head-of reads those files, so a refused record never
  ;; becomes a head and the first ADMITTED record at its sequence wins, which
  ;; is inga.ref/project's rule with the same predicate.
  ([data-dir blocks qcs hash-fn admit?]
   (reduce
    (fn [n [block rec]]
      (let [f (record-path data-dir rec)
            existed? (fs/existsSync f)]
        (when-not existed?
          (ensure-dir! (path/dirname f))
          (fs/writeFileSync f (js/JSON.stringify (clj->js rec)) "utf8"))
        ;; Written after the record: a crash or late certificate leaves a
        ;; recoverable record-without-proof, never a phantom proof.
        (write-proof-if-available! data-dir block rec qcs hash-fn)
        (if existed? n (inc n))))
    0
    (for [b blocks
          rec (keep decode-proposal (:inga.block/proposals b))
          :when (admit? rec)]
      [b rec]))))

(defn proof-text
  "The proof for `ref`/`seq` as the EDN text it is stored as, or nil.

  Text rather than a parsed value, because the HTTP layer serves JSON and a
  parsed proof would have to be re-encoded to get there — which is the lossy
  step this format exists to avoid. One string crosses the wire and the client
  parses it with the same `decode-proof` this node uses."
  [data-dir ref seq']
  (let [f (path/join data-dir "proofs" (js/encodeURIComponent ref)
                     (str (pad seq') ".edn"))]
    (when (fs/existsSync f)
      (try (fs/readFileSync f "utf8") (catch :default _ nil)))))

(defn proof-of
  "`{:block :qc}` for the record at `ref`/`seq`, or nil."
  [data-dir ref seq']
  (some-> (proof-text data-dir ref seq') proof/decode))

(defn count-records [data-dir]
  (let [root (path/join data-dir "committed")]
    (if-not (fs/existsSync root)
      0
      (reduce (fn [n d]
                (+ n (count (fs/readdirSync (path/join root d)))))
              0 (fs/readdirSync root)))))

(defn head-of
  "The head record for `ref`: the highest sequence reachable CONTIGUOUSLY
  from 0, which is the rule `inga.ref/head-of` applies to the in-memory
  projection. A gap means some earlier sequence was never committed, and a
  head past a gap would claim a history the log does not have."
  [data-dir ref]
  (let [d (path/join data-dir "committed" (js/encodeURIComponent ref))]
    (when (fs/existsSync d)
      (let [seqs (->> (fs/readdirSync d)
                      (keep (fn [f]
                              (let [n (js/parseInt (str/replace f #"\.json$" "") 10)]
                                (when-not (js/isNaN n) n))))
                      sort vec)
            top (reduce (fn [expected n] (if (= n expected) (inc expected) (reduced expected)))
                        0 seqs)]
        (when (pos? top)
          (try (js->clj (js/JSON.parse
                         (fs/readFileSync (path/join d (str (pad (dec top)) ".json")) "utf8")))
               (catch :default _ nil)))))))
