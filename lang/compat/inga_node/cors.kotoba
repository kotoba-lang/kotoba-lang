(ns inga-node.cors
  "Which browser origins may read this node's HTTP answers. Opt-in.

  A native client (a kotoba-shell app's `http/fetch`, curl, another node) is
  not subject to CORS and never needed this. A page is: without
  `Access-Control-Allow-Origin` the browser hands it nothing, not even the
  status. Measured 2026-10-13 with kotoba-lang/app-wallet: the same `/health`
  that its iOS build read through the shell bridge was `Failed to fetch` from
  its browser build.

  Off unless `INGA_CORS_ORIGINS` names origins, so a node that sets nothing
  answers exactly as before. The value is `*` or a comma-separated list of
  exact origins (`https://wallet.example,http://localhost:5178`). An exact
  list echoes the one origin that asked and adds `Vary: Origin`, so a shared
  cache cannot hand one origin's answer to another.

  What this does NOT change: who may WRITE. CORS only decides whether a page
  may read the reply; `curl -X POST /submit` was always possible, and
  authority over a ref is `inga.writer`'s job (INGA_WRITER_POLICY). No
  credentials are ever allowed — the node has no cookies or sessions — so `*`
  is the honest value for a public read endpoint, not a loosened one.

  Pure: no request objects, no I/O. `node` asks it for headers and applies
  them."
  (:require [kotoba.lang.text :as str]))

(def allow-methods "GET, POST, OPTIONS")
(def allow-headers "content-type")
(def max-age "600")

(defn- origin?
  "scheme://host[:port], nothing more. A path, a trailing slash or a query
  can never equal a browser's Origin header, so accepting one would be a
  configuration that silently matches nothing."
  [s]
  (boolean (re-matches #"https?://[A-Za-z0-9.\-\[\]:]+" s)))

(defn parse-origins
  "`INGA_CORS_ORIGINS` -> nil (off), :any, or a set of exact origins.
  Throws on an entry that is not an origin, at startup, rather than
  starting a node whose CORS quietly never applies."
  [s]
  (let [s (some-> s str/trim)]
    (cond
      (or (nil? s) (= "" s)) nil
      (= "*" s) :any
      :else (let [entries (->> (str/split s #",") (map str/trim) (remove #(= "" %)))]
              (doseq [e entries]
                (when-not (origin? e)
                  (throw (ex-info (str "INGA_CORS_ORIGINS: not an origin (scheme://host[:port]): " e)
                                  {:entry e}))))
              (when (seq entries) (set entries))))))

(defn allowed?
  [allowed origin]
  (and (some? allowed) (string? origin)
       (or (= :any allowed) (contains? allowed origin))))

(defn headers
  "Response headers for a request from `origin`, or nil to add none. With
  `preflight` (the request's Access-Control-Request-* headers, for an
  OPTIONS), also the method/header grants and, when the browser asks for a
  private-network hop (a public page to a node on a LAN or tailnet), the
  Private Network Access grant."
  ([allowed origin] (headers allowed origin nil))
  ([allowed origin {:keys [private-network?] :as preflight}]
   (when (allowed? allowed origin)
     (cond-> {"Access-Control-Allow-Origin" (if (= :any allowed) "*" origin)}
       (not= :any allowed) (assoc "Vary" "Origin")
       preflight (assoc "Access-Control-Allow-Methods" allow-methods
                        "Access-Control-Allow-Headers" allow-headers
                        "Access-Control-Max-Age" max-age)
       private-network? (assoc "Access-Control-Allow-Private-Network" "true")))))
