(ns inga-node.proof
  "The commitment proof's format: `{:block :qc}` as EDN text.

  Portable `.cljc` and separate from `inga-node.store` on purpose. The store
  is `.cljs` — it is a filesystem — and `inga-node.ref` has to load on a JVM,
  because `-compare-and-set-ref!` is synchronous and only a JVM caller can
  block waiting for a commit. A portable namespace that requires a
  ClojureScript one is portable in name only, and clj-kondo says so before a
  consumer does.

  ## EDN, never JSON

  `:inga.block/proposals` and `:inga.qc/block-hash` are QUALIFIED keywords and
  `:inga.qc/witnesses` is a SET. `clj->js` writes a keyword by its `name`
  alone, so a JSON round trip returns `:proposals` and `:block-hash`, the
  certificate then names no block, and every proof fails
  `:block-not-certified` against an empty hash. Measured — that is exactly
  what the first version of this did."
  (:require [kotoba.lang.edn :as edn]))

(defn encode
  "The proof as the text that gets stored and served.

  `*print-namespace-maps*` is pinned off for the reason `kekkai.envelope`
  pins it: a map whose keys share a namespace prints as `#:inga.qc{…}` by
  default in some contexts and not others, so the same value written by a
  process and by a person would differ. `clojure.edn` reads both forms, so
  this is stability rather than correctness — a proof that reads back
  differently depending on who wrote it is a proof nobody can diff."
  [{:keys [block qc]}]
  (binding [*print-namespace-maps* false]
    (pr-str {:block block :qc qc})))

(defn decode
  "A `{:block :qc}` proof from its EDN text, or nil.

  One decoder for the file reader and for any HTTP client, because a proof
  decoded two ways is a proof one of them gets wrong."
  [text]
  (try
    (let [m (edn/read-string (str text))]
      (when (and (map? m) (map? (:block m)) (map? (:qc m)))
        m))
    (catch  _ nil)))
