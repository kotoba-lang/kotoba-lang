(ns kotoba.image
  "A portable replacement for the raster half of java.awt.image.BufferedImage
  (TYPE_INT_RGB / TYPE_INT_ARGB, getRGB / setRGB) and for javax.imageio's
  PNG read / write.

  A raster is an opaque value made only by `create` and `read-image`: a type
  (:rgb or :argb), a width, a height, and one packed 32-bit ARGB int per
  pixel (int[] on the JVM, Int32Array under kbb). `get-rgb` answers exactly
  what BufferedImage.getRGB answers for the same type, and `read-image`
  answers exactly what ImageIO.read(...).getRGB answers for every pixel of
  every PNG kind it accepts -- measured against the JDK, see README.

  Bytes: `write-png` returns a byte[] on the JVM and an Int8Array under kbb
  (the host byte container kotoba.lang.io.file/read-all-bytes and
  kotoba.bytes/->host-bytes use there). `read-image` takes those, a
  Uint8Array / Buffer, or any sequence of byte values.

  NOT covered: java.awt drawing (Graphics2D, fonts, AlphaComposite, scaling),
  and decoding JPEG / GIF / BMP / TIFF / WBMP -- those refuse by name, because
  ImageIO WOULD decode them and returning nil would claim they are not
  images."
  (:require [kotoba.image.gray :as gray] [kotoba.lang.io.file :as file] [png.core :as png] [png.decode :as png-decode] [png.encode :as encode] [png.grammar :as grammar]))

;; ── errors ───────────────────────────────────────────────────────────────────

(defn- fail
  ([kind msg] (fail kind msg {}))
  ([kind msg data]
   (throw (ex-info msg (assoc data :kotoba.image/error kind)))))

;; ── the raster ───────────────────────────────────────────────────────────────

;; Field names are not `type`: under kbb a record field called `type` collides
;; with a getter the host object already has ("Cannot set property type").
(defrecord Image [kind w h data])

(def ^:private types #{:rgb :argb})

(def ^:private max-pixels 2147483647)

(defn- new-ints [n]
  )

(defn image?
  "true when x is a raster made by this namespace."
  [x]
  (instance? Image x))

(defn- check-image! [img]
  (when-not (image? img)
    (fail :invalid-image "not a kotoba.image raster" {:value-type (str (type img))})))

(defn create
  "new BufferedImage(width, height, TYPE_INT_RGB | TYPE_INT_ARGB): every
  pixel 0. Width and height are integers > 0 (else :invalid-dimensions, as
  the JDK's IllegalArgumentException), and width*height must fit an int
  array; type is :rgb or :argb (else :invalid-type)."
  [width height type]
  (when-not (contains? types type)
    (fail :invalid-type (str "unknown image type " (pr-str type))
          {:type type :known (vec (sort types))}))
  (when-not (and (integer? width) (integer? height) (pos? width) (pos? height)
                 (<= (* width height) max-pixels))
    (fail :invalid-dimensions (str "invalid dimensions " (pr-str width) "x" (pr-str height))
          {:width width :height height}))
  (->Image type width height (new-ints (* width height))))

(defn width [img] (check-image! img) (:w img))
(defn height [img] (check-image! img) (:h img))
(defn image-type [img] (check-image! img) (:kind img))

(defn- index! [img x y]
  (check-image! img)
  (let [w (:w img) h (:h img)]
    (if (and (integer? x) (integer? y) (<= 0 x) (< x w) (<= 0 y) (< y h))
      (+ (* y w) x)
      (fail :out-of-bounds "Coordinate out of bounds!"
            {:x x :y y :width w :height h}))))

(defn- s32
  "The low 32 bits of integer n, as a signed 32-bit int."
  [n]
  )

(defn- opaque
  "0xFF000000 | v, signed."
  [v]
  )

(defn get-rgb
  "BufferedImage.getRGB(x, y): the pixel as a signed 32-bit ARGB int. For
  :rgb the alpha byte reads 0xFF. Outside the raster -> ex-info
  {:kotoba.image/error :out-of-bounds} (the JDK throws
  ArrayIndexOutOfBoundsException \"Coordinate out of bounds!\")."
  [img x y]
  (let [i (index! img x y)
        v (aget  i)]
    (if (= :rgb (:kind img)) (opaque v) )))

(defn set-rgb!
  "BufferedImage.setRGB(x, y, argb): any integer, of which the low 32 bits
  are taken (0xff0080ff as a long, -1, 0x1ffffffff all work). :rgb keeps only
  the low 24 bits. Returns nil. Bounds as get-rgb; a non-integer argb ->
  :invalid-argb."
  [img x y argb]
  (let [i (index! img x y)]
    (when-not (integer? argb)
      (fail :invalid-argb (str "argb must be an integer, got " (pr-str argb)) {:argb argb}))
    (let [v (s32 argb)
          v (if (= :rgb (:kind img)) (bit-and v 0xffffff) v)]
      (aset  i )
      nil)))

(defn pixels
  "Every pixel as get-rgb reports it, row-major, in a fresh vector."
  [img]
  (check-image! img)
  (let [w (:w img) h (:h img)]
    (vec (for [y (range h) x (range w)] (get-rgb img x y)))))

(defn- from-argb-ints
  "A raster of `type` whose pixel i is argb[i] (already what get-rgb must
  answer; :rgb keeps the low 24 bits)."
  [type w h argbs]
  (let [img (create w h type)
        ^ints d 
        rgb? (= :rgb type)]
    (loop [i 0 s (seq argbs)]
      (when s
        (let [v (s32 (first s))]
          (aset d i ))
        (recur (inc i) (next s))))
    img))

;; ── bytes in ─────────────────────────────────────────────────────────────────

(defn- ->ubytes
  "Whatever the caller holds as bytes -> a vector of 0..255."
  [b]
  (cond
    (nil? b) (fail :invalid-input "input == null!")
    (vector? b) (mapv #(bit-and % 0xff) b)
    :else
    ))

;; ── format sniffing: what ImageIO's reader SPIs would claim ─────────────────

(def ^:private png-signature [137 80 78 71 13 10 26 10])

(defn- starts-with? [v prefix]
  (and (>= (count v) (count prefix))
       (= prefix (subvec v 0 (count prefix)))))

(defn- wbmp-multibyte
  "WBMPImageReaderSpi.tryReadMultiByteInteger: [value next-pos] or nil on
  EOF / overflow."
  [v pos]
  (loop [pos pos result nil first? true]
    (if (>= pos (count v))
      nil
      (let [b (nth v pos)
            r (if first?
                (bit-and b 0x7f)
                (bit-or (bit-shift-left result 7) (bit-and b 0x7f)))]
        (if (zero? (bit-and b 0x80))
          [r (inc pos)]
          (if (not (zero? (bit-and r 0xfe000000)))
            nil
            (recur (inc pos) r false)))))))

(defn- wbmp?
  "WBMPImageReaderSpi.canDecodeInput. `known-length?` false = ImageIO.read of
  a stream (length -1: width < 1024 and height < 768 suffices); true = a
  File (the data after the header must be exactly the raster)."
  [v known-length?]
  (when (and (>= (count v) 2) (zero? (nth v 0)) (zero? (nth v 1)))
    (when-let [[w p] (wbmp-multibyte v 2)]
      (when-let [[h p] (wbmp-multibyte v p)]
        (and (pos? w) (pos? h)
             (if known-length?
               (= (- (count v) p) (* (+ (quot w 8) (if (zero? (mod w 8)) 0 1)) h))
               (and (< w 1024) (< h 768))))))))

(defn- sniff [v known-length?]
  (cond
    (starts-with? v png-signature) :png
    (starts-with? v [0xFF 0xD8]) :jpeg
    (or (starts-with? v [71 73 70 56 55 97]) (starts-with? v [71 73 70 56 57 97])) :gif
    (starts-with? v [0x42 0x4d]) :bmp
    (or (starts-with? v [0x49 0x49 0x2a 0x00]) (starts-with? v [0x4d 0x4d 0x00 0x2a])) :tiff
    (wbmp? v known-length?) :wbmp
    :else nil))

;; ── PNG → ARGB, the way PNGImageReader + its ColorModel do it ───────────────

(def ^:private color-type-bits
  {:gray #{1 2 4 8 16} :rgb #{8 16} :indexed #{1 2 4 8} :gray-alpha #{8 16} :rgba #{8 16}})

(def ^:private channels {:gray 1 :rgb 3 :indexed 1 :gray-alpha 2 :rgba 4})

(defn- refuse-png
  ([reason msg] (refuse-png reason msg {}))
  ([reason msg data] (fail :unsupported-png msg (assoc data :reason reason))))

(defn- fr
  "Round a double to the nearest IEEE single (Java's float arithmetic)."
  [x]
  )

(def ^:private f65535 (fr 65535.0))
(def ^:private f255 (fr 255.0))

(defn- u16->u8
  "ComponentColorModel.extractComponent / getAlpha for a 16-bit sample in an
  sRGB (or alpha) band: (int) ((float)c / 65535f * 255f + 0.5f)."
  [c]
  (let [f (fr (/ (fr c) f65535))
        g (fr (* f f255))
        h (fr (+ g 0.5))]
    ))

(defn- sample-reader
  "fn [row-bytes-offset x c] -> sample, for packed rows of `bits`."
  [data bits ch]
  (case (long bits)
    16 (fn [off x c]
         (let [i (+ off (* 2 (+ (* x ch) c)))]
           (bit-or (bit-shift-left (nth data i) 8) (nth data (inc i)))))
    8 (fn [off x c] (nth data (+ off (* x ch) c)))
    ;; sub-byte: only gray / indexed, one channel, MSB first
    (let [per (quot 8 bits) mask (dec (bit-shift-left 1 bits))]
      (fn [off x _]
        (let [b (nth data (+ off (quot x per)))
              shift (- 8 (* bits (inc (mod x per))))]
          (bit-and (bit-shift-right b shift) mask))))))

(defn- chunk-u16 [d i] (bit-or (bit-shift-left (nth d i) 8) (nth d (inc i))))

(defn- argb [a r g b]
  (s32 (bit-or (bit-shift-left a 24) (bit-shift-left r 16) (bit-shift-left g 8) b)))

(defn- palette-table
  "PNGImageReader.parse_PLTE_chunk + getImageTypes + parse_tRNS_chunk: the
  2^bits ARGB entries of the IndexColorModel ImageIO builds.
  The PLTE arrays are rounded UP to 2 / 4 / 16 / 256 entries with black,
  then padded to 2^bits with the LAST of those (black when rounding added
  any); tRNS entries beyond that rounded length are dropped, missing ones
  are 255."
  [plte trns bits]
  (let [n0 (quot (count plte) 3)
        n (min n0 (bit-shift-left 1 bits))
        rounded (cond (> n 16) 256 (> n 4) 16 (> n 2) 4 :else 2)
        entry (fn [i] (if (< i n)
                        [(nth plte (* 3 i)) (nth plte (+ 1 (* 3 i))) (nth plte (+ 2 (* 3 i)))]
                        [0 0 0]))
        rgb (mapv entry (range rounded))
        plength (bit-shift-left 1 bits)
        rgb (if (< rounded plength)
              (into rgb (repeat (- plength rounded) (peek rgb)))
              rgb)
        alpha (when trns
                (let [k (min (count trns) rounded)]
                  (into (vec (take k trns)) (repeat (- (count rgb) k) 255))))]
    (mapv (fn [i]
            (let [[r g b] (nth rgb i)]
              (argb (if alpha (nth alpha i) 255) r g b)))
          (range (count rgb)))))

(defn- zero-within [d limit]
  (first (filter #(zero? (nth d %)) (range (min limit (count d))))))

(defn- metadata-bytes-read
  "How many bytes of chunk `t` PNGImageReader's full metadata pass consumes
  (a palette image is the only kind ImageIO.read parses in full), or a
  refusal where the parser itself throws. A count different from the chunk
  length makes ImageIO throw \"Failed to read a chunk of type ..\"."
  [t d plte?]
  (let [n (count d)
        bad (fn [msg] (refuse-png :malformed msg {:chunk t}))
        keyword-end (fn [] (or (zero-within d 80) (bad (str t ": Found non null terminated string"))))]
    (case t
      "PLTE" (if plte? 0 n)
      "tRNS" (if plte? n 0)
      "bKGD" 1, "cHRM" 32, "gAMA" 4, "pHYs" 9, "sBIT" 3, "sRGB" 1, "tIME" 7
      "hIST" (if plte? (* 2 (quot n 2)) (bad "hIST chunk without prior PLTE chunk!"))
      "iCCP" (let [k (keyword-end)]
               (if (<= (- n k 2) 0) (bad "iCCP chunk length is not proper") n))
      "tEXt" (do (keyword-end) n)
      "sPLT" (let [k (keyword-end) rem (- n k 1)]
               (when (<= rem 0) (bad "sPLT chunk length is not proper"))
               (let [depth (nth d (inc k))
                     esz (case (long depth) 8 6 16 10 (bad "sPLT sample depth not 8 or 16!"))]
                 (+ k 2 (* esz (quot rem esz)))))
      n)))

(defn- palette-metadata
  "PNGImageReader.readMetadata for a palette image: every chunk up to IEND,
  in order. -> {:plte bytes :trns bytes-or-nil}."
  [chunks]
  (loop [cs (rest chunks) plte nil trns nil]
    (let [c (first cs) t (:type c) d (vec (:data c))]
      (cond
        (nil? c) (refuse-png :malformed "no IEND chunk (ImageIO reads a palette image's metadata to IEND)")
        (= "IEND" t) {:plte plte :trns trns}
        (and (= "IDAT" t) (nil? plte)) (refuse-png :missing-plte "Required PLTE chunk missing")
        :else
        (let [consumed (metadata-bytes-read t d (some? plte))]
          (when-not (= consumed (count d))
            (refuse-png :malformed (str "Failed to read a chunk of type " t) {:chunk t}))
          (recur (rest cs)
                 (if (and (= "PLTE" t) (nil? plte)) d plte)
                 (if (and (= "tRNS" t) plte) d trns)))))))

(defn- chunk-view
  "The chunks ImageIO.read looks at, in its order. ImageIO.read sets
  ignoreMetadata, so for a non-palette image only tRNS chunks BEFORE the
  first IDAT are read (the last valid one wins); for a palette image every
  chunk is parsed, a tRNS counts only after a PLTE, and a PLTE must come
  before the first IDAT."
  [chunks color bits]
  (let [idx (first (keep-indexed (fn [i c] (when (= "IDAT" (:type c)) i)) chunks))]
    (when (nil? idx) (refuse-png :malformed "no IDAT chunk"))
    (when (and (#{:gray-alpha :rgba} color)
               (some #(= "tRNS" (:type %)) (take idx chunks)))
      ;; parse_tRNS_chunk returns without consuming the chunk for colour
      ;; types 4/6, and ImageIO.read then misreads the stream.
      (refuse-png :malformed "tRNS chunk in a gray+alpha / RGBA image"))
    (if (= :indexed color)
      (let [{:keys [plte trns]} (palette-metadata chunks)]
        (when (nil? plte)
          (refuse-png :missing-plte "Required PLTE chunk missing"))
        {:plte plte :trns trns})
      (let [want (case color :gray 2 :rgb 6 nil)
            trns (when want
                   (some->> (take idx chunks)
                            (filter #(and (= "tRNS" (:type %)) (= want (count (:data %)))))
                            last :data vec))]
        {:trns trns}))))

(defn- decode-png [v]
  ;; The chunk list and IHDR first (png.decode), so that the header's own
  ;; refusals (:interlaced, bit depth, ...) are the reason reported rather
  ;; than whatever unfiltering Adam7 data as sequential rows trips over;
  ;; the pixels (png.core/parse) only once the header is one we decode.
  (let [chunks (try (:chunks (png-decode/decode grammar/grammar v))
                    (catch  e
                      (refuse-png :malformed (str "PNG does not parse: " (ex-message e)))))
        c0 (first chunks)
        _ (when-not (and (= "IHDR" (:type c0)) (= 13 (count (:data c0))))
            (refuse-png :malformed "Bad type or length for IHDR chunk!"))
        {:keys [width height bit-depth color-type compression filter interlace]}
        (png-decode/decode grammar/grammar :ihdr (vec (:data c0)))]
    (when-not (and (integer? width) (integer? height) (pos? width) (pos? height))
      (refuse-png :malformed "Image width/height <= 0!" {:width width :height height}))
    (when-not (contains? color-type-bits color-type)
      (refuse-png :invalid-color-type "Color type must be 0, 2, 3, 4, or 6!" {:color-type color-type}))
    (when-not (contains? (color-type-bits color-type) bit-depth)
      (refuse-png :invalid-bit-depth "Bad color type/bit depth combination!"
                  {:color-type color-type :bit-depth bit-depth}))
    (when-not (and (= 0 compression) (= 0 filter))
      (refuse-png :malformed "Unknown compression/filter method (not 0)!"))
    (case (long interlace)
      0 nil
      1 (refuse-png :interlaced "Adam7-interlaced PNGs are not decoded (png.core does not de-interlace)")
      (refuse-png :malformed "Unknown interlace method (not 0 or 1)!"))
    (when (> (* width height) max-pixels)
      (refuse-png :too-large "Can not read image of the size" {:width width :height height}))
    (let [ch (channels color-type)
          bits bit-depth
          stride (quot (+ (* width ch bits) 7) 8)
          {:keys [plte trns]} (chunk-view chunks color-type bits)
          data (try (:pixels (png/parse grammar/grammar v))
                    (catch  e
                      (refuse-png :malformed (str "PNG image data does not decode: " (ex-message e)))))
          _ (when (< (count data) (* stride height))
              (refuse-png :malformed "image data is shorter than the IHDR says"
                          {:expected (* stride height) :got (count data)}))
          sample (sample-reader data bits ch)
          g (fn [s] (gray/srgb8 bits s))
          px (case color-type
               :rgb (let [c8 (if (= 16 bits) u16->u8 identity)
                          tr (when trns [(chunk-u16 trns 0) (chunk-u16 trns 2) (chunk-u16 trns 4)])]
                      (fn [off x]
                        (let [r (sample off x 0) gg (sample off x 1) b (sample off x 2)]
                          (argb (if (and tr (= [r gg b] tr)) 0 255) (c8 r) (c8 gg) (c8 b)))))
               :rgba (let [c8 (if (= 16 bits) u16->u8 identity)]
                       (fn [off x]
                         (argb (c8 (sample off x 3)) (c8 (sample off x 0))
                               (c8 (sample off x 1)) (c8 (sample off x 2)))))
               :gray-alpha (let [a8 (if (= 16 bits) u16->u8 identity)]
                             (fn [off x]
                               (let [v (g (sample off x 0))]
                                 (argb (a8 (sample off x 1)) v v v))))
               :gray (if (< bits 8)
                       ;; scale to 8 bits the way both JDK paths do:
                       ;; (s*255 + max/2)/max == the IndexColorModel ramp i*255/max
                       (let [mx (dec (bit-shift-left 1 bits))
                             scale (fn [s] (quot (+ (* s 255) (quot mx 2)) mx))
                             tg (when trns (chunk-u16 trns 0))]
                         (if tg
                           ;; tRNS: an 8-bit gray+alpha raster; the SCALED sample
                           ;; is compared with the tRNS value (PNGImageReader
                           ;; decodePass), and gray goes through the sRGB LUT.
                           (fn [off x]
                             (let [s (scale (sample off x 0)) v (gray/srgb8 8 s)]
                               (argb (if (= s tg) 0 255) v v v)))
                           ;; no tRNS: IndexColorModel ramp, no colour conversion.
                           (fn [off x]
                             (let [v (scale (sample off x 0))] (argb 255 v v v)))))
                       (let [tg (when trns (chunk-u16 trns 0))]
                         (fn [off x]
                           (let [s (sample off x 0) v (g s)]
                             (argb (if (and tg (= s tg)) 0 255) v v v)))))
               :indexed (let [table (palette-table plte trns bits)]
                          (fn [off x] (nth table (sample off x 0)))))
          type (if (or (#{:rgba :gray-alpha} color-type) (some? trns)) :argb :rgb)]
      (from-argb-ints type width height
                      (for [y (range height) x (range width)]
                        (px (* y stride) x))))))

(defn- read-ubytes [v known-length?]
  (case (sniff v known-length?)
    :png (decode-png v)
    nil nil
    (let [f (sniff v known-length?)]
      (fail :unsupported-format
            (str "ImageIO would decode this as " (name f) "; kotoba.image decodes PNG only")
            {:format f}))))

(defn read-image
  "ImageIO.read(new ByteArrayInputStream(bytes)), for PNG.

  -> a raster whose get-rgb equals ImageIO's getRGB for every pixel; :argb
     when the PNG carries alpha (colour type 4 / 6, or a tRNS chunk ImageIO
     honours), else :rgb.
  -> nil when no ImageIO reader would claim the bytes (ImageIO returns null).
  -> ex-info {:kotoba.image/error :unsupported-format :format f} for JPEG,
     GIF, BMP, TIFF and WBMP signatures.
  -> ex-info {:kotoba.image/error :unsupported-png :reason r} for a PNG this
     does not decode: :interlaced :malformed :missing-plte
     :invalid-bit-depth :invalid-color-type :too-large."
  [bytes]
  (read-ubytes (->ubytes bytes) false))

;; ── PNG out ──────────────────────────────────────────────────────────────────

(defn- host-bytes [v]
  )

(defn write-png
  "ImageIO.write(img, \"png\", out) -> the PNG bytes (byte[] on the JVM,
  Int8Array under kbb). :rgb -> colour type 2, :argb -> colour type 6, 8-bit,
  no interlace. ImageIO.read of the result gives getRGB == get-rgb for every
  pixel."
  [img]
  (check-image! img)
  (let [w (:w img) h (:h img) argb? (= :argb (:kind img))
        d (:data img)
        samples (persistent!
                 (reduce (fn [acc i]
                           (let [v (aget  i)
                                 acc (-> acc
                                         (conj! (bit-and (bit-shift-right v 16) 0xff))
                                         (conj! (bit-and (bit-shift-right v 8) 0xff))
                                         (conj! (bit-and v 0xff)))]
                             (if argb? (conj! acc (bit-and (bit-shift-right v 24) 0xff)) acc)))
                         (transient [])
                         (range (* w h))))]
    (host-bytes (encode/encode samples {:width w :height h :color (if argb? :rgba :rgb)}))))

;; ── files ────────────────────────────────────────────────────────────────────

(defn- ->path [f]
  )

(defn read-file
  "ImageIO.read(File): f is a path string (on the JVM also a java.io.File or
  java.nio.file.Path). A file that does not exist, is not a regular file, or
  cannot be read -> ex-info {:kotoba.image/error :cannot-read :path p} (the
  JDK: IIOException \"Can't read input file!\"). Otherwise as read-image,
  except that the WBMP sniff knows the length, as ImageIO's File path does."
  [f]
  (let [p (->path f)]
    (when-not (and (file/file? p) (file/can-read? p))
      (fail :cannot-read "Can't read input file!" {:path p}))
    (read-ubytes (->ubytes (file/read-all-bytes p)) true)))

(defn write-png-file!
  "ImageIO.write(img, \"png\", File): writes write-png's bytes to f (same
  forms as read-file), creating or truncating it. Returns true. A path that
  cannot be written -> ex-info {:kotoba.image/error :cannot-write :path p}."
  [img f]
  (let [p (->path f)
        bytes (write-png img)]
    (try (file/write-bytes p bytes)
         (catch  e
           (fail :cannot-write (str "cannot write " p ": " (ex-message e)) {:path p})))
    true))
