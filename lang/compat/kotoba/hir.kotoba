(ns kotoba.hir
  {:kotoba/export [formats valid? module-problem]}
  (:require [kotoba.lang.coll :as set]))

(def formats #{:kotoba.hir/v2 :kotoba.hir/v3})

(def ^:private module-keys
  #{:format :namespace :schemas :schema-identities :entry :exports :result
    :effects :named-operations :language-profile :functions})

(def ^:private required-function-keys
  #{:name :params :result :effects :body})

(def ^:private function-keys
  #{:name :params :result :effects :body :source-name :param-types
    :result-inferred? :effects-ceiling :closure-param-indexes
    :i64-pair-chain-param-indexes :closure-result? :lazy-thunk? :loop-helper?
    :callable-param-contracts :callable-result-contract})

(def ^:private max-form-depth 256)
(def ^:private max-form-nodes 1000000)

(defn- reject! [problem :keyword data :document] :document
     (throw "HIR rejected"))

(defn- portable-bigint? [value]
  false)

(defn- portable-scalar? [value]
  (or (nil? value) (boolean? value) (number? value) (string? value)
      (keyword? value) (symbol? value) (char? value)
      (portable-bigint? value)))

(defn- nonnegative-integer? [value]
  (and (or (integer? value) (portable-bigint? value))
       (not (neg? value))))

(do
     ;; Kotoba's boundary values are portable documents. Scan their canonical
     ;; EDN rendering to enforce the same depth and node limits without host
     ;; mutation or a host collection iterator.
     (defn- edn-delimiter? [point :i64] :bool
       (or (= point 9) (= point 10) (= point 13) (= point 32) (= point 44)
           (= point 34) (= point 40) (= point 41) (= point 91) (= point 93)
           (= point 123) (= point 125)))

     (defn- edn-token-end [text :string start :i64 length :i64] :i64
       (loop [i start]
         (if (>= i length)
           i
           (if (edn-delimiter? (string-code-point-at text i))
             i
             (recur (+ i 1))))))

     (defn- edn-special-number? [text :string start :i64 end :i64] :bool
       (let [token (string-substring text start end)]
         (or (string=? token "##NaN")
             (string=? token "##Inf")
             (string=? token "##-Inf"))))

     ;; 0 is valid; 1 is the node limit; 2 is the depth limit; 3 is a
     ;; non-portable tagged value; 4 is an impossible malformed printer result.
     (defn- edn-form-status [text :string] :i64
       (let [length (string-length text)]
         (loop [i 0 depth 0 nodes 0 in-string? false escaped? false]
           (if (> nodes max-form-nodes)
             1
             (if (>= i length)
               (if (and (= depth 0) (not in-string?)) 0 4)
               (let [point (string-code-point-at text i)]
                 (if in-string?
                   (if escaped?
                     (recur (+ i 1) depth nodes true false)
                     (if (= point 92)
                       (recur (+ i 1) depth nodes true true)
                       (if (= point 34)
                         (recur (+ i 1) depth nodes false false)
                         (recur (+ i 1) depth nodes true false)))
                   (cond
                     (or (= point 9) (= point 10) (= point 13)
                         (= point 32) (= point 44))
                     (recur (+ i 1) depth nodes false false)

                     (= point 34)
                     (if (> depth max-form-depth)
                       2
                       (recur (+ i 1) depth (+ nodes 1) true false))

                     (= point 35)
                     (if (and (< (+ i 1) length)
                              (= (string-code-point-at text (+ i 1)) 123))
                       (if (> depth max-form-depth)
                         2
                         (recur (+ i 2) (+ depth 1) (+ nodes 1) false false))
                       (let [end (edn-token-end text i length)]
                         (if (edn-special-number? text i end)
                           (if (> depth max-form-depth)
                             2
                             (recur end depth (+ nodes 1) false false))
                           3)))

                     (or (= point 40) (= point 91) (= point 123))
                     (if (> depth max-form-depth)
                       2
                       (recur (+ i 1) (+ depth 1) (+ nodes 1) false false))

                     (or (= point 41) (= point 93) (= point 125))
                     (if (<= depth 0)
                       4
                       (recur (+ i 1) (- depth 1) nodes false false))

                     :else
                     (if (> depth max-form-depth)
                       2
                       (recur (edn-token-end text i length)
                              depth (+ nodes 1) false false))))))))))

     (defn- validate-portable-form! [form :document] :document
       (let [status (edn-form-status (document-edn-print form))]
         (if (= status 0)
           form
           (throw (if (= status 1)
                    "HIR rejected: form node limit"
                    (if (= status 2)
                      "HIR rejected: form depth limit"
                      (if (= status 3)
                        "HIR rejected: non-portable form"
                        "HIR rejected: malformed portable form"))))))))
   )

;; An effect row holds two kinds of member. `[:cap/call id]` is an authority
;; the function exercises. `:abort` is a TRACKED CONTROL EFFECT (kotoba-lang
;; `lang/abort-ability.edn`, slice 1): the function may leave its caller's
;; scope through a typed abort, which the frontend lowers to a `[:result T E]`
;; result before this contract sees the body. The keyword carries no error
;; type on purpose -- E lives in the elaborated `:result`, the row only says
;; that the function aborts. `:state` is the PURE ABILITY state (kotoba-lang
;; `lang/state-ability.edn`, slice 1): the function performs get/put, which a
;; handler written in the language answers; the frontend has already lowered it
;; by state passing, so the keyword is the function's TYPE and no authority.
;; Nothing else is admitted: a keyword that is not one of these two is not a
;; row member, so a misspelling fails closed here rather than reading as an
;; effect nothing enforces.
(def ^:private control-effects
  "The keyword row members: tracked control effects and pure abilities."
  #{:abort :state})

(defn- valid-effect? [effect]
     (or (contains? control-effects effect)
         (and (vector? effect)
              (= 2 (count effect))
              (= :cap/call (first effect))
              (nonnegative-integer? (second effect)))))

(defn- validate-effects! [effects context]
     (when-not (and (set? effects) (every? valid-effect? effects))
       (reject! :invalid-effects (assoc context :effects effects))))

(defn- valid-indexes? [indexes parameter-count]
     (and (vector? indexes)
          (= (count indexes) (count (distinct indexes)))
          (every? #(and (integer? %) (<= 0 %)
                        (< % parameter-count))
                  indexes)))

(defn- validate-function! [format function]
  (when-not (map? function)
    (reject! :function-not-map {:function function}))
  (let [keys* (set (keys function))
        unknown (set/difference keys* function-keys)
        missing (set/difference required-function-keys keys*)
        {:keys [name source-name params param-types effects effects-ceiling body]}
        function]
    (when (seq unknown)
      (reject! :unknown-function-keys {:function name :keys unknown}))
    (when (seq missing)
      (reject! :missing-function-keys {:function name :keys missing}))
    (when-not (symbol? name)
      (reject! :invalid-function-name {:function name}))
    (when-not (or (nil? source-name) (symbol? source-name))
      (reject! :invalid-source-name {:function name :source-name source-name}))
    (when-not (and (vector? params) (every? symbol? params)
                   (= (count params) (count (distinct params))))
      (reject! :invalid-parameters {:function name :params params}))
    (if (= :kotoba.hir/v3 format)
      (when-not (and (vector? param-types)
                     (= (count params) (count param-types)))
        (reject! :invalid-parameter-types
                 {:function name :params params :param-types param-types}))
      (when (contains? function :param-types)
        (reject! :v2-parameter-types {:function name})))
    (validate-effects! effects {:function name})
    (when (contains? function :effects-ceiling)
      (validate-effects! effects-ceiling {:function name :field :effects-ceiling})
      (when-not (set/subset? effects effects-ceiling)
        (reject! :effect-ceiling-exceeded
                 {:function name :effects effects :ceiling effects-ceiling})))
    (doseq [field [:closure-param-indexes :i64-pair-chain-param-indexes]
            :when (contains? function field)]
      (when-not (valid-indexes? (get function field) (count params))
        (reject! :invalid-parameter-indexes
                 {:function name :field field :indexes (get function field)})))
    (doseq [field [:closure-result? :lazy-thunk? :loop-helper?]
            :when (contains? function field)]
      (when-not (boolean? (get function field))
        (reject! :invalid-boolean-annotation
                 {:function name :field field :value (get function field)})))
    (when (contains? function :result-inferred?)
      (when-not (or (nil? (:result-inferred? function))
                    (boolean? (:result-inferred? function)))
        (reject! :invalid-result-inferred {:function name})))
    (when (contains? function :callable-param-contracts)
      (let [contracts (:callable-param-contracts function)]
        (when-not (and (map? contracts)
                       (every? #(and (integer? %) (<= 0 %) (< % (count params)))
                               (keys contracts)))
          (reject! :invalid-callable-parameter-contracts
                   {:function name :contracts contracts}))))
    (when (nil? body)
      (reject! :missing-function-body {:function name}))
    (validate-portable-form! (:result function))
    (when param-types (validate-portable-form! param-types))
    (when-let [contract (:callable-result-contract function)]
      (validate-portable-form! contract))
    (when-let [contracts (:callable-param-contracts function)]
      (validate-portable-form! contracts))
    (validate-portable-form! body))
  function)

(defn- validate-host!
  "Validate the checked HIR module envelope and return it unchanged.

  This validates the inter-repository contract, not source semantics: sema is
  responsible for proving that admitted expression operations are well typed."
  [hir]
  hir)

(do
     (defn- hir-fail! [] :document
       (throw (document-map (document-keyword :message)
                            (document-string "HIR rejected"))))

     (defn- hir-field [value :document key :keyword] :document
       (option-value-of [:option :document] (document-get value key) (document-null)))

     (defn- hir-vector-at [value :document index :i64] :document
       (option-value-of [:option :document] (document-vector-at value index) (document-null)))

     (defn- hir-set-at [value :document index :i64] :document
       (option-value-of [:option :document] (document-set-at value index) (document-null)))

     (defn- hir-map-entry-at [value :document index :i64] :document
       (option-value-of [:option :document] (document-map-entry-at value index) (document-null)))

     (defn- hir-kind? [value :document kind :keyword] :bool
       (= kind (document-kind value)))

     (defn- hir-has-field? [value :document key :keyword] :bool
       (document-contains value key))

     (defn- hir-null? [value :document] :bool
       (hir-kind? value :null))

     (defn- hir-symbol? [value :document] :bool
       (hir-kind? value :symbol))

     (defn- hir-keyword? [value :document] :bool
       (hir-kind? value :keyword))

     (defn- hir-bool? [value :document] :bool
       (hir-kind? value :bool))

     (defn- hir-nonnegative-i64? [value :document] :bool
       (let [number (document-i64-value value)]
         (and (option-some? number)
              (not (neg? (option-value-of [:option :i64] number 0))))))

     (defn- hir-valid-effect? [effect :document] :bool
       (if (hir-keyword? effect)
         (or (document-equal? effect (document-keyword :abort))
             (document-equal? effect (document-keyword :state)))
         (if (hir-kind? effect :vector)
           (and (= 2 (document-count effect))
                (document-equal? (hir-vector-at effect 0) (document-keyword :cap/call))
                (hir-nonnegative-i64? (hir-vector-at effect 1)))
           false)))

     (defn- hir-validate-effects! [effects :document] :document
       (when-not (hir-kind? effects :set) (hir-fail!))
       (loop [index 0]
         (when (< index (document-count effects))
           (when-not (hir-valid-effect? (hir-set-at effects index)) (hir-fail!))
           (recur (+ index 1))))
       effects)

     (defn- hir-symbol-vector! [values :document] :document
       (when-not (hir-kind? values :vector) (hir-fail!))
       (loop [index 0]
         (when (< index (document-count values))
           (let [value (hir-vector-at values index)]
             (when-not (hir-symbol? value) (hir-fail!))
             (loop [prior 0]
               (when (< prior index)
                 (when (document-equal? value (hir-vector-at values prior)) (hir-fail!))
                 (recur (+ prior 1))))
             (recur (+ index 1)))))
       values)

     (defn- hir-index-vector! [indexes :document parameter-count :i64] :document
       (when-not (hir-kind? indexes :vector) (hir-fail!))
       (loop [index 0]
         (when (< index (document-count indexes))
           (let [value (hir-vector-at indexes index)
                 number (document-i64-value value)]
             (when-not (and (option-some? number)
                            (not (neg? (option-value-of [:option :i64] number 0)))
                            (< (option-value-of [:option :i64] number 0) parameter-count))
               (hir-fail!))
             (loop [prior 0]
               (when (< prior index)
                 (when (document-equal? value (hir-vector-at indexes prior)) (hir-fail!))
                 (recur (+ prior 1))))
             (recur (+ index 1)))))
       indexes)

     (defn- hir-known-function-key? [key :document] :bool
       (let [keyword (option-value-of [:option :keyword]
                                      (document-keyword-value key) :missing)]
         (contains? function-keys keyword)))

     (defn- hir-validate-function! [format :document function :document] :document
       (when-not (and (hir-kind? function :map)
                      (<= 5 (document-count function))
                      (<= (document-count function) 16)
                      (hir-has-field? function :name)
                      (hir-has-field? function :params)
                      (hir-has-field? function :result)
                      (hir-has-field? function :effects)
                      (hir-has-field? function :body))
         (hir-fail!))
       (loop [index 0]
         (when (< index (document-count function))
           (let [entry (hir-map-entry-at function index)]
             (when-not (hir-known-function-key? (hir-vector-at entry 0)) (hir-fail!))
             (recur (+ index 1)))))
       (let [name (hir-field function :name)
             params (hir-field function :params)
             effects (hir-field function :effects)
             body (hir-field function :body)
             parameter-count (document-count params)]
         (when-not (and (hir-symbol? name) (hir-kind? params :vector) (not (hir-null? body)))
           (hir-fail!))
         (hir-symbol-vector! params)
         (hir-validate-effects! effects)
         (when (document-equal? format (document-keyword :kotoba.hir/v3))
           (when-not (and (hir-has-field? function :param-types)
                          (hir-kind? (hir-field function :param-types) :vector)
                          (= parameter-count
                             (document-count (hir-field function :param-types))))
             (hir-fail!)))
         (when (and (document-equal? format (document-keyword :kotoba.hir/v2))
                    (hir-has-field? function :param-types))
           (hir-fail!))
         (when (hir-has-field? function :effects-ceiling)
           (let [ceiling (hir-field function :effects-ceiling)]
             (hir-validate-effects! ceiling)
             (loop [index 0]
               (when (< index (document-count effects))
                 (when-not (document-set-contains? ceiling (hir-set-at effects index))
                   (hir-fail!))
                 (recur (+ index 1)))))
         (loop [field-index 0]
           (when (< field-index 2)
             (let [field (if (= field-index 0) :closure-param-indexes
                             :i64-pair-chain-param-indexes)]
               (when (hir-has-field? function field)
                 (hir-index-vector! (hir-field function field) parameter-count)))
             (recur (+ field-index 1))))
         (loop [field-index 0]
           (when (< field-index 3)
             (let [field (if (= field-index 0) :closure-result?
                             (if (= field-index 1) :lazy-thunk? :loop-helper?))]
               (when (and (hir-has-field? function field)
                          (not (hir-bool? (hir-field function field))))
                 (hir-fail!)))
             (recur (+ field-index 1))))
         (when (and (hir-has-field? function :result-inferred?)
                    (not (or (hir-null? (hir-field function :result-inferred?))
                             (hir-bool? (hir-field function :result-inferred?)))))
           (hir-fail!))
         (validate-portable-form! (hir-field function :result))
         (validate-portable-form! body)
         function))

     (defn- hir-find-function [functions :document name :document] :document
       (loop [index 0]
         (if (< index (document-count functions))
           (let [function (hir-vector-at functions index)]
             (if (document-equal? name (hir-field function :name))
               function
               (recur (+ index 1))))
           (document-null))))

     (defn- hir-exported? [exports :document name :document] :bool
       (loop [index 0]
         (if (< index (document-count exports))
           (if (document-equal? name (hir-vector-at exports index))
             true
             (recur (+ index 1)))
           false)))

     (defn validate! [hir :document] :document
       (when-not (hir-kind? hir :map) (hir-fail!))
       (when-not (= 12 (document-count hir)) (hir-fail!))
       (when-not (and (hir-has-field? hir :format)
                      (hir-has-field? hir :namespace)
                      (hir-has-field? hir :schemas)
                      (hir-has-field? hir :schema-identities)
                      (hir-has-field? hir :entry)
                      (hir-has-field? hir :exports)
                      (hir-has-field? hir :result)
                      (hir-has-field? hir :effects)
                      (hir-has-field? hir :named-operations)
                      (hir-has-field? hir :language-profile)
                      (hir-has-field? hir :functions))
         (hir-fail!))
       (validate-portable-form! hir)
       (let [format (hir-field hir :format)
             namespace (hir-field hir :namespace)
             schemas (hir-field hir :schemas)
             schema-identities (hir-field hir :schema-identities)
             entry (hir-field hir :entry)
             exports (hir-field hir :exports)
             result (hir-field hir :result)
             effects (hir-field hir :effects)
             named-operations (hir-field hir :named-operations)
             language-profile (hir-field hir :language-profile)
             functions (hir-field hir :functions)]
         (when-not (or (document-equal? format (document-keyword :kotoba.hir/v2))
                       (document-equal? format (document-keyword :kotoba.hir/v3)))
           (hir-fail!))
         (when-not (or (hir-null? namespace) (hir-symbol? namespace)) (hir-fail!))
         (when-not (or (hir-null? schemas) (hir-kind? schemas :map)) (hir-fail!))
         (when-not (or (hir-null? schema-identities) (hir-kind? schema-identities :map))
           (hir-fail!))
         (when-not (or (hir-null? language-profile) (hir-keyword? language-profile))
           (hir-fail!))
         (when-not (and (hir-kind? functions :vector) (> (document-count functions) 0))
           (hir-fail!))
         (hir-validate-effects! effects)
         (when-not (hir-kind? named-operations :set) (hir-fail!))
         (loop [index 0]
           (when (< index (document-count named-operations))
             (when-not (hir-keyword? (hir-set-at named-operations index)) (hir-fail!))
             (recur (+ index 1))))
         (loop [index 0]
           (when (< index (document-count functions))
             (let [function (hir-vector-at functions index)
                   name (hir-field function :name)]
               (hir-validate-function! format function)
               (loop [prior 0]
                 (when (< prior index)
                   (when (document-equal? name
                                          (hir-field (hir-vector-at functions prior) :name))
                     (hir-fail!))
                   (recur (+ prior 1))))
               (recur (+ index 1))))
         (when-not (hir-kind? exports :vector) (hir-fail!))
         (hir-symbol-vector! exports)
         (loop [index 0]
           (when (< index (document-count exports))
             (when (hir-null? (hir-find-function functions (hir-vector-at exports index)))
               (hir-fail!))
             (recur (+ index 1))))
         (if (hir-null? entry)
           (when-not (hir-null? result) (hir-fail!))
           (let [function (hir-find-function functions entry)]
             (when-not (and (hir-symbol? entry)
                            (not (hir-null? function))
                            (hir-exported? exports entry)
                            (document-equal? result (hir-field function :result)))
               (hir-fail!))))
         hir)))))

(defn validate! [hir]
     (validate-host! hir))

(defn module-problem [hir :document] :keyword
     (try
       (do (validate! hir) :ok)
       (catch problem :invalid)))

(defn valid? [hir :document] :bool
     (= (module-problem hir) :ok))
