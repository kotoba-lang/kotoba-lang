(ns kotoba.image.gray
  "What `getRGB` does to a gray sample, as data.

  A PNG of colour type 0 or 4 (and a gray PNG with a tRNS chunk) comes out of
  javax.imageio as a ComponentColorModel over ColorSpace.CS_GRAY, and CS_GRAY
  is LINEAR gray. `getRGB` therefore does not return the sample: it converts
  linear gray to sRGB through a lookup table (ComponentColorModel ->
  ColorModel.getLinearRGB8TosRGB8LUT / getLinearRGB16TosRGB8LUT, the IEC
  61966-2-1 transfer curve evaluated in float). A gray sample of 128 reads
  back as 0xFFBCBCBC, not 0xFF808080.

  The two tables below are that LUT as the JDK computes it -- measured, not
  re-derived: they were printed by writing every sample into a
  TYPE_BYTE_GRAY / TYPE_USHORT_GRAY raster and calling getRGB (OpenJDK
  21.0.1, 2026-09-25). Measured rather than recomputed because the JDK's
  curve goes through Math.pow and float rounding, and a JavaScript pow that
  differs by one ulp would move a rounding boundary. kotoba.image.jvm-oracle-test
  re-measures all 256 + 65536 entries against the live JDK.

  Sub-byte gray (1/2/4-bit) without tRNS does NOT go through this table: the
  JDK builds an IndexColorModel ramp for it (ImageTypeSpecifier.Grayscale),
  so those samples read back scaled but unconverted.")

(def lut8
  "linear gray 8-bit sample -> sRGB 8-bit, index = sample."
  [0 13 22 28 34 38 42 46 50 53 56 59 61 64 66 69 71 73 75 77 79 81 83 85 86
   88 90 92 93 95 96 98 99 101 102 104 105 106 108 109 110 112 113 114 115 117
   118 119 120 121 122 124 125 126 127 128 129 130 131 132 133 134 135 136 137
   138 139 140 141 142 143 144 145 146 147 148 148 149 150 151 152 153 154 155
   155 156 157 158 159 159 160 161 162 163 163 164 165 166 167 167 168 169 170
   170 171 172 173 173 174 175 175 176 177 178 178 179 180 180 181 182 182 183
   184 185 185 186 187 187 188 189 189 190 190 191 192 192 193 194 194 195 196
   196 197 197 198 199 199 200 200 201 202 202 203 203 204 205 205 206 206 207
   208 208 209 209 210 210 211 212 212 213 213 214 214 215 215 216 216 217 218
   218 219 219 220 220 221 221 222 222 223 223 224 224 225 226 226 227 227 228
   228 229 229 230 230 231 231 232 232 233 233 234 234 235 235 236 236 237 237
   238 238 238 239 239 240 240 241 241 242 242 243 243 244 244 245 245 246 246
   246 247 247 248 248 249 249 250 250 251 251 251 252 252 253 253 254 254 255
   255])

(def thresholds16
  "linear gray 16-bit sample -> sRGB 8-bit, as thresholds: output o is
  produced by samples in [thresholds16[o], thresholds16[o+1]). The measured
  table is monotone and hits every output 0..255, so 256 numbers describe
  all 65536 entries."
  [0 10 30 50 70 90 110 130 150 170 189 209 230 253 276 301 327 354 382 412
   443 475 509 544 580 618 657 698 740 783 828 875 923 972 1023 1075 1129 1185
   1242 1300 1360 1422 1486 1551 1617 1685 1755 1827 1900 1975 2052 2130 2210
   2292 2376 2461 2548 2637 2727 2820 2914 3010 3108 3208 3309 3412 3518 3625
   3734 3844 3957 4072 4188 4307 4427 4550 4674 4800 4928 5059 5191 5325 5461
   5599 5740 5882 6026 6173 6321 6471 6624 6778 6935 7094 7255 7418 7583 7750
   7919 8091 8265 8440 8618 8798 8981 9165 9352 9541 9732 9925 10121 10318
   10518 10720 10925 11132 11341 11552 11765 11981 12199 12420 12643 12868
   13095 13325 13557 13791 14028 14267 14508 14752 14998 15247 15498 15751
   16007 16265 16525 16788 17054 17321 17592 17864 18139 18417 18697 18980
   19264 19552 19842 20134 20429 20727 21027 21329 21634 21942 22252 22564
   22880 23197 23518 23840 24166 24494 24824 25158 25493 25832 26173 26516
   26862 27211 27563 27917 28273 28633 28995 29359 29727 30097 30469 30845
   31223 31603 31987 32373 32762 33153 33547 33944 34344 34747 35152 35560
   35970 36384 36800 37219 37640 38065 38492 38922 39355 39790 40229 40670
   41114 41561 42011 42463 42918 43377 43838 44301 44768 45238 45710 46185
   46663 47144 47628 48115 48605 49097 49593 50091 50592 51096 51604 52114
   52627 53142 53661 54183 54708 55235 55766 56300 56836 57376 57918 58464
   59012 59564 60118 60675 61236 61799 62366 62935 63508 64083 64662 65244])

(def ^:private lut16*
  (delay
    (let [t thresholds16]
      (loop [s 0 o 0 acc (transient [])]
        (if (> s 65535)
          (persistent! acc)
          (let [o (if (and (< o 255) (>= s (nth t (inc o)))) (inc o) o)]
            (recur (inc s) o (conj! acc o))))))))

(defn srgb8
  "The sRGB 8-bit value getRGB reports for linear gray `sample` of `bits`
  (8 or 16)."
  [bits sample]
  (if (== 8 bits) (nth lut8 sample) (nth @lut16* sample)))
