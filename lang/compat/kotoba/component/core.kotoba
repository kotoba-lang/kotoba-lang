         arena-base (align-up (if (seq non-empty)
                                (+ (:pointer (last non-empty))
                                   (:length (last non-empty)))
                                8)
                              8)
         str-ptr (into {} (map (juxt :value :pointer) prepared-strs))
         str-len (into {} (map (juxt :value :length) prepared-strs))
