                   (case (first descriptor)
                     :option [(second descriptor)]
                     :result [(second descriptor) (nth descriptor 2)]
                     nil))]
    (and (= 1 (count params))
         (= 1 (count param-types))
         (= descriptor result)
         (= (first params) body)
         (seq payloads)
         (every? supported-payload? payloads)
