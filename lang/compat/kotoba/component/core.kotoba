        by-id (into {} (map (juxt :id identity))
                    (:capabilities component-wit/contract))
        scalar-type {:i64 0x7e :f32 0x7d :f64 0x7c}
        import-for
        (fn [dd__154051_1]
          (let [id (fe-get dd__154051_1 :id)
                request-type (fe-get dd__154051_1 :request-type)
                result-type (fe-get dd__154051_1 :result-type)]
