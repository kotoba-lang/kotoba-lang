;; kotoba.kir -- the GUEST-ROUTE twin of osaho's `kotoba/kir.cljk`, narrowed
;; to the surface the compiler front end actually consumes.
;;
;; WHY A TWIN. kir.cljk is ~6000 lines of host code: an interpreter over host
;; maps/lists/bigints (`eval-expr`, `execute`), an `ex-info`-throwing trap
;; channel, dynamic vars, `volatile!` fuel counters, and a lowering (`lower`)
;; that validates through `kotoba.hir/validate!` and then SEALS an oracle by
;; running that interpreter. None of it has a Kotoba spelling today, and the
;; project route refuses the host module at its first cross-module call
;; ("qualified call is not an admitted exported import: value/operand-tag?").
;; Consumers (kotoba-sema `frontend`, and through it sema/project/
;; capability_names ...) use three functions of it: `lower`, `execute` (only
;; to constant-fold a `def` value under a fuel bound) and
;; `host-stack-exhausted?`. This module exports exactly those, plus `eval-expr`
;; and the three exported budget constants, over kotoba.form's `:form/r`.
;;
;; WHAT IS REAL AND WHAT IS A NAMED REFUSAL
;;   host-stack-exhausted?  REAL. The host predicate asks whether an exception
;;                          is the host running out of native stack (V8
;;                          RangeError "...call stack...", SpiderMonkey "too
;;                          much recursion"). A Kotoba function is never handed
;;                          a host exception; the twin takes the exception's
;;                          MESSAGE and answers the same question on the same
;;                          two phrases. (The JVM StackOverflowError branch has
;;                          no message-only equivalent and is not reachable on
;;                          the guest route.)
;;   max-fuel, default-frames, max-frames
;;                          REAL, as zero-argument functions (an exported
;;                          constant must be a function): call as (max-fuel).
;;   lower                  REFUSAL. Its two halves are (1) validation through
;;                          kotoba.hir/validate! + two shape rejectors and
;;                          (2) sealing `:oracle-value` by RUNNING the
;;                          interpreter. Half (2) needs `execute`; emitting the
;;                          structural half alone would return a KIR module
;;                          with no sealed oracle and no validation, i.e. a
;;                          different artifact under the same name. So it
;;                          answers ok=false, trap "kotoba.kir/lower-unavailable".
;;   execute, eval-expr     REFUSAL. The interpreter (typed values, records,
;;                          variants, heap handles, kgraph, bytes, decimal,
;;                          fuel/cell/byte/frame budgets, ~1800 lines in
;;                          eval-expr alone) has no native port yet. Both answer
;;                          ok=false, trap "kotoba.kir/interpreter-unavailable".
;;
;; The refusals are VALUES, not exceptions (a Kotoba function has no raise a
;; caller can see): every consumer must test `ok` before reading `value`. A
;; `def` fold that hits one is therefore refused by name at the call site
;; ("did not evaluate"), never folded to a wrong constant.
;;
;; CONTRACT DIFFERENCES FROM THE HOST MODULE (deliberate)
;;   * results are :kotoba.kir/run {ok, value :form/r, trap, message}
;;   * `opts` maps are a :form/r map form; arities are fixed
;;     ((lower hir) (execute kir name args opts) (eval-expr form)).
;;   * `execute`'s args are a [:list :form/r], its function name a :string.
;;
;; The host behaviour of kir.cljk is untouched: nbb and the JVM never see this
;; file (extension priority across source roots picks the `.kotoba` twin only
;; on the project route).

(ns kotoba.kir
  (:require [kotoba.string :as ks])
  (:export [host-stack-exhausted? lower execute eval-expr max-fuel default-frames max-frames])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                       [:kids [:list [:ref :form/r]]]]]
             :kotoba.kir/run [:record :kotoba.kir/run
                              [[:ok :bool]
                               [:value [:ref :form/r]]
                               [:trap :string]
                               [:message :string]]]}))

;; 2^53-1: where the reference interpreter's fuel counter is still exact.
(defn max-fuel [] :i64 9007199254740991)
(defn default-frames [] :i64 32)
(defn max-frames [] :i64 9007199254740991)

(defn host-stack-exhausted? [message :string] :bool
  (or (and (ks/includes? message "call stack")
           (ks/includes? message "Maximum"))
      (ks/includes? message "too much recursion")))

(defn- nil-form [] [:ref :form/r]
  (record-new [:ref :form/r] 0 "" 0 :none (typed-list-new [:list [:ref :form/r]])))

(defn- refused [trap :string message :string] [:ref :kotoba.kir/run]
  (record-new [:ref :kotoba.kir/run] false (nil-form) trap message))

(defn lower [hir [:ref :form/r]] [:ref :kotoba.kir/run]
  (refused "kotoba.kir/lower-unavailable"
           "lowering validates through kotoba.hir and seals an oracle by running the KIR interpreter; neither has a native port yet"))

(defn execute [kir [:ref :form/r] function-name :string args [:list [:ref :form/r]] opts [:ref :form/r]] [:ref :kotoba.kir/run]
  (refused "kotoba.kir/interpreter-unavailable"
           "the KIR reference interpreter has no native port yet"))

(defn eval-expr [form [:ref :form/r]] [:ref :kotoba.kir/run]
  (refused "kotoba.kir/interpreter-unavailable"
           "the KIR reference interpreter has no native port yet"))
