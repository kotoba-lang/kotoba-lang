;; ---------------------------------------------------------------------------
;; Typed values: validated ONCE at a trust boundary, never re-walked inside.
;;
;; superproject adr-2609242100-kotoba-safety-is-language-resource-is-target-
;; profile, step P2 (2026-09-24). Until then every constructor and every call
;; re-validated the WHOLE value against `adt-node-limit` 64 / `adt-depth-limit`
;; 12, recursively: building a cons list was O(n^2), a list stopped at about
;; five cells, and with the two limits lifted this recursive walk overflowed
;; the host stack at ten and was reported as `:fuel-exhausted`.
;;
;; Now there are two entry points with two different jobs:
;;
;;   * `bounded-typed-value!` -- the BOUNDARY walk. A value that arrives from
;;     outside (an `execute` argument, a capability result, a decoded
;;     document) is checked in full, once, by an explicit-stack iterative walk
;;     (no host recursion depends on the value), against a TRAVERSAL BUDGET:
;;     `boundary-traversal-node-limit` nodes and `boundary-traversal-byte-limit`
;;     bytes of string / keyword / bytes payload (kotoba-lang lang/limits.edn
;;     :language/boundary). Exceeding either is a named trap,
;;     `:budget/boundary-nodes` or `:budget/boundary-bytes`, carried as `:trap`
;;     in the ex-data. There is no depth limit on the value any more.
;;
;;   * `shallow-typed-value!` -- the CONSTRUCTOR check, for values built inside
;;     a program the frontend and kotoba-verifier already type-checked. It
;;     checks only what the node being built owns, in O(width of that node):
;;     the tag / case exists, the arity matches, every IMMEDIATE operand has
;;     the declared tag. It never walks into an operand.
;;
;; What a constructor owns is kept in both: a typed set is sorted and
;; deduplicated, a typed map's keys are sorted and unique -- semantics, not
;; validation, and O(size of the node op) as before.
;;
;; `adt-node-limit` / `adt-depth-limit` remain, as bounds on a TYPE DESCRIPTOR
;; (`validate-value-type!`), checked statically. Per-leaf data sizes (string
;; 64 KiB, keyword 512 bytes, list width, set / map / record width) are
;; language data sizes and stay where they were.

(defn boundary-traversal-node-limit [] :i64 65536)

(defn boundary-traversal-byte-limit [] :i64 1048576)

nil

nil

nil

nil

nil

nil
