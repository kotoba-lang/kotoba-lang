(defn utf8-byte-count! [value :string] :i64
     (string-byte-length value))

(defn bounded-string!
  [value limit]
  (let [bytes (utf8-byte-count! value)]
    (when (> bytes limit)
      (throw (ex-info "string exceeds UTF-8 byte limit"
                      {:phase :value :bytes bytes :limit limit})))
    value))

(defn bytes-value? [value :bytes] :bool true)

(defn bytes-byte-count [value :bytes] :i64 (bytes-count value))

nil

;; --- bytes as a guest value; the string constructor (2026-09-25) ------------
;;
;; Superproject adr-2609242330 (amu selfhost): Kotoba had no operation that
;; builds a string from bytes or code points, and no way to build a non-empty
;; `:bytes` value at all, so a pure CBOR/UTF-8 library could read text but never
;; produce it. `:bytes` is the language's byte string -- a distinct type from
;; `:vector-i64` in every checker (a CBOR byte string and an array of small ints
;; are different values) -- and these are its reference semantics:
;;
;;   (bytes-from-vector-i64 v)  every item in [0,255], at most
;;                              `bytes-value-byte-limit` items
;;   (vector-i64-from-bytes b)  the bytes as i64 items
;;   (string-from-utf8 b)       canonical UTF-8 (RFC 3629) only; every other
;;                              byte sequence is REFUSED with a named trap,
;;                              never replaced with U+FFFD
;;
;; The classification is one function so every backend can be compared with
;; it: the ESM prelude and the native loader implement the same walk and name
;; the same first failure.

nil

nil

nil

(defn utf8-decode-canonical [value :bytes] :string (string-from-utf8 value))

nil

(defn bytes-from-items [items :vector-i64] :bytes (bytes-from-vector-i64 items))

(defn bytes-items [value :bytes] :vector-i64 (vector-i64-from-bytes value))

(defn bytes-slice-of [value :bytes start :i64 end :i64] :bytes (bytes-slice value start end))

nil


nil

nil

