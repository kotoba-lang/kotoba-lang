(defn utf8-substring! [value :string start :i64 end :i64] :string (string-substring value start end))

(defn utf8-index-of! [value :string needle :string] :i64 (string-index-of value needle))

;; --- ABI v7 text operations (2026-09-16) ------------------------------------
;;
;; Four heads the command binaries measured to need on the host side (root
;; ADR-2609160044 follow-up): `string-compare`, `string-fold-ascii`,
;; `string-find-blank`, `string-skip-blank`. Here they are the reference
;; semantics over CLJC strings, in UTF-8 byte coordinates like everything
;; above; on native they are context slots answered by the loader.

nil

(defn utf8-compare! [a :string b :string] :i64 (string-compare a b))

(defn fold-ascii! [value :string] :string (string-fold-ascii value))

nil

nil

(defn utf8-find-blank! [value :string from :i64] :i64 (string-find-blank value from))

(defn utf8-skip-blank! [value :string from :i64] :i64 (string-skip-blank value from))

;; --- ABI v8 line operations (2026-09-16) ------------------------------------
;;
;; Two heads the line-oriented commands measured to need: every line walk
;; cut a view to search from an offset (a handle per search), and sort's
;; merge and uniq cut two views per comparison. Reference semantics here,
;; in UTF-8 byte coordinates; context slots 272 / 280 on native.

nil

nil

(defn utf8-index-of-from! [value :string needle :string from :i64] :i64 (string-index-of-from value needle from))

nil

(defn utf8-compare-lines! [a :string i :i64 b :string j :i64] :i64 (string-compare-lines a i b j))

;; --- ABI v10 range operations (2026-09-16) -----------------------------------
;;
;; Two heads that take no view and mint none: a byte search from an offset
;; and a range append. Reference semantics here; context slots 336 / 344 on
;; native.

(defn utf8-find-byte! [value :string byte :i64 from :i64] :i64 (string-find-byte value byte from))

(defn utf8-append-range! [acc :string value :string start :i64 end :i64] :string (string-append-range acc value start end))

(defn utf8-code-point-at! [value :string offset :i64] :i64 (string-code-point-at value offset))

(defn bounded-keyword! [value :keyword limit :i64] :keyword
     (let [bytes (+ 1 (utf8-byte-count! (keyword-name value)))]
       (when (> bytes limit)
         (throw (ex-info "keyword exceeds UTF-8 byte limit"
                         {:phase :value :bytes bytes :limit limit})))
       value))

nil

;; JVM `str/lower` (and bare `.toLowerCase()`) fold through
;; the platform DEFAULT locale, which is not deterministic across hosts --
;; the classic case is Turkish (`tr`/`tr-TR`), where uppercase `I` folds to
;; dotless `ı`, not `i`. A safe deterministic application language cannot
;; let case-folding depend on which machine it runs on, so this always pins
;; `Locale/ROOT` on the JVM. cljs's `.toLowerCase()` (no-arg) is already
;; locale-independent Unicode simple case mapping and is the closest cljs
;; equivalent; the two are verified to agree only on the ASCII and common
;; accented-Latin ranges this primitive's conformance vectors cover, not
;; claimed to agree on the full Unicode SpecialCasing table (Turkish `İ`/`ı`,
;; German `ß`, Lithuanian dot-retention, and similar locale/context-sensitive
;; exceptions are explicitly out of scope).
(defn fold-case! [value :string] :string (string-fold-case value))

;; The mirror of `fold-case!`. The same locale determinism rules apply: the
;; JVM `str/upper` (and bare `.toUpperCase()`) folds through
;; the platform DEFAULT locale -- Turkish (`tr`/`tr-TR`) maps lowercase `i` to
;; dotted capital `İ`, not `I` -- so this always pins `Locale/ROOT` on the
;; JVM. cljs's `.toUpperCase()` (no-arg) is already locale-independent
;; Unicode simple case mapping. The two are verified to agree on the ASCII and
;; common accented-Latin ranges this primitive's conformance vectors cover;
;; the full Unicode SpecialCasing table (Turkish `İ`/`ı`, German `ß`, Greek
;; final-sigma context, Lithuanian dot-retention) is explicitly out of scope,
;; exactly as for `fold-case!`.
(defn upper-case! [value :string] :string (string-upper value))

