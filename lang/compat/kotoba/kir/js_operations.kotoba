(ns kotoba.kir.js-operations
  "Pure observations of opaque JS values. No coercion or property access."
  {:kotoba/export [nullish? truthy? strict-equal? type-of array? bool-value undefined-value]}
  )

;; The module observes opaque JS values; this guest has no JS host, so the reading is
;; the fail-closed answer (the trap is thrown; nothing is fabricated). Each body is the
;; abort itself; the declared result is the fn's contract.
(defn nullish? [value :document] :bool
  (throw (ex-info "kir.js-operations: no JS host on this guest" {:phase :host :trap :js-host-unavailable})))

(defn truthy? [value :document] :bool
  (throw (ex-info "kir.js-operations: no JS host on this guest" {:phase :host :trap :js-host-unavailable})))

(defn strict-equal? [left :document right :document] :bool
  (throw (ex-info "kir.js-operations: no JS host on this guest" {:phase :host :trap :js-host-unavailable})))

(defn type-of [value :document] :document
  (throw (ex-info "kir.js-operations: no JS host on this guest" {:phase :host :trap :js-host-unavailable})))

(defn array? [value :document] :bool
  (throw (ex-info "kir.js-operations: no JS host on this guest" {:phase :host :trap :js-host-unavailable})))

(defn bool-value [value :document] :document
  (throw (ex-info "kir.js-operations: no JS host on this guest" {:phase :host :trap :js-host-unavailable})))

(defn undefined-value [] :document
  (throw (ex-info "kir.js-operations: no JS host on this guest" {:phase :host :trap :js-host-unavailable})))
