(ns kotoba.kir.js-operations
  "Pure observations of opaque JS values. No coercion or property access."
  {:kotoba/export [nullish? truthy? strict-equal? type-of array? bool-value undefined-value]}
  )

(defn- require-js-host! []
  )

(defn nullish? [value]
  (require-js-host!)
  )

(defn truthy? [value]
  (require-js-host!)
  )

(defn strict-equal? [left right]
  (require-js-host!)
  )

(defn type-of [value]
  (require-js-host!)
  )

(defn array? [value]
  (require-js-host!)
  )

(defn bool-value [value]
  (require-js-host!)
  )

(defn undefined-value []
  (require-js-host!)
  )
