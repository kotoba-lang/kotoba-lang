(ns kotoba.kir.descriptor
  "Structural type descriptors over KIR, and their canonical byte encoding.

  Extracted from `kotoba.wasm.typed` (2026-08-04, ADR-2608049000) without
  behaviour change. Nothing here was ever wasm-specific: the encoding walks
  KIR to find which types a module uses and serialises them, and its only
  dependency was `kotoba.kir.cljs-i64` for BigInt-safe map keys. It lived in
  the wasm repo because that is where it was first needed, which is a fact
  about extraction order rather than about coupling.

  It moves to T0 because a SECOND consumer needs it. The native capability
  boundary can carry exactly four shapes today -- i64, string, option-i64,
  result-i64 -- because the loader is handed an integer `kind` rather than a
  structure, so a capability whose request is a variant with a record payload
  (`clock-v1` is one) cannot cross it at all. Fixing that means giving the
  loader a descriptor, and there must be exactly ONE encoding of a descriptor:
  two would look correct on both sides while disagreeing, which is the failure
  mode where a producer and a checker agree on the same mistake.

  `kotoba.wasm.typed` re-exports these names, so wasm callers are unchanged.

  No require: measured after extraction, the descriptor half never touched
  `kotoba.kir.cljs-i64`. Its single use is in `infer-type`, which stays with
  the wasm-specific half."
  {:kotoba/export [boolean-result-ops capability-contracts descriptor-indices descriptor-table descriptor? encode-descriptor keyword-text primitive-tags scalar-adt-aliases text-bytes uleb utf8]}
  
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :form/rd [:record :form/rd [[:form [:ref :form/r]] [:pos :i64]]]}))

(defn- form-no-forms [] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]]))

(defn- form-one-form [a [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a))

(defn- form-two-forms [a [:ref :form/r] b [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a b))

(defn- form-three-forms [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a b c))

(defn- form-append-form [xs [:list [:ref :form/r]] x [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-conj [:list [:ref :form/r]] xs x))

(defn- form-mk [t :i64 s :string n :i64 k :keyword kids [:list [:ref :form/r]]] [:ref :form/r]
     (record-new [:ref :form/r] t s n k kids 0 (bytes-empty)))

(defn- form-nil-form [] [:ref :form/r] (form-mk 0 "" 0 :none (form-no-forms)))

(defn- form-bool-form [b :bool] [:ref :form/r] (form-mk 1 "" (if b 1 0) :none (form-no-forms)))

(defn- form-int-form [n :i64] [:ref :form/r] (form-mk 2 "" n :none (form-no-forms)))

(defn- form-string-form [s :string] [:ref :form/r] (form-mk 3 s 0 :none (form-no-forms)))

(defn- form-keyword-form [k :keyword] [:ref :form/r] (form-mk 4 "" 0 k (form-no-forms)))

(defn- form-symbol-form [s :string] [:ref :form/r] (form-mk 5 s 0 :none (form-no-forms)))

(defn- form-form-seq [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 6 "" 0 :none kids))

(defn- form-form-vec [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 7 "" 0 :none kids))

(defn- form-form-set [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 8 "" 0 :none kids))

(defn- form-form-map [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 9 "" 0 :none kids))

(defn- form-tag-of [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :tag))

(defn- form-kids-of [f [:ref :form/r]] [:list [:ref :form/r]] (record-get [:ref :form/r] f :kids))

(defn- form-int-value [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :n))

(defn- form-string-value [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s))

(defn- form-symbol-value [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s))

(defn- form-keyword-value [f [:ref :form/r]] :keyword (record-get [:ref :form/r] f :k))

(defn- form-bool-value [f [:ref :form/r]] :bool (= 1 (record-get [:ref :form/r] f :n)))

(defn- form-is-nil? [f [:ref :form/r]] :bool (= 0 (form-tag-of f)))

(defn- form-is-bool? [f [:ref :form/r]] :bool (= 1 (form-tag-of f)))

(defn- form-is-int? [f [:ref :form/r]] :bool (= 2 (form-tag-of f)))

(defn- form-is-string? [f [:ref :form/r]] :bool (= 3 (form-tag-of f)))

(defn- form-is-keyword? [f [:ref :form/r]] :bool (= 4 (form-tag-of f)))

(defn- form-is-symbol? [f [:ref :form/r]] :bool (= 5 (form-tag-of f)))

(defn- form-is-seq? [f [:ref :form/r]] :bool (= 6 (form-tag-of f)))

(defn- form-is-vec? [f [:ref :form/r]] :bool (= 7 (form-tag-of f)))

(defn- form-is-set? [f [:ref :form/r]] :bool (= 8 (form-tag-of f)))

(defn- form-is-map? [f [:ref :form/r]] :bool (= 9 (form-tag-of f)))

(defn- form-is-list-like? [f [:ref :form/r]] :bool (or (= 6 (form-tag-of f)) (= 7 (form-tag-of f))))

(defn- form-is-true? [f [:ref :form/r]] :bool (and (= 1 (form-tag-of f)) (= 1 (record-get [:ref :form/r] f :n))))

(defn- form-count-of [f [:ref :form/r]] :i64 (vector-count (form-kids-of f)))

(defn- form-nth-of [f [:ref :form/r] i :i64] [:ref :form/r]
     (if (and (>= i 0) (< i (form-count-of f)))
       (typed-list-nth [:list [:ref :form/r]] (form-kids-of f) i)
       (form-nil-form)))

(defn- form-first-of [f [:ref :form/r]] [:ref :form/r] (form-nth-of f 0))

(defn- form-lookup-from [kids [:list [:ref :form/r]] key [:ref :form/r] i :i64] [:ref :form/r]
     (let [n (vector-count kids)]
       (loop [j i]
         (if (>= (+ j 1) n)
           (form-nil-form)
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] kids j) key)
             (typed-list-nth [:list [:ref :form/r]] kids (+ j 1))
             (recur (+ j 2)))))))

(defn- form-form-get [m [:ref :form/r] key [:ref :form/r]] [:ref :form/r]
     (form-lookup-from (form-kids-of m) key 0))

(defn- form-lookup-has [kids [:list [:ref :form/r]] key [:ref :form/r]] :bool
     (let [n (vector-count kids)]
       (loop [j 0]
         (if (>= (+ j 1) n)
           false
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] kids j) key)
             true
             (recur (+ j 2)))))))

(defn- form-form-has? [m [:ref :form/r] key [:ref :form/r]] :bool
     (form-lookup-has (form-kids-of m) key))

(defn- form-member? [xs [:list [:ref :form/r]] x [:ref :form/r]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n) false
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] xs i) x) true (recur (inc i)))))))

(defn- form-ordered-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [i 0]
           (if (>= i n) true
             (if (form-eq (typed-list-nth [:list [:ref :form/r]] xs i) (typed-list-nth [:list [:ref :form/r]] ys i))
               (recur (inc i))
               false)))
         false)))

(defn- form-set-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [i 0]
           (if (>= i n) true
             (if (form-member? ys (typed-list-nth [:list [:ref :form/r]] xs i)) (recur (inc i)) false)))
         false)))

(defn- form-map-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [j 0]
           (if (>= (+ j 1) n) true
             (let [k (typed-list-nth [:list [:ref :form/r]] xs j)]
               (if (and (form-lookup-has ys k)
                        (form-eq (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)) (form-lookup-from ys k 0)))
                 (recur (+ j 2))
                 false))))
         false)))

(defn- form-eq
     "Structural equality, as `=` on the host's data: a list and a vector are
     different kinds here (as are they to the reader), sets and maps compare
     without order."
     [a [:ref :form/r] b [:ref :form/r]] :bool
     (let [t (form-tag-of a)]
       (and (= t (form-tag-of b))
            (cond
              (= t 0) true
              (= t 1) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
              (= t 2) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
              (= t 3) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
              (= t 4) (= (record-get [:ref :form/r] a :k) (record-get [:ref :form/r] b :k))
              (= t 5) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
              (= t 8) (form-set-eq (form-kids-of a) (form-kids-of b))
              (= t 9) (form-map-eq (form-kids-of a) (form-kids-of b))
              :else (form-ordered-eq (form-kids-of a) (form-kids-of b))))))

(defn- form-rest-list
     "The kids of F after the first, as a list."
     [f [:ref :form/r]] [:list [:ref :form/r]]
     (let [xs (form-kids-of f)
           n (vector-count xs)]
       (loop [i 1 acc (form-no-forms)]
         (if (>= i n)
           acc
           (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs i)))))))

(defn- form-last-of [f [:ref :form/r]] [:ref :form/r]
     (form-nth-of f (dec (form-count-of f))))

(defn- form-cons-onto [x [:ref :form/r] xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count xs)]
       (loop [i 0 acc (form-one-form x)]
         (if (>= i n)
           acc
           (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs i)))))))

(defn- form-assoc-form
     "Map M with K bound to V: the first entry whose key is K keeps its place and
     takes V, else K V are appended (as `assoc` on the host's map)."
     [m [:ref :form/r] k [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
     (let [xs (form-kids-of m)
           n (vector-count xs)]
       (if (form-lookup-has xs k)
         (form-form-map
          (loop [j 0 acc (form-no-forms)]
            (if (>= (+ j 1) n)
              acc
              (let [key (typed-list-nth [:list [:ref :form/r]] xs j)]
                (recur (+ j 2)
                       (typed-list-conj [:list [:ref :form/r]]
                                        (typed-list-conj [:list [:ref :form/r]] acc key)
                                        (if (form-eq key k) v (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)))))))))
         (form-form-map (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] xs k) v)))))

(defn- form-call0 [name :string] [:ref :form/r] (form-form-seq (form-one-form (form-symbol-form name))))

(defn- form-call1 [name :string a [:ref :form/r]] [:ref :form/r]
     (form-form-seq (form-two-forms (form-symbol-form name) a)))

(defn- form-call2 [name :string a [:ref :form/r] b [:ref :form/r]] [:ref :form/r]
     (form-form-seq (form-three-forms (form-symbol-form name) a b)))

(defn- form-call3 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c)))

(defn- form-call4 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c) d)))

(defn- form-call5 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c) d) e)))

(defn- form-call6 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r] f [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c) d) e) f)))

(defn- form-vec2 [a [:ref :form/r] b [:ref :form/r]] [:ref :form/r] (form-form-vec (form-two-forms a b)))

(defn- form-vec3 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:ref :form/r] (form-form-vec (form-three-forms a b c)))

(defn- form-vec4 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r]] [:ref :form/r]
     (form-form-vec (typed-list-conj [:list [:ref :form/r]] (form-three-forms a b c) d)))

(defn- form-vec5 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r]] [:ref :form/r]
     (form-form-vec (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms a b c) d) e)))

(defn- form-vec6 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r] f [:ref :form/r]] [:ref :form/r]
     (form-form-vec (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms a b c) d) e) f)))

(defn- form-doc-at [d :document i :i64] :document
     (option-value-of [:option :document] (document-vector-at d i) (document-null)))

(defn- form-doc-list-at [d :document i :i64] :document
     (option-value-of [:option :document] (document-list-at d i) (document-null)))

(defn- form-doc-entry-at [d :document i :i64] :document
     (option-value-of [:option :document] (document-map-entry-at d i) (document-null)))

(defn- form-doc-items [d :document list? :bool] [:list [:ref :form/r]]
     (let [n (document-count d)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n)
           acc
           (recur (inc i)
                  (typed-list-conj [:list [:ref :form/r]] acc
                                   (form-from-document (if list? (form-doc-list-at d i) (form-doc-at d i)))))))))

(defn- form-doc-map-items [d :document] [:list [:ref :form/r]]
     (let [n (document-count d)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n)
           acc
           (let [e (form-doc-entry-at d i)]
             (recur (inc i)
                    (typed-list-conj [:list [:ref :form/r]]
                                     (typed-list-conj [:list [:ref :form/r]] acc (form-from-document (form-doc-at e 0)))
                                     (form-from-document (form-doc-at e 1)))))))))

(defn- form-set-marker? [d :document] :bool
     (and (> (document-count d) 0)
          (= (document-kind (form-doc-at d 0)) :keyword)
          (= (option-value-of [:option :keyword] (document-keyword-value (form-doc-at d 0)) :none) :kotoba.form/set)))

(defn- form-doc-set-items [d :document] [:list [:ref :form/r]]
     (let [n (document-count d)]
       (loop [i 1 acc (form-no-forms)]
         (if (>= i n)
           acc
           (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (form-from-document (form-doc-at d i))))))))

(defn- form-from-document [d :document] [:ref :form/r]
     (let [kind (document-kind d)]
       (cond
         (= kind :bool) (form-bool-form (option-value-of [:option :bool] (document-bool-value d) false))
         (= kind :i64) (form-int-form (option-value-of [:option :i64] (document-i64-value d) 0))
         (= kind :string) (form-string-form (option-value-of [:option :string] (document-string-value d) ""))
         (= kind :keyword) (form-keyword-form (option-value-of [:option :keyword] (document-keyword-value d) :none))
         (= kind :vector) (if (form-set-marker? d) (form-form-set (form-doc-set-items d)) (form-form-vec (form-doc-items d false)))
         (= kind :list) (form-form-seq (form-doc-items d true))
         (= kind :set) (form-form-set (form-doc-items d false))
         (= kind :map) (form-form-map (form-doc-map-items d))
         :else (form-nil-form))))

(defn- form-keyword-has-namespace? [f [:ref :form/r]] :bool
     (and (= 4 (form-tag-of f))
          (>= (string-find-byte (document-edn-print (document-keyword (record-get [:ref :form/r] f :k))) 47 0) 0)))

(defn- form-keys-of [m [:ref :form/r]] [:ref :form/r]
     (let [xs (form-kids-of m)
           n (vector-count xs)]
       (form-form-set
        (loop [j 0 acc (form-no-forms)]
          (if (>= j n)
            acc
            (recur (+ j 2) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs j))))))))

(defn- form-dissoc-form
     "Map M without K (as `dissoc` on the host's map)."
     [m [:ref :form/r] k [:ref :form/r]] [:ref :form/r]
     (let [xs (form-kids-of m)
           n (vector-count xs)]
       (form-form-map
        (loop [j 0 acc (form-no-forms)]
          (if (>= (+ j 1) n)
            acc
            (let [key (typed-list-nth [:list [:ref :form/r]] xs j)]
              (recur (+ j 2)
                     (if (form-eq key k)
                       acc
                       (typed-list-conj [:list [:ref :form/r]]
                                        (typed-list-conj [:list [:ref :form/r]] acc key)
                                        (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)))))))))))

(defn- form-append-many [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count ys)]
       (loop [i 0 acc xs]
         (if (>= i n) acc (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] ys i)))))))

(defn- form-rd [f [:ref :form/r] pos :i64] [:ref :form/rd]
     (record-new [:ref :form/rd] f pos))

(defn- form-rd-form [r [:ref :form/rd]] [:ref :form/r] (record-get [:ref :form/rd] r :form))

(defn- form-rd-pos [r [:ref :form/rd]] :i64 (record-get [:ref :form/rd] r :pos))

(defn- form-rd-fail [] :i64 (vector-at (vector-i64) 0))

(defn- form-rd-width [c :i64] :i64
     (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4))

(defn- form-rd-space? [c :i64] :bool
     (or (= c 32) (= c 10) (= c 13) (= c 9) (= c 44)))

(defn- form-rd-delimiter? [c :i64] :bool
     (or (form-rd-space? c) (= c 40) (= c 41) (= c 91) (= c 93) (= c 123) (= c 125) (= c 34) (= c 59)))

(defn- form-rd-line-end [s :string i :i64 n :i64] :i64
     (loop [i i]
       (if (or (>= i n) (= 10 (string-code-point-at s i))) i (recur (+ i (form-rd-width (string-code-point-at s i)))))))

(defn- form-rd-skip [s :string i :i64] :i64
     (let [n (string-byte-length s)]
       (loop [i i]
         (if (>= i n)
           i
           (let [c (string-code-point-at s i)]
             (cond (form-rd-space? c) (recur (inc i))
                   (= c 59) (recur (form-rd-line-end s i n))
                   :else i))))))

(defn- form-rd-token-end [s :string i :i64 n :i64] :i64
     (loop [i i]
       (if (>= i n)
         i
         (let [c (string-code-point-at s i)]
           (if (form-rd-delimiter? c) i (recur (+ i (form-rd-width c))))))))

(defn- form-rd-digit? [c :i64] :bool (and (>= c 48) (<= c 57)))

(defn- form-rd-decimal [s :string i :i64 e :i64] :i64
     (loop [j i v 0]
       (if (>= j e)
         v
         (let [c (string-code-point-at s j)]
           (if (form-rd-digit? c) (recur (inc j) (+ (* v 10) (- c 48))) (form-rd-fail))))))

(defn- form-rd-number? [s :string i :i64 e :i64] :bool
     (let [c (string-code-point-at s i)]
       (or (form-rd-digit? c)
           (and (= c 45) (> (- e i) 1) (form-rd-digit? (string-code-point-at s (inc i)))))))

(defn- form-rd-atom [s :string i :i64] [:ref :form/rd]
     (let [n (string-byte-length s)
           e (form-rd-token-end s i n)
           token (string-substring s i e)
           c (string-code-point-at s i)]
       (cond
         (= e i) (form-rd (form-nil-form) (form-rd-fail))
         (= c 58) (form-rd (form-keyword-form (keyword-from-string (string-substring s (inc i) e))) e)
         (string=? token "nil") (form-rd (form-nil-form) e)
         (string=? token "true") (form-rd (form-bool-form true) e)
         (string=? token "false") (form-rd (form-bool-form false) e)
         (form-rd-number? s i e)
         (form-rd (form-int-form (if (= c 45) (- 0 (form-rd-decimal s (inc i) e)) (form-rd-decimal s i e))) e)
         :else (form-rd (form-symbol-form token) e))))

(defn- form-rd-string-end [s :string i :i64] :i64
     (let [n (string-byte-length s)]
       (loop [j (inc i)]
         (if (>= j n)
           (form-rd-fail)
           (let [c (string-code-point-at s j)]
             (cond (= c 34) (inc j)
                   (= c 92) (recur (+ j 2))
                   :else (recur (+ j (form-rd-width c)))))))))

(defn- form-rd-string [s :string i :i64] [:ref :form/rd]
     (let [e (form-rd-string-end s i)
           d (document-edn-read (string-substring s i e))]
       (form-rd (form-string-form (option-value-of [:option :string] (document-string-value d) "")) e)))

(defn- form-rd-items [s :string i :i64 close :i64] [:ref :form/rd]
     (let [n (string-byte-length s)]
       (loop [j (form-rd-skip s i) acc (form-no-forms)]
         (if (>= j n)
           (form-rd (form-nil-form) (form-rd-fail))
           (if (= close (string-code-point-at s j))
             (form-rd (form-form-vec acc) (inc j))
             (let [r (form-rd-value s j)]
               (recur (form-rd-skip s (form-rd-pos r)) (typed-list-conj [:list [:ref :form/r]] acc (form-rd-form r)))))))))

(defn- form-rd-value [s :string i :i64] [:ref :form/rd]
     (let [n (string-byte-length s)
           j (form-rd-skip s i)]
       (if (>= j n)
         (form-rd (form-nil-form) (form-rd-fail))
         (let [c (string-code-point-at s j)]
           (cond
             (= c 40) (let [r (form-rd-items s (inc j) 41)] (form-rd (form-form-seq (form-kids-of (form-rd-form r))) (form-rd-pos r)))
             (= c 91) (form-rd-items s (inc j) 93)
             (= c 123) (let [r (form-rd-items s (inc j) 125)] (form-rd (form-form-map (form-kids-of (form-rd-form r))) (form-rd-pos r)))
             (and (= c 35) (< (inc j) n) (= 123 (string-code-point-at s (inc j))))
             (let [r (form-rd-items s (+ j 2) 125)] (form-rd (form-form-set (form-kids-of (form-rd-form r))) (form-rd-pos r)))
             (= c 39) (let [r (form-rd-value s (inc j))] (form-rd (form-call1 "quote" (form-rd-form r)) (form-rd-pos r)))
             (= c 34) (form-rd-string s j)
             :else (form-rd-atom s j))))))

(defn- form-edn-form
     "The one form in TEXT."
     [text :string] [:ref :form/r]
     (form-rd-form (form-rd-value text 0)))



(defn primitive-tags [] [:ref :form/r]
     (form-edn-form "{:i64 0 :string 1 :keyword 2 :bool 3 :symbol 19 :vector-i64 11 :f64 12 :f32 13 :vector-f64 14 :string-index 16 :disjoint-set-i64 17 :document 18 :bytes 21}"))



(defn scalar-adt-aliases [] [:ref :form/r]
     (form-edn-form "{:option-i64 [:option :i64] :result-i64 [:result :i64 :i64]}"))



(defn boolean-result-ops [] [:ref :form/r]
     (form-edn-form "#{f64-eq f64-lt f64-le f64-gt f64-ge f64-unordered f32-eq f32-lt f32-le f32-gt f32-ge f32-unordered bool-not option-some? result-ok? option-some?-of result-ok?-of typed-set-contains typed-map-contains document-contains document-equal?}"))




(defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r] (form-form-get m (form-keyword-form k)))

(defn- member? [x [:ref :form/r] xs [:ref :form/r]] :bool
     (let [n (form-count-of xs)]
       (loop [i 0]
         (if (>= i n) false (if (form-eq (form-nth-of xs i) x) true (recur (inc i)))))))

(defn- sym-is? [f [:ref :form/r] name :string] :bool
     (and (form-is-symbol? f) (string=? (form-symbol-value f) name)))

(defn- kw-in? [f [:ref :form/r] text :string] :bool
     (and (form-is-keyword? f) (member? f (form-edn-form text))))

(defn- sym-in? [f [:ref :form/r] text :string] :bool
     (and (form-is-symbol? f) (member? f (form-edn-form text))))

(defn descriptor? [value [:ref :form/r]] :bool
     (or (and (form-is-keyword? value)
              (or (form-form-has? (primitive-tags) value) (form-form-has? (scalar-adt-aliases) value)))
         (and (form-is-vec? value)
              (or (form-eq (form-first-of value) (form-keyword-form :list))
                  (kw-in? (form-first-of value) "[:option :result :variant :vector :set :map :record :ref]")))))



(defn- host-integer [n :i64] :i64 n)



(defn uleb [n :i64] :vector-i64
     (loop [n n out (vector-i64)]
       (let [byte (bit-and n 127)
             remaining (i64-shift-right n 7)]
         (if (= remaining 0)
           (vector-conj out byte)
           (recur remaining (vector-conj out (bit-or byte 128)))))))



(defn- bytes-append [a :vector-i64 b :vector-i64] :vector-i64
     (let [n (vector-count b)]
       (loop [acc a i 0]
         (if (>= i n) acc (recur (vector-conj acc (vector-at b i)) (inc i))))))

(defn- utf8-code-point [out :vector-i64 cp :i64] :vector-i64
     (cond
       (< cp 128) (vector-conj out cp)
       (< cp 2048) (vector-conj (vector-conj out (+ 192 (quot cp 64))) (+ 128 (bit-and cp 63)))
       (< cp 65536) (vector-conj (vector-conj (vector-conj out (+ 224 (quot cp 4096)))
                                              (+ 128 (bit-and (quot cp 64) 63)))
                                 (+ 128 (bit-and cp 63)))
       :else (vector-conj (vector-conj (vector-conj (vector-conj out (+ 240 (quot cp 262144)))
                                                    (+ 128 (bit-and (quot cp 4096) 63)))
                                       (+ 128 (bit-and (quot cp 64) 63)))
                          (+ 128 (bit-and cp 63)))))



(defn utf8 [text :string] :vector-i64
     (let [n (string-byte-length text)]
       (loop [i 0 out (vector-i64)]
         (if (< i n)
           (let [cp (string-code-point-at text i)]
             (recur (+ i (cond (< cp 128) 1 (< cp 2048) 2 (< cp 65536) 3 :else 4))
                    (utf8-code-point out cp)))
           out))))



(defn text-bytes [text :string] :vector-i64
     (let [bytes (utf8 text)]
       (bytes-append (uleb (vector-count bytes)) bytes)))



(defn keyword-text [value :keyword] :string
     (document-edn-print (document-keyword value)))



(defn- bad? [v :vector-i64] :bool
     (and (> (vector-count v) 0) (= -1 (vector-at v 0))))

(defn- failed [] :vector-i64 (vector-i64 -1))

(defn- kw-text [f [:ref :form/r]] :string
     (document-edn-print (document-keyword (form-keyword-value f))))

(defn- encode-all [prefix :vector-i64 descs [:list [:ref :form/r]]] :vector-i64
     (let [n (vector-count descs)]
       (loop [i 0 out prefix]
         (if (>= i n)
           out
           (let [e (encode (typed-list-nth [:list [:ref :form/r]] descs i))]
             (if (bad? e) e (recur (inc i) (bytes-append out e))))))))



(defn- encode-members [members [:ref :form/r]] :vector-i64
     (let [n (form-count-of members)]
       (loop [i 0 out (uleb n)]
         (if (>= i n)
           out
           (let [m (form-nth-of members i)
                 e (encode (form-nth-of m 1))]
             (if (bad? e)
               e
               (recur (inc i) (bytes-append (bytes-append out (text-bytes (kw-text (form-nth-of m 0)))) e))))))))



(defn- encode-with [tag :i64 rest-bytes :vector-i64] :vector-i64
     (if (bad? rest-bytes) rest-bytes (bytes-append (vector-i64 tag) rest-bytes)))

(defn- encode-pair [tag :i64 d1 [:ref :form/r] d2 [:ref :form/r]] :vector-i64
     (let [a (encode d1)]
       (if (bad? a)
         a
         (let [b (encode d2)]
           (if (bad? b) b (bytes-append (vector-i64 tag) (bytes-append a b)))))))

(defn- encode [d [:ref :form/r]] :vector-i64
     (cond
       (form-form-has? (scalar-adt-aliases) d) (encode (form-form-get (scalar-adt-aliases) d))
       (form-form-has? (primitive-tags) d) (vector-i64 (form-int-value (form-form-get (primitive-tags) d)))
       (not (form-is-vec? d)) (failed)
       :else
       (let [head (form-first-of d)]
         (cond
           (form-eq head (form-keyword-form :option)) (encode-with 4 (encode (form-nth-of d 1)))
           (form-eq head (form-keyword-form :result)) (encode-pair 5 (form-nth-of d 1) (form-nth-of d 2))
           (form-eq head (form-keyword-form :variant))
           (encode-with 6 (let [m (encode-members (form-nth-of d 2))]
                            (if (bad? m) m (bytes-append (text-bytes (kw-text (form-nth-of d 1))) m))))
           (form-eq head (form-keyword-form :vector))
           (let [items (form-nth-of d 1)]
             (encode-with 7 (encode-all (uleb (form-count-of items)) (form-kids-of items))))
           (form-eq head (form-keyword-form :set)) (encode-with 8 (encode (form-nth-of d 1)))
           (form-eq head (form-keyword-form :list)) (encode-with 20 (encode (form-nth-of d 1)))
           (form-eq head (form-keyword-form :map)) (encode-pair 10 (form-nth-of d 1) (form-nth-of d 2))
           (form-eq head (form-keyword-form :record))
           (encode-with 9 (let [m (encode-members (form-nth-of d 2))]
                            (if (bad? m) m (bytes-append (text-bytes (kw-text (form-nth-of d 1))) m))))
           (form-eq head (form-keyword-form :ref))
           (bytes-append (vector-i64 15) (text-bytes (kw-text (form-nth-of d 1))))
           :else (failed)))))

(defn encode-descriptor
     "The canonical byte encoding of a descriptor; aborts on one the encoder does
     not know."
     [descriptor [:ref :form/r]] :vector-i64
     (let [e (encode descriptor)]
       (if (bad? e)
         (do (throw (ex-info "unsupported typed descriptor" {:phase :kir-descriptor :problem :unsupported-descriptor})) e)
         e)))



(defn- add-found [found [:ref :form/r] x [:ref :form/r]] [:ref :form/r]
     (if (member? x found) found (form-form-vec (form-append-form (form-kids-of found) x))))

(defn- add-kw [found [:ref :form/r] k :keyword] [:ref :form/r] (add-found found (form-keyword-form k)))

(defn- walk-each [xs [:list [:ref :form/r]] found [:ref :form/r]] [:ref :form/r]
     (let [n (vector-count xs)]
       (loop [i 0 f found]
         (if (>= i n) f (recur (inc i) (walk (typed-list-nth [:list [:ref :form/r]] xs i) f))))))

(defn- walk-pair-types [pairs [:ref :form/r] found [:ref :form/r]] [:ref :form/r]
     (let [n (form-count-of pairs)]
       (loop [i 0 f found]
         (if (>= i n) f (recur (inc i) (walk (form-nth-of (form-nth-of pairs i) 1) f))))))

(defn- walk-descriptor [value [:ref :form/r] found [:ref :form/r]] [:ref :form/r]
     (let [found (add-found found value)]
       (if (not (form-is-vec? value))
         found
         (let [head (form-first-of value)]
           (cond
             (form-eq head (form-keyword-form :option)) (walk (form-nth-of value 1) found)
             (form-eq head (form-keyword-form :result)) (walk (form-nth-of value 2) (walk (form-nth-of value 1) found))
             (form-eq head (form-keyword-form :variant)) (walk-pair-types (form-nth-of value 2) found)
             (form-eq head (form-keyword-form :vector)) (walk-each (form-kids-of (form-nth-of value 1)) found)
             (form-eq head (form-keyword-form :set)) (walk (form-nth-of value 1) found)
             (form-eq head (form-keyword-form :list)) (walk (form-nth-of value 1) found)
             (form-eq head (form-keyword-form :map)) (walk (form-nth-of value 2) (walk (form-nth-of value 1) found))
             (form-eq head (form-keyword-form :record)) (walk-pair-types (form-nth-of value 2) found)
             :else found)))))

(defn- head-in? [value [:ref :form/r] text :string] :bool
     (and (form-is-seq? value) (sym-in? (form-first-of value) text)))

(defn- map-values [m [:ref :form/r]] [:list [:ref :form/r]]
     (let [xs (form-kids-of m)
           n (vector-count xs)]
       (loop [j 1 acc (form-no-forms)]
         (if (>= j n) acc (recur (+ j 2) (form-append-form acc (typed-list-nth [:list [:ref :form/r]] xs j)))))))

(defn- walk [value [:ref :form/r] found [:ref :form/r]] [:ref :form/r]
     (cond
       (descriptor? value) (walk-descriptor value found)
       (head-in? value "[f64-eq f64-lt f64-le f64-gt f64-ge f64-unordered f32-eq f32-lt f32-le f32-gt f32-ge f32-unordered bool-not option-some? result-ok? option-some?-of result-ok?-of typed-set-contains typed-map-contains document-contains document-equal?]")
       (walk-each (form-kids-of value) (add-kw found :bool))
       (head-in? value "[option-some option-none option-some? option-value]")
       (walk-each (form-kids-of value) (add-kw found :option-i64))
       (head-in? value "[result-ok result-err result-ok? result-value result-error]")
       (walk-each (form-kids-of value) (add-kw found :result-i64))
       (head-in? value "[vector-new vector-count vector-get vector-at vector-drop vector-take vector-assoc vector-conj]")
       (walk-each (form-kids-of value) (add-kw found :vector-i64))
       (head-in? value "[vector-f64-new vector-f64-count vector-f64-get vector-f64-at vector-f64-drop vector-f64-take vector-f64-assoc vector-f64-conj]")
       (walk-each (form-kids-of value) (add-kw found :vector-f64))
       (head-in? value "[string-index-new string-index-count string-index-contains string-index-get string-index-assoc]")
       (walk-each (form-kids-of value) (add-kw found :string-index))
       (head-in? value "[disjoint-set-i64-new disjoint-set-i64-count disjoint-set-i64-union]")
       (walk-each (form-kids-of value) (add-kw found :disjoint-set-i64))
       (head-in? value "[document-null document-bool document-i64 document-f64 document-string document-keyword document-symbol document-vector document-list document-set document-map document-count document-kind document-vector-at document-list-at document-map-entry-at document-vector-assoc document-vector-conj document-vector-drop document-vector-remove document-equal? document-set-contains? document-sha256 document-print document-read document-edn-print document-edn-read document-contains document-get document-assoc document-dissoc document-merge document-string-value document-keyword-value document-symbol-value document-bool-value document-i64-value document-f64-value document-bytes document-bytes-value document-link document-link-value]")
       (let [f1 (add-kw found :document)
             f2 (if (sym-is? (form-first-of value) "document-kind") (add-kw f1 :keyword) f1)
             f3 (if (sym-is? (form-first-of value) "document-sha256") (add-kw f2 :string) f2)
             f4 (if (or (sym-is? (form-first-of value) "document-print") (sym-is? (form-first-of value) "document-edn-print")) (add-kw f3 :string) f3)
             f5 (if (or (sym-is? (form-first-of value) "document-bytes-value") (sym-is? (form-first-of value) "document-link-value")) (add-kw f4 :bytes) f4)]
         (walk-each (form-kids-of value) f5))
       (head-in? value "[keyword-from-string]") (walk-each (form-kids-of value) (add-kw found :keyword))
       (head-in? value "[symbol]") (walk-each (form-kids-of value) (add-kw found :symbol))
       (head-in? value "[bytes-empty]") (add-kw found :bytes)
       (head-in? value "[bytes-count bytes-at bytes-slice bytes-concat]")
       (walk-each (form-kids-of value) (add-kw found :bytes))
       (head-in? value "[bytes-from-vector-i64 vector-i64-from-bytes]")
       (walk-each (form-kids-of value) (add-kw (add-kw found :bytes) :vector-i64))
       (head-in? value "[string-from-utf8]")
       (walk-each (form-kids-of value) (add-kw (add-kw found :bytes) :string))
       (form-is-map? value) (walk-each (map-values value) found)
       (or (form-is-seq? value) (form-is-vec? value) (form-is-set? value)) (walk-each (form-kids-of value) found)
       (form-is-string? value) (add-kw found :string)
       (form-is-keyword? value) (add-kw found :keyword)
       (form-is-bool? value) (add-kw found :bool)
       :else found))



(defn- pr-join [open :string items [:list [:ref :form/r]] close :string] :string
     (let [n (vector-count items)]
       (loop [i 0 acc open]
         (if (>= i n)
           (string-concat acc close)
           (recur (inc i)
                  (string-concat (if (= i 0) acc (string-concat acc " ")) (pr-form (typed-list-nth [:list [:ref :form/r]] items i))))))))

(defn- pr-form [f [:ref :form/r]] :string
     (cond
       (form-is-nil? f) "nil"
       (form-is-bool? f) (if (form-bool-value f) "true" "false")
       (form-is-int? f) (string-from-i64 (form-int-value f))
       (form-is-string? f) (document-edn-print (document-string (form-string-value f)))
       (form-is-keyword? f) (kw-text f)
       (form-is-symbol? f) (form-symbol-value f)
       (form-is-seq? f) (pr-join "(" (form-kids-of f) ")")
       (form-is-vec? f) (pr-join "[" (form-kids-of f) "]")
       (form-is-set? f) (pr-join "#{" (form-kids-of f) "}")
       :else (pr-join "{" (form-kids-of f) "}")))

(defn- insert-at [xs [:list [:ref :form/r]] p :i64 x [:ref :form/r]] [:list [:ref :form/r]]
     (let [n (vector-count xs)]
       (loop [i 0 acc (form-no-forms)]
         (if (> i n)
           acc
           (recur (inc i)
                  (let [with-x (if (= i p) (form-append-form acc x) acc)]
                    (if (< i n) (form-append-form with-x (typed-list-nth [:list [:ref :form/r]] xs i)) with-x)))))))

(defn- sort-position [sorted [:list [:ref :form/r]] key :string] :i64
     (let [n (vector-count sorted)]
       (loop [i 0]
         (if (or (>= i n) (> (string-compare (pr-form (typed-list-nth [:list [:ref :form/r]] sorted i)) key) 0))
           i
           (recur (inc i))))))

(defn- sort-by-print [xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count xs)]
       (loop [i 0 sorted (form-no-forms)]
         (if (>= i n)
           sorted
           (let [x (typed-list-nth [:list [:ref :form/r]] xs i)]
             (recur (inc i) (insert-at sorted (sort-position sorted (pr-form x)) x)))))))

(defn descriptor-table [kir [:ref :form/r]] [:ref :form/r]
     (form-form-vec (sort-by-print (form-kids-of (walk kir (form-form-vec (form-no-forms)))))))



(defn descriptor-indices [kir [:ref :form/r]] [:ref :form/r]
     (let [table (form-kids-of (descriptor-table kir))
           n (vector-count table)]
       (loop [i 0 m (form-form-map (form-no-forms))]
         (if (>= i n)
           m
           (recur (inc i) (form-assoc-form m (typed-list-nth [:list [:ref :form/r]] table i) (form-int-form i)))))))



;; A capability id is an i64 KIR value, so on ClojureScript it is a JS
;; BigInt -- and cljs.core can do neither of the two things a collection does
;; with a value it is asked to deduplicate, order, or group by:
;;
;;   (hash    (js/BigInt 7))              throws "Cannot create property
;;                                        'closure_uid_...' on bigint '7'"
;;   (compare (js/BigInt 7) (js/BigInt 23)) throws "Cannot compare 23 to 7"
;;
;; `capability-contracts` reached both. Measured 2026-09-09 under nbb:
;;
;;   step      threw at            because
;;   distinct  9 distinct ids      a set of 8 or fewer is a linear array set;
;;                                 past that it hashes
;;   sort-by   the SECOND contract `compare` on the `juxt` vector's first slot
;;   group-by  9 distinct ids      same array-map/hash-map threshold
;;
;; The middle one is the one that fired in practice, and it fired at TWO
;; capabilities: `amu compile --target wasm32-browser` answered `internal
;; compiler error` (exit 70) for every module declaring two or more
;; capabilities, while the same module compiled and ran on aarch64-macos --
;; the native path never builds this table.
;;
;; The narrowing is `host-integer`, the same exact, fail-closed conversion
;; `uleb` already applies to this very id one call later, so nothing new is
;; assumed about the value. Only the KEYS are narrowed; `:id` itself is
;; carried through untouched, because it is a KIR value and the encoder
;; downstream is entitled to see the value it was given.

(defn- contract-id [c [:ref :form/r]] :i64 (let [i (fget c :id)] (if (form-is-int? i) (form-int-value i) 0)))



(defn- same-identity? [a [:ref :form/r] b [:ref :form/r]] :bool
     (and (= (contract-id a) (contract-id b))
          (form-eq (fget a :request-type) (fget b :request-type))
          (form-eq (fget a :result-type) (fget b :result-type))))



(defn- contract-compare [a [:ref :form/r] b [:ref :form/r]] :i64
     (let [ia (contract-id a) ib (contract-id b)]
       (cond (< ia ib) -1
             (> ia ib) 1
             :else (let [c1 (string-compare (pr-form (fget a :request-type)) (pr-form (fget b :request-type)))]
                     (if (= c1 0)
                       (string-compare (pr-form (fget a :result-type)) (pr-form (fget b :result-type)))
                       c1)))))



(defn- distinct-contracts [xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count xs)]
       (loop [i 0 out (form-no-forms)]
         (if (>= i n)
           out
           (let [c (typed-list-nth [:list [:ref :form/r]] xs i)
                 m (vector-count out)
                 seen (loop [j 0]
                        (if (>= j m) false (if (same-identity? (typed-list-nth [:list [:ref :form/r]] out j) c) true (recur (inc j)))))]
             (recur (inc i) (if seen out (form-append-form out c))))))))

(defn- sort-contracts [xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count xs)]
       (loop [i 0 sorted (form-no-forms)]
         (if (>= i n)
           sorted
           (let [x (typed-list-nth [:list [:ref :form/r]] xs i)
                 m (vector-count sorted)
                 p (loop [j 0]
                     (if (or (>= j m) (> (contract-compare (typed-list-nth [:list [:ref :form/r]] sorted j) x) 0)) j (recur (inc j))))]
             (recur (inc i) (insert-at sorted p x)))))))



(defn- collect-kids [xs [:list [:ref :form/r]] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count xs)]
       (loop [i 0 a acc]
         (if (>= i n) a (recur (inc i) (collect-caps (typed-list-nth [:list [:ref :form/r]] xs i) a))))))

(defn- collect-caps [f [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [acc (if (and (form-is-seq? f) (sym-is? (form-first-of f) "typed-cap-call"))
                 (form-append-form acc
                                   (form-assoc-form
                                    (form-assoc-form
                                     (form-assoc-form (form-form-map (form-no-forms)) (form-keyword-form :id) (form-nth-of f 1))
                                     (form-keyword-form :request-type) (form-nth-of f 2))
                                    (form-keyword-form :result-type) (form-nth-of f 3)))
                 acc)]
       (if (or (form-is-seq? f) (form-is-vec? f) (form-is-set? f) (form-is-map? f))
         (collect-kids (form-kids-of f) acc)
         acc)))

(defn- functions-caps [functions [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count functions)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n) acc (recur (inc i) (collect-caps (fget (typed-list-nth [:list [:ref :form/r]] functions i) :body) acc))))))

(defn- conflicting-ids? [xs [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n) false
           (if (loop [j (inc i)]
                 (if (>= j n) true
                   (if (= (contract-id (typed-list-nth [:list [:ref :form/r]] xs i)) (contract-id (typed-list-nth [:list [:ref :form/r]] xs j))) false (recur (inc j)))))
             (recur (inc i))
             true)))))

(defn capability-contracts
     "Returns the sealed typed capability contracts used by KIR. One capability
     id has exactly one request/result contract per module."
     [kir [:ref :form/r]] [:ref :form/r]
     (let [contracts (sort-contracts (distinct-contracts (functions-caps (form-kids-of (fget kir :functions)))))]
       (if (conflicting-ids? contracts)
         (throw (ex-info "typed capability id has conflicting contracts"
                         {:phase :kir-descriptor :problem :conflicting-contracts}))
         (form-form-vec contracts))))
