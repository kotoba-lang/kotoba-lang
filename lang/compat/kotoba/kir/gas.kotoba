(ns kotoba.kir.gas
  "Consensus gas for KIR: a versioned schedule of weights, charged on the
  reference interpreter once per evaluated KIR form (superproject
  adr-2610092340 D3 / D12).

  Gas is NOT fuel. Fuel is the run's boundedness ceiling (function entries,
  one unit each) and its counting differs by backend family on purpose
  (`kotoba.kir`'s `budget-traps`; measured 2026-10-09 by kotoba-lang/amu
  `scripts/test-fuel-differential.cljk`: a 1,000-iteration loop costs 2 fuel
  on this interpreter, 1 on wasm32 and 1,002 on native). Gas is the price
  table a validator set agrees on, so it is defined here, once, over the IR
  every backend reads:

    gas used by a run that answers =
      the sum, over every KIR application form the run evaluates,
      of the weight the schedule gives that form's head

  - a head that names a function of the module weighs `:call`;
  - any other head weighs `(get :weights head)`, else `:default`;
  - literals and symbol references weigh nothing.

  A run that exhausts its gas traps `:budget/gas`. A consensus caller treats
  that as `revert, charge the whole limit` (the EVM's out-of-gas rule), which
  is what lets a backend charge a straight-line segment's sum at the
  segment's entry instead of form by form: for a run that ANSWERS, the two
  orders charge the same total, so only the reference's per-form definition
  is normative.

  `schedule-v0-draft` weighs every form 1. It is a placeholder that makes the
  counting testable before the weights are measured (adr-2610092340 O2:
  schedule v1's weights come from benchmarks on a published reference
  machine). Nothing should be priced on it."
  {:kotoba/export [schedule-v0-draft validate-schedule! form-weight]})

(def schedule-v0-draft
  {:gas-schedule/id :kotoba.gas/v0-draft
   :gas-schedule/version 0
   :call 1
   :default 1
   :weights {}})

(defn- positive-int? [x] (and (integer? x) (pos? x)))
(defn- natural-int? [x] (and (integer? x) (not (neg? x))))

(defn validate-schedule!
  "Refuse a schedule a run could not be priced by. `:default` and `:call` must
  be positive: a zero default would make every unlisted head free, and gas
  that can be zero everywhere stops nothing. A listed weight may be zero
  (a form deliberately priced into its parent), never negative."
  [schedule]
  (let [refuse (fn [reason]
                 (throw (ex-info (str "gas schedule refused: " (name reason))
                                 {:phase :ir :reason reason :schedule schedule})))]
    (when-not (map? schedule) (refuse :gas-schedule-not-a-map))
    (when-not (keyword? (:gas-schedule/id schedule)) (refuse :gas-schedule-id))
    (when-not (natural-int? (:gas-schedule/version schedule)) (refuse :gas-schedule-version))
    (when-not (positive-int? (:default schedule)) (refuse :gas-schedule-default))
    (when-not (positive-int? (:call schedule)) (refuse :gas-schedule-call))
    (when-not (and (map? (:weights schedule))
                   (every? (fn [[k v]] (and (symbol? k) (natural-int? v))) (:weights schedule)))
      (refuse :gas-schedule-weights))
    schedule))

(defn form-weight
  "The weight of one evaluated application form whose head is `op`.
  `function?` is whether `op` names a function of the module."
  [schedule op function?]
  (if function?
    (:call schedule)
    (get (:weights schedule) op (:default schedule))))
