(ns kotoba.kir.admission
  {:kotoba/export [check]}
  (:require [kotoba.lang.coll :as set]
            [kotoba.security.abac :as abac]
            [kotoba.security.crypto-policy :as crypto]
            [kotoba.security.hardware :as hardware]
            [kotoba.security.information-flow :as flow]
            ;; See `kotoba.kir`'s ns form for why a conditional
            ;; require needs to be the WHOLE clause, not an item inside it,
            ;; when the other feature needs none -- not an issue here since
            ;; `clojure.set` is always required, but kept consistent.
            
            [kotoba.form :as form])
  ;; Kotoba: the HIR, the policy and the answer are `:form/r` values (kotoba.form), the
  ;; dynamic value every other phase of the compiler's Kotoba route uses. Until 2026-10-10
  ;; they crossed in as `:document`s, whose containers hold at most 32 items, so a policy
  ;; granting 33 or more capabilities trapped (SIGTRAP) on the seed route. The grant
  ;; algebra (shape, malformed, missing, unused) now runs on Forms; only the inputs of the
  ;; kotoba.security evaluators, which read documents, are converted (`doc-of`), and their
  ;; answers come back as Forms (`form/from-document`).
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                 [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]}))

(defn- kotoba-integer?
  "See `kotoba.compiler.frontend`'s identically-named helper docstring: a
  policy's cap-id may be a bigint (this file's caller may parse
  `--policy policy.edn` via `kotoba.compiler.kotoba-reader`, the same
  reader `.kotoba` source itself uses) or a plain number, on `:cljs`."
  [form :document]
  :bool
  (integer? form))

(defn- g [m :document k :keyword] :document
     (if (map? m) (get m k (document-null)) (document-null)))

(defn- err-doc [message :string data :document] :document
     (document-map (document-keyword :message) (document-string message)
                   (document-keyword :data) data))

;; ---- document -> typed readers for the two typed policies (hardware signing, information flow) ----

(defn- opt-doc [d :document] [:option :document]
     (if (nil? d)
       (option-none-of [:option :document])
       (option-some-of [:option :document] d)))

(defn- opt-string [d :document] [:option :string]
     (match-option (document-string-value d) [:option :string]
       (none (option-none-of [:option :string]))
       (some s (option-some-of [:option :string] s))))

(defn- opt-keyword [d :document] [:option :keyword]
     (match-option (document-keyword-value d) [:option :keyword]
       (none (option-none-of [:option :keyword]))
       (some k (option-some-of [:option :keyword] k))))

(defn- opt-bool [d :document] [:option :bool]
     (cond (document-equal? d (document-bool true)) (option-some-of [:option :bool] true)
           (document-equal? d (document-bool false)) (option-some-of [:option :bool] false)
           :else (option-none-of [:option :bool])))

(defn- kw-list-doc [xs [:list :keyword]] :document
     (reduce (fn [acc k] (document-vector-conj acc (document-keyword k)))
             (document-vector) xs))

(defn- kw-set-doc [xs [:set :keyword]] :document
     (loop [i 0 acc (document-vector)]
       (if (< i (count xs))
         (recur (+ i 1) (document-vector-conj acc (document-keyword (typed-set-nth [:set :keyword] xs i))))
         acc)))

(defn- opt-string-doc [o [:option :string]] :document
     (match-option o [:option :string]
       (none (document-null))
       (some s (document-string s))))

;; every field of the host's answer (`kotoba.security.hardware/evaluate-signing`), :provider-id and
;; :non-claims included (a set reads as a vector here)
(defn- signing-result-doc [r [:ref :hw/signing-result]] :document
     (document-map (document-keyword :hardware-signing/qualified?)
                   (document-bool (:hardware-signing/qualified? r))
                   (document-keyword :hardware-signing/provider-id)
                   (opt-string-doc (:hardware-signing/provider-id r))
                   (document-keyword :hardware-signing/scope)
                   (document-keyword (:hardware-signing/scope r))
                   (document-keyword :hardware-signing/violations)
                   (kw-list-doc (:hardware-signing/violations r))
                   (document-keyword :hardware-signing/non-claims)
                   (kw-set-doc (:hardware-signing/non-claims r))))

(defn- signing-check [ev :document] :document
     (signing-result-doc
      (hardware/evaluate-signing
       (record-new [:record :hw/signing-evidence [[:provider-id [:option :string]] [:hardware-backed? [:option :bool]] [:provider-origin-verified? [:option :bool]] [:private-exported? [:option :bool]] [:sign-verified? [:option :bool]] [:unavailable-failed-closed? [:option :bool]]]]
                   (opt-string (g ev :provider-id))
                   (opt-bool (g ev :hardware-backed?))
                   (opt-bool (g ev :provider-origin-verified?))
                   (opt-bool (g ev :private-exported?))
                   (opt-bool (g ev :sign-verified?))
                   (opt-bool (g ev :unavailable-failed-closed?))))))

(defn- classifications-of [d :document] [:list [:option :keyword]]
     (loop [i 0 acc (typed-list-new [:list [:option :keyword]])]
       (if (>= i (if (coll? d) (document-count d) 0))
         acc
         (recur (+ i 1) (typed-list-conj [:list [:option :keyword]] acc (opt-keyword (nth d i)))))))

(defn- grant-of [gr :document] [:ref :if/grant]
     (record-new [:record :if/grant [[:id [:option :document]] [:subject [:option :document]] [:purpose [:option :document]] [:from [:option :keyword]] [:to [:option :keyword]] [:expires-at [:option :string]]]]
                 (opt-doc (g gr :id))
                 (opt-doc (g gr :subject))
                 (opt-doc (g gr :purpose))
                 (opt-keyword (g gr :from))
                 (opt-keyword (g gr :to))
                 (opt-string (g gr :expires-at))))

(defn- grant-opt-of [gr :document] [:option [:ref :if/grant]]
     (if (nil? gr)
       (option-none-of [:option [:ref :if/grant]])
       (option-some-of [:option [:ref :if/grant]] (grant-of gr))))

(defn- violation-add [acc :document v [:ref :if/violation]] :document
     (document-vector-conj
      acc
      (document-map (document-keyword :information-flow/control)
                    (document-keyword (:information-flow/control v))
                    (document-keyword :information-flow/message)
                    (document-string (:information-flow/message v)))))

(defn- violations-doc [vs [:list [:ref :if/violation]]] :document
     (reduce violation-add (document-vector) vs))

(defn- grant-id-doc [o [:option :document]] :document
     (match-option o [:option :document]
       (none (document-null))
       (some d d)))

(defn- flow-result-doc [r [:ref :if/result]] :document
     (document-map (document-keyword :information-flow/allowed?)
                   (document-bool (:information-flow/allowed? r))
                   (document-keyword :information-flow/source)
                   (document-keyword (:information-flow/source r))
                   (document-keyword :information-flow/target)
                   (document-keyword (:information-flow/target r))
                   (document-keyword :information-flow/downgrade?)
                   (document-bool (:information-flow/downgrade? r))
                   (document-keyword :information-flow/grant-id)
                   (grant-id-doc (:information-flow/grant-id r))
                   (document-keyword :information-flow/violations)
                   (violations-doc (:information-flow/violations r))))

(defn- flow-check [req :document] :document
     (flow-result-doc
      (flow/evaluate-egress
       (record-new [:record :if/request [[:subject [:option :document]] [:purpose [:option :document]] [:now [:option :string]] [:input-classifications [:list [:option :keyword]]] [:output-classification [:option :keyword]] [:declassification-grant [:option [:ref :if/grant]]]]]
                   (opt-doc (g req :subject))
                   (opt-doc (g req :purpose))
                   (opt-string (g req :now))
                   (classifications-of (g req :input-classifications))
                   (opt-keyword (g req :output-classification))
                   (grant-opt-of (g req :declassification-grant))))))


;; ---- the grant algebra over Forms ----

(defn- kf [k :keyword] [:ref :form/r] (form/keyword-form k))

;; (get m k) on the host: nil unless M is a map
(defn- fg [m [:ref :form/r] k :keyword] [:ref :form/r]
     (if (form/is-map? m) (form/form-get m (kf k)) (form/nil-form)))

(defn- fhas? [m [:ref :form/r] k :keyword] :bool
     (and (form/is-map? m) (form/form-has? m (kf k))))

;; host truthiness: everything but nil and false
(defn- ftruthy? [f [:ref :form/r]] :bool
     (not (or (form/is-nil? f) (and (form/is-bool? f) (not (form/bool-value f))))))

(defn- fl-at [xs [:list [:ref :form/r]] i :i64] [:ref :form/r]
     (typed-list-nth [:list [:ref :form/r]] xs i))

;; `=` on the host's data: a list and a vector with equal items are equal (both are
;; sequential), sets and maps compare without order; every other kind is `form/eq`.
(defn- sequential-tag? [t :i64] :bool (or (= t 6) (= t 7)))

(defn- items-same? [a [:list [:ref :form/r]] b [:list [:ref :form/r]] i :i64] :bool
     (cond
       (>= i (vector-count a)) true
       (same? (fl-at a i) (fl-at b i)) (items-same? a b (+ i 1))
       :else false))

(defn- in-items? [xs [:list [:ref :form/r]] x [:ref :form/r] i :i64] :bool
     (cond
       (>= i (vector-count xs)) false
       (same? (fl-at xs i) x) true
       :else (in-items? xs x (+ i 1))))

(defn- all-in-items? [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]] i :i64] :bool
     (cond
       (>= i (vector-count xs)) true
       (in-items? ys (fl-at xs i) 0) (all-in-items? xs ys (+ i 1))
       :else false))

;; the value of key K in map entries KV (k v k v ...), compared by `same?`; FOUND? asks for presence
(defn- entry-same? [kv [:list [:ref :form/r]] k [:ref :form/r] v [:ref :form/r] j :i64] :bool
     (cond
       (>= (+ j 1) (vector-count kv)) false
       (same? (fl-at kv j) k) (same? (fl-at kv (+ j 1)) v)
       :else (entry-same? kv k v (+ j 2))))

(defn- entries-in? [a [:list [:ref :form/r]] b [:list [:ref :form/r]] j :i64] :bool
     (cond
       (>= (+ j 1) (vector-count a)) true
       (entry-same? b (fl-at a j) (fl-at a (+ j 1)) 0) (entries-in? a b (+ j 2))
       :else false))

(defn- same? [a [:ref :form/r] b [:ref :form/r]] :bool
     (let [ta (form/tag-of a)
           tb (form/tag-of b)]
       (cond
         (and (sequential-tag? ta) (sequential-tag? tb))
         (and (= (form/count-of a) (form/count-of b)) (items-same? (form/kids-of a) (form/kids-of b) 0))
         (not (= ta tb)) false
         (= ta 8) (and (all-in-items? (form/kids-of a) (form/kids-of b) 0)
                       (all-in-items? (form/kids-of b) (form/kids-of a) 0))
         (= ta 9) (and (= (form/count-of a) (form/count-of b))
                       (entries-in? (form/kids-of a) (form/kids-of b) 0))
         :else (form/eq a b))))

;; (set xs) for a set, vector or list: its distinct items, first occurrence first
(defn- distinct-items [xs [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count xs))
       acc
       (distinct-items xs (+ i 1) (if (in-items? acc (fl-at xs i) 0) acc (form/append-form acc (fl-at xs i))))))

(defn- collection? [x [:ref :form/r]] :bool
     (or (form/is-set? x) (form/is-vec? x) (form/is-seq? x)))

(defn- entry-items [kv [:list [:ref :form/r]] j :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= (+ j 1) (vector-count kv))
       acc
       (entry-items kv (+ j 2) (form/append-form acc (form/vec2 (fl-at kv j) (fl-at kv (+ j 1)))))))

(defn- char-items [s :string i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (string-length s))
       acc
       (char-items s (+ i 1) (form/append-form acc (form/string-form (string-substring s i (+ i 1)))))))

;; the values the host's `set` takes: nil, a collection, a map (its entries) or a string (its characters)
(defn- seqable? [x [:ref :form/r]] :bool
     (or (form/is-nil? x) (collection? x) (form/is-map? x) (form/is-string? x)))

;; (set x) for a value `seqable?` admits: its distinct items, first occurrence first
(defn- set-items [x [:ref :form/r]] [:list [:ref :form/r]]
     (cond
       (collection? x) (distinct-items (form/kids-of x) 0 (form/no-forms))
       (form/is-map? x) (entry-items (form/kids-of x) 0 (form/no-forms))
       (form/is-string? x) (distinct-items (char-items (form/string-value x) 0 (form/no-forms)) 0 (form/no-forms))
       :else (form/no-forms)))

;; the members of A that B lacks, in A's order (set/difference)
(defn- difference-items [a [:list [:ref :form/r]] b [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]]
     [:list [:ref :form/r]]
     (if (>= i (vector-count a))
       acc
       (difference-items a b (+ i 1) (if (in-items? b (fl-at a i) 0) acc (form/append-form acc (fl-at a i))))))

;; [:cap/call <integer 0..255>]
(defn- grant-ok? [x [:ref :form/r]] :bool
     (and (form/is-vec? x)
          (= 2 (form/count-of x))
          (form/eq (form/nth-of x 0) (kf :cap/call))
          (form/is-int? (form/nth-of x 1))
          (<= 0 (form/int-value (form/nth-of x 1)))
          (<= (form/int-value (form/nth-of x 1)) 255)))

(defn- malformed-items [xs [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count xs))
       acc
       (malformed-items xs (+ i 1) (if (grant-ok? (fl-at xs i)) acc (form/append-form acc (fl-at xs i))))))

(defn- policy-key-ok? [k [:ref :form/r]] :bool
     (or (form/eq k (kf :allow)) (form/eq k (kf :abac)) (form/eq k (kf :attributes))
         (form/eq k (kf :information-flow)) (form/eq k (kf :crypto-required?))
         (form/eq k (kf :crypto-policy)) (form/eq k (kf :crypto-envelope))
         (form/eq k (kf :hardware-signing-required?))
         (form/eq k (kf :hardware-signing-evidence))))

(defn- policy-keys-ok? [kv [:list [:ref :form/r]] j :i64] :bool
     (cond
       (>= j (vector-count kv)) true
       (policy-key-ok? (fl-at kv j)) (policy-keys-ok? kv (+ j 2))
       :else false))

;; map?, every key one this check reads, and :allow (when present) a set -- the host's test
(defn- policy-ok? [policy [:ref :form/r]] :bool
     (and (form/is-map? policy)
          (policy-keys-ok? (form/kids-of policy) 0)
          (or (not (fhas? policy :allow)) (form/is-set? (fg policy :allow)))))

;; ---- host `assoc` / `merge` on the attribute maps ----
;; (merge base x): nil leaves BASE, a map's entries are assoc'ed in order, a two-item vector is one
;; entry (`conj` on a map); anything else makes the host throw, which `mergeable?` reports first.
(defn- mergeable? [x [:ref :form/r]] :bool
     (or (form/is-nil? x) (form/is-map? x) (and (form/is-vec? x) (= 2 (form/count-of x)))))

(defn- assoc-entries [m [:ref :form/r] kv [:list [:ref :form/r]] j :i64] [:ref :form/r]
     (if (>= (+ j 1) (vector-count kv))
       m
       (assoc-entries (form/assoc-form m (fl-at kv j) (fl-at kv (+ j 1))) kv (+ j 2))))

(defn- merge-into [base [:ref :form/r] x [:ref :form/r]] [:ref :form/r]
     (cond
       (form/is-map? x) (assoc-entries base (form/kids-of x) 0)
       (form/is-vec? x) (form/assoc-form base (form/nth-of x 0) (form/nth-of x 1))
       :else base))

(defn- one-entry [k :keyword v [:ref :form/r]] [:ref :form/r]
     (form/assoc-form (form/form-map (form/no-forms)) (kf k) v))

;; the shapes the host's `->` over `assoc`/`merge` accepts: :attributes nil or a map, and its
;; :resource / :action mergeable
(defn- attributes-ok? [supplied [:ref :form/r]] :bool
     (and (or (form/is-nil? supplied) (form/is-map? supplied))
          (mergeable? (fg supplied :resource))
          (mergeable? (fg supplied :action))))

(defn- attributes-of [supplied [:ref :form/r] required [:ref :form/r]] [:ref :form/r]
     (let [base (if (form/is-map? supplied) supplied (form/form-map (form/no-forms)))
           a1 (form/assoc-form base (kf :resource)
                               (merge-into (one-entry :effects required) (fg supplied :resource)))
           action (form/assoc-form (one-entry :id (kf :compiler/admit)) (kf :capabilities) required)]
       (form/assoc-form a1 (kf :action) (merge-into action (fg supplied :action)))))

(defn- flow-request-of [flow-policy [:ref :form/r] attributes [:ref :form/r]] [:ref :form/r]
     (let [r1 (one-entry :subject (fg (fg attributes :subject) :id))
           r2 (form/assoc-form r1 (kf :purpose) (fg attributes :purpose))
           r3 (form/assoc-form r2 (kf :now) (fg (fg attributes :environment) :now))]
       (merge-into r3 flow-policy)))

;; ---- Form -> document, for the kotoba.security evaluators only ----
;; A set reads as a vector (a set in a document tree is a vector without duplicates; the
;; evaluators enumerate it), a list as a vector, f64 and bytes as nil, as
;; `kotoba.compiler.frontend.base/form->document` does. These inputs are the policy's own
;; :abac / :attributes / :crypto-* / :hardware-signing-evidence / :information-flow maps and the
;; row; the grants never cross.
(defn- doc-vec [xs [:list [:ref :form/r]] i :i64 acc :document] :document
     (if (>= i (vector-count xs))
       acc
       (doc-vec xs (+ i 1) (document-vector-conj acc (doc-of (fl-at xs i))))))

(defn- doc-map [kv [:list [:ref :form/r]] j :i64 acc :document] :document
     (if (>= (+ j 1) (vector-count kv))
       acc
       (doc-map kv (+ j 2) (document-assoc acc (doc-of (fl-at kv j)) (doc-of (fl-at kv (+ j 1)))))))

(defn- doc-of [f [:ref :form/r]] :document
     (cond
       (form/is-nil? f) (document-null)
       (form/is-bool? f) (document-bool (form/bool-value f))
       (form/is-int? f) (document-i64 (form/int-value f))
       (form/is-string? f) (document-string (form/string-value f))
       (form/is-keyword? f) (document-keyword (form/keyword-value f))
       (form/is-symbol? f) (document-symbol (symbol (form/symbol-value f)))
       (form/is-map? f) (doc-map (form/kids-of f) 0 (document-map))
       (collection? f) (doc-vec (form/kids-of f) 0 (document-vector))
       :else (document-null)))

(defn- form-or-nil [d :document] [:ref :form/r]
     (if (nil? d) (form/nil-form) (form/from-document d)))

(defn- phase-data [] :document
     (document-map (document-keyword :phase) (document-keyword :admission)))

(defn check
     "Deny-by-default capability admission. Policy shape:
  {:allow #{[:cap/call 7] ...} :abac {...} :attributes {...}}. Returns least privilege and lint facts or
  throws before any backend is selected. HIR, POLICY and the answer are Forms (any number of grants);
  the answer's sets are set Forms, in first-occurrence order.

  A refusal is the Kotoba route's thrown document {:message .. :data {:phase :admission ..}}: the
  messages and the order of the refusals are the host's. Its data carries the row-bounded :required
  and :missing of the denial; the policy-sized :allowed and malformed :entries are not carried (a
  document holds at most 32 items, a policy has no such bound; the route's catchers read :phase and
  the message). Where the host's `set` on :effects or `assoc`/`merge` on :attributes or
  :information-flow would throw (a scalar; a non-map), this throws a document without :phase (an
  internal error), as the host's error is."
     [hir [:ref :form/r] policy [:ref :form/r]] [:ref :form/r]
     (do
       (when-not (policy-ok? policy)
         (throw (err-doc "malformed capability policy" (phase-data))))
       (let [supplied-attributes (fg policy :attributes)
             flow-policy (fg policy :information-flow)]
         (do
           (when-not (seqable? (fg hir :effects))
             (throw (err-doc "admission: :effects is a collection" (document-map))))
           (when-not (attributes-ok? supplied-attributes)
             (throw (err-doc "admission: :attributes, :resource and :action are maps" (document-map))))
           (when (and (ftruthy? flow-policy) (not (mergeable? flow-policy)))
             (throw (err-doc "admission: :information-flow is a map" (document-map))))
           (let [required (set-items (fg hir :effects))
                 allowed (set-items (fg policy :allow))
                 malformed (malformed-items allowed 0 (form/no-forms))
                 missing (difference-items required allowed 0 (form/no-forms))
                 unused (difference-items allowed required 0 (form/no-forms))
                 required-set (form/form-set required)
                 attributes (attributes-of supplied-attributes required-set)
                 abac-result (form/from-document (abac/evaluate (doc-of attributes) (doc-of (fg policy :abac))))
                 crypto-required? (ftruthy? (fg policy :crypto-required?))
                 crypto-result (if (or crypto-required? (ftruthy? (fg policy :crypto-envelope)))
                                 (form-or-nil (crypto/check-production-envelope
                                               (doc-of (fg policy :crypto-policy)) (doc-of (fg policy :crypto-envelope))))
                                 (form/nil-form))
                 hardware-signing-required? (ftruthy? (fg policy :hardware-signing-required?))
                 hardware-signing-result
                 (if (or hardware-signing-required? (ftruthy? (fg policy :hardware-signing-evidence)))
                   (form-or-nil (signing-check (doc-of (fg policy :hardware-signing-evidence))))
                   (form/nil-form))
                 flow-result
                 (if (ftruthy? flow-policy)
                   (form-or-nil (flow-check (doc-of (flow-request-of flow-policy attributes))))
                   (form/nil-form))]
             (when (> (vector-count malformed) 0)
               (throw (err-doc "malformed capability policy" (phase-data))))
             (when (> (vector-count missing) 0)
               (throw (err-doc "capability policy denies required effects"
                               (document-map (document-keyword :phase) (document-keyword :admission)
                                             (document-keyword :required) (doc-vec required 0 (document-vector))
                                             (document-keyword :missing) (doc-vec missing 0 (document-vector))))))
             (when-not (ftruthy? (fg abac-result :abac/allowed?))
               (throw (err-doc "ABAC policy denies compilation"
                               (document-map (document-keyword :phase) (document-keyword :admission)
                                             (document-keyword :abac/policy-id) (doc-of (fg abac-result :abac/policy-id))
                                             (document-keyword :abac/violations) (doc-of (fg abac-result :abac/violations))))))
             (when (and (ftruthy? flow-result)
                        (not (ftruthy? (fg flow-result :information-flow/allowed?))))
               (throw (err-doc "information-flow policy denies compilation"
                               (document-map (document-keyword :phase) (document-keyword :admission)
                                             (document-keyword :information-flow/violations)
                                             (doc-of (fg flow-result :information-flow/violations))))))
             (when (and crypto-required? (not (ftruthy? (fg crypto-result :valid?))))
               (throw (err-doc "hybrid PQC policy denies compilation"
                               (document-map (document-keyword :phase) (document-keyword :admission)
                                             (document-keyword :crypto) (doc-of crypto-result)))))
             (when (and hardware-signing-required?
                        (not (ftruthy? (fg hardware-signing-result :hardware-signing/qualified?))))
               (throw (err-doc "hardware signing policy denies compilation"
                               (document-map (document-keyword :phase) (document-keyword :admission)
                                             (document-keyword :hardware-signing) (doc-of hardware-signing-result)))))
             (let [r1 (one-entry :admitted? (form/bool-form true))
                   r2 (form/assoc-form r1 (kf :required) required-set)
                   r3 (form/assoc-form r2 (kf :minimal-policy) (one-entry :allow required-set))
                   r4 (form/assoc-form r3 (kf :unused-grants) (form/form-set unused))
                   r5 (form/assoc-form r4 (kf :abac) abac-result)
                   r6 (form/assoc-form r5 (kf :information-flow) flow-result)
                   r7 (form/assoc-form r6 (kf :crypto) crypto-result)]
               (form/assoc-form r7 (kf :hardware-signing) hardware-signing-result)))))))
