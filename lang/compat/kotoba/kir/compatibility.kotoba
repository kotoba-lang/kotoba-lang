(ns kotoba.kir.compatibility
  {:kotoba/export [compiler-version descriptor language-version schema tender-role]})

;; Kotoba admits no exported value: each constant is a function of no arguments
;; there. The host keeps the plain vars callers read today.
(def ^:private schema-k :kotoba.compatibility/v1)
(def ^:private compiler-version-s "kotoba-compiler/1")
(def ^:private language-version-k :kotoba.language/safe-v1)
(def ^:private tender-role-k :kototama/component-tender-v1)

(defn schema [] :keyword schema-k)
(defn compiler-version [] :string compiler-version-s)
(defn language-version [] :keyword language-version-k)
(defn tender-role [] :keyword tender-role-k)

(defn- fld [m :document k :keyword] :document
     (option-value-of [:option :document] (document-get m k) (document-null)))

(defn- kw [m :document] :keyword
     (option-value-of [:option :keyword] (document-keyword-value m) :none))

(defn- tender-contract [tp :document] :keyword
     (let [rt (kw (fld tp :runtime))
           ex (kw (fld tp :execution))]
       (if (= :kotoba-linux-static-prelude-v1 rt)
         :kotoba.linux-static/v1
         (case ex
           :javascript :kotoba.restricted-esm/v1
           :wasm :kotoba.capability-host/v1
           :native :kotoba.supervisor/v1
           :process :kotoba.aiueos-process/v1
           :kernel :kotoba.aiueos-kernel/v1
           :firmware :kotoba.aiueos-firmware/v1
           :cljs :kotoba.cljs-host/v1
           :kotoba.unsupported/v1))))

(defn descriptor [m :document] :document
     (let [tp (fld m :target-profile)]
       (document-map :format (document-keyword schema-k)
                     :compiler (document-string compiler-version-s)
                     :language (document-keyword language-version-k)
                     :hir (fld m :hir-format)
                     :kir (fld m :kir-format)
                     :target (fld m :target)
                     :runtime (fld tp :runtime)
                     :value-abi (fld m :value-abi)
                     :tender-role (document-keyword tender-role-k)
                     :tender-contract (document-keyword (tender-contract tp)))))
