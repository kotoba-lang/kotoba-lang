(ns kotoba.kir.iq-codebook
  "The codebook tables the IQ dequantizers index, as HEX BYTE IMAGES.

  In Q8_0, Q4_K and Q6_K a code IS a number. In the four IQ formats a code is
  an INDEX INTO A TABLE that belongs to the format and not to the block: a
  grid of 256, 512 or 1024 entries, plus a sign table for three of them. So
  the tables are part of the operation's meaning, and an oracle that does not
  carry them cannot answer.

  Vendored from llama.cpp @3173a564 (MIT) through
  `os/aiueos/kernel/qwen35_quant_tables.inc`, which is where the C reads them.
  Each is stored as the LITTLE-ENDIAN BYTE IMAGE of the C array rather than as
  a vector of its declared element type, because that is what every consumer
  wants: the C itself casts every grid to `const uint8_t *` before indexing,
  and a backend that reaches these bytes reaches them as a run of bytes in a
  read-only pool.

  `digests` pins each image with FNV-1a/32 over the bytes, in order. It is
  here so that a SECOND transcription of the same table -- a backend's
  read-only pool, say -- can be compared with this one by a test rather than
  only by an execution: two independently typed copies of 8192 bytes that
  agree on a positional digest agree."
  {:kotoba/export [digests fnv1a32 hex->bytes iq2s-grid iq2s-grid-hex iq3s-grid iq3s-grid-hex iq3xxs-grid iq3xxs-grid-hex kmask-iq2xs kmask-iq2xs-hex ksigns-iq2xs ksigns-iq2xs-hex kvalues-iq4nl kvalues-iq4nl-hex]}
  (:require [kotoba.lang.text :as str]))

(defn hex->bytes
  "A hex image as a vector of unsigned bytes. Refuses an odd length and any
  character that is not a hex digit, because a table that silently loses its
  tail is a codebook that answers the wrong number for high indices only."
  [hex]
  (when-not (even? (count hex))
    (throw (ex-info "codebook hex image has an odd length" {:length (count hex)})))
  (let [digits "0123456789abcdef"
        value (fn [c] (let [i (str/index-of digits (str/lower (str c)))]
                        (or i (throw (ex-info "codebook hex image is not hex"
                                              {:character (str c)})))))]
    (mapv (fn [i] (+ (* 16 (value (nth hex (* 2 i)))) (value (nth hex (inc (* 2 i))))))
          (range (quot (count hex) 2)))))

(defn fnv1a32
  "FNV-1a over BYTES, 32 bits. Positional by construction, so it separates a
  permuted table from the table -- which a sum or a histogram does not.

  Written without a 32-bit `bit-xor` and without a 32-bit multiply, because
  neither is portable: 0x811c9dc5 exceeds 2^31 so ClojureScript's `bit-xor`
  would return a negative, and `h * 0x01000193` exceeds 2^53 so a double would
  lose the low bits. Only the LOW BYTE of the accumulator changes under the
  xor, and the prime splits as 2^24 + 403, both of whose partial products stay
  exactly representable."
  [bytes]
  (reduce (fn [h b]
            (let [low (mod h 256)
                  x (+ (- h low) (bit-xor low b))]
              (mod (+ (* (mod x 256) 16777216) (* x 403)) 4294967296)))
          2166136261 bytes))

;; ---------------------------------------------------------------------------
;; the tables
;; ---------------------------------------------------------------------------

(def kmask-iq2xs-hex
  "`kmask_iq2xs`, eight single-bit masks. `signs & kmask[j]` picks element j's
  sign out of a byte."
  "0102040810204080")

(def ksigns-iq2xs-hex
  "`ksigns_iq2xs`, 128 bytes. IQ3_XXS packs a seven-bit sign selector per
  group of eight and expands it through this table; IQ2_S and IQ3_S store the
  eight bits directly and do not use it."
  (str
   "008182038405068788090a8b0c8d8e0f901112931495961718999a1b9c1d1e9f"
   "a02122a324a5a62728a9aa2bac2d2eaf30b1b233b43536b7b8393abb3cbdbe3f"
   "c04142c344c5c64748c9ca4bcc4d4ecf50d1d253d45556d7d8595adb5cddde5f"
   "60e1e263e46566e7e8696aeb6cedee6ff07172f374f5f67778f9fa7bfc7d7eff"))

(def kvalues-iq4nl-hex
  "`kvalues_iq4nl`, sixteen SIGNED bytes. This is the whole of IQ4_XS's
  codebook: a nibble selects one of sixteen levels. It is the only IQ table
  small enough to sit in one XMM register."
  "8198adbfcfddeaf6010d192635455971")

