(ns kotoba.kir.xml
  {:kotoba/export [attribute-limit depth-limit name-count name-text node-limit parse-elements path-attr path-count path-segment-limit path-text validate-name! validate-path!]}
  (:require [kotoba.lang.text :as str])
  ;; the host's bounds and integer helpers; Kotoba's strings are bounded by the
  ;; language and its integers are i64, so the twin needs neither
  
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :xml/ps [:record :xml/ps [[:pos :i64] [:nodes :i64] [:out [:ref :form/r]] [:text :string] [:attrs [:ref :form/r]] [:empty :bool] [:err :keyword]]]}))

(defn- form-no-forms [] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]]))

(defn- form-one-form [a [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a))

(defn- form-two-forms [a [:ref :form/r] b [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a b))

(defn- form-three-forms [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a b c))

(defn- form-append-form [xs [:list [:ref :form/r]] x [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-conj [:list [:ref :form/r]] xs x))

(defn- form-mk [t :i64 s :string n :i64 k :keyword kids [:list [:ref :form/r]]] [:ref :form/r]
     (record-new [:ref :form/r] t s n k kids 0 (bytes-empty)))

(defn- form-nil-form [] [:ref :form/r] (form-mk 0 "" 0 :none (form-no-forms)))

(defn- form-bool-form [b :bool] [:ref :form/r] (form-mk 1 "" (if b 1 0) :none (form-no-forms)))

(defn- form-int-form [n :i64] [:ref :form/r] (form-mk 2 "" n :none (form-no-forms)))

(defn- form-string-form [s :string] [:ref :form/r] (form-mk 3 s 0 :none (form-no-forms)))

(defn- form-keyword-form [k :keyword] [:ref :form/r] (form-mk 4 "" 0 k (form-no-forms)))

(defn- form-symbol-form [s :string] [:ref :form/r] (form-mk 5 s 0 :none (form-no-forms)))

(defn- form-form-seq [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 6 "" 0 :none kids))

(defn- form-form-vec [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 7 "" 0 :none kids))

(defn- form-form-set [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 8 "" 0 :none kids))

(defn- form-form-map [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 9 "" 0 :none kids))

(defn- form-tag-of [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :tag))

(defn- form-kids-of [f [:ref :form/r]] [:list [:ref :form/r]] (record-get [:ref :form/r] f :kids))

(defn- form-int-value [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :n))

(defn- form-string-value [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s))

(defn- form-symbol-value [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s))

(defn- form-keyword-value [f [:ref :form/r]] :keyword (record-get [:ref :form/r] f :k))

(defn- form-bool-value [f [:ref :form/r]] :bool (= 1 (record-get [:ref :form/r] f :n)))

(defn- form-is-nil? [f [:ref :form/r]] :bool (= 0 (form-tag-of f)))

(defn- form-is-bool? [f [:ref :form/r]] :bool (= 1 (form-tag-of f)))

(defn- form-is-int? [f [:ref :form/r]] :bool (= 2 (form-tag-of f)))

(defn- form-is-string? [f [:ref :form/r]] :bool (= 3 (form-tag-of f)))

(defn- form-is-keyword? [f [:ref :form/r]] :bool (= 4 (form-tag-of f)))

(defn- form-is-symbol? [f [:ref :form/r]] :bool (= 5 (form-tag-of f)))

(defn- form-is-seq? [f [:ref :form/r]] :bool (= 6 (form-tag-of f)))

(defn- form-is-vec? [f [:ref :form/r]] :bool (= 7 (form-tag-of f)))

(defn- form-is-set? [f [:ref :form/r]] :bool (= 8 (form-tag-of f)))

(defn- form-is-map? [f [:ref :form/r]] :bool (= 9 (form-tag-of f)))

(defn- form-is-list-like? [f [:ref :form/r]] :bool (or (= 6 (form-tag-of f)) (= 7 (form-tag-of f))))

(defn- form-is-true? [f [:ref :form/r]] :bool (and (= 1 (form-tag-of f)) (= 1 (record-get [:ref :form/r] f :n))))

(defn- form-count-of [f [:ref :form/r]] :i64 (vector-count (form-kids-of f)))

(defn- form-nth-of [f [:ref :form/r] i :i64] [:ref :form/r]
     (if (and (>= i 0) (< i (form-count-of f)))
       (typed-list-nth [:list [:ref :form/r]] (form-kids-of f) i)
       (form-nil-form)))

(defn- form-first-of [f [:ref :form/r]] [:ref :form/r] (form-nth-of f 0))

(defn- form-lookup-from [kids [:list [:ref :form/r]] key [:ref :form/r] i :i64] [:ref :form/r]
     (let [n (vector-count kids)]
       (loop [j i]
         (if (>= (+ j 1) n)
           (form-nil-form)
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] kids j) key)
             (typed-list-nth [:list [:ref :form/r]] kids (+ j 1))
             (recur (+ j 2)))))))

(defn- form-form-get [m [:ref :form/r] key [:ref :form/r]] [:ref :form/r]
     (form-lookup-from (form-kids-of m) key 0))

(defn- form-lookup-has [kids [:list [:ref :form/r]] key [:ref :form/r]] :bool
     (let [n (vector-count kids)]
       (loop [j 0]
         (if (>= (+ j 1) n)
           false
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] kids j) key)
             true
             (recur (+ j 2)))))))

(defn- form-form-has? [m [:ref :form/r] key [:ref :form/r]] :bool
     (form-lookup-has (form-kids-of m) key))

(defn- form-member? [xs [:list [:ref :form/r]] x [:ref :form/r]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n) false
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] xs i) x) true (recur (inc i)))))))

(defn- form-ordered-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [i 0]
           (if (>= i n) true
             (if (form-eq (typed-list-nth [:list [:ref :form/r]] xs i) (typed-list-nth [:list [:ref :form/r]] ys i))
               (recur (inc i))
               false)))
         false)))

(defn- form-set-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [i 0]
           (if (>= i n) true
             (if (form-member? ys (typed-list-nth [:list [:ref :form/r]] xs i)) (recur (inc i)) false)))
         false)))

(defn- form-map-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [j 0]
           (if (>= (+ j 1) n) true
             (let [k (typed-list-nth [:list [:ref :form/r]] xs j)]
               (if (and (form-lookup-has ys k)
                        (form-eq (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)) (form-lookup-from ys k 0)))
                 (recur (+ j 2))
                 false))))
         false)))

(defn- form-eq
     "Structural equality, as `=` on the host's data: a list and a vector are
     different kinds here (as are they to the reader), sets and maps compare
     without order."
     [a [:ref :form/r] b [:ref :form/r]] :bool
     (let [t (form-tag-of a)]
       (and (= t (form-tag-of b))
            (cond
              (= t 0) true
              (= t 1) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
              (= t 2) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
              (= t 3) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
              (= t 4) (= (record-get [:ref :form/r] a :k) (record-get [:ref :form/r] b :k))
              (= t 5) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
              (= t 8) (form-set-eq (form-kids-of a) (form-kids-of b))
              (= t 9) (form-map-eq (form-kids-of a) (form-kids-of b))
              :else (form-ordered-eq (form-kids-of a) (form-kids-of b))))))

(defn- form-rest-list
     "The kids of F after the first, as a list."
     [f [:ref :form/r]] [:list [:ref :form/r]]
     (let [xs (form-kids-of f)
           n (vector-count xs)]
       (loop [i 1 acc (form-no-forms)]
         (if (>= i n)
           acc
           (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs i)))))))

(defn- form-last-of [f [:ref :form/r]] [:ref :form/r]
     (form-nth-of f (dec (form-count-of f))))

(defn- form-cons-onto [x [:ref :form/r] xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count xs)]
       (loop [i 0 acc (form-one-form x)]
         (if (>= i n)
           acc
           (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs i)))))))

(defn- form-assoc-form
     "Map M with K bound to V: the first entry whose key is K keeps its place and
     takes V, else K V are appended (as `assoc` on the host's map)."
     [m [:ref :form/r] k [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
     (let [xs (form-kids-of m)
           n (vector-count xs)]
       (if (form-lookup-has xs k)
         (form-form-map
          (loop [j 0 acc (form-no-forms)]
            (if (>= (+ j 1) n)
              acc
              (let [key (typed-list-nth [:list [:ref :form/r]] xs j)]
                (recur (+ j 2)
                       (typed-list-conj [:list [:ref :form/r]]
                                        (typed-list-conj [:list [:ref :form/r]] acc key)
                                        (if (form-eq key k) v (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)))))))))
         (form-form-map (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] xs k) v)))))

(defn- form-call0 [name :string] [:ref :form/r] (form-form-seq (form-one-form (form-symbol-form name))))

(defn- form-call1 [name :string a [:ref :form/r]] [:ref :form/r]
     (form-form-seq (form-two-forms (form-symbol-form name) a)))

(defn- form-call2 [name :string a [:ref :form/r] b [:ref :form/r]] [:ref :form/r]
     (form-form-seq (form-three-forms (form-symbol-form name) a b)))

(defn- form-call3 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c)))

(defn- form-call4 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c) d)))

(defn- form-call5 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c) d) e)))

(defn- form-call6 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r] f [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c) d) e) f)))

(defn- form-vec2 [a [:ref :form/r] b [:ref :form/r]] [:ref :form/r] (form-form-vec (form-two-forms a b)))

(defn- form-vec3 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:ref :form/r] (form-form-vec (form-three-forms a b c)))

(defn- form-vec4 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r]] [:ref :form/r]
     (form-form-vec (typed-list-conj [:list [:ref :form/r]] (form-three-forms a b c) d)))

(defn- form-vec5 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r]] [:ref :form/r]
     (form-form-vec (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms a b c) d) e)))

(defn- form-vec6 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r] f [:ref :form/r]] [:ref :form/r]
     (form-form-vec (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms a b c) d) e) f)))

(defn- form-doc-at [d :document i :i64] :document
     (option-value-of [:option :document] (document-vector-at d i) (document-null)))

(defn- form-doc-list-at [d :document i :i64] :document
     (option-value-of [:option :document] (document-list-at d i) (document-null)))

(defn- form-doc-entry-at [d :document i :i64] :document
     (option-value-of [:option :document] (document-map-entry-at d i) (document-null)))

(defn- form-doc-items [d :document list? :bool] [:list [:ref :form/r]]
     (let [n (document-count d)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n)
           acc
           (recur (inc i)
                  (typed-list-conj [:list [:ref :form/r]] acc
                                   (form-from-document (if list? (form-doc-list-at d i) (form-doc-at d i)))))))))

(defn- form-doc-map-items [d :document] [:list [:ref :form/r]]
     (let [n (document-count d)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n)
           acc
           (let [e (form-doc-entry-at d i)]
             (recur (inc i)
                    (typed-list-conj [:list [:ref :form/r]]
                                     (typed-list-conj [:list [:ref :form/r]] acc (form-from-document (form-doc-at e 0)))
                                     (form-from-document (form-doc-at e 1)))))))))

(defn- form-set-marker? [d :document] :bool
     (and (> (document-count d) 0)
          (= (document-kind (form-doc-at d 0)) :keyword)
          (= (option-value-of [:option :keyword] (document-keyword-value (form-doc-at d 0)) :none) :kotoba.form/set)))

(defn- form-doc-set-items [d :document] [:list [:ref :form/r]]
     (let [n (document-count d)]
       (loop [i 1 acc (form-no-forms)]
         (if (>= i n)
           acc
           (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (form-from-document (form-doc-at d i))))))))

(defn- form-from-document [d :document] [:ref :form/r]
     (let [kind (document-kind d)]
       (cond
         (= kind :bool) (form-bool-form (option-value-of [:option :bool] (document-bool-value d) false))
         (= kind :i64) (form-int-form (option-value-of [:option :i64] (document-i64-value d) 0))
         (= kind :string) (form-string-form (option-value-of [:option :string] (document-string-value d) ""))
         (= kind :keyword) (form-keyword-form (option-value-of [:option :keyword] (document-keyword-value d) :none))
         (= kind :vector) (if (form-set-marker? d) (form-form-set (form-doc-set-items d)) (form-form-vec (form-doc-items d false)))
         (= kind :list) (form-form-seq (form-doc-items d true))
         (= kind :set) (form-form-set (form-doc-items d false))
         (= kind :map) (form-form-map (form-doc-map-items d))
         :else (form-nil-form))))

(defn- form-keyword-has-namespace? [f [:ref :form/r]] :bool
     (and (= 4 (form-tag-of f))
          (>= (string-find-byte (document-edn-print (document-keyword (record-get [:ref :form/r] f :k))) 47 0) 0)))

(defn- form-keys-of [m [:ref :form/r]] [:ref :form/r]
     (let [xs (form-kids-of m)
           n (vector-count xs)]
       (form-form-set
        (loop [j 0 acc (form-no-forms)]
          (if (>= j n)
            acc
            (recur (+ j 2) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs j))))))))

(defn- form-dissoc-form
     "Map M without K (as `dissoc` on the host's map)."
     [m [:ref :form/r] k [:ref :form/r]] [:ref :form/r]
     (let [xs (form-kids-of m)
           n (vector-count xs)]
       (form-form-map
        (loop [j 0 acc (form-no-forms)]
          (if (>= (+ j 1) n)
            acc
            (let [key (typed-list-nth [:list [:ref :form/r]] xs j)]
              (recur (+ j 2)
                     (if (form-eq key k)
                       acc
                       (typed-list-conj [:list [:ref :form/r]]
                                        (typed-list-conj [:list [:ref :form/r]] acc key)
                                        (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)))))))))))

(defn- form-append-many [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count ys)]
       (loop [i 0 acc xs]
         (if (>= i n) acc (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] ys i)))))))



(defn node-limit [] :i64 2048)


(defn depth-limit [] :i64 32)


(defn attribute-limit [] :i64 32)


(defn path-segment-limit [] :i64 32)



(def ^:private string-limit 65536)



(defn- trap-error [reason :keyword] :i64
     (throw (ex-info "xml" {:phase :xml :trap reason})))



(defn- name-start? [c :i64] :bool
     (or (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122)) (= c 95)))

(defn- name-char? [c :i64] :bool
     (or (name-start? c) (and (>= c 48) (<= c 57)) (= c 46) (= c 58) (= c 45)))

(defn- valid-name? [text :string] :bool
     (let [n (string-byte-length text)]
       (and (>= n 1) (<= n 128)
            (name-start? (string-code-point-at text 0))
            (loop [i 1]
              (if (>= i n) true (if (name-char? (string-code-point-at text i)) (recur (inc i)) false))))))



(defn- ws? [c :i64] :bool (or (= c 32) (= c 9) (= c 10) (= c 13)))



(defn- cp [t :string n :i64 i :i64] :i64
     (if (and (>= i 0) (< i n)) (string-code-point-at t i) -1))

(defn- width [c :i64] :i64 (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4))

(defn- skip [t :string n :i64 i :i64] :i64
     (loop [i i] (if (ws? (cp t n i)) (recur (inc i)) i)))

(defn- starts? [t :string n :i64 i :i64 token :string] :bool
     (let [m (string-byte-length token)]
       (and (<= (+ i m) n)
            (loop [k 0]
              (if (>= k m) true (if (= (string-code-point-at t (+ i k)) (string-code-point-at token k)) (recur (inc k)) false))))))

(defn- find-token [t :string n :i64 from :i64 token :string] :i64
     (loop [i from]
       (cond (> (+ i (string-byte-length token)) n) -1
             (starts? t n i token) i
             :else (recur (+ i (width (cp t n i)))))))

(defn- name-end [t :string n :i64 i :i64] :i64
     (loop [i i] (if (name-char? (cp t n i)) (recur (inc i)) i)))



(defn- ascii-ws? [c :i64] :bool (or (= c 32) (and (>= c 9) (<= c 13))))

(defn- collapse [s :string] :string
     (let [n (string-byte-length s)]
       (loop [i 0 out ""]
         (if (>= i n)
           out
           (if (ascii-ws? (string-code-point-at s i))
             (recur (loop [j i] (if (and (< j n) (ascii-ws? (string-code-point-at s j))) (recur (inc j)) j))
                    (string-concat out " "))
             (let [e (loop [j i] (if (and (< j n) (not (ascii-ws? (string-code-point-at s j)))) (recur (+ j (width (string-code-point-at s j)))) j))]
               (recur e (string-concat out (string-substring s i e)))))))))

(defn- normalize-text [text :string] :string
     (str/trim (collapse text)))



(defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r] (form-form-get m (form-keyword-form k)))

(defn- ps [pos :i64 nodes :i64 out [:ref :form/r] text :string attrs [:ref :form/r] empty :bool err :keyword] [:ref :xml/ps]
     (record-new [:ref :xml/ps] pos nodes out text attrs empty err))

(defn- ps-pos [s [:ref :xml/ps]] :i64 (record-get [:ref :xml/ps] s :pos))

(defn- ps-nodes [s [:ref :xml/ps]] :i64 (record-get [:ref :xml/ps] s :nodes))

(defn- ps-out [s [:ref :xml/ps]] [:ref :form/r] (record-get [:ref :xml/ps] s :out))

(defn- ps-text [s [:ref :xml/ps]] :string (record-get [:ref :xml/ps] s :text))

(defn- ps-attrs [s [:ref :xml/ps]] [:ref :form/r] (record-get [:ref :xml/ps] s :attrs))

(defn- ps-empty [s [:ref :xml/ps]] :bool (record-get [:ref :xml/ps] s :empty))

(defn- ps-err [s [:ref :xml/ps]] :keyword (record-get [:ref :xml/ps] s :err))

(defn- empty-map [] [:ref :form/r] (form-form-map (form-no-forms)))

(defn- fail [s [:ref :xml/ps] k :keyword] [:ref :xml/ps]
     (ps (ps-pos s) (ps-nodes s) (ps-out s) (ps-text s) (ps-attrs s) (ps-empty s) k))

(defn- at [s [:ref :xml/ps] pos :i64] [:ref :xml/ps]
     (ps pos (ps-nodes s) (ps-out s) (ps-text s) (ps-attrs s) (ps-empty s) (ps-err s)))

(defn- scan-attr-value [t :string n :i64 i :i64 q :i64] :i64
     (loop [j i]
       (if (>= j n)
         -1
         (let [c (string-code-point-at t j)]
           (cond (= c q) j
                 (or (= c 60) (= c 38)) -2
                 :else (recur (+ j (width c))))))))

(defn- parse-attrs [t :string n :i64 s [:ref :xml/ps]] [:ref :xml/ps]
     (loop [i (ps-pos s) attrs (empty-map)]
       (let [j (skip t n i)]
         (cond
           (starts? t n j "/>") (ps (+ j 2) (ps-nodes s) (ps-out s) "" attrs true :none)
           (= (cp t n j) 62) (ps (inc j) (ps-nodes s) (ps-out s) "" attrs false :none)
           :else
           (let [e (name-end t n j)
                 attr (string-substring t j e)
                 k (skip t n e)
                 q0 (skip t n (inc k))
                 q (cp t n q0)
                 b (inc q0)
                 close (if (or (= q 34) (= q 39)) (scan-attr-value t n b q) 0)]
             (cond
               (not (valid-name? attr)) (fail s :invalid-xml-name)
               (form-form-has? attrs (form-string-form attr)) (fail s :duplicate-xml-attribute)
               (>= (form-count-of attrs) 32) (fail s :xml-attribute-limit)
               (not (= 61 (cp t n k))) (fail s :invalid-xml-attribute)
               (not (or (= q 34) (= q 39))) (fail s :invalid-xml-attribute)
               (= close -2) (fail s :xml-entity-or-markup-rejected)
               (= close -1) (fail s :unterminated-xml-attribute)
               :else (recur (inc close)
                            (form-assoc-form attrs (form-string-form attr) (form-string-form (string-substring t b close))))))))))

(defn- comment-end [t :string n :i64 i :i64] :i64
     (let [end (find-token t n (+ i 4) "-->")]
       (if (or (< end 0) (>= (find-token (string-substring t (+ i 4) end) (string-byte-length (string-substring t (+ i 4) end)) 0 "--") 0))
         -1
         (+ end 3))))

(defn- join-part [acc :string started :bool part :string] :string
     (if started (string-concat (string-concat acc " ") part) part))

(defn- parse-content [t :string n :i64 depth :i64 path :string tag :string s [:ref :xml/ps]] [:ref :xml/ps]
     (loop [i (ps-pos s) acc "" started false nodes (ps-nodes s) out (ps-out s)]
       (cond
         (starts? t n i "</")
         (let [j (+ i 2)
               e (name-end t n j)
               closing (string-substring t j e)
               k (skip t n e)]
           (cond (not (valid-name? closing)) (ps i nodes out "" (ps-attrs s) false :invalid-xml-name)
                 (or (not (string=? closing tag)) (not (= 62 (cp t n k)))) (ps i nodes out "" (ps-attrs s) false :xml-close-mismatch)
                 :else (ps (inc k) nodes out (normalize-text acc) (ps-attrs s) false :none)))
         (starts? t n i "<!--")
         (let [e (comment-end t n i)]
           (if (< e 0)
             (ps i nodes out "" (ps-attrs s) false :invalid-xml-comment)
             (recur e (join-part acc started " ") true nodes out)))
         (= 60 (cp t n i))
         (let [r (element t n (inc depth) path (ps i nodes out "" (ps-attrs s) false :none))]
           (if (not (= (ps-err r) :none))
             r
             (recur (ps-pos r) (join-part acc started (ps-text r)) true (ps-nodes r) (ps-out r))))
         :else
         (let [f (if (< i n) (string-find-byte t 60 i) -1)
               e (if (< f 0) n f)]
           (if (= e i)
             (ps i nodes out "" (ps-attrs s) false :invalid-xml-text)
             (recur e (join-part acc started (string-substring t i e)) true nodes out))))))

(defn- element [t :string n :i64 depth :i64 parent :string s [:ref :xml/ps]] [:ref :xml/ps]
     (let [i (ps-pos s)
           nodes (inc (ps-nodes s))
           c1 (cp t n (inc i))]
       (cond
         (> depth 32) (fail s :xml-depth-limit)
         (> nodes 2048) (fail s :xml-node-limit)
         (or (not (= 60 (cp t n i))) (= c1 47) (= c1 33) (= c1 63)) (fail s :invalid-xml-element)
         :else
         (let [e (name-end t n (inc i))
               tag (string-substring t (inc i) e)]
           (if (not (valid-name? tag))
             (fail s :invalid-xml-name)
             (let [path (if (> (string-byte-length parent) 0) (string-concat (string-concat parent "/") tag) tag)
                   idx (form-count-of (ps-out s))
                   a (parse-attrs t n (ps e nodes (ps-out s) "" (empty-map) false :none))]
               (if (not (= (ps-err a) :none))
                 a
                 (let [with-slot (ps (ps-pos a) nodes (form-form-vec (form-append-form (form-kids-of (ps-out s)) (form-nil-form))) "" (ps-attrs a) false :none)
                       c (if (ps-empty a)
                           (ps (ps-pos a) nodes (ps-out with-slot) "" (ps-attrs a) false :none)
                           (parse-content t n depth path tag with-slot))]
                   (if (not (= (ps-err c) :none))
                     c
                     (let [record (form-assoc-form
                                   (form-assoc-form
                                    (form-assoc-form (empty-map) (form-keyword-form :path) (form-string-form path))
                                    (form-keyword-form :attributes) (ps-attrs a))
                                   (form-keyword-form :text) (form-string-form (ps-text c)))]
                       (ps (ps-pos c) (ps-nodes c) (replace-at (ps-out c) idx record) (ps-text c) (ps-attrs a) false :none)))))))))))

(defn- replace-at [xs [:ref :form/r] index :i64 x [:ref :form/r]] [:ref :form/r]
     (let [n (form-count-of xs)]
       (loop [i 0 out (form-no-forms)]
         (if (>= i n)
           (form-form-vec out)
           (recur (inc i) (form-append-form out (if (= i index) x (form-nth-of xs i))))))))

(defn- comments [t :string n :i64 s [:ref :xml/ps]] [:ref :xml/ps]
     (loop [i (skip t n (ps-pos s))]
       (if (starts? t n i "<!--")
         (let [e (comment-end t n i)]
           (if (< e 0) (fail (at s i) :invalid-xml-comment) (recur (skip t n e))))
         (at s i))))

(defn- digit01? [c :i64] :bool (or (= c 48) (= c 49)))

(defn- quote? [c :i64] :bool (or (= c 34) (= c 39)))

(defn- ws-run-end [d :string m :i64 i :i64] :i64
     (loop [j i] (if (and (< j m) (ascii-ws? (string-code-point-at d j))) (recur (inc j)) j)))

(defn- encoding-end [d :string m :i64 i :i64] :i64
     ;; end of \s+encoding="UTF-8" at I, or -1
     (let [j (ws-run-end d m i)]
       (if (and (> j i) (starts? d m j "encoding="))
         (let [q (cp d m (+ j 9))]
           (if (and (quote? q)
                    (or (starts? d m (+ j 10) "UTF-8") (starts? d m (+ j 10) "utf-8"))
                    (= q (cp d m (+ j 15))))
             (+ j 16)
             -1))
         -1)))

(defn- xml-declaration? [d :string] :bool
     (let [m (string-byte-length d)
           j (ws-run-end d m 5)]
       (and (starts? d m 0 "<?xml") (> j 5) (starts? d m j "version=")
            (let [q (cp d m (+ j 8))]
              (and (quote? q) (starts? d m (+ j 9) "1.") (digit01? (cp d m (+ j 11))) (= q (cp d m (+ j 12)))
                   (let [k (+ j 13)
                         e (encoding-end d m k)
                         after (if (>= e 0) e k)
                         z (ws-run-end d m after)]
                     (and (starts? d m z "?>") (= (+ z 2) m))))))))

(defn- doctype? [d :string] :bool
     (let [m (string-byte-length d)
           j (ws-run-end d m 9)]
       (and (starts? d m 0 "<!DOCTYPE") (> j 9) (starts? d m j "html")
            (let [z (ws-run-end d m (+ j 4))]
              (and (= 62 (cp d m z)) (= (inc z) m))))))

(defn- prolog [t :string n :i64 s [:ref :xml/ps]] [:ref :xml/ps]
     (let [s1 (comments t n s)]
       (if (not (= (ps-err s1) :none))
         s1
         (let [i (ps-pos s1)
               s2 (if (starts? t n i "<?xml")
                    (let [end (find-token t n (+ i 5) "?>")]
                      (cond (< end 0) (fail s1 :invalid-xml-declaration)
                            (not (xml-declaration? (string-substring t i (+ end 2)))) (fail s1 :invalid-xml-declaration)
                            :else (at s1 (+ end 2))))
                    s1)]
           (if (not (= (ps-err s2) :none))
             s2
             (let [s3 (comments t n s2)]
               (if (not (= (ps-err s3) :none))
                 s3
                 (let [i3 (ps-pos s3)]
                   (if (starts? t n i3 "<!DOCTYPE")
                     (let [end (find-token t n (+ i3 9) ">")]
                       (cond (< end 0) (fail s3 :invalid-xml-doctype)
                             (not (doctype? (string-substring t i3 (inc end)))) (fail s3 :invalid-xml-doctype)
                             :else (comments t n (at s3 (inc end)))))
                     (comments t n s3))))))))))

(defn- parse-state [input :string] [:ref :xml/ps]
     (let [n (string-byte-length input)
           s0 (ps 0 0 (form-form-vec (form-no-forms)) "" (empty-map) false :none)]
       (if (> n string-limit)
         (fail s0 :string-exceeds-utf8-byte-limit)
         (let [p (prolog input n s0)]
           (if (not (= (ps-err p) :none))
             p
             (let [el (element input n 1 "" p)]
               (if (not (= (ps-err el) :none))
                 el
                 (let [tail (comments input n el)]
                   (if (not (= (ps-err tail) :none))
                     tail
                     (let [end (skip input n (ps-pos tail))]
                       (if (= end n) tail (fail tail :xml-trailing-content))))))))))))

(defn parse-elements
     "Parse the sealed, text-free XML subset into exact-path element records."
     [input :string] [:ref :form/r]
     (let [s (parse-state input)]
       (if (= (ps-err s) :none)
         (ps-out s)
         (do (trap-error (ps-err s)) (ps-out s)))))



(defn- segments-ok? [path :string] :bool
     ;; every "/"-separated segment (empty ones kept) is a valid name; at most 32
     (let [n (string-byte-length path)]
       (loop [start 0 count 0]
         (let [f (string-find-byte path 47 start)
               e (if (< f 0) n f)]
           (cond (or (> (inc count) 32) (not (valid-name? (string-substring path start e)))) false
                 (< f 0) true
                 :else (recur (inc f) (inc count)))))))

(defn validate-path! [path :string] :string
     (cond (> (string-byte-length path) string-limit)
           (do (trap-error :string-exceeds-utf8-byte-limit) path)
           (not (segments-ok? path)) (do (trap-error :invalid-xml-path) path)
           :else path))



(defn validate-name! [name :string] :string
     (cond (> (string-byte-length name) string-limit) (do (trap-error :string-exceeds-utf8-byte-limit) name)
           (not (valid-name? name)) (do (trap-error :invalid-xml-name) name)
           :else name))



(defn- element-name [node [:ref :form/r]] :string
     (let [p (form-string-value (fget node :path))
           f (last-slash p)]
       (if (< f 0) p (string-substring p (inc f) (string-byte-length p)))))

(defn- last-slash [p :string] :i64
     (loop [i 0 last -1]
       (let [f (string-find-byte p 47 i)]
         (if (< f 0) last (recur (inc f) f)))))



(defn- filter-by-path [nodes [:ref :form/r] path :string] [:ref :form/r]
     (let [n (form-count-of nodes)]
       (loop [i 0 out (form-no-forms)]
         (if (>= i n)
           (form-form-vec out)
           (let [x (form-nth-of nodes i)]
             (recur (inc i) (if (string=? (form-string-value (fget x :path)) path) (form-append-form out x) out)))))))

(defn- filter-by-name [nodes [:ref :form/r] name :string] [:ref :form/r]
     (let [n (form-count-of nodes)]
       (loop [i 0 out (form-no-forms)]
         (if (>= i n)
           (form-form-vec out)
           (let [x (form-nth-of nodes i)]
             (recur (inc i) (if (string=? (element-name x) name) (form-append-form out x) out)))))))

(defn path-count [input :string path :string] :i64
     (let [p (validate-path! path)]
       (form-count-of (filter-by-path (parse-elements input) p))))



(defn name-count [input :string name :string] :i64
     (let [nm (validate-name! name)]
       (form-count-of (filter-by-name (parse-elements input) nm))))



(defn- text-at [matches [:ref :form/r] index :i64] [:option :string]
     (if (>= index (form-count-of matches))
       (option-none-of [:option :string])
       (option-some-of [:option :string] (form-string-value (fget (form-nth-of matches index) :text)))))

(defn name-text [input :string name :string index :i64] [:option :string]
     (let [nm (validate-name! name)]
       (if (< index 0)
         (do (trap-error :xml-index-out-of-range) (option-none-of [:option :string]))
         (text-at (filter-by-name (parse-elements input) nm) index))))



(defn path-text [input :string path :string index :i64] [:option :string]
     (let [p (validate-path! path)]
       (if (< index 0)
         (do (trap-error :xml-index-out-of-range) (option-none-of [:option :string]))
         (text-at (filter-by-path (parse-elements input) p) index))))



(defn path-attr [input :string path :string index :i64 attribute :string] [:option :string]
     (let [p (validate-path! path)
           a (validate-name! attribute)]
       (if (< index 0)
         (do (trap-error :xml-index-out-of-range) (option-none-of [:option :string]))
         (let [matches (filter-by-path (parse-elements input) p)]
           (if (>= index (form-count-of matches))
             (option-none-of [:option :string])
             (let [attrs (fget (form-nth-of matches index) :attributes)
                   k (form-string-form a)]
               (if (form-form-has? attrs k)
                 (option-some-of [:option :string] (form-string-value (form-form-get attrs k)))
                 (option-none-of [:option :string]))))))))
