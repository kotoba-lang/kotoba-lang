                                                  temp-slot
                                                  (:temp-slot state))))
                    kept (into {}
                               (filter (fn [dd__127587_1]
                                         (let [register (fe-nth dd__127587_1 1)]
                                           (contains? preserved-set register)))
                                       (:assigned state)))
                    kept (if (and (gmir/vreg? dst) (not= :mir/tail-call op))
