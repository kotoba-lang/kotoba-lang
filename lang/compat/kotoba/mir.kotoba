                                           (let [instruction (fe-nth dd__84583_1 1)]
                                             [(:mir/dst instruction) slot]))
                                         phis))
        stores-by-edge
        (reduce (fn [stores dd__84771_1]
                  (let [index (fe-nth dd__84771_1 0)
                        dd__84771_2 (fe-nth dd__84771_1 1)
                        dst (fe-get dd__84771_2 :mir/dst)
                        incomings (fe-get dd__84771_2 :mir/incomings)]
                    (let [join (preceding-label instructions index)
                        slot (get slot-by-dst dst)]
