nil

nil

nil

nil

nil

nil

nil

nil

;; ---------------------------------------------------------------------------
;; Kotoba route: allocation helpers over Form. Allocator state is one map form
;; with the keys :assigned :free :reserve :backed :next-slot :out :used-temp?
;; :temp-slot :def-position :index, and :problem once a step has failed.
;; A failing step sets :problem (the host throws) and every caller stops at it.
;; ---------------------------------------------------------------------------

(defn- direct-recur-sites [instructions [:ref :form/r] current-function [:ref :form/r] parameter-homes [:ref :form/r]] [:ref :form/r]
     ;; indexes of self tail calls with as many arguments as there are homes
     (let [n (form/count-of instructions)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [ins (form/nth-of instructions i)]
             (recur (inc i)
                    (if (and (kw? (fget ins :mir/op) :mir/tail-call)
                             (form/eq current-function (fget ins :mir/callee))
                             (= (form/count-of (fget ins :mir/arguments))
                                (form/count-of parameter-homes)))
                      (vconj acc (fint i))
                      acc)))))))

;; How many times VALUE appears in the vector ARGUMENTS.
(defn- occurrences [arguments [:ref :form/r] value [:ref :form/r]] :i64
     (let [n (form/count-of arguments)]
       (loop [i 0 c 0]
         (if (>= i n) c
           (recur (inc i) (if (form/eq (form/nth-of arguments i) value) (inc c) c))))))

;; Map a self-tail argument SSA value to its exact allocator-owned parameter home
;; when that recur is the value's sole use.
(defn- direct-recur-home-candidates [instructions [:ref :form/r] current-function [:ref :form/r] parameter-homes [:ref :form/r] indexes [:ref :form/r]] [:ref :form/r]
     (let [sites (direct-recur-sites instructions current-function parameter-homes)]
       (if (= 1 (form/count-of sites))
         (let [index (ival (form/nth-of sites 0))
               arguments (fget (form/nth-of instructions index) :mir/arguments)
               n (form/count-of arguments)]
           (loop [k 0 out (fmap)]
             (if (>= k n) out
               (let [value (form/nth-of arguments k)
                     uses (mget indexes value)]
                 (recur (inc k)
                        (if (and (gmir/vreg? value)
                                 (= 1 (occurrences arguments value))
                                 (= 1 (form/count-of uses))
                                 (int-eq? (form/nth-of uses 0) index))
                          (massoc out value (form/nth-of parameter-homes k))
                          out))))))
         (fmap))))

;; The suffix after a producer reaches its sole recur use without crossing a
;; control-flow or call boundary.
(defn- straight-line-to-recur? [instructions [:ref :form/r] producer-index :i64 recur-index :i64] :bool
     (loop [i (+ producer-index 1)]
       (if (>= i recur-index) true
         (let [op (kw-of (fget (form/nth-of instructions i) :mir/op))]
           (if (or (call-operation? op) (= op :mir/label) (= op :mir/jump) (= op :mir/branch-zero) (= op :mir/branch-nonzero) (= op :mir/return) (= op :mir/tail-call) (= op :mir/recur) (= op :mir/reentry))
             false
             (recur (inc i)))))))

;; The first use of VALUE at or after INDEX, or -1.
(defn- next-use-of [indexes [:ref :form/r] index :i64 value [:ref :form/r]] :i64
     (let [uses (mget indexes value)
           n (form/count-of uses)]
       (loop [k 0]
         (if (>= k n) -1
           (let [u (ival (form/nth-of uses k))]
             (if (>= u index) u (recur (inc k))))))))

;; The assigned value with the furthest next use, excluding PROTECTED operands.
;; Ties keep the earlier ordered entry. A nil form when nothing is eligible.
(defn- furthest-victim [assigned [:ref :form/r] indexes [:ref :form/r] index :i64 protected [:ref :form/r]] [:ref :form/r]
     (let [ordered (ordered-vregs (mkeys assigned))
           candidates (vremove-members ordered protected)
           n (form/count-of candidates)]
       (if (= n 0)
         (form/nil-form)
         (loop [k 1 best (form/nth-of candidates 0)]
           (if (>= k n) best
             (let [value (form/nth-of candidates k)
                   best-use (next-use-of indexes index best)
                   value-use (next-use-of indexes index value)]
               (recur (inc k) (if (> value-use best-use) value best))))))))

;; STATE's assignment without VALUES, their registers back on the free list
;; unless another value still owns them.
(defn- dissoc-all [m [:ref :form/r] ks [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of ks)]
       (loop [i 0 acc m]
         (if (>= i n) acc (recur (inc i) (mdissoc acc (form/nth-of ks i)))))))

;; The registers ASSIGNED gives to VALUES, in VALUES' order.
(defn- registers-of [assigned [:ref :form/r] values [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of values)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (recur (inc i) (vconj acc (mget assigned (form/nth-of values i))))))))

(defn- expire-assigned [state [:ref :form/r] values [:ref :form/r]] [:ref :form/r]
     (let [expired (ordered-vregs values)
           assigned (fget state :assigned)
           remaining (dissoc-all assigned expired)
           still-owned (mvals remaining)
           freed (vremove-members (registers-of assigned expired) still-owned)]
       (kassoc (kassoc state :assigned remaining)
               :free (vinto (fget state :free) freed))))

;; Re-split POOL into the scratch free list and the reserve (leaf + preserved)
;; after a call has clobbered every caller-saved register.
(defn- rebuild-pool-lists [target [:ref :form/r] pool [:ref :form/r] assigned [:ref :form/r]] [:ref :form/r]
     (let [owned (mvals assigned)
           scratch-count (form/count-of (form/form-get (physical-registers) target))]
       (mk2 :free (vremove-members (vtake pool scratch-count) owned)
            :reserve (vremove-members (vdrop pool scratch-count) owned))))

(defn- expire-assigned-in-pool [target [:ref :form/r] state [:ref :form/r] values [:ref :form/r]] [:ref :form/r]
     (let [assigned (fget state :assigned)
           remaining (dissoc-all assigned values)
           still-owned (mvals remaining)
           released (vremove-members (registers-of assigned (ordered-vregs values)) still-owned)
           scratch (form/form-get (physical-registers) target)
           state2 (expire-assigned state values)
           free2 (vinto (vremove-members (fget state2 :free) released) (vkeep-members released scratch))
           reserve2 (vinto (vremove-members released scratch) (fget state2 :reserve))]
       (kassoc (kassoc state2 :free free2) :reserve reserve2)))

;; A reload in one arm does not satisfy a use in another. Values that already
;; have a slot are dropped from the assignment at every label.
(defn- drop-backed-assignments [target [:ref :form/r] pool [:ref :form/r] assigned [:ref :form/r] backed [:ref :form/r]] [:ref :form/r]
     (let [ks (mkeys assigned)
           n (form/count-of ks)
           kept (loop [i 0 acc (fmap)]
                  (if (>= i n) acc
                    (let [k (form/nth-of ks i)]
                      (recur (inc i) (if (mhas? backed k) acc (massoc acc k (mget assigned k)))))))
           lists (rebuild-pool-lists target pool kept)]
       (mk3 :assigned kept :free (fget lists :free) :reserve (fget lists :reserve))))

(defn- physicalize-call [instruction [:ref :form/r] call-registers [:ref :form/r] return-register [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :mir/op))
           base (kassoc (kassoc (fmap) :mir/op (fget instruction :mir/op)) :mir/arguments call-registers)
           with-dst (if (= op :mir/tail-call) base (kassoc base :mir/dst return-register))
           with-callee (if (or (= op :mir/call) (= op :mir/tail-call))
                         (kassoc with-dst :mir/callee (fget instruction :mir/callee))
                         with-dst)
           with-runtime (if (= op :mir/runtime-call)
                          (kassoc (kassoc with-callee :mir/runtime (fget instruction :mir/runtime))
                                  :mir/context-offset (fget instruction :mir/context-offset))
                          with-callee)]
       (if (= op :mir/capability-call)
         (kassoc (kassoc (kassoc with-runtime :mir/capability (fget instruction :mir/capability))
                         :mir/kind (fget instruction :mir/kind))
                 :mir/context-offset (fget instruction :mir/context-offset))
         with-runtime)))

;; ---- call-live-slots ----

(defn- call-indexes-of [instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (recur (inc i)
                  (if (call-operation? (kw-of (fget (form/nth-of instructions i) :mir/op)))
                    (vconj acc (fint i))
                    acc))))))

(defn- crosses-a-call? [call-indexes [:ref :form/r] definition-index :i64 last-use :i64] :bool
     (let [n (form/count-of call-indexes)]
       (loop [k 0]
         (if (>= k n) false
           (let [c (ival (form/nth-of call-indexes k))]
             (if (and (< definition-index c) (< c last-use)) true (recur (inc k))))))))

;; A map vreg -> stable slot, for values whose definition precedes a call and
;; whose final use follows it; slots are numbered in definition order.
(defn- call-live-slots [instructions [:ref :form/r]] [:ref :form/r]
     (let [last-use (last-uses instructions)
           call-indexes (call-indexes-of instructions)
           n (form/count-of instructions)]
       (loop [i 0 slots (fmap)]
         (if (>= i n) slots
           (let [dst (fget (form/nth-of instructions i) :mir/dst)]
             (recur (inc i)
                    (if (and (gmir/vreg? dst)
                             (crosses-a-call? call-indexes i (ival-or (mget last-use dst) -1)))
                      (massoc slots dst (fint (quot (form/count-of slots) 2)))
                      slots)))))))

;; ---- state helpers ----

(defn- st-failed? [st [:ref :form/r]] :bool (fhas? st :problem))

(defn- st-fail [st [:ref :form/r] problem :keyword] [:ref :form/r]
     (kassoc st :problem (kwf problem)))

;; Splice the spill-store in immediately after VALUE was defined.
(defn- store-at-definition [st [:ref :form/r] value [:ref :form/r] register [:ref :form/r] slot :i64] [:ref :form/r]
     (let [def-position (fget st :def-position)]
       (if (not (mhas? def-position value))
         (st-fail st :spill-required)
         (let [position (ival (mget def-position value))
               out (fget st :out)
               store (instr-spill-store register (fint slot))
               ks (mkeys def-position)
               n (form/count-of ks)
               shifted (loop [i 0 acc (fmap)]
                         (if (>= i n) acc
                           (let [k (form/nth-of ks i)
                                 p (ival (mget def-position k))]
                             (recur (inc i) (massoc acc k (fint (if (>= p position) (inc p) p)))))))]
           (kassoc (kassoc st :out (vinto (vconj (vtake out position) store) (vdrop out position)))
                   :def-position shifted)))))

;; ---------------------------------------------------------------------------
;; Kotoba route: the entry plan and the linear-scan step functions.
;; ---------------------------------------------------------------------------

;; The number of leading :mir/argument instructions.
(defn- leading-argument-count [instructions [:ref :form/r]] :i64
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (and (< i n) (kw? (fget (form/nth-of instructions i) :mir/op) :mir/argument))
           (recur (inc i))
           i))))

(defn- argument-after? [instructions [:ref :form/r] from :i64] :bool
     (let [n (form/count-of instructions)]
       (loop [i from]
         (if (>= i n) false
           (if (kw? (fget (form/nth-of instructions i) :mir/op) :mir/argument) true (recur (inc i)))))))

;; The argument instructions of ARGUMENTS whose value is read later.
(defn- used-arguments [arguments [:ref :form/r] last-use [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of arguments)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [a (form/nth-of arguments i)]
             (recur (inc i) (if (mhas? last-use (fget a :mir/dst)) (vconj acc a) acc)))))))

(defn- place-entry-input [state [:ref :form/r] instruction [:ref :form/r] preserved-values [:ref :form/r]] [:ref :form/r]
     (let [value (fget instruction :mir/dst)
           primary (if (member-of? preserved-values value) :preserved :scratch)
           secondary (if (= primary :preserved) :scratch :preserved)
           tier (cond (> (form/count-of (fget state primary)) 0) primary
                      (> (form/count-of (fget state secondary)) 0) secondary
                      :else :none)]
       (if (= tier :none)
         (kassoc state :spill-inputs (vconj (fget state :spill-inputs) instruction))
         (let [register (form/nth-of (fget state tier) 0)]
           (kassoc (kassoc (kassoc state tier (vrest (fget state tier)))
                           :register-inputs (vconj (fget state :register-inputs) (form/vec2 instruction register)))
                   :assigned (massoc (fget state :assigned) value register))))))

(defn- place-entry-inputs [used [:ref :form/r] pool [:ref :form/r] scratch-count :i64 preserved-values [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of used)
           initial (kassoc (kassoc (kassoc (kassoc (kassoc (fmap) :scratch (vtake pool scratch-count))
                                                   :preserved (vdrop pool scratch-count))
                                           :register-inputs (fvec))
                                   :spill-inputs (fvec))
                           :assigned (fmap))]
       (loop [i 0 state initial]
         (if (>= i n) state
           (recur (inc i) (place-entry-input state (form/nth-of used i) preserved-values))))))

;; The slot each spilled entry input is stored to: {:slots map :next-slot int}.
(defn- entry-spill-slots [spill-inputs [:ref :form/r] slot-base :i64 stable-slots [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of spill-inputs)]
       (loop [i 0 slots (fmap) next-slot slot-base]
         (if (>= i n)
           (mk2 :slots slots :next-slot (fint next-slot))
           (let [value (fget (form/nth-of spill-inputs i) :mir/dst)]
             (if (mhas? stable-slots value)
               (recur (inc i) (massoc slots value (mget stable-slots value)) next-slot)
               (recur (inc i) (massoc slots value (fint next-slot)) (inc next-slot))))))))

;; Does every argument instruction name a register-passed input?
(defn- arguments-in-registers? [arguments [:ref :form/r] abi [:ref :form/r]] :bool
     (let [n (form/count-of arguments)]
       (loop [i 0]
         (if (>= i n) true
           (let [idx (fget (form/nth-of arguments i) :mir/index)]
             (if (and (form/is-int? idx) (>= (form/int-value idx) 0) (< (form/int-value idx) (form/count-of abi)))
               (recur (inc i))
               false))))))

(defn- abi-register-of [abi [:ref :form/r] instruction [:ref :form/r]] [:ref :form/r]
     (form/nth-of abi (ival (fget instruction :mir/index))))

(defn- entry-markers [arguments [:ref :form/r] abi [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of arguments)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [a (form/nth-of arguments i)]
             (recur (inc i) (vconj acc (kassoc a :mir/dst (abi-register-of abi a)))))))))

(defn- entry-stores [spill-inputs [:ref :form/r] abi [:ref :form/r] entry-spills [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of spill-inputs)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [a (form/nth-of spill-inputs i)]
             (recur (inc i)
                    (vconj acc (instr-spill-store (abi-register-of abi a)
                                                  (mget entry-spills (fget a :mir/dst))))))))))

(defn- entry-copies [register-inputs [:ref :form/r] abi [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of register-inputs)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [pair (form/nth-of register-inputs i)]
             (recur (inc i)
                    (vconj acc (mk2 :mir/dst (form/nth-of pair 1)
                                    :mir/src (abi-register-of abi (form/nth-of pair 0))))))))))

;; The assigned register of each argument, in order, as the parameter homes.
(defn- homes-of [arguments [:ref :form/r] assigned [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of arguments)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (recur (inc i) (vconj acc (mget assigned (fget (form/nth-of arguments i) :mir/dst))))))))

;; Materialize a function's ABI inputs as canonical self-markers followed by a
;; bounded set of direct entry spills and a parallel copy into allocator
;; registers. Returns the plan map, or {:problem ...}.
(defn- entry-argument-plan [target [:ref :form/r] pool [:ref :form/r] instructions [:ref :form/r] last-use [:ref :form/r] slot-base :i64 stable-slots [:ref :form/r] preserved-values [:ref :form/r]] [:ref :form/r]
     (let [argument-count (leading-argument-count instructions)
           abi (form/form-get (call-argument-registers) target)
           arguments (vtake instructions argument-count)
           remaining (vdrop instructions argument-count)]
       (cond
         (argument-after? instructions argument-count) (kassoc (fmap) :problem (kwf :spill-required))
         (not (arguments-in-registers? arguments abi)) (kassoc (fmap) :problem (kwf :spill-required))
         :else
         (let [scratch-count (form/count-of (form/form-get (physical-registers) target))
               used (used-arguments arguments last-use)
               placement (place-entry-inputs used pool scratch-count preserved-values)
               assigned (fget placement :assigned)
               spill-inputs (fget placement :spill-inputs)
               spills (entry-spill-slots spill-inputs slot-base stable-slots)
               entry-spills (fget spills :slots)
               next-slot (ival (fget spills :next-slot))
               scheduled (schedule-parallel-copies (entry-copies (fget placement :register-inputs) abi) next-slot)
               instrs (vinto (vinto (entry-markers arguments abi) (entry-stores spill-inputs abi entry-spills))
                             (fget scheduled :instructions))]
           (kassoc
            (kassoc
             (kassoc
              (kassoc
               (kassoc
                (kassoc
                 (kassoc
                  (kassoc
                   (kassoc
                    (kassoc
                     (kassoc
                      (kassoc (fmap) :argument-count (fint argument-count))
                      :remaining remaining)
                     :assigned assigned)
                    :entry-spills entry-spills)
                   :stable-slots (mmerge stable-slots entry-spills))
                  :stable-slot-count (fint next-slot))
                 :temp-slot (fint next-slot))
                :free (fget placement :scratch))
               :reserve (fget placement :preserved))
              :instructions instrs)
             :parameter-homes (if (and (= 0 (form/count-of entry-spills))
                                       (= argument-count (quot (form/count-of assigned) 2)))
                                (homes-of arguments assigned)
                                (form/nil-form)))
            :used-temp? (fget scheduled :used-temp?))))))

;; ---- step functions (ctx = the per-function constants) ----

;; Spill VALUE's register to its slot (storing at its definition unless it is
;; already backed) and free the register.
(defn- spill-assigned [st [:ref :form/r] value [:ref :form/r]] [:ref :form/r]
     (let [register (mget (fget st :assigned) value)]
       (if (form/is-nil? register)
         (st-fail st :spill-required)
         (let [existing (mget (fget st :backed) value)
               has-existing (form/is-int? existing)
               slot (if has-existing (form/int-value existing) (ival (fget st :next-slot)))
               next-slot (if has-existing (ival (fget st :next-slot)) (+ 1 (ival (fget st :next-slot))))]
           (if (> next-slot 4095)
             (st-fail st :spill-frame-too-large)
             (let [st1 (kassoc
                        (kassoc
                         (kassoc
                          (kassoc st :backed (massoc (fget st :backed) value (fint slot)))
                          :next-slot (fint next-slot))
                         :assigned (mdissoc (fget st :assigned) value))
                        :free (vconj (fget st :free) register))]
               (if has-existing
                 st1
                 (store-at-definition st1 value register slot))))))))

;; Take a register from the PREFERRED list (:preserved -> reserve, else free),
;; else from the other, else evict the assigned value with the furthest next
;; use that is not an operand. The register taken is left in :taken.
(defn- take-register [st [:ref :form/r] ctx [:ref :form/r] protected [:ref :form/r] prefer :keyword] [:ref :form/r]
     (let [primary (if (= prefer :preserved) :reserve :free)
           secondary (if (= prefer :preserved) :free :reserve)
           plist (fget st primary)
           slist (fget st secondary)]
       (cond
         (> (form/count-of plist) 0)
         (kassoc (kassoc st primary (vrest plist)) :taken (form/nth-of plist 0))
         (> (form/count-of slist) 0)
         (kassoc (kassoc st secondary (vrest slist)) :taken (form/nth-of slist 0))
         :else
         (let [victim (furthest-victim (fget st :assigned) (fget ctx :indexes) (ival (fget st :index)) protected)]
           (if (form/is-nil? victim)
             (st-fail st :spill-required)
             (let [register (mget (fget st :assigned) victim)
                   st1 (spill-assigned st victim)]
               (if (st-failed? st1)
                 st1
                 (kassoc (kassoc st1 :free (vrest (fget st1 :free))) :taken register))))))))

;; Are all ARGUMENTS assigned?
(defn- all-assigned? [assigned [:ref :form/r] arguments [:ref :form/r]] :bool
     (let [n (form/count-of arguments)]
       (loop [i 0]
         (if (>= i n) true
           (if (mhas? assigned (form/nth-of arguments i)) (recur (inc i)) false)))))

;; The copies moving each assigned argument into its call register.
(defn- call-copies [assigned [:ref :form/r] arguments [:ref :form/r] call-registers [:ref :form/r]] [:ref :form/r]
     (let [n (if (< (form/count-of arguments) (form/count-of call-registers)) (form/count-of arguments) (form/count-of call-registers))]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [source (mget assigned (form/nth-of arguments i))]
             (recur (inc i)
                    (if (form/is-nil? source) acc
                      (vconj acc (mk2 :mir/dst (form/nth-of call-registers i) :mir/src source)))))))))

;; The slot loads for arguments that are not in a register, or a nil form when
;; one has no slot.
(defn- call-loads [st [:ref :form/r] arguments [:ref :form/r] call-registers [:ref :form/r]] [:ref :form/r]
     (let [n (if (< (form/count-of arguments) (form/count-of call-registers)) (form/count-of arguments) (form/count-of call-registers))
           assigned (fget st :assigned)
           backed (fget st :backed)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [value (form/nth-of arguments i)]
             (if (mhas? assigned value)
               (recur (inc i) acc)
               (let [slot (mget backed value)]
                 (if (form/is-nil? slot)
                   (form/nil-form)
                   (recur (inc i) (vconj acc (instr-spill-load (form/nth-of call-registers i) slot)))))))))))

;; Spill every live-across value that is not in a preserved register.
(defn- live-across-values [assigned [:ref :form/r] last-use [:ref :form/r] index :i64] [:ref :form/r]
     (let [ks (mkeys assigned)
           n (form/count-of ks)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [k (form/nth-of ks i)]
             (recur (inc i) (if (> (ival-or (mget last-use k) -1) index) (vconj acc k) acc)))))))

(defn- spill-live-across [st [:ref :form/r] ctx [:ref :form/r] index :i64] [:ref :form/r]
     (let [live (ordered-vregs (live-across-values (fget st :assigned) (fget ctx :last-use) index))
           m (form/count-of live)]
       (loop [j 0 state st]
         (if (or (>= j m) (st-failed? state)) state
           (let [value (form/nth-of live j)
                 register (mget (fget state :assigned) value)]
             (recur (inc j)
                    (if (member-of? (fget ctx :preserved-set) register)
                      state
                      (spill-assigned state value))))))))

;; Registers of KEPT-LIKE assigned entries whose register is preserved.
(defn- keep-preserved [assigned [:ref :form/r] preserved-set [:ref :form/r]] [:ref :form/r]
     (let [ks (mkeys assigned)
           n (form/count-of ks)]
       (loop [i 0 acc (fmap)]
         (if (>= i n) acc
           (let [k (form/nth-of ks i)
                 r (mget assigned k)]
             (recur (inc i) (if (member-of? preserved-set r) (massoc acc k r) acc)))))))

;; The assigned values whose last use is INDEX.
(defn- values-dying-at [assigned [:ref :form/r] last-use [:ref :form/r] index :i64] [:ref :form/r]
     (let [ks (mkeys assigned)
           n (form/count-of ks)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [k (form/nth-of ks i)]
             (recur (inc i) (if (int-eq? (mget last-use k) index) (vconj acc k) acc)))))))

;; Pin the parallel-copy temporary when SCHEDULED used it for the first time.
(defn- absorb-scheduled-copies [st [:ref :form/r] scheduled [:ref :form/r] temp-slot :i64] [:ref :form/r]
     (let [sched-used (form/is-true? (fget scheduled :used-temp?))
           st-used (form/is-true? (fget st :used-temp?))
           pinning (and sched-used (not st-used))]
       (kassoc
        (kassoc
         (kassoc
          (kassoc st :out (vinto (fget st :out) (fget scheduled :instructions)))
          :used-temp? (form/bool-form (or st-used sched-used)))
         :next-slot (fint (if pinning (+ 1 (ival (fget st :next-slot))) (ival (fget st :next-slot)))))
        :temp-slot (if sched-used (fint temp-slot) (fget st :temp-slot)))))

(defn- current-temp-slot [st [:ref :form/r]] :i64
     (let [t (fget st :temp-slot)]
       (if (form/is-nil? t) (ival (fget st :next-slot)) (form/int-value t))))

;; A self tail call that re-enters through the parameter homes.
(defn- emit-direct-recur [st [:ref :form/r] ctx [:ref :form/r] instruction [:ref :form/r]] [:ref :form/r]
     (let [arguments (fget instruction :mir/arguments)
           homes (fget ctx :parameter-homes)
           n (form/count-of arguments)
           copies (loop [i 0 acc (fvec)]
                    (if (>= i n) acc
                      (recur (inc i)
                             (vconj acc (mk2 :mir/dst (form/nth-of homes i)
                                             :mir/src (mget (fget st :assigned) (form/nth-of arguments i)))))))
           temp-slot (current-temp-slot st)
           scheduled (schedule-parallel-copies copies temp-slot)
           st1 (absorb-scheduled-copies st scheduled temp-slot)]
       (kassoc st1 :out (vconj (fget st1 :out) (mk2 :mir/op (kwf :mir/recur) :mir/arguments homes)))))

;; The state after the call's results are placed: caller-saved assignments are
;; gone, the return register holds DST, and dying values are released.
(defn- settle-after-call [st [:ref :form/r] ctx [:ref :form/r] index :i64 instruction [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :mir/op))
           dst (fget instruction :mir/dst)
           return-register (fget ctx :return-register)
           kept0 (keep-preserved (fget st :assigned) (fget ctx :preserved-set))
           kept (if (and (gmir/vreg? dst) (not (= op :mir/tail-call))) (massoc kept0 dst return-register) kept0)
           lists (rebuild-pool-lists (fget ctx :target) (fget ctx :pool) kept)
           st1 (kassoc (kassoc (kassoc st :assigned kept) :free (fget lists :free)) :reserve (fget lists :reserve))
           st2 (if (and (gmir/vreg? dst)
                        (member-of? (fget ctx :crossing) dst)
                        (> (form/count-of (fget st1 :reserve)) 0))
                 (let [preserved (form/nth-of (fget st1 :reserve) 0)]
                   (kassoc
                    (kassoc
                     (kassoc
                      (kassoc st1 :out (vconj (fget st1 :out) (instr-move preserved return-register)))
                      :assigned (massoc (fget st1 :assigned) dst preserved))
                     :reserve (vrest (fget st1 :reserve)))
                    :free (vconj (fget st1 :free) return-register)))
                 st1)
           expired (values-dying-at (fget st2 :assigned) (fget ctx :last-use) index)
           st3 (expire-assigned-in-pool (fget ctx :target) st2 expired)]
       (if (gmir/vreg? dst)
         (kassoc st3 :def-position (massoc (fget st3 :def-position) dst (fint (form/count-of (fget st3 :out)))))
         st3)))

;; An ordinary (non-recur) call: spill what is live across it, marshal the
;; arguments into the ABI registers, emit the call.
(defn- emit-ordinary-call [st [:ref :form/r] ctx [:ref :form/r] index :i64 instruction [:ref :form/r]] [:ref :form/r]
     (let [arguments (fget instruction :mir/arguments)
           call-registers (vtake (argument-registers-for-call (fget ctx :target) instruction)
                                 (form/count-of arguments))
           st1 (spill-live-across st ctx index)]
       (if (st-failed? st1)
         st1
         (let [copies (call-copies (fget st1 :assigned) arguments call-registers)
               loads (call-loads st1 arguments call-registers)]
           (if (form/is-nil? loads)
             (st-fail st1 :spill-required)
             (let [temp-slot (current-temp-slot st1)
                   scheduled (schedule-parallel-copies copies temp-slot)
                   st2 (absorb-scheduled-copies st1 scheduled temp-slot)
                   st3 (kassoc st2 :out (vconj (vinto (fget st2 :out) loads)
                                               (physicalize-call instruction call-registers (fget ctx :return-register))))]
               (settle-after-call st3 ctx index instruction)))))))

(defn- emit-call [st [:ref :form/r] ctx [:ref :form/r] index :i64 instruction [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :mir/op))
           direct-recur? (and (form/is-true? (fget ctx :direct-reentry?))
                              (= op :mir/tail-call)
                              (form/eq (fget ctx :current-function) (fget instruction :mir/callee))
                              (all-assigned? (fget st :assigned) (fget instruction :mir/arguments)))]
       (if direct-recur?
         (emit-direct-recur st ctx instruction)
         (emit-ordinary-call st ctx index instruction))))

;; ---------------------------------------------------------------------------
;; Kotoba route: the per-instruction step of the linear scan, and the function.
;; ---------------------------------------------------------------------------

(defn- load-one-source [state [:ref :form/r] ctx [:ref :form/r] source [:ref :form/r] protected [:ref :form/r]] [:ref :form/r]
     (let [slot (mget (fget state :backed) source)]
       (if (form/is-nil? slot)
         (st-fail state :spill-required)
         (let [prefer (if (member-of? (fget ctx :crossing) source) :preserved :scratch)
               taken (take-register state ctx protected prefer)]
           (if (st-failed? taken)
             taken
             (let [register (fget taken :taken)]
               (kassoc (kassoc taken :assigned (massoc (fget taken :assigned) source register))
                       :out (vconj (fget taken :out) (instr-spill-load register slot)))))))))

;; Load each of SRCS that is not in a register from its slot.
(defn- load-sources [st [:ref :form/r] ctx [:ref :form/r] srcs [:ref :form/r] protected [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of srcs)]
       (loop [i 0 state st]
         (if (or (>= i n) (st-failed? state)) state
           (let [source (form/nth-of srcs i)]
             (recur (inc i)
                    (if (mhas? (fget state :assigned) source)
                      state
                      (load-one-source state ctx source protected))))))))

;; The register currently holding DESIRED-HOME's value, as the value, or a nil form.
(defn- owner-of-register [assigned [:ref :form/r] register [:ref :form/r]] [:ref :form/r]
     (let [ks (mkeys assigned)
           n (form/count-of ks)]
       (loop [i 0]
         (if (>= i n) (form/nil-form)
           (let [k (form/nth-of ks i)]
             (if (form/eq (mget assigned k) register) k (recur (inc i))))))))

;; A definition may overwrite its requested recur home only when the register is
;; free, or when the old value is an operand whose final use is this very
;; instruction.
(defn- direct-home-for [st [:ref :form/r] ctx [:ref :form/r] index :i64 instruction [:ref :form/r] protected [:ref :form/r] dst [:ref :form/r]] [:ref :form/r]
     (let [desired (mget (fget ctx :recur-home-candidates) dst)]
       (if (form/is-nil? desired)
         (form/nil-form)
         (let [owner (owner-of-register (fget st :assigned) desired)
               recur-use (form/nth-of (mget (fget ctx :indexes) dst) 0)]
           (if (and (schedulable-integer-op? (kw-of (fget instruction :mir/op)))
                    (form/is-int? recur-use)
                    (straight-line-to-recur? (fget ctx :instructions) index (form/int-value recur-use))
                    (or (form/is-nil? owner)
                        (and (member-of? protected owner)
                             (int-eq? (mget (fget ctx :last-use) owner) index))))
             desired
             (form/nil-form))))))

;; Give DST a register: its requested home, else the first of the preferred list,
;; else the dying left operand's register, else whatever `take-register` yields.
(defn- allocate-destination [st [:ref :form/r] ctx [:ref :form/r] index :i64 instruction [:ref :form/r] protected [:ref :form/r] dst [:ref :form/r]] [:ref :form/r]
     (if (mhas? (fget st :assigned) dst)
       (st-fail st :multiple-definition)
       (let [prefer (if (member-of? (fget ctx :crossing) dst) :preserved :scratch)
             direct-home (direct-home-for st ctx index instruction protected dst)
             left (fget instruction :mir/left)
             dying-left (if (and (= prefer :scratch)
                                 (gmir/vreg? left)
                                 (int-eq? (mget (fget ctx :last-use) left) index))
                          (mget (fget st :assigned) left)
                          (form/nil-form))
             primary (if (= prefer :preserved) (fget st :reserve) (fget st :free))
             from-primary (if (> (form/count-of primary) 0) (form/nth-of primary 0) (form/nil-form))
             register (cond (not (form/is-nil? direct-home)) direct-home
                            (not (form/is-nil? from-primary)) from-primary
                            :else dying-left)]
         (if (form/is-nil? register)
           (let [taken (take-register st ctx protected prefer)]
             (if (st-failed? taken)
               taken
               (kassoc taken :assigned (massoc (fget taken :assigned) dst (fget taken :taken)))))
           (let [free2 (if (not (form/is-nil? direct-home))
                         (vremove-members (fget st :free) (form/form-vec (form/one-form direct-home)))
                         (if (and (not (form/is-nil? from-primary)) (= prefer :scratch))
                           (vrest (fget st :free))
                           (fget st :free)))
                 reserve2 (if (not (form/is-nil? direct-home))
                            (vremove-members (fget st :reserve) (form/form-vec (form/one-form direct-home)))
                            (if (and (not (form/is-nil? from-primary)) (= prefer :preserved))
                              (vrest (fget st :reserve))
                              (fget st :reserve)))]
             (kassoc (kassoc (kassoc st :free free2) :reserve reserve2)
                     :assigned (massoc (fget st :assigned) dst register)))))))

;; INSTRUCTION with every vreg replaced by its register (vector arguments
;; element-wise) and the lowered merge operations turned back into spills.
(defn- map-assigned-vector [assigned [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of v)]
       (form/form-vec
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (recur (inc i) (form/append-form acc (mget assigned (form/nth-of v i)))))))))

(defn- rewrite-registers [instruction [:ref :form/r] assigned [:ref :form/r]] [:ref :form/r]
     (let [kids (form/kids-of instruction)
           n (vector-count kids)]
       (form/form-map
        (loop [j 0 acc (form/no-forms)]
          (if (>= (+ j 1) n) acc
            (let [k (typed-list-nth [:list [:ref :form/r]] kids j)
                  v (typed-list-nth [:list [:ref :form/r]] kids (+ j 1))]
              (recur (+ j 2)
                     (form/append-form
                      (form/append-form acc k)
                      (cond
                        (gmir/vreg? v) (mget assigned v)
                        (and (kw? k :mir/arguments) (form/is-vec? v)) (map-assigned-vector assigned v)
                        :else v)))))))))

(defn- lowered-merge-back [allocated [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget allocated :mir/op))]
       (cond
         (= op :mir/merge-store)
         (mk3 :mir/op (kwf :mir/spill-store) :mir/src (fget allocated :mir/src) :mir/slot (fget allocated :mir/slot))
         (= op :mir/merge-load)
         (mk3 :mir/op (kwf :mir/spill-load) :mir/dst (fget allocated :mir/dst) :mir/slot (fget allocated :mir/slot))
         :else allocated)))

;; Values to release after this instruction: dying now, or a definition nothing reads.
(defn- expired-after [assigned [:ref :form/r] last-use [:ref :form/r] index :i64 dst [:ref :form/r]] [:ref :form/r]
     (let [ks (mkeys assigned)
           n (form/count-of ks)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [k (form/nth-of ks i)]
             (recur (inc i)
                    (if (or (int-eq? (mget last-use k) index)
                            (and (form/eq dst k) (not (mhas? last-use k))))
                      (vconj acc k)
                      acc)))))))

;; One non-call instruction: labels reset backed assignments, sources are loaded,
;; the destination gets a register, the instruction is rewritten and dead values
;; are released.
(defn- step-drop-backed [st [:ref :form/r] ctx [:ref :form/r] index :i64 instruction [:ref :form/r]] [:ref :form/r]
     (if (and (kw? (fget instruction :mir/op) :mir/label)
              (> index 0)
              (let [ks (mkeys (fget st :assigned))
                    n (form/count-of ks)]
                (loop [i 0]
                  (if (>= i n) false
                    (if (mhas? (fget st :backed) (form/nth-of ks i)) true (recur (inc i)))))))
       (let [block (drop-backed-assignments (fget ctx :target) (fget ctx :pool) (fget st :assigned) (fget st :backed))]
         (kassoc (kassoc (kassoc st :assigned (fget block :assigned)) :free (fget block :free)) :reserve (fget block :reserve)))
       st))

(defn- step-instruction [st0 [:ref :form/r] ctx [:ref :form/r] index :i64 instruction [:ref :form/r]] [:ref :form/r]
     (let [st1 (step-drop-backed (kassoc st0 :index (fint index)) ctx index instruction)
           srcs (vdistinct (vreg-sources instruction))
           protected (form/form-set (form/kids-of srcs))
           loaded (load-sources st1 ctx srcs protected)]
       (if (st-failed? loaded)
         loaded
         (let [dst (fget instruction :mir/dst)
               with-dst (if (gmir/vreg? dst)
                          (allocate-destination loaded ctx index instruction protected dst)
                          loaded)]
           (if (st-failed? with-dst)
             with-dst
             (let [assigned (fget with-dst :assigned)
                   allocated (lowered-merge-back (rewrite-registers instruction assigned))
                   expired (expired-after assigned (fget ctx :last-use) index dst)
                   out (fget with-dst :out)
                   state2 (if (form/is-true? (fget ctx :calls?))
                            (expire-assigned-in-pool (fget ctx :target) with-dst expired)
                            (expire-assigned with-dst expired))
                   state3 (kassoc state2 :out (vconj out allocated))]
               (if (gmir/vreg? dst)
                 (kassoc state3 :def-position
                         (massoc (fget state3 :def-position) dst (fint (+ 1 (form/count-of out)))))
                 state3)))))))

(defn- step [st [:ref :form/r] ctx [:ref :form/r] index :i64] [:ref :form/r]
     (let [instruction (form/nth-of (fget ctx :instructions) index)]
       (if (call-operation? (kw-of (fget instruction :mir/op)))
         (emit-call (kassoc st :index (fint index)) ctx index instruction)
         (step-instruction st ctx index instruction))))

(defn- run-steps [st [:ref :form/r] ctx [:ref :form/r] from :i64 to :i64] [:ref :form/r]
     (loop [index from state st]
       (if (or (>= index to) (st-failed? state))
         state
         (recur (inc index) (step state ctx index)))))

;; Is there any instruction of OPS-KIND: 0 a call, 1 quotient, 2 control flow,
;; 3 runtime/capability call, 4 a self tail-call of CURRENT.
(defn- any-mir-op? [instructions [:ref :form/r] kind :i64 current [:ref :form/r]] :bool
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) false
           (let [ins (form/nth-of instructions i)
                 op (kw-of (fget ins :mir/op))]
             (if (cond (= kind 0) (call-operation? op)
                       (= kind 1) (or (= op :mir/quotient-constant) (= op :mir/quotient))
                       (= kind 2) (or (= op :mir/label) (= op :mir/branch-zero) (= op :mir/branch-nonzero)
                                      (= op :mir/jump) (= op :mir/phi))
                       (= kind 3) (or (= op :mir/runtime-call) (= op :mir/capability-call))
                       (= kind 4) (and (= op :mir/tail-call) (form/eq current (fget ins :mir/callee)))
                       :else false)
               true
               (recur (inc i))))))))

(defn- argument-dsts [instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 acc (fset)]
         (if (>= i n) acc
           (let [ins (form/nth-of instructions i)]
             (recur (inc i) (if (kw? (fget ins :mir/op) :mir/argument) (sconj acc (fget ins :mir/dst)) acc)))))))

;; The per-function constants of a linear scan.
(defn- allocation-context [program [:ref :form/r] current-function [:ref :form/r]] [:ref :form/r]
     (let [instructions (fget program :mir/instructions)
           target (fget program :mir/target)
           last-use (last-uses instructions)
           indexes (use-indexes instructions)
           calls? (any-mir-op? instructions 0 (form/nil-form))
           quotients? (any-mir-op? instructions 1 (form/nil-form))
           straight-line? (not (any-mir-op? instructions 2 (form/nil-form)))
           pool (if (and (kw? target :x86-64) quotients? (not calls?) straight-line?)
                  (x86-quotient-steered-pool true)
                  (allocator-pool target (kassoc (fmap) :leaf? (form/bool-form (not calls?)))))
           crossing (if calls? (form/form-set (form/kids-of (mkeys (call-live-slots instructions)))) (fset))
           self-tail? (and (not (form/is-nil? current-function)) (any-mir-op? instructions 4 current-function))
           host-calls? (any-mir-op? instructions 3 (form/nil-form))
           x86-direct-reentry? (and (kw? target :x86-64) self-tail? (not host-calls?))
           preserved-entry-values (cond (kw? target :aarch64) crossing
                                        x86-direct-reentry? (argument-dsts instructions)
                                        :else (fset))]
       (kassoc
        (kassoc
         (kassoc
          (kassoc
           (kassoc
            (kassoc
             (kassoc
              (kassoc
               (kassoc
                (kassoc
                 (kassoc
                  (kassoc (fmap) :instructions instructions)
                  :target target)
                 :last-use last-use)
                :indexes indexes)
               :calls? (form/bool-form calls?))
              :pool pool)
             :crossing crossing)
            :preserved-set (form/form-get (preserved-registers) target))
           :return-register (form/form-get (return-registers) target))
          :current-function current-function)
         :self-tail? (form/bool-form self-tail?))
        :preserved-entry-values preserved-entry-values)))

;; The state and context once the entry plan has been applied.
(defn- initial-state [entry [:ref :form/r] direct-reentry? :bool] [:ref :form/r]
     (let [entry-instructions (fget entry :instructions)
           entry-assigned (fget entry :assigned)
           ks (mkeys entry-assigned)
           n (form/count-of ks)
           start (+ (form/count-of entry-instructions) (if direct-reentry? 1 0))
           def-position (loop [i 0 acc (fmap)]
                          (if (>= i n) acc
                            (recur (inc i) (massoc acc (form/nth-of ks i) (fint start)))))
           used-temp? (form/is-true? (fget entry :used-temp?))
           out (if direct-reentry?
                 (vconj entry-instructions (mk2 :mir/op (kwf :mir/reentry) :mir/parameters (fget entry :parameter-homes)))
                 entry-instructions)]
       (kassoc
        (kassoc
         (kassoc
          (kassoc
           (kassoc
            (kassoc
             (kassoc
              (kassoc
               (kassoc (fmap) :assigned entry-assigned)
               :free (fget entry :free))
              :reserve (fget entry :reserve))
             :backed (fget entry :entry-spills))
            :next-slot (fint (+ (ival (fget entry :stable-slot-count)) (if used-temp? 1 0))))
           :out out)
          :used-temp? (form/bool-form used-temp?))
         :temp-slot (if used-temp? (fget entry :temp-slot) (form/nil-form)))
        :def-position def-position)))

(defn- finish-allocation [program [:ref :form/r] st [:ref :form/r]] [:ref :form/r]
     (let [out0 (fget st :out)
           out (if (> (form/count-of (filter-ops out0 5)) 0) out0 (without-reentry out0))
           built (kassoc
                  (kassoc
                   (kassoc
                    (kassoc
                     (kassoc
                      (kassoc (fmap) :mir/version (fget program :mir/version))
                      :mir/target (fget program :mir/target))
                     :mir/registers (kwf :physical))
                    :mir/frame-slots (fint (+ (ival (fget st :next-slot)) (if (form/is-true? (fget st :used-temp?)) 1 0))))
                   :mir/instructions out)
                  :mir/target (fget program :mir/target))
           p (flat-problem built)]
       (if (= p :ok)
         (kassoc (fmap) :program built)
         (kassoc (fmap) :problem (kwf p)))))

(defn- without-reentry [out [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of out)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [ins (form/nth-of out i)]
             (recur (inc i) (if (kw? (fget ins :mir/op) :mir/reentry) acc (vconj acc ins))))))))

;; Linear-scan allocation. The result map has :program, or :problem (the
;; keyword the host would have thrown).
(defn- allocate-without-spills-result [program [:ref :form/r] merge-slots :i64 current-function [:ref :form/r]] [:ref :form/r]
     (if (not (kw? (fget program :mir/registers) :virtual))
       (kassoc (fmap) :problem (kwf :registers-not-virtual))
       (let [ctx0 (allocation-context program current-function)
             instructions (fget ctx0 :instructions)
             target (fget ctx0 :target)
             entry (entry-argument-plan target (fget ctx0 :pool) instructions (fget ctx0 :last-use)
                                        merge-slots (fmap) (fget ctx0 :preserved-entry-values))]
         (if (fhas? entry :problem)
           (kassoc (fmap) :problem (fget entry :problem))
           (let [parameter-homes (fget entry :parameter-homes)
                 self-tail? (form/is-true? (fget ctx0 :self-tail?))
                 x86-direct? (and (kw? target :x86-64) self-tail?
                                  (not (any-mir-op? instructions 3 (form/nil-form))))
                 direct-reentry? (and self-tail?
                                      (or (kw? target :aarch64) x86-direct?)
                                      (not (form/is-nil? parameter-homes)))
                 candidates (if direct-reentry?
                              (direct-recur-home-candidates instructions current-function parameter-homes (fget ctx0 :indexes))
                              (fmap))
                 ctx (kassoc
                      (kassoc
                       (kassoc ctx0 :direct-reentry? (form/bool-form direct-reentry?))
                       :parameter-homes parameter-homes)
                      :recur-home-candidates candidates)
                 st0 (initial-state entry direct-reentry?)
                 done (run-steps st0 ctx (ival (fget entry :argument-count)) (form/count-of instructions))]
             (if (st-failed? done)
               (kassoc (fmap) :problem (fget done :problem))
               (finish-allocation program done)))))))

;; ---------------------------------------------------------------------------
;; Kotoba route: the conservative all-vreg path, allocation policy, stack
;; arguments and the public allocator.
;; ---------------------------------------------------------------------------

;; ---- SSA order and frame-slot interference ----

;; {:ordered vec-of-defined-vregs} or {:problem ...}.
(defn- validate-ssa-definition-order [instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 defined (fset) ordered (fvec)]
         (if (>= i n)
           (kassoc (fmap) :ordered ordered)
           (let [ins (form/nth-of instructions i)
                 srcs (vreg-sources ins)
                 dst (fget ins :mir/dst)]
             (cond
               (not (all-members? srcs defined)) (kassoc (fmap) :problem (kwf :use-before-definition))
               (and (gmir/vreg? dst) (member-of? defined dst)) (kassoc (fmap) :problem (kwf :multiple-definition))
               (gmir/vreg? dst) (recur (inc i) (sconj defined dst) (vconj ordered dst))
               :else (recur (inc i) defined ordered)))))))

(defn- all-members? [xs [:ref :form/r] s [:ref :form/r]] :bool
     (let [n (form/count-of xs)]
       (loop [i 0]
         (if (>= i n) true
           (if (member-of? s (form/nth-of xs i)) (recur (inc i)) false)))))

;; Values whose frame contents INSTRUCTION reads.
(defn- slot-sources [instruction [:ref :form/r]] [:ref :form/r]
     (if (kw? (fget instruction :mir/op) :mir/merge-load)
       (vconj (fvec) (fget instruction :mir/dst))
       (vreg-sources instruction)))

;; The frame value INSTRUCTION defines, or a nil form.
(defn- slot-definition [instruction [:ref :form/r] merge-dst-by-slot [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :mir/op))]
       (cond
         (= op :mir/merge-store) (mget merge-dst-by-slot (fget instruction :mir/slot))
         (= op :mir/merge-load) (form/nil-form)
         :else (instruction-def instruction))))

(defn- slot-block-use-def [instructions [:ref :form/r] blocks [:ref :form/r] merge-dst-by-slot [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of blocks)]
       (loop [b 0 acc (fvec)]
         (if (>= b n) acc
           (let [block (form/nth-of blocks b)]
             (recur (inc b)
                    (vconj acc (slot-block-fold instructions (ival (fget block :start)) (ival (fget block :end)) merge-dst-by-slot))))))))

(defn- slot-block-fold [instructions [:ref :form/r] start :i64 end :i64 merge-dst-by-slot [:ref :form/r]] [:ref :form/r]
     (loop [i start uses (fset) defs (fset)]
       (if (> i end)
         (mk2 :uses uses :defs defs)
         (let [ins (form/nth-of instructions i)
               reads (vremove-members (slot-sources ins) defs)
               definition (slot-definition ins merge-dst-by-slot)
               m (form/count-of reads)
               uses2 (loop [j 0 u uses]
                       (if (>= j m) u (recur (inc j) (sconj u (form/nth-of reads j)))))]
           (recur (inc i) uses2 (if (gmir/vreg? definition) (sconj defs definition) defs))))))

(defn- slot-liveness [instructions [:ref :form/r] merge-dst-by-slot [:ref :form/r]] [:ref :form/r]
     (let [blocks (basic-blocks instructions)
           label->block (label-block-indexes instructions blocks)
           successors (block-successors instructions blocks label->block)
           use-def (slot-block-use-def instructions blocks merge-dst-by-slot)
           none (empty-sets (form/count-of blocks))]
       (loop [live-in none live-out none]
         (let [next-out (next-live-out live-in successors)
               next-in (next-live-in use-def next-out)]
           (if (and (form/eq next-in live-in) (form/eq next-out live-out))
             (mk3 :blocks blocks :live-in next-in :live-out next-out)
             (recur next-in next-out))))))

;; GRAPH with DEFINITION interfering with every value of LIVE (other than itself).
(defn- add-interference [graph [:ref :form/r] definition [:ref :form/r] live [:ref :form/r]] [:ref :form/r]
     (if (not (gmir/vreg? definition))
       graph
       (let [n (form/count-of live)]
         (loop [i 0 g (if (mhas? graph definition) graph (massoc graph definition (fset)))]
           (if (>= i n) g
             (let [value (form/nth-of live i)]
               (recur (inc i)
                      (if (form/eq value definition)
                        g
                        (massoc (massoc g definition (sconj (mget g definition) value))
                                value (sconj (mget g value) definition))))))))))

;; LIVE without DEFINITION (when a vreg), plus the values INSTRUCTION reads.
(defn- live-before [live [:ref :form/r] definition [:ref :form/r] sources [:ref :form/r]] [:ref :form/r]
     (let [base (if (gmir/vreg? definition)
                  (vremove-members live (form/form-vec (form/one-form definition)))
                  live)
           n (form/count-of sources)]
       (loop [i 0 acc (form/form-set (form/kids-of base))]
         (if (>= i n) acc (recur (inc i) (sconj acc (form/nth-of sources i)))))))

(defn- block-interference [graph [:ref :form/r] instructions [:ref :form/r] start :i64 end :i64 live-out [:ref :form/r] merge-dst-by-slot [:ref :form/r]] [:ref :form/r]
     (loop [i end g graph live live-out]
       (if (< i start) g
         (let [ins (form/nth-of instructions i)
               definition (slot-definition ins merge-dst-by-slot)
               g2 (add-interference g definition live)
               live2 (live-before live definition (slot-sources ins))]
           (recur (- i 1) g2 live2)))))

(defn- spill-interference [instructions [:ref :form/r] merge-dst-by-slot [:ref :form/r]] [:ref :form/r]
     (let [liveness (slot-liveness instructions merge-dst-by-slot)
           blocks (fget liveness :blocks)
           live-out (fget liveness :live-out)
           n (form/count-of blocks)]
       (loop [b 0 graph (fmap)]
         (if (>= b n) graph
           (let [block (form/nth-of blocks b)]
             (recur (inc b)
                    (block-interference graph instructions (ival (fget block :start)) (ival (fget block :end))
                                        (form/nth-of live-out b) merge-dst-by-slot)))))))

;; The smallest slot at or above OFFSET that none of NEIGHBOURS already holds,
;; or -1 when the frame is full.
(defn- free-slot [slots [:ref :form/r] neighbours [:ref :form/r] offset :i64] :i64
     (let [taken (taken-slots slots neighbours)]
       (loop [s offset]
         (if (>= s 4096) -1
           (if (member-of? taken (fint s)) (recur (inc s)) s)))))

(defn- taken-slots [slots [:ref :form/r] neighbours [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of neighbours)]
       (loop [i 0 acc (fset)]
         (if (>= i n) acc
           (let [v (form/nth-of neighbours i)]
             (recur (inc i) (if (mhas? slots v) (sconj acc (mget slots v)) acc)))))))

;; {:slots map} or {:problem ...}
(defn- spill-slots [instructions [:ref :form/r] offset :i64 merge-dst-by-slot [:ref :form/r]] [:ref :form/r]
     (let [ordered-result (validate-ssa-definition-order instructions)]
       (if (fhas? ordered-result :problem)
         ordered-result
         (let [ordered (fget ordered-result :ordered)
               interference (spill-interference instructions merge-dst-by-slot)
               n (form/count-of ordered)]
           (loop [i 0 slots (fmap)]
             (if (>= i n)
               (kassoc (fmap) :slots slots)
               (let [value (form/nth-of ordered i)
                     slot (free-slot slots (mget interference value) offset)]
                 (if (< slot 0)
                   (kassoc (fmap) :problem (kwf :spill-frame-too-large))
                   (recur (inc i) (massoc slots value (fint slot)))))))))))

;; ---- the conservative expansion ----

;; All of VALUES have a slot.
(defn- all-slotted? [slots [:ref :form/r] values [:ref :form/r]] :bool
     (let [n (form/count-of values)]
       (loop [i 0]
         (if (>= i n) true
           (if (mhas? slots (form/nth-of values i)) (recur (inc i)) false)))))

(defn- sp-load [slots [:ref :form/r] value [:ref :form/r] register [:ref :form/r]] [:ref :form/r]
     (instr-spill-load register (mget slots value)))

(defn- sp-store [slots [:ref :form/r] value [:ref :form/r] register [:ref :form/r]] [:ref :form/r]
     (instr-spill-store register (mget slots value)))

(defn- ok-expansion [instrs [:ref :form/r]] [:ref :form/r] (kassoc (fmap) :ok instrs))

(defn- bad-expansion [problem :keyword] [:ref :form/r] (kassoc (fmap) :problem (kwf problem)))

(defn- binary-spill-op? [op :keyword] :bool
     (or (arithmetic-op? op)
         (= op :mir/f64-add) (= op :mir/f64-subtract) (= op :mir/f64-multiply) (= op :mir/f64-divide)
         (= op :mir/f64-min) (= op :mir/f64-max)))

(defn- unary-spill-op? [op :keyword] :bool
     (or (= op :mir/f64-sqrt) (= op :mir/f32-sqrt) (= op :mir/f32-to-f64) (= op :mir/f64-to-f32)
         (= op :mir/i64-to-f32) (= op :mir/i64-to-f64)))

(defn- load-op-spill? [op :keyword] :bool
     (or (= op :mir/kernel-load-u8) (= op :mir/kernel-load-u16) (= op :mir/kernel-load-u32) (= op :mir/kernel-load-u64)
         (= op :mir/slice-load-u8) (= op :mir/slice-load-u16) (= op :mir/slice-load-u32) (= op :mir/slice-load-u64)
         (= op :mir/kernel-try-lock-u32) (= op :mir/kernel-unlock-u32)))

(defn- store-op-spill? [op :keyword] :bool
     (or (= op :mir/kernel-store-u8) (= op :mir/kernel-store-u16) (= op :mir/kernel-store-u32) (= op :mir/kernel-store-u64)
         (= op :mir/slice-store-u8) (= op :mir/slice-store-u16) (= op :mir/slice-store-u32) (= op :mir/slice-store-u64)))

(defn- atomic-rw-spill? [op :keyword] :bool
     (or (= op :mir/kernel-atomic-add-u32) (= op :mir/kernel-atomic-add-u64)
         (= op :mir/kernel-xchg-u32) (= op :mir/kernel-xchg-u64)))

(defn- cmpxchg-spill? [op :keyword] :bool
     (or (= op :mir/kernel-cmpxchg-u32) (= op :mir/kernel-cmpxchg-u64)))

(defn- dot-spill? [op :keyword] :bool
     (or (= op :mir/kernel-dot-f32) (= op :mir/kernel-dequant-dot-q8-0)
         (= op :mir/kernel-dequant-dot-q4-k) (= op :mir/kernel-dequant-dot-q6-k)))

;; Loads of the named operand fields of INSTRUCTION into REGISTERS, in order.
(defn- loads-of-fields [slots [:ref :form/r] instruction [:ref :form/r] fields [:ref :form/r] registers [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of fields)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (recur (inc i)
                  (vconj acc (sp-load slots (fget instruction (kw-of (form/nth-of fields i))) (form/nth-of registers i))))))))

;; The fields a family loads, as a vector of keyword forms.
(defn- fields-vec [a :keyword b :keyword c :keyword d :keyword e :keyword] [:ref :form/r]
     (let [v (fvec)
           v1 (if (= a :none) v (vconj v (kwf a)))
           v2 (if (= b :none) v1 (vconj v1 (kwf b)))
           v3 (if (= c :none) v2 (vconj v2 (kwf c)))
           v4 (if (= d :none) v3 (vconj v3 (kwf d)))]
       (if (= e :none) v4 (vconj v4 (kwf e)))))

;; The operand values a family loads.
(defn- operand-values [instruction [:ref :form/r] fields [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of fields)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (recur (inc i) (vconj acc (fget instruction (kw-of (form/nth-of fields i)))))))))

;; Expansion of an instruction that loads FIELDS into REGISTERS, then runs BODY,
;; then stores its DST from STORE-REG (a nil form: no store).
(defn- expand-with [slots [:ref :form/r] instruction [:ref :form/r] fields [:ref :form/r] registers [:ref :form/r] body [:ref :form/r] store-reg [:ref :form/r]] [:ref :form/r]
     (let [values (operand-values instruction fields)
           dst (fget instruction :mir/dst)]
       (if (not (and (all-slotted? slots values)
                     (or (form/is-nil? store-reg) (mhas? slots dst))))
         (bad-expansion :use-before-definition)
         (let [loads (loads-of-fields slots instruction fields registers)
               with-body (vconj loads body)]
           (ok-expansion (if (form/is-nil? store-reg)
                           with-body
                           (vconj with-body (sp-store slots dst store-reg))))))))

;; The instruction map with the given keys, taken from INSTRUCTION's op and
;; maximum, and registers bound to its operand roles.
(defn- body-of [instruction [:ref :form/r] pairs [:ref :form/r]] [:ref :form/r]
     ;; PAIRS is a vector of [role register] pair vectors; :mir/op is always copied
     (let [n (form/count-of pairs)]
       (loop [i 0 acc (kassoc (fmap) :mir/op (fget instruction :mir/op))]
         (if (>= i n) acc
           (let [pair (form/nth-of pairs i)]
             (recur (inc i) (massoc acc (form/nth-of pair 0) (form/nth-of pair 1))))))))

(defn- pr2 [role :keyword register [:ref :form/r]] [:ref :form/r] (form/vec2 (kwf role) register))

(defn- with-maximum [body [:ref :form/r] instruction [:ref :form/r]] [:ref :form/r]
     (kassoc body :mir/maximum (fget instruction :mir/maximum)))

;; Expand the operation families that share a shape, by register role lists.
(defn- expand-shaped [slots [:ref :form/r] instruction [:ref :form/r] abi [:ref :form/r] r0 [:ref :form/r] r1 [:ref :form/r] r2 [:ref :form/r] r3 [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :mir/op))
           c0 (form/nth-of abi 0) c1 (form/nth-of abi 1) c2 (form/nth-of abi 2) c3 (form/nth-of abi 3) c4 (form/nth-of abi 4)]
       (cond
         (binary-spill-op? op)
         (expand-with slots instruction (fields-vec :mir/left :mir/right :none :none :none) (form/vec2 r0 r1)
                      (body-of instruction (vconj (vconj (vconj (fvec) (pr2 :mir/dst r0)) (pr2 :mir/left r0)) (pr2 :mir/right r1)))
                      r0)
         (unary-spill-op? op)
         (expand-with slots instruction (fields-vec :mir/input :none :none :none :none) (vconj (fvec) r0)
                      (body-of instruction (vconj (vconj (fvec) (pr2 :mir/dst r0)) (pr2 :mir/input r0)))
                      r0)
         (load-op-spill? op)
         (expand-with slots instruction (fields-vec :mir/base :mir/length :mir/index :none :none) (vconj (vconj (vconj (fvec) r0) r1) r2)
                      (with-maximum (body-of instruction (vconj (vconj (vconj (vconj (fvec) (pr2 :mir/dst r0)) (pr2 :mir/base r0)) (pr2 :mir/length r1)) (pr2 :mir/index r2))) instruction)
                      r0)
         (store-op-spill? op)
         (expand-with slots instruction (fields-vec :mir/base :mir/length :mir/index :mir/stored :none) (vconj (vconj (vconj (vconj (fvec) r0) r1) r2) r3)
                      (with-maximum (body-of instruction (vconj (vconj (vconj (vconj (vconj (fvec) (pr2 :mir/dst r3)) (pr2 :mir/base r0)) (pr2 :mir/length r1)) (pr2 :mir/index r2)) (pr2 :mir/stored r3))) instruction)
                      r3)
         (atomic-rw-spill? op)
         (expand-with slots instruction (fields-vec :mir/base :mir/length :mir/index :mir/stored :none) (vconj (vconj (vconj (vconj (fvec) r0) r1) r2) r3)
                      (with-maximum (body-of instruction (vconj (vconj (vconj (vconj (vconj (fvec) (pr2 :mir/dst r0)) (pr2 :mir/base r0)) (pr2 :mir/length r1)) (pr2 :mir/index r2)) (pr2 :mir/stored r3))) instruction)
                      r0)
         (cmpxchg-spill? op)
         (expand-with slots instruction (fields-vec :mir/base :mir/length :mir/index :mir/expected :mir/stored) (vconj (vconj (vconj (vconj (vconj (fvec) c0) c1) c2) c3) c4)
                      (with-maximum (body-of instruction (vconj (vconj (vconj (vconj (vconj (vconj (fvec) (pr2 :mir/dst c0)) (pr2 :mir/base c0)) (pr2 :mir/length c1)) (pr2 :mir/index c2)) (pr2 :mir/expected c3)) (pr2 :mir/stored c4))) instruction)
                      c0)
         (dot-spill? op)
         (expand-with slots instruction (fields-vec :mir/base :mir/length :mir/second-base :mir/second-length :mir/count) (vconj (vconj (vconj (vconj (vconj (fvec) c0) c1) c2) c3) c4)
                      (with-maximum (body-of instruction (vconj (vconj (vconj (vconj (vconj (vconj (fvec) (pr2 :mir/dst c0)) (pr2 :mir/base c0)) (pr2 :mir/length c1)) (pr2 :mir/second-base c2)) (pr2 :mir/second-length c3)) (pr2 :mir/count c4))) instruction)
                      c0)
         (= op :mir/kernel-subregion)
         (expand-with slots instruction (fields-vec :mir/base :mir/length :mir/offset :mir/size :none) (vconj (vconj (vconj (vconj (fvec) r0) r1) r2) r3)
                      (body-of instruction (vconj (vconj (vconj (vconj (vconj (fvec) (pr2 :mir/dst r0)) (pr2 :mir/base r0)) (pr2 :mir/length r1)) (pr2 :mir/offset r2)) (pr2 :mir/size r3)))
                      r0)
         :else (bad-expansion :unsupported-spill-operation))))

(defn- shaped-op? [op :keyword] :bool
     (or (binary-spill-op? op) (unary-spill-op? op) (load-op-spill? op) (store-op-spill? op)
         (atomic-rw-spill? op) (cmpxchg-spill? op) (dot-spill? op) (= op :mir/kernel-subregion)))

;; Expansion of the call-like operations: arguments loaded into the ABI registers.
(defn- expand-call-like [slots [:ref :form/r] instruction [:ref :form/r] target [:ref :form/r] r0 [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :mir/op))
           arguments (fget instruction :mir/arguments)
           n (form/count-of arguments)
           call-registers (cond (= op :mir/tail-call) (prefix-of (form/form-get (call-argument-registers) target) n)
                                (= op :mir/x86-privileged) (prefix-of (privileged-argument-registers target) n)
                                :else (prefix-of (argument-registers-for-call target instruction) n))]
       (if (not (all-slotted? slots arguments))
         (bad-expansion :use-before-definition)
         (let [loads (loads-into-registers slots arguments call-registers)
               dst (fget instruction :mir/dst)
               return-register (form/form-get (return-registers) target)]
           (cond
             (= op :mir/x86-privileged)
             (if (mhas? slots dst)
               (ok-expansion (vconj (vconj loads (kassoc (mk3 :mir/op (fget instruction :mir/op) :mir/dst r0 :mir/action (fget instruction :mir/action)) :mir/arguments call-registers))
                                    (sp-store slots dst r0)))
               (bad-expansion :use-before-definition))
             (= op :mir/tail-call)
             (ok-expansion (vconj loads (mk3 :mir/op (kwf :mir/tail-call) :mir/callee (fget instruction :mir/callee) :mir/arguments call-registers)))
             :else
             (if (mhas? slots dst)
               (ok-expansion (vconj (vconj loads (physicalize-call instruction call-registers return-register))
                                    (sp-store slots dst return-register)))
               (bad-expansion :use-before-definition)))))))

(defn- loads-into-registers [slots [:ref :form/r] values [:ref :form/r] registers [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of values)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (recur (inc i) (vconj acc (sp-load slots (form/nth-of values i) (form/nth-of registers i))))))))

;; The expansion of one instruction of the conservative path: {:ok vec} or {:problem}.
(defn- expand-spill-instruction [slots [:ref :form/r] merge-dst-by-slot [:ref :form/r] target [:ref :form/r] instruction [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :mir/op))
           phys (form/form-get (physical-registers) target)
           r0 (form/nth-of phys 0) r1 (form/nth-of phys 1) r2 (form/nth-of phys 2) r3 (form/nth-of phys 3)
           abi (form/form-get (call-argument-registers) target)
           dst (fget instruction :mir/dst)]
       (cond
         (= op :mir/argument)
         (let [idx (fget instruction :mir/index)]
           (cond
             (not (and (form/is-int? idx) (>= (form/int-value idx) 0) (< (form/int-value idx) (form/count-of abi))))
             (bad-expansion :argument-index-invalid)
             (not (mhas? slots dst)) (bad-expansion :use-before-definition)
             :else (ok-expansion (vconj (vconj (fvec) (kassoc instruction :mir/dst (form/nth-of abi (form/int-value idx))))
                                        (sp-store slots dst (form/nth-of abi (form/int-value idx)))))))
         (or (= op :mir/constant) (= op :mir/data-address) (= op :mir/rodata-address) (= op :mir/function-address))
         (if (mhas? slots dst)
           (ok-expansion (vconj (vconj (fvec) (kassoc instruction :mir/dst r0)) (sp-store slots dst r0)))
           (bad-expansion :use-before-definition))
         (= op :mir/merge-store)
         (let [phi-dst (mget merge-dst-by-slot (fget instruction :mir/slot))]
           (cond
             (form/is-nil? phi-dst) (bad-expansion :unknown-merge-slot)
             (not (and (mhas? slots (fget instruction :mir/src)) (mhas? slots phi-dst))) (bad-expansion :use-before-definition)
             :else (ok-expansion (vconj (vconj (fvec) (sp-load slots (fget instruction :mir/src) r0))
                                        (sp-store slots phi-dst r0)))))
         (= op :mir/merge-load) (ok-expansion (fvec))
         (= op :mir/quotient-constant)
         (expand-with slots instruction (fields-vec :mir/left :none :none :none :none) (vconj (fvec) r0)
                      (body-of instruction (vconj (vconj (vconj (fvec) (pr2 :mir/dst r0)) (pr2 :mir/left r0))
                                                  (form/vec2 (kwf :mir/divisor) (fget instruction :mir/divisor))))
                      r0)
         (shaped-op? op) (expand-shaped slots instruction abi r0 r1 r2 r3)
         (or (= op :mir/x86-privileged) (= op :mir/tail-call) (= op :mir/call) (= op :mir/runtime-call) (= op :mir/capability-call))
         (expand-call-like slots instruction target r0)
         (or (= op :mir/branch-zero) (= op :mir/branch-nonzero))
         (if (mhas? slots (fget instruction :mir/test))
           (ok-expansion (vconj (vconj (fvec) (sp-load slots (fget instruction :mir/test) r0)) (kassoc instruction :mir/test r0)))
           (bad-expansion :use-before-definition))
         (= op :mir/return)
         (if (mhas? slots (fget instruction :mir/value))
           (ok-expansion (vconj (vconj (fvec) (sp-load slots (fget instruction :mir/value) r0)) (kassoc instruction :mir/value r0)))
           (bad-expansion :use-before-definition))
         (or (= op :mir/label) (= op :mir/jump)) (ok-expansion (vconj (fvec) instruction))
         :else (bad-expansion :unsupported-spill-operation))))

(defn- expand-all-spill [slots [:ref :form/r] merge-dst-by-slot [:ref :form/r] target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 out (fvec)]
         (if (>= i n) (kassoc (fmap) :ok out)
           (let [r (expand-spill-instruction slots merge-dst-by-slot target (form/nth-of instructions i))]
             (if (fhas? r :problem)
               r
               (recur (inc i) (vinto out (fget r :ok)))))))))

;; The highest slot + 1, or 0.
(defn- slot-count-of [slots [:ref :form/r]] :i64
     (let [vs (mvals slots)
           n (form/count-of vs)]
       (loop [i 0 best -1]
         (if (>= i n) (+ best 1)
           (let [v (ival (form/nth-of vs i))]
             (recur (inc i) (if (> v best) v best)))))))

;; Allocate every value a frame slot and reload around each use: the path for
;; bodies the linear scan cannot fit. {:program p} or {:problem kw}.
(defn- allocate-with-spills-result [program [:ref :form/r] merge-dst-by-slot [:ref :form/r]] [:ref :form/r]
     (let [instructions (fget program :mir/instructions)
           target (fget program :mir/target)
           sl (spill-slots instructions 0 merge-dst-by-slot)]
       (if (fhas? sl :problem)
         sl
         (let [slots (fget sl :slots)
               slot-count (slot-count-of slots)]
           (if (> slot-count 4095)
             (kassoc (fmap) :problem (kwf :spill-frame-too-large))
             (let [expanded (expand-all-spill slots merge-dst-by-slot target instructions)]
               (if (fhas? expanded :problem)
                 expanded
                 (let [built (kassoc
                              (kassoc
                               (kassoc
                                (kassoc
                                 (kassoc
                                  (kassoc (fmap) :mir/version (fget program :mir/version))
                                  :mir/target target)
                                 :mir/registers (kwf :physical))
                                :mir/frame-slots (fint slot-count))
                               :mir/instructions (fget expanded :ok))
                              :mir/target target)
                       p (flat-problem built)]
                   (if (= p :ok)
                     (kassoc (fmap) :program built)
                     (kassoc (fmap) :problem (kwf p)))))))))))

nil

nil

nil

nil

nil

