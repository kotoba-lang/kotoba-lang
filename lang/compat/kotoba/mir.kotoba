        (:out
         (reduce (fn [dd__85426_1 dd__85426_2]
                   (let [label (fe-get dd__85426_1 :label)
                         out (fe-get dd__85426_1 :out)
                         op (fe-get dd__85426_2 :mir/op)
                         target (fe-get dd__85426_2 :mir/target)
                         dst (fe-get dd__85426_2 :mir/dst)
