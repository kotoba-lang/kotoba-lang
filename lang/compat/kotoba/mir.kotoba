(ns kotoba.mir
  "Closed target-selected Machine IR and deterministic allocation."
  {:kotoba/export [allocate-registers allocate-registers-result allocator-pool call-argument-registers capability-argument-registers capability-context-offsets counted-self-recur-plan counted-self-recur-plans counted-self-recur-plans-result instruction-keysets kernel-atomic-ops kernel-dequant-dot-maximum kernel-dequant-dot-operations kernel-dot-f32-maximum kernel-window-maxima kernel-window-operations leaf-registers physical-registers preserved-registers privileged-argument-registers return-registers runtime-argument-registers runtime-context-offsets saved-registers select-target select-target-result slice-item-limit slice-operations supported-versions targets validate! validate-problem version]}
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :form/rd [:record :form/rd [[:form [:ref :form/r]] [:pos :i64]]]})
  (:require [kotoba.form :as form]
            [kotoba.gmir :as gmir]))

(defn- kslot [m [:ref :form/r] k :keyword] :i64
     (let [xs (form/kids-of m) n (vector-count xs)]
       (loop [j 0]
         (if (>= (+ j 1) n) -1
           (let [x (typed-list-nth [:list [:ref :form/r]] xs j)]
             (if (and (form/is-keyword? x) (= (form/keyword-value x) k)) j (recur (+ j 2))))))))

(defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r]
     (let [j (kslot m k)] (if (< j 0) (form/nil-form) (typed-list-nth [:list [:ref :form/r]] (form/kids-of m) (+ j 1)))))

(defn- fhas? [m [:ref :form/r] k :keyword] :bool (>= (kslot m k) 0))

(defn- kw-of [f [:ref :form/r]] :keyword
     (if (form/is-keyword? f) (form/keyword-value f) :none))

(defn- kw? [f [:ref :form/r] k :keyword] :bool
     (and (form/is-keyword? f) (= (form/keyword-value f) k)))

(defn- int-eq? [f [:ref :form/r] n :i64] :bool
     (and (form/is-int? f) (= (form/int-value f) n)))

(defn- int-in? [f [:ref :form/r] lo :i64 hi :i64] :bool
     (and (form/is-int? f) (<= lo (form/int-value f)) (<= (form/int-value f) hi)))

(defn- member-of? [xs [:ref :form/r] x [:ref :form/r]] :bool
     (let [kids (form/kids-of xs)
           n (vector-count kids)]
       (loop [i 0]
         (if (>= i n) false
           (if (form/eq (typed-list-nth [:list [:ref :form/r]] kids i) x) true (recur (inc i)))))))

(defn- tier [table [:ref :form/r] target [:ref :form/r]] [:list [:ref :form/r]]
     (form/kids-of (form/form-get table target)))

(defn- mentions? [f [:ref :form/r] r [:ref :form/r]] :bool
     (if (form/eq f r)
       true
       (let [kids (form/kids-of f)
             n (vector-count kids)]
         (loop [i 0]
           (if (>= i n) false
             (if (mentions? (typed-list-nth [:list [:ref :form/r]] kids i) r) true (recur (inc i))))))))

(defn- reject! [problem :keyword] :i64
     ;; The host's error carries the offending instruction; the twin, the problem.
     (throw (ex-info "MIR rejected" {:phase :mir :problem problem})))

(defn version [] :i64 3)

(defn supported-versions [] [:ref :form/r] (form/edn-form "#{1 2 3}"))

(defn targets [] [:ref :form/r] (form/edn-form "#{:x86-64 :aarch64}"))

(defn physical-registers [] [:ref :form/r] (form/edn-form "{:x86-64 [:x86-64/rax :x86-64/rcx :x86-64/rdx :x86-64/r8] :aarch64 [:aarch64/x0 :aarch64/x1 :aarch64/x2 :aarch64/x3]}"))

(defn leaf-registers [] [:ref :form/r] (form/edn-form "{:x86-64 [:x86-64/rdi :x86-64/rsi] :aarch64 [:aarch64/x5 :aarch64/x6 :aarch64/x8 :aarch64/x9 :aarch64/x10 :aarch64/x11 :aarch64/x12]}"))

(defn preserved-registers [] [:ref :form/r] (form/edn-form "{:x86-64 [:x86-64/rbx :x86-64/r12 :x86-64/r13 :x86-64/r14 :x86-64/r15] :aarch64 [:aarch64/x19 :aarch64/x20 :aarch64/x21 :aarch64/x22 :aarch64/x23 :aarch64/x24 :aarch64/x25 :aarch64/x26]}"))

(defn privileged-argument-registers [target [:ref :form/r]] [:ref :form/r]
     (form/form-vec (form/append-many (tier (physical-registers) target)
                                      (tier (preserved-registers) target))))

(defn allocator-pool [target [:ref :form/r] options [:ref :form/r]] [:ref :form/r]
     (form/form-vec
      (form/append-many
       (if (let [lf (fget options :leaf?)] (not (or (form/is-nil? lf) (and (form/is-bool? lf) (= 0 (form/int-value lf))))))
         (form/append-many (tier (physical-registers) target) (tier (leaf-registers) target))
         (tier (physical-registers) target))
       (tier (preserved-registers) target))))

(defn- x86-quotient-steered-pool [leaf? :bool] [:ref :form/r]
     (form/form-vec
      (form/append-many
       (form/append-many (form/two-forms (form/keyword-form :x86-64/rcx) (form/keyword-form :x86-64/r8))
                         (if leaf? (tier (leaf-registers) (form/keyword-form :x86-64)) (form/no-forms)))
       (tier (preserved-registers) (form/keyword-form :x86-64)))))

(defn saved-registers [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (let [pres (tier (preserved-registers) target)
           n (vector-count pres)]
       (form/form-vec
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (let [r (typed-list-nth [:list [:ref :form/r]] pres i)]
              (recur (inc i) (if (mentions? instructions r) (form/append-form acc r) acc))))))))

(defn call-argument-registers [] [:ref :form/r] (form/edn-form "{:x86-64 [:x86-64/rdi :x86-64/rsi :x86-64/rdx :x86-64/rcx :x86-64/r8] :aarch64 [:aarch64/x0 :aarch64/x1 :aarch64/x2 :aarch64/x3 :aarch64/x4]}"))

(defn runtime-argument-registers [] [:ref :form/r] (form/edn-form "{:x86-64 [:x86-64/rsi :x86-64/rdx :x86-64/rcx :x86-64/r8] :aarch64 [:aarch64/x1 :aarch64/x2 :aarch64/x3 :aarch64/x4]}"))

(defn runtime-context-offsets [] [:ref :form/r] (form/edn-form "{:pair 56 :pair-first 64 :pair-second 72 :kgraph-assert! 80 :kgraph-get 88 :kgraph-count 96 :kgraph-entity-at 104 :string-byte-length 72 :string=? 112 :string-concat 120 :string-substring 136 :string-code-point-at 144 :vector-new-empty 152 :vector-conj 160 :vector-count 168 :vector-at 176 :vector-assoc 184 :vector-drop 192 :vector-alloc 200 :vector-assoc-in-place 208 :string-index-of 216 :arena-enter 224 :arena-leave 232 :string-compare 240 :string-fold-ascii 248 :string-find-blank 256 :string-skip-blank 264 :string-index-of-from 272 :string-compare-lines 280 :string-find-byte 336 :string-append-range 344 :string-from-utf8 352 :bytes-from-vector 360 :bytes-slice 368 :bytes-concat 376 :fuel-charge 8 :gas-charge 384}"))

(defn capability-argument-registers [] [:ref :form/r] (form/edn-form "{:x86-64 {:i64 [:x86-64/rdx] :string [:x86-64/r8] :option-i64 [:x86-64/r8] :result-i64 [:x86-64/r8] :clock-v1 [:x86-64/r8] :dataspace-v1 [:x86-64/r8] :ui-commit-v1 [:x86-64/r8] :ui-event-v1 [:x86-64/r8] :bytes-v1 [:x86-64/r8] :string-bytes-v1 [:x86-64/r8]} :aarch64 {:i64 [:aarch64/x2] :string [:aarch64/x4] :option-i64 [:aarch64/x4] :result-i64 [:aarch64/x4] :clock-v1 [:aarch64/x4] :dataspace-v1 [:aarch64/x4] :ui-commit-v1 [:aarch64/x4] :ui-event-v1 [:aarch64/x4] :bytes-v1 [:aarch64/x4] :string-bytes-v1 [:aarch64/x4]}}"))

(defn capability-context-offsets [] [:ref :form/r] (form/edn-form "{:i64 48 :string 128 :option-i64 128 :result-i64 128 :clock-v1 128 :dataspace-v1 128 :ui-commit-v1 128 :ui-event-v1 128 :bytes-v1 128 :string-bytes-v1 128}"))

(defn return-registers [] [:ref :form/r] (form/edn-form "{:x86-64 :x86-64/rax :aarch64 :aarch64/x0}"))

nil

nil

(defn- stack-argument-ops [] [:ref :form/r] (form/edn-form "#{:mir/incoming-load :mir/outgoing-argument :mir/incoming-argument-store}"))

(defn instruction-keysets [] [:ref :form/r]
     (form/edn-form "{:mir/add #{:mir/dst :mir/left :mir/op :mir/right}, :mir/argument #{:mir/dst :mir/index :mir/op}, :mir/bit-and #{:mir/dst :mir/left :mir/op :mir/right}, :mir/bit-or #{:mir/dst :mir/left :mir/op :mir/right}, :mir/bit-xor #{:mir/dst :mir/left :mir/op :mir/right}, :mir/branch-nonzero #{:mir/op :mir/target :mir/test}, :mir/branch-zero #{:mir/op :mir/target :mir/test}, :mir/call #{:mir/arguments :mir/callee :mir/dst :mir/op}, :mir/capability-call #{:mir/arguments :mir/capability :mir/context-offset :mir/dst :mir/kind :mir/op}, :mir/constant #{:mir/dst :mir/op :mir/value}, :mir/data-address #{:mir/content :mir/dst :mir/op}, :mir/equal #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-add #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-divide #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-equal #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-greater-or-equal #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-greater-than #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-less-or-equal #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-less-than #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-multiply #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-sqrt #{:mir/dst :mir/input :mir/op}, :mir/f32-subtract #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-to-f64 #{:mir/dst :mir/input :mir/op}, :mir/f32-unordered #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-add #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-divide #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-equal #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-greater-or-equal #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-greater-than #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-less-or-equal #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-less-than #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-max #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-min #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-multiply #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-sqrt #{:mir/dst :mir/input :mir/op}, :mir/f64-subtract #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-to-f32 #{:mir/dst :mir/input :mir/op}, :mir/f64-unordered #{:mir/dst :mir/left :mir/op :mir/right}, :mir/function-address #{:mir/dst :mir/function :mir/op}, :mir/greater-or-equal #{:mir/dst :mir/left :mir/op :mir/right}, :mir/greater-than #{:mir/dst :mir/left :mir/op :mir/right}, :mir/i64-to-f32 #{:mir/dst :mir/input :mir/op}, :mir/i64-to-f64 #{:mir/dst :mir/input :mir/op}, :mir/incoming-argument-store #{:mir/index :mir/op :mir/src}, :mir/incoming-load #{:mir/dst :mir/index :mir/op}, :mir/jump #{:mir/op :mir/target}, :mir/kernel-atomic-add-u32 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/kernel-atomic-add-u64 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/kernel-cmpxchg-u32 #{:mir/base :mir/dst :mir/expected :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/kernel-cmpxchg-u64 #{:mir/base :mir/dst :mir/expected :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/kernel-dequant-dot-iq2-s #{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}, :mir/kernel-dequant-dot-iq3-s #{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}, :mir/kernel-dequant-dot-ptq1-0 #{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}, :mir/kernel-dequant-dot-iq3-xxs #{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}, :mir/kernel-dequant-dot-iq4-xs #{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}, :mir/kernel-dequant-dot-q4-k #{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}, :mir/kernel-dequant-dot-q6-k #{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}, :mir/kernel-dequant-dot-q8-0 #{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}, :mir/kernel-dot-f32 #{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}, :mir/kernel-load-u16 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/kernel-load-u32 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/kernel-load-u64 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/kernel-load-u8 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/kernel-store-u16 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/kernel-store-u32 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/kernel-store-u64 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/kernel-store-u8 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/kernel-subregion #{:mir/base :mir/dst :mir/length :mir/offset :mir/op :mir/size}, :mir/kernel-try-lock-u32 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/kernel-unlock-u32 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/kernel-xchg-u32 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/kernel-xchg-u64 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/label #{:mir/id :mir/op}, :mir/less-or-equal #{:mir/dst :mir/left :mir/op :mir/right}, :mir/less-than #{:mir/dst :mir/left :mir/op :mir/right}, :mir/move #{:mir/dst :mir/op :mir/src}, :mir/multiply #{:mir/dst :mir/left :mir/op :mir/right}, :mir/multiply-add #{:mir/addend :mir/dst :mir/left :mir/op :mir/right}, :mir/multiply-subtract #{:mir/addend :mir/dst :mir/left :mir/op :mir/right}, :mir/outgoing-argument #{:mir/index :mir/op :mir/src}, :mir/phi #{:mir/dst :mir/incomings :mir/op}, :mir/quotient #{:mir/dst :mir/left :mir/op :mir/right}, :mir/quotient-constant #{:mir/divisor :mir/dst :mir/left :mir/op}, :mir/recur #{:mir/arguments :mir/op}, :mir/reentry #{:mir/op :mir/parameters}, :mir/return #{:mir/op :mir/value}, :mir/rodata-address #{:mir/content :mir/dst :mir/op :mir/rodata-encoding}, :mir/runtime-call #{:mir/arguments :mir/context-offset :mir/dst :mir/op :mir/runtime}, :mir/shift-left #{:mir/dst :mir/left :mir/op :mir/right}, :mir/shift-right-signed #{:mir/dst :mir/left :mir/op :mir/right}, :mir/shift-right-unsigned #{:mir/dst :mir/left :mir/op :mir/right}, :mir/slice-load-u16 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/slice-load-u32 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/slice-load-u64 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/slice-load-u8 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/slice-store-u16 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/slice-store-u32 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/slice-store-u64 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/slice-store-u8 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/spill-load #{:mir/dst :mir/op :mir/slot}, :mir/spill-store #{:mir/op :mir/slot :mir/src}, :mir/subtract #{:mir/dst :mir/left :mir/op :mir/right}, :mir/tail-call #{:mir/arguments :mir/callee :mir/op}, :mir/x86-privileged #{:mir/action :mir/arguments :mir/dst :mir/op}}"))

(defn kernel-window-operations [] [:ref :form/r] (form/edn-form "#{:mir/kernel-load-u8 :mir/kernel-store-u8 :mir/kernel-load-u16 :mir/kernel-store-u16 :mir/kernel-load-u32 :mir/kernel-store-u32 :mir/kernel-load-u64 :mir/kernel-store-u64}"))

(defn kernel-window-maxima [] [:ref :form/r] (form/edn-form "#{512 4096 16384 65536}"))

(defn slice-operations [] [:ref :form/r] (form/edn-form "#{:mir/slice-load-u8 :mir/slice-store-u8 :mir/slice-load-u16 :mir/slice-store-u16 :mir/slice-load-u32 :mir/slice-store-u32 :mir/slice-load-u64 :mir/slice-store-u64}"))

(defn slice-item-limit [] :i64 1099511627776)

(defn kernel-atomic-ops [] [:ref :form/r]
     (form/edn-form "#{:mir/kernel-atomic-add-u32 :mir/kernel-atomic-add-u64 :mir/kernel-xchg-u32 :mir/kernel-xchg-u64 :mir/kernel-cmpxchg-u32 :mir/kernel-cmpxchg-u64}"))

(defn kernel-dot-f32-maximum [] :i64 65536)

(defn kernel-dequant-dot-operations [] [:ref :form/r]
     (form/edn-form "#{:mir/kernel-dequant-dot-q8-0 :mir/kernel-dequant-dot-q4-k :mir/kernel-dequant-dot-q6-k :mir/kernel-dequant-dot-iq4-xs :mir/kernel-dequant-dot-iq2-s :mir/kernel-dequant-dot-iq3-xxs :mir/kernel-dequant-dot-iq3-s :mir/kernel-dequant-dot-ptq1-0}"))

(defn kernel-dequant-dot-maximum [] :i64 65536)

(defn- indexed-memory-operations [] [:ref :form/r]
     (form/edn-form "#{:mir/kernel-try-lock-u32 :mir/kernel-unlock-u32 :mir/kernel-load-u8 :mir/kernel-store-u8 :mir/kernel-load-u16 :mir/kernel-store-u16 :mir/kernel-load-u32 :mir/kernel-store-u32 :mir/kernel-load-u64 :mir/kernel-store-u64 :mir/slice-load-u8 :mir/slice-store-u8 :mir/slice-load-u16 :mir/slice-store-u16 :mir/slice-load-u32 :mir/slice-store-u32 :mir/slice-load-u64 :mir/slice-store-u64 :mir/kernel-atomic-add-u32 :mir/kernel-atomic-add-u64 :mir/kernel-xchg-u32 :mir/kernel-xchg-u64 :mir/kernel-cmpxchg-u32 :mir/kernel-cmpxchg-u64}"))

(defn instruction-known-op? [op :keyword] :bool
     (form/form-has? (instruction-keysets) (form/keyword-form op)))

(defn- arithmetic-op-0? [op :keyword] :bool
     (or (= op :mir/add) (= op :mir/bit-and) (= op :mir/bit-or) (= op :mir/bit-xor) (= op :mir/equal) (= op :mir/f32-add) (= op :mir/f32-divide) (= op :mir/f32-equal) (= op :mir/f32-greater-or-equal) (= op :mir/f32-greater-than) (= op :mir/f32-less-or-equal) (= op :mir/f32-less-than) (= op :mir/f32-multiply) (= op :mir/f32-subtract) (= op :mir/f32-unordered) (= op :mir/f64-add) (= op :mir/f64-divide) (= op :mir/f64-equal) (= op :mir/f64-greater-or-equal) (= op :mir/f64-greater-than) (= op :mir/f64-less-or-equal) (= op :mir/f64-less-than) (= op :mir/f64-max) (= op :mir/f64-min)))

(defn- arithmetic-op-1? [op :keyword] :bool
     (or (= op :mir/f64-multiply) (= op :mir/f64-subtract) (= op :mir/f64-unordered) (= op :mir/greater-or-equal) (= op :mir/greater-than) (= op :mir/less-or-equal) (= op :mir/less-than) (= op :mir/multiply) (= op :mir/quotient) (= op :mir/shift-left) (= op :mir/shift-right-signed) (= op :mir/shift-right-unsigned) (= op :mir/subtract)))

(defn- arithmetic-op? [op :keyword] :bool
     (or (arithmetic-op-0? op) (arithmetic-op-1? op)))

(defn- keyset-text-of [op :keyword] :string
     (cond
       (arithmetic-op? op) "#{:mir/dst :mir/left :mir/op :mir/right}"
       (or (= op :mir/argument) (= op :mir/incoming-load)) "#{:mir/dst :mir/index :mir/op}"
       (or (= op :mir/branch-nonzero) (= op :mir/branch-zero)) "#{:mir/op :mir/target :mir/test}"
       (or (= op :mir/call)) "#{:mir/arguments :mir/callee :mir/dst :mir/op}"
       (or (= op :mir/capability-call)) "#{:mir/arguments :mir/capability :mir/context-offset :mir/dst :mir/kind :mir/op}"
       (or (= op :mir/constant)) "#{:mir/dst :mir/op :mir/value}"
       (or (= op :mir/data-address)) "#{:mir/content :mir/dst :mir/op}"
       (or (= op :mir/f32-sqrt) (= op :mir/f32-to-f64) (= op :mir/f64-sqrt) (= op :mir/f64-to-f32) (= op :mir/i64-to-f32) (= op :mir/i64-to-f64)) "#{:mir/dst :mir/input :mir/op}"
       (or (= op :mir/function-address)) "#{:mir/dst :mir/function :mir/op}"
       (or (= op :mir/incoming-argument-store) (= op :mir/outgoing-argument)) "#{:mir/index :mir/op :mir/src}"
       (or (= op :mir/jump)) "#{:mir/op :mir/target}"
       (or (= op :mir/kernel-atomic-add-u32) (= op :mir/kernel-atomic-add-u64) (= op :mir/kernel-store-u16) (= op :mir/kernel-store-u32) (= op :mir/kernel-store-u64) (= op :mir/kernel-store-u8) (= op :mir/kernel-xchg-u32) (= op :mir/kernel-xchg-u64) (= op :mir/slice-store-u16) (= op :mir/slice-store-u32) (= op :mir/slice-store-u64) (= op :mir/slice-store-u8)) "#{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}"
       (or (= op :mir/kernel-cmpxchg-u32) (= op :mir/kernel-cmpxchg-u64)) "#{:mir/base :mir/dst :mir/expected :mir/index :mir/length :mir/maximum :mir/op :mir/stored}"
       (or (= op :mir/kernel-dequant-dot-iq2-s) (= op :mir/kernel-dequant-dot-iq3-s) (= op :mir/kernel-dequant-dot-ptq1-0) (= op :mir/kernel-dequant-dot-iq3-xxs) (= op :mir/kernel-dequant-dot-iq4-xs) (= op :mir/kernel-dequant-dot-q4-k) (= op :mir/kernel-dequant-dot-q6-k) (= op :mir/kernel-dequant-dot-q8-0) (= op :mir/kernel-dot-f32)) "#{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}"
       (or (= op :mir/kernel-load-u16) (= op :mir/kernel-load-u32) (= op :mir/kernel-load-u64) (= op :mir/kernel-load-u8) (= op :mir/kernel-try-lock-u32) (= op :mir/kernel-unlock-u32) (= op :mir/slice-load-u16) (= op :mir/slice-load-u32) (= op :mir/slice-load-u64) (= op :mir/slice-load-u8)) "#{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}"
       (or (= op :mir/kernel-subregion)) "#{:mir/base :mir/dst :mir/length :mir/offset :mir/op :mir/size}"
       (or (= op :mir/label)) "#{:mir/id :mir/op}"
       (or (= op :mir/move)) "#{:mir/dst :mir/op :mir/src}"
       (or (= op :mir/multiply-add) (= op :mir/multiply-subtract)) "#{:mir/addend :mir/dst :mir/left :mir/op :mir/right}"
       (or (= op :mir/phi)) "#{:mir/dst :mir/incomings :mir/op}"
       (or (= op :mir/quotient-constant)) "#{:mir/divisor :mir/dst :mir/left :mir/op}"
       (or (= op :mir/recur)) "#{:mir/arguments :mir/op}"
       (or (= op :mir/reentry)) "#{:mir/op :mir/parameters}"
       (or (= op :mir/return)) "#{:mir/op :mir/value}"
       (or (= op :mir/rodata-address)) "#{:mir/content :mir/dst :mir/op :mir/rodata-encoding}"
       (or (= op :mir/runtime-call)) "#{:mir/arguments :mir/context-offset :mir/dst :mir/op :mir/runtime}"
       (or (= op :mir/spill-load)) "#{:mir/dst :mir/op :mir/slot}"
       (or (= op :mir/spill-store)) "#{:mir/op :mir/slot :mir/src}"
       (or (= op :mir/tail-call)) "#{:mir/arguments :mir/callee :mir/op}"
       (or (= op :mir/x86-privileged)) "#{:mir/action :mir/arguments :mir/dst :mir/op}"
       :else ""))

(defn- known-op? [op :keyword] :bool
     (not (string=? (keyset-text-of op) "")))

(defn- keyset-matches? [op :keyword keys [:ref :form/r]] :bool
     (let [t (keyset-text-of op)]
       (and (not (string=? t "")) (form/eq (form/edn-form t) keys))))

(defn instruction-keyset-of [op :keyword] [:ref :form/r]
     (form/form-get (instruction-keysets) (form/keyword-form op)))

(defn instruction-keyset-is? [op :keyword keys [:ref :form/r]] :bool
     (and (instruction-known-op? op)
          (form/eq (instruction-keyset-of op) keys)))

(defn- v2-excluded? [op :keyword] :bool
     (or (= op :mir/call) (= op :mir/tail-call) (= op :mir/quotient-constant)
         (= op :mir/branch-nonzero) (= op :mir/reentry) (= op :mir/recur)))

(defn- operation-allowed? [program-version :i64 op :keyword] :bool
     (and (known-op? op)
          (cond
            (= program-version 1) (and (not (= op :mir/phi)) (not (v2-excluded? op)))
            (= program-version 2) (not (v2-excluded? op))
            (= program-version 3) true
            :else false)))

nil

(defn- window-op? [op :keyword] :bool
     (or (= op :mir/kernel-load-u8) (= op :mir/kernel-store-u8) (= op :mir/kernel-load-u16) (= op :mir/kernel-store-u16) (= op :mir/kernel-load-u32) (= op :mir/kernel-store-u32) (= op :mir/kernel-load-u64) (= op :mir/kernel-store-u64)))

(defn- slice-op? [op :keyword] :bool
     (or (= op :mir/slice-load-u8) (= op :mir/slice-store-u8) (= op :mir/slice-load-u16) (= op :mir/slice-store-u16) (= op :mir/slice-load-u32) (= op :mir/slice-store-u32) (= op :mir/slice-load-u64) (= op :mir/slice-store-u64)))

(defn- atomic-op? [op :keyword] :bool
     (or (= op :mir/kernel-atomic-add-u32) (= op :mir/kernel-atomic-add-u64) (= op :mir/kernel-xchg-u32) (= op :mir/kernel-xchg-u64) (= op :mir/kernel-cmpxchg-u32) (= op :mir/kernel-cmpxchg-u64)))

(defn- dequant-op? [op :keyword] :bool
     (or (= op :mir/kernel-dequant-dot-q8-0) (= op :mir/kernel-dequant-dot-q4-k) (= op :mir/kernel-dequant-dot-q6-k) (= op :mir/kernel-dequant-dot-iq4-xs) (= op :mir/kernel-dequant-dot-iq2-s) (= op :mir/kernel-dequant-dot-iq3-xxs) (= op :mir/kernel-dequant-dot-iq3-s) (= op :mir/kernel-dequant-dot-ptq1-0)))

(defn- lock-op? [op :keyword] :bool
     (or (= op :mir/kernel-try-lock-u32) (= op :mir/kernel-unlock-u32)))

(defn- stack-argument-op? [op :keyword] :bool
     (or (= op :mir/incoming-load) (= op :mir/outgoing-argument) (= op :mir/incoming-argument-store)))

(defn- value-op-listed-0? [op :keyword] :bool
     (or (= op :mir/argument) (= op :mir/constant) (= op :mir/add) (= op :mir/subtract) (= op :mir/multiply) (= op :mir/quotient) (= op :mir/quotient-constant) (= op :mir/bit-and) (= op :mir/bit-or) (= op :mir/bit-xor) (= op :mir/shift-left) (= op :mir/shift-right-signed) (= op :mir/shift-right-unsigned) (= op :mir/f64-add) (= op :mir/f64-subtract) (= op :mir/f64-multiply) (= op :mir/f64-divide) (= op :mir/f64-min) (= op :mir/f64-max) (= op :mir/f64-sqrt) (= op :mir/f64-equal) (= op :mir/f64-less-than) (= op :mir/f64-less-or-equal) (= op :mir/f64-greater-than)))

(defn- value-op-listed-1? [op :keyword] :bool
     (or (= op :mir/f64-greater-or-equal) (= op :mir/f64-unordered) (= op :mir/f32-add) (= op :mir/f32-subtract) (= op :mir/f32-multiply) (= op :mir/f32-divide) (= op :mir/f32-sqrt) (= op :mir/f32-equal) (= op :mir/f32-less-than) (= op :mir/f32-less-or-equal) (= op :mir/f32-greater-than) (= op :mir/f32-greater-or-equal) (= op :mir/f32-unordered) (= op :mir/f32-to-f64) (= op :mir/f64-to-f32) (= op :mir/i64-to-f32) (= op :mir/i64-to-f64) (= op :mir/kernel-load-u8) (= op :mir/kernel-store-u8) (= op :mir/kernel-load-u32) (= op :mir/kernel-store-u32) (= op :mir/kernel-try-lock-u32) (= op :mir/kernel-unlock-u32) (= op :mir/kernel-subregion)))

(defn- value-op-listed-2? [op :keyword] :bool
     (or (= op :mir/kernel-dot-f32) (= op :mir/kernel-dequant-dot-q8-0) (= op :mir/kernel-dequant-dot-q4-k) (= op :mir/kernel-dequant-dot-q6-k) (= op :mir/kernel-dequant-dot-iq4-xs) (= op :mir/kernel-dequant-dot-iq2-s) (= op :mir/kernel-dequant-dot-iq3-xxs) (= op :mir/kernel-dequant-dot-iq3-s) (= op :mir/kernel-dequant-dot-ptq1-0) (= op :mir/equal) (= op :mir/less-than) (= op :mir/greater-than) (= op :mir/less-or-equal) (= op :mir/greater-or-equal) (= op :mir/call) (= op :mir/runtime-call) (= op :mir/capability-call) (= op :mir/x86-privileged) (= op :mir/data-address) (= op :mir/rodata-address) (= op :mir/function-address)))

(defn- value-op-listed? [op :keyword] :bool
     (or (value-op-listed-0? op) (value-op-listed-1? op) (value-op-listed-2? op)))

(defn- indexed-memory-op? [op :keyword] :bool
     (or (lock-op? op) (window-op? op) (slice-op? op) (atomic-op? op)))

(defn- window-maximum? [f [:ref :form/r]] :bool
     (or (int-eq? f 512) (int-eq? f 4096) (int-eq? f 16384) (int-eq? f 65536)))

(defn- physical-register-kw? [target :keyword k :keyword] :bool
     (if (= target :x86-64)
       (or (= k :x86-64/rax) (= k :x86-64/rcx) (= k :x86-64/rdx) (= k :x86-64/r8)
           (= k :x86-64/rdi) (= k :x86-64/rsi)
           (= k :x86-64/rbx) (= k :x86-64/r12) (= k :x86-64/r13) (= k :x86-64/r14) (= k :x86-64/r15))
       (if (= target :aarch64)
         (or (= k :aarch64/x0) (= k :aarch64/x1) (= k :aarch64/x2) (= k :aarch64/x3) (= k :aarch64/x4)
             (= k :aarch64/x5) (= k :aarch64/x6) (= k :aarch64/x8) (= k :aarch64/x9) (= k :aarch64/x10)
             (= k :aarch64/x11) (= k :aarch64/x12)
             (= k :aarch64/x19) (= k :aarch64/x20) (= k :aarch64/x21) (= k :aarch64/x22)
             (= k :aarch64/x23) (= k :aarch64/x24) (= k :aarch64/x25) (= k :aarch64/x26))
         false)))

(defn- call-register-count [target :keyword] :i64
     (if (or (= target :x86-64) (= target :aarch64)) 5 0))

(defn- fvec [] [:ref :form/r] (form/form-vec (form/no-forms)))

(defn- fmap [] [:ref :form/r] (form/form-map (form/no-forms)))

(defn- fset [] [:ref :form/r] (form/form-set (form/no-forms)))

(defn- vconj [v [:ref :form/r] x [:ref :form/r]] [:ref :form/r]
     (form/form-vec (form/append-form (form/kids-of v) x)))

(defn- vinto [v [:ref :form/r] w [:ref :form/r]] [:ref :form/r]
     (form/form-vec (form/append-many (form/kids-of v) (form/kids-of w))))

(defn- vrest [v [:ref :form/r]] [:ref :form/r]
     (form/form-vec (form/rest-list v)))

(defn- vsub [v [:ref :form/r] from :i64 to :i64] [:ref :form/r]
     (form/form-vec
      (loop [i from acc (form/no-forms)]
        (if (>= i to) acc (recur (inc i) (form/append-form acc (form/nth-of v i)))))))

(defn- vtake [v [:ref :form/r] n :i64] [:ref :form/r]
     (vsub v 0 (if (< n (form/count-of v)) n (form/count-of v))))

(defn- vdrop [v [:ref :form/r] n :i64] [:ref :form/r]
     (vsub v (if (< n (form/count-of v)) n (form/count-of v)) (form/count-of v)))

(defn- vassoc [v [:ref :form/r] i :i64 x [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of v)]
       (form/form-vec
        (loop [j 0 acc (form/no-forms)]
          (if (>= j n) acc
            (recur (inc j) (form/append-form acc (if (= j i) x (form/nth-of v j)))))))))

(defn- vremove-at [v [:ref :form/r] i :i64] [:ref :form/r]
     (let [n (form/count-of v)]
       (form/form-vec
        (loop [j 0 acc (form/no-forms)]
          (if (>= j n) acc
            (recur (inc j) (if (= j i) acc (form/append-form acc (form/nth-of v j)))))))))

(defn- sconj [s [:ref :form/r] x [:ref :form/r]] [:ref :form/r]
     (if (member-of? s x) s (form/form-set (form/append-form (form/kids-of s) x))))

(defn- vremove-members [v [:ref :form/r] s [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of v)]
       (form/form-vec
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (let [x (form/nth-of v i)]
              (recur (inc i) (if (member-of? s x) acc (form/append-form acc x)))))))))

(defn- vkeep-members [v [:ref :form/r] s [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of v)]
       (form/form-vec
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (let [x (form/nth-of v i)]
              (recur (inc i) (if (member-of? s x) (form/append-form acc x) acc))))))))

(defn- vdistinct [v [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of v)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [x (form/nth-of v i)]
             (recur (inc i) (if (member-of? acc x) acc (vconj acc x))))))))

(defn- vindex-of [v [:ref :form/r] x [:ref :form/r]] :i64
     (let [n (form/count-of v)]
       (loop [i 0]
         (if (>= i n) -1
           (if (form/eq (form/nth-of v i) x) i (recur (inc i)))))))

(defn- mget [m [:ref :form/r] k [:ref :form/r]] [:ref :form/r] (form/form-get m k))

(defn- mhas? [m [:ref :form/r] k [:ref :form/r]] :bool (form/form-has? m k))

(defn- massoc [m [:ref :form/r] k [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
     (form/assoc-form m k v))

(defn- mdissoc [m [:ref :form/r] k [:ref :form/r]] [:ref :form/r]
     (form/dissoc-form m k))

(defn- kassoc [m [:ref :form/r] k :keyword v [:ref :form/r]] [:ref :form/r]
     (let [j (kslot m k)]
       (form/assoc-form m (if (< j 0) (form/keyword-form k) (typed-list-nth [:list [:ref :form/r]] (form/kids-of m) j)) v)))

(defn- mkeys [m [:ref :form/r]] [:ref :form/r]
     (let [xs (form/kids-of m)
           n (vector-count xs)]
       (form/form-vec
        (loop [j 0 acc (form/no-forms)]
          (if (>= j n) acc
            (recur (+ j 2) (form/append-form acc (typed-list-nth [:list [:ref :form/r]] xs j))))))))

(defn- mvals [m [:ref :form/r]] [:ref :form/r]
     (let [xs (form/kids-of m)
           n (vector-count xs)]
       (form/form-vec
        (loop [j 1 acc (form/no-forms)]
          (if (>= j n) acc
            (recur (+ j 2) (form/append-form acc (typed-list-nth [:list [:ref :form/r]] xs j))))))))

(defn- mmerge [m [:ref :form/r] n [:ref :form/r]] [:ref :form/r]
     (let [xs (form/kids-of n)
           c (vector-count xs)]
       (loop [j 0 acc m]
         (if (>= (+ j 1) c) acc
           (recur (+ j 2) (form/assoc-form acc (typed-list-nth [:list [:ref :form/r]] xs j)
                                           (typed-list-nth [:list [:ref :form/r]] xs (+ j 1))))))))

(defn- fint [n :i64] [:ref :form/r] (form/int-form n))

(defn- ival [f [:ref :form/r]] :i64
     (if (form/is-int? f) (form/int-value f) 0))

(defn- ival-or [f [:ref :form/r] default :i64] :i64
     (if (form/is-int? f) (form/int-value f) default))

(defn- kwf [k :keyword] [:ref :form/r] (form/keyword-form k))

(defn- kw-text [f [:ref :form/r]] :string
     (document-edn-print (document-keyword (form/keyword-value f))))

(defn- physical-register? [target [:ref :form/r] value [:ref :form/r]] :bool
     (and (form/is-keyword? value)
          (physical-register-kw? (kw-of target) (form/keyword-value value))))

(defn- register? [virtual? :bool target [:ref :form/r] value [:ref :form/r]] :bool
     (if virtual? (gmir/vreg? value) (physical-register? target value)))

(defn- call-operation? [op :keyword] :bool
     (or (= op :mir/call) (= op :mir/tail-call) (= op :mir/runtime-call) (= op :mir/capability-call)))

(defn- prefix-of [xs [:ref :form/r] n :i64] [:ref :form/r]
     (form/form-vec
      (loop [i 0 acc (form/no-forms)]
        (if (>= i n) acc (recur (inc i) (form/append-form acc (form/nth-of xs i)))))))

(defn- all-registers? [virtual? :bool target [:ref :form/r] xs [:ref :form/r]] :bool
     (let [n (form/count-of xs)]
       (loop [i 0]
         (if (>= i n) true
           (if (register? virtual? target (form/nth-of xs i)) (recur (inc i)) false)))))

(defn- field-register-ok? [virtual? :bool target [:ref :form/r] ins [:ref :form/r] k :keyword] :bool
     (let [v (fget ins k)]
       (or (form/is-nil? v) (register? virtual? target v))))

(defn- scalar-registers-ok? [virtual? :bool target [:ref :form/r] ins [:ref :form/r]] :bool
     (and (field-register-ok? virtual? target ins :mir/dst)
          (field-register-ok? virtual? target ins :mir/src)
          (field-register-ok? virtual? target ins :mir/input)
          (field-register-ok? virtual? target ins :mir/left)
          (field-register-ok? virtual? target ins :mir/right)
          (field-register-ok? virtual? target ins :mir/addend)
          (field-register-ok? virtual? target ins :mir/test)
          (field-register-ok? virtual? target ins :mir/base)
          (field-register-ok? virtual? target ins :mir/length)
          (field-register-ok? virtual? target ins :mir/second-base)
          (field-register-ok? virtual? target ins :mir/second-length)
          (field-register-ok? virtual? target ins :mir/count)
          (field-register-ok? virtual? target ins :mir/stored)
          (field-register-ok? virtual? target ins :mir/offset)
          (field-register-ok? virtual? target ins :mir/size)))

(defn- registers-ok? [virtual? :bool target [:ref :form/r] ins [:ref :form/r]] :bool
     (and (scalar-registers-ok? virtual? target ins)
          (let [a (fget ins :mir/arguments)]
            (or (not (form/is-vec? a)) (all-registers? virtual? target a)))
          (let [a (fget ins :mir/parameters)]
            (or (not (form/is-vec? a)) (all-registers? virtual? target a)))))

(defn- phi-incomings-ok? [virtual? :bool target [:ref :form/r] incomings [:ref :form/r]] :bool
     (and (form/is-vec? incomings)
          (let [n (form/count-of incomings)]
            (loop [i 0]
              (if (>= i n) true
                (let [inc-f (form/nth-of incomings i)]
                  (if (and (form/is-map? inc-f)
                           (form/eq (form/keys-of inc-f) (form/edn-form "#{:mir/predecessor :mir/value}"))
                           (gmir/label? (fget inc-f :mir/predecessor))
                           (register? virtual? target (fget inc-f :mir/value)))
                    (recur (inc i))
                    false)))))))

(defn- runtime-call-ok? [ins [:ref :form/r]] :bool
     (let [runtime (fget ins :mir/runtime)
           arities (gmir/runtime-operation-arities)]
       (and (form/form-has? arities runtime)
            (int-eq? (form/form-get arities runtime) (form/count-of (fget ins :mir/arguments)))
            (form/eq (form/form-get (runtime-context-offsets) runtime) (fget ins :mir/context-offset)))))

(defn- runtime-call-physical-ok? [target [:ref :form/r] ins [:ref :form/r]] :bool
     (let [args (fget ins :mir/arguments)]
       (and (form/eq (fget ins :mir/dst) (form/form-get (return-registers) target))
            (form/eq args (prefix-of (form/form-get (runtime-argument-registers) target)
                                     (form/count-of args))))))

(defn- x86-privileged-ok? [target [:ref :form/r] ins [:ref :form/r]] :bool
     (let [action (fget ins :mir/action)
           arities (gmir/x86-privileged-action-arities)]
       (and (kw? target :x86-64)
            (form/form-has? arities action)
            (int-eq? (form/form-get arities action) (form/count-of (fget ins :mir/arguments))))))

(defn- capability-call-ok? [ins [:ref :form/r]] :bool
     (let [kind (fget ins :mir/kind)]
       (and (form/form-has? (gmir/capability-kinds) kind)
            (int-in? (fget ins :mir/capability) 0 255)
            (= 1 (form/count-of (fget ins :mir/arguments)))
            (form/eq (form/form-get (capability-context-offsets) kind) (fget ins :mir/context-offset)))))

(defn- capability-call-physical-ok? [target [:ref :form/r] ins [:ref :form/r]] :bool
     (and (form/eq (fget ins :mir/dst) (form/form-get (return-registers) target))
          (form/eq (fget ins :mir/arguments)
                   (form/form-get (form/form-get (capability-argument-registers) target) (fget ins :mir/kind)))))

(defn- direct-call-shape-ok? [version :i64 ins [:ref :form/r]] :bool
     (let [args (fget ins :mir/arguments)]
       (and (= 3 version)
            (gmir/function-id? (fget ins :mir/callee))
            (form/is-vec? args)
            (<= (form/count-of args) (gmir/max-arity)))))

(defn- direct-call-physical-ok? [op :keyword target [:ref :form/r] ins [:ref :form/r]] :bool
     (let [args (fget ins :mir/arguments)
           regs (form/form-get (call-argument-registers) target)]
       (and (or (= op :mir/tail-call)
                (form/eq (fget ins :mir/dst) (form/form-get (return-registers) target)))
            (<= (form/count-of args) (form/count-of regs))
            (form/eq args (prefix-of regs (form/count-of args))))))

(defn- arity-vector-ok? [v [:ref :form/r]] :bool
     (and (form/is-vec? v) (<= (form/count-of v) (gmir/max-arity))))

(defn- profile-problem [version :i64 virtual? :bool target [:ref :form/r] ins [:ref :form/r]] :keyword
     (let [opf (fget ins :mir/op)
           op (kw-of opf)
           maximum (fget ins :mir/maximum)]
       (cond
         (not (and (operation-allowed? version op)
                   (keyset-matches? op (form/keys-of ins)))) :non-canonical-instruction
         (and virtual? (or (= op :mir/spill-load) (= op :mir/spill-store) (= op :mir/move))) :physical-operation-in-virtual-program
         (and (or (= op :mir/reentry) (= op :mir/recur)) (or virtual? (not (= 3 version)))) :direct-reentry-profile-violation
         (and virtual? (or (= op :mir/multiply-add) (= op :mir/multiply-subtract))) :target-selected-operation-in-virtual-program
         (and (= op :mir/branch-nonzero) (not (kw? target :aarch64))) :target-selected-operation-target-mismatch
         (not (registers-ok? virtual? target ins)) :register-profile-violation
         (and (indexed-memory-op? op)
              (not (register? virtual? target (fget ins :mir/index)))) :register-profile-violation
         (and (window-op? op)
              (not (window-maximum? maximum))) :invalid-kernel-memory-maximum
         (and (slice-op? op)
              (not (int-eq? maximum (slice-item-limit)))) :invalid-kernel-memory-maximum
         (and (lock-op? op)
              (not (int-eq? maximum 4096))) :invalid-kernel-memory-maximum
         (and (atomic-op? op)
              (not (int-eq? maximum 4096))) :invalid-kernel-memory-maximum
         (and (= op :mir/kernel-dot-f32)
              (not (int-eq? maximum (kernel-dot-f32-maximum)))) :invalid-kernel-memory-maximum
         (and (dequant-op? op)
              (not (int-eq? maximum (kernel-dequant-dot-maximum)))) :invalid-kernel-memory-maximum
         (and (= op :mir/return) (not (register? virtual? target (fget ins :mir/value)))) :register-profile-violation
         :else :ok)))

(defn- transfer-problem [version :i64 virtual? :bool target [:ref :form/r] ins [:ref :form/r]] :keyword
     (let [op (kw-of (fget ins :mir/op))
           direct? (or (= op :mir/call) (= op :mir/tail-call))]
       (cond
         (and (= op :mir/phi) (not virtual?)) :phi-in-physical-program
         (and (= op :mir/phi)
              (not (phi-incomings-ok? virtual? target (fget ins :mir/incomings)))) :invalid-phi-incomings
         (and direct? (not (direct-call-shape-ok? version ins))) :invalid-call
         (and direct? (not virtual?)
              (not (direct-call-physical-ok? op target ins))) :physical-call-profile-violation
         (and (= op :mir/reentry) (not (arity-vector-ok? (fget ins :mir/parameters)))) :invalid-direct-reentry
         (and (= op :mir/recur) (not (arity-vector-ok? (fget ins :mir/arguments)))) :invalid-direct-recur
         (and (= op :mir/runtime-call) (not (runtime-call-ok? ins))) :invalid-runtime-call
         (and (= op :mir/runtime-call) (not virtual?)
              (not (runtime-call-physical-ok? target ins))) :physical-runtime-call-profile-violation
         (and (= op :mir/x86-privileged) (not (x86-privileged-ok? target ins))) :invalid-x86-privileged
         (and (= op :mir/capability-call) (not (capability-call-ok? ins))) :invalid-capability-call
         (and (= op :mir/capability-call) (not virtual?)
              (not (capability-call-physical-ok? target ins))) :physical-capability-call-profile-violation
         :else :ok)))

(defn- operand-problem [virtual? :bool target [:ref :form/r] frame-slots [:ref :form/r] ins [:ref :form/r]] :keyword
     (let [opf (fget ins :mir/op)
           op (kw-of opf)
           index (fget ins :mir/index)
           slot (fget ins :mir/slot)
           id (if (= op :mir/label) (fget ins :mir/id) (fget ins :mir/target))]
       (cond
         (and (= op :mir/constant) (not (gmir/i64-value? (fget ins :mir/value)))) :constant-not-i64
         (and (= op :mir/quotient-constant) (not (gmir/i64-value? (fget ins :mir/divisor)))) :constant-divisor-not-i64
         (and (= op :mir/data-address) (not (form/is-string? (fget ins :mir/content)))) :invalid-data-content
         (and (= op :mir/rodata-address)
              (not (gmir/rodata-content? (fget ins :mir/rodata-encoding) (fget ins :mir/content)))) :invalid-rodata-content
         (and (= op :mir/function-address) (not (gmir/function-id? (fget ins :mir/function)))) :invalid-function-address
         (and (= op :mir/argument)
              (not (and (form/is-int? index) (>= (form/int-value index) 0)))) :argument-index-invalid
         (and (or (= op :mir/spill-load) (= op :mir/spill-store))
              (not (and (form/is-int? slot)
                        (form/is-int? frame-slots)
                        (<= 0 (form/int-value slot))
                        (< (form/int-value slot) (form/int-value frame-slots))))) :spill-slot-invalid
         (and (stack-argument-op? op)
              (not (and (form/is-int? index)
                        (<= (call-register-count (kw-of target)) (form/int-value index))
                        (< (form/int-value index) (gmir/max-arity))))) :stack-argument-index-invalid
         (and (or (= op :mir/label) (= op :mir/branch-zero) (= op :mir/branch-nonzero) (= op :mir/jump))
              (not (gmir/label? id))) :invalid-label
         :else :ok)))

(defn- instruction-problem [version :i64 virtual? :bool target [:ref :form/r] frame-slots [:ref :form/r] ins [:ref :form/r]] :keyword
     (let [a (profile-problem version virtual? target ins)]
       (if (= a :ok)
         (let [b (transfer-problem version virtual? target ins)]
           (if (= b :ok)
             (operand-problem virtual? target frame-slots ins)
             b))
         a)))

(defn- each-instruction-problem [version :i64 virtual? :bool target [:ref :form/r] frame-slots [:ref :form/r] instructions [:ref :form/r]] :keyword
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) :ok
           (let [p (instruction-problem version virtual? target frame-slots (form/nth-of instructions i))]
             (if (= p :ok) (recur (inc i)) p))))))

(defn- label-index [instructions [:ref :form/r] id [:ref :form/r] limit :i64] :i64
     (loop [i 0]
       (if (>= i limit) -1
         (let [ins (form/nth-of instructions i)]
           (if (and (kw? (fget ins :mir/op) :mir/label) (form/eq (fget ins :mir/id) id))
             i
             (recur (inc i)))))))

(defn- duplicate-label? [instructions [:ref :form/r]] :bool
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) false
           (let [ins (form/nth-of instructions i)]
             (if (and (kw? (fget ins :mir/op) :mir/label)
                      (>= (label-index instructions (fget ins :mir/id) i) 0))
               true
               (recur (inc i))))))))

(defn- unresolved-target? [instructions [:ref :form/r]] :bool
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) false
           (let [t (fget (form/nth-of instructions i) :mir/target)]
             (if (and (not (form/is-nil? t)) (< (label-index instructions t n) 0))
               true
               (recur (inc i))))))))

(defn- flat-shape-ok? [program [:ref :form/r]] :bool
     (let [version (fget program :mir/version)
           registers (kw-of (fget program :mir/registers))
           frame-slots (fget program :mir/frame-slots)]
       (and (form/is-map? program)
            (or (form/eq (form/keys-of program)
                         (form/edn-form "#{:mir/version :mir/target :mir/registers :mir/instructions}"))
                (form/eq (form/keys-of program)
                         (form/edn-form "#{:mir/version :mir/target :mir/registers :mir/instructions :mir/frame-slots}")))
            (int-in? version 1 3)
            (member-of? (targets) (fget program :mir/target))
            (or (= registers :virtual) (= registers :physical))
            (form/is-vec? (fget program :mir/instructions))
            (or (form/is-nil? frame-slots)
                (and (= registers :physical)
                     (int-in? frame-slots 0 4095))))))

(defn- flat-parts-problem [version :i64 target [:ref :form/r] registers :keyword frame-slots [:ref :form/r] instructions [:ref :form/r]] :keyword
     (let [virtual? (= registers :virtual)
           p (each-instruction-problem version virtual? target frame-slots instructions)]
       (cond
         (not (= p :ok)) p
         (duplicate-label? instructions) :duplicate-label
         (unresolved-target? instructions) :unresolved-target
         :else :ok)))

(defn- flat-problem [program [:ref :form/r]] :keyword
     (if (flat-shape-ok? program)
       (flat-parts-problem (form/int-value (fget program :mir/version))
                           (fget program :mir/target)
                           (kw-of (fget program :mir/registers))
                           (fget program :mir/frame-slots)
                           (fget program :mir/instructions))
       :non-canonical-program))

(defn- function-named [functions [:ref :form/r] name [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of functions)]
       (loop [i 0]
         (if (>= i n) (form/nil-form)
           (let [f (form/nth-of functions i)]
             (if (form/eq (fget f :mir/name) name) f (recur (inc i))))))))

(defn- distinct-names? [names [:ref :form/r]] :bool
     (let [n (form/count-of names)]
       (loop [i 0]
         (if (>= i n) true
           (let [x (form/nth-of names i)]
             (if (loop [j 0]
                   (if (>= j i) false (if (form/eq (form/nth-of names j) x) true (recur (inc j)))))
               false
               (recur (inc i))))))))

(defn- all-function-ids? [names [:ref :form/r]] :bool
     (let [n (form/count-of names)]
       (loop [i 0]
         (if (>= i n) true
           (if (gmir/function-id? (form/nth-of names i)) (recur (inc i)) false)))))

(defn- names-of [functions [:ref :form/r]] [:ref :form/r]
     (form/form-vec
      (let [n (form/count-of functions)]
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (recur (inc i) (form/append-form acc (fget (form/nth-of functions i) :mir/name))))))))

(defn- op-matches? [kind :i64 op :keyword] :bool
     (cond
       (= kind 0) (or (call-operation? op) (= op :mir/recur))
       (= kind 1) (or (= op :mir/call) (= op :mir/tail-call))
       (= kind 2) (= op :mir/argument)
       (= kind 3) (= op :mir/incoming-load)
       (= kind 4) (= op :mir/reentry)
       (= kind 5) (= op :mir/recur)
       :else false))

(defn- filter-ops [instructions [:ref :form/r] kind :i64] [:ref :form/r]
     (form/form-vec
      (let [n (form/count-of instructions)]
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (let [ins (form/nth-of instructions i)]
              (recur (inc i)
                     (if (op-matches? kind (kw-of (fget ins :mir/op))) (form/append-form acc ins) acc))))))))

(defn- field-vec [xs [:ref :form/r] field :keyword] [:ref :form/r]
     (form/form-vec
      (let [n (form/count-of xs)]
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (recur (inc i) (form/append-form acc (fget (form/nth-of xs i) field))))))))

(defn- range-vec [n :i64] [:ref :form/r]
     (form/form-vec
      (loop [i 0 acc (form/no-forms)]
        (if (>= i n) acc (recur (inc i) (form/append-form acc (form/int-form i)))))))

(defn- all-index-below? [xs [:ref :form/r] arity :i64] :bool
     (let [n (form/count-of xs)]
       (loop [i 0]
         (if (>= i n) true
           (let [x (fget (form/nth-of xs i) :mir/index)]
             (if (and (form/is-int? x) (< (form/int-value x) arity)) (recur (inc i)) false))))))

(defn- entry-arguments-ok? [target [:ref :form/r] arity :i64 instructions [:ref :form/r]] :bool
     (let [regs (form/form-get (call-argument-registers) target)
           register-arity (if (< arity (form/count-of regs)) arity (form/count-of regs))
           arguments (filter-ops instructions 2)]
       (and (= register-arity (form/count-of arguments))
            (form/eq (range-vec register-arity) (field-vec arguments :mir/index))
            (form/eq (prefix-of regs register-arity) (field-vec arguments :mir/dst))
            (all-index-below? (filter-ops instructions 3) arity))))

(defn- prefix-state-ok? [instructions [:ref :form/r] from :i64 to :i64 registers [:ref :form/r] slots [:ref :form/r]] [:ref :form/r]
     ;; Returns the final registers map, or a nil form when the prefix is invalid.
     (if (>= from to)
       registers
       (let [ins (form/nth-of instructions from)
             op (kw-of (fget ins :mir/op))
             src (fget ins :mir/src)
             dst (fget ins :mir/dst)
             slot (fget ins :mir/slot)]
         (cond
           (= op :mir/move)
           (if (form/form-has? registers src)
             (prefix-state-ok? instructions (inc from) to (form/assoc-form registers dst (form/form-get registers src)) slots)
             (form/nil-form))
           (= op :mir/spill-store)
           (if (form/form-has? registers src)
             (prefix-state-ok? instructions (inc from) to registers (form/assoc-form slots slot (form/form-get registers src)))
             (form/nil-form))
           (= op :mir/spill-load)
           (if (form/form-has? slots slot)
             (prefix-state-ok? instructions (inc from) to (form/assoc-form registers dst (form/form-get slots slot)) slots)
             (form/nil-form))
           :else (form/nil-form)))))

(defn- initial-registers [abi [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (>= i (form/count-of abi))
       acc
       (initial-registers abi (inc i) (form/assoc-form acc (form/nth-of abi i) (form/int-form i)))))

(defn- parameters-map-home? [registers [:ref :form/r] parameters [:ref :form/r] arity :i64] :bool
     (let [n (form/count-of parameters)]
       (and (= n arity)
            (loop [i 0]
              (if (>= i n) true
                (let [p (form/nth-of parameters i)]
                  (if (and (form/form-has? registers p) (int-eq? (form/form-get registers p) i))
                    (recur (inc i))
                    false)))))))

(defn- valid-direct-reentry-prefix? [target [:ref :form/r] arity :i64 instructions [:ref :form/r] reentry-index :i64 parameters [:ref :form/r]] :bool
     (let [abi (prefix-of (form/form-get (call-argument-registers) target) arity)
           n (form/count-of instructions)
           prefix-count (if (< arity n) arity n)
           prefix (prefix-of instructions prefix-count)]
       (and (= arity prefix-count)
            (form/eq (range-vec arity) (field-vec prefix :mir/index))
            (form/eq abi (field-vec prefix :mir/dst))
            (= prefix-count (form/count-of (filter-ops prefix 2)))
            (<= arity reentry-index)
            (let [result (prefix-state-ok? instructions arity reentry-index
                                           (initial-registers abi 0 (form/form-map (form/no-forms)))
                                           (form/form-map (form/no-forms)))]
              (and (form/is-map? result)
                   (parameters-map-home? result parameters arity))))))

(defn- first-reentry-index [instructions [:ref :form/r]] :i64
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) -1
           (if (kw? (fget (form/nth-of instructions i) :mir/op) :mir/reentry) i (recur (inc i)))))))

(defn- recur-terminates? [instructions [:ref :form/r]] :bool
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) true
           (if (kw? (fget (form/nth-of instructions i) :mir/op) :mir/recur)
             (if (or (>= (inc i) n) (kw? (fget (form/nth-of instructions (inc i)) :mir/op) :mir/label))
               (recur (inc i))
               false)
             (recur (inc i)))))))

(defn- every-arguments-eq? [recurs [:ref :form/r] parameters [:ref :form/r]] :bool
     (let [n (form/count-of recurs)]
       (loop [i 0]
         (if (>= i n) true
           (if (form/eq parameters (fget (form/nth-of recurs i) :mir/arguments)) (recur (inc i)) false)))))

(defn- reentry-contract-ok? [target [:ref :form/r] arity :i64 instructions [:ref :form/r]] :bool
     (let [regs (form/form-get (call-argument-registers) target)
           register-arity (if (< arity (form/count-of regs)) arity (form/count-of regs))
           reentries (filter-ops instructions 4)
           recurs (filter-ops instructions 5)]
       (if (> (form/count-of recurs) 0)
         (let [params (fget (form/nth-of reentries 0) :mir/parameters)]
           (and (= 1 (form/count-of reentries))
                (= register-arity (form/count-of params))
                (and (= register-arity (form/count-of params)) (distinct-names? params))
                (valid-direct-reentry-prefix? target register-arity instructions
                                              (first-reentry-index instructions) params)
                (recur-terminates? instructions)
                (every-arguments-eq? recurs params)))
         (= 0 (form/count-of reentries)))))

(defn- value-op? [opf [:ref :form/r]] :bool
     (let [op (kw-of opf)]
       (or (window-op? op) (slice-op? op) (atomic-op? op) (value-op-listed? op))))

(defn- unbacked-value? [instructions [:ref :form/r]] :bool
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) false
           (let [ins (form/nth-of instructions i)]
             (if (value-op? (fget ins :mir/op))
               (let [store (form/nth-of instructions (inc i))]
                 (if (and (kw? (fget store :mir/op) :mir/spill-store)
                          (form/eq (fget ins :mir/dst) (fget store :mir/src)))
                   (recur (inc i))
                   true))
               (recur (inc i))))))))

(defn- slice-vec [xs [:ref :form/r] from :i64 n :i64] [:ref :form/r]
     (form/form-vec
      (loop [i 0 acc (form/no-forms)]
        (if (>= i n) acc (recur (inc i) (form/append-form acc (form/nth-of xs (+ from i))))))))

(defn- all-spill-loads? [xs [:ref :form/r]] :bool
     (let [n (form/count-of xs)]
       (loop [i 0]
         (if (>= i n) true
           (if (kw? (fget (form/nth-of xs i) :mir/op) :mir/spill-load) (recur (inc i)) false)))))

(defn- call-loads-ok? [instructions [:ref :form/r] index :i64 arguments [:ref :form/r]] :bool
     (let [k (form/count-of arguments)]
       (and (>= index k)
            (let [loads (slice-vec instructions (- index k) k)]
              (and (all-spill-loads? loads)
                   (form/eq arguments (field-vec loads :mir/dst)))))))

(defn- non-parallel-call-arguments? [instructions [:ref :form/r]] :bool
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) false
           (let [ins (form/nth-of instructions i)]
             (if (call-operation? (kw-of (fget ins :mir/op)))
               (if (call-loads-ok? instructions i (fget ins :mir/arguments))
                 (recur (inc i))
                 true)
               (recur (inc i))))))))

(defn- has-index? [pending [:list [:ref :form/r]] idx :i64] :bool
     (let [n (vector-count pending)]
       (loop [i 0]
         (if (>= i n) false
           (if (int-eq? (fget (typed-list-nth [:list [:ref :form/r]] pending i) :mir/index) idx)
             true
             (recur (inc i)))))))

(defn- pending-covers? [pending [:list [:ref :form/r]] from :i64 w :i64] :bool
     (loop [k 0]
       (if (>= k w) true
         (if (has-index? pending (+ from k)) (recur (inc k)) false))))

(defn- pending-all-op? [pending [:list [:ref :form/r]] op :keyword] :bool
     (let [n (vector-count pending)]
       (loop [i 0]
         (if (>= i n) true
           (if (kw? (fget (typed-list-nth [:list [:ref :form/r]] pending i) :mir/op) op)
             (recur (inc i))
             false)))))

(defn- callee-arity-of [op :keyword ins [:ref :form/r] arity :i64 functions [:ref :form/r]] :i64
     (cond
       (or (= op :mir/call) (= op :mir/tail-call))
       (let [f (function-named functions (fget ins :mir/callee))
             a (fget f :mir/arity)]
         (if (form/is-int? a) (form/int-value a) 0))
       (= op :mir/recur) arity
       :else 0))

(defn- pending-ok? [pending [:list [:ref :form/r]] op :keyword register-count :i64 callee-arity :i64] :bool
     (let [w (if (> callee-arity register-count) (- callee-arity register-count) 0)
           expected-op (if (or (= op :mir/tail-call) (= op :mir/recur))
                         :mir/incoming-argument-store
                         :mir/outgoing-argument)]
       (and (= w (vector-count pending))
            (pending-covers? pending register-count w)
            (pending-all-op? pending expected-op))))

(defn- stack-arguments-ok? [target [:ref :form/r] arity :i64 functions [:ref :form/r] instructions [:ref :form/r]] :bool
     (let [register-count (call-register-count (kw-of target))
           n (form/count-of instructions)]
       (loop [i 0 pending (form/no-forms)]
         (if (>= i n)
           (= 0 (vector-count pending))
           (let [ins (form/nth-of instructions i)
                 op (kw-of (fget ins :mir/op))]
             (cond
               (or (= op :mir/outgoing-argument) (= op :mir/incoming-argument-store))
               (recur (inc i) (form/append-form pending ins))
               (or (call-operation? op) (= op :mir/recur))
               (if (pending-ok? pending op register-count (callee-arity-of op ins arity functions))
                 (recur (inc i) (form/no-forms))
                 false)
               :else (recur (inc i) pending)))))))

(defn- direct-calls-problem [physical? :bool target [:ref :form/r] functions [:ref :form/r] instructions [:ref :form/r]] :keyword
     (let [register-count (call-register-count (kw-of target))
           n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) :ok
           (let [ins (form/nth-of instructions i)
                 op (kw-of (fget ins :mir/op))]
             (if (or (= op :mir/call) (= op :mir/tail-call))
               (let [f (function-named functions (fget ins :mir/callee))]
                 (if (form/is-nil? f)
                   :unresolved-callee
                   (let [callee-arity (form/int-value (fget f :mir/arity))
                         expected (if (and physical? (> callee-arity register-count)) register-count callee-arity)]
                     (if (= expected (form/count-of (fget ins :mir/arguments)))
                       (recur (inc i))
                       :call-arity-mismatch))))
               (recur (inc i))))))))

(defn- policy-ok? [calls? :bool policy :keyword] :bool
     (if calls?
       (or (= policy :all-vregs) (= policy :call-live))
       (= policy :allocator)))

(defn- function-shape-ok? [registers :keyword f [:ref :form/r]] :bool
     (let [virtual? (= registers :virtual)
           policy (kw-of (fget f :mir/frame-policy))]
       (and (form/is-map? f)
            (form/eq (form/keys-of f)
                     (if virtual?
                       (form/edn-form "#{:mir/name :mir/arity :mir/instructions}")
                       (form/edn-form "#{:mir/name :mir/arity :mir/frame-slots :mir/frame-policy :mir/instructions}")))
            (gmir/function-id? (fget f :mir/name))
            (int-in? (fget f :mir/arity) 0 (gmir/max-arity))
            (or virtual? (= policy :allocator) (= policy :all-vregs) (= policy :call-live)))))

(defn- function-problem [target [:ref :form/r] registers :keyword functions [:ref :form/r] f [:ref :form/r]] :keyword
     (let [physical? (= registers :physical)
           instructions (fget f :mir/instructions)
           frame-slots (fget f :mir/frame-slots)
           policy (kw-of (fget f :mir/frame-policy))
           arity (if (form/is-int? (fget f :mir/arity)) (form/int-value (fget f :mir/arity)) 0)]
       (cond
         (not (function-shape-ok? registers f)) :non-canonical-function
         (not (and (form/is-vec? instructions)
                   (or (form/is-nil? frame-slots)
                       (and physical? (int-in? frame-slots 0 4095))))) :non-canonical-program
         (not (= :ok (flat-parts-problem 3 target registers frame-slots instructions)))
         (flat-parts-problem 3 target registers frame-slots instructions)
         (and physical? (not (entry-arguments-ok? target arity instructions))) :entry-argument-profile-violation
         (and physical?
              (not (policy-ok? (> (form/count-of (filter-ops instructions 0)) 0) policy))) :call-frame-policy-violation
         (and physical? (not (reentry-contract-ok? target arity instructions))) :invalid-direct-reentry-contract
         (and physical? (= policy :all-vregs) (unbacked-value? instructions)) :unbacked-call-frame-value
         (and physical? (= policy :all-vregs) (non-parallel-call-arguments? instructions)) :non-parallel-call-arguments
         (not (= :ok (direct-calls-problem physical? target functions instructions)))
         (direct-calls-problem physical? target functions instructions)
         (and physical? (not (stack-arguments-ok? target arity functions instructions))) :stack-argument-profile-violation
         :else :ok)))

(defn- functions-problem [target [:ref :form/r] registers :keyword functions [:ref :form/r]] :keyword
     (let [n (form/count-of functions)]
       (loop [i 0]
         (if (>= i n) :ok
           (let [p (function-problem target registers functions (form/nth-of functions i))]
             (if (= p :ok) (recur (inc i)) p))))))

(defn- module-problem [module [:ref :form/r]] :keyword
     (let [target (fget module :mir/target)
           registers (kw-of (fget module :mir/registers))
           entry (fget module :mir/entry)
           functions (fget module :mir/functions)
           names (names-of functions)]
       (cond
         (not (and (form/is-map? module)
                   (form/eq (form/keys-of module)
                            (form/edn-form "#{:mir/version :mir/target :mir/registers :mir/entry :mir/functions}"))
                   (member-of? (targets) target)
                   (or (= registers :virtual) (= registers :physical))
                   (gmir/function-id? entry)
                   (form/is-vec? functions)
                   (> (form/count-of functions) 0))) :non-canonical-module
         (not (and (all-function-ids? names)
                   (distinct-names? names)
                   (member-of? names entry))) :invalid-module-functions
         :else (functions-problem target registers functions))))

(defn validate-problem [program [:ref :form/r]] :keyword
     (if (int-eq? (fget program :mir/version) 3)
       (module-problem program)
       (flat-problem program)))

(defn- gmir-keyword-of [k :keyword] :keyword
     (let [t (document-edn-print (document-keyword k))]
       (keyword-from-string (string-concat "gmir/" (string-substring t 5 (string-byte-length t))))))

(defn- gmir-incoming [incoming [:ref :form/r]] [:ref :form/r]
     (form/form-map
      (form/append-form
       (form/append-form
        (form/append-form
         (form/append-form (form/no-forms) (form/keyword-form :gmir/predecessor))
         (fget incoming :mir/predecessor))
        (form/keyword-form :gmir/value))
       (fget incoming :mir/value))))

(defn- gmir-incomings [incomings [:ref :form/r]] [:ref :form/r]
     (form/form-vec
      (let [n (form/count-of incomings)]
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (recur (inc i) (form/append-form acc (gmir-incoming (form/nth-of incomings i)))))))))

(defn- gmir-instruction [ins [:ref :form/r]] [:ref :form/r]
     (let [kids (form/kids-of ins)
           n (vector-count kids)]
       (form/form-map
        (loop [j 0 acc (form/no-forms)]
          (if (>= (+ j 1) n) acc
            (let [k (typed-list-nth [:list [:ref :form/r]] kids j)
                  v (typed-list-nth [:list [:ref :form/r]] kids (+ j 1))]
              (if (kw? k :mir/context-offset)
                (recur (+ j 2) acc)
                (recur (+ j 2)
                       (form/append-form
                        (form/append-form acc (form/keyword-form (gmir-keyword-of (kw-of k))))
                        (cond
                          (kw? k :mir/op) (form/keyword-form (gmir-keyword-of (kw-of v)))
                          (kw? k :mir/incomings) (gmir-incomings v)
                          :else v))))))))))

(defn- gmir-program-of [instructions [:ref :form/r]] [:ref :form/r]
     (form/form-map
      (form/append-form
       (form/append-form
        (form/append-form
         (form/append-form (form/no-forms) (form/keyword-form :gmir/version))
         (form/int-form 2))
        (form/keyword-form :gmir/instructions))
       (form/form-vec
        (let [n (form/count-of instructions)]
          (loop [i 0 acc (form/no-forms)]
            (if (>= i n) acc
              (recur (inc i) (form/append-form acc (gmir-instruction (form/nth-of instructions i)))))))))))

(defn validate!
     "Validate virtual or physical MIR and return it unchanged. v3 modules own
     independent function frames and a closed scalar direct-call graph. The
     Kotoba twin aborts with the first problem's keyword."
     [program [:ref :form/r]] [:ref :form/r]
     (let [p (validate-problem program)]
       (if (= p :ok)
         (if (and (int-eq? (fget program :mir/version) 2)
                  (kw? (fget program :mir/registers) :virtual))
           (do (gmir/validate! (gmir-program-of (fget program :mir/instructions))) program)
           program)
         (do (reject! p) program))))

nil

nil

(defn- argument-registers-for-call [target [:ref :form/r] instruction [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :mir/op))]
       (cond
         (= op :mir/runtime-call) (form/form-get (runtime-argument-registers) target)
         (= op :mir/capability-call)
         (form/form-get (form/form-get (capability-argument-registers) target) (fget instruction :mir/kind))
         :else (form/form-get (call-argument-registers) target))))

nil

nil

nil

nil

nil

nil

(defn- push-field [acc [:ref :form/r] ins [:ref :form/r] k :keyword] [:ref :form/r]
     (let [v (fget ins k)]
       (if (form/is-nil? v) acc (vconj acc v))))

(defn- source-field-key [i :i64] :keyword
     (cond
       (= i 0) :mir/src
       (= i 1) :mir/input
       (= i 2) :mir/left
       (= i 3) :mir/right
       (= i 4) :mir/addend
       (= i 5) :mir/test
       (= i 6) :mir/value
       (= i 7) :mir/base
       (= i 8) :mir/length
       (= i 9) :mir/expected
       (= i 10) :mir/second-base
       (= i 11) :mir/second-length
       (= i 12) :mir/count
       (= i 13) :mir/stored
       (= i 14) :mir/offset
       (= i 15) :mir/size
       :else :none))

(defn- push-fields [ins [:ref :form/r]] [:ref :form/r]
     (loop [i 0 acc (fvec)]
       (if (>= i 16) acc
         (recur (inc i) (push-field acc ins (source-field-key i))))))

(defn- push-incoming-values [acc [:ref :form/r] incomings [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of incomings)]
       (loop [i 0 out acc]
         (if (>= i n) out
           (recur (inc i) (vconj out (fget (form/nth-of incomings i) :mir/value)))))))

(defn- instruction-sources [ins [:ref :form/r]] [:ref :form/r]
     (let [base (push-fields ins)
           incomings (fget ins :mir/incomings)
           with-incomings (if (form/is-vec? incomings) (push-incoming-values base incomings) base)
           with-index (if (indexed-memory-op? (kw-of (fget ins :mir/op)))
                        (vconj with-incomings (fget ins :mir/index))
                        with-incomings)
           arguments (fget ins :mir/arguments)]
       (if (form/is-vec? arguments) (vinto with-index arguments) with-index)))

(defn- vreg-sources [ins [:ref :form/r]] [:ref :form/r]
     (let [xs (instruction-sources ins)
           n (form/count-of xs)]
       (form/form-vec
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (let [x (form/nth-of xs i)]
              (recur (inc i) (if (gmir/vreg? x) (form/append-form acc x) acc))))))))

(defn- mir-keyword-of [k :keyword] :keyword
     (let [t (document-edn-print (document-keyword k))]
       (keyword-from-string (string-concat "mir/" (string-substring t 6 (string-byte-length t))))))

(defn- mir-incoming [incoming [:ref :form/r]] [:ref :form/r]
     (form/form-map
      (form/append-form
       (form/append-form
        (form/append-form
         (form/append-form (form/no-forms) (kwf :mir/predecessor))
         (fget incoming :gmir/predecessor))
        (kwf :mir/value))
       (fget incoming :gmir/value))))

(defn- mir-incomings [incomings [:ref :form/r]] [:ref :form/r]
     (form/form-vec
      (let [n (form/count-of incomings)]
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (recur (inc i) (form/append-form acc (mir-incoming (form/nth-of incomings i)))))))))

(defn- select-instruction [target [:ref :form/r] instruction [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :gmir/op))
           kids (form/kids-of instruction)
           n (vector-count kids)
           init (cond
                  (= op :gmir/runtime-call)
                  (kassoc (fmap) :mir/context-offset
                          (mget (runtime-context-offsets) (fget instruction :gmir/runtime)))
                  (= op :gmir/capability-call)
                  (kassoc (fmap) :mir/context-offset
                          (mget (capability-context-offsets) (fget instruction :gmir/kind)))
                  :else (fmap))]
       (loop [j 0 out init]
         (if (>= (+ j 1) n) out
           (let [k (typed-list-nth [:list [:ref :form/r]] kids j)
                 v (typed-list-nth [:list [:ref :form/r]] kids (+ j 1))
                 nk (kwf (mir-keyword-of (kw-of k)))]
             (recur (+ j 2)
                    (massoc out nk
                            (cond
                              (kw? k :gmir/op) (kwf (mir-keyword-of (kw-of v)))
                              (kw? k :gmir/incomings) (mir-incomings v)
                              :else v))))))))

(defn- vreg-use-counts [instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 counts (fmap)]
         (if (>= i n) counts
           (let [vs (vreg-sources (form/nth-of instructions i))
                 m (form/count-of vs)]
             (recur (inc i)
                    (loop [j 0 c counts]
                      (if (>= j m) c
                        (let [v (form/nth-of vs j)]
                          (recur (inc j) (massoc c v (fint (+ 1 (ival (mget c v)))))))))))))))

(defn- aarch64-fuse-zero-equality-branches [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (if (not (kw? target :aarch64))
       instructions
       (let [n (form/count-of instructions)
             use-counts (vreg-use-counts instructions)]
         (loop [index 0 out (fvec)]
           (if (>= index n) out
             (let [constant (form/nth-of instructions index)
                   equal (form/nth-of instructions (+ index 1))
                   branch (form/nth-of instructions (+ index 2))
                   zero (fget constant :mir/dst)
                   result (fget equal :mir/dst)
                   left (fget equal :mir/left)
                   right (fget equal :mir/right)
                   operand (cond (form/eq zero left) right
                                 (form/eq zero right) left
                                 :else (form/nil-form))
                   fuse? (and (kw? (fget constant :mir/op) :mir/constant)
                              (int-eq? (fget constant :mir/value) 0)
                              (kw? (fget equal :mir/op) :mir/equal)
                              (kw? (fget branch :mir/op) :mir/branch-zero)
                              (form/eq result (fget branch :mir/test))
                              (gmir/vreg? operand)
                              (and (not (form/eq zero result)) (not (form/eq zero operand)) (not (form/eq result operand)))
                              (int-eq? (mget use-counts zero) 1)
                              (int-eq? (mget use-counts result) 1))]
               (if fuse?
                 (recur (+ index 3)
                        (vconj out (form/form-map
                                    (form/append-form
                                     (form/append-form
                                      (form/append-form
                                       (form/append-form
                                        (form/append-form
                                         (form/append-form (form/no-forms) (kwf :mir/op))
                                         (kwf :mir/branch-nonzero))
                                        (kwf :mir/test))
                                       operand)
                                      (kwf :mir/target))
                                     (fget branch :mir/target)))))
                 (recur (+ index 1) (vconj out constant)))))))))

(defn- live-source-set [instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 acc (fset)]
         (if (>= i n) acc
           (let [vs (vreg-sources (form/nth-of instructions i))
                 m (form/count-of vs)]
             (recur (inc i)
                    (loop [j 0 s acc]
                      (if (>= j m) s (recur (inc j) (sconj s (form/nth-of vs j)))))))))))

(defn- select-pass [target [:ref :form/r] instructions [:ref :form/r] constant-division? :bool] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 constants (fmap) out (fvec) specialized (fset)]
         (if (>= i n)
           (massoc (massoc (fmap) (kwf :out) out) (kwf :specialized) specialized)
           (let [ins (form/nth-of instructions i)
                 right (fget ins :gmir/right)
                 specialized? (and constant-division?
                                   (kw? (fget ins :gmir/op) :gmir/quotient)
                                   (mhas? constants right))
                 selected0 (select-instruction target ins)
                 selected (if specialized?
                            (form/dissoc-form (kassoc (kassoc selected0 :mir/op (kwf :mir/quotient-constant))
                                             :mir/divisor (mget constants right))
                                     (kwf :mir/right))
                            selected0)
                 constants2 (if (kw? (fget ins :gmir/op) :gmir/constant)
                              (massoc constants (fget ins :gmir/dst) (fget ins :gmir/value))
                              constants)]
             (recur (inc i) constants2 (vconj out selected)
                    (if specialized? (sconj specialized right) specialized)))))))

(defn- drop-absorbed-constants [out [:ref :form/r] specialized [:ref :form/r]] [:ref :form/r]
     (let [live (live-source-set out)
           m (form/count-of out)]
       (loop [j 0 res (fvec)]
         (if (>= j m) res
           (let [ins2 (form/nth-of out j)]
             (recur (inc j)
                    (if (and (kw? (fget ins2 :mir/op) :mir/constant)
                             (member-of? specialized (fget ins2 :mir/dst))
                             (not (member-of? live (fget ins2 :mir/dst))))
                      res
                      (vconj res ins2))))))))

(defn- select-instructions [target [:ref :form/r] instructions [:ref :form/r] constant-division? :bool] [:ref :form/r]
     (let [pass (select-pass target instructions constant-division?)]
       (drop-absorbed-constants (aarch64-fuse-zero-equality-branches target (fget pass :out))
                                (fget pass :specialized))))

(defn- gmir-dequant-op-not-q8? [op :keyword] :bool
     (or (= op :gmir/kernel-dequant-dot-q4-k) (= op :gmir/kernel-dequant-dot-q6-k)
         (= op :gmir/kernel-dequant-dot-iq4-xs) (= op :gmir/kernel-dequant-dot-iq2-s)
         (= op :gmir/kernel-dequant-dot-iq3-xxs) (= op :gmir/kernel-dequant-dot-iq3-s)
         (= op :gmir/kernel-dequant-dot-ptq1-0)))

(defn- gmir-all-instructions [program [:ref :form/r]] [:ref :form/r]
     (if (int-eq? (fget program :gmir/version) 3)
       (let [functions (fget program :gmir/functions)
             n (form/count-of functions)]
         (loop [i 0 acc (fvec)]
           (if (>= i n) acc
             (recur (inc i) (vinto acc (fget (form/nth-of functions i) :gmir/instructions))))))
       (fget program :gmir/instructions)))

(defn- any-op? [instructions [:ref :form/r] kind :i64] :bool
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) false
           (let [op (kw-of (fget (form/nth-of instructions i) :gmir/op))]
             (if (cond (= kind 0) (= op :gmir/x86-privileged)
                       (= kind 1) (gmir-dequant-op-not-q8? op)
                       :else false)
               true
               (recur (inc i))))))))

(defn- select-all-functions [target [:ref :form/r] functions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of functions)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [f (form/nth-of functions i)]
             (recur (inc i)
                    (vconj acc (form/form-map
                                (form/append-form
                                 (form/append-form
                                  (form/append-form
                                   (form/append-form
                                    (form/append-form
                                     (form/append-form (form/no-forms) (kwf :mir/name))
                                     (fget f :gmir/name))
                                    (kwf :mir/arity))
                                   (fget f :gmir/arity))
                                  (kwf :mir/instructions))
                                 (select-instructions target (fget f :gmir/instructions) true))))))))))

(defn- select-all-flat [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (recur (inc i) (vconj acc (select-instruction target (form/nth-of instructions i))))))))

(defn- selected-program [target [:ref :form/r] program [:ref :form/r]] [:ref :form/r]
     (if (int-eq? (fget program :gmir/version) 3)
       (kassoc
        (kassoc
         (kassoc
          (kassoc
           (kassoc (fmap) :mir/version (fint 3))
           :mir/target target)
          :mir/registers (kwf :virtual))
         :mir/entry (fget program :gmir/entry))
        :mir/functions (select-all-functions target (fget program :gmir/functions)))
       (kassoc
        (kassoc
         (kassoc
          (kassoc (fmap) :mir/version (fget program :gmir/version))
          :mir/target target)
         :mir/registers (kwf :virtual))
        :mir/instructions (select-all-flat target (fget program :gmir/instructions)))))

(defn select-target-result [target [:ref :form/r] program [:ref :form/r]] [:ref :form/r]
     (if (not (member-of? (targets) target))
       (kassoc (fmap) :problem (kwf :unsupported-target))
       (let [instructions (do (gmir/validate! program) (gmir-all-instructions program))]
         (cond
           (and (not (kw? target :x86-64)) (any-op? instructions 0))
           (kassoc (fmap) :problem (kwf :x86-privileged-target-mismatch))
           (and (not (kw? target :x86-64)) (any-op? instructions 1))
           (kassoc (fmap) :problem (kwf :x86-simd-target-mismatch))
           :else
           (let [built (selected-program target program)
                 p (validate-problem built)]
             (if (= p :ok)
               (kassoc (fmap) :program built)
               (kassoc (fmap) :problem (kwf p))))))))

(defn select-target
     "Select the closed GMIR operation set into target MIR, preserving vregs."
     [target [:ref :form/r] program [:ref :form/r]] [:ref :form/r]
     (let [r (select-target-result target program)]
       (if (mhas? r (kwf :problem))
         (do (reject! (kw-of (fget r :problem))) program)
         (let [built (fget r :program)]
           (if (and (int-eq? (fget built :mir/version) 2))
             (do (gmir/validate! (gmir-program-of (fget built :mir/instructions))) built)
             built)))))

nil

nil

;; ---------------------------------------------------------------------------
;; Kotoba route: post-allocation scheduling over Form.
;; ---------------------------------------------------------------------------

(defn- scheduling-latency [target [:ref :form/r] instruction [:ref :form/r]] :i64
     (if (and (or (kw? target :x86-64) (kw? target :aarch64))
              (kw? (fget instruction :mir/op) :mir/multiply))
       3
       1))

(defn- scheduling-register? [target [:ref :form/r] value [:ref :form/r]] :bool
     (or (gmir/vreg? value) (physical-register? target value)))

;; The scheduling registers among INSTRUCTION's sources, without repeats.
(defn- scheduling-sources [target [:ref :form/r] instruction [:ref :form/r]] [:ref :form/r]
     (let [xs (instruction-sources instruction)
           n (form/count-of xs)]
       (loop [i 0 acc (fset)]
         (if (>= i n) acc
           (let [x (form/nth-of xs i)]
             (recur (inc i) (if (scheduling-register? target x) (sconj acc x) acc)))))))

;; The set PREDS with the readers/writers recorded for SOURCES folded in: the
;; index of each source's last definition.
(defn- raw-predecessors [sources [:ref :form/r] last-def [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of sources)]
       (loop [i 0 acc (fset)]
         (if (>= i n) acc
           (let [s (form/nth-of sources i)]
             (recur (inc i) (if (mhas? last-def s) (sconj acc (mget last-def s)) acc)))))))

;; READERS with INDEX recorded as a reader of every source.
(defn- record-readers [readers [:ref :form/r] sources [:ref :form/r] index :i64] [:ref :form/r]
     (let [n (form/count-of sources)]
       (loop [i 0 acc readers]
         (if (>= i n) acc
           (let [s (form/nth-of sources i)]
             (recur (inc i) (massoc acc s (sconj (mget acc s) (fint index)))))))))

;; Register dependencies within one scheduling segment: for each instruction,
;; the set of earlier indexes it must follow (RAW, WAR and WAW).
(defn- segment-predecessors [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (let [total (form/count-of instructions)]
       (loop [index 0 last-def (fmap) readers (fmap) preds (fvec)]
         (if (>= index total) preds
           (let [instruction (form/nth-of instructions index)
                 sources (scheduling-sources target instruction)
                 dst (fget instruction :mir/dst)
                 register-dst? (scheduling-register? target dst)
                 raw (raw-predecessors sources last-def)
                 war (if register-dst? (mget readers dst) (fset))
                 waw (if register-dst? (mget last-def dst) (form/nil-form))
                 with-war (vinto raw war)
                 pred-indexes (if (form/is-nil? waw) (vdistinct with-war) (vdistinct (vconj with-war waw)))
                 readers2 (record-readers readers sources index)
                 readers3 (if register-dst? (massoc readers2 dst (fset)) readers2)
                 last-def2 (if register-dst? (massoc last-def dst (fint index)) last-def)]
             (recur (inc index) last-def2 readers3 (vconj preds pred-indexes)))))))

(defn- all-ready? [preds [:ref :form/r] completion [:ref :form/r] cycle :i64] :bool
     (let [n (form/count-of preds)]
       (loop [i 0]
         (if (>= i n) true
           (let [p (form/nth-of preds i)]
             (if (and (mhas? completion p) (<= (ival (mget completion p)) cycle))
               (recur (inc i))
               false))))))

(defn- segment-ready-at-cycle? [predecessors [:ref :form/r] completion [:ref :form/r] cycle :i64 index :i64] :bool
     (all-ready? (form/nth-of predecessors index) completion cycle))

;; Is ORDER a permutation of 0..COUNT-1?
(defn- permutation? [order [:ref :form/r] count :i64] :bool
     (and (= count (form/count-of order))
          (loop [k 0]
            (if (>= k count) true
              (if (>= (vindex-of order (fint k)) 0) (recur (inc k)) false)))))

;; Does every instruction come after all of its predecessors in ORDER?
(defn- respects-dependencies? [predecessors [:ref :form/r] order [:ref :form/r] count :i64] :bool
     (loop [index 0]
       (if (>= index count) true
         (let [preds (form/nth-of predecessors index)
               m (form/count-of preds)
               here (vindex-of order (fint index))]
           (if (loop [j 0]
                 (if (>= j m) true
                   (if (< (vindex-of order (form/nth-of preds j)) here) (recur (inc j)) false)))
             (recur (inc index))
             false)))))

(defn- valid-scheduled-segment? [target [:ref :form/r] instructions [:ref :form/r] order [:ref :form/r]] :bool
     (let [count (form/count-of instructions)]
       (and (permutation? order count)
            (respects-dependencies? (segment-predecessors target instructions) order count))))

;; Dependency-aware list-scheduling helpers ---------------------------------

;; Successor sets: for each index, the indexes that list it as a predecessor.
(defn- add-successors [succ [:ref :form/r] preds [:ref :form/r] index :i64] [:ref :form/r]
     (let [n (form/count-of preds)]
       (loop [j 0 acc succ]
         (if (>= j n) acc
           (let [p (ival (form/nth-of preds j))]
             (recur (inc j) (vassoc acc p (sconj (form/nth-of acc p) (fint index)))))))))

(defn- empty-sets [n :i64] [:ref :form/r]
     (loop [i 0 acc (fvec)]
       (if (>= i n) acc (recur (inc i) (vconj acc (fset))))))

(defn- zero-heights [n :i64] [:ref :form/r]
     (loop [i 0 acc (fvec)]
       (if (>= i n) acc (recur (inc i) (vconj acc (fint 0))))))

(defn- successor-sets [predecessors [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of predecessors)]
       (loop [index 0 acc (empty-sets n)]
         (if (>= index n) acc
           (recur (inc index) (add-successors acc (form/nth-of predecessors index) index))))))

(defn- max-height [heights [:ref :form/r] successors [:ref :form/r]] :i64
     (let [n (form/count-of successors)]
       (loop [j 0 best 0]
         (if (>= j n) best
           (let [h (ival (form/nth-of heights (ival (form/nth-of successors j))))]
             (recur (inc j) (if (> h best) h best)))))))

(defn- segment-heights [target [:ref :form/r] instructions [:ref :form/r] successors [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [index (- n 1) heights (zero-heights n)]
         (if (< index 0) heights
           (recur (- index 1)
                  (vassoc heights index
                          (fint (+ (scheduling-latency target (form/nth-of instructions index))
                                   (max-height heights (form/nth-of successors index))))))))))

;; Of REMAINING (a set of indexes), the ready one with the greatest height, ties
;; to the smaller index; -1 when none is ready this cycle.
(defn- pick-ready [predecessors [:ref :form/r] remaining [:ref :form/r] completion [:ref :form/r] heights [:ref :form/r] cycle :i64] :i64
     (let [n (form/count-of remaining)]
       (loop [j 0 best -1]
         (if (>= j n) best
           (let [index (ival (form/nth-of remaining j))]
             (recur (inc j)
                    (if (segment-ready-at-cycle? predecessors completion cycle index)
                      (if (< best 0)
                        index
                        (let [hb (ival (form/nth-of heights best))
                              hi (ival (form/nth-of heights index))]
                          (if (or (> hi hb) (and (= hi hb) (< index best))) index best)))
                      best)))))))

(defn- all-indexes [n :i64] [:ref :form/r]
     (loop [i 0 acc (fvec)]
       (if (>= i n) acc (recur (inc i) (vconj acc (fint i))))))

(defn- remove-index [remaining [:ref :form/r] index :i64] [:ref :form/r]
     (vremove-members remaining (form/form-set (form/one-form (fint index)))))

(defn- schedule-loop [target [:ref :form/r] instructions [:ref :form/r] predecessors [:ref :form/r] heights [:ref :form/r]] [:ref :form/r]
     (loop [cycle 0 remaining (all-indexes (form/count-of instructions)) completion (fmap) out (fvec)]
       (if (= 0 (form/count-of remaining)) out
         (let [ready (pick-ready predecessors remaining completion heights cycle)]
           (if (< ready 0)
             (recur (inc cycle) remaining completion out)
             (recur (inc cycle)
                    (remove-index remaining ready)
                    (massoc completion (fint ready)
                            (fint (+ cycle (scheduling-latency target (form/nth-of instructions ready)))))
                    (vconj out (fint ready))))))))

;; A deterministic dependency-aware permutation of the original indexes.
(defn- schedule-integer-segment-indices [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (if (< n 2)
         (all-indexes n)
         (let [predecessors (segment-predecessors target instructions)
               successors (successor-sets predecessors)
               heights (segment-heights target instructions successors)
               order (schedule-loop target instructions predecessors heights)]
           ;; The host refuses a schedule that breaks a register dependency. The
           ;; list scheduler cannot produce one; should it ever, the original
           ;; order is the always-valid answer, and this function must not abort
           ;; (its caller loops).
           (if (valid-scheduled-segment? target instructions order)
             order
             (all-indexes n))))))

(defn- schedule-integer-segment [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (let [order (schedule-integer-segment-indices target instructions)
           n (form/count-of order)]
       (loop [k 0 acc (fvec)]
         (if (>= k n) acc
           (recur (inc k) (vconj acc (form/nth-of instructions (ival (form/nth-of order k)))))))))

(defn- aarch64-fusion-pair? [target [:ref :form/r] instructions [:ref :form/r] use-counts [:ref :form/r] index :i64] :bool
     (let [multiply (form/nth-of instructions index)
           consumer (form/nth-of instructions (+ index 1))
           product (fget multiply :mir/dst)
           consumer-op (kw-of (fget consumer :mir/op))]
       (and (kw? (fget multiply :mir/op) :mir/multiply)
            (scheduling-register? target product)
            (int-eq? (mget use-counts product) 1)
            (or (and (= consumer-op :mir/add)
                     (or (form/eq product (fget consumer :mir/left))
                         (form/eq product (fget consumer :mir/right))))
                (and (= consumer-op :mir/subtract)
                     (form/eq product (fget consumer :mir/right)))))))

;; Use counts of the scheduling registers among all instructions' sources.
(defn- scheduling-use-counts [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 counts (fmap)]
         (if (>= i n) counts
           (let [xs (instruction-sources (form/nth-of instructions i))
                 m (form/count-of xs)]
             (recur (inc i)
                    (loop [j 0 c counts]
                      (if (>= j m) c
                        (let [x (form/nth-of xs j)]
                          (recur (inc j)
                                 (if (scheduling-register? target x)
                                   (massoc c x (fint (+ 1 (ival (mget c x)))))
                                   c)))))))))))

;; The indexes of adjacent multiply/consumer pairs the AArch64 selector fuses.
(defn- protected-scheduling-indexes [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (if (not (kw? target :aarch64))
       (fset)
       (let [use-counts (scheduling-use-counts target instructions)
             limit (- (form/count-of instructions) 1)]
         (loop [index 0 out (fset)]
           (if (>= index limit) out
             (recur (inc index)
                    (if (aarch64-fusion-pair? target instructions use-counts index)
                      (sconj (sconj out (fint index)) (fint (+ index 1)))
                      out)))))))

(defn- schedulable-integer-op? [op :keyword] :bool
     (or (= op :mir/add) (= op :mir/subtract) (= op :mir/multiply)
         (= op :mir/bit-and) (= op :mir/bit-or) (= op :mir/bit-xor)
         (= op :mir/shift-left) (= op :mir/shift-right-signed) (= op :mir/shift-right-unsigned)
         (= op :mir/equal) (= op :mir/less-than) (= op :mir/greater-than)
         (= op :mir/less-or-equal) (= op :mir/greater-or-equal)))

(defn- schedule-instructions [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (let [protected (protected-scheduling-indexes target instructions)
           n (form/count-of instructions)]
       (loop [i 0 out (fvec) segment (fvec)]
         (if (>= i n)
           (vinto out (schedule-integer-segment target segment))
           (let [instruction (form/nth-of instructions i)]
             (if (and (not (member-of? protected (fint i)))
                      (schedulable-integer-op? (kw-of (fget instruction :mir/op))))
               (recur (inc i) out (vconj segment instruction))
               (recur (inc i)
                      (vconj (vinto out (schedule-integer-segment target segment)) instruction)
                      (fvec))))))))

(defn- schedule-program [program [:ref :form/r]] [:ref :form/r]
     (kassoc program :mir/instructions
             (schedule-instructions (fget program :mir/target) (fget program :mir/instructions))))

