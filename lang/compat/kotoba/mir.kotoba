                            arguments (fe-get dd__101297_1 :mir/arguments)
                            instruction dd__101297_1]
                        (when (and (= :mir/tail-call op)
                                 (= current-function callee)
                                 (= (count arguments)
                                    (count parameter-homes)))
                        [index instruction]))))
                   vec)]
