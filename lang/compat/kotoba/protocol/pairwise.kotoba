(ns kotoba.protocol.pairwise
  "Pairwise DIDs: one key per context (ADR-2610081200 R1, tier :t1).

  A principal keeps one root seed and shows each context a different
  did:key. Two contexts cannot link the two DIDs; within one context
  the DID is stable, so reputation can accrue there.

  Derivation, fixed here so every implementation agrees:

    seed_ctx = HKDF-SHA256(ikm  = root-seed,
                           salt = \"kotoba/pairwise/v1\",
                           info = context,
                           len  = 32)
    did_ctx  = did:key of the Ed25519 key with seed seed_ctx

  This ns does not hash or derive keys — crypto lives in kotoba-auth.
  It owns the context grammar, the derivation constants, and the shape
  check that fails closed:

    context not canonical            → :not-a-context
    one context bound twice          → :context-rebound
    one DID used in two contexts     → :linked-across-contexts
    root DID shown as a pairwise DID → :root-exposed"
  (:require [kotoba.lang.text :as str]
            [kotoba.protocol.ref :as ref]
            [kotoba.protocol.vocab :as vocab]))

(def version 1)

(def hkdf-salt "kotoba/pairwise/v1")
(def seed-length 32)

(defn context?
  "A context is a canonical ref (`ipfs://…` / `ipns://…`) or a reverse-DNS
  id. Free text is not a context: two spellings of one place would mint
  two DIDs, and one spelling of two places would link them."
  [c]
  (boolean (or (ref/canonical-ref-uri? c)
               (vocab/reverse-dns-id? c))))

(defn derivation
  "The HKDF parameters for `context`, or {:error …}."
  [context]
  (if (context? context)
    {:salt hkdf-salt :info context :length seed-length :curve :ed25519}
    {:error :not-a-context :value context}))

(defn binding-errors
  "`root` is the principal's root did:key. `bindings` is a seq of
  {:context :did}. [] when the set keeps every context unlinkable."
  [root bindings]
  (vec
   (concat
    (for [{:keys [context did]} bindings
          err [(when-not (context? context) {:error :not-a-context :value context})
               (when-not (vocab/did-key? did) {:error :not-a-key :value did})
               (when (= did root) {:error :root-exposed :context context})]
          :when err]
      err)
    (for [[c bs] (group-by :context bindings)
          :when (and (context? c) (< 1 (count (distinct (map :did bs)))))]
      {:error :context-rebound :context c})
    (for [[d bs] (group-by :did bindings)
          :let [cs (distinct (map :context bs))]
          :when (and (vocab/did-key? d) (< 1 (count cs)))]
      {:error :linked-across-contexts :did d :contexts (vec (sort cs))}))))

(defn linkable?
  "Two pairwise appearances are linkable only inside one context."
  [a b]
  (and (some? (:context a))
       (= (:context a) (:context b))
       (= (:did a) (:did b))))

(defn context-of
  "The context a did is bound to in `bindings`, or nil."
  [bindings did]
  (some #(when (= did (:did %)) (:context %)) bindings))

(defn same-principal?
  "Only the holder of the root, who has the bindings, can tell that two
  pairwise DIDs are one principal. Exposed so that holder's own tooling
  agrees with the protocol; a relying party never has `bindings`."
  [bindings a b]
  (boolean (and (context-of bindings a) (context-of bindings b))))

(defn- blank? [s] (or (nil? s) (str/blank? s)))

(defn context-for-graph
  "The canonical pairwise context of a graph: its IPNS name."
  [ipns-name]
  (when-not (blank? ipns-name)
    (let [c (str "ipns://" ipns-name)]
      (when (context? c) c))))
