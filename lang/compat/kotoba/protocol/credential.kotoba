(ns kotoba.protocol.credential
  "Credential predicate algebra (ADR-2610081200 R3, tier :t3).\n\nA credential predicate is a pure function that evaluates a credential\nagainst a set of conditions without revealing the credential itself.\nThis algebra defines the structure of such predicates and their\ncomposition, leaving the actual verification to be injected via\nverify-fn.\n\nThe algebra does not perform any cryptographic operations; it\nonly combines boolean results and error propagation."
  (:require [kotoba.lang.text :as str]))

;; ── Predicate structure ──────────────────────────────────────
;; A predicate is a map with a :verify-fn that takes a credential
;; and returns either {:ok true} or {:ok false} or {:error ...}.
;; For simplicity, we define a predicate as a function that returns
;; a boolean or an error map.

(defn predicate? [p]
  "Return true if `p` is a map containing a :verify-fn that is a function."
  (and (map? p)
       (:verify-fn p)
       (fn? (:verify-fn p))))

(defn make-predicate
  "Create a predicate map from a verify-fn."
  [verify-fn]
  (if (fn? verify-fn)
    {:verify-fn verify-fn}
    {:error :not-a-function :value verify-fn}))

;; ── Predicate combinators ────────────────────────────────────
;; These combinators assume that the verify-fns of the input predicates
;; return either {:ok true}, {:ok false}, or {:error ...}.
;; They return a new predicate whose verify-fn combines the results.

(defn and-pred
  "Return a predicate that is the logical AND of two predicates."
  [p1 p2]
  (if (and (predicate? p1) (predicate? p2))
    {:verify-fn
     (fn [cred]
       (let [r1 ((:verify-fn p1) cred)
             r2 ((:verify-fn p2) cred)]
         (cond
           (:error r1) r1
           (:error r2) r2
           :else {:ok (and (:ok r1) (:ok r2))}))) }
    {:error :invalid-predicate :value [p1 p2]}))

(defn or-pred
  "Return a predicate that is the logical OR of two predicates."
  [p1 p2]
  (if (and (predicate? p1) (predicate? p2))
    {:verify-fn
     (fn [cred]
       (let [r1 ((:verify-fn p1) cred)
             r2 ((:verify-fn p2) cred)]
         (cond
           (:error r1) (if (:ok r2) r2 r1) ;; keep the first error unless the second passes
           (:error r2) r1                  ;; if second errors, keep the first result
           :else {:ok (or (:ok r1) (:ok r2))}))) }
    {:error :invalid-predicate :value [p1 p2]}))

(defn not-pred
  "Return a predicate that is the logical NOT of a predicate."
  [p]
  (if (predicate? p)
    {:verify-fn
     (fn [cred]
       (let [r ((:verify-fn p) cred)]
         (if (:error r)
           r
           {:ok (not (:ok r))}))) }
    {:error :invalid-predicate :value p}))

;; ── Error helpers ────────────────────────────────────────────
(defn pred-error
  "Helper to create an error map for predicate failures."
  [kw value]
  {:error kw :value value})
