                    ",booleanProfile:'strict-v1',optionProfile:'tagged-i64-v1'"
                    ",genericOptionProfile:'typed-tagged-v1'"
                    ",resultProfile:'tagged-i64-i64-v1'"
                    ",parametricAdtLimits:Object.freeze({depth:" max-type-depth
