             "if(c==='\\n'||c==='\\r')fail('newline-string');if(c!=='\\\\'){out+=c;continue;}"
             "if(i>=s.length)fail('truncated-escape');const e=s[i++];const escapes={b:'\\b',t:'\\t',n:'\\n',f:'\\f',r:'\\r','\\\"':'\\\"','\\\\':'\\\\'};"
