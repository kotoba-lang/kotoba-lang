             "throw new Error('f64-log-near-one-domain');const y=(v-1)/(v+1),z=y*y;"
             "let p=0.047619047619047616;p=0.05263157894736842+z*p;"
             "p=0.058823529411764705+z*p;p=0.06666666666666667+z*p;"
