                    ",moduleLiteralBytes:" max-string-value-bytes
                    ",valueBytes:" max-string-value-bytes "})"
                    ",bytesLimits:Object.freeze({valueBytes:" max-bytes-value-bytes "})"
                    ",keywordLimits:Object.freeze({valueBytes:" max-keyword-bytes "})"))
