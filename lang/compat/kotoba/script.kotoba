             "const docEdnSymbol=s=>{s=assertSymbol(s);if(s==='nil'||s==='true'||s==='false'||s[0]===':'||s[0]==='#'||"
             "/[\\s,\\[\\]{}()\"';`~^\\\\]/u.test(s)||/^[+-]?[0-9]+$/.test(s)||/^[+-]?(?:(?:[0-9]+\\.[0-9]*)|(?:[0-9]*\\.[0-9]+)|(?:[0-9]+[eE][+-]?[0-9]+))(?:[eE][+-]?[0-9]+)?$/.test(s))throw new Error('document-edn-ambiguous-symbol');return s;};"
             "const docEdnPrint=v=>{const walk=n=>{n=assertDoc(n);const t=n[0];"
