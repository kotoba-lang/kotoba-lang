;; kotoba.text -- an ALIAS over `kotoba.string`. Same surface, one
;; implementation.
;;
;; Root ADR-2609040930's replacement-router table sends `clojure.string` to
;; `kotoba.text`, and until 2026-09-08 that name resolved to NOTHING in this
;; plane: the namespace in `kotoba-lang/text` is `kotoba.lang.text`, and no
;; guest module answered to `kotoba.text` at all. This file makes the name the
;; router already points at actually resolve. It is not papering over a
;; conflict between two live names -- the owner's decision (2026-09-08) is that
;; `kotoba.text` and `kotoba.string` are ALIASES, and the `.cljc` half of that
;; is being done separately in `kotoba-lang/text`.
;;
;; ⚠ There is a `kotoba.string` in the `.cljc` plane too, with a LARGER
;; surface. The guest surface here is deliberately a SUBSET of it, and the
;; shared names answer the same thing on the same inputs -- held by the oracle
;; in `test/kotoba/lang/kotoba_string_compat_test.clj`, which calls
;; clojure.string itself. Divergences, where they exist, are named in
;; `lang/compat.edn` `:hazards` rather than left to be discovered.
;;
;; Forwarding wrappers, not a re-export: `(:export [name])` must name a
;; function this module defines. Measured 2026-09-08, a bare re-export is
;; `:kotoba.error/export-names-undefined`.

(ns kotoba.text
  (:require [kotoba.string :as ks])
  (:export [byte-index-of utf16-index-of utf16-last-index-of
            starts-with? ends-with? includes?
            blank? trim triml trimr reverse
            index-of last-index-of]))

(defn byte-index-of [s :string needle :string] :i64 (ks/byte-index-of s needle))
(defn utf16-index-of [s :string needle :string] :i64 (ks/utf16-index-of s needle))
(defn utf16-last-index-of [s :string needle :string] :i64 (ks/utf16-last-index-of s needle))
(defn starts-with? [s :string prefix :string] :bool (ks/starts-with? s prefix))
(defn ends-with? [s :string suffix :string] :bool (ks/ends-with? s suffix))
(defn includes? [s :string substring :string] :bool (ks/includes? s substring))
(defn blank? [s :string] :bool (ks/blank? s))
(defn trim [s :string] :string (ks/trim s))
(defn triml [s :string] :string (ks/triml s))
(defn trimr [s :string] :string (ks/trimr s))
(defn reverse [s :string] :string (ks/reverse s))
(defn index-of [s :string value :string] [:option :i64] (ks/index-of s value))
(defn last-index-of [s :string value :string] [:option :i64] (ks/last-index-of s value))
