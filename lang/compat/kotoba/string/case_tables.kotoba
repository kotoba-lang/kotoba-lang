      (string-substring "𐐀𐐁𐐂𐐃𐐄𐐅𐐆𐐇𐐈𐐉𐐊𐐋𐐌𐐍𐐎𐐏𐐐𐐑𐐒𐐓𐐔𐐕𐐖𐐗𐐘𐐙𐐚𐐛𐐜𐐝𐐞𐐟𐐠𐐡𐐢𐐣𐐤𐐥𐐦𐐧" (* 4 (- point 66600)) (* 4 (+ 1 (- point 66600))))
      (if (>= point 66776) (<= point 66811) false)
      (string-substring "𐒰𐒱𐒲𐒳𐒴𐒵𐒶𐒷𐒸𐒹𐒺𐒻𐒼𐒽𐒾𐒿𐓀𐓁𐓂𐓃𐓄𐓅𐓆𐓇𐓈𐓉𐓊𐓋𐓌𐓍𐓎𐓏𐓐𐓑𐓒𐓓" (* 4 (- point 66776)) (* 4 (+ 1 (- point 66776))))
      (if (>= point 66967) (<= point 67004) false)
      (string-substring "𐕰𐕱𐕲𐕳𐕴𐕵𐕶𐕷𐕸𐕹𐕺𐖢𐕼𐕽𐕾𐕿𐖀𐖁𐖂𐖃𐖄𐖅𐖆𐖇𐖈𐖉𐖊𐖲𐖌𐖍𐖎𐖏𐖐𐖑𐖒𐖺𐖔𐖕" (* 4 (- point 66967)) (* 4 (+ 1 (- point 66967))))
      (if (>= point 68800) (<= point 68850) false)
      (string-substring "𐲀𐲁𐲂𐲃𐲄𐲅𐲆𐲇𐲈𐲉𐲊𐲋𐲌𐲍𐲎𐲏𐲐𐲑𐲒𐲓𐲔𐲕𐲖𐲗𐲘𐲙𐲚𐲛𐲜𐲝𐲞𐲟𐲠𐲡𐲢𐲣𐲤𐲥𐲦𐲧𐲨𐲩𐲪𐲫𐲬𐲭𐲮𐲯𐲰𐲱𐲲" (* 4 (- point 68800)) (* 4 (+ 1 (- point 68800))))
      (if (>= point 68976) (<= point 68997) false)
      (string-substring "𐵐𐵑𐵒𐵓𐵔𐵕𐵖𐵗𐵘𐵙𐵚𐵛𐵜𐵝𐵞𐵟𐵠𐵡𐵢𐵣𐵤𐵥" (* 4 (- point 68976)) (* 4 (+ 1 (- point 68976))))
      (if (>= point 71872) (<= point 71903) false)
      (string-substring "𑢠𑢡𑢢𑢣𑢤𑢥𑢦𑢧𑢨𑢩𑢪𑢫𑢬𑢭𑢮𑢯𑢰𑢱𑢲𑢳𑢴𑢵𑢶𑢷𑢸𑢹𑢺𑢻𑢼𑢽𑢾𑢿" (* 4 (- point 71872)) (* 4 (+ 1 (- point 71872))))
      (if (>= point 93792) (<= point 93823) false)
      (string-substring "𖹀𖹁𖹂𖹃𖹄𖹅𖹆𖹇𖹈𖹉𖹊𖹋𖹌𖹍𖹎𖹏𖹐𖹑𖹒𖹓𖹔𖹕𖹖𖹗𖹘𖹙𖹚𖹛𖹜𖹝𖹞𖹟" (* 4 (- point 93792)) (* 4 (+ 1 (- point 93792))))
      (if (>= point 93883) (<= point 93907) false)
      (string-substring "𖺠𖺡𖺢𖺣𖺤𖺥𖺦𖺧𖺨𖺩𖺪𖺫𖺬𖺭𖺮𖺯𖺰𖺱𖺲𖺳𖺴𖺵𖺶𖺷𖺸" (* 4 (- point 93883)) (* 4 (+ 1 (- point 93883))))
      (if (>= point 125218) (<= point 125251) false)
      (string-substring "𞤀𞤁𞤂𞤃𞤄𞤅𞤆𞤇𞤈𞤉𞤊𞤋𞤌𞤍𞤎𞤏𞤐𞤑𞤒𞤓𞤔𞤕𞤖𞤗𞤘𞤙𞤚𞤛𞤜𞤝𞤞𞤟𞤠𞤡" (* 4 (- point 125218)) (* 4 (+ 1 (- point 125218))))
      :else (string-substring s index (+ index width)))))

;; java.lang.String.toUpperCase(Locale.ROOT) differs from the simple mapping
;; at exactly 102 code points, where it expands to more than one
;; character -- SpecialCasing.txt's unconditional entries. They are here as
;; whole literals rather than as an index, because the expansion is not one
;; character wide and there is nothing to index. Everything else falls
;; through to the simple table.
;;
;; There is no lower-root-slice. String.toLowerCase(Locale.ROOT) needs the
;; Final_Sigma condition, which is a property of the SURROUNDING string and
;; not of the code point; see lang/compat.edn :absent lower-case.
(defn upper-root-slice [s :string index :i64 width :i64] :string
  (let [point (string-code-point-at s index)]
    (cond
      (= point 223) "SS"
      (= point 329) "ʼN"
      (= point 496) "J̌"
      (= point 912) "Ϊ́"
      (= point 944) "Ϋ́"
      (= point 1415) "ԵՒ"
      (= point 7830) "H̱"
      (= point 7831) "T̈"
      (= point 7832) "W̊"
      (= point 7833) "Y̊"
      (= point 7834) "Aʾ"
      (= point 8016) "Υ̓"
      (= point 8018) "Υ̓̀"
      (= point 8020) "Υ̓́"
      (= point 8022) "Υ̓͂"
      (= point 8064) "ἈΙ"
      (= point 8065) "ἉΙ"
