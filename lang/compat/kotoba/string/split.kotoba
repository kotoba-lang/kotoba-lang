;; kotoba.string.split -- `split` on a LITERAL separator, alone in its own
;; namespace for the reason `kotoba.string.join` is: it needs an amu that builds
;; a `[:list :string]` whose length is known only while the program runs.
;;
;; WHY IT WAS ABSENT. `lang/compat.edn` recorded `split` / `split-lines` as
;; absent from the guest `kotoba.lang.text` because "a list of unknown length has
;; no construction": `typed-list-new` takes its items as literal operands.
;; `typed-list-conj` (amu ADR 0354 line of work: kotoba-sema `typed-list-conj`,
;; the KIR interpreter, and the native word-arena lowering) appends one item at
;; the end, so the list can now be built. That is the whole change.
;;
;; WHAT IT IS. `java.util.regex.Pattern/split` restricted to a separator that is
;; a plain string -- which is what 45 of the compiler's 47 `split` call sites
;; are (`"/"`, `"."`, `":"`, `"::"`, `"@"`, `"e"`); the other two are character
;; classes and are a different wall. The host `kotoba.lang.text/split` takes a
;; regex; a caller that must run on both writes the separator as a string, and
;; the host accepts a string as the literal separator (text repo change of the
;; same date).
;;
;;   * limit 0 (two-argument): trailing empty strings are removed; when the
;;     separator never occurs the answer is `[s]`, even for the empty string.
;;   * limit > 0: at most `limit` parts, the last one the unsplit remainder.
;;   * limit < 0: every part, trailing empties kept.
;;   * an empty separator splits between characters (a surrogate pair is one).
;;
;; Offsets are UTF-8 bytes, which are also character-aligned here because both
;; the text and the separator are whole code points; only the substrings, never
;; an offset, cross the boundary.

(ns kotoba.string.split
  (:export [split split-lines]))

(defn- char-width [point :i64] :i64
  (if (< point 128) 1 (if (< point 2048) 2 (if (< point 65536) 3 4))))

(defn- add [parts [:list :string] piece :string] [:list :string]
  (typed-list-conj [:list :string] parts piece))

;; ---- separators ------------------------------------------------------------

;; `(string-index-of-from s sep from)`, spelled with operations every compiler of
;; this module has (2026-10-04, agent TEXT of the amu seed, R6: the seed's source
;; route has `string-find-byte` and `string-index-of`, not `string-index-of-from`).
;; An ASCII first byte is found with `string-find-byte` (an ASCII byte only occurs
;; at a code-point boundary, so `at + 1` is one too) and each candidate compared
;; in place (`matches-at?`); any other first byte searches the remainder. Same answer as the
;; builtin for a non-empty `sep` and a boundary `from`, which every caller passes.
;; `sep` occurs at offset `at` (a boundary): compared code point by code point,
;; so no substring ends inside a character of `s`.
(defn- matches-at? [s :string sep :string at :i64 k :i64] :bool
  (if (= k (string-byte-length sep))
    true
    (if (= at (string-byte-length s))
      false
      (let [point (string-code-point-at sep k)]
        (if (= point (string-code-point-at s at))
          (matches-at? s sep (+ at (char-width point)) (+ k (char-width point)))
          false)))))

(defn- index-from [s :string sep :string from :i64] :i64
  (let [first-byte (string-code-point-at sep 0)
        size (string-byte-length s)]
    (if (< first-byte 128)
      (loop [at (string-find-byte s first-byte from)]
        (if (< at 0)
          -1
          (if (matches-at? s sep at 0)
            at
            (recur (string-find-byte s first-byte (+ at 1))))))
      (let [r (string-index-of (string-substring s from size) sep)]
        (if (< r 0) -1 (+ r from))))))

(defn- by-string [s :string sep :string sep-width :i64 from :i64 parts [:list :string]
                  made :i64 limit :i64] [:list :string]
  (let [at (index-from s sep from)]
    (if (or (< at 0) (and (> limit 0) (>= made (- limit 1))))
      (add parts (string-substring s from (string-byte-length s)))
      (by-string s sep sep-width (+ at sep-width)
                 (add parts (string-substring s from at))
                 (+ made 1) limit))))

;; The host splits on the empty pattern's zero-width matches: one at every
;; boundary after the first, INCLUDING the end of the text, so the remainder
;; after the last character is a trailing "" (kept for a non-zero limit,
;; dropped with the other trailing empties for limit 0). Until 2026-10-04 this
;; ended without it; agent TEXT's differential against the host
;; kotoba.lang.text (amu seed/tests/text) found 20 of 805 split cases that
;; disagreed, all of them this one: ("a" "" -1) is ["a" ""], ("" "" n) is [""].
(defn- by-character [s :string from :i64 parts [:list :string] made :i64 limit :i64]
  [:list :string]
  (let [n (string-byte-length s)]
    (if (or (>= from n) (and (> limit 0) (>= made (- limit 1))))
      (add parts (string-substring s from n))
      (let [w (char-width (string-code-point-at s from))]
        (by-character s (+ from w) (add parts (string-substring s from (+ from w)))
                      (+ made 1) limit)))))

;; ---- trailing empties ------------------------------------------------------

(defn- last-kept [parts [:list :string] index :i64] :i64
  (if (< index 0)
    -1
    (if (= 0 (string-byte-length (typed-list-nth [:list :string] parts index)))
      (last-kept parts (- index 1))
      index)))

(defn- prefix-of [parts [:list :string] upto :i64 index :i64 out [:list :string]]
  [:list :string]
  (if (> index upto)
    out
    (prefix-of parts upto (+ index 1)
               (add out (typed-list-nth [:list :string] parts index)))))

(defn- drop-trailing-empties [parts [:list :string]] [:list :string]
  (prefix-of parts (last-kept parts (- (vector-count parts) 1)) 0
             (typed-list-new [:list :string])))

;; ---- entry points ----------------------------------------------------------

(defn- split-limited [s :string sep :string limit :i64] [:list :string]
  (let [seplen (string-byte-length sep)
        empty (typed-list-new [:list :string])]
    (if (= seplen 0)
      (if (= (string-byte-length s) 0)
        (add empty s)
        (let [chars (by-character s 0 empty 0 limit)]
          (if (= limit 0) (drop-trailing-empties chars) chars)))
      (if (< (index-from s sep 0) 0)
        (add empty s)
        (let [parts (by-string s sep seplen 0 empty 0 limit)]
          (if (= limit 0) (drop-trailing-empties parts) parts))))))

(defn split
  ([s :string sep :string] [:list :string] (split-limited s sep 0))
  ([s :string sep :string limit :i64] [:list :string] (split-limited s sep limit)))

;; `clojure.string/split-lines` is `(split s #"\r?\n")`: a lone carriage return
;; is not a separator, and the empties a final newline leaves are dropped.
(defn- last-cr [p :string from :i64 best :i64] :i64
  (let [at (index-from p "\r" from)]
    (if (< at 0)
      best
      (last-cr p (+ at 1) at))))

(defn- strip-cr [parts [:list :string] index :i64 out [:list :string]] [:list :string]
  (if (>= index (vector-count parts))
    out
    (let [p (typed-list-nth [:list :string] parts index)
          n (string-byte-length p)
          ;; Whether the piece ENDS in a carriage return, found by walking the
          ;; CRs forward from offsets that are always boundaries (0, and one past
          ;; a CR): a search from the last byte would start inside a multi-byte
          ;; character and be refused.
          fixed (if (and (> n 0) (= (last-cr p 0 -1) (- n 1)))
                  (string-substring p 0 (- n 1))
                  p)]
      (strip-cr parts (+ index 1) (add out fixed)))))

(defn split-lines [s :string] [:list :string]
  (if (< (index-from s "\n" 0) 0)
    (add (typed-list-new [:list :string]) s)
    (drop-trailing-empties
     (strip-cr (split-limited s "\n" -1) 0 (typed-list-new [:list :string])))))
