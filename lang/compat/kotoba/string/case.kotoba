;; Unicode case mapping, under names that say which mapping.
;;
;; NOT `clojure.string/lower-case` / `upper-case` / `capitalize`. Those three
;; call `String.toLowerCase()` and `String.toUpperCase()` with no locale
;; argument, so what they answer depends on `Locale.getDefault()` -- in a
;; Turkish default locale `(clojure.string/lower-case "I")` is "ı" and not
;; "i". That is ambient authority in the plainest possible form, and a Kotoba
;; guest has no locale to read even if it wanted one. The Clojure names
;; therefore stay absent, with the measurement, in `lang/compat.edn`; what is
;; here says in the name which mapping it is.
;;
;; `simple-lower-case` / `simple-upper-case` are the Unicode SIMPLE case
;; mappings -- `java.lang.Character.toLowerCase(int)` and `toUpperCase(int)`,
;; one code point to one code point, no locale, no context. Exact against
;; those, swept over every code point.
;;
;; `upper-case-root` is `java.lang.String.toUpperCase(Locale.ROOT)`, which is
;; the simple mapping PLUS the 102 code points SpecialCasing expands to more
;; than one character (ß -> SS, ŉ -> ʼN, ﬁ -> FI). Exact against that, swept
;; the same way and over multi-code-point strings as well, because the claim
;; is about a whole string and not about a character.
;;
;; There is no `lower-case-root`. `String.toLowerCase(Locale.ROOT)` carries
;; one CONDITIONAL rule -- Final_Sigma, which lowercases Σ to ς at the end of
;; a word: `"ΑΣ".toLowerCase(ROOT)` is "ας" and `"ΑΣΒ"` is "ασβ", measured
;; 2026-09-02. Whether a Σ is final is a property of what surrounds it, not
;; of the code point, and deciding it needs the Cased and Case_Ignorable
;; properties over the whole of Unicode. That is a different size of table
;; from this one and it is not here. `simple-lower-case` answers "ασ" for
;; "ΑΣ", and the oracle asserts that divergence rather than choosing inputs
;; that hide it.
;;
;; Cost: one walk, one recursive call per code point plus one table call, and
;; one `string-concat` per code point. Recursion here is fuel-bounded like any
;; other guest recursion -- roughly two calls per code point, so a few hundred
;; code points under the default 512-call budget.

(ns kotoba.string.case
  (:export [simple-lower-case simple-upper-case upper-case-root simple-capitalize])
  (:require [kotoba.string.case-tables :as tables]))

;; UTF-8 width from the code point, so a scan advances without ever landing
;; inside a code point. The same six lines are private in
;; `lang/compat/clojure/string.kotoba`; a compat module does not reach into
;; another compat module's privates, so it is written twice rather than
;; exported from one of them and pulled into every consumer of the other.
(defn- code-point-width [point :i64] :i64
  (if (< point 128)
    1
    (if (< point 2048)
      2
      (if (< point 65536) 3 4))))

(defn- lower-from [s :string index :i64 out :string] :string
  (if (= index (string-byte-length s))
    out
    (let [width (code-point-width (string-code-point-at s index))]
      (lower-from s (+ index width)
                  (string-concat out (tables/lower-slice s index width))))))

(defn- upper-from [s :string index :i64 out :string] :string
  (if (= index (string-byte-length s))
    out
    (let [width (code-point-width (string-code-point-at s index))]
      (upper-from s (+ index width)
                  (string-concat out (tables/upper-slice s index width))))))

(defn- upper-root-from [s :string index :i64 out :string] :string
  (if (= index (string-byte-length s))
    out
    (let [width (code-point-width (string-code-point-at s index))]
      (upper-root-from s (+ index width)
                       (string-concat out (tables/upper-root-slice s index width))))))

;; Character.toLowerCase(int) applied to every code point.
(defn simple-lower-case [s :string] :string
  (lower-from s 0 ""))

;; Character.toUpperCase(int) applied to every code point.
(defn simple-upper-case [s :string] :string
  (upper-from s 0 ""))

;; String.toUpperCase(Locale.ROOT), expansions included.
(defn upper-case-root [s :string] :string
  (upper-root-from s 0 ""))

;; The first CODE POINT simple-uppercased, the rest simple-lowercased.
;;
;; clojure.string/capitalize is not this, on three counts: the locale above,
;; the String-level expansions above, and its own `(subs s 0 1)`, which takes
;; one UTF-16 CODE UNIT -- half of a surrogate pair when the first character
;; is astral. That last one is measured in the oracle rather than assumed,
;; because the two halves concatenate back together and the defect does not
;; show on every input.
(defn simple-capitalize [s :string] :string
  (if (= (string-byte-length s) 0)
    s
    (let [width (code-point-width (string-code-point-at s 0))]
      (string-concat (tables/upper-slice s 0 width)
                     (lower-from s width "")))))
