;; kotoba.string.join -- `join`, alone in its own namespace, because of what it
;; costs the modules it would otherwise share a file with.
;;
;; WHY IT IS NOT IN `kotoba.string`. `join` consumes a `[:list :string]` and
;; reads it with `typed-list-nth`. That accessor is typed by kotoba-sema (since
;; 2026-09-03) and was lowered by NEITHER backend until 2026-09-08. A module
;; containing it is refused WHOLE by an older amu -- a caller that mentions only
;; `starts-with?` cannot build. Measured 2026-09-08, both directions, with
;; `join` in `clojure.string`:
;;
;;   (ns probe-str (:require [clojure.string :as s]) (:export [main]))
;;   (defn main [] :i64 (if (s/starts-with? "abc" "ab") 1 0))
;;
;;   amu 9092ee34, --target wasm32 -> exit 70, :error :wasm-typed-lowering,
;;                                    "unsupported typed Wasm expression"
;;   same tree, `join` deleted     -> exit 0
;;   amu with kotoba-script f803255e + kotoba-wasm 829966fd (amu PR #898):
;;                     wasm32 -> exit 0 AND web -> exit 0, both RUN, main = 1
;;
;; And 74 guest modules require `clojure.string` (66 of them in
;; `network-awai/app-hyakka`; the command and the breakdown are in that file's
;; header). Putting `join` in the shared module would make all 74 need the new
;; amu on the day this lands. Putting it here makes only its own callers need
;; it, which is the whole reason this namespace exists.
;;
;; REMOVAL CONDITION, stated so this does not become permanent by default: when
;; the consuming trees run an amu whose `kotoba-script` pin is at or past
;; f803255ed259203e008d989f859b3b1b5fd22c98 and whose `kotoba-wasm` pin is at or
;; past 829966fd47148d3ef2b873ea35bed57a63928606 -- amu PR #898, which merged
;; to amu main as 8cc1361fa90ae084b4b5a3ef019caee9a1a097bb on 2026-09-08 -- this file folds
;; into `kotoba.string` and the namespace is retired. Nothing else is needed:
;; the function does not change, only which module can afford to hold it.
;;
;; The function itself is exactly `clojure.string/join`'s two-argument arity --
;; separator, then the strings, separator between adjacent pairs and nowhere
;; else. clojure.string/join's one-argument arity (join coll) has no
;; counterpart: there is no multi-arity here, so that call is an arity refusal
;; at check time, never a different answer. Held to clojure.string/join itself
;; by the oracle in test/kotoba/lang/clojure_string_compat_test.clj.
;;
;; COST, stated because it is not free: one `string-concat` per item after the
;; first, onto an accumulator rebuilt each step -- O(result length x item count)
;; bytes copied. The list is bounded by construction (kotoba-sema's
;; `max-list-items` is 128) and the recursion is fuel-bounded like any other
;; guest recursion.

(ns kotoba.string.join
  (:export [join]))

(defn- join-from [separator :string items [:list :string] index :i64 acc :string] :string
  (if (= index (vector-count items))
    acc
    (join-from separator items (+ index 1)
               (if (= index 0)
                 (nth items index)
                 (string-concat acc (string-concat separator (nth items index)))))))

;; `(join "," (typed-list-new [:list :string] "a" "b"))` is "a,b"; an empty list
;; is "", and a one-item list is that item, with no separator anywhere -- all
;; three asserted against clojure.string/join rather than described.
(defn join [separator :string items [:list :string]] :string
  (join-from separator items 0 ""))
