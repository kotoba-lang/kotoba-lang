(ns kotoba.abi.target
  "Physical target profiles. Vocabulary is not engine/host qualification."
  {:kotoba/export [profiles profile-contract binding-keys valid-binding?]}
  (:require [kotoba.core.execution :as execution]
            [kotoba.abi.component :as component]))

(def profiles
  (merge
   (into {} (map (fn [[target isa os abi]]
                   [target {:family :native
                            :layout {:isa isa :os os
                                     :abi (cond (= os :windows) (if (= isa :x86_64) :kotoba-sysv-v1 :kotoba-aapcs64-v1)
                                                (= isa :x86_64) :sysv :else :aapcs64)
                                     :mode (if (= abi :static-elf) :static-elf :supervisor)}
                            :context-versions (if (= abi :static-elf) #{} #{11 12})}])
                 [[:x86_64-kotoba-v1 :x86_64 :portable :loader-v12]
                  [:aarch64-kotoba-v1 :aarch64 :portable :loader-v12]
                  [:x86_64-linux-kotoba-v1 :x86_64 :linux :loader-v12]
                  [:x86_64-macos-kotoba-v1 :x86_64 :macos :loader-v12]
                  [:x86_64-windows-kotoba-v1 :x86_64 :windows :loader-v12]
                  [:aarch64-linux-kotoba-v1 :aarch64 :linux :loader-v12]
                  [:aarch64-macos-kotoba-v1 :aarch64 :macos :loader-v12]
                  [:aarch64-windows-kotoba-v1 :aarch64 :windows :loader-v12]
                  [:aarch64-android-kotoba-v1 :aarch64 :android :loader-v12]
                  [:aarch64-ios-kotoba-v1 :aarch64 :ios :loader-v12]
                  [:x86_64-linux-static-kotoba-v1 :x86_64 :linux :static-elf]
                  [:aarch64-linux-static-kotoba-v1 :aarch64 :linux :static-elf]]))
   {:wasm32-kotoba-v1 {:family :wasm :layout {:word-bits 32 :host :core}}
    :wasm32-browser-kotoba-v1 {:family :wasm :layout {:word-bits 32 :host :browser}}
    :wasm32-wasi-kotoba-v1 {:family :wasm :layout {:word-bits 32 :host :wasi}}
    :wasm-component-kotoba-v1 {:family :component}
    :wasm-component-kotoba-v2 {:family :component}
    :js-kotoba-v1 {:family :script :layout {:module-format :restricted-esm :host :node}}
    :js-browser-kotoba-v1 {:family :script :layout {:module-format :restricted-esm :host :browser}}
    :cljs-kotoba-v1 {:family :script :layout {:module-format :cljs-source :host :toolchain}}
    :cljs-browser-kotoba-v1 {:family :script :layout {:module-format :cljs-source :host :browser}}
    :cljs-node-kotoba-v1 {:family :script :layout {:module-format :cljs-source :host :node}}
    :evm256-kotoba-v1 {:family :evm :layout {:word-bits 256 :calling-convention :pure-zeroarg-i64}}}))

(defn profile-contract [target profile]
  (when-let [physical (get profiles target)]
    (when (and (component/profile? profile)
               (or (not= :evm (:family physical)) (= :sync profile)))
      {:format :kotoba.target-profile/v2 :target target :profile profile
        :physical physical
       :budgets (let [base (case (:family physical)
                             :native #{:fuel :memory-bytes :stack-bytes}
                             :script #{:fuel :max-frames}
                             :evm #{:gas :step-limit}
                             :wasm #{:fuel :memory-pages}
                             :component #{:fuel :memory-pages})]
                  (if (= :async profile)
                    (into base #{:deadline-ms :max-items :max-bytes}) base))
       :cancellation (if (component/cancellation-required? profile) :required :none)
       :ambient-authority false})))

(def binding-keys
  #{:format :target :profile :profile-contract-cid :artifact-cid :interface-cid
    :runtime-identity :layout})

(defn valid-binding?
  "Exact target-owned layout, never a guessed profile or automatic fallback.
  Canonical block, contract CID, artifact/interface/runtime equality are checked
  by the content/host layers; this predicate is only the closed shape gate."
  [binding]
  (let [contract (profile-contract (:target binding) (:profile binding))
        physical (:physical contract) layout (:layout binding)]
    (and (map? binding) (= binding-keys (set (keys binding)))
         (= :kotoba.target-binding/v2 (:format binding)) contract
         (every? execution/cid? ((juxt :profile-contract-cid :artifact-cid
                                      :interface-cid :runtime-identity) binding))
         (if (= :component (:family physical))
           (and (map? layout)
                (= #{:component-cid :wit-world-cid :wasi-version} (set (keys layout)))
                (= component/wasi-version (:wasi-version layout))
                (every? execution/cid? ((juxt :component-cid :wit-world-cid) layout)))
           (if (and (= :native (:family physical)) (seq (:context-versions physical)))
             (and (= (:layout physical) (dissoc layout :context-version))
                  (contains? (:context-versions physical) (:context-version layout)))
             (= (:layout physical) layout))))))
