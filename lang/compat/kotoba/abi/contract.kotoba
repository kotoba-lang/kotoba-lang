(ns kotoba.abi.contract
  "Compatibility facade. New consumers select core.execution or abi.component explicitly. Wire v1 values are unchanged."
  {:kotoba/export [ability-keys admission-keys ambient-wasi? approval-keys cancellation-required? capability-id capability-import-name capability-import-names capability-imports capability-lease-keys cid? component-authority-envelope-keys component-authority-event-keys component-authority-signing-payload component-import-key component-profiles component-target component-target-v2 component-world component-world-v2 conformance-result exact-import-grant-provider-sets? execution-identity-keys plan-keys policy-decision-keys portable-execution-v1-vectors profile? required-budget-keys stream-contract typed-capability-ids typed-capability-operation typed-capability-operations typed-capability-wit-v3 typed-capability-world-v3 valid-ability? valid-approval? valid-capability-lease? valid-component-authority-envelope? valid-component-authority-event? valid-execution-identity? valid-plan? valid-policy-decision? valid-stream-limits? wasi-version world-wit world-wit-v2]}
  (:require [kotoba.core.execution :as neutral]
            [kotoba.abi.component :as component]))

(def ability-keys neutral/ability-keys)
(def admission-keys component/admission-keys)
(def ambient-wasi? component/ambient-wasi?)
(def approval-keys neutral/approval-keys)
(def cancellation-required? component/cancellation-required?)
(def capability-id component/capability-id)
