(ns kotoba.abi.wit-data
  "GENERATED — do not edit. Run scripts/gen_wit_data.cljk.

  The authoritative WIT bytes, embedded so every platform reads the same
  string. This repository is a git dependency, so a consumer runs from its
  own root and cannot resolve a relative path into this repo's wit/ tree;
  embedding is what makes the JVM and ClojureScript copies byte-identical
  rather than merely intended to be.

  kotoba.abi.wit-data-test asserts each string still equals its file."
  {:kotoba/export [aiueos-capability-v2-wit files]})

;; aiueos-capability-v2/aiueos-capability.wit
;; The pinned aiueos:capability@0.3.0 world served to effectful consumers. The directory says v2 and the package says 0.3.0; that is the existing naming, not a mismatch.
(def aiueos-capability-v2-wit
  "package aiueos:capability@0.3.0;\n\n/// A host-owned, non-forgeable authority. There is intentionally no exported\n/// constructor or serialization method. The linker creates one only after\n/// admitting a descriptor and a live lease.\ninterface capability {\n  resource grant;\n  /// Every provider call can fail closed without exposing a host exception.\n  enum denial {\n    revoked,\n    expired,\n    quota,\n    deadline,\n    audit-unavailable,\n    provider-failed,\n  }\n  /// A named request narrows acquisition to one operation. Selecting a name\n  /// does not create authority: the host returns a grant only when that exact\n  /// operation appears in the admitted descriptor.\n  enum grant-request {\n    identity-sign,\n    identity-verify,\n    hash-sha256,\n    http-post,\n    log-read,\n    log-append,\n    clock-now,\n    http-get-stream,\n    object-get-stream,\n    object-put-block,\n    object-compare-and-set-ref,\n  }\n  record bytes-request { bytes: list<u8>, }\n  record bytes-response { bytes: list<u8>, }\n  record http-post-request {\n    path: string,\n    headers: list<tuple<string, string>>,\n    body: list<u8>,\n  }\n  record http-post-response {\n    status: u16,\n    headers: list<tuple<string, string>>,\n    body: list<u8>,\n  }\n  record log-read-request { cursor: u64, max-bytes: u32, }\n  record log-read-response { next-cursor: u64, bytes: list<u8>, }\n  record stream-chunk { bytes: list<u8>, done: bool, }\n  /// A pull-based byte stream. Every read is bounded by both the caller's\n  /// request and the admitted grant. Dropping/cancelling closes host resources.\n  resource bytes-stream {\n    read: func(max-bytes: u32) -> result<stream-chunk, denial>;\n    cancel: func();\n  }\n  variant bytes-task-state {\n    pending,\n    ready(own<bytes-stream>),\n  }\n  /// Task<Stream Bytes> without ambient executors. Poll and cancellation are\n  /// explicit so every host can enforce deadline, item, and byte budgets.\n  resource bytes-task {\n    poll: func() -> result<bytes-task-state, denial>;\n    cancel: func();\n  }\n  record http-get-stream-request {\n    path: string,\n    headers: list<tuple<string, string>>,\n  }\n  record object-get-stream-request { key: string, }\n  record object-put-block-request { key: string, bytes: list<u8>, }\n  record object-compare-and-set-ref-request {\n    key: string,\n    expected-etag: option<string>,\n    bytes: list<u8>,\n  }\n  record object-compare-and-set-ref-response {\n    won: bool,\n    etag: option<string>,\n  }\n\n  /// The only way a guest obtains a resource representation. The host binds\n  /// the returned handle to the exact admitted named operation and rejects\n  /// unadmitted, cross-interface, expired, revoked, or exhausted use. This is\n  /// issuance, not a constructor.\n  acquire: func(request: grant-request) -> result<own<grant>, denial>;\n}\n\ninterface identity {\n  use capability.{grant, denial, bytes-request, bytes-response};\n  sign: func(authority: borrow<grant>, request: bytes-request) -> result<bytes-response, denial>;\n  verify: func(authority: borrow<grant>, request: bytes-request) -> result<bool, denial>;\n}\n\ninterface hash {\n  use capability.{grant, denial, bytes-request, bytes-response};\n  sha256: func(authority: borrow<grant>, request: bytes-request) -> result<bytes-response, denial>;\n}\n\ninterface http {\n  use capability.{grant, denial, bytes-task, http-post-request, http-post-response, http-get-stream-request};\n  post: func(authority: borrow<grant>, request: http-post-request) -> result<http-post-response, denial>;\n  get-stream: func(authority: borrow<grant>, request: http-get-stream-request) -> result<own<bytes-task>, denial>;\n}\n\ninterface object-store {\n  use capability.{grant, denial, bytes-task, object-get-stream-request, object-put-block-request, object-compare-and-set-ref-request, object-compare-and-set-ref-response};\n  get-stream: func(authority: borrow<grant>, request: object-get-stream-request) -> result<own<bytes-task>, denial>;\n  put-block: func(authority: borrow<grant>, request: object-put-block-request) -> result<_, denial>;\n  compare-and-set-ref: func(authority: borrow<grant>, request: object-compare-and-set-ref-request) -> result<object-compare-and-set-ref-response, denial>;\n}\n\ninterface log {\n  use capability.{grant, denial, bytes-request, log-read-request, log-read-response};\n  read: func(authority: borrow<grant>, request: log-read-request) -> result<log-read-response, denial>;\n  append: func(authority: borrow<grant>, request: bytes-request) -> result<_, denial>;\n}\n\ninterface clock {\n  use capability.{grant, denial};\n  now: func(authority: borrow<grant>) -> result<u64, denial>;\n}\n\nworld providers {\n  export identity;\n  export hash;\n  export http;\n  export object-store;\n  export log;\n  export clock;\n}\n\n/// The world imported by a Kotoba application Component. A compiler emits a\n/// subset of these interfaces only when it can lower `acquire` and typed calls.\nworld application {\n  import capability;\n  import identity;\n  import hash;\n  import http;\n  import object-store;\n  import log;\n  import clock;\n  export main: func() -> s64;\n}\n")

(def files
  "var name -> classpath path, for the drift test."
  '{aiueos-capability-v2-wit "aiueos-capability-v2/aiueos-capability.wit"})
