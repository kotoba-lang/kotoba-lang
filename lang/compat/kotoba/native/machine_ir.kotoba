(defn- le64 [n :i64] [:list [:ref :form/r]]
     (lcat (u32le (bit-and n 4294967295)) (u32le (ushr n 32))))

(defn- shl [x :i64 n :i64] :i64 (i64-shift-left x n))

(defn- sar [x :i64 n :i64] :i64 (i64-shift-right x n))

(defn- fmod [a :i64 b :i64] :i64
     (let [r (rem a b)] (if (and (not (= r 0)) (< (bit-xor r b) 0)) (+ r b) r)))

(defn- byte-list [bytes :vector-i64] [:list [:ref :form/r]]
     (let [n (vector-count bytes)]
       (loop [i 0 acc (lnone)] (if (>= i n) acc (recur (inc i) (lconj acc (intf (vector-at bytes i))))))))

(defn- u32le [word :i64] [:list [:ref :form/r]]
     (form/kids-of (form/vec4 (intf (bit-and word 255)) (intf (bit-and (ushr word 8) 255))
                              (intf (bit-and (ushr word 16) 255)) (intf (bit-and (ushr word 24) 255)))))

(defn- align16 [n :i64] :i64 (* 16 (quot (+ n 15) 16)))

;; Hacker's Delight signed reciprocal construction. All arithmetic here is
;; wider than i64: the returned multiplier is normalized back to one signed
;; word only after the exact recurrence terminates. Keeping this computation
;; in the encoder means GMIR retains the source operation and the independent
;; verifier can deterministically re-derive the same selected bytes.
nil
nil
nil
nil
nil
nil

nil

nil

nil

nil

(defn- ult [a :i64 b :i64] :bool (< (bit-xor a -9223372036854775808) (bit-xor b -9223372036854775808)))

(defn- uge [a :i64 b :i64] :bool (not (ult a b)))

(defn- udivmod [a :i64 b :i64] :vector-i64
     (loop [i 63 q 0 r 0]
       (if (< i 0) (vector-conj (vector-conj (vector-alloc 0) q) r)
         (let [r1 (bit-or (shl r 1) (bit-and (ushr a i) 1))
               ;; r < b <= 2^64-1 so 2r+1 may wrap: the wrapped case is >= b by construction
               over? (or (< r 0) (uge r1 b))]
           (recur (dec i) (if over? (bit-or q (shl 1 i)) q) (if over? (- r1 b) r1))))))

(defn- udiv [a :i64 b :i64] :i64 (vector-at (udivmod a b) 0))

(defn- umod [a :i64 b :i64] :i64 (vector-at (udivmod a b) 1))

(defn signed-division-magic [divisor :i64] :vector-i64
     (if (or (= divisor 0) (= divisor 1) (= divisor -1))
       (vector-alloc 0)
       (let [two63 -9223372036854775808
             neg? (< divisor 0)
             ad (if neg? (- 0 divisor) divisor)
             t (+ two63 (if neg? 1 0))
             anc (- (- t 1) (umod t ad))
             q1 (udiv two63 anc)
             q2 (udiv two63 ad)
             ;; the remainders' initial values, outside the loop: a loop init that names
             ;; an earlier binding of the same loop is refused by the seed (E2111)
             r10 (- two63 (* q1 anc))
             r20 (- two63 (* q2 ad))]
         (loop [power 63 q1 q1 r1 r10 q2 q2 r2 r20]
           (let [p (inc power)
                 dq1 (* 2 q1) dr1 (* 2 r1)
                 take1 (or (< r1 0) (uge dr1 anc))
                 nq1 (if take1 (+ dq1 1) dq1)
                 nr1 (if take1 (- dr1 anc) dr1)
                 dq2 (* 2 q2) dr2 (* 2 r2)
                 take2 (or (< r2 0) (uge dr2 ad))
                 nq2 (if take2 (+ dq2 1) dq2)
                 nr2 (if take2 (- dr2 ad) dr2)
                 delta (- ad nr2)]
             (if (or (ult nq1 delta) (and (= nq1 delta) (= nr1 0)))
               (recur p nq1 nr1 nq2 nr2)
               (let [m0 (+ nq2 1)
                     m (if neg? (- 0 m0) m0)]
                 (vector-conj (vector-conj (vector-conj (vector-conj (vector-alloc 0) m) (- p 64)) (if (and (not neg?) (< m 0)) 1 0)) (if (and neg? (>= m 0)) 1 0)))))))))

