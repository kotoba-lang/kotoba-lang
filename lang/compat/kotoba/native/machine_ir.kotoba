nil

nil

nil

;; ── f64 min/max: MINSD/MAXSD alone do NOT compute this operation ─────────
;;
;; The definition is the KIR interpreter, which is `Math/min`/`Math/max` on the
;; JVM and `js/Math.min`/`js/Math.max` on cljs. Measured 2026-09-02, both arms
;; agree on every row, and AArch64's FMIN/FMAX agree with them under execution:
;;
;;   min(NaN,x)=NaN  min(x,NaN)=NaN  min(-0.0,+0.0)=-0.0  min(+0.0,-0.0)=-0.0
;;   max(NaN,x)=NaN  max(x,NaN)=NaN  max(-0.0,+0.0)=+0.0  max(+0.0,-0.0)=+0.0
;;
;; A bare `minsd xmm0, xmm1` computes `(a < b) ? a : b`, so it returns the
;; SECOND operand whenever the comparison is false -- which is exactly the two
;; cases above where the first operand should win. Executed through the Rosetta
;; loader on 2026-09-02 this cost six of the EIGHTEEN NaN/zero rows on x86-64
;; (`min(NaN,x)`, `min(-0,+0)`, `max(NaN,x)`, `max(+0,-0)` and their -2.0
;; twins), while AArch64 was right on all twenty-four of its observations. Not
;; a hypothetical: the previous encoding was a silent wrong answer on shipped
;; code.
;;
;; The repair is straight-line and branchless. `minsd a,b` is already correct
;; except in two situations, and each has a mask that names it:
;;
;;   a == b (ordered)  -- the only inputs that are equal yet differ in bits are
;;                        +0.0 and -0.0, so `a|b` is the min (sign bit wins) and
;;                        `a&b` is the max. For equal non-zero inputs the bits
;;                        are identical and both are the identity.
;;   a is NaN          -- the answer is `a` itself. When only *b* is NaN the
;;                        bare MINSD/MAXSD already returns b, because the
;;                        comparison against a NaN is false.
;;
;; So: result = a-is-NaN ? a : (a==b ? a|b : minsd(a,b)). Every byte below was
;; assembled with `llvm-mc -arch=x86-64 -show-encoding`, not derived by hand.
;; The sequence borrows xmm2/xmm3/xmm4, which is safe for the same reason
;; xmm0/xmm1 are: no f64 value is live in the SSE bank across an operation --
;; every one of them bounces in from a general register and back out again.
nil

;; ── f32 encoders ─────────────────────────────────────────────────────────
;;
;; Every byte below was assembled with `clang -target x86_64-apple-macos` and
;; read back with `otool -t`, not derived from the manual and trusted. The
;; AArch64 twin's FADD came out wrong by hand (0x1E202800 derived, 0x1E212800
;; assembled), which is the whole argument for doing it this way.
;;
;; MOVD, not MOVQ: the operand is 32 bits and the upper half of the word is not
;; part of the value. Writing a 32-bit destination also ZEROES the upper half of
;; the 64-bit register, which is why every f32-producing sequence ends in a
;; MOVSXD -- the canonical word is the pattern SIGN-extended from bit 31.

nil

nil

;; movsxd r64, r32 over the same register: re-establish the sign extension a
;; 32-bit write has just destroyed.
nil

;; cvtsi2ss / cvtsi2sd read the 64-bit general register directly, so there is no
;; move in -- only out. `prefix` is 0xf3 for single, 0xf2 for double.
nil

nil

nil

nil

;; UCOMISS is UCOMISD without the 0x66 prefix and sets identical flags --
;; ZF=PF=CF=1 when either operand is NaN -- so the condition codes, the operand
;; swap for lt/le, and the extra PF test for equality are the f64 sequence
;; unchanged. The result is a 0/1 word, so no sign extension is involved.
nil

;; `movabs r64,imm64` is ten bytes (eleven for r8-r15) whatever the value is,
;; so a literal 1 costs exactly what 2^63 costs. Two narrower forms cover
;; almost every constant a program contains:
;;
;;   0 <= v <= 0xFFFFFFFF   mov r32,imm32   five bytes, zero-extends to 64
;;   -2^31 <= v < 0         mov r64,imm32   seven bytes, sign-extends
;;
;; `xor r32,r32` would encode zero in two, and is deliberately not used: it
;; writes flags where a `mov` writes none, and these bytes land in a stream
;; whose later instructions were emitted expecting no flag change.
;;
;; Narrowing is sound because every intra-function branch is a
;; `kotoba.codegen.layout` token, so displacements resolve after final token
;; sizes are known.
nil

nil

;; The full-width form, for values that are NOT final when their width is
;; chosen. `resolve-program-layout` reserves a token's width from a first pass
;; and then demands exactly that many bytes back; a data address is not known
;; until the layout resolves, so narrowing it would reserve ten bytes for an
;; offset that later encodes in five and trip the reserved-width check — which
;; is precisely what it is there to catch. Compile-time constants have no such
;; problem: their value is final before anything is sized.
;; x86-64 folds a constant straight into add, sub and multiply, so the separate
;; `mov reg,imm` that fed them disappears along with the register it occupied.
;; Every one of these immediates is a sign-extended imm32, so a value outside
;; the signed 32-bit range keeps the two-instruction form.
;;
;;   add r64,imm32   REX.W 81 /0 id
;;   sub r64,imm32   REX.W 81 /5 id
;;   imul r64,r64,imm32   REX.W 69 /r id   -- three-operand, so dst may differ
;;                                            from the source and no move is
;;                                            needed ahead of it either
nil

nil

;; `lea dst,[src+disp]` computes what `mov dst,src` then `add dst,imm` computes,
;; in one instruction, when the destination differs from the source. It is sound
;; here because it writes no flags and nothing reads the flags the `add` wrote:
;; every flag consumer this backend emits carries its own producer in the same
;; unit — `x86-compare` puts `cmp` immediately before `setcc`, and
;; `:mc/branch-zero` puts `test reg,reg` immediately before `jz`. No flag ever
;; travels between two MIR instructions.
;;
;; Returns nil when the base register would need a SIB byte (RSP and R12 encode
;; rm=100, which means "SIB follows"), leaving the caller on the two-instruction
;; form rather than emitting a different addressing mode than it intended.
nil

nil

nil

nil

nil

nil

(defn- cat3 [a [:list [:ref :form/r]] b [:list [:ref :form/r]] c [:list [:ref :form/r]]] [:list [:ref :form/r]] (lcat (lcat a b) c))

(defn- cat4 [a [:list [:ref :form/r]] b [:list [:ref :form/r]] c [:list [:ref :form/r]] d [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (lcat (lcat (lcat a b) c) d))

(defn- a64-register-code [register [:ref :form/r]] :i64
     (if (form/is-keyword? register)
       (let [t (ktext register) n (string-byte-length t)]
         (if (and (> n 10) (< n 13) (string=? (string-substring t 0 10) ":aarch64/x"))
           (let [digits (string-substring t 10 n)
                 k (string-byte-length digits)
                 ok (and (or (= k 1) (not (= 48 (string-code-point-at digits 0))))
                         (loop [i 0] (if (>= i k) true (let [c (string-code-point-at digits i)] (if (and (>= c 48) (<= c 57)) (recur (inc i)) false)))))
                 v (if ok (decimal-of digits) -1)]
             (if (or (and (>= v 0) (<= v 17)) (and (>= v 19) (<= v 26))) v -1))
           -1))
       -1))

(defn- a64-register [register [:ref :form/r]] :i64
     (let [c (a64-register-code register)]
       (if (< c 0) (trap!) c)))

(defn- a64-mov [dst [:ref :form/r] src [:ref :form/r]] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or 0xaa0003e0 (shl (a64-register src) 16)) (a64-register dst))))

(defn- a64-constant-chunks [value :i64] :vector-i64
     (vector-conj (vector-conj (vector-conj (vector-conj (vector-alloc 0) (bit-and value 65535)) (bit-and (ushr value 16) 65535)) (bit-and (ushr value 32) 65535)) (bit-and (ushr value 48) 65535)))

(defn- a64-wide-move [opcode :i64 rd :i64 chunk :i64 lane :i64] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or opcode (shl lane 21)) (bit-or (shl chunk 5) rd))))

(defn- chunk-bit [chunks :vector-i64 index :i64] :bool
     (not (= 0 (bit-and (vector-at chunks (quot index 16)) (shl 1 (rem index 16))))))

(defn- a64-periodic? [chunks :vector-i64 width :i64] :bool
     (loop [i 0] (if (>= i 64) true (if (= (chunk-bit chunks i) (chunk-bit chunks (rem i width))) (recur (inc i)) false))))

(defn- a64-element-ones [chunks :vector-i64 width :i64] :i64
     (loop [i 0 n 0] (if (>= i width) n (recur (inc i) (if (chunk-bit chunks i) (inc n) n)))))

(defn- a64-element-transitions [chunks :vector-i64 width :i64] :i64
     (loop [i 0 n 0]
       (if (>= i width) n
         (recur (inc i) (if (= (chunk-bit chunks i) (chunk-bit chunks (rem (inc i) width))) n (inc n))))))

(defn- a64-element-start [chunks :vector-i64 width :i64] :i64
     (loop [i 0]
       (if (>= i width) -1
         (if (and (chunk-bit chunks i) (not (chunk-bit chunks (fmod (dec i) width)))) i (recur (inc i))))))

(defn- a64-logical-width [chunks :vector-i64 width :i64] :vector-i64
     (if (a64-periodic? chunks width)
       (let [ones (a64-element-ones chunks width)
             transitions (a64-element-transitions chunks width)
             start (a64-element-start chunks width)]
         (if (and (< 0 ones) (< ones width) (= 2 transitions) (>= start 0))
           (vector-conj (vector-conj (vector-conj (vector-alloc 0) (if (= width 64) 1 0)) (fmod (- width start) width)) (bit-or (bit-and (- (* 2 width)) 63) (dec ones)))
           (vector-alloc 0)))
       (vector-alloc 0)))

(defn- a64-logical-immediate-fields [chunks :vector-i64] :vector-i64
     (loop [w 2]
       (if (> w 64) (vector-alloc 0)
         (let [r (a64-logical-width chunks w)]
           (if (> (vector-count r) 0) r (recur (* w 2)))))))

(defn- a64-logical-word [rd :i64 f :vector-i64] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or 0xb20003e0 (shl (vector-at f 0) 22))
                    (bit-or (bit-or (shl (vector-at f 1) 16) (shl (vector-at f 2) 10)) rd))))

(defn- a64-logical-immediate [rd :i64 chunks :vector-i64] [:list [:ref :form/r]]
     (let [f (a64-logical-immediate-fields chunks)]
       (if (= 0 (vector-count f)) (lnone) (a64-logical-word rd f))))

nil

(defn- vassoc4 [v :vector-i64 i :i64 x :i64] :vector-i64
     (vector-conj (vector-conj (vector-conj (vector-conj (vector-alloc 0) (if (= i 0) x (vector-at v 0))) (if (= i 1) x (vector-at v 1))) (if (= i 2) x (vector-at v 2))) (if (= i 3) x (vector-at v 3))))

(defn- a64-logical-seed-plan [chunks :vector-i64] :vector-i64
     (loop [k 0]
       (if (>= k 8) (vector-alloc 0)
         (let [replacement (if (< k 4) 0 65535)
               lane (rem k 4)
               r (if (not (= replacement (vector-at chunks lane)))
                   (a64-logical-immediate-fields (vassoc4 chunks lane replacement))
                   (vector-alloc 0))]
           (if (> (vector-count r) 0)
             (vector-conj (vector-conj (vector-conj (vector-conj (vector-alloc 0) (vector-at r 0)) (vector-at r 1)) (vector-at r 2)) lane)
             (recur (inc k)))))))

(defn- a64-logical-seeded-wide [rd :i64 chunks :vector-i64] [:list [:ref :form/r]]
     (let [p (a64-logical-seed-plan chunks)]
       (if (= 0 (vector-count p)) (lnone)
         (lcat (a64-logical-word rd p)
               (a64-wide-move 0xf2800000 rd (vector-at chunks (vector-at p 3)) (vector-at p 3))))))

(defn- a64-constant-fixed [dst [:ref :form/r] value :i64] [:list [:ref :form/r]]
     (let [rd (a64-register dst) c (a64-constant-chunks value)]
       (cat4 (a64-wide-move 0xd2800000 rd (vector-at c 0) 0)
             (a64-wide-move 0xf2800000 rd (vector-at c 1) 1)
             (a64-wide-move 0xf2800000 rd (vector-at c 2) 2)
             (a64-wide-move 0xf2800000 rd (vector-at c 3) 3))))

(defn- lanes-not [chunks :vector-i64 x :i64] :vector-i64
     (loop [i 0 acc (vector-alloc 0)] (if (>= i 4) acc (recur (inc i) (if (= (vector-at chunks i) x) acc (vector-conj acc i))))))

(defn- a64-constant [dst [:ref :form/r] value :i64] [:list [:ref :form/r]]
     (let [rd (a64-register dst)
           chunks (a64-constant-chunks value)
           movz-lanes (lanes-not chunks 0)
           movn-lanes (lanes-not chunks 65535)
           movn? (< (max 1 (vector-count movn-lanes)) (max 1 (vector-count movz-lanes)))
           lanes (if movn? movn-lanes movz-lanes)
           first-lane (if (> (vector-count lanes) 0) (vector-at lanes 0) 0)
           fill (if movn? 65535 0)
           first-chunk (vector-at chunks first-lane)
           initial (a64-wide-move (if movn? 0x92800000 0xd2800000) rd
                                  (if movn? (bit-and (bit-xor first-chunk -1) 65535) first-chunk) first-lane)
           wide (loop [lane 0 out initial]
                  (if (>= lane 4) out
                    (recur (inc lane)
                           (if (and (not (= lane first-lane)) (not (= fill (vector-at chunks lane))))
                             (lcat out (a64-wide-move 0xf2800000 rd (vector-at chunks lane) lane))
                             out))))
           logical (a64-logical-immediate rd chunks)
           logical-seeded (if (and (= 0 (lcount logical)) (> (lcount wide) 8))
                            (a64-logical-seeded-wide rd chunks)
                            (lnone))
           selected (if (and (> (lcount logical-seeded) 0) (< (lcount logical-seeded) (lcount wide))) logical-seeded wide)]
       (if (and (> (lcount logical) 0) (< (lcount logical) (lcount selected))) logical selected)))

(defn- a64-compare [cset :i64 dst [:ref :form/r] left [:ref :form/r] right [:ref :form/r]] [:list [:ref :form/r]]
     (lcat (u32le (bit-or 0xeb00001f (bit-or (shl (a64-register right) 16) (shl (a64-register left) 5))))
           (u32le (bit-or cset (a64-register dst)))))

(defn- a64-f64-binary [base :i64 dst [:ref :form/r] left [:ref :form/r] right [:ref :form/r]] [:list [:ref :form/r]]
     (cat4 (u32le (bit-or 0x9e670000 (shl (a64-register left) 5)))
           (u32le (bit-or 0x9e670001 (shl (a64-register right) 5)))
           (u32le base)
           (u32le (bit-or 0x9e660000 (a64-register dst)))))

(defn- a64-f64-compare [cset :i64 dst [:ref :form/r] left [:ref :form/r] right [:ref :form/r]] [:list [:ref :form/r]]
     (cat4 (u32le (bit-or 0x9e670000 (shl (a64-register left) 5)))
           (u32le (bit-or 0x9e670001 (shl (a64-register right) 5)))
           (u32le 0x1e612000)
           (u32le (bit-or cset (a64-register dst)))))

;; ── AArch64 f32 encoders ─────────────────────────────────────────────────
;;
;; Each single-precision word is its double-precision twin with the `ftype`
;; field narrowed (bit 22 cleared); the two FMOV general-register forms clear
;; `sf` as well. That is a derivation, so it was checked and not trusted: every
;; word here was assembled with `clang -target arm64-apple-macos` and read back
;; with `otool -t`. It earned its keep -- FADD S0,S0,S1 derives to 0x1E202800
;; by hand and assembles to 0x1E212800.
;;
;; FMOV S,W and FMOV W,S, not FMOV D,X / FMOV X,D: the value is 32 bits.
;; Writing a W register zeroes the upper half of its X register, which is why
;; every f32-producing sequence ends in SXTW.

(defn- a64-fmov-s0-w [register [:ref :form/r]] [:list [:ref :form/r]] (u32le (bit-or 0x1e270000 (shl (a64-register register) 5))))

(defn- a64-fmov-s1-w [register [:ref :form/r]] [:list [:ref :form/r]] (u32le (bit-or 0x1e270001 (shl (a64-register register) 5))))

(defn- a64-fmov-w-s0 [register [:ref :form/r]] [:list [:ref :form/r]] (u32le (bit-or 0x1e260000 (a64-register register))))

;; SXTW Xd, Wd -- re-establish the sign extension the FMOV W has destroyed.
(defn- a64-sxtw [register [:ref :form/r]] [:list [:ref :form/r]]
     (let [r (a64-register register)] (u32le (bit-or 0x93407c00 (bit-or (shl r 5) r)))))

(defn- a64-f32-binary [base :i64 dst [:ref :form/r] left [:ref :form/r] right [:ref :form/r]] [:list [:ref :form/r]]
     (lcat (cat4 (a64-fmov-s0-w left) (a64-fmov-s1-w right) (u32le base) (a64-fmov-w-s0 dst)) (a64-sxtw dst)))

;; FCMP sets exactly the same flags for single as for double, including
;; N=0 Z=0 C=1 V=1 when unordered, so the CSET words are the f64 table's
;; unchanged and only the compare narrows.
(defn- a64-f32-compare [cset :i64 dst [:ref :form/r] left [:ref :form/r] right [:ref :form/r]] [:list [:ref :form/r]]
     (cat4 (a64-fmov-s0-w left) (a64-fmov-s1-w right) (u32le 0x1e212000) (u32le (bit-or cset (a64-register dst)))))

nil

nil

nil

nil

nil

(defn- memory-label [instruction-index :i64 suffix :string] [:ref :form/r]
     (kf (keyword-from-string (string-concat "kotoba.native.kernel-memory/" (string-concat suffix (string-concat "-" (string-from-i64 instruction-index)))))))

nil

nil

nil

nil

nil

nil

nil

;; sysops: the general atomic read-modify-writes.
;;
;; Where `x86-kernel-lock` above fixes both comparand and replacement, these
;; take the word from the guest. Every byte string below was taken from the
;; system assembler rather than derived by hand -- the lock's own comment
;; records what a hand carry costs.
;;
;;   lock xadd    [r11], r10d   f0 45 0f c1 13     lock xadd    [r11], r10  f0 4d 0f c1 13
;;   lock cmpxchg [r11], r10d   f0 45 0f b1 13     lock cmpxchg [r11], r10  f0 4d 0f b1 13
;;   xchg         [r11], r10d      45 87 13        xchg         [r11], r10     4d 87 13
;;
;; XCHG with a memory operand asserts LOCK implicitly, so it carries no F0
;; prefix. That is the architecture's rule and not an omission.
;;
;; R10 carries the guest's operand: it is dead after the bounds check, so
;; nothing allocated is disturbed. All three answer with the word memory held
;; BEFORE the operation, which is what the instruction leaves behind -- `xadd`
;; and `xchg` in the source register, `cmpxchg` in EAX/RAX either way.
;;
;; For the 32-bit spellings the result needs no widening: a write to a 32-bit
;; register zeroes the upper half, so `xadd`/`xchg` into R10D and `mov r10d,
;; eax` all leave R10 holding the old word zero-extended -- which is what the
;; KIR oracle answers.
nil
;; sysops: end

nil

(defn- rb [enc :keyword target [:ref :form/r]] [:list [:ref :form/r]] (lone (layout-relative-branch enc target)))

(defn- rbo [enc :keyword target [:ref :form/r] reg :i64] [:list [:ref :form/r]]
     (lone (layout-relative-branch-ops enc target (lone (intf reg)))))

(defn- lbl [id [:ref :form/r]] [:list [:ref :form/r]] (lone (layout-label id)))

(defn- trap-tail [done [:ref :form/r] trap [:ref :form/r]] [:list [:ref :form/r]]
     (cat4 (rb :aarch64/b-imm26 done) (lbl trap) (u32le 0xd4200000) (lbl done)))

(defn- a64-alignment-check [trap [:ref :form/r] bytes :i64 register [:ref :form/r]] [:list [:ref :form/r]]
     (if (<= bytes 1)
       (lnone)
       (let [imms (cond (= bytes 2) 0 (= bytes 4) 1 :else 2)]
         (lcat (u32le (bit-or (bit-or 0xf2400000 (shl imms 10)) (bit-or (shl (a64-register register) 5) 31)))
               (rb :aarch64/b-ne-imm19 trap)))))
;; ── simd: the f32 dot product ───────────────────────────────────────────────
;;
;; kotoba-gmir ADR 0010's `kernel-dot-f32`, as ONE opaque MC instruction.
;;
;; THE ACCUMULATION TREE IS THE CONTRACT (kotoba-kir ADR 0233), and the two
;; arms below are required to produce BIT-IDENTICAL results. They do, by
;; construction rather than by measurement:
;;
;;   four lane accumulators, all +0.0
;;   while eight or more elements remain:
;;       lane k += a[i+k]   * b[i+k]      for k = 0..3   (the lower half)
;;       lane k += a[i+4+k] * b[i+4+k]    for k = 0..3   (the upper half)
;;       i += 8
;;   sum = (lane0 + lane1) + (lane2 + lane3)
;;   for each remaining element: sum += a[i] * b[i]
;;
;; Each lane is an INDEPENDENT chain of the same additions in the same order in
;; both arms -- four lanes of one XMM register in the AVX2 arm, four separate
;; XMM registers in the scalar one -- and interleaving between independent
;; chains cannot change a result. The reduction is two `vhaddps` on 128 bits in
;; the AVX2 arm and three `addss` in the scalar one, which compute the same
;; pairwise tree: `HADDPS x,x` yields [s0+s1, s2+s3, ...], so a second one
;; yields (s0+s1)+(s2+s3) in lane 0.
;;
;; That is why the reduction is pairwise rather than the left-to-right chain
;; `dot_avx2` uses in aiueos: a left-to-right chain needs three lane
;; extractions, where the pairwise one is an instruction the AVX arm already
;; has. The LOOP is `dot_avx2`'s (eight at a time, lower before upper) rather
;; than `dot_scalar`'s (four at a time) because eight is what a 256-bit
;; register does, and a scalar sequence can imitate a vector while a vector
;; cannot imitate an arbitrary scalar order.
;;
;; No FMA. `vfmadd231ps` rounds once where `vmulps` + `vaddps` round twice, so
;; it computes a DIFFERENT value -- and it is a separate feature bit (leaf 1
;; ECX[12]) that an AVX2 CPU is not required to have, so a third arm would be a
;; third answer.
;;
;; CLOBBER DISCIPLINE. R9 is the context register and is untouched. R10, R11
;; and every XMM/YMM register are scratch, because no allocator in this
;; repository allocates one. Everything else this sequence writes is pushed and
;; popped by the sequence itself: RAX, RCX and RDX because `cpuid` writes them
;; unconditionally, and RBX because `cpuid` writes it AND it is callee-saved.
;; That last one is not a courtesy -- `kotoba.mir/saved-registers` derives a
;; function's frame saves from a tree-seq over the INSTRUCTION MAPS, so a
;; register a byte sequence clobbers without naming is a register nothing
;; saves.
;;
;; THE OPERANDS ARE RESCUED TO THE STACK BEFORE THE GUARD RUNS. They may be
;; allocated to RAX, RCX, RDX or RBX, all four of which `cpuid` destroys, and
;; only two scratch registers exist to hold five values. So the sequence pushes
;; the three it still needs, runs the guard, and pops them into R10/R11/RBX
;; afterwards. `test` sets ZF before the pops and POP does not touch the flags,
;; which is what lets the branch happen after six of them -- the same property
;; `x86-kernel-lock` already relies on.
;;
;; The four branch encodings used are the four the layout pass has: `ja`,
;; `jae`, `jz`, `jmp`. There is no `jb` and no `jne` at rel32 width, so the
;; three guard failures are spelled as "jump over a jump" rather than as a
;; conditional branch to the failure label. That is three extra bytes each and
;; no new layout encoding, which is the right trade for a sequence that runs
;; once per call.

nil

nil

;; ── simd: the AArch64 arm of the same accumulation tree ─────────────────────
;;
;; ONE ARM, AND IT IS SCALAR. That is the decision (2026-09-09) and not a gap:
;; the contract of `kernel-dot-f32` is an ORDER OF SUMMATION, not a dot
;; product, so the only AArch64 answer that may be called the same operation is
;; the one that reproduces the x86 arms' order exactly. NEON can hold four
;; lanes as well as SSE can, but the cheap NEON reduction (`faddp`) computes a
;; DIFFERENT tree, and the expensive one that computes this tree costs the
;; lane extractions the scalar sequence does not pay. Speed was weighed against
;; bit-identity and bit-identity won, because a provider network prices work by
;; agreeing on the answer.
;;
;; So this is `x86-kernel-dot-f32`'s SCALAR arm, instruction for instruction:
;; four accumulators, elements 0..3 of each eight-element block into lanes
;; 0..3, then elements 4..7 into the same four lanes in the same order, then
;; `(s0+s1)+(s2+s3)`, then the ≤7-element tail onto lane 0. AArch64 scalar
;; single-precision FMUL and FADD are IEEE-754 round-to-nearest-even on exactly
;; the operands SSE's `mulss`/`addss` are, so the two agree by construction.
;;
;; NO FMADD. `FMADD S,S,S,S` rounds once where FMUL+FADD round twice, which is
;; a MORE accurate answer and therefore the wrong one. Nothing in this sequence
;; may be peephole-fused into it -- the two words are emitted here as bytes and
;; never pass the MIR peephole, which is why the hazard is stated rather than
;; guarded.
;;
;; NO FEATURE GUARD, because there is nothing to guard: FMUL/FADD/SCVTF/LDR-S
;; are AArch64 base, present on every implementation of the architecture. The
;; x86 side needs `cpuid` to choose between two arms; one arm needs no choice.
;;
;; CLOBBER DISCIPLINE. `kotoba.mir` hands this operation the call-argument tier
;; (x0..x4) with nothing live across it, so those five and the encoder scratch
;; pair x16/x17 are all this sequence writes. x7 is the context register and is
;; untouched. V0..V5 are scratch: no allocator in this repository allocates a
;; vector register, and `a64-simd-park-spills` parks into d16+ only.

(defn- unaligned-access? [op :keyword maximum [:ref :form/r]] :bool
     (and (or (= op :gmir/kernel-load-u32) (= op :gmir/kernel-store-u32)) (form/eq maximum (intf 512))))

(defn- a64-add-rr [dst [:ref :form/r] left [:ref :form/r] right [:ref :form/r]] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or 0x8b000000 (shl (a64-register right) 16)) (bit-or (shl (a64-register left) 5) (a64-register dst)))))

(defn- a64-add-imm [dst [:ref :form/r] src [:ref :form/r] amount :i64] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or 0x91000000 (shl amount 10)) (bit-or (shl (a64-register src) 5) (a64-register dst)))))

(defn- a64-sub-imm [dst [:ref :form/r] src [:ref :form/r] amount :i64] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or 0xd1000000 (shl amount 10)) (bit-or (shl (a64-register src) 5) (a64-register dst)))))

;; CMP Xn, #imm12 -- SUBS XZR, Xn, #imm.
(defn- a64-cmp-imm [register [:ref :form/r] amount :i64] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or 0xf100001f (shl amount 10)) (shl (a64-register register) 5))))

;; CMP Xn, Xm -- SUBS XZR, Xn, Xm. `b.hi` after it is "n above m", unsigned,
;; which is what `ja` is after the x86 `cmp`.
(defn- a64-cmp-rr [left [:ref :form/r] right [:ref :form/r]] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or 0xeb00001f (shl (a64-register right) 16)) (shl (a64-register left) 5))))

;; LDR St, [Xn, #disp] -- the unsigned-offset form, so DISP is a byte offset
;; and a multiple of four. Every use here is a block offset of 0..28.
(defn- a64-f32-load [vt :i64 base [:ref :form/r] disp :i64] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or 0xbd400000 (shl (quot disp 4) 10)) (bit-or (shl (a64-register base) 5) vt))))

;; The three-register scalar-single words, derived the way this file's other
;; f32 encoders are: FADD is `0001 1110 ftype=00 1 Rm 001010 Rn Rd` and FMUL is
;; the same with opcode 000010. Both bases were checked against the existing
;; fixed-register words -- `(bit-or a64-fadd-s (bit-shift-left 1 16))` is
;; 0x1E212800, which is exactly the `:aarch64/f32-add` word above.
(defn- a64-fadd-s [] :i64 0x1e202800)
(defn- a64-fmul-s [] :i64 0x1e200800)

(defn- a64-f32-rrr [base :i64 d :i64 n :i64 m :i64] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or base (shl m 16)) (bit-or (shl n 5) d))))

;; FMOV St, WZR -- +0.0, and the pattern rather than an arithmetic identity, so
;; the accumulator starts at positive zero and nowhere else.
(defn- a64-f32-zero [vt :i64] [:list [:ref :form/r]] (u32le (bit-or (bit-or 0x1e270000 (shl 31 5)) vt)))

;; SCVTF Sd, Xn -- the whole 64-bit register, as the x86 arm's REX.W
;; `cvtsi2ss` reads it. A 32-bit conversion of -1 would answer 4294967295.0f.
(defn- a64-scvtf-s-x [vd :i64 register [:ref :form/r]] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or 0x9e220000 (shl (a64-register register) 5)) vd)))

;; LDRSB Xt, [Xn, #disp] -- sign-extending byte load into the 64-bit register,
;; which is the missing half of the pair above: SCVTF has to see -1 and not
;; 255. `10 111 0 01 10 imm12 Rn Rt`.
(defn- a64-ldrsb-x [dst [:ref :form/r] base [:ref :form/r] disp :i64] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or 0x39800000 (shl disp 10)) (bit-or (shl (a64-register base) 5) (a64-register dst)))))

;; LDRH Wt, [Xn, #disp] -- zero-extending halfword, for the fp16 scale.
(defn- a64-ldrh-w [dst [:ref :form/r] base [:ref :form/r] disp :i64] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or 0x79400000 (shl (quot disp 2) 10)) (bit-or (shl (a64-register base) 5) (a64-register dst)))))

(defn- dot-label [instruction-index :i64 suffix :string] [:ref :form/r]
     (memory-label instruction-index (string-concat "a64-dot-" suffix)))

(defn- dot-step [pa [:ref :form/r] pb [:ref :form/r] disp :i64 lane :i64] [:list [:ref :form/r]]
     (cat4 (a64-f32-load 4 pa disp) (a64-f32-load 5 pb disp) (a64-f32-rrr (a64-fmul-s) 4 4 5) (a64-f32-rrr (a64-fadd-s) lane lane 4)))

(defn- counted-loop [body-label [:ref :form/r] check-label [:ref :form/r] remaining [:ref :form/r] bound :i64 body [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (lcat (cat4 (rb :aarch64/b-imm26 check-label) (lbl body-label) body (lbl check-label))
           (lcat (a64-cmp-imm remaining bound) (rb :aarch64/b-hs-imm19 body-label))))

(defn- a64-kernel-dot-f32 [instruction-index :i64 instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [dst (fget instruction :mir/dst) base (fget instruction :mir/base) length (fget instruction :mir/length)
           second-base (fget instruction :mir/second-base) second-length (fget instruction :mir/second-length)
           maximum (fint instruction :mir/maximum)
           elements (fget instruction :mir/count)
           trap (dot-label instruction-index "trap") done (dot-label instruction-index "done")
           pa base pb second-base remaining elements
           x16 (kf :aarch64/x16)
           frame (a64-saved-frame (distinct-forms (form/three-forms base second-base elements)) (nf))
           checks (lcat (lcat (cat4 (a64-constant x16 maximum) (a64-cmp-rr length x16) (rb :aarch64/b-hi-imm19 trap) (a64-cmp-rr second-length x16))
                              (cat4 (rb :aarch64/b-hi-imm19 trap) (rbo :aarch64/cbz-imm19 trap (a64-register base))
                                    (rbo :aarch64/cbz-imm19 trap (a64-register second-base)) (a64-constant x16 (quot maximum 4))))
                        (lcat (cat4 (a64-cmp-rr elements x16) (rb :aarch64/b-hi-imm19 trap) (a64-mov x16 elements) (a64-add-rr x16 x16 x16))
                              (cat4 (a64-add-rr x16 x16 x16) (a64-cmp-rr x16 length) (rb :aarch64/b-hi-imm19 trap)
                                    (lcat (a64-cmp-rr x16 second-length) (rb :aarch64/b-hi-imm19 trap)))))
           block-body (lcat (lcat (cat4 (dot-step pa pb 0 0) (dot-step pa pb 4 1) (dot-step pa pb 8 2) (dot-step pa pb 12 3))
                                  (cat4 (dot-step pa pb 16 0) (dot-step pa pb 20 1) (dot-step pa pb 24 2) (dot-step pa pb 28 3)))
                            (cat3 (a64-add-imm pa pa 32) (a64-add-imm pb pb 32) (a64-sub-imm remaining remaining 8)))
           tail-body (cat4 (dot-step pa pb 0 0) (a64-add-imm pa pa 4) (a64-add-imm pb pb 4) (a64-sub-imm remaining remaining 1))]
       (lcat (lcat (cat4 checks (kids (fget frame :save))
                         (cat4 (a64-f32-zero 0) (a64-f32-zero 1) (a64-f32-zero 2) (a64-f32-zero 3))
                         (counted-loop (dot-label instruction-index "block") (dot-label instruction-index "block-check") remaining 8 block-body))
                   (cat4 (a64-f32-rrr (a64-fadd-s) 0 0 1) (a64-f32-rrr (a64-fadd-s) 2 2 3) (a64-f32-rrr (a64-fadd-s) 0 0 2)
                         (counted-loop (dot-label instruction-index "tail") (dot-label instruction-index "tail-check") remaining 1 tail-body)))
             (cat4 (kids (fget frame :restore)) (a64-fmov-w-s0 dst) (a64-sxtw dst) (trap-tail done trap)))))
;; simd: end

;; ── dequant: the fused dequantize-and-dot family ────────────────────────────
;;
;; `kernel-dot-f32` folds two f32 regions. A transformer's weights are not f32
;; -- 490 of the Qwen3.5 model's 866 tensors are Q8_0, Q4_K or Q6_K -- so
;; using it means materialising a dequantized row somewhere first, which is a
;; write of four bytes per weight into memory that is read once. The fusion
;; removes that traffic: the codes are widened INSIDE the register file and
;; multiplied by the activations without ever reaching memory as f32.
;;
;; ONE OPAQUE MC INSTRUCTION PER FORMAT, the way `kernel-dot-f32` is one. The
;; guard, both arms, and the loop belong to the instruction, because what the
;; instruction exists to select is a sequence and not an expression.
;;
;; THE OPERAND SHAPE IS BLOCK-SCALE. A quantized row is a vector of BLOCKS,
;; and the byte stride and the element stride are different numbers, so
;; `:mir/count` counts blocks and BOTH spans are derived from it. Nothing here
;; assumes the two regions are the same length; they never are.
;;
;; THE ACCUMULATION TREE IS `kernel-dot-f32`'S, and there is no tail: every
;; format's block is a whole number of eight-element groups (32, 256, 256), so
;; a partial group cannot occur. Four accumulators; the lower half of each
;; group before its upper half; `(s0+s1)+(s2+s3)` at the end. It is
;; `dot_scalar` in `os/aiueos/kernel/qwen35_infer.c:234`, and it is the
;; contract because the C has TWO trees and only this one is reproducible.
;;
;; NO FMA, DELIBERATELY. `y = q*d` then `sum += y*a` is two roundings, and
;; `vfmadd231ps` would fuse the second one away -- giving a MORE accurate
;; answer that differs from the oracle's, which is the one thing an arm of
;; this pair may not do.

nil

(defn- x86-dequant-magic [] :i64 0x77800000)

nil

;; ── dequant-iq: where a K-quant block's parameters change ───────────────────
;;
;; Q8_0's four eight-element groups are a LOOP: every group reads eight
;; consecutive bytes, scales them by the one number the block header carries,
;; and steps both pointers by a constant. The K-quants are not loops, and the
;; reason is in the formats rather than in this backend:
;;
;;   Q4_K  144 bytes -- d, dmin, twelve packed six-bit (scale, min) pairs,
;;         then 128 bytes of nibble pairs. A 64-element half takes ONE
;;         (scale, min) pair for the low nibbles of thirty-two bytes and
;;         ANOTHER for the high nibbles of the SAME thirty-two bytes, so which
;;         byte a group reads, which half of it, and which pair scales it all
;;         change on different periods, and the byte offset does not advance
;;         monotonically with the output index.
;;
;;   Q6_K  210 bytes -- 128 low-nibble bytes, 64 two-bit-pair bytes, sixteen
;;         signed scales, d. The scale index changes every sixteen elements
;;         and the two-bit field's shift every thirty-two, and each low byte
;;         is read twice, its two halves landing sixty-four elements apart in
;;         the output.
;;
;; So the thirty-two groups are unrolled and every displacement is a constant
;; computed here. That is also why the pointers move ONCE per block: `[pw+d]`
;; and `[px+d]` reach the whole of it, and the two adds that close the body
;; are the only arithmetic either pointer sees.
;;
;; THE ACCUMULATION TREE IS UNCHANGED. Both arms of all three formats fold
;; eight elements into four accumulators, lower half then upper half, lane by
;; lane, and finish with `(s0+s1)+(s2+s3)`. What differs between the formats
;; is only how a code becomes a float.

nil

nil

nil

nil

nil

nil

;; ── dequant-ptq1: PTQ1_0's geometry (ADR 0088) ──────────────────────────────
;;
;; A 28-byte block: `qs[24]` at 0 holding five base-3 digits per byte, `qh[2]`
;; at 24 holding four, then `d` as fp16 at 26. `dequantize_row_ptq1_0`
;; (PrismML-Eng/llama.cpp @9a9394a8, `ggml/src/ggml-quants.c:2255`) writes
;; three stages: qs[m] for digit n 0..4, m 0..15; qs[16+m] for n 0..4, m 0..7;
;; qh[h] for n 0..3, h 0..1. Digit n of a byte is `((byte*3^n) & 255)*3 >> 8`
;; and the weight is `(digit - 1) * d`.
;;
;; So fifteen of the sixteen eight-element groups read EIGHT CONSECUTIVE BYTES
;; AT ONE DIGIT, which is a load and a widening. The sixteenth reads qh[0] and
;; qh[1] alternately at digits 0,0,1,1,2,2,3,3, which no load can gather.

nil

nil

nil

nil

nil

nil
;; dequant: end

;; ── dequant: the AArch64 arm of the fused dequantize-and-dot ────────────────
;;
;; Q8_0 ONLY, and the other six formats stay refused. That is not tidiness: a
;; `case` with a missing arm would emit a loop with an EMPTY BODY, which is a
;; working instruction that answers +0.0 for every row on every machine while
;; agreeing with itself. `a64-dequant-formats` is the guard, and it carries a
;; row per format with `:emitted?` so a new format has to say `false` before it
;; can say anything.
;;
;; The tree is `a64-kernel-dot-f32`'s and therefore the x86 scalar arm's: four
;; accumulators, element e of each eight-element group into lane e mod 4, then
;; `(s0+s1)+(s2+s3)`. There is no tail -- a Q8_0 block is thirty-two elements,
;; four whole groups -- so the tail loop the f32 dot product needs is absent
;; here on both ISAs.
;;
;; The half-precision scale is decoded by the SAME EQUATION the x86 arm uses,
;; not by AArch64's own `FCVT S,H`. FCVT would be one instruction and would be
;; exact for every finite half -- and it would still be the wrong choice: the
;; two arms must agree on NaN payloads and on the inf/nan case, and the x86
;; equation has a hand-written arm for exponent 31 whose output is
;; `(significand << 13 & 0x007fffff) | 0x7f800000 | sign`. Reproducing the
;; equation reproduces that too; reproducing the intent would not.
;;
;; NO FMADD, for the reason `a64-kernel-dot-f32` states: `q*d` then `*a` then
;; `+=` is three roundings, and any fusion answers a different, better number.

nil

;; MUL Xd, Xn, Xm -- MADD with XZR as the addend. The block count is already
;; bounded by `block-limit` before either product is formed, so neither can
;; wrap; that check is the whole reason the limit is derived from BOTH strides.
(defn- a64-mul-rr [dst [:ref :form/r] left [:ref :form/r] right [:ref :form/r]] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or 0x9b007c00 (shl (a64-register right) 16)) (bit-or (shl (a64-register left) 5) (a64-register dst)))))

(defn- a64-and-rr [dst [:ref :form/r] left [:ref :form/r] right [:ref :form/r]] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or 0x8a000000 (shl (a64-register right) 16)) (bit-or (shl (a64-register left) 5) (a64-register dst)))))

(defn- a64-orr-rr [dst [:ref :form/r] left [:ref :form/r] right [:ref :form/r]] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or 0xaa000000 (shl (a64-register right) 16)) (bit-or (shl (a64-register left) 5) (a64-register dst)))))

;; LSL Xd, Xn, #k -- UBFM Xd, Xn, #(-k mod 64), #(63-k). The alias, spelled
;; out, because this file has no shift-by-immediate encoder and the aliasing
;; rule is the kind of thing that is easy to get one off.
(defn- a64-lsl-imm [dst [:ref :form/r] src [:ref :form/r] amount :i64] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or (bit-or 0xd3400000 (shl (fmod (- 64 amount) 64) 16)) (shl (- 63 amount) 10))
                    (bit-or (shl (a64-register src) 5) (a64-register dst)))))

(defn- a64-fmov-s-w [vd :i64 register [:ref :form/r]] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or 0x1e270000 (shl (a64-register register) 5)) vd)))

(defn- a64-fmov-w-s [register [:ref :form/r] vn :i64] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or 0x1e260000 (shl vn 5)) (a64-register register))))

(defn- a64-dequant-format [encoding :keyword] :vector-i64
     (case encoding
       :aarch64/kernel-dequant-dot-q8-0 (vector-conj (vector-conj (vector-conj (vector-alloc 0) 34) 32) 1)
       :aarch64/kernel-dequant-dot-q4-k (vector-conj (vector-conj (vector-conj (vector-alloc 0) 144) 256) 0)
       :aarch64/kernel-dequant-dot-q6-k (vector-conj (vector-conj (vector-conj (vector-alloc 0) 210) 256) 0)
       :aarch64/kernel-dequant-dot-iq4-xs (vector-conj (vector-conj (vector-conj (vector-alloc 0) 136) 256) 0)
       :aarch64/kernel-dequant-dot-iq2-s (vector-conj (vector-conj (vector-conj (vector-alloc 0) 82) 256) 0)
       :aarch64/kernel-dequant-dot-iq3-xxs (vector-conj (vector-conj (vector-conj (vector-alloc 0) 98) 256) 0)
       :aarch64/kernel-dequant-dot-iq3-s (vector-conj (vector-conj (vector-conj (vector-alloc 0) 110) 256) 0)
       :aarch64/kernel-dequant-dot-ptq1-0 (vector-conj (vector-conj (vector-conj (vector-alloc 0) 28) 128) 0)
       (vector-alloc 0)))

(defn- a64-dequant-fp16 [packed [:ref :form/r] disp :i64 sign [:ref :form/r] significand [:ref :form/r] work :i64 magic :i64
                            inf-nan [:ref :form/r] done [:ref :form/r]] [:list [:ref :form/r]]
     (let [x16 (kf :aarch64/x16) x17 (kf :aarch64/x17)]
       (lcat (lcat (cat4 (a64-ldrh-w x16 packed disp) (a64-constant x17 0x8000) (a64-and-rr sign x16 x17) (a64-lsl-imm sign sign 16))
                   (cat4 (a64-constant x17 0x7fff) (a64-and-rr significand x16 x17) (a64-lsl-imm significand significand 13)
                         (a64-constant x17 0x7c00)))
             (lcat (cat4 (a64-and-rr x16 x16 x17) (a64-cmp-rr x16 x17) (rb :aarch64/b-eq-imm19 inf-nan) (a64-fmov-s-w work significand))
                   (lcat (cat4 (a64-f32-rrr (a64-fmul-s) work work magic) (a64-fmov-w-s x16 work) (rb :aarch64/b-imm26 done) (lbl inf-nan))
                         (lcat (cat4 (a64-constant x17 0x007fffff) (a64-and-rr x16 significand x17) (a64-constant x17 0x7f800000) (a64-orr-rr x16 x16 x17))
                               (lcat (lbl done) (a64-orr-rr x16 x16 sign))))))))

(defn- dq-element [pw [:ref :form/r] px [:ref :form/r] work :i64 e :i64] [:list [:ref :form/r]]
     (lcat (cat3 (a64-ldrsb-x (kf :aarch64/x16) pw e) (a64-scvtf-s-x 4 (kf :aarch64/x16)) (a64-f32-rrr (a64-fmul-s) 4 4 work))
           (cat3 (a64-f32-load 5 px (* 4 e)) (a64-f32-rrr (a64-fmul-s) 4 4 5) (a64-f32-rrr (a64-fadd-s) (rem e 4) (rem e 4) 4))))

(defn- dq-elements [pw [:ref :form/r] px [:ref :form/r] work :i64] [:list [:ref :form/r]]
     (loop [e 0 acc (lnone)] (if (>= e 8) acc (recur (inc e) (lcat acc (dq-element pw px work e))))))

(defn- dq-label [instruction-index :i64 encoding :keyword suffix :string] [:ref :form/r]
     (memory-label instruction-index (string-concat "a64-dq-" (string-concat (keyword-name encoding) (string-concat "-" suffix)))))

(defn- a64-kernel-dequant-dot [encoding :keyword instruction-index :i64 instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [fmt (a64-dequant-format encoding)]
       (if (not (and (= 3 (vector-count fmt)) (= 1 (vector-at fmt 2))))
         (reject-list! :mc-encode :dequant-format-not-emitted instruction)
         (let [block-bytes (vector-at fmt 0) block-elements (vector-at fmt 1)
               dst (fget instruction :mir/dst) base (fget instruction :mir/base) length (fget instruction :mir/length)
               second-base (fget instruction :mir/second-base) second-length (fget instruction :mir/second-length)
               maximum (fint instruction :mir/maximum) blocks (fget instruction :mir/count)
               block-limit (min (quot maximum block-bytes) (quot maximum (* 4 block-elements)))
               element-span (* 4 block-elements)
               groups (quot block-elements 8)
               trap (dq-label instruction-index encoding "trap") done (dq-label instruction-index encoding "done")
               pw base px second-base remaining blocks group length sign second-length
               work 6 magic 7
               x16 (kf :aarch64/x16)
               frame (a64-saved-frame (distinct-forms (lconj (lconj (form/three-forms base length second-base) second-length) blocks)) (nf))
               checks (lcat (lcat (cat4 (a64-constant x16 maximum) (a64-cmp-rr length x16) (rb :aarch64/b-hi-imm19 trap) (a64-cmp-rr second-length x16))
                                  (cat4 (rb :aarch64/b-hi-imm19 trap) (rbo :aarch64/cbz-imm19 trap (a64-register base))
                                        (rbo :aarch64/cbz-imm19 trap (a64-register second-base)) (a64-constant x16 block-limit)))
                            (lcat (cat4 (a64-cmp-rr blocks x16) (rb :aarch64/b-hi-imm19 trap) (a64-constant x16 block-bytes) (a64-mul-rr x16 blocks x16))
                                  (lcat (cat4 (a64-cmp-rr x16 length) (rb :aarch64/b-hi-imm19 trap) (a64-constant x16 element-span) (a64-mul-rr x16 blocks x16))
                                        (lcat (a64-cmp-rr x16 second-length) (rb :aarch64/b-hi-imm19 trap)))))
               group-body (cat4 (dq-elements pw px work) (a64-add-imm pw pw 8) (a64-add-imm px px 32) (a64-sub-imm group group 1))
               block-body (lcat (cat4 (a64-dequant-fp16 pw 0 sign group work magic (dq-label instruction-index encoding "fp16-inf") (dq-label instruction-index encoding "fp16-done"))
                                      (a64-fmov-s-w work x16) (a64-add-imm pw pw 2) (a64-constant group groups))
                                (lcat (counted-loop (dq-label instruction-index encoding "group") (dq-label instruction-index encoding "group-check") group 1 group-body)
                                      (a64-sub-imm remaining remaining 1)))]
           (lcat (lcat (cat4 checks (kids (fget frame :save))
                             (cat4 (a64-f32-zero 0) (a64-f32-zero 1) (a64-f32-zero 2) (a64-f32-zero 3))
                             (lcat (a64-constant x16 (x86-dequant-magic)) (a64-fmov-s-w magic x16)))
                       (cat4 (counted-loop (dq-label instruction-index encoding "block") (dq-label instruction-index encoding "block-check") remaining 1 block-body)
                             (a64-f32-rrr (a64-fadd-s) 0 0 1) (a64-f32-rrr (a64-fadd-s) 2 2 3) (a64-f32-rrr (a64-fadd-s) 0 0 2)))
                 (cat4 (kids (fget frame :restore)) (a64-fmov-w-s dst 0) (a64-sxtw dst) (trap-tail done trap)))))))
;; dequant: end

(defn- a64-kernel-bounds-check [trap [:ref :form/r] width :i64 aligned? :bool instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [base (fget instruction :mir/base) length (fget instruction :mir/length) index (fget instruction :mir/index)]
       (lcat (cat4 (a64-constant (kf :aarch64/x16) (fint instruction :mir/maximum))
                   (u32le (bit-or (bit-or 0xeb00001f (shl 16 16)) (shl (a64-register length) 5)))
                   (lcat (rb :aarch64/b-hi-imm19 trap) (rbo :aarch64/cbz-imm19 trap (a64-register base)))
                   (lcat (u32le (bit-or (bit-or 0xeb00001f (shl (a64-register length) 16)) (shl (a64-register index) 5)))
                         (rb :aarch64/b-hs-imm19 trap)))
             (cat3 (if (> width 8)
                     (cat3 (u32le (bit-or (bit-or 0xcb000000 (shl (a64-register index) 16)) (bit-or (shl (a64-register length) 5) 16)))
                           (u32le (bit-or (bit-or 0xf100001f (shl (quot width 8) 10)) (shl 16 5)))
                           (rb :aarch64/b-lt-imm19 trap))
                     (lnone))
                   (if aligned? (a64-alignment-check trap (quot width 8) index) (lnone))
                   (u32le (bit-or (bit-or 0x8b000000 (shl (a64-register index) 16)) (bit-or (shl (a64-register base) 5) 16)))))))

(defn- a64-slice-bounds-check [trap [:ref :form/r] bytes :i64 instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [base (fget instruction :mir/base) length (fget instruction :mir/length) index (fget instruction :mir/index)
           lsl (cond (= bytes 1) 0 (= bytes 2) 1 (= bytes 4) 2 :else 3)]
       (lcat (cat4 (a64-constant (kf :aarch64/x16) (fint instruction :mir/maximum))
                   (u32le (bit-or (bit-or 0xeb00001f (shl 16 16)) (shl (a64-register length) 5)))
                   (lcat (rb :aarch64/b-hi-imm19 trap) (rbo :aarch64/cbz-imm19 trap (a64-register base)))
                   (a64-alignment-check trap bytes base))
             (cat3 (u32le (bit-or (bit-or 0xeb00001f (shl (a64-register length) 16)) (shl (a64-register index) 5)))
                   (rb :aarch64/b-hs-imm19 trap)
                   (u32le (bit-or (bit-or 0x8b000000 (shl (a64-register index) 16))
                                  (bit-or (shl lsl 10) (bit-or (shl (a64-register base) 5) 16))))))))

(defn- a64-kernel-lock [instruction-index :i64 expected :i64 desired :i64 instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [trap (memory-label instruction-index "lock-trap")
           retry (memory-label instruction-index "lock-retry")
           fail (memory-label instruction-index "lock-fail")
           done (memory-label instruction-index "lock-done")
           dst (fget instruction :mir/dst)]
       (lcat (lcat (cat4 (a64-kernel-bounds-check trap 32 false instruction)
                         (lbl retry)
                         (u32le 0x885ffe11)
                         (u32le (bit-or (bit-or 0xf100001f (shl expected 10)) (shl 17 5))))
                   (cat4 (rb :aarch64/b-ne-imm19 fail)
                         (a64-constant dst desired)
                         (u32le (bit-or 0x8811fe00 (a64-register dst)))
                         (u32le (bit-or 0xf100001f (shl 17 5)))))
             (lcat (cat4 (rb :aarch64/b-ne-imm19 retry)
                         (a64-constant dst 1)
                         (rb :aarch64/b-imm26 done)
                         (lbl fail))
                   (cat3 (u32le 0xd5033f5f)
                         (a64-constant dst 0)
                         (trap-tail done trap))))))

(defn- a64-memory-access [store? :bool width :i64 result [:ref :form/r]] [:list [:ref :form/r]]
     (let [op (cond (and (not store?) (= width 8)) 0x39400000 (and (not store?) (= width 16)) 0x79400000
                    (and (not store?) (= width 32)) 0xb9400000 (not store?) 0xf9400000
                    (= width 8) 0x39000000 (= width 16) 0x79000000 (= width 32) 0xb9000000 :else 0xf9000000)]
       (u32le (bit-or (bit-or op (shl 16 5)) (a64-register result)))))
;; sysops: the AArch64 general atomics, as single LSE instructions.
;;
;; `a64-kernel-lock` above is an LDAXR/STLXR pair, and it says why: there is no
;; CAS below ARMv8.1-LSE. That pair cannot be generalised here, and the reason
;; is register count rather than taste. A general atomic needs the address, the
;; loaded word, the word to store and the store status all live at once, and
;; this encoder has exactly two scratch registers -- x16 and x17 -- because
;; every other register may be holding an allocated value. The lock gets away
;; with three because its replacement is an immediate it can build in `dst`.
;;
;; LSE turns each of them into ONE instruction with no loop, no status register
;; and no monitor to clear:
;;
;;   ldaddal w3, w17, [x16]   0xb8e30211      ldaddal x3, x17, [x16]  0xf8e30211
;;   swpal   w3, w17, [x16]   0xb8e38211      swpal   x3, x17, [x16]  0xf8e38211
;;   casal   w17, w3, [x16]   0x88f1fe03      casal   x17, x3, [x16]  0xc8f1fe03
;;
;; taken from the system assembler at `-march=armv8.1-a`, with Rs at bits
;; 20-16, Rn at 9-5 and Rt at 4-0.
;;
;; THE COST, STATED PLAINLY: this raises the AArch64 baseline for a module that
;; uses these six operations to ARMv8.1-A. FEAT_LSE is architecturally
;; mandatory from ARMv8.1 (2014) and present on every Apple Silicon part, and
;; nothing else in this backend needs it -- a module that uses none of these
;; six is unchanged. The alternative is not "the same thing without LSE": it is
;; a third scratch register taken out of the allocator's pool for every AArch64
;; program, to serve six operations.
;;
;; `x17` carries the old word out of all three, and the answer is moved from it
;; into `dst` afterwards rather than being written there directly, because
;; `dst` may alias an operand this instruction has not finished reading.
;; The 32-bit forms write w17, which zero-extends x17 -- the same zero-extended
;; old word the KIR oracle answers with.
(defn- a64-kernel-atomic [instruction-index :i64 kind :keyword width :i64 instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [trap (memory-label instruction-index "atomic-trap")
           done (memory-label instruction-index "atomic-done")
           wide? (= 64 width)
           dst (fget instruction :mir/dst) stored (fget instruction :mir/stored) expected (fget instruction :mir/expected)
           body (cond
                  (= kind :add) (u32le (bit-or (bit-or (if wide? 0xf8e00000 0xb8e00000) (shl (a64-register stored) 16)) (bit-or (shl 16 5) 17)))
                  (= kind :xchg) (u32le (bit-or (bit-or (if wide? 0xf8e08000 0xb8e08000) (shl (a64-register stored) 16)) (bit-or (shl 16 5) 17)))
                  :else (lcat (u32le (bit-or (bit-or (if wide? 0xaa0003e0 0x2a0003e0) (shl (a64-register expected) 16)) 17))
                              (u32le (bit-or (bit-or (if wide? 0xc8e0fc00 0x88e0fc00) (shl 17 16)) (bit-or (shl 16 5) (a64-register stored))))))]
       (cat4 (a64-kernel-bounds-check trap width false instruction)
             body
             (u32le (bit-or (bit-or 0xaa0003e0 (shl 17 16)) (a64-register dst)))
             (trap-tail done trap))))
;; sysops: end

(defn- a64-store-answer [dst [:ref :form/r] stored [:ref :form/r]] [:list [:ref :form/r]]
     (if (feq dst stored) (lnone) (a64-mov dst stored)))

(defn- a64-kernel-memory [instruction-index :i64 width :i64 store? :bool aligned? :bool instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [trap (memory-label instruction-index "trap")
           done (memory-label instruction-index "done")
           dst (fget instruction :mir/dst) stored (fget instruction :mir/stored)]
       (cat4 (a64-kernel-bounds-check trap width aligned? instruction)
             (a64-memory-access store? width (if store? stored dst))
             (if store? (a64-store-answer dst stored) (lnone))
             (trap-tail done trap))))

(defn- a64-slice-memory [instruction-index :i64 width :i64 store? :bool instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [trap (memory-label instruction-index "slice-trap")
           done (memory-label instruction-index "slice-done")
           dst (fget instruction :mir/dst) stored (fget instruction :mir/stored)]
       (cat4 (a64-slice-bounds-check trap (quot width 8) instruction)
             (a64-memory-access store? width (if store? stored dst))
             (if store? (a64-store-answer dst stored) (lnone))
             (trap-tail done trap))))

(defn- a64-kernel-subregion [instruction-index :i64 instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [trap (memory-label instruction-index "subregion-trap")
           done (memory-label instruction-index "subregion-done")
           base (fget instruction :mir/base) length (fget instruction :mir/length)
           offset (fget instruction :mir/offset) size (fget instruction :mir/size)]
       (lcat (cat4 (rbo :aarch64/cbz-imm19 trap (a64-register base))
                   (u32le (bit-or (bit-or 0xeb00001f (shl (a64-register length) 16)) (shl (a64-register offset) 5)))
                   (rb :aarch64/b-hi-imm19 trap)
                   (u32le (bit-or (bit-or 0xcb000000 (shl (a64-register offset) 16)) (bit-or (shl (a64-register length) 5) 16))))
             (cat4 (u32le (bit-or (bit-or 0xeb00001f (shl 16 16)) (shl (a64-register size) 5)))
                   (rb :aarch64/b-hi-imm19 trap)
                   (u32le (bit-or (bit-or 0x8b000000 (shl (a64-register offset) 16)) (bit-or (shl (a64-register base) 5) (a64-register (fget instruction :mir/dst)))))
                   (trap-tail done trap)))))

(defn- a64-quotient [dst [:ref :form/r] left [:ref :form/r] right [:ref :form/r]] [:list [:ref :form/r]]
     (let [x16 (kf :aarch64/x16)]
       (lcat (cat4 (u32le (bit-or 0xb4000000 (bit-or (shl 15 5) (a64-register right))))
                   (a64-constant-fixed x16 (- -9223372036854775807 1))
                   (u32le (bit-or 0xeb00001f (bit-or (shl 16 16) (shl (a64-register left) 5))))
                   (u32le (bit-or 0x54000001 (shl 7 5))))
             (cat4 (a64-constant-fixed x16 -1)
                   (u32le (bit-or 0xeb00001f (bit-or (shl 16 16) (shl (a64-register right) 5))))
                   (u32le (bit-or 0x54000000 (shl 3 5)))
                   (cat3 (u32le (bit-or (bit-or 0x9ac00c00 (shl (a64-register right) 16)) (bit-or (shl (a64-register left) 5) (a64-register dst))))
                         (u32le (bit-or 0x14000000 2))
                         (u32le 0xd4200000))))))

(defn- a64-quotient-constant [dst [:ref :form/r] left [:ref :form/r] divisor :i64 load-multiplier? :bool] [:list [:ref :form/r]]
     (let [magic (signed-division-magic divisor)]
       (if (= 0 (vector-count magic))
         (lcat (a64-constant (kf :aarch64/x17) divisor) (a64-quotient dst left (kf :aarch64/x17)))
         (let [multiplier (vector-at magic 0) shift (vector-at magic 1)
               l (a64-register left) d (a64-register dst)]
           (cat4 (if load-multiplier? (a64-constant (kf :aarch64/x16) multiplier) (lnone))
                 (u32le (bit-or (bit-or 0x9b407c00 (shl 16 16)) (bit-or (shl l 5) 17)))
                 (lcat (if (= 1 (vector-at magic 2)) (u32le (bit-or (bit-or 0x8b000000 (shl l 16)) (bit-or (shl 17 5) 17))) (lnone))
                       (if (= 1 (vector-at magic 3)) (u32le (bit-or (bit-or 0xcb000000 (shl l 16)) (bit-or (shl 17 5) 17))) (lnone)))
                 (if (> shift 0)
                   (lcat (u32le (bit-or (bit-or 0x9340fc00 (shl shift 16)) (bit-or (shl 17 5) d)))
                         (u32le (bit-or (bit-or 0x8b400000 (shl 17 16)) (bit-or (shl 63 10) (bit-or (shl d 5) d)))))
                   (u32le (bit-or (bit-or 0x8b400000 (shl 17 16)) (bit-or (shl 63 10) (bit-or (shl 17 5) d))))))))))

;; --- inline handle operations (context ABI v9, ADR 0084) --------------------
;;
;; Five runtime operations are emitted IN LINE rather than as a call through
;; the context table: `pair-first`, `pair-second` (which `string-byte-length`
;; shares, slot 72), `vector-count`, `vector-at` and `vector-assoc!`
;; (`vector-assoc-in-place`). Each is a handle-range check, a table read and
;; one load or store -- the whole of what the loader's `checked_*` twin does,
;; minus the C call around it. Everything else stays a call: a search or a
;; comparison is a loop, and the loader's is libc's.
;;
;; The check is the same one, emitted: `(uint64)(handle - 1) < *used` (a
;; handle of 0 wraps to the largest value and fails like any other out of
;; range), then for a vector `(uint64)index < length`, and the failure is
;; `udf` / `ud2` -- SIGILL, the signal `raise(SIGILL)` in the C twin sends,
;; so a supervisor cannot tell an inline refusal from a host one. What the
;; inline path READS -- the used counters, the pair and vector tables, the
;; item arena -- it reaches through six POINTERS the loader writes into the
;; context at start (ABI v9, offsets 288-328) and nothing writes afterwards:
;; guest code has no store but the kernel window family, which the frontend
;; admits separately, so the pointers and the tables are as trustworthy in
;; line as they are behind a call. The registers are the runtime-call
;; profile's own -- arguments in x1..x3 / rsi..rcx, the answer in x0 / rax,
;; which the call would have clobbered -- plus the encoder scratch pair
;; x16/x17 / r10/r11 that no allocated value ever occupies.
;;
;; Measured 2026-09-16 on org-ieee-sort's index merge sort over 33 MB
;; (769,400 lines, ~15 M comparisons, two `vector-at` and one
;; `vector-assoc!` each): see ADR 0084 and the conformance in amu.
nil

nil

(defn- a64-ldr-x16-context [offset :i64] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or 0xf9400000 (shl (quot offset 8) 10)) (bit-or (shl 7 5) 16))))

(defn- a64-inline-handle [trap [:ref :form/r] used-offset :i64 base-offset :i64] [:list [:ref :form/r]]
     (lcat (cat4 (a64-ldr-x16-context used-offset) (u32le 0xf9400210) (u32le 0xd1000431) (u32le 0xeb10023f))
           (cat3 (lone (layout-relative-branch :aarch64/b-hs-imm19 trap))
                 (a64-ldr-x16-context base-offset)
                 (u32le 0x8b111210))))                                 ; add x16, x16, x17, lsl #4

(defn- inline-runtime-op? [runtime :keyword] :bool
     (or (= runtime :pair-first) (= runtime :pair-second) (= runtime :string-byte-length)
         (= runtime :vector-count) (= runtime :vector-at) (= runtime :vector-assoc-in-place)
         (= runtime :fuel-charge) (= runtime :gas-charge)))

nil

(defn- a64-fuel-charge [instruction-index :i64] [:list [:ref :form/r]]
     (let [present (memory-label instruction-index "fuel-present")]
       (lcat (cat4 (u32le 0xf94004f0)
                   (u32le 0xf1000610)
                   (lone (layout-relative-branch :aarch64/b-hs-imm19 present))
                   (u32le 0xd4200000))
             (lcat (lone (layout-label present)) (u32le 0xf90004f0)))))

(defn- a64-gas-charge [instruction-index :i64] [:list [:ref :form/r]]
     (let [present (memory-label instruction-index "gas-present")
           trap (memory-label instruction-index "gas-trap")
           store (u32le (bit-or (bit-or 0xf9000000 (shl (quot 384 8) 10)) (bit-or (shl 7 5) 16)))]
       (lcat (cat4 (u32le 0xf94000f0)
                   (u32le 0xf100321f)
                   (lone (layout-relative-branch :aarch64/b-ne-imm19 trap))
                   (a64-ldr-x16-context 384))
             (lcat (cat4 (u32le 0xeb010210)
                         (lone (layout-relative-branch :aarch64/b-hs-imm19 present))
                         (u32le 0x92800010)
                         store)
                   (cat4 (lone (layout-label trap))
                         (u32le 0xd4200000)
                         (lone (layout-label present))
                         store)))))

(defn- a64-inline-runtime [instruction-index :i64 runtime :keyword] [:list [:ref :form/r]]
     (cond
       (= runtime :fuel-charge) (a64-fuel-charge instruction-index)
       (= runtime :gas-charge) (a64-gas-charge instruction-index)
       :else (a64-inline-handle-runtime instruction-index runtime)))

(defn- a64-inline-handle-runtime [instruction-index :i64 runtime :keyword] [:list [:ref :form/r]]
     (let [trap (memory-label instruction-index "handle-trap")
           done (memory-label instruction-index "handle-done")
           body (cond
                  (= runtime :pair-first) (lcat (a64-inline-handle trap 288 296) (u32le 0xf9400200))
                  (or (= runtime :pair-second) (= runtime :string-byte-length))
                  (lcat (a64-inline-handle trap 288 296) (u32le 0xf9400600))
                  (= runtime :vector-count) (lcat (a64-inline-handle trap 312 320) (u32le 0xf9400600))
                  :else
                  (lcat (cat4 (a64-inline-handle trap 312 320)
                              (u32le 0xa9404211)
                              (u32le 0xeb10005f)
                              (lone (layout-relative-branch :aarch64/b-hs-imm19 trap)))
                        (cat3 (a64-ldr-x16-context 328)
                              (u32le 0x8b020231)
                              (if (= runtime :vector-at)
                                (u32le 0xf8717a00)
                                (lcat (u32le 0xf8317a03) (a64-mov (kf :aarch64/x0) (kf :aarch64/x1)))))))]
       (cat4 body
             (form/two-forms (layout-relative-branch :aarch64/b-imm26 done) (layout-label trap))
             ;; udf #<code>: vector ops trap 12 (vector/index-out-of-range),
             ;; pair ops keep 0 -- the host's `trap-code`
             (u32le (if (or (= runtime :vector-at) (= runtime :vector-assoc-in-place)) 12 0))
             (lone (layout-label done)))))

nil

nil                                   ; add r10, r11

nil

nil

nil

nil

nil

nil

(defn- a64-runtime-call [instruction-index :i64 instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [context-offset (fint instruction :mir/context-offset)
           runtime (fkw instruction :mir/runtime)]
       (cond
         (or (< context-offset 0) (not (= 0 (fmod context-offset 8))) (> (quot context-offset 8) 4095))
         (reject-list! :mc-encode :invalid-runtime-context-offset instruction)
         (inline-runtime-op? runtime) (a64-inline-runtime instruction-index runtime)
         :else
         (let [x7 (kf :aarch64/x7)]
           (lcat (cat4 (a64-adjust-stack 0xd10003ff 16)
                       (a64-stack-memory 0xf9000000 x7 0)
                       (a64-mov (kf :aarch64/x0) x7)
                       (u32le (bit-or (bit-or 0xf9400000 (shl (quot context-offset 8) 10)) (bit-or (shl 7 5) 16))))
                 (cat3 (u32le 0xd63f0200)
                       (a64-stack-memory 0xf9400000 x7 0)
                       (a64-adjust-stack 0x910003ff 16)))))))

nil

(defn- a64-capability-call [instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [capability (fint instruction :mir/capability)
           kind-code-f (form/form-get (gmir/capability-kinds) (fget instruction :mir/kind))
           context-offset (fint instruction :mir/context-offset)]
       (if (not (and (form/is-int? kind-code-f) (<= 0 capability) (<= capability 255)))
         (reject-list! :mc-encode :invalid-capability-call instruction)
         (let [kind-code (form/int-value kind-code-f)
               word-offset (+ 16 (* 8 (quot capability 64)))
               bit-index (rem capability 64)
               x7 (kf :aarch64/x7)]
           (lcat (cat4 (u32le (bit-or (bit-or 0xf9400000 (shl (quot word-offset 8) 10)) (bit-or (shl 7 5) 16)))
                       (u32le (bit-or (bit-or 0x37000000 (shl (bit-and bit-index 32) 26))
                                      (bit-or (shl (bit-and bit-index 31) 19) (bit-or (shl 2 5) 16))))
                       (u32le 0xd4200000)
                       (a64-adjust-stack 0xd10003ff 16))
                 (lcat (cat4 (a64-stack-memory 0xf9000000 x7 0)
                             (a64-constant (kf :aarch64/x1) capability)
                             (if (> kind-code 0)
                               (lcat (a64-constant (kf :aarch64/x2) kind-code) (a64-constant (kf :aarch64/x3) kind-code))
                               (lnone))
                             (a64-mov (kf :aarch64/x0) x7))
                       (cat4 (u32le (bit-or (bit-or 0xf9400000 (shl (quot context-offset 8) 10)) (bit-or (shl 7 5) 16)))
                             (u32le 0xd63f0200)
                             (a64-stack-memory 0xf9400000 x7 0)
                             (a64-adjust-stack 0x910003ff 16))))))))

nil

nil

nil

nil

nil

;; amu-h7: the canned #UD handler. Same shape as the three above; the bytes
;; are `kotoba.native.interrupt-abi`'s and are the ones the image lays in the
;; vector-6 entry slot, so a kernel that lays no region installs the same
;; handler a kernel with a region reaches through `(kernel-isr-entry-address 6)`.
nil

nil

;; boot: one Microsoft x64 call out of a Kotoba guest, and back.
;;
;; Three things have to be true at the `call` and none of them is true on
;; arrival. RSP must be 16-byte aligned; the callee owns 32 bytes of shadow
;; space above it; and every volatile register must be a value the guest can
;; afford to lose. The guest's own frame is `sub rsp, frame-bytes` from an
;; alignment this encoder cannot know statically, so the alignment is done at
;; run time rather than assumed.
;;
;; The register discipline is the part worth reading twice. MS x64 preserves
;; RBX, RBP, RDI, RSI and R12-R15, which is the whole of `kotoba.mir`'s leaf
;; and preserved tiers -- those survive by contract. What does NOT survive is
;; the four-register scratch tier (RAX, RCX, RDX, R8) and R9, which carries
;; the guest's hidden context. All five are saved here rather than at the MIR
;; layer, because `:mir/x86-privileged` is not a `call-operation?`: the
;; scanner does not treat it as a barrier and may hold a live value in the
;; scratch tier across it.
;;
;; The argument order (R10 <- a, RDX <- b, RCX <- R10) is not cosmetic. `a`
;; and `b` arrive in allocator registers that may BE RCX or RDX, so writing
;; RCX first would destroy `b` whenever `b` lives there. Staging `a` through
;; R10 -- outside the pool -- makes every assignment safe.
nil

;; boot-lit: the same call, four or six UEFI arguments wide.
;;
;; `x86-uefi-call2` above stages `a` through R10 so that writing RCX cannot
;; destroy `b`. With four or six arguments that trick does not scale -- there
;; is one R10 -- so the ordering problem is solved once, structurally: EVERY
;; argument is written to the outgoing frame BEFORE any argument register is
;; loaded. Reads all happen while the sources are still intact; writes all
;; happen afterwards.
;;
;; The staging area for arguments 1-4 is the callee's own shadow space, which
;; is exactly what shadow space is for: `[rsp+0x00..0x18]` are the home
;; locations of RCX, RDX, R8 and R9. Arguments 5 and 6 are written to
;; `[rsp+0x20]` and `[rsp+0x28]`, where Microsoft x64 says they go, and stay
;; there.
;;
;;   +0x00..0x18  shadow space / staging for arguments 1-4
;;   +0x20        argument 5      +0x28  argument 6
;;   +0x30        original RSP
;;   +0x38..0x58  RAX, RCX, RDX, R8, R9
;;
;; 0x60 is a multiple of 16, so RSP is still 16-aligned at the `call` after
;; `and rsp,-16`. R11 holds the target across the whole sequence: nothing
;; between the load and the `call` writes it.
;;
;; A four-argument call still allocates the six-argument frame and simply does
;; not write +0x20/+0x28. Sizing the frame by the argument count would save
;; sixteen bytes of stack and add a second frame layout to verify.
nil


;; fwstore: `AllocatePages`, with the out-pointer inside this frame.
;;
;; The whole reason this is an encoder and not a call site is the out-word.
;; `AllocatePages(AllocateType, MemoryType, Pages, OUT Memory)` writes the base
;; through its fourth argument, and if the program supplied that pointer the
;; program could supply a pointer to a word it wrote itself -- so "the address
;; the firmware returned" would be an address the program chose, and the
;; region-provenance root kotoba-sema grants would be worth nothing. Here the
;; word is at `[rsp+0x20]` in a frame nothing else can name.
;;
;; It is `x86-uefi-call-wide`'s frame with one slot repurposed:
;;
;;   +0x00..0x18  shadow space / staging for arguments 1-4
;;   +0x20        THE OUT WORD, and the address passed as argument 4
;;   +0x28        original RSP
;;   +0x30..0x50  RAX, RCX, RDX, R8, R9
;;
;; 0x60 is a multiple of 16, so RSP is still 16-aligned at the `call` after
;; `and rsp,-16`. `+0x20` is the fifth-argument slot of the Microsoft x64
;; frame: a four-parameter callee owns `[rsp..rsp+0x18]` and never writes
;; above it, so the word survives the call it is an argument to.
;;
;; The out word is PRE-LOADED with `address-hint` before the call, which is
;; what makes `AllocateMaxAddress` and `AllocateAddress` expressible -- for
;; those two the parameter is IN OUT. `AllocateAnyPages` ignores what is there.
;;
;; And the answer is zeroed on failure, branchlessly:
;;
;;   mov r10,[rsp+0x20]   the word the firmware wrote
;;   xor r11,r11          (this sets flags, so it comes BEFORE the test)
;;   test rax,rax         EFI_STATUS, still in RAX from the call
;;   cmovne r10,r11       status != 0 -> 0
;;
;; Zero rather than a status because Kotoba has no multi-value return on a
;; firmware target, and because a null base is the one answer every bounded
;; memory operation already refuses -- so a caller that forgets to test it
;; traps at its first access rather than writing wherever the out-word
;; happened to point. Every byte here was checked against `llvm-mc -triple
;; x86_64 -show-encoding`.
nil

nil

(defn- a64-rrr [base :i64 instruction [:ref :form/r]] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or base (shl (a64-register (fget instruction :mir/right)) 16))
                    (bit-or (shl (a64-register (fget instruction :mir/left)) 5) (a64-register (fget instruction :mir/dst))))))

(defn- a64-add-sub [encoding :keyword instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [immediate (fget instruction :native/a64-immediate)
           add? (= encoding :aarch64/add)]
       (if (truthy? immediate)
         (let [iop (fkw instruction :native/a64-immediate-op)
               sub-form? (if add? (= iop :subtract) (not (= iop :add)))]
           (u32le (bit-or (bit-or (if sub-form? 0xd1000000 0x91000000) (shl (fint instruction :native/a64-immediate-shift) 22))
                          (bit-or (bit-or (shl (form/int-value immediate) 10) (shl (a64-register (fget instruction :mir/left)) 5))
                                  (a64-register (fget instruction :mir/dst))))))
         (a64-rrr (if add? 0x8b000000 0xcb000000) instruction))))

(defn- a64-multiply-accumulate [encoding :keyword instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [shift (fget instruction :native/a64-mersenne-shift)]
       (if (truthy? shift)
         (let [factor (a64-register (fget instruction :native/a64-mersenne-factor))
               addend (a64-register (fget instruction :mir/addend))
               dst (a64-register (fget instruction :mir/dst))]
           (lcat (u32le (bit-or (bit-or 0xcb000000 (shl factor 16)) (bit-or (shl (form/int-value shift) 10) (bit-or (shl factor 5) 17))))
                 (u32le (bit-or (bit-or 0x8b000000 (shl 17 16)) (bit-or (shl addend 5) dst)))))
         (u32le (bit-or (bit-or (if (= encoding :aarch64/multiply-add) 0x9b000000 0x9b008000)
                                (shl (a64-register (fget instruction :mir/right)) 16))
                        (bit-or (bit-or (shl (a64-register (fget instruction :mir/addend)) 10)
                                        (shl (a64-register (fget instruction :mir/left)) 5))
                                (a64-register (fget instruction :mir/dst))))))))

(defn- a64-three-register-base [encoding :keyword] :i64
     (case encoding
       :aarch64/multiply 0x9b007c00
       :aarch64/bit-and 0x8a000000
       :aarch64/bit-or 0xaa000000
       :aarch64/bit-xor 0xca000000
       :aarch64/shift-left 0x9ac02000
       :aarch64/shift-right-signed 0x9ac02800
       :aarch64/shift-right-unsigned 0x9ac02400
       -1))

(defn- a64-f64-binary-base [encoding :keyword] :i64
     (case encoding
       :aarch64/f64-add 0x1e612800 :aarch64/f64-subtract 0x1e613800 :aarch64/f64-multiply 0x1e610800
       :aarch64/f64-divide 0x1e611800 :aarch64/f64-min 0x1e615800 :aarch64/f64-max 0x1e614800
       -1))

(defn- a64-float-cset [encoding :keyword] :i64
     (case encoding
       (:aarch64/f64-equal :aarch64/f32-equal) 0x9a9f17e0
       (:aarch64/f64-less-than :aarch64/f32-less-than) 0x9a9f57e0
       (:aarch64/f64-less-or-equal :aarch64/f32-less-or-equal) 0x9a9f87e0
       (:aarch64/f64-greater-than :aarch64/f32-greater-than) 0x9a9fd7e0
       (:aarch64/f64-greater-or-equal :aarch64/f32-greater-or-equal) 0x9a9fb7e0
       (:aarch64/f64-unordered :aarch64/f32-unordered) 0x9a9f77e0
       -1))

(defn- a64-f32-binary-base [encoding :keyword] :i64
     (case encoding
       :aarch64/f32-add 0x1e212800 :aarch64/f32-subtract 0x1e213800
       :aarch64/f32-multiply 0x1e210800 :aarch64/f32-divide 0x1e211800
       -1))

(defn- a64-int-cset [encoding :keyword] :i64
     (case encoding
       :aarch64/equal 0x9a9f17e0 :aarch64/less-than 0x9a9fa7e0 :aarch64/greater-than 0x9a9fd7e0
       :aarch64/less-or-equal 0x9a9fc7e0 :aarch64/greater-or-equal 0x9a9fb7e0
       -1))

(defn- a64-family [encoding :keyword] :keyword
     (let [n (keyword-name encoding)]
       (cond (and (>= (string-byte-length n) 12) (string=? (string-substring n 0 12) "kernel-load-")) :kernel-memory
             (and (>= (string-byte-length n) 13) (string=? (string-substring n 0 13) "kernel-store-")) :kernel-memory
             (and (>= (string-byte-length n) 6) (string=? (string-substring n 0 6) "slice-")) :slice-memory
             :else :none)))

(defn- encode-selected-a64 [isa :keyword frame-bytes :i64 return-suffix [:list [:ref :form/r]] instruction-index :i64
                               load-a64-multiplier? :bool instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [encoding (fkw instruction :mc/encoding)
           dst (fget instruction :mir/dst)]
       (cond
         (= encoding :aarch64/argument)
         (let [index (fint instruction :mir/index)]
           (if (not (and (<= 0 index) (<= index 4)))
             (reject-list! :mc-encode :argument-index-unsupported instruction)
             (let [src (kf (keyword-from-string (string-concat "aarch64/x" (string-from-i64 index))))]
               (if (feq dst src) (lnone) (a64-mov dst src)))))
         (= encoding :aarch64/constant) (a64-constant dst (fint instruction :mir/value))
         (= encoding :aarch64/data-address)
         (lone (map3 :native/data-content (fget instruction :mir/content) :native/data-dst dst :native/data-target (kf :aarch64)))
         (= encoding :aarch64/rodata-address)
         (lone (map4 :native/rodata-content (fget instruction :mir/content) :native/rodata-encoding (fget instruction :mir/rodata-encoding)
                     :native/rodata-dst dst :native/rodata-target (kf :aarch64)))
         (or (= encoding :aarch64/add) (= encoding :aarch64/subtract)) (a64-add-sub encoding instruction)
         (or (= encoding :aarch64/multiply-add) (= encoding :aarch64/multiply-subtract)) (a64-multiply-accumulate encoding instruction)
         (>= (a64-three-register-base encoding) 0) (a64-rrr (a64-three-register-base encoding) instruction)
         (= encoding :aarch64/quotient) (a64-quotient dst (fget instruction :mir/left) (fget instruction :mir/right))
         (= encoding :aarch64/quotient-constant)
         (a64-quotient-constant dst (fget instruction :mir/left) (fint instruction :mir/divisor) load-a64-multiplier?)
         (>= (a64-f64-binary-base encoding) 0)
         (a64-f64-binary (a64-f64-binary-base encoding) dst (fget instruction :mir/left) (fget instruction :mir/right))
         (= encoding :aarch64/f64-sqrt)
         (cat3 (u32le (bit-or 0x9e670000 (shl (a64-register (fget instruction :mir/input)) 5)))
               (u32le 0x1e61c000)
               (u32le (bit-or 0x9e660000 (a64-register dst))))
         (and (>= (a64-float-cset encoding) 0) (string=? (string-substring (keyword-name encoding) 0 3) "f64"))
         (a64-f64-compare (a64-float-cset encoding) dst (fget instruction :mir/left) (fget instruction :mir/right))
         (>= (a64-f32-binary-base encoding) 0)
         (a64-f32-binary (a64-f32-binary-base encoding) dst (fget instruction :mir/left) (fget instruction :mir/right))
         (= encoding :aarch64/f32-sqrt)
         (cat4 (a64-fmov-s0-w (fget instruction :mir/input)) (u32le 0x1e21c000) (a64-fmov-w-s0 dst) (a64-sxtw dst))
         (>= (a64-float-cset encoding) 0)
         (a64-f32-compare (a64-float-cset encoding) dst (fget instruction :mir/left) (fget instruction :mir/right))
         (= encoding :aarch64/f32-to-f64)
         (cat3 (a64-fmov-s0-w (fget instruction :mir/input)) (u32le 0x1e22c000) (u32le (bit-or 0x9e660000 (a64-register dst))))
         (= encoding :aarch64/f64-to-f32)
         (cat4 (u32le (bit-or 0x9e670000 (shl (a64-register (fget instruction :mir/input)) 5)))
               (u32le 0x1e624000) (a64-fmov-w-s0 dst) (a64-sxtw dst))
         (= encoding :aarch64/i64-to-f32)
         (cat3 (u32le (bit-or 0x9e220000 (shl (a64-register (fget instruction :mir/input)) 5))) (a64-fmov-w-s0 dst) (a64-sxtw dst))
         (= encoding :aarch64/i64-to-f64)
         (lcat (u32le (bit-or 0x9e620000 (shl (a64-register (fget instruction :mir/input)) 5)))
               (u32le (bit-or 0x9e660000 (a64-register dst))))
         (>= (a64-int-cset encoding) 0)
         (a64-compare (a64-int-cset encoding) dst (fget instruction :mir/left) (fget instruction :mir/right))
         (= encoding :aarch64/spill-load) (a64-stack-memory 0xf9400000 dst (fint instruction :mir/slot))
         (= encoding :aarch64/spill-store) (a64-stack-memory 0xf9000000 (fget instruction :mir/src) (fint instruction :mir/slot))
         (= encoding :aarch64/incoming-load) (a64-stack-displacement 0xf9400000 dst (fint instruction :mir/displacement))
         (= encoding :aarch64/outgoing-argument)
         (a64-stack-displacement 0xf9000000 (fget instruction :mir/src) (fint instruction :mir/displacement))
         (= encoding :aarch64/incoming-argument-store)
         (a64-stack-displacement 0xf9000000 (fget instruction :mir/src) (fint instruction :mir/displacement))
         (= encoding :aarch64/simd-park-store)
         (u32le (bit-or (bit-or 0x9e670000 (shl (a64-register (fget instruction :mir/src)) 5)) (+ 16 (fint instruction :mir/slot))))
         (= encoding :aarch64/simd-park-load)
         (u32le (bit-or (bit-or 0x9e660000 (shl (+ 16 (fint instruction :mir/slot)) 5)) (a64-register dst)))
         (= encoding :aarch64/move)
         (if (feq dst (fget instruction :mir/src)) (lnone) (a64-mov dst (fget instruction :mir/src)))
         (= encoding :aarch64/runtime-call) (a64-runtime-call instruction-index instruction)
         (= encoding :aarch64/capability-call) (a64-capability-call instruction)
         (= encoding :aarch64/return)
         (lcat (if (fkw= instruction :mir/value :aarch64/x0) (lnone) (a64-mov (kf :aarch64/x0) (fget instruction :mir/value)))
               return-suffix)
         (= (a64-family encoding) :kernel-memory)
         (let [bits (* 8 (kernel-access-bytes encoding))
               store? (>= (string-index-of (keyword-name encoding) "store") 0)
               op (keyword-ns-name "gmir" encoding)]
           (a64-kernel-memory instruction-index bits store?
                              (and (> bits 8) (not (unaligned-access? op (fget instruction :mir/maximum))))
                              instruction))
         (= (a64-family encoding) :slice-memory)
         (a64-slice-memory instruction-index (* 8 (kernel-access-bytes encoding))
                           (>= (string-index-of (keyword-name encoding) "store") 0) instruction)
         (= encoding :aarch64/kernel-try-lock-u32) (a64-kernel-lock instruction-index 0 1 instruction)
         (= encoding :aarch64/kernel-unlock-u32) (a64-kernel-lock instruction-index 1 0 instruction)
         (= encoding :aarch64/kernel-atomic-add-u32) (a64-kernel-atomic instruction-index :add 32 instruction)
         (= encoding :aarch64/kernel-atomic-add-u64) (a64-kernel-atomic instruction-index :add 64 instruction)
         (= encoding :aarch64/kernel-xchg-u32) (a64-kernel-atomic instruction-index :xchg 32 instruction)
         (= encoding :aarch64/kernel-xchg-u64) (a64-kernel-atomic instruction-index :xchg 64 instruction)
         (= encoding :aarch64/kernel-cmpxchg-u32) (a64-kernel-atomic instruction-index :cmpxchg 32 instruction)
         (= encoding :aarch64/kernel-cmpxchg-u64) (a64-kernel-atomic instruction-index :cmpxchg 64 instruction)
         (= encoding :aarch64/kernel-subregion) (a64-kernel-subregion instruction-index instruction)
         (= encoding :aarch64/kernel-dot-f32) (a64-kernel-dot-f32 instruction-index instruction)
         (= 3 (vector-count (a64-dequant-format encoding))) (a64-kernel-dequant-dot encoding instruction-index instruction)
         :else (reject-list! :mc-encode :unknown-encoding instruction))))

(defn- encode-selected [isa :keyword frame-bytes :i64 return-suffix [:list [:ref :form/r]] instruction-index :i64
                           load-a64-multiplier? :bool instruction [:ref :form/r]] [:list [:ref :form/r]]
     (if (= isa :x86-64)
       (reject-list! :mc-encode :x86-64-deferred instruction)
       (encode-selected-a64 isa frame-bytes return-suffix instruction-index load-a64-multiplier? instruction)))


nil

(defn- label-offsets [tokens [:list [:ref :form/r]] i :i64 position :i64 labels [:list [:ref :form/r]]] [:ref :form/r]
     (if (>= i (lcount tokens))
       (fmap labels)
       (let [token (lget tokens i)
             problem (layout-token-problem token)]
         (cond
           (not (= problem :ok)) (reject-form! :layout problem token)
           (layout-label-token? token)
           (let [id (fget token :mir/id)]
             (if (lmember? (lpairs-keys labels) id)
               (reject-form! :layout :duplicate-label token)
               (label-offsets tokens (inc i) position (lconj (lconj labels id) (intf position)))))
           :else
           (let [size (size-of-token token)]
             (if (< size 0)
               (reject-form! :layout :token-size token)
               (label-offsets tokens (inc i) (+ position size) labels)))))))

(defn- lpairs-keys [kvs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount kvs)] (loop [j 0 acc (lnone)] (if (>= j n) acc (recur (+ j 2) (lconj acc (lget kvs j)))))))

(defn- a64-adr-code [code :i64 displacement :i64] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or 0x10000000 (shl (bit-and displacement 3) 29))
                    (bit-or (shl (bit-and (sar displacement 2) 0x7ffff) 5) code))))

nil

(defn- a64-imm19 [base :i64 displacement :i64] :i64
     (bit-or base (shl (bit-and (quot displacement 4) 0x7ffff) 5)))

(defn- encode-layout-branch [token [:ref :form/r] displacement :i64] [:list [:ref :form/r]]
     (let [enc (fkw token :mir/encoding)
           op0 (form/nth-of (fget token :mir/operands) 0)]
       (case enc
         :aarch64/adr-label (a64-adr-code (form/int-value op0) displacement)
         :aarch64/cbz-imm19 (u32le (bit-or (a64-imm19 0xb4000000 displacement) (form/int-value op0)))
         :aarch64/cbnz-imm19 (u32le (bit-or (a64-imm19 0xb5000000 displacement) (form/int-value op0)))
         :aarch64/b-hi-imm19 (u32le (a64-imm19 0x54000008 displacement))
         :aarch64/b-hs-imm19 (u32le (a64-imm19 0x54000002 displacement))
         :aarch64/b-ne-imm19 (u32le (a64-imm19 0x54000001 displacement))
         :aarch64/b-lt-imm19 (u32le (a64-imm19 0x5400000b displacement))
         :aarch64/b-eq-imm19 (u32le (a64-imm19 0x54000000 displacement))
         :aarch64/b-imm26 (u32le (bit-or 0x14000000 (bit-and (quot displacement 4) 0x03ffffff)))
         :aarch64/bl-imm26 (u32le (bit-or 0x94000000 (bit-and (quot displacement 4) 0x03ffffff)))
         :aarch64/cbnz-x16-imm19 (u32le (a64-imm19 0xb5000010 displacement))
         (reject-list! :mc-encode :x86-64-deferred token))))

(defn- branch-size [enc :keyword] :i64
     (case enc
       (:x86-64/jz-rel32 :x86-64/js-rel32 :x86-64/jl-rel32 :x86-64/jg-rel32 :x86-64/ja-rel32 :x86-64/jae-rel32) 6
       (:x86-64/jmp-rel32 :x86-64/call-rel32) 5
       (:x86-64/jmp-rel8 :x86-64/jne-rel8 :x86-64/jns-rel8) 2
       :x86-64/lea-rip-label 7
       (:aarch64/adr-label :aarch64/cbz-x0-imm19 :aarch64/cbz-x1-imm19 :aarch64/cbz-imm19 :aarch64/cbnz-imm19
        :aarch64/cbnz-x1-imm19 :aarch64/cbnz-x16-imm19 :aarch64/b-eq-imm19 :aarch64/b-ne-imm19 :aarch64/b-hi-imm19
        :aarch64/b-hs-imm19 :aarch64/b-lt-imm19 :aarch64/b-gt-imm19 :aarch64/tbnz-imm14 :aarch64/b-imm26 :aarch64/bl-imm26) 4
       -1))

(defn- branch-minimum [enc :keyword] :i64
     (case enc
       (:x86-64/jmp-rel8 :x86-64/jne-rel8 :x86-64/jns-rel8) -128
       (:aarch64/adr-label :aarch64/cbz-x0-imm19 :aarch64/cbz-x1-imm19 :aarch64/cbz-imm19 :aarch64/cbnz-imm19
        :aarch64/cbnz-x1-imm19 :aarch64/cbnz-x16-imm19 :aarch64/b-eq-imm19 :aarch64/b-ne-imm19 :aarch64/b-hi-imm19
        :aarch64/b-hs-imm19 :aarch64/b-lt-imm19 :aarch64/b-gt-imm19) -1048576
       :aarch64/tbnz-imm14 -32768
       (:aarch64/b-imm26 :aarch64/bl-imm26) -134217728
       -2147483648))

(defn- branch-maximum [enc :keyword] :i64
     (case enc
       (:x86-64/jmp-rel8 :x86-64/jne-rel8 :x86-64/jns-rel8) 127
       :aarch64/adr-label 0xfffff
       (:aarch64/cbz-x0-imm19 :aarch64/cbz-x1-imm19 :aarch64/cbz-imm19 :aarch64/cbnz-imm19
        :aarch64/cbnz-x1-imm19 :aarch64/cbnz-x16-imm19 :aarch64/b-eq-imm19 :aarch64/b-ne-imm19 :aarch64/b-hi-imm19
        :aarch64/b-hs-imm19 :aarch64/b-lt-imm19 :aarch64/b-gt-imm19) 0xffffc
       :aarch64/tbnz-imm14 0x7ffc
       (:aarch64/b-imm26 :aarch64/bl-imm26) 0x7fffffc
       0x7fffffff))

(defn- branch-pc-bias [enc :keyword] :i64
     (if (string=? (keyword-ns-text enc) "x86-64") (branch-size enc) 0))

(defn- keyword-ns-text [k :keyword] :string
     (let [t (document-edn-print (document-keyword k)) slash (string-find-byte t 47 1)]
       (if (< slash 0) "" (string-substring t 1 slash))))

(defn- branch-alignment [enc :keyword] :i64
     (if (or (string=? (keyword-ns-text enc) "x86-64") (= enc :aarch64/adr-label)) 1 4))

(defn- qualified-keyword-form? [x [:ref :form/r]] :bool
     (and (form/is-keyword? x) (not (string=? (keyword-ns-text (form/keyword-value x)) ""))))

(defn- map-keys-are? [m [:ref :form/r] text :string] :bool (feq (form/keys-of m) (form/edn-form text)))

(defn- small-int-form? [x [:ref :form/r] hi :i64] :bool
     (and (form/is-int? x) (<= 0 (form/int-value x)) (<= (form/int-value x) hi)))

(defn- layout-token-problem [token [:ref :form/r]] :keyword
     (cond
       (layout-label-token? token)
       (cond (not (map-keys-are? token "#{:mir/op :mir/id}")) :non-canonical-label
             (not (qualified-keyword-form? (fget token :mir/id))) :label-id
             :else :ok)
       (layout-relative-branch-token? token)
       (let [enc (fkw token :mir/encoding)
             ops (fget token :mir/operands)
             n (if (form/is-vec? ops) (fcount ops) -1)]
         (cond
           (not (or (map-keys-are? token "#{:mir/op :mir/encoding :mir/target}")
                    (map-keys-are? token "#{:mir/op :mir/encoding :mir/target :mir/operands}")))
           :non-canonical-branch
           (< (branch-size enc) 0) :unsupported-branch-encoding
           (not (qualified-keyword-form? (fget token :mir/target))) :branch-target
           (and (fhas? token :mir/operands) (not (form/is-vec? ops))) :branch-operands
           (= enc :aarch64/tbnz-imm14)
           (if (and (= n 2) (small-int-form? (fnth ops 0) 31) (small-int-form? (fnth ops 1) 63)) :ok :branch-operands)
           (or (= enc :aarch64/cbz-imm19) (= enc :aarch64/cbnz-imm19))
           (if (and (= n 1) (small-int-form? (fnth ops 0) 31)) :ok :branch-operands)
           (= enc :x86-64/lea-rip-label) (if (and (= n 1) (small-int-form? (fnth ops 0) 15)) :ok :branch-operands)
           (= enc :aarch64/adr-label) (if (and (= n 1) (small-int-form? (fnth ops 0) 30)) :ok :branch-operands)
           (fhas? token :mir/operands) :branch-operands
           :else :ok))
       (and (form/is-map? token) (fhas? token :mir/op)) :unknown-token-operation
       :else :ok))

(defn- size-of-token [token [:ref :form/r]] :i64
     (cond
       (layout-label-token? token) 0
       (layout-relative-branch-token? token) (branch-size (fkw token :mir/encoding))
       (ftruthy? token :native/data-content)
       (let [t (fkw token :native/data-target)] (cond (= t :x86-64) 10 (= t :aarch64) 16 :else -1))
       (ftruthy? token :native/rodata-content)
       (let [t (fkw token :native/rodata-target)] (cond (= t :x86-64) 7 (= t :aarch64) 4 :else -1))
       (and (form/is-int? token) (<= 0 (form/int-value token)) (<= (form/int-value token) 255)) 1
       :else -1))

;; boot-lit: `lea dst,[rip+disp32]`. ModRM mod=00 rm=101 is RIP-relative in
;; 64-bit mode -- the same three bits mean "disp32, no base" in 32-bit mode,
;; which is the encoding trap here. The displacement is measured from the END
;; of the instruction, hence the seven.
nil

(defn- a64-adr [dst [:ref :form/r] displacement :i64] [:list [:ref :form/r]]
     (if (not (and (<= -1048576 displacement) (<= displacement 1048575)))
       (reject-list! :mc-encode :rodata-literal-out-of-range dst)
       (a64-adr-code (a64-register dst) displacement)))

(defn- align-to [value :i64 alignment :i64] :i64 (* alignment (quot (+ value (dec alignment)) alignment)))

(defn- resolve-tokens [tokens [:list [:ref :form/r]] i :i64 position :i64 labels [:ref :form/r]
                          data-offsets [:ref :form/r] literal-offsets [:ref :form/r] out [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (lcount tokens))
       out
       (let [token (lget tokens i)]
         (cond
           (layout-label-token? token) (resolve-tokens tokens (inc i) position labels data-offsets literal-offsets out)
           (layout-relative-branch-token? token)
           (let [enc (fkw token :mir/encoding)
                 size (branch-size enc)
                 target (form/form-get labels (fget token :mir/target))]
             (if (form/is-nil? target)
               (reject-list! :layout :unknown-label token)
               (let [displacement (- (form/int-value target) (+ position (branch-pc-bias enc)))]
                 (cond
                   (not (and (<= (branch-minimum enc) displacement) (<= displacement (branch-maximum enc))))
                   (reject-list! :layout :displacement-out-of-range token)
                   (not (= 0 (fmod displacement (branch-alignment enc))))
                   (reject-list! :layout :displacement-unaligned token)
                   :else
                   (let [encoded (encode-layout-branch token displacement)]
                     (if (not (= size (lcount encoded)))
                       (reject-list! :layout :branch-width token)
                       (resolve-tokens tokens (inc i) (+ position size) labels data-offsets literal-offsets (lcat out encoded))))))))
           :else
           (let [size (size-of-token token)
                 encoded (cond
                           (ftruthy? token :native/data-content)
                           (let [offset (form/int-value (form/form-get data-offsets (fget token :native/data-content)))]
                             (if (fkw= token :native/data-target :aarch64)
                               (a64-constant-fixed (fget token :native/data-dst) offset)
                               (reject-list! :mc-encode :x86-64-deferred token)))
                           (ftruthy? token :native/rodata-content)
                           (let [offset (form/int-value (form/form-get literal-offsets
                                                                       (form/vec2 (fget token :native/rodata-encoding)
                                                                                  (fget token :native/rodata-content))))]
                             (if (fkw= token :native/rodata-target :aarch64)
                               (a64-adr (fget token :native/rodata-dst) (- offset position))
                               (reject-list! :mc-encode :x86-64-deferred token)))
                           :else (lone token))]
             (if (not (= size (lcount encoded)))
               (reject-list! :layout :token-width token)
               (resolve-tokens tokens (inc i) (+ position size) labels data-offsets literal-offsets (lcat out encoded))))))))

(defn- distinct-forms [xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount xs)]
       (loop [i 0 acc (lnone)] (if (>= i n) acc (recur (inc i) (if (lmember? acc (lget xs i)) acc (lconj acc (lget xs i))))))))

(defn- data-contents [tokens [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount tokens)]
       (distinct-forms (loop [i 0 acc (lnone)]
                         (if (>= i n) acc
                           (let [c (fget (lget tokens i) :native/data-content)]
                             (recur (inc i) (if (truthy? c) (lconj acc c) acc))))))))

(defn- rodata-literals [tokens [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount tokens)]
       (distinct-forms (loop [i 0 acc (lnone)]
                         (if (>= i n) acc
                           (let [t (lget tokens i) c (fget t :native/rodata-content)]
                             (recur (inc i) (if (truthy? c) (lconj acc (form/vec2 (fget t :native/rodata-encoding) c)) acc))))))))

(defn- tokens-code-size [tokens [:list [:ref :form/r]]] :i64
     (let [n (lcount tokens)]
       (loop [i 0 s 0] (if (>= i n) s (recur (inc i) (let [z (size-of-token (lget tokens i))] (if (> z 0) (+ s z) s)))))))

(defn- literal-plan [literals [:list [:ref :form/r]] start :i64] [:ref :form/r]
     (let [n (lcount literals)]
       (loop [i 0 offset start offsets (fmap (lnone)) bytes (lnone)]
         (if (>= i n) (form/vec2 offsets (fvec bytes))
           (let [key (lget literals i)
                 r (gmir/rodata-bytes (fnth key 0) (fnth key 1))
                 encoded (option-value-of [:option :vector-i64] r (vector-conj (vector-alloc 0) -1))]
             (if (and (= 1 (vector-count encoded)) (= -1 (vector-at encoded 0)))
               (do (trap!) (form/vec2 offsets (fvec bytes)))
               (let [next-offset (align-to (+ offset (vector-count encoded)) (gmir/rodata-alignment))
                     pad (- next-offset (+ offset (vector-count encoded)))]
                 (recur (inc i) next-offset (form/assoc-form offsets key (intf offset))
                        (lcat (lcat bytes (byte-list encoded)) (zeros pad))))))))))

(defn- zeros [n :i64] [:list [:ref :form/r]]
     (loop [i 0 acc (lnone)] (if (>= i n) acc (recur (inc i) (lconj acc (intf 0))))))

(defn- data-plan [contents [:list [:ref :form/r]] code-size :i64] [:ref :form/r]
     (let [n (lcount contents)]
       (loop [i 0 offset code-size offsets (fmap (lnone)) bytes (lnone)]
         (if (>= i n) (form/vec2 offsets (fvec bytes))
           (let [c (lget contents i) b (utf8-bytes (form/string-value c))]
             (recur (inc i) (+ offset (lcount b)) (form/assoc-form offsets c (intf offset)) (lcat bytes b)))))))

(defn- resolve-program-layout [tokens [:list [:ref :form/r]]] [:ref :form/r]
     (let [labels (label-offsets tokens 0 0 (lnone))
           code-size (tokens-code-size tokens)
           dp (data-plan (data-contents tokens) code-size)
           data (kids (fnth dp 1))
           literals (rodata-literals tokens)
           lp (literal-plan literals (align-to (+ code-size (lcount data)) (gmir/rodata-alignment)))
           literal-pad (if (> (lcount literals) 0)
                         (- (align-to (+ code-size (lcount data)) (gmir/rodata-alignment)) (+ code-size (lcount data)))
                         0)
           code (resolve-tokens tokens 0 0 labels (fnth dp 0) (fnth lp 0) (lnone))]
       (map3 :code (fvec (lcat (cat3 code data (zeros literal-pad)) (kids (fnth lp 1))))
             :code-size (intf code-size)
             :labels labels)))

nil

(defn- a64-leaf-constant-registers [] [:list [:ref :form/r]]
     (form/three-forms (kf :aarch64/x13) (kf :aarch64/x14) (kf :aarch64/x15)))

(defn- a64-leaf-cache-safe-encodings [] [:ref :form/r]
     (form/edn-form "#{:aarch64/argument :aarch64/constant :aarch64/data-address :aarch64/add :aarch64/subtract :aarch64/multiply :aarch64/multiply-add :aarch64/multiply-subtract :aarch64/quotient :aarch64/quotient-constant :aarch64/bit-and :aarch64/bit-or :aarch64/bit-xor :aarch64/shift-left :aarch64/shift-right-signed :aarch64/shift-right-unsigned :aarch64/f64-add :aarch64/f64-subtract :aarch64/f64-multiply :aarch64/f64-divide :aarch64/f64-min :aarch64/f64-max :aarch64/f64-sqrt :aarch64/f64-equal :aarch64/f64-less-than :aarch64/f64-less-or-equal :aarch64/f64-greater-than :aarch64/f64-greater-or-equal :aarch64/f64-unordered :aarch64/f32-add :aarch64/f32-subtract :aarch64/f32-multiply :aarch64/f32-divide :aarch64/f32-sqrt :aarch64/f32-equal :aarch64/f32-less-than :aarch64/f32-less-or-equal :aarch64/f32-greater-than :aarch64/f32-greater-or-equal :aarch64/f32-unordered :aarch64/f32-to-f64 :aarch64/f64-to-f32 :aarch64/i64-to-f32 :aarch64/i64-to-f64 :aarch64/equal :aarch64/less-than :aarch64/greater-than :aarch64/less-or-equal :aarch64/greater-or-equal :aarch64/spill-load :aarch64/spill-store :aarch64/move :aarch64/return :aarch64/simd-park-store :aarch64/simd-park-load}"))

(defn- alias-of [aliases [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
     (if (form/form-has? aliases v) (form/form-get aliases v) v))

(defn- a64-cache-register-sources [instruction [:ref :form/r] aliases [:ref :form/r]] [:ref :form/r]
     (let [xs (form/kids-of instruction) n (vector-count xs)]
       (fmap (loop [j 0 acc (lnone)]
               (if (>= (+ j 1) n) acc
                 (let [k (typed-list-nth [:list [:ref :form/r]] xs j)
                       v (typed-list-nth [:list [:ref :form/r]] xs (+ j 1))]
                   (recur (+ j 2)
                          (lconj (lconj acc k)
                                 (if (and (form/is-keyword? k) (mir-source-key? (form/keyword-value k) 2))
                                   (if (form/is-vec? v) (fvec (map-alias (kids v) aliases)) (alias-of aliases v))
                                   v)))))))))

(defn- map-alias [xs [:list [:ref :form/r]] aliases [:ref :form/r]] [:list [:ref :form/r]]
     (let [n (lcount xs)] (loop [i 0 acc (lnone)] (if (>= i n) acc (recur (inc i) (lconj acc (alias-of aliases (lget xs i))))))))

(defn- positive-mersenne-shift [value :i64] :i64
     (cond (= value 9223372036854775807) 63
           (<= value 0) -1
           :else (let [c (+ value 1)]
                   (if (= 0 (bit-and c (- c 1)))
                     (loop [k 0 x c] (if (= x 1) (if (and (>= k 1) (<= k 63)) k -1) (recur (inc k) (sar x 1))))
                     -1))))

(defn- cache-value-of-register [cache [:list [:ref :form/r]] register [:ref :form/r]] [:ref :form/r]
     (let [n (lcount cache)]
       (loop [i 0] (if (>= i n) (nf) (let [e (lget cache i)] (if (feq (fnth e 1) register) (fnth e 0) (recur (inc i))))))))

(defn- cache-register-of-value [cache [:list [:ref :form/r]] value [:ref :form/r]] [:ref :form/r]
     (let [n (lcount cache)]
       (loop [i 0] (if (>= i n) (nf) (let [e (lget cache i)] (if (feq (fnth e 0) value) (fnth e 1) (recur (inc i))))))))

(defn- a64-strength-reduce-cached-mersenne [instruction [:ref :form/r] cache [:list [:ref :form/r]]] [:ref :form/r]
     (if (not (fkw= instruction :mc/encoding :aarch64/multiply-subtract))
       instruction
       (let [left (fget instruction :mir/left) right (fget instruction :mir/right)
             lv (cache-value-of-register cache left) rv (cache-value-of-register cache right)
             factor (cond (truthy? lv) right (truthy? rv) left :else (nf))
             constant-value (cond (truthy? lv) lv (truthy? rv) rv :else (nf))
             shift (if (truthy? constant-value) (positive-mersenne-shift (form/int-value constant-value)) -1)]
         (if (>= shift 0)
           (fassoc (fassoc instruction :native/a64-mersenne-shift (intf shift)) :native/a64-mersenne-factor factor)
           instruction))))

nil

(defn- msub-on? [instruction [:ref :form/r] register [:ref :form/r]] :bool
     (and (fkw= instruction :mc/encoding :aarch64/multiply-subtract)
          (or (feq (fget instruction :mir/left) register) (feq (fget instruction :mir/right) register))))

(defn- union-tags [tags [:ref :form/r] sources [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount sources)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) acc
           (recur (inc i) (let [t (form/form-get tags (lget sources i))]
                            (if (truthy? t) (lcat-distinct acc (kids t)) acc)))))))

(defn- lcat-distinct [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount ys)] (loop [i 0 acc xs] (if (>= i n) acc (recur (inc i) (if (lmember? acc (lget ys i)) acc (lconj acc (lget ys i))))))))

(defn- msub-ordinals [instructions [:list [:ref :form/r]] factor [:ref :form/r]] :vector-i64
     ;; position -> ordinal, -1 for not an msub on FACTOR
     (let [n (lcount instructions)]
       (loop [i 0 k 0 acc (vector-alloc 0)]
         (if (>= i n) acc
           (if (msub-on? (lget instructions i) factor)
             (recur (inc i) (inc k) (vector-conj acc k))
             (recur (inc i) k (vector-conj acc -1)))))))

(defn- count-ordinals [ords :vector-i64] :i64
     (let [n (vector-count ords)] (loop [i 0 c 0] (if (>= i n) c (recur (inc i) (if (>= (vector-at ords i) 0) (inc c) c))))))

(defn- chain-ordered? [reaches [:ref :form/r] msub-count :i64] :bool
     (loop [o 1]
       (if (>= o msub-count) true
         (let [r (form/form-get reaches (intf o))]
           (if (and (truthy? r) (fmember? r (intf (dec o)))) (recur (inc o)) false)))))

(defn- a64-serial-msub-chain? [instructions [:list [:ref :form/r]] factor [:ref :form/r]] :bool
     (let [ords (msub-ordinals instructions factor)
           msub-count (count-ordinals ords)]
       (or (<= msub-count 1)
           (chain-ordered? (serial-reaches instructions ords) msub-count))))

(defn- serial-reaches [instructions [:list [:ref :form/r]] ords :vector-i64] [:ref :form/r]
     (let [n (lcount instructions)]
       (loop [i 0 tags (fmap (lnone)) reaches (fmap (lnone))]
         (if (>= i n) reaches
           (let [ins (lget instructions i)
                 source-tags (union-tags tags (a64-source-registers ins))
                 ordinal (vector-at ords i)
                 reaches-p (if (>= ordinal 0) (form/assoc-form reaches (intf ordinal) (fset source-tags)) reaches)
                 dst (fget ins :mir/dst)
                 carried (if (>= ordinal 0) (lcat-distinct source-tags (lone (intf ordinal))) source-tags)
                 tags-p (if (truthy? dst)
                         (if (> (lcount carried) 0) (form/assoc-form tags dst (fset carried)) (form/dissoc-form tags dst))
                         tags)]
             (recur (inc i) tags-p reaches-p))))))

(defn- readers-of [instructions [:list [:ref :form/r]] register [:ref :form/r]] :i64
     (let [n (lcount instructions)]
       (loop [i 0 c 0] (if (>= i n) c (recur (inc i) (if (lmember? (a64-source-registers (lget instructions i)) register) (inc c) c))))))

(defn- msub-readers-of [instructions [:list [:ref :form/r]] register [:ref :form/r]] :i64
     (let [n (lcount instructions)]
       (loop [i 0 c 0]
         (if (>= i n) c
           (let [ins (lget instructions i)]
             (recur (inc i) (if (and (lmember? (a64-source-registers ins) register) (msub-on? ins register)) (inc c) c)))))))

(defn- a64-profitable-cached-mersenne-values [instructions [:list [:ref :form/r]] cache [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount cache)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) acc
           (let [e (lget cache i) value (form/int-value (fnth e 0)) register (fnth e 1)
                 shift (positive-mersenne-shift value)]
             (recur (inc i)
                    (if (< shift 0) acc
                      (let [readers (readers-of instructions register)
                            uses (msub-readers-of instructions register)
                            words (quot (lcount (a64-constant (kf :aarch64/x13) value)) 4)]
                        (if (and (> uses 0) (= readers uses)
                                 (or (< (* 2 uses) (+ words uses)) (a64-serial-msub-chain? instructions register)))
                          (lconj acc (fnth e 0))
                          acc)))))))))

(defn- a64-cache-source-keys [] [:list [:ref :form/r]]
     (form/kids-of (form/edn-form "[:mir/test :mir/value :mir/src :mir/input :mir/left :mir/right :mir/addend :mir/base :mir/length :mir/index :mir/stored :mir/expected :mir/offset :mir/size :mir/arguments]")))

(defn- a64-source-keys [] [:list [:ref :form/r]]
     (form/kids-of (form/edn-form "[:mir/test :mir/value :mir/src :mir/input :mir/left :mir/right :mir/addend :mir/base :mir/length :mir/index :mir/stored :mir/expected :mir/second-base :mir/second-length :mir/count :mir/offset :mir/size :mir/arguments]")))

(defn- a64-source-registers [instruction [:ref :form/r]] [:list [:ref :form/r]] (source-values instruction 1))

(defn- a64-add-sub-immediate [op :keyword value :i64] :vector-i64
     (if (= value (- -9223372036854775807 1))
       (vector-alloc 0)
       (let [negative? (< value 0)
             magnitude (if negative? (- 0 value) value)
             plan (cond (<= magnitude 4095) (vector-conj (vector-conj (vector-alloc 0) magnitude) 0)
                        (and (= 0 (rem magnitude 4096)) (<= (quot magnitude 4096) 4095)) (vector-conj (vector-conj (vector-alloc 0) (quot magnitude 4096)) 1)
                        :else (vector-alloc 0))]
         (if (= 0 (vector-count plan)) plan
           (vector-conj (vector-conj (vector-conj (vector-alloc 0) (if (= (= op :aarch64/add) (not negative?)) 1 2)) (vector-at plan 0)) (vector-at plan 1))))))

(defn- uses-before-redefinition [instructions [:list [:ref :form/r]] from :i64 register [:ref :form/r]] :i64
     (let [n (lcount instructions)]
       (loop [i from uses 0]
         (if (>= i n) uses
           (let [ins (lget instructions i)
                 srcs (a64-source-registers ins)
                 u (+ uses (loop [j 0 c 0] (if (>= j (lcount srcs)) c (recur (inc j) (if (feq (lget srcs j) register) (inc c) c)))))]
             (if (feq register (fget ins :mir/dst)) u (recur (inc i) u)))))))

(defn- a64-fold-adjacent-add-sub-immediates [instructions [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount instructions)]
       (loop [i 0 out (lnone)]
         (if (>= i n) out
           (let [constant (lget instructions i)
                 consumer (lget instructions (inc i))
                 register (fget constant :mir/dst)
                 op (fkw consumer :mc/encoding)
                 constant? (fkw= constant :mc/encoding :aarch64/constant)
                 operand (cond (and (= op :aarch64/add) (feq register (fget consumer :mir/right))) (fget consumer :mir/left)
                               (and (= op :aarch64/add) (feq register (fget consumer :mir/left))) (fget consumer :mir/right)
                               (and (= op :aarch64/subtract) (feq register (fget consumer :mir/right))) (fget consumer :mir/left)
                               :else (nf))
                 selected (if (and constant? (truthy? operand) (= 1 (uses-before-redefinition instructions (inc i) register)))
                            (a64-add-sub-immediate op (fint constant :mir/value))
                            (vector-alloc 0))]
             (if (> (vector-count selected) 0)
               (recur (+ i 2)
                      (lconj out (fassoc (fassoc (fassoc (fassoc consumer :mir/left operand)
                                                         :native/a64-immediate-op (kf (if (= 1 (vector-at selected 0)) :add :subtract)))
                                                 :native/a64-immediate (intf (vector-at selected 1)))
                                         :native/a64-immediate-shift (intf (vector-at selected 2)))))
               (recur (inc i) (lconj out constant))))))))

;; A Mersenne-reduced multiply-subtract no longer reads its `:mir/left` and
;; `:mir/right`; it reads the factor register the reduction recorded. Reporting
;; the pre-reduction operands here would keep a constant register alive that
;; nothing loads any more, and the cache would refuse a slot it could have used.
(defn- a64-used-source-registers [instructions [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount instructions)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) acc
           (let [ins (lget instructions i)
                 reduced? (ftruthy? ins :native/a64-mersenne-shift)
                 factor (fget ins :native/a64-mersenne-factor)
                 srcs (if reduced?
                        (a64-source-registers (form/dissoc-form (form/dissoc-form ins (kf :mir/left)) (kf :mir/right)))
                        (a64-source-registers ins))]
             (recur (inc i) (lcat (if (truthy? factor) (lconj acc factor) acc) srcs)))))))

;; The x86-64 sibling of `a64-fold-adjacent-add-sub-immediates`, extended to
;; multiply because x86-64 has a three-operand `imul r64,r64,imm32` where
;; AArch64 does not. Same shape and same safety condition: a constant may fold
;; into the instruction that follows it only when that instruction is its one
;; and only reader before the register is written again. Anything else — the
;; register read twice, read later, or never — leaves both instructions alone.
;; Once a constant is folded, the instruction that carries it reads its source
;; through a form that accepts any register: three-operand `imul r64,r64,imm32`
;; and `lea r64,[r64+disp32]` both name their source explicitly rather than
;; operating in place. A copy feeding such an instruction is therefore
;; redundant — `mov rcx,r11` then `imul r8,rcx,M` is `imul r8,r11,M`.
;;
;; The safety condition is the one the immediate folding already uses: the
;; copy's destination must be read exactly once before it is written again. If
;; anything else reads it, or reads it later, the copy is doing work and stays.
;;
;; Restricted to instructions that carry an immediate on purpose. Without one,
;; add and subtract lower in place and genuinely need the copy; propagating
;; into them would change which register the result lands in.
;; A constant division leaves its answer in R11 and then moves it to whatever
;; `dst` the allocator chose. That move sits on the dependency chain — the next
;; instruction cannot start until it retires — and it is unnecessary whenever
;; the reader is a form that names its source explicitly, which the folded
;; three-operand shapes all are.
;;
;; So: when the division's destination is read exactly once, by the instruction
;; immediately after it, in a slot that accepts any register, the reader is
;; pointed at R11 and the division is told to skip its move. R11 is outside the
;; allocator's four registers, and the reader writes its own `dst`, so nothing
;; can be holding R11 across the gap.
nil

nil

;; Every constant division by the same divisor loads the same ten-byte
;; reciprocal into R10. Loading it once is worth seven of those ten-byte loads
;; on a kernel that divides eight times, and costs nothing: R10 is outside the
;; allocator's four registers, and the sign correction that used to borrow it
;; now borrows RDX, which is dead at that point in every branch and is restored
;; by the pop regardless.
;;
;; Only in a straight-line run of qualifying encodings, and only for divisions
;; after the first with that exact divisor. A branch would let control reach the
;; second division without passing the first.
nil

nil

nil

nil

nil

nil

(defn- constant-occurrences [instructions [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount instructions)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) acc
           (let [ins (lget instructions i)]
             (if (fkw= ins :mc/encoding :aarch64/constant)
               (recur (inc i) (occurrence-add acc (fget ins :mir/value) i))
               (recur (inc i) acc)))))))

(defn- occurrence-add [acc [:list [:ref :form/r]] value [:ref :form/r] i :i64] [:list [:ref :form/r]]
     (let [n (lcount acc)]
       (loop [j 0]
         (if (>= j n) (lconj acc (form/vec3 value (intf i) (intf 1)))
           (let [e (lget acc j)]
             (if (feq (fnth e 0) value)
               (lcat (lconj (lslice acc 0 j) (form/vec3 value (fnth e 1) (intf (inc (form/int-value (fnth e 2)))))) (ldrop acc (inc j)))
               (recur (inc j))))))))

(defn- singleton-mersenne? [instructions [:list [:ref :form/r]] e [:ref :form/r]] :bool
     (and (= 1 (form/int-value (fnth e 2)))
          (>= (positive-mersenne-shift (form/int-value (fnth e 0))) 0)
          (let [dst (fget (lget instructions (form/int-value (fnth e 1))) :mir/dst)]
            (and (truthy? dst)
                 (let [readers (readers-of instructions dst) uses (msub-readers-of instructions dst)]
                   (and (> uses 0) (= readers uses)))))))

(defn- cache-candidates [instructions [:list [:ref :form/r]] occ [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount occ)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) acc
           (let [e (lget occ i) c (form/int-value (fnth e 2))]
             (recur (inc i)
                    (if (or (> c 1) (singleton-mersenne? instructions e))
                      (lconj acc (form/vec3 (fnth e 0) (fnth e 1)
                                            (intf (* (dec c) (lcount (a64-constant (kf :aarch64/x13) (form/int-value (fnth e 0))))))))
                      acc)))))))

(defn- candidate-before? [a [:ref :form/r] b [:ref :form/r]] :bool
     (let [sa (form/int-value (fnth a 2)) sb (form/int-value (fnth b 2))]
       (or (> sa sb) (and (= sa sb) (< (form/int-value (fnth a 1)) (form/int-value (fnth b 1)))))))

(defn- insert-sorted [acc [:list [:ref :form/r]] x [:ref :form/r]] [:list [:ref :form/r]]
     (let [n (lcount acc)]
       (loop [j 0] (if (>= j n) (lconj acc x) (if (candidate-before? x (lget acc j)) (form-insert acc j x) (recur (inc j)))))))

(defn- sort-candidates [xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount xs)] (loop [i 0 acc (lnone)] (if (>= i n) acc (recur (inc i) (insert-sorted acc (lget xs i)))))))

(defn- a64-cache-eligible? [instructions [:list [:ref :form/r]]] :bool
     (let [n (lcount instructions) safe (a64-leaf-cache-safe-encodings)]
       (loop [i 0]
         (if (>= i n) true
           (let [ins (lget instructions i) enc (fget ins :mc/encoding)]
             (if (and (fkw= ins :mc/op :mc/instruction) (fmember? safe enc)
                      (not (kw? enc :aarch64/call)) (not (kw? enc :aarch64/tail-call)))
               (recur (inc i)) false))))))

(defn- cache-alias-pass [instructions [:list [:ref :form/r]] cache [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount instructions)]
       (loop [i 0 aliases (fmap (lnone)) loaded (lnone) out (lnone)]
         (if (>= i n) out
           (let [ins (lget instructions i) value (fget ins :mir/value)
                 register (if (fkw= ins :mc/encoding :aarch64/constant) (cache-register-of-value cache value) (nf))]
             (if (truthy? register)
               (recur (inc i) (form/assoc-form aliases (fget ins :mir/dst) register)
                      (if (lmember? loaded value) loaded (lconj loaded value))
                      (if (lmember? loaded value) out (lconj out (fassoc ins :mir/dst register))))
               (let [dst (fget ins :mir/dst)]
                 (recur (inc i) (if (truthy? dst) (form/dissoc-form aliases dst) aliases) loaded
                        (lconj out (a64-cache-register-sources ins aliases))))))))))

(defn- take-cache [selected [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [regs (a64-leaf-constant-registers) m (min (lcount selected) 3)]
       (loop [i 0 acc (lnone)] (if (>= i m) acc (recur (inc i) (lconj acc (form/vec2 (fnth (lget selected i) 0) (lget regs i))))))))

(defn- select-cache-entries [cache [:list [:ref :form/r]] values [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (loop [i 0 acc (lnone)]
       (if (>= i (lcount cache)) acc
         (recur (inc i) (if (lmember? values (fnth (lget cache i) 0)) (lconj acc (lget cache i)) acc)))))

(defn- reduce-all-mersenne [aliased [:list [:ref :form/r]] reduction-cache [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (loop [i 0 acc (lnone)]
       (if (>= i (lcount aliased)) acc
         (recur (inc i) (lconj acc (a64-strength-reduce-cached-mersenne (lget aliased i) reduction-cache))))))

(defn- cache-registers-of [cache [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (loop [i 0 acc (lnone)] (if (>= i (lcount cache)) acc (recur (inc i) (lconj acc (fnth (lget cache i) 1))))))

(defn- drop-unused-cache-loads [rewritten [:list [:ref :form/r]] cache-registers [:list [:ref :form/r]] used [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (loop [i 0 acc (lnone)]
       (if (>= i (lcount rewritten)) acc
         (let [ins (lget rewritten i) dst (fget ins :mir/dst)]
           (recur (inc i)
                  (if (and (fkw= ins :mc/encoding :aarch64/constant) (lmember? cache-registers dst) (not (lmember? used dst)))
                    acc (lconj acc ins)))))))

(defn- a64-cache-leaf-constants [instructions [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (not (a64-cache-eligible? instructions))
       instructions
       (let [cache (take-cache (sort-candidates (cache-candidates instructions (constant-occurrences instructions))))
             aliased (cache-alias-pass instructions cache)
             reduction-cache (select-cache-entries cache (a64-profitable-cached-mersenne-values aliased cache))
             rewritten (reduce-all-mersenne aliased reduction-cache)]
         (drop-unused-cache-loads rewritten (cache-registers-of cache) (a64-used-source-registers rewritten)))))

nil

(defn- a64-x16-preserving? [encoding [:ref :form/r]] :bool
     (case (kw-of encoding)
       (:aarch64/argument :aarch64/constant :aarch64/data-address :aarch64/add :aarch64/subtract :aarch64/multiply
        :aarch64/multiply-add :aarch64/multiply-subtract :aarch64/bit-and :aarch64/bit-or :aarch64/bit-xor
        :aarch64/shift-left :aarch64/shift-right-signed :aarch64/shift-right-unsigned :aarch64/spill-load
        :aarch64/spill-store :aarch64/move :aarch64/return :aarch64/simd-park-store :aarch64/simd-park-load) true
       false))

(defn- label-ids [tokens [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount tokens)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) acc
           (let [t (lget tokens i)] (recur (inc i) (if (layout-label-token? t) (lconj acc (fget t :mir/id)) acc)))))))

(defn- keyword-ns-dot-name [k [:ref :form/r]] :string
     (let [kw (form/keyword-value k)] (string-concat (keyword-ns-text kw) (string-concat "." (keyword-name kw)))))

(defn- rename-labels [tokens [:list [:ref :form/r]] rename [:list [:ref :form/r]] ns :string] [:list [:ref :form/r]]
     (let [n (lcount tokens)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) acc
           (let [t (lget tokens i)]
             (recur (inc i)
                    (cond
                      (and (layout-label-token? t) (lmember? rename (fget t :mir/id)))
                      (lconj acc (fassoc t :mir/id (kf (keyword-from-string (string-concat ns (string-concat "/" (keyword-ns-dot-name (fget t :mir/id))))))))
                      (and (layout-relative-branch-token? t) (lmember? rename (fget t :mir/target)))
                      (lconj acc (fassoc t :mir/target (kf (keyword-from-string (string-concat ns (string-concat "/" (keyword-ns-dot-name (fget t :mir/target))))))))
                      :else (lconj acc t))))))))

(defn- rename-token-labels [scope :string tokens [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (rename-labels tokens (distinct-forms (label-ids tokens)) (string-concat "kotoba.native." scope)))

(defn- index-where-op [instructions [:list [:ref :form/r]] op :keyword] :vector-i64
     (let [n (lcount instructions)]
       (loop [i 0 acc (vector-alloc 0)] (if (>= i n) acc (recur (inc i) (if (kw? (fget (lget instructions i) :mc/op) op) (vector-conj acc i) acc))))))

(defn- a64-bottom-test-self-recur-plan [instructions [:list [:ref :form/r]]] [:ref :form/r]
     (let [reentries (index-where-op instructions :mc/reentry)
           recurs (index-where-op instructions :mc/recur)]
       (if (not (and (= 1 (vector-count reentries)) (= 1 (vector-count recurs))))
         (nf)
         (let [ri (vector-at reentries 0) ci (vector-at recurs 0)
               reentry (lget instructions ri)
               branch (lget instructions (+ ri 1))
               return (lget instructions (+ ri 2))
               body-label (lget instructions (+ ri 3))
               recur (lget instructions ci)
               parameters (fget reentry :mc/parameters)
               arguments (fget recur :mc/arguments)]
           (if (and (= ci (dec (lcount instructions)))
                    (fkw= branch :mc/op :mc/branch-nonzero)
                    (fkw= return :mc/op :mc/instruction)
                    (fkw= return :mc/encoding :aarch64/return)
                    (layout-label-token? body-label)
                    (feq (fget branch :mc/target) (fget body-label :mir/id))
                    (feq parameters arguments)
                    (fmember? arguments (fget branch :mc/test))
                    (fmember? arguments (fget return :mir/value)))
             (fassoc (fassoc (map4 :recur-index (intf ci) :branch-index (intf (+ ri 1)) :test (fget branch :mc/test) :body (fget branch :mc/target))
                             :return-index (intf (+ ri 2)))
                     :return return)
             (nf))))))

(defn- a64-identity-callee? [function [:ref :form/r]] :bool
     (and (form/eq (fget function :mc/arity) (intf 1))
          (form/eq (fget function :mc/frame-slots) (intf 0))
          (feq (fget function :mc/instructions)
               (form/edn-form "[{:mc/op :mc/instruction :mc/encoding :aarch64/argument :mir/dst :aarch64/x0 :mir/index 0} {:mc/op :mc/instruction :mc/encoding :aarch64/return :mir/value :aarch64/x0}]"))))

(defn- x0-clobbered-between? [instructions [:list [:ref :form/r]] from :i64 to :i64] :bool
     (loop [i from]
       (if (>= i to) false
         (let [ins (lget instructions i) enc (fget ins :mc/encoding)]
           (if (or (fkw= ins :mir/dst :aarch64/x0)
                   (kw? enc :aarch64/call) (kw? enc :aarch64/runtime-call) (kw? enc :aarch64/capability-call))
             true (recur (inc i)))))))

(defn- body-label-index [instructions [:list [:ref :form/r]] body [:ref :form/r]] :i64
     (let [n (lcount instructions)]
       (loop [i 0] (if (>= i n) -1 (let [t (lget instructions i)] (if (and (layout-label-token? t) (feq body (fget t :mir/id))) i (recur (inc i))))))))

(defn- a64-loop-invariant-identity-call-plan [instructions [:list [:ref :form/r]] bottom-test [:ref :form/r] identity-callees [:list [:ref :form/r]]] [:ref :form/r]
     (if (not (truthy? bottom-test))
       (nf)
       (let [body-index (body-label-index instructions (fget bottom-test :body))]
         (if (< body-index 0)
           (nf)
           (let [ci (+ body-index 1) li (+ body-index 2)
                 constant (lget instructions ci)
                 call (lget instructions li)
                 recur-index (form/int-value (fget bottom-test :recur-index))
                 recur (lget instructions recur-index)]
             (if (and (fkw= constant :mc/op :mc/instruction)
                      (fkw= constant :mc/encoding :aarch64/constant)
                      (fkw= constant :mir/dst :aarch64/x0)
                      (fkw= call :mc/op :mc/instruction)
                      (fkw= call :mc/encoding :aarch64/call)
                      (feq (fget call :mir/arguments) (fvec (lone (kf :aarch64/x0))))
                      (fkw= call :mir/dst :aarch64/x0)
                      (lmember? identity-callees (fget call :mir/callee))
                      (not (fmember? (fget recur :mc/arguments) (kf :aarch64/x0)))
                      (not (x0-clobbered-between? instructions (inc li) recur-index)))
               (map3 :body-index (intf body-index) :constant-index (intf ci) :constant constant)
               (nf)))))))

(defn- it-step [isa :keyword frame-bytes :i64 return-suffix [:list [:ref :form/r]] tail-suffix [:list [:ref :form/r]]
                   callee-labels [:ref :form/r] self-tail-prefix [:list [:ref :form/r]] self-tail-body [:ref :form/r]
                   bottom-test-exit [:ref :form/r] bottom-test [:ref :form/r] identity-hoist [:ref :form/r]
                   instruction-index :i64 instruction [:ref :form/r] load-multiplier? :bool] [:list [:ref :form/r]]
     (let [op (fkw instruction :mc/op)]
       (cond
         (layout-label-token? instruction)
         (if (and (truthy? identity-hoist) (= instruction-index (fint identity-hoist :body-index)))
           (lconj (encode-selected isa frame-bytes return-suffix (fint identity-hoist :constant-index) false (fget identity-hoist :constant))
                  instruction)
           (lone instruction))
         (= op :mc/reentry) (lone (layout-label self-tail-body))
         (= op :mc/recur)
         (let [prefix (rename-token-labels (string-concat "self-tail." (string-from-i64 instruction-index)) self-tail-prefix)]
           (if (and (truthy? bottom-test) (= instruction-index (fint bottom-test :recur-index)))
             (lcat (lcat prefix (form/two-forms (layout-relative-branch-ops :aarch64/cbnz-imm19 (fget bottom-test :body)
                                                                            (lone (intf (a64-register (fget bottom-test :test)))))
                                                (layout-label bottom-test-exit)))
                   (encode-selected isa frame-bytes return-suffix (fint bottom-test :return-index) false (fget bottom-test :return)))
             (lconj prefix (layout-relative-branch :aarch64/b-imm26 self-tail-body))))
         (= op :mc/instruction)
         (let [encoding (fkw instruction :mc/encoding) ename (keyword-name encoding)]
           (cond
             (or (and (truthy? bottom-test) (= instruction-index (fint bottom-test :return-index)))
                 (and (truthy? identity-hoist) (= instruction-index (fint identity-hoist :constant-index))))
             (lnone)
             (string=? ename "function-address")
             (let [label (form/form-get callee-labels (fget instruction :mir/function))]
               (if (form/is-nil? label)
                 (reject-list! :mc-encode :unknown-function-address-target instruction)
                 (lone (layout-relative-branch-ops :aarch64/adr-label label (lone (intf (a64-register (fget instruction :mir/dst))))))))
             (or (string=? ename "call") (string=? ename "tail-call"))
             (let [label (form/form-get callee-labels (fget instruction :mir/callee))]
               (cond (form/is-nil? label) (reject-list! :mc-encode :unknown-call-target instruction)
                     (string=? ename "tail-call") (lconj tail-suffix (layout-relative-branch :aarch64/b-imm26 label))
                     :else (lone (layout-relative-branch :aarch64/bl-imm26 label))))
             :else (encode-selected isa frame-bytes return-suffix instruction-index load-multiplier? instruction)))
         (= op :mc/branch-zero)
         (lone (layout-relative-branch-ops :aarch64/cbz-imm19 (fget instruction :mc/target)
                                           (lone (intf (a64-register (fget instruction :mc/test))))))
         (= op :mc/branch-nonzero)
         (let [bottom? (and (truthy? bottom-test) (= instruction-index (fint bottom-test :branch-index)))]
           (lone (layout-relative-branch-ops (if bottom? :aarch64/cbz-imm19 :aarch64/cbnz-imm19)
                                             (if bottom? bottom-test-exit (fget instruction :mc/target))
                                             (lone (intf (a64-register (fget instruction :mc/test)))))))
         (= op :mc/jump) (lone (layout-relative-branch :aarch64/b-imm26 (fget instruction :mc/target)))
         :else (reject-list! :mc-encode :unknown-operation instruction))))

(defn- it-walk [isa :keyword frame-bytes :i64 return-suffix [:list [:ref :form/r]] tail-suffix [:list [:ref :form/r]]
                   callee-labels [:ref :form/r] self-tail-prefix [:list [:ref :form/r]] self-tail-body [:ref :form/r]
                   bottom-test-exit [:ref :form/r] bottom-test [:ref :form/r] identity-hoist [:ref :form/r]
                   instructions [:list [:ref :form/r]] i :i64 cached [:ref :form/r] out [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (lcount instructions))
       out
       (let [instruction (lget instructions i)
             encoding (fget instruction :mc/encoding)
             magic (if (kw? encoding :aarch64/quotient-constant) (signed-division-magic (fint instruction :mir/divisor)) (vector-alloc 0))
             multiplier (if (> (vector-count magic) 0) (intf (vector-at magic 0)) (nf))
             load-multiplier? (not (feq multiplier cached))
             tokens (it-step isa frame-bytes return-suffix tail-suffix callee-labels self-tail-prefix self-tail-body
                             bottom-test-exit bottom-test identity-hoist i instruction load-multiplier?)
             next-multiplier (cond (truthy? multiplier) multiplier
                                   (and (fkw= instruction :mc/op :mc/instruction) (a64-x16-preserving? encoding)) cached
                                   :else (nf))]
         (it-walk isa frame-bytes return-suffix tail-suffix callee-labels self-tail-prefix self-tail-body bottom-test-exit
                  bottom-test identity-hoist instructions (inc i) next-multiplier (lcat out tokens)))))

(defn- instruction-tokens [isa :keyword frame-bytes :i64 return-suffix [:list [:ref :form/r]] tail-suffix [:list [:ref :form/r]]
                              callee-labels [:ref :form/r] identity-callees [:list [:ref :form/r]] self-tail-prefix [:list [:ref :form/r]]
                              self-tail-body [:ref :form/r] bottom-test-exit [:ref :form/r] input [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (not (= isa :aarch64))
       (reject-list! :mc-encode :x86-64-deferred (kf isa))
       (let [instructions (a64-fold-adjacent-add-sub-immediates (a64-fuse-multiplies (a64-cache-leaf-constants input)))
             bottom-test (a64-bottom-test-self-recur-plan instructions)
             identity-hoist (if (= 0 (lcount self-tail-prefix))
                              (a64-loop-invariant-identity-call-plan instructions bottom-test identity-callees)
                              (nf))]
         (it-walk isa frame-bytes return-suffix tail-suffix callee-labels self-tail-prefix self-tail-body bottom-test-exit
                  bottom-test identity-hoist instructions 0 (nf) (lnone)))))

(defn- qualify-function-locals [function-index :string tokens [:list [:ref :form/r]] protected [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [ids (distinct-forms (label-ids tokens))
           rename (loop [i 0 acc (lnone)] (if (>= i (lcount ids)) acc (recur (inc i) (if (lmember? protected (lget ids i)) acc (lconj acc (lget ids i))))))]
       (rename-labels tokens rename (string-concat "kotoba.native.local." function-index))))

(defn- call-frame-policy? [frame-policy [:ref :form/r]] :bool
     (or (kw? frame-policy :all-vregs) (kw? frame-policy :call-live)))

;; ── callee-saved registers ───────────────────────────────────────────────────
;;
;; The allocator's preserved tier is callee-saved by both ABIs, so a function
;; that names one of those registers owes its caller the original value back.
;; The frame pays exactly that debt: it saves the registers the body actually
;; names and no others, so a function small enough to stay in the scratch tier
;; carries no save at all.
;;
;; Which registers those are is derived from the instruction stream about to be
;; emitted rather than carried alongside it. A carried list has to be kept equal
;; to the body, and when it drifts it drifts toward omitting a save -- which is
;; a corrupted caller, observed far from here.

nil

(defn- a64-frame-reg-code [r [:ref :form/r]] :i64
     (if (form/is-int? r) (form/int-value r) (a64-register-code r)))

(defn- a64-stack-pair [opcode :i64 a [:ref :form/r] b [:ref :form/r]] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or opcode (if (truthy? b) (shl (a64-frame-reg-code b) 10) 0))
                    (bit-or (shl 31 5) (a64-frame-reg-code a)))))

(defn- a64-stack-pair-at [pair-op :i64 single-op :i64 offset :i64 a [:ref :form/r] b [:ref :form/r]] [:list [:ref :form/r]]
     (if (truthy? b)
       (u32le (bit-or (bit-or pair-op (shl (bit-and (quot offset 8) 0x7f) 15))
                      (bit-or (shl (a64-frame-reg-code b) 10) (bit-or (shl 31 5) (a64-frame-reg-code a)))))
       (u32le (bit-or (bit-or single-op (shl (quot offset 8) 10)) (bit-or (shl 31 5) (a64-frame-reg-code a))))))

(defn- save-pairs [saved [:list [:ref :form/r]] extra [:ref :form/r]] [:list [:ref :form/r]]
     (let [n (lcount saved)
           ps (loop [i 0 acc (lnone)] (if (>= i n) acc (recur (+ i 2) (lconj acc (form/vec2 (lget saved i) (lget saved (inc i)))))))]
       (if (truthy? extra) (lconj ps extra) ps)))

(defn- a64-saved-frame-small [pairs [:list [:ref :form/r]]] [:ref :form/r]
     (let [n (lcount pairs)
           save (loop [i 0 acc (lnone)]
                  (if (>= i n) acc
                    (let [p (lget pairs i) a (fnth p 0) b (fnth p 1)]
                      (recur (inc i) (lcat acc (if (truthy? b) (a64-stack-pair 0xa9bf0000 a b) (a64-stack-pair 0xf81f0c00 a (nf))))))))
           restore (loop [i (dec n) acc (lnone)]
                     (if (< i 0) acc
                       (let [p (lget pairs i) a (fnth p 0) b (fnth p 1)]
                         (recur (dec i) (lcat acc (if (truthy? b) (a64-stack-pair 0xa8c10000 a b) (a64-stack-pair 0xf8410400 a (nf))))))))]
       (map2 :save (fvec save) :restore (fvec restore))))

(defn- a64-saved-frame-save [pairs [:list [:ref :form/r]] area :i64] [:list [:ref :form/r]]
     (let [p0 (lget pairs 0) a0 (fnth p0 0) b0 (fnth p0 1)
           first-save (if (truthy? b0)
                        (a64-stack-pair-at 0xa9800000 0 (- 0 area) a0 b0)
                        (u32le (bit-or (bit-or 0xf8000c00 (shl (bit-and (- 0 area) 0x1ff) 12)) (bit-or (shl 31 5) (a64-frame-reg-code a0)))))]
       (loop [i 1 acc first-save]
         (if (>= i (lcount pairs)) acc
           (let [p (lget pairs i)]
             (recur (inc i) (lcat acc (a64-stack-pair-at 0xa9000000 0xf9000000 (* 16 i) (fnth p 0) (fnth p 1)))))))))

(defn- a64-saved-frame-restore [pairs [:list [:ref :form/r]] area :i64] [:list [:ref :form/r]]
     (let [p0 (lget pairs 0) a0 (fnth p0 0) b0 (fnth p0 1)
           last-restore (if (truthy? b0)
                          (a64-stack-pair-at 0xa8c00000 0 area a0 b0)
                          (u32le (bit-or (bit-or 0xf8400400 (shl (bit-and area 0x1ff) 12)) (bit-or (shl 31 5) (a64-frame-reg-code a0)))))]
       (loop [i (dec (lcount pairs)) acc (lnone)]
         (if (< i 1) (lcat acc last-restore)
           (let [p (lget pairs i)]
             (recur (dec i) (lcat acc (a64-stack-pair-at 0xa9400000 0xf9400000 (* 16 i) (fnth p 0) (fnth p 1)))))))))

(defn- a64-saved-frame [saved [:list [:ref :form/r]] extra-pair [:ref :form/r]] [:ref :form/r]
     (let [pairs (save-pairs saved extra-pair)
           area (* 16 (lcount pairs))]
       (if (<= (lcount pairs) 1)
         (a64-saved-frame-small pairs)
         (map2 :save (fvec (a64-saved-frame-save pairs area)) :restore (fvec (a64-saved-frame-restore pairs area))))))

(defn- a64-form-frame-pointer [offset :i64] [:list [:ref :form/r]]
     (u32le (bit-or 0x910003fd (shl (bit-and offset 0xfff) 10))))

(defn- mir-saved-registers [target :keyword instructions [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (kids (mir/saved-registers (kf target) (fvec instructions))))

(defn- function-frame [target :keyword frame-slots :i64 frame-policy [:ref :form/r] instructions [:list [:ref :form/r]]] [:ref :form/r]
     (if (not (= target :aarch64))
       (reject-form! :mc-encode :x86-64-deferred (kf target))
       (let [storage-bytes (align16 (* 8 frame-slots))
             saved (mir-saved-registers target instructions)
             call-frame? (call-frame-policy? frame-policy)
             frame (a64-saved-frame saved (if call-frame? (form/vec2 (intf 29) (intf 30)) (nf)))
             save (kids (fget frame :save)) restore (kids (fget frame :restore))
             fp-offset (* 16 (quot (+ (lcount saved) 1) 2))
             down (a64-adjust-stack 0xd10003ff storage-bytes)
             up (a64-adjust-stack 0x910003ff storage-bytes)
             ret (u32le 0xd65f03c0)]
         (fassoc (map4 :frame-bytes (intf storage-bytes)
                       :saved-registers (fvec saved)
                       :prologue (fvec (if call-frame? (cat3 save (a64-form-frame-pointer fp-offset) down) (lcat save down)))
                       :tail-suffix (fvec (lcat up restore)))
                 :return-suffix (fvec (cat3 up restore ret))))))

nil

(defn- a64-call-like? [encoding [:ref :form/r]] :bool
     (or (kw? encoding :aarch64/call) (kw? encoding :aarch64/tail-call) (kw? encoding :aarch64/runtime-call)
         (kw? encoding :aarch64/capability-call)))

(defn- simd-park-admissible? [instructions [:list [:ref :form/r]]] :bool
     (let [n (lcount instructions)]
       (loop [i 0]
         (if (>= i n) true
           (let [ins (lget instructions i) enc (fget ins :mc/encoding) slot (fget ins :mir/slot)]
             (cond (a64-call-like? enc) false
                   (and (or (kw? enc :aarch64/spill-store) (kw? enc :aarch64/spill-load))
                        (not (and (form/is-int? slot) (<= 0 (form/int-value slot)) (<= (form/int-value slot) 15)))) false
                   :else (recur (inc i))))))))

(defn- a64-simd-park-spills [function [:ref :form/r]] [:ref :form/r]
     (let [frame-slots (fint function :mc/frame-slots)
           instructions (kids (fget function :mc/instructions))]
       (if (not (and (> frame-slots 0) (<= frame-slots 16)
                     (not (call-frame-policy? (fget function :mc/frame-policy)))
                     (simd-park-admissible? instructions)))
         function
         (fassoc (fassoc function :mc/frame-slots (intf 0))
                 :mc/instructions
                 (fvec (loop [i 0 acc (lnone)]
                         (if (>= i (lcount instructions)) acc
                           (let [ins (lget instructions i) enc (fget ins :mc/encoding)]
                             (recur (inc i)
                                    (lconj acc (cond (kw? enc :aarch64/spill-store) (fassoc ins :mc/encoding (kf :aarch64/simd-park-store))
                                                     (kw? enc :aarch64/spill-load) (fassoc ins :mc/encoding (kf :aarch64/simd-park-load))
                                                     :else ins)))))))))))

(defn- fresh-self-tail-body-label [function-index :string prefix [:list [:ref :form/r]] instructions [:list [:ref :form/r]]] [:ref :form/r]
     (let [occupied (label-ids (lcat prefix instructions))]
       (loop [attempt 0]
         (let [candidate (kf (keyword-from-string (string-concat "kotoba.native.internal.self-tail/"
                                                                 (string-concat function-index (string-concat "." (string-from-i64 attempt))))))]
           (if (lmember? occupied candidate) (recur (inc attempt)) candidate)))))

;; ── stack-passed arguments ──────────────────────────────────────────────────
;;
;; Arguments past the fifth travel on the stack (kotoba-mir
;; `stack-argument-rewrite`). A caller stores argument i at [sp + 8(i - 5)] --
;; the bottom of its own frame, which is why a function making such a call
;; moves its spill slots up by the number of stack arguments it passes. The
;; callee finds them above everything it pushed:
;;
;;   x86-64   frame-bytes + 8 * saved + odd-count pad + 8 (return address)
;;   AArch64  frame-bytes + the save area (16 per pair, fp/lr included)
;;
;; A function with none of these instructions is untouched: same slots, same
;; frame, same bytes.

(defn- stack-argument-op? [instruction [:ref :form/r] op :string] :bool
     (let [e (fget instruction :mc/encoding)] (and (form/is-keyword? e) (string=? (keyword-name (form/keyword-value e)) op))))

(defn- stack-argument-frame [function [:ref :form/r]] [:ref :form/r]
     (let [instructions (kids (fget function :mc/instructions))
           n (lcount instructions)
           reserve (loop [i 0 r 0]
                     (if (>= i n) r
                       (let [ins (lget instructions i)]
                         (recur (inc i) (if (stack-argument-op? ins "outgoing-argument") (max r (- (fint ins :mir/index) 4)) r)))))]
       (if (= reserve 0)
         function
         (let [slots (fget function :mc/frame-slots)]
           (fassoc (fassoc function :mc/frame-slots (intf (+ (if (truthy? slots) (form/int-value slots) 0) reserve)))
                   :mc/instructions (fvec (shift-slots instructions reserve)))))))

(defn- shift-slots [instructions [:list [:ref :form/r]] reserve :i64] [:list [:ref :form/r]]
     (let [n (lcount instructions)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) acc
           (let [ins (lget instructions i)]
             (recur (inc i) (lconj acc (if (fhas? ins :mir/slot) (fassoc ins :mir/slot (intf (+ (fint ins :mir/slot) reserve))) ins))))))))

(defn- incoming-argument-base [frame-bytes :i64 saved [:list [:ref :form/r]] frame-policy [:ref :form/r]] :i64
     (+ (+ frame-bytes (* 16 (quot (+ (lcount saved) 1) 2))) (if (call-frame-policy? frame-policy) 16 0)))

(defn- resolve-stack-argument-offsets [frame-bytes :i64 saved [:list [:ref :form/r]] frame-policy [:ref :form/r]
                                          instructions [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [base (incoming-argument-base frame-bytes saved frame-policy) n (lcount instructions)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) acc
           (let [ins (lget instructions i)]
             (recur (inc i)
                    (lconj acc (cond (stack-argument-op? ins "outgoing-argument")
                                     (fassoc ins :mir/displacement (intf (* 8 (- (fint ins :mir/index) 5))))
                                     (or (stack-argument-op? ins "incoming-load") (stack-argument-op? ins "incoming-argument-store"))
                                     (fassoc ins :mir/displacement (intf (+ base (* 8 (- (fint ins :mir/index) 5)))))
                                     :else ins))))))))

(defn- counted-bulk-entry-charge-tokens [counter :i64 fallback [:ref :form/r]] [:list [:ref :form/r]]
     (let [enough (kf :kotoba.native.bulk-fuel/entry-enough)]
       (lcat (cat4 (u32le (bit-or 0xeb1f001f (shl counter 5)))
                   (lone (layout-relative-branch :aarch64/b-lt-imm19 fallback))
                   (u32le (bit-or 0x91000410 (shl counter 5)))
                   (lcat (u32le 0xf94004f1) (u32le 0xeb10023f)))
             (cat4 (lone (layout-relative-branch :aarch64/b-hs-imm19 enough))
                   (lcat (u32le 0xf90004ff) (u32le 0xd4200000))
                   (lone (layout-label enough))
                   (lcat (u32le 0xcb100231) (u32le 0xf90004f1))))))

(defn- prefix-tokens [spec [:ref :form/r] fallback-label [:ref :form/r]] [:list [:ref :form/r]]
     (if (and (form/is-map? spec) (fhas? spec :counted-bulk-counter))
       (counted-bulk-entry-charge-tokens (fint spec :counted-bulk-counter) fallback-label)
       (kids spec)))

(defn- function-index-text [i :i64 suffix :string] :string (string-concat (string-from-i64 i) suffix))

(defn- fallback-tokens [target :keyword index :i64 fp [:list [:ref :form/r]] fallback-label [:ref :form/r]
                           prologue [:list [:ref :form/r]] frame-bytes :i64 return-suffix [:list [:ref :form/r]]
                           tail-suffix [:list [:ref :form/r]] callee-labels [:ref :form/r] identity-callees [:list [:ref :form/r]]
                           instructions [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [fallback-body (fresh-self-tail-body-label (function-index-text index ".fallback") fp instructions)
           fallback-exit (fresh-self-tail-body-label (function-index-text index ".fallback-exit") (lconj fp (layout-label fallback-body)) instructions)
           body (instruction-tokens target frame-bytes return-suffix tail-suffix callee-labels identity-callees
                                    fp fallback-body fallback-exit instructions)]
       (qualify-function-locals (function-index-text index ".fallback")
                                (cat4 (lone (layout-label fallback-label)) fp prologue body)
                                (form/three-forms fallback-label fallback-body fallback-exit))))

(defn- primary-tokens [target :keyword index :i64 prefix [:list [:ref :form/r]] self-tail-prefix [:list [:ref :form/r]]
                          protected-extra [:ref :form/r] prologue [:list [:ref :form/r]] frame-bytes :i64 return-suffix [:list [:ref :form/r]]
                          tail-suffix [:list [:ref :form/r]] callee-labels [:ref :form/r] identity-callees [:list [:ref :form/r]]
                          instructions [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [self-tail-body (fresh-self-tail-body-label (function-index-text index ".bulk") prefix instructions)
           bottom-test-exit (fresh-self-tail-body-label (function-index-text index ".bulk-exit") (lconj prefix (layout-label self-tail-body)) instructions)
           body (instruction-tokens target frame-bytes return-suffix tail-suffix callee-labels identity-callees
                                    self-tail-prefix self-tail-body bottom-test-exit instructions)]
       (qualify-function-locals (function-index-text index ".bulk")
                                (cat3 prefix prologue body)
                                (if (truthy? protected-extra)
                                  (form/three-forms self-tail-body bottom-test-exit protected-extra)
                                  (form/two-forms self-tail-body bottom-test-exit)))))

(defn- framed-tokens [target :keyword index :i64 function [:ref :form/r] frame [:ref :form/r] prefixes [:ref :form/r]
                         callee-labels [:ref :form/r] identity-callees [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [name (fget function :mc/name)
           frame-policy (fget function :mc/frame-policy)
           frame-bytes (fint frame :frame-bytes)
           prologue (kids (fget frame :prologue))
           return-suffix (kids (fget frame :return-suffix))
           tail-suffix (kids (fget frame :tail-suffix))
           instructions (resolve-stack-argument-offsets frame-bytes (kids (fget frame :saved-registers)) frame-policy
                                                        (kids (fget function :mc/instructions)))
           found (form/form-get prefixes name)
           instrumentation (if (form/is-nil? found) (fvec (lnone)) found)
           map? (form/is-map? instrumentation)
           fallback-prefix (if map? (fget instrumentation :fallback) (nf))
           fallback? (truthy? fallback-prefix)
           fallback-label (if fallback? (fresh-self-tail-body-label (function-index-text index ".fallback-entry") (kids fallback-prefix) instructions) (nf))
           entry (if map? (fget instrumentation :entry) (nf))
           prefix (prefix-tokens (if map? (if (form/is-nil? entry) (fvec (lnone)) entry) instrumentation) fallback-label)
           self-tail-prefix (if (and map? (fhas? instrumentation :recur)) (kids (fget instrumentation :recur)) prefix)
           primary (primary-tokens target index prefix self-tail-prefix fallback-label prologue frame-bytes return-suffix tail-suffix
                                   callee-labels identity-callees instructions)
           fallback (if fallback?
                      (fallback-tokens target index (kids fallback-prefix) fallback-label prologue frame-bytes return-suffix tail-suffix
                                       callee-labels identity-callees instructions)
                      (lnone))]
       (cat3 (lone (layout-label (form/form-get callee-labels name))) primary fallback)))

(defn- module-function-tokens [target :keyword index :i64 function0 [:ref :form/r] prefixes [:ref :form/r]
                                  callee-labels [:ref :form/r] identity-callees [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [function (stack-argument-frame (a64-simd-park-spills function0))
           frame-slots (let [s (fget function :mc/frame-slots)] (if (truthy? s) (form/int-value s) 0))
           frame (function-frame target frame-slots (fget function :mc/frame-policy) (kids (fget function :mc/instructions)))]
       (framed-tokens target index function frame prefixes callee-labels identity-callees)))

(defn- module-tokens [target :keyword functions [:list [:ref :form/r]] i :i64 prefixes [:ref :form/r] callee-labels [:ref :form/r]
                         identity-callees [:list [:ref :form/r]] out [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (lcount functions)) out
       (module-tokens target functions (inc i) prefixes callee-labels identity-callees
                      (lcat out (module-function-tokens target i (lget functions i) prefixes callee-labels identity-callees)))))

(defn- callee-label-map [functions [:list [:ref :form/r]]] [:ref :form/r]
     (let [n (lcount functions)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) (fmap acc)
           (recur (inc i) (lconj (lconj acc (fget (lget functions i) :mc/name))
                                 (kf (keyword-from-string (string-concat "kotoba.native.function/" (string-from-i64 i))))))))))

(defn- identity-callee-names [functions [:list [:ref :form/r]] prefixes [:ref :form/r]] [:list [:ref :form/r]]
     (let [n (lcount functions)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) acc
           (let [f (lget functions i) name (fget f :mc/name) p (form/form-get prefixes name)]
             (recur (inc i) (if (and (a64-identity-callee? f) (or (form/is-nil? p) (= 0 (fcount p)))) (lconj acc name) acc)))))))

(defn- function-offsets [functions [:list [:ref :form/r]] labels [:ref :form/r] callee-labels [:ref :form/r]] :vector-i64
     (let [n (lcount functions)]
       (loop [i 0 acc (vector-alloc 0)]
         (if (>= i n) acc
           (recur (inc i) (vector-conj acc (form/int-value (form/form-get labels (form/form-get callee-labels (fget (lget functions i) :mc/name))))))))))

(defn- name-index [functions [:list [:ref :form/r]] name [:ref :form/r]] :i64
     (let [n (lcount functions)]
       (loop [i 0] (if (>= i n) -1 (if (feq (fget (lget functions i) :mc/name) name) i (recur (inc i)))))))

(defn- exports-map [functions [:list [:ref :form/r]] exports [:list [:ref :form/r]] offsets :vector-i64 code-size :i64] [:ref :form/r]
     (let [n (lcount exports) m (vector-count offsets)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) (fmap acc)
           (let [name (lget exports i)
                 index (name-index functions name)
                 offset (vector-at offsets index)
                 end (if (< (inc index) m) (vector-at offsets (inc index)) code-size)]
             (recur (inc i) (lconj (lconj acc name)
                                   (map3 :offset (intf offset) :length (intf (- end offset))
                                         :arity (fget (lget functions index) :mc/arity)))))))))

(defn- valid-exports? [exports [:ref :form/r] functions [:list [:ref :form/r]]] :bool
     (and (form/is-vec? exports) (> (fcount exports) 0)
          (all-distinct? (kids exports))
          (let [xs (kids exports) n (lcount xs)]
            (loop [i 0] (if (>= i n) true (if (>= (name-index functions (lget xs i)) 0) (recur (inc i)) false))))))

(defn encode-mc-module [program [:ref :form/r] prefixes [:ref :form/r] exports [:ref :form/r]] [:ref :form/r]
     (let [target (fkw program :mc/target)
           functions (kids (fget program :mc/functions))]
       (cond
         (not (mc-valid? program)) (reject-form! :mc :invalid-program program)
         (not (form/eq (fget program :mc/version) (intf 3))) (reject-form! :mc-encode :module-version-required program)
         (not (valid-exports? exports functions)) (reject-form! :mc-encode :invalid-module-exports exports)
         :else
         (let [callee-labels (callee-label-map functions)
               identity-callees (if (= target :aarch64) (identity-callee-names functions prefixes) (lnone))
               tokens (module-tokens target functions 0 prefixes callee-labels identity-callees (lnone))
               layout (resolve-program-layout tokens)
               offsets (function-offsets functions (fget layout :labels) callee-labels)]
           (map2 :code (fget layout :code)
                 :exports (exports-map functions (kids exports) offsets (fint layout :code-size)))))))

(defn encode-mc [program [:ref :form/r]] [:ref :form/r]
     (let [target (fkw program :mc/target)
           instructions (kids (fget program :mc/instructions))
           n (lcount instructions)
           host-call? (loop [i 0]
                        (if (>= i n) false
                          (let [e (fget (lget instructions i) :mc/encoding)]
                            (if (and (form/is-keyword? e)
                                     (let [nm (keyword-name (form/keyword-value e))] (or (string=? nm "runtime-call") (string=? nm "capability-call"))))
                              true (recur (inc i))))))]
       (cond
         (not (mc-valid? program)) (reject-form! :mc :invalid-program program)
         (not (form/eq (fget program :mc/version) (intf 2))) (reject-form! :mc-encode :flat-program-version-required program)
         :else
         (let [frame (function-frame target (fint program :mc/frame-slots) (kf (if host-call? :call-live :allocator)) instructions)]
           (fget (resolve-program-layout
                  (lcat (kids (fget frame :prologue))
                        (instruction-tokens target (fint frame :frame-bytes) (kids (fget frame :return-suffix)) (kids (fget frame :tail-suffix))
                                            (fmap (lnone)) (lnone) (lnone) (nf) (nf) instructions)))
                 :code)))))

nil

(defn function-reenters-guest? [instructions [:ref :form/r]] :bool
     (let [xs (kids instructions) n (lcount xs)]
       (loop [i 0]
         (if (>= i n) false
           (let [op (fget (lget xs i) :gmir/op)
                 runtime (fget (lget xs i) :gmir/runtime)]
             ;; the per-constructor fuel debit and the consensus gas debit are
             ;; charges, not re-entry (as on the host)
             (if (and (or (kw? op :gmir/call) (kw? op :gmir/tail-call) (kw? op :gmir/runtime-call) (kw? op :gmir/capability-call))
                      (not (or (kw? runtime :fuel-charge) (kw? runtime :gas-charge))))
               true (recur (inc i))))))))

nil

(defn- charged-constructor? [h [:ref :form/r]] :bool
     (or (sym? h "pair") (sym? h "kgraph-assert!") (sym? h "map-new") (sym? h "map-assoc")
         (sym? h "option-some") (sym? h "result-ok") (sym? h "result-err") (sym? h "result-ok-of")
         (sym? h "result-err-of") (sym? h "variant-new") (sym? h "option-some-of")
         (sym? h "option-none-of") (sym? h "hetero-vector-new") (sym? h "hetero-vector-assoc")
         (sym? h "typed-list-new") (sym? h "typed-list-conj") (sym? h "typed-set-new")
         (sym? h "typed-set-conj") (sym? h "typed-set-disj") (sym? h "typed-map-new")
         (sym? h "typed-map-assoc") (sym? h "typed-map-dissoc") (sym? h "record-new")
         (sym? h "record-assoc") (sym? h "vector-new") (sym? h "vector-conj")
         (sym? h "vector-assoc") (sym? h "vector-assoc!") (sym? h "bytes-slice")
         (sym? h "bytes-concat") (sym? h "bytes-from-vector-i64") (sym? h "vector-i64-from-bytes")
         (sym? h "vector-alloc") (sym? h "vector-drop") (sym? h "vector-take")
         (sym? h "vector-f64-new") (sym? h "vector-f64-conj") (sym? h "vector-f64-assoc")
         (sym? h "vector-f64-drop") (sym? h "vector-f64-take") (sym? h "string-index-new")
         (sym? h "string-index-assoc") (sym? h "disjoint-set-i64-new")
         (sym? h "disjoint-set-i64-union") (sym? h "document-vector") (sym? h "document-list")
         (sym? h "document-set") (sym? h "document-map")))

(defn- charge-kids [xs [:list [:ref :form/r]] mode :i64 schedule [:ref :form/r] names [:ref :form/r]] [:list [:ref :form/r]]
     (let [n (lcount xs)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) acc (recur (inc i) (lconj acc (charge-walk (lget xs i) mode schedule names)))))))

(defn- gas-weight [op [:ref :form/r] schedule [:ref :form/r] names [:ref :form/r]] :i64
     (if (fmember? names op)
       (form/int-value (fget schedule :call))
       (let [w (form/form-get (fget schedule :weights) op)]
         (if (form/is-int? w) (form/int-value w) (form/int-value (fget schedule :default))))))

(defn- charge-walk [f [:ref :form/r] mode :i64 schedule [:ref :form/r] names [:ref :form/r]] [:ref :form/r]
     (cond
       (form/is-seq? f)
       (let [c (lst (charge-kids (kids f) mode schedule names))
             head (if (> (fcount c) 0) (fnth c 0) (nf))]
         (if (= mode 0)
           (if (charged-constructor? head) (form/call2 "do" (form/call0 "fuel-charge!") c) c)
           (let [w (gas-weight head schedule names)]
             (if (> w 0) (form/call2 "do" (form/call1 "gas-charge!" (intf w)) c) c))))
       (form/is-vec? f) (fvec (charge-kids (kids f) mode schedule names))
       (form/is-map? f) (fmap (charge-kids (kids f) mode schedule names))
       :else f))

(defn- charge-functions [fs [:list [:ref :form/r]] mode :i64 schedule [:ref :form/r] names [:ref :form/r]] [:ref :form/r]
     (let [n (lcount fs)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) (fvec acc)
           (let [fn-form (lget fs i)]
             (recur (inc i) (lconj acc (fassoc fn-form :body (charge-walk (fget fn-form :body) mode schedule names)))))))))

(defn- function-name-forms [fs [:list [:ref :form/r]]] [:ref :form/r]
     (let [n (lcount fs)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) (fvec acc) (recur (inc i) (lconj acc (fget (lget fs i) :name)))))))

(defn- pos-int-form? [x [:ref :form/r]] :bool (and (form/is-int? x) (> (form/int-value x) 0)))

(defn- gas-weights-ok? [w [:ref :form/r]] :bool
     (let [xs (kids w) n (lcount xs)]
       (loop [j 0]
         (if (>= (+ j 1) n) true
           (let [k (lget xs j) v (lget xs (+ j 1))]
             (if (and (form/is-symbol? k) (form/is-int? v) (>= (form/int-value v) 0))
               (recur (+ j 2))
               false))))))

nil

(defn charge-constructors [kir [:ref :form/r]] [:ref :form/r]
     (fassoc kir :functions (charge-functions (kids (fget kir :functions)) 0 (nf) (nf))))

(defn- valid-gas-schedule? [s [:ref :form/r]] :bool
     (and (form/is-map? s)
          (form/is-keyword? (fget s :gas-schedule/id))
          (pos-int-form? (fget s :default))
          (pos-int-form? (fget s :call))
          (form/is-map? (fget s :weights))
          (gas-weights-ok? (fget s :weights))))

(defn charge-gas [kir [:ref :form/r]] [:ref :form/r]
     (let [schedule (fget kir :gas-schedule)]
       (if (not (truthy? schedule))
         kir
         (if (not (valid-gas-schedule? schedule))
           (throw (ex-info "gas schedule refused" {:phase :native :reason :gas-schedule}))
           (let [fs (kids (fget kir :functions))]
             (fassoc (form/dissoc-form kir (kf :gas-schedule)) :functions
                     (charge-functions fs 1 schedule (function-name-forms fs))))))))

(defn entry-fuel-prefixes-of-gmir [module [:ref :form/r] tokens [:ref :form/r]] [:ref :form/r]
     (let [fs (kids (fget module :gmir/functions)) n (lcount fs)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) (fmap acc)
           (let [f (lget fs i)]
             (recur (inc i) (if (function-reenters-guest? (fget f :gmir/instructions))
                              (lconj (lconj acc (fget f :gmir/name)) tokens)
                              acc)))))))

(defn entry-fuel-prefixes [kir [:ref :form/r] tokens [:ref :form/r]] [:ref :form/r]
     (entry-fuel-prefixes-of-gmir (lower-kir-module kir) tokens))

(defn counted-self-recur-plans-of-gmir [target :keyword module [:ref :form/r]] [:ref :form/r]
     (let [r (mir/counted-self-recur-plans-result (mir-select-target target module))]
       (if (fhas? r :problem) (reject-form! :mir (fkw r :problem) module) (fget r :plans))))

(defn counted-self-recur-plans [target :keyword kir [:ref :form/r]] [:ref :form/r]
     (counted-self-recur-plans-of-gmir target (lower-kir-module kir)))

(defn compile-kir-module [target :keyword kir [:ref :form/r] prefixes [:ref :form/r]] [:ref :form/r]
     (let [mc (compile-gmir target (lower-kir-module kir))]
       (encode-mc-module mc prefixes (fget kir :exports))))

(defn compile-expression [target :keyword params [:ref :form/r] body [:ref :form/r]] [:ref :form/r]
     (encode-mc (compile-gmir target (lower-kir-expression params body (fmap (lnone))))))
