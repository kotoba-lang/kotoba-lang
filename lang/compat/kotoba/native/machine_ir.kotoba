(ns kotoba.native.machine-ir
  "Closed production contract for GMIR -> target MIR -> allocated MC data.

  Production native emission crosses this namespace exclusively. Admitted KIR
  lowers through closed GMIR/MIR/MC data; unknown operations, unsupported value
  shapes, use-before-definition, register exhaustion, and malformed labels fail
  closed before either ISA encoder."
  {:kotoba/export [charge-constructors charge-gas coalesce-program-moves compile-expression compile-gmir compile-kir-module counted-self-recur-plans counted-self-recur-plans-of-gmir encode-mc encode-mc-module entry-fuel-prefixes entry-fuel-prefixes-of-gmir function-reenters-guest? hoist-program-consumers lower-kir-expression lower-kir-module lower-mc pilot-module? signed-division-magic word-result-type?]}
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :form/rd [:record :form/rd [[:form [:ref :form/r]] [:pos :i64]]]
                                 :mi/lv [:record :mi/lv [[:code [:list [:ref :form/r]]] [:value [:ref :form/r]]
                                                         [:reg :i64] [:label :i64]]]})
  (:require [kotoba.form :as form]
            [kotoba.bytes :as kbytes] [kotoba.lang.text :as str]
            [kotoba.lang.coll :as walk]
            [kotoba.gmir :as gmir]
            [kotoba.mir :as mir]
            [kotoba.codegen.mc :as mc]
            [kotoba.codegen.layout :as layout]
            [kotoba.native.aggregate-abi :as aggregate-abi]
            [kotoba.native.image-scratch :as image-scratch]
            [kotoba.native.interrupt-abi :as interrupt-abi]
            [kotoba.native.document :as document]
            [kotoba.native.string-index :as string-index]
            ;; host only: kotoba.native.typed-map has no Kotoba-route twin yet
            
            [kotoba.native.string-search :as string-search]
            ))

(defn- kf [k :keyword] [:ref :form/r] (form/keyword-form k))

(defn- nf [] [:ref :form/r] (form/nil-form))

(defn- intf [n :i64] [:ref :form/r] (form/int-form n))

(defn- kslot [m [:ref :form/r] k :keyword] :i64
     (let [xs (form/kids-of m) n (vector-count xs)]
       (loop [j 0]
         (if (>= (+ j 1) n) -1
           (let [x (typed-list-nth [:list [:ref :form/r]] xs j)]
             (if (and (form/is-keyword? x) (= (form/keyword-value x) k)) j (recur (+ j 2))))))))

(defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r]
     (let [j (kslot m k)] (if (< j 0) (form/nil-form) (typed-list-nth [:list [:ref :form/r]] (form/kids-of m) (+ j 1)))))

(defn- fhas? [m [:ref :form/r] k :keyword] :bool (>= (kslot m k) 0))

(defn- fval-at [m [:ref :form/r] j :i64] [:ref :form/r] (typed-list-nth [:list [:ref :form/r]] (form/kids-of m) (+ j 1)))

(defn- ftruthy? [m [:ref :form/r] k :keyword] :bool
     (let [j (kslot m k)]
       (and (>= j 0)
            (let [v (fval-at m j)] (not (or (form/is-nil? v) (and (form/is-bool? v) (not (form/bool-value v)))))))))

(defn- fkw= [m [:ref :form/r] k :keyword kw :keyword] :bool
     (let [j (kslot m k)]
       (and (>= j 0) (let [v (fval-at m j)] (and (form/is-keyword? v) (= (form/keyword-value v) kw))))))

(defn- fassoc [m [:ref :form/r] k :keyword v [:ref :form/r]] [:ref :form/r]
     (form/assoc-form m (form/keyword-form k) v))

(defn- kw-of [f [:ref :form/r]] :keyword (if (form/is-keyword? f) (form/keyword-value f) :none))

(defn- fkw [m [:ref :form/r] k :keyword] :keyword
     (let [j (kslot m k)] (if (< j 0) :none (kw-of (fval-at m j)))))

(defn- fint [m [:ref :form/r] k :keyword] :i64 (form/int-value (fget m k)))

(defn- kw? [f [:ref :form/r] k :keyword] :bool (and (form/is-keyword? f) (= (form/keyword-value f) k)))

(defn- truthy? [f [:ref :form/r]] :bool
     (not (or (form/is-nil? f) (and (form/is-bool? f) (not (form/bool-value f))))))

(defn- feq [a [:ref :form/r] b [:ref :form/r]] :bool (form/eq a b))

(defn- kids [f [:ref :form/r]] [:list [:ref :form/r]] (form/kids-of f))

(defn- lcount [xs [:list [:ref :form/r]]] :i64 (vector-count xs))

(defn- lget [xs [:list [:ref :form/r]] i :i64] [:ref :form/r]
     (if (and (>= i 0) (< i (vector-count xs))) (typed-list-nth [:list [:ref :form/r]] xs i) (form/nil-form)))

(defn- lconj [xs [:list [:ref :form/r]] x [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-conj [:list [:ref :form/r]] xs x))

(defn- lnone [] [:list [:ref :form/r]] (form/no-forms))

(defn- lone [x [:ref :form/r]] [:list [:ref :form/r]] (form/one-form x))

(defn- lcat [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] [:list [:ref :form/r]] (form/append-many xs ys))

(defn- lslice [xs [:list [:ref :form/r]] from :i64 to :i64] [:list [:ref :form/r]]
     (loop [i from acc (form/no-forms)]
       (if (>= i to) acc (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs i))))))

(defn- ldrop [xs [:list [:ref :form/r]] from :i64] [:list [:ref :form/r]]
     (lslice xs from (vector-count xs)))

(defn- lmember? [xs [:list [:ref :form/r]] x [:ref :form/r]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n) false
           (if (form/eq (typed-list-nth [:list [:ref :form/r]] xs i) x) true (recur (inc i)))))))

(defn- lreverse [xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (loop [i (dec (vector-count xs)) acc (form/no-forms)]
       (if (< i 0) acc (recur (dec i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs i))))))

(defn- fvec [xs [:list [:ref :form/r]]] [:ref :form/r] (form/form-vec xs))

(defn- fmap [xs [:list [:ref :form/r]]] [:ref :form/r] (form/form-map xs))

(defn- fset [xs [:list [:ref :form/r]]] [:ref :form/r] (form/form-set xs))

(defn- map2 [k1 :keyword v1 [:ref :form/r] k2 :keyword v2 [:ref :form/r]] [:ref :form/r]
     (form/form-map (typed-list-conj [:list [:ref :form/r]] (form/three-forms (kf k1) v1 (kf k2)) v2)))

(defn- map3 [k1 :keyword v1 [:ref :form/r] k2 :keyword v2 [:ref :form/r] k3 :keyword v3 [:ref :form/r]] [:ref :form/r]
     (fassoc (map2 k1 v1 k2 v2) k3 v3))

(defn- map4 [k1 :keyword v1 [:ref :form/r] k2 :keyword v2 [:ref :form/r] k3 :keyword v3 [:ref :form/r]
                k4 :keyword v4 [:ref :form/r]] [:ref :form/r]
     (fassoc (map3 k1 v1 k2 v2 k3 v3) k4 v4))

(defn- fmember? [coll [:ref :form/r] x [:ref :form/r]] :bool (lmember? (form/kids-of coll) x))

(defn- keyword-ns-name [ns :string k :keyword] :keyword
     (keyword-from-string (string-concat ns (string-concat "/" (keyword-name k)))))

(defn- ushr [x :i64 n :i64] :i64 (if (= n 0) x (u64-shift-right x n)))

(defn- reject! [phase :keyword problem :keyword instruction [:ref :form/r]] :i64
     ;; The host's ex-data carries the offending instruction; the twin, phase and problem.
     (throw (ex-info (string-concat "machine IR rejected: " (keyword-name problem))
                     {:phase phase :problem problem})))

(defn- reject-form! [phase :keyword problem :keyword instruction [:ref :form/r]] [:ref :form/r]
     (do (reject! phase problem instruction) (form/nil-form)))

(defn- trap! [] :i64 (vector-at (vector-i64) 0))

(defn- mir-valid? [p [:ref :form/r]] :bool
     (try (do (mir/validate! p) true) (catch e false)))

(defn- mc-valid? [p [:ref :form/r]] :bool
     (try (do (mc/validate! p) true) (catch e false)))

(defn- reject-list! [phase :keyword problem :keyword instruction [:ref :form/r]] [:list [:ref :form/r]]
     (do (reject! phase problem instruction) (form/no-forms)))

(defn- a64-op [instruction [:ref :form/r]] :keyword
     (let [e (fget instruction :mc/encoding)]
       (if (truthy? e) (kw-of e) (fkw instruction :mir/op))))

(defn- a64-fused-multiply [multiply [:ref :form/r] consumer [:ref :form/r]] [:ref :form/r]
     (let [product (fget multiply :mir/dst)
           consumer-op (a64-op consumer)
           add? (or (= consumer-op :mir/add) (= consumer-op :aarch64/add))
           sub? (or (= consumer-op :mir/subtract) (= consumer-op :aarch64/subtract))
           addend (cond
                    (and add? (feq product (fget consumer :mir/left))) (fget consumer :mir/right)
                    (and add? (feq product (fget consumer :mir/right))) (fget consumer :mir/left)
                    (and sub? (feq product (fget consumer :mir/right))) (fget consumer :mir/left)
                    :else (nf))]
       (if (and (truthy? addend) (not (feq product addend)))
         (let [fused (map4 :mir/dst (fget consumer :mir/dst)
                           :mir/left (fget multiply :mir/left)
                           :mir/right (fget multiply :mir/right)
                           :mir/addend addend)]
           (if (ftruthy? multiply :mc/encoding)
             (fassoc (fassoc fused :mc/op (kf :mc/instruction))
                     :mc/encoding (kf (if sub? :aarch64/multiply-subtract :aarch64/multiply-add)))
             (fassoc fused :mir/op (kf (if sub? :mir/multiply-subtract :mir/multiply-add)))))
         (nf))))

nil

(defn- a64-product-use-count [instructions [:list [:ref :form/r]] after :i64 product [:ref :form/r]] :i64
     (let [n (lcount instructions)]
       (loop [i after uses 0]
         (if (>= i n)
           uses
           (let [instruction (lget instructions i)
                 used? (lmember? (a64-source-registers-mir instruction) product)
                 killed? (feq product (fget instruction :mir/dst))]
             (cond
               (and used? killed?) (inc uses)
               killed? uses
               used? (recur (inc i) (inc uses))
               :else (recur (inc i) uses)))))))

(defn- a64-constant-op? [op :keyword] :bool (or (= op :mir/constant) (= op :aarch64/constant)))

(defn- a64-clobbers-any? [between [:list [:ref :form/r]] protected [:list [:ref :form/r]]] :bool
     (let [n (lcount between)]
       (loop [i 0]
         (if (>= i n) false
           (if (lmember? protected (fget (lget between i) :mir/dst)) true (recur (inc i)))))))

(defn- a64-fuse-multiplies [instructions [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount instructions)]
       (loop [index 0 out (lnone)]
         (if (>= index n)
           out
           (let [multiply (lget instructions index)
                 op (a64-op multiply)]
             (if (or (= op :mir/multiply) (= op :aarch64/multiply))
               (let [after (inc index)
                     consumer-index (loop [candidate after]
                                      (if (a64-constant-op? (a64-op (lget instructions candidate)))
                                        (recur (inc candidate))
                                        candidate))
                     between (lslice instructions after (if (< consumer-index n) consumer-index n))
                     protected (form/three-forms (fget multiply :mir/dst) (fget multiply :mir/left)
                                                 (fget multiply :mir/right))
                     unclobbered? (not (a64-clobbers-any? between protected))
                     product (fget multiply :mir/dst)
                     unique-use? (= 1 (a64-product-use-count instructions after product))
                     fused (if (and unclobbered? unique-use?)
                             (a64-fused-multiply multiply (lget instructions consumer-index))
                             (nf))]
                 (if (truthy? fused)
                   (recur (inc consumer-index) (lconj (lcat out between) fused))
                   (recur (inc index) (lconj out multiply))))
               (recur (inc index) (lconj out multiply))))))))

nil

(defn- a64-direct-result-op? [op :keyword] :bool
     (case op (:mir/constant :mir/add :mir/subtract :mir/multiply :mir/multiply-add :mir/multiply-subtract
               :mir/quotient-constant :mir/bit-and :mir/bit-or :mir/bit-xor :mir/shift-left :mir/shift-right-signed
               :mir/shift-right-unsigned :mir/equal :mir/less-than :mir/greater-than :mir/less-or-equal
               :mir/greater-or-equal) true false))

(defn- mir-source-key? [k :keyword which :i64] :bool
     (case k
       (:mir/test :mir/value :mir/src :mir/input :mir/left :mir/right :mir/addend :mir/base :mir/length
        :mir/index :mir/stored :mir/expected :mir/offset :mir/size :mir/arguments) true
       (:mir/second-base :mir/second-length :mir/count) (not (= which 2))
       :mc/test (= which 0)
       false))

(defn- source-values [instruction [:ref :form/r] which :i64] [:list [:ref :form/r]]
     (let [xs (form/kids-of instruction) n (vector-count xs)]
       (loop [j 0 acc (lnone)]
         (if (>= (+ j 1) n) acc
           (let [k (typed-list-nth [:list [:ref :form/r]] xs j)
                 v (typed-list-nth [:list [:ref :form/r]] xs (+ j 1))]
             (recur (+ j 2)
                    (if (and (form/is-keyword? k) (mir-source-key? (form/keyword-value k) which))
                      (cond (form/is-vec? v) (lcat acc (form/kids-of v))
                            (form/is-keyword? v) (lconj acc v)
                            :else acc)
                      acc)))))))

(defn- a64-source-registers-mir [instruction [:ref :form/r]] [:list [:ref :form/r]] (source-values instruction 0))

(defn- a64-used-before-definition? [instructions [:list [:ref :form/r]] register [:ref :form/r]] :bool
     (let [n (lcount instructions)]
       (loop [i 0]
         (if (>= i n)
           false
           (let [instruction (lget instructions i)]
             (cond
               (lmember? (a64-source-registers-mir instruction) register) true
               (feq register (fget instruction :mir/dst)) false
               :else (recur (inc i))))))))

(defn- a64-label-index [instructions [:list [:ref :form/r]]] [:ref :form/r]
     (let [n (lcount instructions)]
       (loop [i 0 acc (lnone)]
         (if (>= i n)
           (fmap acc)
           (let [ins (lget instructions i)]
             (recur (inc i)
                    (if (fkw= ins :mir/op :mir/label)
                      (let [id (fget ins :mir/id)]
                        (if (form/form-has? (fmap acc) id)
                          (fmap-assoc-list acc id (intf i))
                          (lconj (lconj acc id) (intf i))))
                      acc)))))))

(defn- fmap-assoc-list [kvs [:list [:ref :form/r]] k [:ref :form/r] v [:ref :form/r]] [:list [:ref :form/r]]
     (form/kids-of (form/assoc-form (fmap kvs) k v)))

(defn- a64-coalesce-direct-results [input [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [instructions input
           n (lcount instructions)
           labels (a64-label-index instructions)]
       (loop [index 0 out (lnone)]
         (if (>= index n)
           out
           (let [producer (lget instructions index)
                 after-labels (loop [candidate (inc index)]
                                (if (fkw= (lget instructions candidate) :mir/op :mir/label)
                                  (recur (inc candidate))
                                  candidate))
                 move (lget instructions after-labels)
                 jump (lget instructions (inc after-labels))
                 source (fget producer :mir/dst)
                 target-index (form/form-get labels (fget jump :mir/target))
                 direct? (a64-direct-result-op? (fkw producer :mir/op))
                 edge? (and direct?
                            (fkw= move :mir/op :mir/move)
                            (feq source (fget move :mir/src))
                            (fkw= jump :mir/op :mir/jump)
                            (truthy? target-index)
                            (not (a64-used-before-definition?
                                  (ldrop instructions (inc (form/int-value target-index))) source)))
                 return (lget instructions (inc index))
                 return? (and direct?
                              (fkw= return :mir/op :mir/return)
                              (feq source (fget return :mir/value)))]
             (cond
               edge?
               (recur (inc after-labels)
                      (lcat (lconj out (fassoc producer :mir/dst (fget move :mir/dst)))
                            (lslice instructions (inc index) after-labels)))
               return?
               (recur (+ index 2)
                      (lconj (lconj out (fassoc producer :mir/dst (kf :aarch64/x0)))
                             (fassoc return :mir/value (kf :aarch64/x0))))
               :else
               (recur (inc index) (lconj out producer))))))))

(defn- layout-label [id [:ref :form/r]] [:ref :form/r]
     (map2 :mir/op (kf :mir/label) :mir/id id))

(defn- layout-relative-branch [encoding :keyword target [:ref :form/r]] [:ref :form/r]
     (map3 :mir/op (kf :mir/relative-branch) :mir/encoding (kf encoding) :mir/target target))

(defn- layout-relative-branch-ops [encoding :keyword target [:ref :form/r] operands [:list [:ref :form/r]]] [:ref :form/r]
     (map4 :mir/op (kf :mir/relative-branch) :mir/encoding (kf encoding) :mir/target target
           :mir/operands (fvec operands)))

(defn- layout-label-token? [token [:ref :form/r]] :bool
     (and (form/is-map? token) (fkw= token :mir/op :mir/label)))

(defn- layout-relative-branch-token? [token [:ref :form/r]] :bool
     (and (form/is-map? token) (fkw= token :mir/op :mir/relative-branch)))

(defn- mir-op-without [instruction [:ref :form/r]] [:list [:ref :form/r]]
     (form/kids-of (form/dissoc-form instruction (kf :mir/op))))

(defn- lower-mc-instruction [isa :keyword instruction [:ref :form/r]] [:ref :form/r]
     (let [op (fkw instruction :mir/op)]
       (case op
         :mir/label (layout-label (fget instruction :mir/id))
         :mir/reentry (map2 :mc/op (kf :mc/reentry) :mc/parameters (fget instruction :mir/parameters))
         :mir/recur (map2 :mc/op (kf :mc/recur) :mc/arguments (fget instruction :mir/arguments))
         :mir/branch-zero (map3 :mc/op (kf :mc/branch-zero) :mc/test (fget instruction :mir/test)
                                :mc/target (fget instruction :mir/target))
         :mir/branch-nonzero (map3 :mc/op (kf :mc/branch-nonzero) :mc/test (fget instruction :mir/test)
                                   :mc/target (fget instruction :mir/target))
         :mir/jump (map2 :mc/op (kf :mc/jump) :mc/target (fget instruction :mir/target))
         (fmap (lcat (form/kids-of (map2 :mc/op (kf :mc/instruction)
                                         :mc/encoding (kf (keyword-ns-name (keyword-name isa) op))))
                     (mir-op-without instruction))))))

(defn- lower-mc-instructions [isa :keyword input [:list [:ref :form/r]]] [:ref :form/r]
     (let [instructions (if (= isa :aarch64)
                          (a64-coalesce-direct-results (a64-fuse-multiplies input))
                          input)
           n (lcount instructions)]
       (loop [i 0 out (lnone)]
         (if (>= i n)
           (fvec out)
           (recur (inc i) (lconj out (lower-mc-instruction isa (lget instructions i))))))))

(defn- lower-mc-function [target :keyword f [:ref :form/r]] [:ref :form/r]
     (fassoc (fassoc (map3 :mc/name (fget f :mir/name) :mc/arity (fget f :mir/arity)
                           :mc/frame-slots (fget f :mir/frame-slots))
                     :mc/frame-policy (fget f :mir/frame-policy))
             :mc/instructions (lower-mc-instructions target (kids (fget f :mir/instructions)))))

(defn- mc-checked [p [:ref :form/r]] [:ref :form/r]
     (if (mc-valid? p) p (reject-form! :mc :invalid-program p)))

(defn lower-mc [program [:ref :form/r]] [:ref :form/r]
     (let [version (fget program :mir/version)
           target (fkw program :mir/target)]
       (cond
         (not (mir-valid? program)) (reject-form! :mir :invalid-program program)
         (not (fkw= program :mir/registers :physical))
         (reject-form! :mc :registers-not-allocated program)
         :else
         (mc-checked
          (if (form/eq version (intf 3))
            (let [fs (kids (fget program :mir/functions))
                  n (lcount fs)]
              (map4 :mc/version (intf 3)
                    :mc/target (kf target)
                    :mc/entry (fget program :mir/entry)
                    :mc/functions (fvec (loop [i 0 acc (lnone)]
                                          (if (>= i n) acc
                                            (recur (inc i) (lconj acc (lower-mc-function target (lget fs i)))))))))
            (map4 :mc/version (intf 2)
                  :mc/target (kf target)
                  :mc/frame-slots (let [s (fget program :mir/frame-slots)] (if (truthy? s) s (intf 0)))
                  :mc/instructions (lower-mc-instructions target (kids (fget program :mir/instructions)))))))))

;; ── pre-allocation liveness: hoist consumers to their producers ─────────────
;;
;; The allocator sees instructions in lowering order, and the scheduler that
;; could reorder them runs AFTER allocation (kotoba.mir/allocate-registers:
;; "Pure integer scheduling runs after allocation on physical MIR"). So a
;; source like
;;
;;   (let [a (lane 0) b (lane 1) ... x (lane 23)] (+ (+ (+ a b) c) ... x))
;;
;; reaches the allocator with all 24 lane values live at once and the 23
;; adds parked at the end -- the maximum-pressure order. On deep-spill that is
;; 14 SIMD parks, 8 stack ops, four callee-saved pairs and a frame.
;;
;; Measured 2026-09-07 (amu docs/codegen-coscientist.md, iteration 146): the
;; same lanes with each add placed right after the lane it consumes compile to
;; ZERO parks, ZERO stack ops, no callee-saved registers and no frame, and run
;; +3.17% (median) / +2.64% (min) faster on the fleet's quiet host. That was a
;; hand-written fixture; this pass produces that order from the original.
;;
;; The rule is small and target-independent. A pure instruction whose operands
;; are all vregs, and for which at least one operand's LAST use is this
;; instruction, moves up to sit immediately after the later of its operand
;; definitions. Hoisting such an instruction shortens a lifetime and never
;; lengthens one it does not already own. It never crosses a barrier (a label,
;; branch, call, memory operation, terminator, or anything touching a
;; physical register), and it never splits an adjacent multiply -> add /
;; subtract pair that the AArch64 selector would otherwise fuse into MADD/MSUB.
;;
;; Iteration 145 is the caution on the other side: chaining the lane INPUTS
;; serially cost 5%. This pass does not do that. The producers keep their
;; independence; only the consumers move, and only next to something they
;; already had to wait for.

nil

nil

nil

nil

(defn- ktext [k [:ref :form/r]] :string
     (if (form/is-keyword? k) (document-edn-print (document-keyword (form/keyword-value k))) ""))

(defn- vreg? [v [:ref :form/r]] :bool (gmir/vreg? v))

(defn- vreg-num [v [:ref :form/r]] :i64
     (if (vreg? v)
       (let [t (ktext v) n (string-byte-length t)]
         (loop [i 18 acc 0] (if (>= i n) acc (recur (inc i) (+ (* acc 10) (- (string-code-point-at t i) 48))))))
       -1))

(defn- vt-new [] :vector-i64 (vector-alloc 0))

(defn- vt-get [t :vector-i64 k [:ref :form/r] dflt :i64] :i64
     (let [i (vreg-num k)]
       (if (and (>= i 0) (< i (vector-count t)))
         (let [x (vector-at t i)] (if (= x -1) dflt x))
         dflt)))

(defn- vt-grow [t :vector-i64 n :i64] :vector-i64
     (loop [u t] (if (>= (vector-count u) n) u (recur (vector-conj u -1)))))

(defn- vt-put [t :vector-i64 k [:ref :form/r] x :i64] :vector-i64
     (let [i (vreg-num k)]
       (if (< i 0) t (vector-assoc! (vt-grow t (inc i)) i x))))

(defn- vt-has? [t :vector-i64 k [:ref :form/r]] :bool (>= (vt-get t k -1) 0))

(defn- hoist-source-key? [k :keyword] :bool
     (case k (:mir/src :mir/input :mir/left :mir/right :mir/addend :mir/test :mir/value) true false))

(defn- hoistable-op? [op :keyword] :bool
     (case op (:mir/add :mir/subtract :mir/multiply :mir/bit-and :mir/bit-or :mir/bit-xor :mir/shift-left
               :mir/shift-right-signed :mir/shift-right-unsigned) true false))

(defn- call-op? [op :keyword] :bool (or (= op :mir/call) (= op :mir/tail-call)))

(defn- crossable-op? [op :keyword] :bool
     (or (hoistable-op? op)
         (case op (:mir/constant :mir/quotient-constant :mir/equal :mir/less-than :mir/greater-than
                   :mir/less-or-equal :mir/greater-or-equal) true false)))

(defn- hoist-key-values [instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [xs (form/kids-of instruction) n (vector-count xs)]
       (loop [j 0 acc (lnone)]
         (if (>= (+ j 1) n) acc
           (let [k (typed-list-nth [:list [:ref :form/r]] xs j)
                 v (typed-list-nth [:list [:ref :form/r]] xs (+ j 1))]
             (recur (+ j 2) (if (and (form/is-keyword? k) (hoist-source-key? (form/keyword-value k)) (not (form/is-nil? v)))
                              (lconj acc v) acc)))))))

(defn- only-vregs [xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount xs)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) acc (recur (inc i) (if (vreg? (lget xs i)) (lconj acc (lget xs i)) acc))))))

(defn- hoist-register-operands [instruction [:ref :form/r]] [:list [:ref :form/r]]
     (only-vregs (hoist-key-values instruction)))

(defn- incoming-values [incomings [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount incomings)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) acc (recur (inc i) (lconj acc (fget (lget incomings i) :mir/value)))))))

(defn- hoist-all-register-reads [instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [args (fget instruction :mir/arguments)
           incs (fget instruction :mir/incomings)]
       (lcat (lcat (only-vregs (hoist-key-values instruction))
                   (if (form/is-vec? args) (only-vregs (kids args)) (lnone)))
             (if (form/is-vec? incs) (only-vregs (incoming-values (kids incs))) (lnone)))))

(defn- hoist-register-only? [instruction [:ref :form/r]] :bool
     (let [vs (lcons (fget instruction :mir/dst) (hoist-key-values instruction))
           n (lcount vs)]
       (loop [i 0]
         (if (>= i n) true
           (let [v (lget vs i)]
             (if (or (not (form/is-keyword? v)) (vreg? v)) (recur (inc i)) false))))))

(defn- lcons [x [:ref :form/r] xs [:list [:ref :form/r]]] [:list [:ref :form/r]] (form/cons-onto x xs))

(defn- hoist-crossable? [instruction [:ref :form/r]] :bool
     (or (and (crossable-op? (fkw instruction :mir/op))
              (hoist-register-only? instruction))
         (call-op? (fkw instruction :mir/op))))

(defn- hoist-splits-fusion-pair? [out [:list [:ref :form/r]] position :i64 use-counts :vector-i64] :bool
     (let [above (lget out (dec position))
           below (lget out position)
           product (fget above :mir/dst)]
       (and (truthy? above) (truthy? below)
            (fkw= above :mir/op :mir/multiply)
            (vreg? product)
            (= 1 (vt-get use-counts product 0))
            (or (and (fkw= below :mir/op :mir/add)
                     (or (feq product (fget below :mir/left)) (feq product (fget below :mir/right))))
                (and (fkw= below :mir/op :mir/subtract)
                     (feq product (fget below :mir/right)))))))

(defn- hoist-use-table [instructions [:list [:ref :form/r]] which :i64] :vector-i64
     (let [n (lcount instructions)]
       (loop [i 0 t (vt-new) last (vt-new)]
         (if (>= i n)
           t
           (let [reads (hoist-all-register-reads (lget instructions i))
                 m (lcount reads)
                 t-p (loop [j 0 t t l last]
                      (if (>= j m) t
                        (let [v (lget reads j) old (vt-get l v -1)]
                          (recur (inc j)
                                 (cond (= which 0) (vt-put t v (+ 1 (vt-get t v 0)))
                                       (= which 1) (vt-put t v i)
                                       :else (if (and (>= old 0) (not (= old i))) (vt-put t v old) t))
                                 (vt-put l v i)))))
                 last-p (loop [j 0 l last]
                         (if (>= j m) l (recur (inc j) (vt-put l (lget reads j) i))))]
             (recur (inc i) t-p last-p))))))

(defn- i64-index-of [xs [:list :i64] x :i64] :i64
     (let [n (vector-count xs)]
       (loop [i 0] (if (>= i n) -1 (if (= (typed-list-nth [:list :i64] xs i) x) i (recur (inc i)))))))

(defn- i64-insert [xs [:list :i64] pos :i64 x :i64] [:list :i64]
     (let [n (vector-count xs)]
       (loop [i 0 acc (typed-list-new [:list :i64])]
         (if (> i n) acc
           (recur (inc i)
                  (cond (< i pos) (typed-list-conj [:list :i64] acc (typed-list-nth [:list :i64] xs i))
                        (= i pos) (typed-list-conj [:list :i64] acc x)
                        :else (typed-list-conj [:list :i64] acc (typed-list-nth [:list :i64] xs (dec i)))))))))

(defn- form-insert [xs [:list [:ref :form/r]] pos :i64 x [:ref :form/r]] [:list [:ref :form/r]]
     (lcat (lconj (lslice xs 0 pos) x) (ldrop xs pos)))

(defn- hoist-max-def-pos [srcs [:list [:ref :form/r]] def-orig :vector-i64 out-orig [:list :i64]] :i64
     (let [n (lcount srcs)]
       (loop [i 0 best -1]
         (if (>= i n) best
           (let [o (vt-get def-orig (lget srcs i) -1)]
             (recur (inc i) (if (< o 0) best (let [p (i64-index-of out-orig o)] (if (> p best) p best)))))))))

(defn- hoist-all-defined? [srcs [:list [:ref :form/r]] def-orig :vector-i64] :bool
     (let [n (lcount srcs)]
       (loop [i 0] (if (>= i n) true (if (vt-has? def-orig (lget srcs i)) (recur (inc i)) false)))))

(defn- hoist-all-killed? [srcs [:list [:ref :form/r]] orig-i :i64 last :vector-i64] :bool
     (let [n (lcount srcs)]
       (loop [i 0] (if (>= i n) true (if (= orig-i (vt-get last (lget srcs i) -2)) (recur (inc i)) false)))))

(defn- hoist-max-other-use [srcs [:list [:ref :form/r]] prev :vector-i64 out-orig [:list :i64]] :i64
     (let [n (lcount srcs)]
       (loop [i 0 best -1]
         (if (>= i n) best
           (let [o (vt-get prev (lget srcs i) -1)
                 p (if (< o 0) -1 (i64-index-of out-orig o))]
             (recur (inc i) (if (> p best) p best)))))))

(defn- hoist-consumers-to-producers [instructions [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [use-counts (hoist-use-table instructions 0)
           last-use (hoist-use-table instructions 1)
           prev-use (hoist-use-table instructions 2)
           n (lcount instructions)]
       (loop [orig-i 0 out (lnone) out-orig (typed-list-new [:list :i64]) def-orig (vt-new) last-barrier -1]
         (if (>= orig-i n)
           out
           (let [ins (lget instructions orig-i)
                 srcs (hoist-register-operands ins)
                 dst (fget ins :mir/dst)
                 hoistable? (and (hoistable-op? (fkw ins :mir/op))
                                 (hoist-register-only? ins)
                                 (> (lcount srcs) 0)
                                 (hoist-all-defined? srcs def-orig)
                                 (hoist-all-killed? srcs orig-i last-use))
                 target-pos (if hoistable?
                              (let [pos (max (inc (hoist-max-def-pos srcs def-orig out-orig))
                                             (max (inc (hoist-max-other-use srcs prev-use out-orig))
                                                  (inc last-barrier)))]
                                (if (hoist-splits-fusion-pair? out pos use-counts) (inc pos) pos))
                              -1)
                 append? (or (< target-pos 0) (>= target-pos (lcount out)))
                 def-orig-p (if (vreg? dst) (vt-put def-orig dst orig-i) def-orig)]
             (if append?
               (recur (inc orig-i)
                      (lconj out ins)
                      (typed-list-conj [:list :i64] out-orig orig-i)
                      def-orig-p
                      (if (hoist-crossable? ins) last-barrier (lcount out)))
               (recur (inc orig-i)
                      (form-insert out target-pos ins)
                      (i64-insert out-orig target-pos orig-i)
                      def-orig-p
                      (if (>= last-barrier target-pos) (inc last-barrier) last-barrier))))))))

(defn- map-functions-instructions [fs [:list [:ref :form/r]] how :keyword] [:list [:ref :form/r]]
     (let [n (lcount fs)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) acc
           (let [f (lget fs i)
                 xs (kids (fget f :mir/instructions))]
             (recur (inc i)
                    (lconj acc (fassoc f :mir/instructions
                                       (fvec (if (= how :hoist) (hoist-consumers-to-producers xs) (a64-coalesce-moves xs)))))))))))

(defn hoist-program-consumers [program [:ref :form/r]] [:ref :form/r]
     (if (form/eq (fget program :mir/version) (intf 3))
       (fassoc program :mir/functions (fvec (map-functions-instructions (kids (fget program :mir/functions)) :hoist)))
       (fassoc program :mir/instructions (fvec (hoist-consumers-to-producers (kids (fget program :mir/instructions)))))))

;; ── post-allocation move coalescing (aarch64) ──────────────────────────────
;;
;; The allocator hands a call its arguments through copies. Two shapes of
;; those copies are pure waste, and both sit on the dependency path INTO the
;; call, so the callee waits on them:
;;
;;   move x19 <- x0 ; move x0 <- x19        x0 still holds n: the copy back is a no-op
;;   add  x2 <- x19 + 1 ; move x0 <- x2     x2 has no other reader: write x0 directly
;;
;; clang writes `add x0, x19, #1`. On kernel_call and kernel_call_branch this
;; is four instructions per call out of 52 and 51 (amu iteration 123 priced a
;; NOP-patched removal at +1.28% on call-preservation; the real removal shortens
;; the argument chain as well). aarch64 only for now: the x86-64 lowering of
;; two-address ops has not been measured under a renamed destination.

nil

nil

nil

(defn- a64-caller-saved? [r [:ref :form/r]] :bool
     (and (form/is-keyword? r)
          (let [t (ktext r)]
            (and (> (string-byte-length t) 10)
                 (string=? (string-substring t 0 10) ":aarch64/x")
                 (let [num (string-substring t 10 (string-byte-length t))
                       k (string-byte-length num)]
                   (and (>= k 1) (<= k 2)
                        (loop [i 0] (if (>= i k) true (let [c (string-code-point-at num i)] (if (and (>= c 48) (<= c 57)) (recur (inc i)) false))))
                        (or (= k 1) (not (= 48 (string-code-point-at num 0))))
                        (< (decimal-of num) 18)))))))

(defn- decimal-of [s :string] :i64
     (let [n (string-byte-length s)]
       (loop [i 0 acc 0] (if (>= i n) acc (recur (inc i) (+ (* acc 10) (- (string-code-point-at s i) 48)))))))

(defn- coalescable-op? [op :keyword] :bool (or (hoistable-op? op) (= op :mir/constant) (= op :mir/move)))

(defn- coalesce-transparent-op? [op :keyword] :bool
     (or (crossable-op? op) (= op :mir/move) (= op :mir/multiply-add) (= op :mir/multiply-subtract)))

(defn- a64-register? [v [:ref :form/r]] :bool
     (and (form/is-keyword? v)
          (let [t (ktext v)] (and (> (string-byte-length t) 9) (string=? (string-substring t 0 9) ":aarch64/")))))

(defn- fvals [m [:ref :form/r]] [:list [:ref :form/r]]
     (let [xs (kids m) n (lcount xs)]
       (loop [j 1 acc (lnone)] (if (>= j n) acc (recur (+ j 2) (lconj acc (lget xs j)))))))

(defn- a64-read-values [v [:ref :form/r]] [:list [:ref :form/r]]
     (cond (form/is-vec? v)
           (let [xs (kids v) n (lcount xs)]
             (loop [i 0 acc (lnone)]
               (if (>= i n) acc
                 (let [x (lget xs i)] (recur (inc i) (if (form/is-map? x) (lcat acc (fvals x)) (lconj acc x)))))))
           (form/is-map? v) (fvals v)
           :else (lone v)))

(defn- a64-registers-read [instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [vs (fvals (form/dissoc-form (form/dissoc-form instruction (kf :mir/op)) (kf :mir/dst)))
           n (lcount vs)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) acc
           (recur (inc i) (lcat acc (a64-register-only (a64-read-values (lget vs i)))))))))

(defn- a64-register-only [xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount xs)]
       (loop [i 0 acc (lnone)] (if (>= i n) acc (recur (inc i) (if (a64-register? (lget xs i)) (lconj acc (lget xs i)) acc))))))

(defn- a64-dead-after? [instructions [:list [:ref :form/r]] from :i64 reg [:ref :form/r]] :bool
     (let [n (lcount instructions)]
       (loop [i from]
         (if (>= i n)
           true
           (let [ins (lget instructions i) op (fkw ins :mir/op)]
             (cond
               (lmember? (a64-registers-read ins) reg) false
               (feq reg (fget ins :mir/dst)) true
               (= op :mir/tail-call) true
               (= op :mir/return) true
               (= op :mir/call) (if (a64-caller-saved? reg) true (recur (inc i)))
               (coalesce-transparent-op? op) (recur (inc i))
               :else false))))))

(defn- alias-forget [alias [:ref :form/r] regs [:list [:ref :form/r]]] [:ref :form/r]
     (let [xs (kids alias) n (lcount xs)]
       (loop [j 0 acc (lnone)]
         (if (>= (+ j 1) n) (fmap acc)
           (let [a (lget xs j) b (lget xs (inc j))]
             (recur (+ j 2) (if (or (lmember? regs a) (lmember? regs b)) acc (lconj (lconj acc a) b))))))))

(defn- a64-coalesce-moves [instructions [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount instructions)]
       (loop [i 0 out (lnone) alias (fmap (lnone))]
         (if (>= i n)
           out
           (let [ins (lget instructions i) op (fkw ins :mir/op) dst (fget ins :mir/dst) nxt (lget instructions (inc i))
                 src (fget ins :mir/src)]
             (cond
               (and (= op :mir/move) (a64-register? dst) (a64-register? src)
                    (or (feq src (form/form-get alias dst)) (feq dst (form/form-get alias src))))
               (recur (inc i) out alias)

               (and (coalescable-op? op) (a64-register? dst)
                    (truthy? nxt) (fkw= nxt :mir/op :mir/move) (feq dst (fget nxt :mir/src))
                    (a64-register? (fget nxt :mir/dst)) (not (feq dst (fget nxt :mir/dst)))
                    (not (lmember? (a64-registers-read ins) (fget nxt :mir/dst)))
                    (a64-dead-after? instructions (+ i 2) dst))
               (let [d (fget nxt :mir/dst)]
                 (recur (+ i 2) (lconj out (fassoc ins :mir/dst d)) (alias-forget alias (lone d))))

               :else
               (let [alias-p (cond
                              (= op :mir/move)
                              (if (and (a64-register? dst) (a64-register? src))
                                (form/assoc-form (alias-forget alias (lone dst)) dst src)
                                (alias-forget alias (lone dst)))
                              (and (coalesce-transparent-op? op) (a64-register? dst))
                              (alias-forget alias (lone dst))
                              :else (fmap (lnone)))]
                 (recur (inc i) (lconj out ins) alias-p))))))))

(defn coalesce-program-moves [program [:ref :form/r]] [:ref :form/r]
     (if (form/eq (fget program :mir/version) (intf 3))
       (fassoc program :mir/functions (fvec (map-functions-instructions (kids (fget program :mir/functions)) :coalesce)))
       (fassoc program :mir/instructions (fvec (a64-coalesce-moves (kids (fget program :mir/instructions)))))))

(defn- mir-select-target [target :keyword program [:ref :form/r]] [:ref :form/r]
     (let [r (mir/select-target-result (kf target) program)]
       (if (fhas? r :problem) (reject-form! :mir (fkw r :problem) program) (fget r :program))))

(defn- mir-allocate [program [:ref :form/r]] [:ref :form/r]
     (let [r (mir/allocate-registers-result program)]
       (if (fhas? r :problem) (reject-form! :mir (fkw r :problem) program) (fget r :program))))

(defn compile-gmir [target :keyword program [:ref :form/r]] [:ref :form/r]
     (let [selected (mir-select-target target program)
           hoisted (hoist-program-consumers selected)
           allocated (mir-allocate hoisted)
           coalesced (if (= target :aarch64) (coalesce-program-moves allocated) allocated)]
       (lower-mc coalesced)))

;; ── closed KIR expression -> GMIR pilot ─────────────────────────────────────

(defn- sym? [f [:ref :form/r] name :string] :bool
     (and (form/is-symbol? f) (string=? (form/symbol-value f) name)))

(defn- symf [name :string] [:ref :form/r] (form/symbol-form name))

(defn- fnth [f [:ref :form/r] i :i64] [:ref :form/r] (form/nth-of f i))

(defn- fcount [f [:ref :form/r]] :i64 (form/count-of f))

(defn- head-is? [form [:ref :form/r] name :string] :bool
     (and (form/is-seq? form) (> (form/count-of form) 0) (sym? (form/nth-of form 0) name)))

(defn- head-in? [form [:ref :form/r] table [:ref :form/r]] :bool
     (and (form/is-seq? form) (> (form/count-of form) 0) (fmember? table (form/nth-of form 0))))

(defn- tget [table [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
     (form/form-get table (form/nth-of form 0)))

(defn- lst [xs [:list [:ref :form/r]]] [:ref :form/r] (form/form-seq xs))

(defn- let1 [name :string value [:ref :form/r] body [:ref :form/r]] [:ref :form/r]
     (form/call2 "let" (form/vec2 (symf name) value) body))

(defn- let2 [n1 :string v1 [:ref :form/r] n2 :string v2 [:ref :form/r] body [:ref :form/r]] [:ref :form/r]
     (form/call2 "let" (form/vec4 (symf n1) v1 (symf n2) v2) body))

(defn- if3 [t [:ref :form/r] a [:ref :form/r] b [:ref :form/r]] [:ref :form/r] (form/call3 "if" t a b))

(defn- head-kw [form [:ref :form/r]] :keyword
     (if (and (form/is-seq? form) (> (form/count-of form) 0) (form/is-symbol? (form/nth-of form 0)))
       (keyword-from-string (form/symbol-value (form/nth-of form 0)))
       :none))

(defn- kir-binary-op [h :keyword] :keyword
     (case h :+ :gmir/add :- :gmir/subtract :* :gmir/multiply :quot :gmir/quotient :bit-and :gmir/bit-and
       :bit-or :gmir/bit-or :bit-xor :gmir/bit-xor :i64-shift-left :gmir/shift-left
       :i64-shift-right :gmir/shift-right-signed :u64-shift-right :gmir/shift-right-unsigned
       := :gmir/equal :< :gmir/less-than :> :gmir/greater-than :<= :gmir/less-or-equal :>= :gmir/greater-or-equal
       :none))

(defn- kir-predicate-op [h :keyword] :keyword
     (case h :not :gmir/equal :zero? :gmir/equal :pos? :gmir/greater-than :neg? :gmir/less-than :none))

(defn- kir-fold-op? [h :keyword] :bool (case h (:+ :- :* :bit-and :bit-or :bit-xor) true false))

(defn- kir-comparison-op? [h :keyword] :bool (case h (:= :< :> :<= :>=) true false))

(defn- kir-word-unary-op? [h :keyword] :bool (case h (:bool-not :bit-not :i32-wrap :u32-wrap) true false))

(defn- kir-i32-binary-op? [h :keyword] :bool
     (case h (:i32-wrapping-add :i32-wrapping-mul :i32-xor :i32-shift-left :i32-shift-right :u32-shift-right) true false))

(defn- kir-f64-binary-op [h :keyword] :keyword
     (case h :f64-add :gmir/f64-add :f64-sub :gmir/f64-subtract :f64-mul :gmir/f64-multiply :f64-div :gmir/f64-divide
       :f64-min :gmir/f64-min :f64-max :gmir/f64-max :f64-eq :gmir/f64-equal :f64-lt :gmir/f64-less-than
       :f64-le :gmir/f64-less-or-equal :f64-gt :gmir/f64-greater-than :f64-ge :gmir/f64-greater-or-equal
       :f64-unordered :gmir/f64-unordered :none))

(defn- kir-f64-unary-op? [h :keyword] :bool (case h (:f64-from-bits :f64-to-bits :f64-abs :f64-neg :f64-sqrt) true false))

(defn- kir-f32-binary-op [h :keyword] :keyword
     (case h :f32-add :gmir/f32-add :f32-sub :gmir/f32-subtract :f32-mul :gmir/f32-multiply :f32-div :gmir/f32-divide
       :f32-eq :gmir/f32-equal :f32-lt :gmir/f32-less-than :f32-le :gmir/f32-less-or-equal :f32-gt :gmir/f32-greater-than
       :f32-ge :gmir/f32-greater-or-equal :f32-unordered :gmir/f32-unordered :none))

(defn- kir-f32-unary-op? [h :keyword] :bool (case h (:f32-from-bits :f32-to-bits :f32-abs :f32-neg :f32-sqrt) true false))

(defn- kir-f32-conversion-op [h :keyword] :keyword
     (case h :f32-to-f64-exact :gmir/f32-to-f64 :f64-to-f32-rounded :gmir/f64-to-f32
       :i64-to-f32-rounded :gmir/i64-to-f32 :i64-to-f64-rounded :gmir/i64-to-f64 :none))

(defn- kir-memory-head? [h :keyword] :bool
     (let [n (keyword-name h)]
       (or (and (>= (string-byte-length n) 7) (string=? (string-substring n 0 7) "kernel-")
                (or (>= (string-index-of n "-load-u") 0) (>= (string-index-of n "-store-u") 0))
                (not (>= (string-index-of n "atomic") 0)))
           (and (>= (string-byte-length n) 6) (string=? (string-substring n 0 6) "slice-"))
           (= h :kernel-try-lock-u32) (= h :kernel-unlock-u32))))

(defn- kir-binary-ops [] [:ref :form/r]
     (form/edn-form "{+ :gmir/add - :gmir/subtract * :gmir/multiply quot :gmir/quotient bit-and :gmir/bit-and bit-or :gmir/bit-or bit-xor :gmir/bit-xor i64-shift-left :gmir/shift-left i64-shift-right :gmir/shift-right-signed u64-shift-right :gmir/shift-right-unsigned = :gmir/equal < :gmir/less-than > :gmir/greater-than <= :gmir/less-or-equal >= :gmir/greater-or-equal}"))

(defn- kir-predicate-ops [] [:ref :form/r]
     (form/edn-form "{not :gmir/equal zero? :gmir/equal pos? :gmir/greater-than neg? :gmir/less-than}"))

(defn- kir-fold-ops [] [:ref :form/r] (form/edn-form "#{+ - * bit-and bit-or bit-xor}"))
(defn- kir-comparison-ops [] [:ref :form/r] (form/edn-form "#{= < > <= >=}"))
(defn- kir-word-unary-ops [] [:ref :form/r] (form/edn-form "#{bool-not bit-not i32-wrap u32-wrap}"))
(defn- kir-i32-binary-ops [] [:ref :form/r]
     (form/edn-form "#{i32-wrapping-add i32-wrapping-mul i32-xor i32-shift-left i32-shift-right u32-shift-right}"))
(defn- kir-f64-binary-ops [] [:ref :form/r]
     (form/edn-form "{f64-add :gmir/f64-add f64-sub :gmir/f64-subtract f64-mul :gmir/f64-multiply f64-div :gmir/f64-divide f64-min :gmir/f64-min f64-max :gmir/f64-max f64-eq :gmir/f64-equal f64-lt :gmir/f64-less-than f64-le :gmir/f64-less-or-equal f64-gt :gmir/f64-greater-than f64-ge :gmir/f64-greater-or-equal f64-unordered :gmir/f64-unordered}"))
(defn- kir-f64-unary-ops [] [:ref :form/r] (form/edn-form "#{f64-from-bits f64-to-bits f64-abs f64-neg f64-sqrt}"))
;; memwidth: 2^40 elements. Mirrors `kotoba.gmir/slice-item-limit` and
;; `kotoba.mir/slice-item-limit` -- an ADDRESS-SPACE bound rather than a window
;; profile, chosen so `length * 8` cannot wrap a 64-bit address computation.
;; Deliberately not derived from any vector arena bound: amu ADR 0285's
;; decision is that the bulk carrier does not travel through the arena.
(defn- slice-item-limit [] :i64 1099511627776)


;; f32: binary32 (kotoba-lang docs/adr/ADR-kotoba-floating-point-on-native.md).
;;
;; The representation is the f64 one at the narrower width, with one difference
;; that is the whole design: the word holds the binary32 pattern SIGN-EXTENDED
;; from bit 31. That is what keeps `f32-to-bits` an identity the way
;; `f64-to-bits` is, because the KIR oracle's `f32-to-i64-bits` yields a SIGNED
;; i32 -- a zero-extended word would disagree with it for every negative float.
;; So `f32-from-bits` is the one member of the family that is NOT an identity
;; here: it is `signed-i32-value`, which also canonicalises the zero-extended
;; u32 that `kernel-load-u32` returns.
;;
;; `f32-min`/`f32-max` are absent, and the reason is no longer the one this
;; comment used to give. It said x86's MINSS/MAXSS disagree with the oracle on
;; NaN and signed zeros -- true, and its f64 twin shipped with that defect until
;; `x86-f64-min-max` above repaired it. The same corrected shape transfers to
;; binary32 unchanged (CMPEQSS/ORPS/ANDPS/ANDNPS/MINSS/CMPUNORDSS). What is
;; missing is not an encoding but an admission: `f32-min`/`f32-max` would have
;; to travel kir -> sema -> gmir -> mir -> codegen -> verifier -> native, seven
;; repositories, and that is a slice of its own rather than a hygiene fix.
;; `kotoba.kir` still refuses them at admission for both backends.
(defn- kir-f32-binary-ops [] [:ref :form/r]
     (form/edn-form "{f32-add :gmir/f32-add f32-sub :gmir/f32-subtract f32-mul :gmir/f32-multiply f32-div :gmir/f32-divide f32-eq :gmir/f32-equal f32-lt :gmir/f32-less-than f32-le :gmir/f32-less-or-equal f32-gt :gmir/f32-greater-than f32-ge :gmir/f32-greater-or-equal f32-unordered :gmir/f32-unordered}"))

(defn- kir-f32-unary-ops [] [:ref :form/r] (form/edn-form "#{f32-from-bits f32-to-bits f32-abs f32-neg f32-sqrt}"))

;; Width conversions, all one-source/one-value. Only the four on which both
;; ISAs and the KIR oracle agree for EVERY input; the `-checked` and truncating
;; float-to-int families are refused at admission and are named in the ADR.
(defn- kir-f32-conversion-ops [] [:ref :form/r]
     (form/edn-form "{f32-to-f64-exact :gmir/f32-to-f64 f64-to-f32-rounded :gmir/f64-to-f32 i64-to-f32-rounded :gmir/i64-to-f32 i64-to-f64-rounded :gmir/i64-to-f64}"))
(defn- kir-kernel-memory-ops [] [:ref :form/r]
     (form/edn-form "{kernel-load-u8 [:gmir/kernel-load-u8 512] kernel-store-u8 [:gmir/kernel-store-u8 512] kernel-load-u8-4k [:gmir/kernel-load-u8 4096] kernel-store-u8-4k [:gmir/kernel-store-u8 4096] kernel-load-u8-16k [:gmir/kernel-load-u8 16384] kernel-store-u8-16k [:gmir/kernel-store-u8 16384] kernel-load-u8-64k [:gmir/kernel-load-u8 65536] kernel-store-u8-64k [:gmir/kernel-store-u8 65536] kernel-load-u16 [:gmir/kernel-load-u16 512] kernel-store-u16 [:gmir/kernel-store-u16 512] kernel-load-u16-4k [:gmir/kernel-load-u16 4096] kernel-store-u16-4k [:gmir/kernel-store-u16 4096] kernel-load-u16-16k [:gmir/kernel-load-u16 16384] kernel-store-u16-16k [:gmir/kernel-store-u16 16384] kernel-load-u16-64k [:gmir/kernel-load-u16 65536] kernel-store-u16-64k [:gmir/kernel-store-u16 65536] kernel-load-u32 [:gmir/kernel-load-u32 512] kernel-store-u32 [:gmir/kernel-store-u32 512] kernel-load-u32-4k [:gmir/kernel-load-u32 4096] kernel-store-u32-4k [:gmir/kernel-store-u32 4096] kernel-load-u32-16k [:gmir/kernel-load-u32 16384] kernel-store-u32-16k [:gmir/kernel-store-u32 16384] kernel-load-u32-64k [:gmir/kernel-load-u32 65536] kernel-store-u32-64k [:gmir/kernel-store-u32 65536] kernel-load-u64 [:gmir/kernel-load-u64 512] kernel-store-u64 [:gmir/kernel-store-u64 512] kernel-load-u64-4k [:gmir/kernel-load-u64 4096] kernel-store-u64-4k [:gmir/kernel-store-u64 4096] kernel-load-u64-16k [:gmir/kernel-load-u64 16384] kernel-store-u64-16k [:gmir/kernel-store-u64 16384] kernel-load-u64-64k [:gmir/kernel-load-u64 65536] kernel-store-u64-64k [:gmir/kernel-store-u64 65536] slice-load-u8 [:gmir/slice-load-u8 1099511627776] slice-store-u8 [:gmir/slice-store-u8 1099511627776] slice-load-u16 [:gmir/slice-load-u16 1099511627776] slice-store-u16 [:gmir/slice-store-u16 1099511627776] slice-load-u32 [:gmir/slice-load-u32 1099511627776] slice-store-u32 [:gmir/slice-store-u32 1099511627776] slice-load-u64 [:gmir/slice-load-u64 1099511627776] slice-store-u64 [:gmir/slice-store-u64 1099511627776] kernel-try-lock-u32 [:gmir/kernel-try-lock-u32 4096] kernel-unlock-u32 [:gmir/kernel-unlock-u32 4096]}"))

(defn- gmir-memory-store-ops [] [:ref :form/r]
     (form/edn-form "#{:gmir/kernel-store-u8 :gmir/kernel-store-u16 :gmir/kernel-store-u32 :gmir/kernel-store-u64 :gmir/slice-store-u8 :gmir/slice-store-u16 :gmir/slice-store-u32 :gmir/slice-store-u64}"))

nil

(defn- kernel-access-bytes [op :keyword] :i64
     (let [n (keyword-name op) k (string-byte-length n)]
       (cond (and (>= k 3) (string=? (string-substring n (- k 3) k) "-u8")) 1
             (and (>= k 4) (string=? (string-substring n (- k 4) k) "-u16")) 2
             (and (>= k 4) (string=? (string-substring n (- k 4) k) "-u32")) 4
             (and (>= k 4) (string=? (string-substring n (- k 4) k) "-u64")) 8
             :else (do (reject! :mc-encode :unknown-access-width (kf op)) 0))))

nil
;; sysops: the general atomics (kotoba-gmir ADR 0007). Separate from the table
;; above because the compare-exchanges take FIVE arguments, and the shared
;; lowering there is written around three-or-four.
;;
;; `[gmir-op maximum argument-count access-bits]`.
(defn- kir-kernel-atomic-ops [] [:ref :form/r]
     (form/edn-form "{kernel-atomic-add-u32 [:gmir/kernel-atomic-add-u32 4096 4 32] kernel-atomic-add-u64 [:gmir/kernel-atomic-add-u64 4096 4 64] kernel-xchg-u32 [:gmir/kernel-xchg-u32 4096 4 32] kernel-xchg-u64 [:gmir/kernel-xchg-u64 4096 4 64] kernel-cmpxchg-u32 [:gmir/kernel-cmpxchg-u32 4096 5 32] kernel-cmpxchg-u64 [:gmir/kernel-cmpxchg-u64 4096 5 64]}"))
;; sysops: end

;; simd: the f32 dot product (kotoba-gmir ADR 0010). Its own table because its
;; operands are two regions and a count rather than `base length index [value]`,
;; so neither of the shared lowerings above fits it.
;;
;; `[gmir-op maximum arity]`. The ceiling bounds BOTH lengths and is pinned to
;; one value; the element ceiling the emitter checks is derived from it.
nil
;; simd: end

;; dequant: the fused dequantize-and-dot family. Same five operands and the
;; same ceiling, so it lowers through the very same clause -- what differs is
;; the arithmetic between the regions, which the GMIR op names and the
;; backend emits. `:gmir/count` is BLOCKS here rather than elements; nothing
;; in the lowering depends on which, because the ceiling check that does live
;; in the emitter and in `kotoba.kir`.
nil

(defn- kir-region-pair-ops [] [:ref :form/r]
     (form/edn-form "{kernel-dot-f32 [:gmir/kernel-dot-f32 65536 5] kernel-dequant-dot-q8-0 [:gmir/kernel-dequant-dot-q8-0 65536 5] kernel-dequant-dot-q4-k [:gmir/kernel-dequant-dot-q4-k 65536 5] kernel-dequant-dot-q6-k [:gmir/kernel-dequant-dot-q6-k 65536 5] kernel-dequant-dot-iq4-xs [:gmir/kernel-dequant-dot-iq4-xs 65536 5] kernel-dequant-dot-iq2-s [:gmir/kernel-dequant-dot-iq2-s 65536 5] kernel-dequant-dot-iq3-xxs [:gmir/kernel-dequant-dot-iq3-xxs 65536 5] kernel-dequant-dot-iq3-s [:gmir/kernel-dequant-dot-iq3-s 65536 5] kernel-dequant-dot-ptq1-0 [:gmir/kernel-dequant-dot-ptq1-0 65536 5]}"))
;; dequant: end

(defn- kir-x86-privileged-ops [] [:ref :form/r]
     (form/edn-form "{kernel-boot-info :boot-info kernel-read-cr0 :read-cr0 kernel-write-cr0 :write-cr0 kernel-read-cr2 :read-cr2 kernel-read-cr3 :read-cr3 kernel-write-cr3 :write-cr3 kernel-invlpg :invlpg kernel-read-cs :read-cs kernel-page-fault-handler-address :page-fault-handler-address kernel-rt-timer-handler-address :rt-timer-handler-address kernel-page-fault-recovery-handler-address :page-fault-recovery-handler-address kernel-configure-page-fault-recovery :configure-page-fault-recovery kernel-double-fault-handler-address :double-fault-handler-address kernel-undefined-opcode-handler-address :undefined-opcode-handler-address kernel-configure-double-fault-ist :configure-double-fault-ist kernel-load-gdt-tss :load-gdt-tss kernel-load-idt :load-idt kernel-probe-guard-write :probe-guard-write kernel-probe-text-write :probe-text-write kernel-probe-nx-execute :probe-nx-execute kernel-probe-recoverable-guard-write :probe-recoverable-guard-write kernel-probe-double-fault :probe-double-fault kernel-cli :cli kernel-sti :sti kernel-hlt :hlt kernel-pause :pause kernel-out-u8 :out-u8 kernel-out-u32 :out-u32 kernel-in-u8 :in-u8 kernel-in-u32 :in-u32 kernel-read-msr :read-msr kernel-write-msr :write-msr kernel-cpuid-eax :cpuid-eax kernel-cpuid-ebx :cpuid-ebx kernel-cpuid-ecx :cpuid-ecx kernel-cpuid-edx :cpuid-edx kernel-xgetbv :xgetbv kernel-read-cr4 :read-cr4 kernel-write-cr4 :write-cr4 kernel-xsetbv :xsetbv kernel-fence-load :fence-load kernel-fence-store :fence-store kernel-fence-full :fence-full kernel-rdtsc :rdtsc kernel-rdtscp :rdtscp kernel-swapgs :swapgs kernel-system-table :system-table kernel-load-ptr :load-ptr kernel-uefi-call2 :uefi-call2 kernel-jump-to :jump-to kernel-uefi-call4 :uefi-call4 kernel-uefi-call6 :uefi-call6 kernel-isr-entry-address :isr-entry-address kernel-scratch-region :scratch-region kernel-uefi-alloc-region :uefi-alloc-region}"))

;; boot-lit: the literal heads. NOT in the table above, because a privileged
;; action's operands are registers and these take a piece of the source text.
;; The value here is the `kotoba.gmir` encoding the head names.
(defn- kir-rodata-address-ops [] [:ref :form/r]
     (form/edn-form "{ucs2 :utf-16le-nul guid :guid-mixed-endian bytes-literal :hex-bytes}"))

;; `bytes-literal-length` produces a count rather than an address, so it
;; lowers to a plain constant and never reaches the pool. It is here rather
;; than folded upstream because the count has to be derived from the SAME text
;; the address is derived from -- deriving it anywhere else would be a second
;; place that has to agree about what a literal is.
nil

;; boot-scratch: the address of a function in the same module. NOT in the
;; privileged table either, and for the literal heads' reason: the operand is
;; a NAME, and a privileged action's operands are virtual registers by the
;; time this lowering is done with them.
nil

(defn- kir-runtime-ops [] [:ref :form/r]
     (form/edn-form "{pair :pair fuel-charge! :fuel-charge gas-charge! :gas-charge pair-first :pair-first pair-second :pair-second kgraph-assert! :kgraph-assert! kgraph-get :kgraph-get kgraph-count :kgraph-count kgraph-entity-at :kgraph-entity-at string-byte-length :string-byte-length string=? :string=? string-concat :string-concat string-substring :string-substring string-code-point-at :string-code-point-at vector-new-empty :vector-new-empty vector-conj :vector-conj vector-count :vector-count vector-at :vector-at vector-assoc :vector-assoc vector-drop :vector-drop vector-f64-new :vector-new-empty vector-f64-conj :vector-conj vector-f64-count :vector-count vector-f64-at :vector-at vector-f64-assoc :vector-assoc vector-f64-drop :vector-drop vector-alloc :vector-alloc vector-assoc! :vector-assoc-in-place string-index-of :string-index-of string-compare :string-compare string-fold-ascii :string-fold-ascii string-find-blank :string-find-blank string-skip-blank :string-skip-blank string-index-of-from :string-index-of-from string-compare-lines :string-compare-lines string-find-byte :string-find-byte string-append-range :string-append-range bytes-empty :vector-new-empty bytes-count :vector-count bytes-at :vector-at string-from-utf8 :string-from-utf8 bytes-from-vector-i64 :bytes-from-vector vector-i64-from-bytes :bytes-from-vector bytes-slice :bytes-slice bytes-concat :bytes-concat}"))

(defn- kir-runtime-op [h :keyword] :keyword
     (case h :pair :pair :pair-first :pair-first :pair-second :pair-second :kgraph-assert! :kgraph-assert! :kgraph-get :kgraph-get :kgraph-count :kgraph-count :kgraph-entity-at :kgraph-entity-at :string-byte-length :string-byte-length :string=? :string=? :string-concat :string-concat :string-substring :string-substring :string-code-point-at :string-code-point-at :vector-new-empty :vector-new-empty :vector-conj :vector-conj :vector-count :vector-count :vector-at :vector-at :vector-assoc :vector-assoc :vector-drop :vector-drop :vector-f64-new :vector-new-empty :vector-f64-conj :vector-conj :vector-f64-count :vector-count :vector-f64-at :vector-at :vector-f64-assoc :vector-assoc :vector-f64-drop :vector-drop :vector-alloc :vector-alloc :vector-assoc! :vector-assoc-in-place :string-index-of :string-index-of :string-compare :string-compare :string-fold-ascii :string-fold-ascii :string-find-blank :string-find-blank :string-skip-blank :string-skip-blank :string-index-of-from :string-index-of-from :string-compare-lines :string-compare-lines :string-find-byte :string-find-byte :string-append-range :string-append-range :bytes-empty :vector-new-empty :bytes-count :vector-count :bytes-at :vector-at :string-from-utf8 :string-from-utf8 :bytes-from-vector-i64 :bytes-from-vector :vector-i64-from-bytes :bytes-from-vector :bytes-slice :bytes-slice :bytes-concat :bytes-concat :none))

(defn- native-clock-request-type [] [:ref :form/r] (form/edn-form "[:variant :kotoba.clock/request [[:wall :bool] [:monotonic :bool]]]"))

(defn- native-clock-wall-type [] [:ref :form/r] (form/edn-form "[:record :kotoba.clock/wall [[:unix-millis :i64] [:observation-sequence :i64]]]"))

(defn- native-clock-monotonic-type [] [:ref :form/r] (form/edn-form "[:record :kotoba.clock/monotonic [[:nanos :i64] [:observation-sequence :i64]]]"))

(defn- native-clock-error-type [] [:ref :form/r] (form/edn-form "[:record :kotoba.clock/error [[:code :keyword] [:message :string]]]"))

(defn- native-clock-result-type [] [:ref :form/r]
     (form/edn-form "[:variant :kotoba.clock/result [[:wall [:record :kotoba.clock/wall [[:unix-millis :i64] [:observation-sequence :i64]]]] [:monotonic [:record :kotoba.clock/monotonic [[:nanos :i64] [:observation-sequence :i64]]]] [:error [:record :kotoba.clock/error [[:code :keyword] [:message :string]]]]]]"))

(defn- native-dataspace-assert-type [] [:ref :form/r] (form/edn-form "[:record :kotoba.dataspace/assert [[:assertion :document] [:facet :i64]]]"))

(defn- native-dataspace-retract-type [] [:ref :form/r] (form/edn-form "[:record :kotoba.dataspace/retract [[:assertion :document] [:facet :i64]]]"))

(defn- native-dataspace-observe-type [] [:ref :form/r] (form/edn-form "[:record :kotoba.dataspace/observe [[:pattern :document] [:facet :i64]]]"))

(defn- native-dataspace-request-type [] [:ref :form/r]
     (form/edn-form "[:variant :kotoba.dataspace/request [[:assert [:record :kotoba.dataspace/assert [[:assertion :document] [:facet :i64]]]] [:retract [:record :kotoba.dataspace/retract [[:assertion :document] [:facet :i64]]]] [:observe [:record :kotoba.dataspace/observe [[:pattern :document] [:facet :i64]]]] [:facet-enter :bool] [:facet-leave :i64]]]"))

(defn- native-dataspace-asserted-type [] [:ref :form/r] (form/edn-form "[:record :kotoba.dataspace/asserted [[:count :i64] [:notices :document]]]"))

(defn- native-dataspace-retracted-type [] [:ref :form/r] (form/edn-form "[:record :kotoba.dataspace/retracted [[:count :i64]]]"))

(defn- native-dataspace-matches-type [] [:ref :form/r] (form/edn-form "[:record :kotoba.dataspace/matches [[:bindings :document] [:notices :document]]]"))

(defn- native-dataspace-facet-type [] [:ref :form/r] (form/edn-form "[:record :kotoba.dataspace/facet [[:id :i64]]]"))

(defn- native-dataspace-error-type [] [:ref :form/r] (form/edn-form "[:record :kotoba.dataspace/error [[:code :keyword] [:message :string]]]"))

(defn- native-dataspace-result-type [] [:ref :form/r]
     (form/edn-form "[:variant :kotoba.dataspace/result [[:asserted [:record :kotoba.dataspace/asserted [[:count :i64] [:notices :document]]]] [:retracted [:record :kotoba.dataspace/retracted [[:count :i64]]]] [:matches [:record :kotoba.dataspace/matches [[:bindings :document] [:notices :document]]]] [:facet [:record :kotoba.dataspace/facet [[:id :i64]]]] [:error [:record :kotoba.dataspace/error [[:code :keyword] [:message :string]]]]]]"))

nil
(defn- native-ui-node-type [] [:ref :form/r] (form/edn-form "[:record :kotoba.ui/node [[:id :keyword] [:parent [:option :keyword]] [:kind :keyword] [:text :string]]]"))
nil
(defn- native-ui-commit-request-type [] [:ref :form/r]
     (form/edn-form "[:record :kotoba.ui/commit-request [[:base-revision :i64] [:nodes [:set [:record :kotoba.ui/node [[:id :keyword] [:parent [:option :keyword]] [:kind :keyword] [:text :string]]]]]]]"))
(defn- native-ui-commit-result-type [] [:ref :form/r] (form/edn-form "[:record :kotoba.ui/commit-result [[:revision :i64] [:node-count :i64]]]"))
(defn- native-ui-event-request-type [] [:ref :form/r] (form/edn-form "[:record :kotoba.ui/event-request [[:after-revision :i64]]]"))
(defn- native-ui-event-type [] [:ref :form/r] (form/edn-form "[:record :kotoba.ui/event [[:revision :i64] [:target :keyword] [:kind :keyword] [:value :string]]]"))
(defn- native-ui-event-result-type [] [:ref :form/r]
     (form/edn-form "[:option [:record :kotoba.ui/event [[:revision :i64] [:target :keyword] [:kind :keyword] [:value :string]]]]"))

nil

(defn- typed-capability-kind [request [:ref :form/r] result [:ref :form/r]] :keyword
     (let []
       (cond
         (and (kw? request :i64) (kw? result :i64)) :i64
         (and (kw? request :string) (kw? result :string)) :string
         (and (kw? request :option-i64) (kw? result :option-i64)) :option-i64
         (and (kw? request :result-i64) (kw? result :result-i64)) :result-i64
         (and (feq request (native-clock-request-type)) (feq result (native-clock-result-type))) :clock-v1
         (and (feq request (native-dataspace-request-type)) (feq result (native-dataspace-result-type))) :dataspace-v1
         (and (feq request (native-ui-commit-request-type)) (feq result (native-ui-commit-result-type))) :ui-commit-v1
         (and (feq request (native-ui-event-request-type)) (feq result (native-ui-event-result-type))) :ui-event-v1
         (and (kw? request :bytes) (kw? result :bytes)) :bytes-v1
         (and (kw? request :string) (kw? result :bytes)) :string-bytes-v1
         :else :none)))

(defn- capability-id [value [:ref :form/r]] :i64
     (if (and (form/is-int? value) (<= 0 (form/int-value value)) (<= (form/int-value value) 255))
       (form/int-value value)
       -1))

(defn- valid-capability-id? [value [:ref :form/r]] :bool (>= (capability-id value) 0))

(defn word-result-type? [type [:ref :form/r]] :bool
     (or (form/is-nil? type)
         (and (form/is-keyword? type)
              (let [k (form/keyword-value type)]
                (or (= k :i64) (= k :bool) (= k :f32) (= k :f64) (= k :string) (= k :keyword)
                    (= k :document) (= k :option-i64) (= k :result-i64) (= k :vector-i64)
                    (= k :vector-f64) (= k :string-index) (= k :bytes))))
         (and (form/is-vec? type) (> (form/count-of type) 0)
              (let [h (form/nth-of type 0)]
                (or (kw? h :option) (kw? h :result) (kw? h :list) (kw? h :set) (kw? h :map) (kw? h :ref))))))

(defn- scalar-literal? [form [:ref :form/r]] :bool (or (form/is-bool? form) (form/is-int? form)))

(defn- scalar-literal [form [:ref :form/r]] :i64
     (if (form/is-bool? form) (if (form/bool-value form) 1 0) (form/int-value form)))

(defn- utf8-bytes [s :string] [:list [:ref :form/r]]
     (let [n (string-byte-length s)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) acc
           (let [c (string-code-point-at s i)]
             (cond
               (< c 0x80) (recur (+ i 1) (lconj acc (intf c)))
               (< c 0x800) (recur (+ i 2) (lconj (lconj acc (intf (bit-or 0xc0 (sar c 6)))) (intf (bit-or 0x80 (bit-and c 0x3f)))))
               (< c 0x10000) (recur (+ i 3) (lconj (lconj (lconj acc (intf (bit-or 0xe0 (sar c 12))))
                                                          (intf (bit-or 0x80 (bit-and (sar c 6) 0x3f))))
                                                   (intf (bit-or 0x80 (bit-and c 0x3f)))))
               :else (recur (+ i 4) (lconj (lconj (lconj (lconj acc (intf (bit-or 0xf0 (sar c 18))))
                                                         (intf (bit-or 0x80 (bit-and (sar c 12) 0x3f))))
                                                  (intf (bit-or 0x80 (bit-and (sar c 6) 0x3f))))
                                           (intf (bit-or 0x80 (bit-and c 0x3f)))))))))))

;; literal-walk: `string-code-point-at` over an ASCII literal.
;;
;; The general operation is a runtime call (`:string-code-point-at`, context
;; slot 144) because a string VALUE is a pair(offset, length) the host resolves
;; against a runtime base -- and a kernel object HAS NO HOST: its packaged
;; context's slots are zero, so the call is a jump to address 0. Measured
;; 2026-09-16 on x86_64-aiueos-kernel-v1 under QEMU: the first kernel object
;; whose literal walk actually executed (aiueos `aes128-gcm-selftest`) died
;; with `#PF rip=0`, and four objects landed before it (`relay-hello-payload`,
;; `relay-ack-payload-valid`, `job-protocol-dispatch`,
;; `device-worker-poll-response`) walk literals the same way and had never
;; run as machine code.
;;
;; An ASCII literal needs no host: every byte is a code point, the bytes can
;; live in the code image's read-only pool (`:gmir/rodata-address`, the
;; boot-lit machinery, hex-encoded so no new encoding is needed), and the
;; access is one bounded byte load (`:gmir/kernel-load-u8`, whose window
;; check traps on an index at or past the length -- the trap `kotoba.kir`
;; and the loader's `checked_string_code_point_at` both raise). Non-ASCII
;; literals and computed strings keep the runtime call; a kernel object
;; cannot use those, and the target's admission is where that is refused.
(defn- ascii-literal? [form [:ref :form/r]] :bool
     (and (form/is-string? form)
          (let [s (form/string-value form)] (= (string-length s) (string-byte-length s)))))

(defn- literal-walk-form? [form [:ref :form/r]] :bool
     (and (head-is? form "string-code-point-at") (= 3 (fcount form)) (ascii-literal? (fnth form 1))))

nil

(defn- hex-digit [d :i64] :string (string-substring "0123456789abcdef" d (+ d 1)))

(defn- hex-of-ascii [s :string] :string
     (let [n (string-byte-length s)]
       (loop [i 0 out ""]
         (if (>= i n) out
           (let [c (string-code-point-at s i)]
             (recur (inc i) (string-concat out (string-concat (hex-digit (quot c 16)) (hex-digit (rem c 16))))))))))

(defn- literal-walk-window [n :i64] :i64
     (cond (<= n 512) 512 (<= n 4096) 4096 (<= n 16384) 16384 (<= n 65536) 65536 :else -1))

(defn- scalar-record-fields [type [:ref :form/r]] [:ref :form/r]
     (if (aggregate-abi/scalar-record-type? type) (form/nth-of type 2) (nf)))

(defn- record-value? [value [:ref :form/r]] :bool (and (form/is-map? value) (fkw= value :aggregate/kind :record)))

(defn- record-value [type [:ref :form/r] values [:list [:ref :form/r]]] [:ref :form/r]
     (map3 :aggregate/kind (kf :record) :aggregate/type type :aggregate/values (fvec values)))

(defn- scalar-variant-cases [type [:ref :form/r]] [:ref :form/r]
     (if (aggregate-abi/scalar-variant-type? type) (form/nth-of type 2) (nf)))

(defn- provider-record-fields [type [:ref :form/r]] [:ref :form/r]
     (if (or (feq type (native-clock-wall-type)) (feq type (native-clock-monotonic-type))
             (feq type (native-clock-error-type))
             (feq type (native-dataspace-assert-type)) (feq type (native-dataspace-retract-type))
             (feq type (native-dataspace-observe-type)) (feq type (native-dataspace-asserted-type))
             (feq type (native-dataspace-retracted-type)) (feq type (native-dataspace-matches-type))
             (feq type (native-dataspace-facet-type)) (feq type (native-dataspace-error-type))
             (feq type (native-ui-node-type)) (feq type (native-ui-commit-request-type))
             (feq type (native-ui-commit-result-type)) (feq type (native-ui-event-request-type))
             (feq type (native-ui-event-type)))
       (form/nth-of type 2)
       (nf)))

(defn- provider-variant-cases [type [:ref :form/r]] [:ref :form/r]
     (if (or (feq type (native-clock-request-type)) (feq type (native-clock-result-type))
             (feq type (native-dataspace-request-type)) (feq type (native-dataspace-result-type)))
       (form/nth-of type 2)
       (nf)))

(defn- variant-value? [value [:ref :form/r]] :bool (and (form/is-map? value) (fkw= value :aggregate/kind :variant)))

(defn- variant-value [type [:ref :form/r] tag [:ref :form/r] payload [:ref :form/r]] [:ref :form/r]
     (map4 :aggregate/kind (kf :variant) :aggregate/type type :variant/tag tag :variant/payload payload))

(defn- reject-lv! [phase :keyword problem :keyword instruction [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (do (reject! phase problem instruction) st))

(defn- lv [code [:list [:ref :form/r]] value [:ref :form/r] reg :i64 label :i64] [:ref :mi/lv]
     (record-new [:ref :mi/lv] code value reg label))

(defn- lv-code [r [:ref :mi/lv]] [:list [:ref :form/r]] (record-get [:ref :mi/lv] r :code))

(defn- lv-val [r [:ref :mi/lv]] [:ref :form/r] (record-get [:ref :mi/lv] r :value))

(defn- lv-reg [r [:ref :mi/lv]] :i64 (record-get [:ref :mi/lv] r :reg))

(defn- lv-label [r [:ref :mi/lv]] :i64 (record-get [:ref :mi/lv] r :label))

(defn- lv-next [st [:ref :mi/lv]] [:ref :form/r] (vreg-form (inc (lv-reg st))))

(defn- label-form [stem :string n :i64] [:ref :form/r]
     (kf (keyword-from-string (string-concat "kotoba.gmir.label/" (string-concat stem (string-concat "-" (string-from-i64 n)))))))

(defn- gm2 [op :keyword k1 :keyword v1 [:ref :form/r]] [:ref :form/r] (map2 :gmir/op (kf op) k1 v1))

(defn- gm3 [op :keyword k1 :keyword v1 [:ref :form/r] k2 :keyword v2 [:ref :form/r]] [:ref :form/r]
     (map3 :gmir/op (kf op) k1 v1 k2 v2))

(defn- gm4 [op :keyword k1 :keyword v1 [:ref :form/r] k2 :keyword v2 [:ref :form/r] k3 :keyword v3 [:ref :form/r]] [:ref :form/r]
     (map4 :gmir/op (kf op) k1 v1 k2 v2 k3 v3))

(defn- scalar-register! [value [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
     (if (vreg? value) value (reject-form! :kir-to-gmir :scalar-value-required form)))

(defn- pair-index [pairs [:ref :form/r] name [:ref :form/r]] :i64
     (let [xs (kids pairs) n (lcount xs)]
       (loop [i 0] (if (>= i n) -1 (if (feq (form/nth-of (lget xs i) 0) name) i (recur (inc i)))))))

(defn- firsts [pairs [:ref :form/r]] [:ref :form/r]
     (let [xs (kids pairs) n (lcount xs)]
       (loop [i 0 acc (lnone)] (if (>= i n) (fvec acc) (recur (inc i) (lconj acc (form/nth-of (lget xs i) 0)))))))

(defn- nso-reduce-conj [items [:list [:ref :form/r]] from :i64] [:ref :form/r]
     (let [n (lcount items)]
       (loop [i from acc (form/call0 "vector-new-empty")]
         (if (>= i n) acc (recur (inc i) (form/call2 "vector-conj" acc (lget items i)))))))

(defn- simple-kir? [x [:ref :form/r]] :bool
     (or (form/is-symbol? x) (form/is-int? x) (form/is-string? x) (form/is-keyword? x) (form/is-bool? x)))

(defn- nso-record-assoc [args [:list [:ref :form/r]]] [:ref :form/r]
     (let [type (lget args 0) value (lget args 1) field (lget args 2) replacement (lget args 3)
           names (firsts (form/nth-of type 2))]
       (if (not (fmember? names field))
         (reject-form! :kir-to-gmir :unknown-record-field type)
         (let [holder (if (form/is-symbol? value) value (symf "record__"))
               fresh (if (simple-kir? replacement) replacement (symf "assoc__"))
               b1 (if (form/is-symbol? value) (lnone) (lconj (lone holder) value))
               bindings (if (simple-kir? replacement) b1 (lconj (lconj b1 fresh) replacement))
               ns (kids names) n (lcount ns)
               built (lst (loop [i 0 acc (form/two-forms (symf "record-new") type)]
                            (if (>= i n) acc
                              (let [name (lget ns i)]
                                (recur (inc i) (lconj acc (if (feq name field) fresh
                                                            (form/call3 "record-get" type holder name))))))))]
           (if (= 0 (lcount bindings)) built (form/call2 "let" (fvec bindings) built))))))

(defn- nso-string-index-arity [op [:ref :form/r]] :i64
     (cond (sym? op "string-index-new") 0 (sym? op "string-index-count") 1
           (sym? op "string-index-contains") 2 (sym? op "string-index-get") 2
           (sym? op "string-index-assoc") 3 :else -1))

(defn- nso-step [form [:ref :form/r]] [:ref :form/r]
     (let [op (fnth form 0)
           args (form/rest-list form)
           n (lcount args)
           a0 (lget args 0) a1 (lget args 1) a2 (lget args 2)]
       (cond
         (and (sym? op "option-some") (= n 1)) (form/call2 "pair" (intf 1) a0)
         (and (sym? op "option-none") (= n 0)) (form/call2 "pair" (intf 0) (intf 0))
         (and (sym? op "option-some?") (= n 1)) (form/call1 "pair-first" a0)
         (and (sym? op "option-value") (= n 2))
         (let1 "option__" a0 (if3 (form/call1 "pair-first" (symf "option__")) (form/call1 "pair-second" (symf "option__")) a1))
         (and (sym? op "option-some-of") (= n 2)) (form/call2 "pair" (intf 1) a1)
         (and (sym? op "option-none-of") (= n 1)) (form/call2 "pair" (intf 0) (intf 0))
         (and (sym? op "option-some?-of") (= n 2)) (form/call1 "pair-first" a1)
         (and (sym? op "option-value-of") (= n 3))
         (let1 "option__" a1 (if3 (form/call1 "pair-first" (symf "option__")) (form/call1 "pair-second" (symf "option__")) a2))
         (and (sym? op "option-match") (= n 5) (form/is-symbol? (lget args 3)))
         (let1 "option__" a1 (if3 (form/call1 "pair-first" (symf "option__"))
                                  (let1 (form/symbol-value (lget args 3)) (form/call1 "pair-second" (symf "option__")) (lget args 4))
                                  a2))
         (and (sym? op "result-ok") (= n 1)) (form/call2 "pair" (intf 1) a0)
         (and (sym? op "result-err") (= n 1)) (form/call2 "pair" (intf 0) a0)
         (and (sym? op "result-ok?") (= n 1)) (form/call1 "pair-first" a0)
         (and (or (sym? op "result-value") (sym? op "result-error")) (= n 2))
         (let1 "result__" a0 (if (sym? op "result-value")
                               (if3 (form/call1 "pair-first" (symf "result__")) (form/call1 "pair-second" (symf "result__")) a1)
                               (if3 (form/call1 "pair-first" (symf "result__")) a1 (form/call1 "pair-second" (symf "result__")))))
         (and (or (sym? op "result-ok-of") (sym? op "result-err-of")) (= n 2))
         (form/call2 "pair" (intf (if (sym? op "result-ok-of") 1 0)) a1)
         (and (sym? op "result-ok?-of") (= n 2)) (form/call1 "pair-first" a1)
         (and (or (sym? op "result-value-of") (sym? op "result-error-of")) (= n 3))
         (let1 "result__" a1 (if (sym? op "result-value-of")
                               (if3 (form/call1 "pair-first" (symf "result__")) (form/call1 "pair-second" (symf "result__")) a2)
                               (if3 (form/call1 "pair-first" (symf "result__")) a2 (form/call1 "pair-second" (symf "result__")))))
         (and (sym? op "result-match-of") (= n 6) (form/is-symbol? (lget args 2)) (form/is-symbol? (lget args 4)))
         (let1 "result__" a1 (if3 (form/call1 "pair-first" (symf "result__"))
                                  (let1 (form/symbol-value (lget args 2)) (form/call1 "pair-second" (symf "result__")) (lget args 3))
                                  (let1 (form/symbol-value (lget args 4)) (form/call1 "pair-second" (symf "result__")) (lget args 5))))
         (and (or (sym? op "min") (sym? op "max")) (= n 2))
         (let2 "min_max__l" a0 "min_max__r" a1
               (if3 (form/call2 (if (sym? op "min") "<=" ">=") (symf "min_max__l") (symf "min_max__r"))
                    (symf "min_max__l") (symf "min_max__r")))
         (and (or (sym? op "vector-take") (sym? op "vector-f64-take")) (= n 2))
         (let2 "vector__" a0 "take__" a1
               (if3 (if3 (form/call2 "<" (symf "take__") (intf 0)) (intf 0)
                         (form/call2 "<=" (symf "take__") (form/call1 "vector-count" (symf "vector__"))))
                    (form/call3 "bytes-slice" (symf "vector__") (intf 0) (symf "take__"))
                    (form/call2 "vector-at" (form/call0 "vector-new-empty") (intf 0))))
         (or (sym? op "vector-new") (sym? op "vector-f64-new")) (nso-reduce-conj args 0)
         (sym? op "typed-set-new") (nso-reduce-conj args 1)
         (and (sym? op "typed-set-conj") (= n 3)) (form/call2 "vector-conj" a1 a2)
         (and (sym? op "record-assoc") (= n 4) (form/is-vec? a0) (kw? (fnth a0 0) :record))
         (nso-record-assoc args)
         (and (sym? op "typed-set-count") (= n 2)) (form/call1 "vector-count" a1)
         (and (sym? op "typed-set-nth") (= n 3)) (form/call2 "vector-at" a1 a2)
         (sym? op "typed-list-new") (nso-reduce-conj args 1)
         (and (sym? op "typed-list-conj") (= n 3)) (form/call2 "vector-conj" a1 a2)
         (and (sym? op "typed-list-nth") (= n 3)) (form/call2 "vector-at" a1 a2)
         (and (or (sym? op "vector-get") (sym? op "vector-f64-get")) (= n 3))
         (let2 "vector__" a0 "index__" a1
               (if3 (if3 (form/call2 "<" (symf "index__") (intf 0)) (intf 0)
                         (form/call2 "<" (symf "index__") (form/call1 "vector-count" (symf "vector__"))))
                    (form/call2 "vector-at" (symf "vector__") (symf "index__"))
                    a2))
         (and (sym? op "keyword-name") (= n 1))
         (let2 "keyword__" a0 "slash__" (form/call3 "string-find-byte" (symf "keyword__") (intf 47) (intf 1))
               (form/call3 "string-substring" (symf "keyword__")
                           (if3 (form/call2 "<" (symf "slash__") (intf 0)) (intf 1)
                                (if3 (form/call2 "=" (form/call1 "string-byte-length" (symf "keyword__")) (intf 2)) (intf 1)
                                     (form/call2 "+" (symf "slash__") (intf 1))))
                           (form/call1 "string-byte-length" (symf "keyword__"))))
         (and (sym? op "keyword-from-string") (= n 1)) (form/call2 "string-concat" (form/string-form ":") a0)
         (and (sym? op "document-symbol") (= n 1) (head-is? a0 "symbol") (= 2 (fcount a0)))
         (nso (form/call1 "document-symbol" (fnth a0 1)))
         (and (sym? op "string-contains?") (= n 2)) (nso (string-search/lower-contains (lst args)))
         (and (sym? op "string-replace-all") (= n 3)) (nso (string-search/lower-replace-all (lst args)))
         (and (>= (nso-string-index-arity op) 0) (= n (nso-string-index-arity op)))
         (nso (string-index-lower op (lst args)))
         (and (form/is-symbol? op) (>= (string-index-of (form/symbol-value op) "document-") 0) (fmember? (document/operations) op))
         (nso (document-lower op (lst args)))
         :else form)))

(defn- string-index-lower [op [:ref :form/r] args [:ref :form/r]] [:ref :form/r]
     (try (string-index/lower op args)
          (catch e (reject-form! :kir-to-gmir :string-index-lowering args))))

(defn- document-lower [op [:ref :form/r] args [:ref :form/r]] [:ref :form/r]
     (try (document/lower op args)
          (catch e (reject-form! :kir-to-gmir :document-lowering args))))

(defn- nso-kids [xs [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (lcount xs)) acc (nso-kids xs (inc i) (lconj acc (nso (lget xs i))))))

(defn- nso [f [:ref :form/r]] [:ref :form/r]
     (cond (form/is-seq? f) (let [g (form/form-seq (nso-kids (kids f) 0 (lnone)))]
                              (if (> (form/count-of g) 0) (nso-step g) g))
           (form/is-vec? f) (form/form-vec (nso-kids (kids f) 0 (lnone)))
           (form/is-map? f) (form/form-map (nso-kids (kids f) 0 (lnone)))
           (form/is-set? f) (form/form-set (nso-kids (kids f) 0 (lnone)))
           :else f))

(defn- normalize-surface-operations [body [:ref :form/r]] [:ref :form/r] (nso body))

(defn- pair-chain [values [:list [:ref :form/r]]] [:ref :form/r]
     (loop [i (dec (lcount values)) tail (intf 0)]
       (if (< i 0) tail (recur (dec i) (form/call2 "pair" (lget values i) tail)))))

(defn- pair-seconds [value [:ref :form/r] n :i64] [:ref :form/r]
     (loop [i 0 h value] (if (>= i n) h (recur (inc i) (form/call1 "pair-second" h)))))

(defn- pair-chain-assoc [subject [:ref :form/r] width :i64 index :i64 item [:ref :form/r]] [:ref :form/r]
     (loop [position (dec width) tail (intf 0)]
       (if (< position 0) tail
         (recur (dec position)
                (form/call2 "pair" (if (= position index) item (form/call1 "pair-first" (pair-seconds subject position))) tail)))))

(defn- variant-dispatch [tag-name :string branches [:list [:ref :form/r]]] [:ref :form/r]
     (loop [i (dec (lcount branches)) fallback (form/call2 "quot" (intf 1) (intf 0))]
       (if (< i 0) fallback
         (let [b (lget branches i)]
           (recur (dec i)
                  (if3 (form/call2 "=" (form/call1 "pair-first" (symf tag-name)) (intf i))
                       (let1 (form/symbol-value (fnth b 1)) (form/call1 "pair-second" (symf tag-name)) (fnth b 2))
                       fallback))))))

(defn- valid-branches? [cases [:ref :form/r] branches [:ref :form/r]] :bool
     (and (truthy? cases) (form/is-vec? branches)
          (feq (firsts cases) (firsts branches))
          (let [bs (kids branches) n (lcount bs)]
            (loop [i 0]
              (if (>= i n) true
                (let [b (lget bs i)]
                  (if (and (form/is-vec? b) (= 3 (fcount b)) (form/is-symbol? (fnth b 1))) (recur (inc i)) false)))))))

(defn- nsvb-step [form [:ref :form/r]] [:ref :form/r]
     (let [op (fnth form 0) args (form/rest-list form) n (lcount args)]
       (cond
         (and (sym? op "variant-new") (= n 3))
         (let [type (lget args 0) tag (lget args 1) payload (lget args 2)
               cases (scalar-variant-cases type)
               ordinal (if (truthy? cases) (pair-index cases tag) -1)]
           (if (or (not (truthy? cases)) (< ordinal 0))
             (reject-form! :variant-boundary :invalid-constructor type)
             (form/call2 "pair" (intf ordinal) payload)))
         (and (sym? op "variant-match") (= n 3))
         (let [type (lget args 0) value (lget args 1) branches (lget args 2)
               cases (scalar-variant-cases type)]
           (if (not (valid-branches? cases branches))
             (reject-form! :variant-boundary :invalid-dispatch type)
             (let1 "variant__" value (variant-dispatch "variant__" (kids branches)))))
         :else form)))

(defn- nrb-index [index [:ref :form/r] width :i64] :i64
     (if (and (form/is-int? index) (<= 0 (form/int-value index)) (< (form/int-value index) width)) (form/int-value index) -1))

(defn- nsrb-step [form [:ref :form/r]] [:ref :form/r]
     (let [op (fnth form 0) args (form/rest-list form) n (lcount args)
           a0 (lget args 0)]
       (cond
         ;; `(<= 1 n)`: a record with no fields is the empty chain, 0 (amu
         ;; ADR 0353 floor :options-map-argument), as the host's `(seq args)`.
         (and (sym? op "record-new") (<= 1 n))
         (let [fields (scalar-record-fields a0) values (ldrop args 1)]
           (if (not (and (truthy? fields) (= (fcount fields) (lcount values))))
             (reject-form! :record-boundary :invalid-constructor a0)
             (pair-chain values)))
         (and (sym? op "hetero-vector-new") (aggregate-abi/hetero-vector-type? a0))
         (let [values (ldrop args 1)]
           (if (not (= (fcount (fnth a0 1)) (lcount values)))
             (reject-form! :record-boundary :invalid-hetero-vector a0)
             (pair-chain values)))
         (and (sym? op "hetero-vector-at") (= n 3) (aggregate-abi/hetero-vector-type? a0))
         (let [index (nrb-index (lget args 2) (fcount (fnth a0 1)))]
           (if (< index 0)
             (reject-form! :record-boundary :invalid-hetero-vector-index a0)
             (form/call1 "pair-first" (pair-seconds (lget args 1) index))))
         (and (sym? op "hetero-vector-count") (= n 2) (aggregate-abi/hetero-vector-type? a0))
         (let1 "hvec__" (lget args 1) (intf (fcount (fnth a0 1))))
         (and (sym? op "hetero-vector-assoc") (= n 4) (aggregate-abi/hetero-vector-type? a0))
         (let [width (fcount (fnth a0 1)) index (nrb-index (lget args 2) width)]
           (if (< index 0)
             (reject-form! :record-boundary :invalid-hetero-vector-index a0)
             (let2 "hvec__" (lget args 1) "hvec_item__" (lget args 3)
                   (pair-chain-assoc (symf "hvec__") width index (symf "hvec_item__")))))
         (and (sym? op "record-assoc") (= n 4))
         (let [fields (scalar-record-fields a0)
               index (if (truthy? fields) (pair-index fields (lget args 2)) -1)]
           (if (< index 0)
             (reject-form! :record-boundary :invalid-update a0)
             (let2 "record__" (lget args 1) "record_item__" (lget args 3)
                   (pair-chain-assoc (symf "record__") (fcount fields) index (symf "record_item__")))))
         (and (sym? op "record-get") (= n 3))
         (let [fields (scalar-record-fields a0)
               index (if (truthy? fields) (pair-index fields (lget args 2)) -1)]
           (if (< index 0)
             (reject-form! :record-boundary :invalid-projection a0)
             (form/call1 "pair-first" (pair-seconds (lget args 1) index))))
         :else form)))

(defn- npb-step [form [:ref :form/r]] [:ref :form/r]
     (let [op (fnth form 0) args (form/rest-list form) n (lcount args)
           a0 (lget args 0)]
       (cond
         (and (sym? op "record-new") (<= 2 n) (truthy? (provider-record-fields a0)))
         (let [fields (provider-record-fields a0) values (ldrop args 1)]
           (if (not (= (fcount fields) (lcount values)))
             (reject-form! :provider-boundary :invalid-record-constructor a0)
             (pair-chain values)))
         (and (sym? op "record-get") (= n 3) (truthy? (provider-record-fields a0)))
         (let [index (pair-index (provider-record-fields a0) (lget args 2))]
           (if (< index 0)
             (reject-form! :provider-boundary :invalid-record-projection a0)
             (form/call1 "pair-first" (pair-seconds (lget args 1) index))))
         (and (sym? op "variant-new") (= n 3) (truthy? (provider-variant-cases a0)))
         (let [ordinal (pair-index (provider-variant-cases a0) (lget args 1))]
           (if (< ordinal 0)
             (reject-form! :provider-boundary :invalid-variant-constructor a0)
             (form/call2 "pair" (intf ordinal) (lget args 2))))
         (and (sym? op "variant-match") (= n 3) (truthy? (provider-variant-cases a0)))
         (let [cases (provider-variant-cases a0) branches (lget args 2)]
           (if (not (valid-branches? cases branches))
             (reject-form! :provider-boundary :invalid-variant-dispatch a0)
             (let1 "provider_variant__" (lget args 1) (variant-dispatch "provider_variant__" (kids branches)))))
         :else form)))

(defn- bw-kids [xs [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]] which :i64] [:list [:ref :form/r]]
     (if (>= i (lcount xs)) acc (bw-kids xs (inc i) (lconj acc (bw (lget xs i) which)) which)))

(defn- bw [f [:ref :form/r] which :i64] [:ref :form/r]
     (cond (form/is-seq? f) (let [g (form/form-seq (bw-kids (kids f) 0 (lnone) which))]
                              (if (= 0 (form/count-of g)) g
                                (cond (= which 1) (nsvb-step g) (= which 2) (nsrb-step g) :else (npb-step g))))
           (form/is-vec? f) (form/form-vec (bw-kids (kids f) 0 (lnone) which))
           (form/is-map? f) (form/form-map (bw-kids (kids f) 0 (lnone) which))
           (form/is-set? f) (form/form-set (bw-kids (kids f) 0 (lnone) which))
           :else f))

(defn- normalize-scalar-variant-boundary [body [:ref :form/r]] [:ref :form/r] (bw body 1))

nil

(defn- normalize-scalar-record-boundary [body [:ref :form/r]] [:ref :form/r] (bw body 2))

(defn- normalize-provider-boundary [body [:ref :form/r]] [:ref :form/r] (bw body 3))

(defn- scalar-boundary-type? [type [:ref :form/r]] :bool
     (or (word-result-type? type)
         (aggregate-abi/scalar-record-type? type)
         (aggregate-abi/scalar-variant-type? type)
         (aggregate-abi/hetero-vector-type? type)))

(defn- function-boundary-types [function [:ref :form/r]] [:ref :form/r]
     (let [params (fget function :params)
           given (fget function :param-types)
           types (if (truthy? given) (kids given)
                   (loop [i 0 acc (lnone)] (if (>= i (fcount params)) acc (recur (inc i) (lconj acc (kf :i64))))))]
       (if (= (fcount params) (lcount types))
         (fvec (lconj types (fget function :result)))
         (nf))))

(defn- tree-nodes [f [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [acc-p (lconj acc f)]
       (if (or (form/is-seq? f) (form/is-vec? f) (form/is-map? f) (form/is-set? f))
         (let [xs (kids f) n (lcount xs)]
           (loop [i 0 a acc-p] (if (>= i n) a (recur (inc i) (tree-nodes (lget xs i) a)))))
         acc-p)))

(defn- any-node? [nodes [:list [:ref :form/r]] which :i64] :bool
     (let [n (lcount nodes)]
       (loop [i 0]
         (if (>= i n) false
           (let [x (lget nodes i)
                 hit (cond (= which 0) (aggregate-abi/aggregate-payload-variant-type? x)
                           (= which 1) (aggregate-abi/nested-record-type? x)
                           (= which 2) (and (form/is-seq? x) (> (fcount x) 0)
                                            (let [h (fnth x 0)]
                                              (or (sym? h "hetero-vector-new") (sym? h "hetero-vector-at")
                                                  (sym? h "hetero-vector-count") (sym? h "hetero-vector-assoc"))))
                           ;; the record an [:option R] holds (amu ADR 0353 floor
                           ;; :native-option-record) selects the pair chain too
                           (= which 4) (and (form/is-vec? x) (= 2 (fcount x)) (kw? (fnth x 0) :option)
                                            (aggregate-abi/scalar-record-type? (fnth x 1)))
                           :else (and (head-is? x "typed-cap-call") (= 5 (fcount x))
                                      (let [kind (typed-capability-kind (fnth x 2) (fnth x 3))
                                            id (fnth x 1)]
                                        (or (and (= kind :clock-v1) (form/is-int? id) (= 7 (form/int-value id)))
                                            (and (= kind :dataspace-v1) (form/is-int? id) (= 24 (form/int-value id)))
                                            (and (= kind :ui-commit-v1) (form/is-int? id) (= 9 (form/int-value id)))
                                            (and (= kind :ui-event-v1) (form/is-int? id) (= 10 (form/int-value id)))))))]
             (if hit true (recur (inc i))))))))

(defn- some-boundary-type? [functions [:list [:ref :form/r]] which :i64 record-types [:ref :form/r]] :bool
     (let [n (lcount functions)]
       (loop [i 0]
         (if (>= i n) false
           (let [types (function-boundary-types (lget functions i))
                 ts (kids types) m (lcount ts)
                 hit (loop [j 0]
                       (if (>= j m) false
                         (let [t (lget ts j)]
                           (if (if (= which 0)
                                 (aggregate-abi/scalar-variant-type? t)
                                 (or (aggregate-abi/scalar-record-type? t)
                                     (and (form/is-vec? t) (kw? (fnth t 0) :ref)
                                          (form/form-has? record-types (fnth t 1)))))
                             true (recur (inc j))))))]
             (if hit true (recur (inc i))))))))

(defn- variant-boundary-module? [functions [:list [:ref :form/r]]] :bool
     (or (some-boundary-type? functions 0 (fmap (lnone)))
         (any-node? (tree-nodes (fvec functions) (lnone)) 0)))

(defn- module-record-types [functions [:list [:ref :form/r]]] [:ref :form/r]
     (let [nodes (tree-nodes (fvec functions) (lnone)) n (lcount nodes)]
       (loop [i 0 types (fmap (lnone))]
         (if (>= i n) types
           (let [t (lget nodes i)]
             (if (aggregate-abi/scalar-record-type? t)
               (let [name (fnth t 1) existing (form/form-get types name)]
                 (cond (form/is-nil? existing) (recur (inc i) (form/assoc-form types name t))
                       (feq existing t) (recur (inc i) types)
                       :else (do (trap!) types)))
               (recur (inc i) types)))))))

(defn- record-boundary-module? [functions [:list [:ref :form/r]] record-types [:ref :form/r]] :bool
     (let [nodes (tree-nodes (fvec functions) (lnone))]
       (or (some-boundary-type? functions 1 record-types)
           (any-node? nodes 1)
           (any-node? nodes 0)
           (any-node? nodes 4)
           (any-node? nodes 2))))

(defn- provider-boundary-module? [functions [:list [:ref :form/r]]] :bool
     (any-node? (tree-nodes (fvec functions) (lnone)) 3))

(defn- tail-constructed-record-types [body [:ref :form/r]] [:list [:ref :form/r]]
     (cond
       (not (form/is-seq? body)) (lnone)
       (head-is? body "record-new") (let [t (fnth body 1)] (if (aggregate-abi/scalar-record-type? t) (lone t) (lnone)))
       (head-is? body "let") (tail-constructed-record-types (fnth body 2))
       (head-is? body "do") (tail-constructed-record-types (form/last-of body))
       (head-is? body "if") (lcat (tail-constructed-record-types (fnth body 2)) (tail-constructed-record-types (fnth body 3)))
       :else (lnone)))

nil

nil

nil

nil

nil

nil

(defn- record-reference-mismatch [functions [:list [:ref :form/r]]] [:ref :form/r]
     (let [n (lcount functions)]
       (loop [i 0]
         (if (>= i n) (nf)
           (let [f (lget functions i) result (fget f :result)]
             (if (and (form/is-vec? result) (kw? (fnth result 0) :ref)
                      (let [ts (tail-constructed-record-types (fget f :body)) m (lcount ts)]
                        (loop [j 0] (if (>= j m) false (if (feq (fnth result 1) (fnth (lget ts j) 1)) (recur (inc j)) true)))))
               f
               (recur (inc i))))))))

(defn- gmir-source-key? [k :keyword] :bool
     (case k (:gmir/test :gmir/value :gmir/src :gmir/input :gmir/left :gmir/right :gmir/addend :gmir/base :gmir/length
              :gmir/index :gmir/stored :gmir/expected :gmir/second-base :gmir/second-length :gmir/count :gmir/offset
              :gmir/size :gmir/arguments) true false))

(defn- gmir-block-boundary? [op [:ref :form/r]] :bool
     (or (kw? op :gmir/label) (kw? op :gmir/branch-zero) (kw? op :gmir/jump)))

(defn- gmir-dce-op? [op [:ref :form/r]] :bool (or (kw? op :gmir/constant) (kw? op :gmir/add)))

(defn- gmir-direct-sources [instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [xs (form/kids-of instruction) n (vector-count xs)]
       (loop [j 0 acc (lnone)]
         (if (>= (+ j 1) n) acc
           (let [k (typed-list-nth [:list [:ref :form/r]] xs j)
                 v (typed-list-nth [:list [:ref :form/r]] xs (+ j 1))]
             (recur (+ j 2)
                    (if (and (form/is-keyword? k) (gmir-source-key? (form/keyword-value k)))
                      (cond (form/is-vec? v) (lcat acc (only-vregs (kids v)))
                            (vreg? v) (lconj acc v)
                            :else acc)
                      acc)))))))

(defn- gmir-source-registers [instruction [:ref :form/r]] [:list [:ref :form/r]]
     (let [incs (kids (fget instruction :gmir/incomings)) m (lcount incs)]
       (loop [j 0 acc (gmir-direct-sources instruction)]
         (if (>= j m) acc
           (let [v (fget (lget incs j) :gmir/value)] (recur (inc j) (if (vreg? v) (lconj acc v) acc)))))))

(defn- gmir-defs [instructions [:list [:ref :form/r]]] :vector-i64
     (let [n (lcount instructions)]
       (loop [i 0 t (vt-new)]
         (if (>= i n) t
           (let [dst (fget (lget instructions i) :gmir/dst)]
             (recur (inc i) (if (vreg? dst) (vt-put t dst i) t)))))))

(defn- gmir-def-of [instructions [:list [:ref :form/r]] defs :vector-i64 v [:ref :form/r]] [:ref :form/r]
     (let [i (vt-get defs v -1)] (if (< i 0) (nf) (lget instructions i))))

(defn- const-i64 [instructions [:list [:ref :form/r]] defs :vector-i64 v [:ref :form/r]] [:ref :form/r]
     (let [d (gmir-def-of instructions defs v)]
       (if (and (truthy? d) (fkw= d :gmir/op :gmir/constant) (form/is-int? (fget d :gmir/value)))
         (fget d :gmir/value)
         (nf))))

(defn- add-const-base [instructions [:list [:ref :form/r]] defs :vector-i64 v [:ref :form/r]] [:ref :form/r]
     (let [d (gmir-def-of instructions defs v)]
       (if (and (truthy? d) (fkw= d :gmir/op :gmir/add))
         (let [left (fget d :gmir/left) right (fget d :gmir/right)
               lk (const-i64 instructions defs left) rk (const-i64 instructions defs right)]
           (cond (and (truthy? rk) (not (truthy? lk))) (form/vec2 left rk)
                 (and (truthy? lk) (not (truthy? rk))) (form/vec2 right lk)
                 :else (nf)))
         (nf))))

(defn- alias-rename [aliases :vector-i64 v [:ref :form/r]] [:ref :form/r]
     (let [a (vt-get aliases v -1)] (if (< a 0) v (vreg-form a))))

(defn- rename-maybe [aliases :vector-i64 v [:ref :form/r]] [:ref :form/r]
     (cond (form/is-vec? v) (let [xs (kids v) n (lcount xs)]
                              (loop [i 0 acc (lnone)] (if (>= i n) (fvec acc) (recur (inc i) (lconj acc (alias-rename aliases (lget xs i)))))))
           (vreg? v) (alias-rename aliases v)
           :else v))

(defn- remap-direct-sources [instruction [:ref :form/r] aliases :vector-i64] [:ref :form/r]
     (let [xs (form/kids-of instruction) n (vector-count xs)]
       (fmap (loop [j 0 acc (lnone)]
               (if (>= (+ j 1) n) acc
                 (let [k (typed-list-nth [:list [:ref :form/r]] xs j)
                       v (typed-list-nth [:list [:ref :form/r]] xs (+ j 1))]
                   (recur (+ j 2)
                          (lconj (lconj acc k)
                                 (if (and (form/is-keyword? k) (gmir-source-key? (form/keyword-value k))) (rename-maybe aliases v) v)))))))))

(defn- remap-incomings [incs [:list [:ref :form/r]] aliases :vector-i64] [:ref :form/r]
     (let [m (lcount incs)]
       (fvec (loop [j 0 acc (lnone)]
               (if (>= j m) acc
                 (let [inc-p (lget incs j) v (fget inc-p :gmir/value)]
                   (recur (inc j) (lconj acc (if (vreg? v) (fassoc inc-p :gmir/value (alias-rename aliases v)) inc-p)))))))))

(defn- remap-gmir-sources [instruction [:ref :form/r] aliases :vector-i64] [:ref :form/r]
     (let [renamed (remap-direct-sources instruction aliases)
           incs (fget instruction :gmir/incomings)]
       (if (truthy? incs) (fassoc renamed :gmir/incomings (remap-incomings (kids incs) aliases)) renamed)))

(defn- vreg-form [n :i64] [:ref :form/r]
     (kf (keyword-from-string (string-concat "kotoba.gmir.vreg/" (string-from-i64 n)))))

(defn- g3 [op :keyword dst [:ref :form/r] left [:ref :form/r] right [:ref :form/r]] [:ref :form/r]
     (map4 :gmir/op (kf op) :gmir/dst dst :gmir/left left :gmir/right right))

(defn- gconst [dst [:ref :form/r] value [:ref :form/r]] [:ref :form/r]
     (map3 :gmir/op (kf :gmir/constant) :gmir/dst dst :gmir/value value))

(defn- distribute-const-offset-multiplies [instructions [:list [:ref :form/r]] next :i64] [:ref :mi/lv]
     (let [defs (gmir-defs instructions) n (lcount instructions)]
       (loop [i 0 out (lnone) next next]
         (if (>= i n)
           (record-new [:ref :mi/lv] out (nf) next 0)
           (let [ins (lget instructions i)]
             (if (not (fkw= ins :gmir/op :gmir/multiply))
               (recur (inc i) (lconj out ins) next)
               (let [left (fget ins :gmir/left) right (fget ins :gmir/right)
                     lk (const-i64 instructions defs left) rk (const-i64 instructions defs right)
                     ;; [base k c c-reg] or nil
                     offset (cond (and (truthy? rk) (not (truthy? lk)))
                                  (let [b (add-const-base instructions defs left)]
                                    (if (truthy? b) (form/vec4 (fnth b 0) (fnth b 1) rk right) (nf)))
                                  (and (truthy? lk) (not (truthy? rk)))
                                  (let [b (add-const-base instructions defs right)]
                                    (if (truthy? b) (form/vec4 (fnth b 0) (fnth b 1) lk left) (nf)))
                                  :else (nf))]
                 (if (not (truthy? offset))
                   (recur (inc i) (lconj out ins) next)
                   (let [product (vreg-form next) folded (vreg-form (+ next 1))
                         kc (* (form/int-value (fnth offset 1)) (form/int-value (fnth offset 2)))]
                     (recur (inc i)
                            (lconj (lconj (lconj out (g3 :gmir/multiply product (fnth offset 0) (fnth offset 3)))
                                          (gconst folded (intf kc)))
                                   (g3 :gmir/add (fget ins :gmir/dst) product folded))
                            (+ next 2)))))))))))

(defn- fold-add-of-add-const [instructions [:list [:ref :form/r]] next :i64] [:ref :mi/lv]
     (let [defs (gmir-defs instructions) n (lcount instructions)]
       (loop [i 0 out (lnone) next next]
         (if (>= i n)
           (record-new [:ref :mi/lv] out (nf) next 0)
           (let [ins (lget instructions i)]
             (if (not (fkw= ins :gmir/op :gmir/add))
               (recur (inc i) (lconj out ins) next)
               (let [left (fget ins :gmir/left) right (fget ins :gmir/right)
                     lk (const-i64 instructions defs left) rk (const-i64 instructions defs right)
                     inner (cond (truthy? rk) (add-const-base instructions defs left)
                                 (truthy? lk) (add-const-base instructions defs right)
                                 :else (nf))
                     outer-k (if (truthy? rk) rk lk)]
                 (if (not (and (truthy? inner) (truthy? outer-k)))
                   (recur (inc i) (lconj out ins) next)
                   (let [folded (vreg-form next)
                         sum (+ (form/int-value (fnth inner 1)) (form/int-value outer-k))]
                     (recur (inc i)
                            (lconj (lconj out (gconst folded (intf sum)))
                                   (g3 :gmir/add (fget ins :gmir/dst) (fnth inner 0) folded))
                            (+ next 1)))))))))))

nil

(defn- gvn-const-multiplies [instructions [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [defs (gmir-defs instructions) n (lcount instructions)
           kept (loop [i 0 mul-by (fmap (lnone)) aliases (vt-new) out (lnone)]
                  (if (>= i n)
                    (record-new [:ref :mi/lv] out (nf) 0 0)
                    (let [ins (lget instructions i) op (fget ins :gmir/op)]
                      (cond
                        (gmir-block-boundary? op) (recur (inc i) (fmap (lnone)) aliases (lconj out ins))
                        (not (kw? op :gmir/multiply)) (recur (inc i) mul-by aliases (lconj out ins))
                        :else
                        (let [left (fget ins :gmir/left) right (fget ins :gmir/right)
                              lk (const-i64 instructions defs left) rk (const-i64 instructions defs right)
                              key (cond (truthy? rk) (form/vec2 left rk) (truthy? lk) (form/vec2 right lk) :else (nf))]
                          (if (not (truthy? key))
                            (recur (inc i) mul-by aliases (lconj out ins))
                            (let [canonical (form/form-get mul-by key)]
                              (if (truthy? canonical)
                                (recur (inc i) mul-by (vt-put aliases (fget ins :gmir/dst) (vreg-num canonical)) out)
                                (recur (inc i) (form/assoc-form mul-by key (fget ins :gmir/dst)) aliases (lconj out ins))))))))))]
       (gvn-remap (record-get [:ref :mi/lv] kept :code) (gvn-aliases instructions defs))))

(defn- gvn-aliases [instructions [:list [:ref :form/r]] defs :vector-i64] :vector-i64
     (let [n (lcount instructions)]
       (loop [i 0 mul-by (fmap (lnone)) aliases (vt-new)]
         (if (>= i n) aliases
           (let [ins (lget instructions i) op (fget ins :gmir/op)]
             (cond
               (gmir-block-boundary? op) (recur (inc i) (fmap (lnone)) aliases)
               (not (kw? op :gmir/multiply)) (recur (inc i) mul-by aliases)
               :else
               (let [left (fget ins :gmir/left) right (fget ins :gmir/right)
                     lk (const-i64 instructions defs left) rk (const-i64 instructions defs right)
                     key (cond (truthy? rk) (form/vec2 left rk) (truthy? lk) (form/vec2 right lk) :else (nf))]
                 (if (not (truthy? key))
                   (recur (inc i) mul-by aliases)
                   (let [canonical (form/form-get mul-by key)]
                     (if (truthy? canonical)
                       (recur (inc i) mul-by (vt-put aliases (fget ins :gmir/dst) (vreg-num canonical)))
                       (recur (inc i) (form/assoc-form mul-by key (fget ins :gmir/dst)) aliases)))))))))))

(defn- gvn-remap [out [:list [:ref :form/r]] aliases :vector-i64] [:list [:ref :form/r]]
     (let [n (lcount out)]
       (loop [i 0 acc (lnone)] (if (>= i n) acc (recur (inc i) (lconj acc (remap-gmir-sources (lget out i) aliases)))))))

(defn- dce-used [instructions [:list [:ref :form/r]]] :vector-i64
     (let [n (lcount instructions)]
       (loop [i 0 used (vt-new)]
         (if (>= i n) used
           (let [srcs (gmir-source-registers (lget instructions i)) m (lcount srcs)]
             (recur (inc i) (loop [j 0 u used] (if (>= j m) u (recur (inc j) (vt-put u (lget srcs j) 1))))))))))

(defn- dce-gmir [instructions [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [used (dce-used instructions) n (lcount instructions)
           kept (loop [i 0 acc (lnone)]
                  (if (>= i n) acc
                    (let [ins (lget instructions i)]
                      (recur (inc i) (if (or (not (gmir-dce-op? (fget ins :gmir/op))) (vt-has? used (fget ins :gmir/dst)))
                                       (lconj acc ins) acc)))))]
       (if (= (lcount kept) n) kept (dce-gmir kept))))

(defn- rewrite-offset-multiplies [instructions [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount instructions)
           max-index (loop [i 0 m -1]
                       (if (>= i n) m
                         (let [dst (fget (lget instructions i) :gmir/dst)]
                           (recur (inc i) (if (vreg? dst) (max m (vreg-num dst)) m)))))
           d (distribute-const-offset-multiplies instructions (inc max-index))
           f (fold-add-of-add-const (record-get [:ref :mi/lv] d :code) (record-get [:ref :mi/lv] d :reg))]
       (dce-gmir (gvn-const-multiplies (record-get [:ref :mi/lv] f :code)))))

(defn- lk-const [literal [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (let [dst (lv-next st)]
       (lv (lone (gm3 :gmir/constant :gmir/dst dst :gmir/value literal)) dst (inc (lv-reg st)) (lv-label st))))

(defn- lk-string-literal [content :string st [:ref :mi/lv]] [:ref :mi/lv]
     (let [r (lv-reg st)
           address (vreg-form (+ r 1)) length (vreg-form (+ r 2)) dst (vreg-form (+ r 3))]
       (lv (lconj (lconj (lone (gm3 :gmir/data-address :gmir/dst address :gmir/content (form/string-form content)))
                         (gm3 :gmir/constant :gmir/dst length :gmir/value (intf (string-byte-length content))))
                  (gm4 :gmir/runtime-call :gmir/dst dst :gmir/runtime (kf :pair) :gmir/arguments (form/vec2 address length)))
           dst (+ r 3) (lv-label st))))

(defn- lk-binary [op :keyword l [:ref :mi/lv] r [:ref :mi/lv] form [:ref :form/r]] [:ref :mi/lv]
     (let [left (scalar-register! (lv-val l) form)
           right (scalar-register! (lv-val r) form)
           dst (lv-next r)]
       (lv (lconj (lcat (lv-code l) (lv-code r)) (g3 op dst left right)) dst (inc (lv-reg r)) (lv-label r))))

(defn- lk-signed-i32 [x [:ref :mi/lv] form [:ref :form/r]] [:ref :mi/lv]
     (let [c (lk-const (intf 32) x)
           count-register (lv-val c)
           shifted (lv-next c)
           dst (vreg-form (+ 2 (lv-reg c)))
           source (scalar-register! (lv-val x) form)]
       (lv (lconj (lconj (lcat (lv-code x) (lv-code c)) (g3 :gmir/shift-left shifted source count-register))
                  (g3 :gmir/shift-right-signed dst shifted count-register))
           dst (+ 2 (lv-reg c)) (lv-label c))))

(defn- lk-unsigned-i32 [x [:ref :mi/lv] form [:ref :form/r]] [:ref :mi/lv]
     (let [m (lk-const (intf 4294967295) x)
           dst (lv-next m)
           source (scalar-register! (lv-val x) form)]
       (lv (lconj (lcat (lv-code x) (lv-code m)) (g3 :gmir/bit-and dst source (lv-val m)))
           dst (inc (lv-reg m)) (lv-label m))))

(defn- phi2 [dst [:ref :form/r] then-exit [:ref :form/r] then-v [:ref :form/r] else-exit [:ref :form/r] else-v [:ref :form/r]] [:ref :form/r]
     (gm3 :gmir/phi :gmir/dst dst
          :gmir/incomings (form/vec2 (map2 :gmir/predecessor then-exit :gmir/value then-v)
                                     (map2 :gmir/predecessor else-exit :gmir/value else-v))))

(defn- fresh-vregs [from :i64 n :i64] [:list [:ref :form/r]]
     (loop [i 0 acc (lnone)] (if (>= i n) acc (recur (inc i) (lconj acc (vreg-form (+ from i)))))))

(defn- merge-phis [dsts [:list [:ref :form/r]] tv [:list [:ref :form/r]] ev [:list [:ref :form/r]]
                      then-exit [:ref :form/r] else-exit [:ref :form/r]] [:list [:ref :form/r]]
     (let [n (lcount dsts)]
       (loop [i 0 acc (lnone)]
         (if (>= i n) acc
           (recur (inc i) (lconj acc (phi2 (lget dsts i) then-exit (lget tv i) else-exit (lget ev i))))))))

(defn- lk-merge [then-value [:ref :form/r] else-value [:ref :form/r] then-exit [:ref :form/r] else-exit [:ref :form/r]
                    form [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (cond
       (and (vreg? then-value) (vreg? else-value))
       (let [dst (lv-next st)]
         (lv (lone (phi2 dst then-exit then-value else-exit else-value)) dst (inc (lv-reg st)) (lv-label st)))
       (and (record-value? then-value) (record-value? else-value)
            (feq (fget then-value :aggregate/type) (fget else-value :aggregate/type)))
       (let [tv (kids (fget then-value :aggregate/values)) ev (kids (fget else-value :aggregate/values))
             n (lcount tv) r (lv-reg st)]
         (if (not (= n (lcount ev)))
           (reject-lv! :kir-to-gmir :record-value-width-mismatch form st)
           (let [dsts (fresh-vregs (+ r 1) n)
                 phis (merge-phis dsts tv ev then-exit else-exit)]
             (lv phis (record-value (fget then-value :aggregate/type) dsts) (+ r n) (lv-label st)))))
       (and (variant-value? then-value) (variant-value? else-value)
            (feq (fget then-value :aggregate/type) (fget else-value :aggregate/type)))
       (let [r (lv-reg st) tag-dst (vreg-form (+ r 1)) payload-dst (vreg-form (+ r 2))]
         (lv (lconj (lone (phi2 tag-dst then-exit (fget then-value :variant/tag) else-exit (fget else-value :variant/tag)))
                    (phi2 payload-dst then-exit (fget then-value :variant/payload) else-exit (fget else-value :variant/payload)))
             (variant-value (fget then-value :aggregate/type) tag-dst payload-dst) (+ r 2) (lv-label st)))
       :else (reject-lv! :kir-to-gmir :branch-value-shape-mismatch form st)))

(defn- lk-all [forms [:list [:ref :form/r]] i :i64 env [:ref :form/r] sigs [:ref :form/r]
                  st [:ref :mi/lv] acc [:list [:ref :form/r]]] [:ref :mi/lv]
     (if (>= i (lcount forms))
       (lv (lv-code st) (fvec acc) (lv-reg st) (lv-label st))
       (let [r (lk-value (lget forms i) env sigs (lv (lnone) (nf) (lv-reg st) (lv-label st)))]
         (lk-all forms (inc i) env sigs (lv (lcat (lv-code st) (lv-code r)) (nf) (lv-reg r) (lv-label r))
                 (lconj acc (lv-val r))))))

(defn- lk-forms [forms [:list [:ref :form/r]] env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (lk-all forms 0 env sigs (lv (lnone) (nf) (lv-reg st) (lv-label st)) (lnone)))

(defn- lk-registers [values [:list [:ref :form/r]] i :i64 form [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (lcount values)) acc
       (lk-registers values (inc i) form (lconj acc (scalar-register! (lget values i) form)))))

(defn- lk-regs [r [:ref :mi/lv] form [:ref :form/r]] [:list [:ref :form/r]]
     (lk-registers (kids (lv-val r)) 0 form (lnone)))

(defn- lk-with-dst [r [:ref :mi/lv] instruction-of-dst [:ref :form/r]] [:ref :mi/lv]
     ;; INSTRUCTION-OF-DST already names (lv-next r) as its dst
     (lv (lconj (lv-code r) instruction-of-dst) (lv-next r) (inc (lv-reg r)) (lv-label r)))

(defn- fresh-st [st [:ref :mi/lv]] [:ref :mi/lv] (lv (lnone) (nf) (lv-reg st) (lv-label st)))

(defn- lk-fold [form [:ref :form/r] env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (let [op (fnth form 0)
           operands (if (and (sym? op "-") (= 2 (fcount form)))
                      (form/two-forms (intf 0) (fnth form 1))
                      (form/rest-list form))
           lowered (lk-each operands 0 env sigs st (typed-list-new [:list [:ref :mi/lv]]))
           n (lcount operands)
           gop (kir-binary-op (head-kw form))]
       (lk-fold-reduce lowered 1 n gop form (lv (lv-code (lget-lv lowered 0)) (scalar-register! (lv-val (lget-lv lowered 0)) form)
                                                (lv-reg (lget-lv lowered (dec n))) (lv-label (lget-lv lowered (dec n)))))))

(defn- lget-lv [xs [:list [:ref :mi/lv]] i :i64] [:ref :mi/lv] (typed-list-nth [:list [:ref :mi/lv]] xs i))

(defn- lk-each [forms [:list [:ref :form/r]] i :i64 env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv]
                   acc [:list [:ref :mi/lv]]] [:list [:ref :mi/lv]]
     (if (>= i (lcount forms)) acc
       (let [r (lk-value (lget forms i) env sigs (fresh-st st))]
         (lk-each forms (inc i) env sigs r (typed-list-conj [:list [:ref :mi/lv]] acc r)))))

(defn- lk-fold-reduce [lowered [:list [:ref :mi/lv]] i :i64 n :i64 gop :keyword form [:ref :form/r] acc [:ref :mi/lv]] [:ref :mi/lv]
     (if (>= i n) acc
       (let [rl (lget-lv lowered i)
             right (scalar-register! (lv-val rl) form)
             dst (lv-next acc)]
         (lk-fold-reduce lowered (inc i) n gop form
                         (lv (lconj (lcat (lv-code acc) (lv-code rl)) (g3 gop dst (lv-val acc) right)) dst (inc (lv-reg acc)) (lv-label acc))))))

(defn- lk-compare-pairs [gop :keyword registers [:list [:ref :form/r]] r0 :i64] [:list [:ref :form/r]]
     ;; comparison dsts r0+1 .. r0+(n-1)
     (let [n (lcount registers)]
       (loop [i 0 acc (lnone)]
         (if (>= (+ i 1) n) acc
           (recur (inc i) (lconj acc (g3 gop (vreg-form (+ r0 1 i)) (lget registers i) (lget registers (inc i)))))))))

(defn- lk-compare-and [code [:list [:ref :form/r]] i :i64 m :i64 r0 :i64 left [:ref :form/r] reg :i64 label :i64] [:ref :mi/lv]
     (if (>= i m)
       (lv code left reg label)
       (let [dst (vreg-form (inc reg))]
         (lk-compare-and (lconj code (g3 :gmir/bit-and dst left (vreg-form (+ r0 1 i)))) (inc i) m r0 dst (inc reg) label))))

(defn- lk-compare-chain [form [:ref :form/r] env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (let [gop (kir-binary-op (head-kw form))
           all (lk-forms (form/rest-list form) env sigs st)
           registers (lk-regs all form)
           r0 (lv-reg all)
           cmp (lk-compare-pairs gop registers r0)
           m (lcount cmp)]
       (lk-compare-and (lcat (lv-code all) cmp) 1 m r0 (vreg-form (+ r0 1)) (+ r0 m) (lv-label all))))

(defn- lk-memory [form [:ref :form/r] env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (let [spec (tget (kir-kernel-memory-ops) form)
           op (kw-of (fnth spec 0)) maximum (fnth spec 1)
           all (lk-forms (form/rest-list form) env sigs st)
           operands (lk-regs all form)
           n (lcount operands)
           dst (lv-next all)]
       (if (not (= n (if (fmember? (gmir-memory-store-ops) (kf op)) 4 3)))
         (reject-lv! :kir-to-gmir :kernel-memory-arity form all)
         (let [base (map4 :gmir/op (kf op) :gmir/dst dst :gmir/base (lget operands 0) :gmir/length (lget operands 1))
               ins (fassoc (fassoc base :gmir/index (lget operands 2)) :gmir/maximum maximum)]
           (lk-with-dst all (if (= n 4) (fassoc ins :gmir/stored (lget operands 3)) ins))))))

(defn- lk-atomic [form [:ref :form/r] env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (let [spec (tget (kir-kernel-atomic-ops) form)
           op (kw-of (fnth spec 0)) maximum (fnth spec 1) arity (form/int-value (fnth spec 2))]
       (if (not (= arity (dec (fcount form))))
         (reject-lv! :kir-to-gmir :kernel-atomic-arity form st)
         (let [all (lk-forms (form/rest-list form) env sigs st)
               operands (lk-regs all form)
               dst (lv-next all)
               base (fassoc (fassoc (map4 :gmir/op (kf op) :gmir/dst dst :gmir/base (lget operands 0) :gmir/length (lget operands 1))
                                    :gmir/index (lget operands 2))
                            :gmir/maximum maximum)]
           (lk-with-dst all (cond (= arity 4) (fassoc base :gmir/stored (lget operands 3))
                                  (= arity 5) (fassoc (fassoc base :gmir/expected (lget operands 3)) :gmir/stored (lget operands 4))
                                  :else base))))))

(defn- lk-region-pair [form [:ref :form/r] env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (let [spec (tget (kir-region-pair-ops) form)
           op (kw-of (fnth spec 0)) maximum (fnth spec 1) arity (form/int-value (fnth spec 2))]
       (if (not (= arity (dec (fcount form))))
         (reject-lv! :kir-to-gmir :kernel-dot-arity form st)
         (let [all (lk-forms (form/rest-list form) env sigs st)
               o (lk-regs all form)
               dst (lv-next all)]
           (lk-with-dst all (fassoc (fassoc (fassoc (fassoc (map4 :gmir/op (kf op) :gmir/dst dst :gmir/base (lget o 0) :gmir/length (lget o 1))
                                                            :gmir/second-base (lget o 2))
                                                    :gmir/second-length (lget o 3))
                                            :gmir/count (lget o 4))
                                    :gmir/maximum maximum))))))

(defn- lk-runtime [form [:ref :form/r] env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (let [runtime (kf (kir-runtime-op (head-kw form)))
           expected (form/form-get (gmir/runtime-operation-arities) runtime)
           all (lk-forms (form/rest-list form) env sigs st)
           registers (lk-regs all form)
           dst (lv-next all)]
       (if (not (and (form/is-int? expected) (= (form/int-value expected) (dec (fcount form)))))
         (reject-lv! :kir-to-gmir :runtime-call-arity form all)
         (lk-with-dst all (gm4 :gmir/runtime-call :gmir/dst dst :gmir/runtime runtime :gmir/arguments (fvec registers))))))

(defn- lk-privileged [form [:ref :form/r] env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (let [action (tget (kir-x86-privileged-ops) form)
           expected (form/form-get (gmir/x86-privileged-action-arities) action)
           all (lk-forms (form/rest-list form) env sigs st)
           registers (lk-regs all form)
           dst (lv-next all)]
       (if (not (and (form/is-int? expected) (= (form/int-value expected) (dec (fcount form)))))
         (reject-lv! :kir-to-gmir :x86-privileged-arity form all)
         (lk-with-dst all (gm4 :gmir/x86-privileged :gmir/dst dst :gmir/action action :gmir/arguments (fvec registers))))))

(defn- lk-literal-walk [form [:ref :form/r] env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (let [content (form/string-value (fnth form 1))
           n (string-byte-length content)
           maximum (literal-walk-window n)
           ix (lk-value (fnth form 2) env sigs (fresh-st st))
           index (scalar-register! (lv-val ix) form)
           r (lv-reg ix)
           address (vreg-form (+ r 1)) length (vreg-form (+ r 2)) dst (vreg-form (+ r 3))]
       (if (< maximum 0)
         (reject-lv! :kir-to-gmir :literal-walk-too-long form ix)
         (lv (lconj (lconj (lconj (lv-code ix)
                                  (gm4 :gmir/rodata-address :gmir/dst address :gmir/content (form/string-form (hex-of-ascii content))
                                       :gmir/rodata-encoding (kf :hex-bytes)))
                           (gm3 :gmir/constant :gmir/dst length :gmir/value (intf n)))
                    (fassoc (fassoc (map4 :gmir/op (kf :gmir/kernel-load-u8) :gmir/dst dst :gmir/base address :gmir/length length)
                                    :gmir/index index)
                            :gmir/maximum (intf maximum)))
             dst (+ r 3) (lv-label ix)))))

(defn- lk-record-new [form [:ref :form/r] env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (let [type (fnth form 1)
           fields (scalar-record-fields type)
           field-forms (ldrop (kids form) 2)]
       (cond
         (not (truthy? fields)) (reject-lv! :kir-to-gmir :unsupported-record-type form st)
         (not (= (fcount fields) (lcount field-forms))) (reject-lv! :kir-to-gmir :record-field-count-mismatch form st)
         :else (let [all (lk-forms field-forms env sigs st)]
                 (lv (lv-code all) (record-value type (lk-regs all form)) (lv-reg all) (lv-label all))))))

(defn- lk-record-get [form [:ref :form/r] env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (let [type (fnth form 1)
           fields (scalar-record-fields type)]
       (if (not (truthy? fields))
         (reject-lv! :kir-to-gmir :unsupported-record-type form st)
         (let [r (lk-value (fnth form 2) env sigs (fresh-st st))
               aggregate (lv-val r)
               field-index (pair-index fields (fnth form 3))]
           (cond
             (not (and (record-value? aggregate) (feq type (fget aggregate :aggregate/type))))
             (reject-lv! :kir-to-gmir :record-type-mismatch form r)
             (< field-index 0) (reject-lv! :kir-to-gmir :unknown-record-field form r)
             :else (lv (lv-code r) (form/nth-of (fget aggregate :aggregate/values) field-index) (lv-reg r) (lv-label r)))))))

(defn- lk-variant-new [form [:ref :form/r] env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (let [type (fnth form 1)
           cases (scalar-variant-cases type)]
       (if (not (truthy? cases))
         (reject-lv! :kir-to-gmir :unsupported-variant-type form st)
         (let [ordinal (pair-index cases (fnth form 2))]
           (if (< ordinal 0)
             (reject-lv! :kir-to-gmir :unknown-variant-case form st)
             (let [tag-register (lv-next st)
                   p (lk-value (fnth form 3) env sigs (lv (lnone) (nf) (inc (lv-reg st)) (lv-label st)))
                   payload (scalar-register! (lv-val p) form)]
               (lv (lcat (lone (gm3 :gmir/constant :gmir/dst tag-register :gmir/value (intf ordinal))) (lv-code p))
                   (variant-value type tag-register payload) (lv-reg p) (lv-label p))))))))

(defn- variant-branches-valid? [cases [:ref :form/r] branches [:ref :form/r]] :bool
     (and (form/is-vec? branches)
          (= (fcount cases) (fcount branches))
          (let [bs (kids branches) n (lcount bs)]
            (loop [i 0]
              (if (>= i n) true
                (let [b (lget bs i)]
                  (if (and (form/is-vec? b) (= 3 (fcount b)) (form/is-keyword? (fnth b 0)) (form/is-symbol? (fnth b 1)))
                    (recur (inc i)) false)))))
          (feq (firsts cases) (firsts branches))))

(defn- lk-variant-match [form [:ref :form/r] env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (let [type (fnth form 1)
           cases (scalar-variant-cases type)
           branches (fnth form 3)]
       (cond
         (not (truthy? cases)) (reject-lv! :kir-to-gmir :unsupported-variant-type form st)
         (not (variant-branches-valid? cases branches)) (reject-lv! :kir-to-gmir :invalid-variant-branches form st)
         :else
         (let [v (lk-value (fnth form 2) env sigs (fresh-st st))
               aggregate (lv-val v)]
           (if (not (and (variant-value? aggregate) (feq type (fget aggregate :aggregate/type))))
             (reject-lv! :kir-to-gmir :variant-type-mismatch form v)
             (let [match-env (form/assoc-form (form/assoc-form env (symf "$variant-tag") (form/vec2 (kf :local) (fget aggregate :variant/tag)))
                                              (symf "$variant-payload") (form/vec2 (kf :local) (fget aggregate :variant/payload)))
                   bs (kids branches) n (lcount bs)
                   last-b (lget bs (dec n))
                   dispatch (loop [i (- n 2) fallback (let1 (form/symbol-value (fnth last-b 1)) (symf "$variant-payload") (fnth last-b 2))]
                              (if (< i 0) fallback
                                (let [b (lget bs i)]
                                  (recur (dec i)
                                         (if3 (form/call2 "=" (symf "$variant-tag") (intf i))
                                              (let1 (form/symbol-value (fnth b 1)) (symf "$variant-payload") (fnth b 2))
                                              fallback)))))
                   d (lk-value dispatch match-env sigs (fresh-st v))]
               (lv (lcat (lv-code v) (lv-code d)) (lv-val d) (lv-reg d) (lv-label d))))))))

(defn- lk-if [form [:ref :form/r] env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (let [t (lk-value (fnth form 1) env sigs (fresh-st st))
           test (scalar-register! (lv-val t) form)
           l (lv-label t)
           then-label (label-form "value-if-then" (+ l 1))
           then-exit (label-form "value-if-then-exit" (+ l 2))
           else-label (label-form "value-if-else" (+ l 3))
           else-exit (label-form "value-if-else-exit" (+ l 4))
           join-label (label-form "value-if-join" (+ l 5))
           a (lk-value (fnth form 2) env sigs (lv (lnone) (nf) (lv-reg t) (+ l 5)))
           b (lk-value (fnth form 3) env sigs (fresh-st a))
           m (lk-merge (lv-val a) (lv-val b) then-exit else-exit form (fresh-st b))]
       (lv (lcat (lcat (lcat (lcat (lv-code t)
                                   (form/two-forms (gm3 :gmir/branch-zero :gmir/test test :gmir/target else-label)
                                                   (gm2 :gmir/label :gmir/id then-label)))
                             (lcat (lv-code a)
                                   (form/three-forms (gm2 :gmir/label :gmir/id then-exit)
                                                     (gm2 :gmir/jump :gmir/target join-label)
                                                     (gm2 :gmir/label :gmir/id else-label))))
                       (lcat (lv-code b)
                             (form/three-forms (gm2 :gmir/label :gmir/id else-exit)
                                               (gm2 :gmir/jump :gmir/target join-label)
                                               (gm2 :gmir/label :gmir/id join-label))))
                 (lv-code m))
           (lv-val m) (lv-reg m) (lv-label m))))

(defn- lk-bind [pairs [:list [:ref :form/r]] i :i64 env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv] form [:ref :form/r]] [:ref :mi/lv]
     (if (>= (+ i 1) (lcount pairs))
       (lv (lv-code st) env (lv-reg st) (lv-label st))
       (let [bnd (lget pairs i)]
         (if (not (form/is-symbol? bnd))
           (reject-lv! :kir-to-gmir :invalid-binding form st)
           (let [r (lk-value (lget pairs (inc i)) env sigs (fresh-st st))]
             (lk-bind pairs (+ i 2) (form/assoc-form env bnd (form/vec2 (kf :local) (lv-val r))) sigs
                      (lv (lcat (lv-code st) (lv-code r)) (nf) (lv-reg r) (lv-label r)) form))))))

(defn- let-form? [form [:ref :form/r]] :bool
     (and (head-is? form "let") (= 3 (fcount form)) (form/is-vec? (fnth form 1)) (= 0 (rem (fcount (fnth form 1)) 2))))

(defn- lk-call [form [:ref :form/r] env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (let [callee (fnth form 0)
           expected (form/form-get sigs callee)]
       (if (not (= (form/int-value expected) (dec (fcount form))))
         (reject-lv! :kir-to-gmir :call-arity-mismatch form st)
         (let [all (lk-forms (form/rest-list form) env sigs st)
               registers (lk-regs all form)
               dst (lv-next all)]
           (lk-with-dst all (gm4 :gmir/call :gmir/dst dst :gmir/callee callee :gmir/arguments (fvec registers)))))))

(defn- lk-value [form [:ref :form/r] env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (let [n (fcount form) h (head-kw form)]
       (cond
         (scalar-literal? form) (lk-const (intf (scalar-literal form)) st)
         (form/is-string? form) (lk-string-literal (form/string-value form) st)
         (form/is-keyword? form) (lk-string-literal (ktext form) st)
         (form/is-symbol? form)
         (let [entry (form/form-get env form)]
           (cond (form/is-nil? entry) (reject-lv! :kir-to-gmir :unknown-parameter form st)
                 (kw? (fnth entry 0) :local) (lv (lnone) (fnth entry 1) (lv-reg st) (lv-label st))
                 :else (let [dst (lv-next st)]
                         (lv (lone (gm3 :gmir/argument :gmir/dst dst :gmir/index (fnth entry 1))) dst (inc (lv-reg st)) (lv-label st)))))
         (not (form/is-seq? form)) (reject-lv! :kir-to-gmir :unsupported-value form st)
         (and (kir-fold-op? h) (or (> n 3) (and (= h :-) (= n 2))))
         (lk-fold form env sigs st)
         (and (kir-comparison-op? h) (> n 3)) (lk-compare-chain form env sigs st)
         (and (not (= (kir-binary-op h) :none)) (= n 3))
         (let [a (lk-value (fnth form 1) env sigs (fresh-st st))
               b (lk-value (fnth form 2) env sigs (fresh-st a))]
           (lk-binary (kir-binary-op h) a b form))
         (and (not (= (kir-predicate-op h) :none)) (= n 2))
         (let [a (lk-value (fnth form 1) env sigs (fresh-st st))
               operand (scalar-register! (lv-val a) form)
               zero (lv-next a) dst (vreg-form (+ 2 (lv-reg a)))]
           (lv (lconj (lconj (lv-code a) (gm3 :gmir/constant :gmir/dst zero :gmir/value (intf 0)))
                      (g3 (kir-predicate-op h) dst operand zero))
               dst (+ 2 (lv-reg a)) (lv-label a)))
         (and (kir-word-unary-op? h) (= n 2))
         (let [a (lk-value (fnth form 1) env sigs (fresh-st st))
               op (fnth form 0)]
           (cond (sym? op "bool-not") (lk-binary :gmir/equal a (lk-const (intf 0) (fresh-st a)) form)
                 (sym? op "bit-not") (lk-binary :gmir/bit-xor a (lk-const (intf -1) (fresh-st a)) form)
                 (sym? op "i32-wrap") (lk-signed-i32 a form)
                 :else (lk-unsigned-i32 a form)))
         (and (kir-i32-binary-op? h) (= n 3))
         (let [op (fnth form 0)
               a (lk-value (fnth form 1) env sigs (fresh-st st))
               b (lk-value (fnth form 2) env sigs (fresh-st a))]
           (cond (sym? op "i32-wrapping-add") (lk-signed-i32 (lk-binary :gmir/add a b form) form)
                 (sym? op "i32-wrapping-mul") (lk-signed-i32 (lk-binary :gmir/multiply a b form) form)
                 (sym? op "i32-xor") (lk-signed-i32 (lk-binary :gmir/bit-xor a b form) form)
                 (sym? op "i32-shift-left") (lk-signed-i32 (lk-binary :gmir/shift-left a b form) form)
                 (sym? op "i32-shift-right") (lk-i32-shift a b form :gmir/shift-right-signed)
                 :else (lk-i32-shift a b form :gmir/shift-right-unsigned)))
         (and (not (= (kir-f64-binary-op h) :none)) (= n 3))
         (let [a (lk-value (fnth form 1) env sigs (fresh-st st))
               b (lk-value (fnth form 2) env sigs (fresh-st a))]
           (lk-binary (kir-f64-binary-op h) a b form))
         (and (kir-f64-unary-op? h) (= n 2))
         (let [a (lk-value (fnth form 1) env sigs (fresh-st st)) op (fnth form 0)]
           (cond (or (sym? op "f64-from-bits") (sym? op "f64-to-bits")) a
                 (sym? op "f64-abs") (lk-binary :gmir/bit-and a (lk-const (intf 9223372036854775807) (fresh-st a)) form)
                 (sym? op "f64-neg") (lk-binary :gmir/bit-xor a (lk-const (intf (- -9223372036854775807 1)) (fresh-st a)) form)
                 :else (lk-sqrt a form :gmir/f64-sqrt)))
         (and (not (= (kir-f32-binary-op h) :none)) (= n 3))
         (let [a (lk-value (fnth form 1) env sigs (fresh-st st))
               b (lk-value (fnth form 2) env sigs (fresh-st a))]
           (lk-binary (kir-f32-binary-op h) a b form))
         (and (kir-f32-unary-op? h) (= n 2))
         (let [a (lk-value (fnth form 1) env sigs (fresh-st st)) op (fnth form 0)]
           (cond (sym? op "f32-to-bits") a
                 (sym? op "f32-from-bits") (lk-signed-i32 a form)
                 (sym? op "f32-abs") (lk-binary :gmir/bit-and a (lk-const (intf 2147483647) (fresh-st a)) form)
                 (sym? op "f32-neg") (lk-binary :gmir/bit-xor a (lk-const (intf -2147483648) (fresh-st a)) form)
                 :else (lk-sqrt a form :gmir/f32-sqrt)))
         (and (not (= (kir-f32-conversion-op h) :none)) (= n 2))
         (let [a (lk-value (fnth form 1) env sigs (fresh-st st))]
           (lk-with-dst a (gm3 (kir-f32-conversion-op h) :gmir/dst (lv-next a)
                               :gmir/input (scalar-register! (lv-val a) form))))
         (and (kir-memory-head? h) (head-in? form (kir-kernel-memory-ops)) (or (= n 4) (= n 5))) (lk-memory form env sigs st)
         (and (>= (string-index-of (keyword-name h) "kernel-") 0) (head-in? form (kir-kernel-atomic-ops))) (lk-atomic form env sigs st)
         (and (>= (string-index-of (keyword-name h) "kernel-d") 0) (head-in? form (kir-region-pair-ops))) (lk-region-pair form env sigs st)
         (and (head-is? form "kernel-subregion") (= n 5))
         (let [all (lk-forms (form/rest-list form) env sigs st)
               o (lk-regs all form)
               dst (lv-next all)]
           (lk-with-dst all (fassoc (fassoc (map4 :gmir/op (kf :gmir/kernel-subregion) :gmir/dst dst :gmir/base (lget o 0) :gmir/length (lget o 1))
                                            :gmir/offset (lget o 2))
                                    :gmir/size (lget o 3))))
         (and (case h (:ucs2 :guid :bytes-literal) true false) (head-in? form (kir-rodata-address-ops)))
         (let [encoding (tget (kir-rodata-address-ops) form)
               content (fnth form 1)
               dst (lv-next st)]
           (cond (not (= 2 n)) (reject-lv! :kir-to-gmir :rodata-literal-arity form st)
                 (not (gmir/rodata-content? encoding content)) (reject-lv! :kir-to-gmir :rodata-literal-malformed form st)
                 :else (lv (lone (gm4 :gmir/rodata-address :gmir/dst dst :gmir/content content :gmir/rodata-encoding encoding))
                           dst (inc (lv-reg st)) (lv-label st))))
         (head-is? form "bytes-literal-length")
         (let [content (fnth form 1)
               dst (lv-next st)]
           (if (not (and (= 2 n) (gmir/rodata-content? (kf :hex-bytes) content)))
             (reject-lv! :kir-to-gmir :rodata-literal-malformed form st)
             (lv (lone (gm3 :gmir/constant :gmir/dst dst :gmir/value (intf (quot (string-byte-length (form/string-value content)) 2))))
                 dst (inc (lv-reg st)) (lv-label st))))
         (head-is? form "kernel-function-address")
         (let [name (fnth form 1)
               dst (lv-next st)]
           (if (not (and (= 2 n) (form/is-symbol? name) (< (string-find-byte (form/symbol-value name) 47 0) 0)))
             (reject-lv! :kir-to-gmir :function-address-name form st)
             (lv (lone (gm3 :gmir/function-address :gmir/dst dst :gmir/function name)) dst (inc (lv-reg st)) (lv-label st))))
         (and (>= (string-index-of (keyword-name h) "kernel-") 0) (head-in? form (kir-x86-privileged-ops))) (lk-privileged form env sigs st)
         (literal-walk-form? form) (lk-literal-walk form env sigs st)
         (not (= (kir-runtime-op h) :none)) (lk-runtime form env sigs st)
         (and (head-is? form "cap-call") (= n 3))
         (let [capability (capability-id (fnth form 1))
               a (lk-value (fnth form 2) env sigs (fresh-st st))]
           (if (< capability 0)
             (reject-lv! :kir-to-gmir :invalid-capability-id form a)
             (lk-with-dst a (fassoc (gm4 :gmir/capability-call :gmir/dst (lv-next a) :gmir/capability (intf capability) :gmir/kind (kf :i64))
                                    :gmir/arguments (fvec (lone (scalar-register! (lv-val a) form)))))))
         (and (head-is? form "typed-cap-call") (= n 5))
         (let [capability (capability-id (fnth form 1))
               kind (typed-capability-kind (fnth form 2) (fnth form 3))
               a (lk-value (fnth form 4) env sigs (fresh-st st))]
           (if (or (< capability 0) (= kind :none))
             (reject-lv! :kir-to-gmir :invalid-typed-capability-call form a)
             (lk-with-dst a (fassoc (gm4 :gmir/capability-call :gmir/dst (lv-next a) :gmir/capability (intf capability) :gmir/kind (kf kind))
                                    :gmir/arguments (fvec (lone (scalar-register! (lv-val a) form)))))))
         (and (head-is? form "record-new") (<= 2 n)) (lk-record-new form env sigs st)
         (and (head-is? form "record-get") (= n 4)) (lk-record-get form env sigs st)
         (and (head-is? form "variant-new") (= n 4)) (lk-variant-new form env sigs st)
         (and (head-is? form "variant-match") (= n 4)) (lk-variant-match form env sigs st)
         (and (head-is? form "if") (= n 4)) (lk-if form env sigs st)
         (let-form? form)
         (let [b (lk-bind (kids (fnth form 1)) 0 env sigs (fresh-st st) form)
               body (lk-value (fnth form 2) (lv-val b) sigs (fresh-st b))]
           (lv (lcat (lv-code b) (lv-code body)) (lv-val body) (lv-reg body) (lv-label body)))
         (and (head-is? form "do") (> n 1))
         (let [all (lk-each (form/rest-list form) 0 env sigs (fresh-st st) (typed-list-new [:list [:ref :mi/lv]]))
               m (vector-count all)
               code (loop [i 0 acc (lnone)] (if (>= i m) acc (recur (inc i) (lcat acc (lv-code (lget-lv all i))))))
               final (lget-lv all (dec m))]
           (lv code (lv-val final) (lv-reg final) (lv-label final)))
         (and (head-is? form "arena-scope") (= n 2))
         (let [body (lk-value (fnth form 1) env sigs (fresh-st st))
               enter (lv-next body) leave (vreg-form (+ 2 (lv-reg body)))]
           (lv (lconj (lcat (lone (gm4 :gmir/runtime-call :gmir/dst enter :gmir/runtime (kf :arena-enter) :gmir/arguments (fvec (lnone))))
                            (lv-code body))
                      (gm4 :gmir/runtime-call :gmir/dst leave :gmir/runtime (kf :arena-leave) :gmir/arguments (fvec (lnone))))
               (lv-val body) (+ 2 (lv-reg body)) (lv-label body)))
         (form/form-has? sigs (fnth form 0)) (lk-call form env sigs st)
         (form/is-symbol? (fnth form 0)) (reject-lv! :aggregate-abi :call-abi-not-admitted form st)
         :else (reject-lv! :kir-to-gmir :unsupported-value form st))))

(defn- lk-i32-shift [a [:ref :mi/lv] b [:ref :mi/lv] form [:ref :form/r] op :keyword] [:ref :mi/lv]
     ;; the host lowers both operands first, then wraps the LEFT one (its constant follows B's code)
     (let [w (if (= op :gmir/shift-right-signed)
               (lk-signed-i32 (lv (lv-code a) (lv-val a) (lv-reg b) (lv-label b)) form)
               (lk-unsigned-i32 (lv (lv-code a) (lv-val a) (lv-reg b) (lv-label b)) form))]
       (lk-binary op w (lv (lv-code b) (lv-val b) (lv-reg w) (lv-label w)) form)))

(defn- lk-sqrt [a [:ref :mi/lv] form [:ref :form/r] op :keyword] [:ref :mi/lv]
     (lk-with-dst a (gm3 op :gmir/dst (lv-next a) :gmir/input (scalar-register! (lv-val a) form))))

(defn- lk-do-prefix [forms [:list [:ref :form/r]] i :i64 n :i64 env [:ref :form/r] sigs [:ref :form/r] st [:ref :mi/lv]] [:ref :mi/lv]
     (if (>= i n) st
       (let [r (lk-value (lget forms i) env sigs (fresh-st st))]
         (lk-do-prefix forms (inc i) n env sigs (lv (lcat (lv-code st) (lv-code r)) (nf) (lv-reg r) (lv-label r))))))

(defn- lk-then [prefix [:ref :mi/lv] r [:ref :mi/lv]] [:ref :mi/lv]
     (lv (lcat (lv-code prefix) (lv-code r)) (lv-val r) (lv-reg r) (lv-label r)))

(defn- lk-tail-call-code [form [:ref :form/r] all [:ref :mi/lv] nparams :i64] [:ref :mi/lv]
     (let [callee (fnth form 0)
           nargs (dec (fcount form))
           registers (fvec (lk-regs all form))
           dst (lv-next all)]
       (if (and (> nargs 5) (> nargs nparams))
         (lv (lconj (lconj (lv-code all) (gm4 :gmir/call :gmir/dst dst :gmir/callee callee :gmir/arguments registers))
                    (gm2 :gmir/return :gmir/value dst))
             (nf) (inc (lv-reg all)) (lv-label all))
         (lv (lconj (lv-code all) (gm3 :gmir/tail-call :gmir/callee callee :gmir/arguments registers))
             (nf) (lv-reg all) (lv-label all)))))

(defn- lk-tail-call [form [:ref :form/r] env [:ref :form/r] sigs [:ref :form/r] nparams :i64 st [:ref :mi/lv]] [:ref :mi/lv]
     (if (not (= (form/int-value (form/form-get sigs (fnth form 0))) (dec (fcount form))))
       (reject-lv! :kir-to-gmir :call-arity-mismatch form st)
       (lk-tail-call-code form (lk-forms (form/rest-list form) env sigs st) nparams)))

(defn- lk-tail [form [:ref :form/r] env [:ref :form/r] sigs [:ref :form/r] nparams :i64 st [:ref :mi/lv]] [:ref :mi/lv]
     (let [n (fcount form)]
       (cond
         (and (head-is? form "do") (> n 1))
         (let [exprs (form/rest-list form)
               m (lcount exprs)
               prefix (lk-do-prefix exprs 0 (dec m) env sigs (fresh-st st))]
           (lk-then prefix (lk-tail (lget exprs (dec m)) env sigs nparams (fresh-st prefix))))
         (and (head-is? form "if") (= n 4))
         (let [t (lk-value (fnth form 1) env sigs (fresh-st st))
               test (scalar-register! (lv-val t) form)
               else-label (label-form "if-else" (inc (lv-label t)))
               a (lk-tail (fnth form 2) env sigs nparams (lv (lnone) (nf) (lv-reg t) (inc (lv-label t))))
               b (lk-tail (fnth form 3) env sigs nparams (fresh-st a))]
           (lv (lcat (lcat (lconj (lv-code t) (gm3 :gmir/branch-zero :gmir/test test :gmir/target else-label))
                           (lv-code a))
                     (lcat (lone (gm2 :gmir/label :gmir/id else-label)) (lv-code b)))
               (nf) (lv-reg b) (lv-label b)))
         (let-form? form)
         (let [b (lk-bind (kids (fnth form 1)) 0 env sigs (fresh-st st) form)
               body (lk-tail (fnth form 2) (lv-val b) sigs nparams (fresh-st b))]
           (lk-then b body))
         (and (form/is-seq? form) (> n 0) (form/form-has? sigs (fnth form 0)))
         (lk-tail-call form env sigs nparams st)
         :else
         (let [r (lk-value form env sigs (fresh-st st))
               result (scalar-register! (lv-val r) form)]
           (lv (lconj (lv-code r) (gm2 :gmir/return :gmir/value result)) (nf) (lv-reg r) (lv-label r))))))

(defn- distinct-symbols? [params [:ref :form/r]] :bool
     (let [xs (kids params) n (lcount xs)]
       (loop [i 0]
         (if (>= i n) true
           (let [x (lget xs i)]
             (if (and (form/is-symbol? x) (not (lmember? (lslice xs 0 i) x))) (recur (inc i)) false))))))

(defn- valid-signatures? [sigs [:ref :form/r]] :bool
     (let [xs (kids sigs) n (lcount xs)]
       (loop [j 0]
         (if (>= (+ j 1) n) true
           (let [k (lget xs j) v (lget xs (inc j))]
             (if (and (gmir/function-id? k) (form/is-int? v) (<= 0 (form/int-value v)) (<= (form/int-value v) (gmir/max-arity)))
               (recur (+ j 2)) false))))))

(defn- any-op? [instructions [:list [:ref :form/r]] a :keyword b :keyword] :bool
     (let [n (lcount instructions)]
       (loop [i 0]
         (if (>= i n) false
           (let [op (fget (lget instructions i) :gmir/op)]
             (if (or (kw? op a) (kw? op b)) true (recur (inc i))))))))

(defn- parameter-env [params [:list [:ref :form/r]]] [:ref :form/r]
     (let [n (lcount params)]
       (loop [i 0 env (fmap (lnone))]
         (if (>= i n) env (recur (inc i) (form/assoc-form env (lget params i) (form/vec2 (kf :local) (vreg-form i))))))))

(defn- parameter-code [n :i64] [:list [:ref :form/r]]
     (loop [i 0 acc (lnone)]
       (if (>= i n) acc (recur (inc i) (lconj acc (gm3 :gmir/argument :gmir/dst (vreg-form i) :gmir/index (intf i)))))))

(defn lower-kir-expression [params [:ref :form/r] body0 [:ref :form/r] signatures [:ref :form/r]] [:ref :form/r]
     (if (not (and (form/is-vec? params) (distinct-symbols? params)
                   (form/is-map? signatures) (valid-signatures? signatures)))
       (reject-form! :kir-to-gmir :invalid-parameters params)
       (let [body (normalize-surface-operations body0)
             ps (kids params) n (lcount ps)
             t (lk-tail body (parameter-env ps) signatures n (lv (lnone) (nf) (dec n) -1))
             instructions (rewrite-offset-multiplies (lcat (parameter-code n) (lv-code t)))]
         (map2 :gmir/version (intf (cond (any-op? instructions :gmir/call :gmir/tail-call) 3
                                         (any-op? instructions :gmir/phi :gmir/phi) 2
                                         :else 1))
               :gmir/instructions (fvec instructions)))))

nil

(defn- gmir-valid? [p [:ref :form/r]] :bool
     (try (do (gmir/validate! p) true) (catch e false)))

(defn- function-ok? [f [:ref :form/r]] :bool
     (and (form/is-map? f)
          (gmir/function-id? (fget f :name))
          (form/is-vec? (fget f :params))
          (let [types (function-boundary-types f)]
            (and (truthy? types)
                 (let [ts (kids types) n (lcount ts)]
                   (loop [i 0] (if (>= i n) true (if (scalar-boundary-type? (lget ts i)) (recur (inc i)) false))))))))

(defn- all-functions-ok? [fs [:list [:ref :form/r]]] :bool
     (let [n (lcount fs)] (loop [i 0] (if (>= i n) true (if (function-ok? (lget fs i)) (recur (inc i)) false)))))

(defn- all-function-ids? [xs [:list [:ref :form/r]]] :bool
     (let [n (lcount xs)] (loop [i 0] (if (>= i n) true (if (gmir/function-id? (lget xs i)) (recur (inc i)) false)))))

(defn- all-distinct? [xs [:list [:ref :form/r]]] :bool
     (let [n (lcount xs)] (loop [i 0] (if (>= i n) true (if (lmember? (lslice xs 0 i) (lget xs i)) false (recur (inc i)))))))

(defn- module-signatures [fs [:list [:ref :form/r]]] [:ref :form/r]
     (let [n (lcount fs)]
       (loop [i 0 acc (fmap (lnone))]
         (if (>= i n) acc
           (let [f (lget fs i)] (recur (inc i) (form/assoc-form acc (fget f :name) (intf (fcount (fget f :params))))))))))

(defn- lower-module-function [f [:ref :form/r] signatures [:ref :form/r] provider? :bool record? :bool variant? :bool] [:ref :form/r]
     (let [b0 (fget f :body)
           b1 (if provider? (normalize-provider-boundary b0) b0)
           b2 (if record? (normalize-scalar-record-boundary b1) b1)
           b3 (if variant? (normalize-scalar-variant-boundary b2) b2)
           lowered (lower-kir-expression (fget f :params) b3 signatures)]
       (map3 :gmir/name (fget f :name) :gmir/arity (intf (fcount (fget f :params)))
             :gmir/instructions (fget lowered :gmir/instructions))))

(defn- lower-module-functions [fs [:list [:ref :form/r]] i :i64 signatures [:ref :form/r] provider? :bool record? :bool variant? :bool
                                  acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (lcount fs)) acc
       (lower-module-functions fs (inc i) signatures provider? record? variant?
                               (lconj acc (lower-module-function (lget fs i) signatures provider? record? variant?)))))

(defn- function-names [fs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (lcount fs)] (loop [i 0 acc (lnone)] (if (>= i n) acc (recur (inc i) (lconj acc (fget (lget fs i) :name)))))))

(defn- all-signed? [xs [:list [:ref :form/r]] signatures [:ref :form/r]] :bool
     (let [n (lcount xs)] (loop [i 0] (if (>= i n) true (if (form/form-has? signatures (lget xs i)) (recur (inc i)) false)))))

(defn lower-kir-module [kir [:ref :form/r]] [:ref :form/r]
     (let [functions (fget kir :functions)
           exports (fget kir :exports)
           fs (kids functions)
           xs (kids exports)
           record-types (module-record-types fs)]
       (cond
         (truthy? (record-reference-mismatch fs)) (reject-form! :record-boundary :result-schema-mismatch kir)
         (not (and (form/is-vec? functions) (> (lcount fs) 0)
                   (form/is-vec? exports) (> (lcount xs) 0)
                   (all-distinct? xs) (all-function-ids? xs)
                   (all-functions-ok? fs)))
         (reject-form! :kir-to-gmir :unsupported-function-module kir)
         :else
         (let [signatures (module-signatures fs)
               names (function-names fs)
               entry (lget xs 0)]
           (if (not (and (all-distinct? names) (all-signed? xs signatures)))
             (reject-form! :kir-to-gmir :invalid-function-module kir)
             (let [module (map3 :gmir/version (intf 3) :gmir/entry entry
                                :gmir/functions (fvec (lower-module-functions fs 0 signatures
                                                                              (provider-boundary-module? fs)
                                                                              (record-boundary-module? fs record-types)
                                                                              (variant-boundary-module? fs)
                                                                              (lnone))))]
               (if (gmir-valid? module) module (reject-form! :gmir :invalid-program module))))))))

(defn- any-instruction-op? [fs [:list [:ref :form/r]] a :keyword b :keyword] :bool
     (let [n (lcount fs)]
       (loop [i 0] (if (>= i n) false (if (any-op? (kids (fget (lget fs i) :gmir/instructions)) a b) true (recur (inc i)))))))

(defn- pilot-module-check [kir [:ref :form/r]] :bool
     (let [module (lower-kir-module kir)
           functions (kids (fget kir :functions))
           gfs (kids (fget module :gmir/functions))]
       (or (record-boundary-module? functions (module-record-types functions))
           (variant-boundary-module? functions)
           (provider-boundary-module? functions)
           (any-instruction-op? gfs :gmir/data-address :gmir/data-address)
           (any-instruction-op? gfs :gmir/call :gmir/tail-call))))

(defn pilot-module? [kir [:ref :form/r]] :bool
     (try (pilot-module-check kir) (catch e false)))

