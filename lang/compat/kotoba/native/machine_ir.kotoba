nil

nil

(defn- a64-reg [name :keyword] :i64 (a64-register (kf name)))

(defn- a64-adjust-stack [opcode :i64 frame-bytes :i64] [:list [:ref :form/r]]
     (loop [remaining frame-bytes out (lnone)]
       (if (= remaining 0) out
         (let [chunk (min remaining 4080)]
           (recur (- remaining chunk) (lcat out (u32le (bit-or opcode (shl chunk 10)))))))))

(defn- a64-stack-memory [opcode :i64 register [:ref :form/r] slot :i64] [:list [:ref :form/r]]
     (u32le (bit-or (bit-or opcode (shl slot 10)) (bit-or (shl 31 5) (a64-register register)))))

nil

(defn- a64-stack-displacement [opcode :i64 register [:ref :form/r] displacement :i64] [:list [:ref :form/r]]
     (if (not (and (= 0 (fmod displacement 8)) (<= 0 (quot displacement 8)) (<= (quot displacement 8) 4095)))
       (reject-list! :mc-encode :stack-argument-out-of-range register)
       (a64-stack-memory opcode register (quot displacement 8))))

