(defn- helpers [] [:ref :form/r] (form-edn-form helpers-text))



(defn- name-set [fs [:list [:ref :form/r]]] [:ref :form/r]
     (let [n (vector-count fs)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n) (form-form-set acc)
           (recur (inc i) (form-append-form acc (fget (typed-list-nth [:list [:ref :form/r]] fs i) :name)))))))



;; The :bytes and :link constructors and readers (root ADR-2610092310 S4).
;; Appended only when a body names one of the four operations, so a document
;; program that does not keeps the helpers (and the code) it had; they are the
;; only helpers that touch a `:bytes` handle (a vector-arena handle on native).
(def ^:private bytes-helpers-text
     "[{:name kotoba$doc-pow2, :params [n], :param-types [:i64], :result :i64, :body (if (<= n 0) 1 (* 2 (kotoba$doc-pow2 (- n 1))))} {:name kotoba$doc-text-of, :params [v], :param-types [:vector-i64], :result :string, :body (string-from-utf8 (bytes-from-vector-i64 v))} {:name kotoba$doc-hex-digit, :params [n], :param-types [:i64], :result :i64, :body (if (< n 10) (+ n 48) (+ n 87))} {:name kotoba$doc-hex-into, :params [v b i], :param-types [:vector-i64 :bytes :i64], :result :vector-i64, :body (if (>= i (bytes-count b)) v (let [x (bytes-at b i) hi (quot x 16)] (kotoba$doc-hex-into (vector-assoc! (vector-assoc! v (* 2 i) (kotoba$doc-hex-digit hi)) (+ (* 2 i) 1) (kotoba$doc-hex-digit (- x (* hi 16)))) b (+ i 1))))} {:name kotoba$doc-bytes, :params [b], :param-types [:bytes], :result :string, :body (if (> (bytes-count b) 65536) (kotoba$doc-trap) (if (= (bytes-count b) 0) \"#kotoba/bytes \\\"\\\"\" (string-concat (string-concat \"#kotoba/bytes \\\"\" (kotoba$doc-text-of (kotoba$doc-hex-into (vector-alloc (* 2 (bytes-count b))) b 0))) \"\\\"\")))} {:name kotoba$doc-unhex-into, :params [v k d i e], :param-types [:vector-i64 :i64 :string :i64 :i64], :result :vector-i64, :body (if (>= i e) v (kotoba$doc-unhex-into (vector-assoc! v k (+ (* 16 (kotoba$doc-hex (string-code-point-at d i))) (kotoba$doc-hex (string-code-point-at d (+ i 1))))) (+ k 1) d (+ i 2) e))} {:name kotoba$doc-bytes-payload, :params [d], :param-types [:string], :result :bytes, :body (let [q (+ (string-find-byte d 34 0) 1) e (- (string-byte-length d) 1)] (if (>= q e) (bytes-empty) (bytes-from-vector-i64 (kotoba$doc-unhex-into (vector-alloc (quot (- e q) 2)) 0 d q e))))} {:name kotoba$doc-varint-end, :params [b i j], :param-types [:bytes :i64 :i64], :result :i64, :body (if (>= j (bytes-count b)) -1 (if (>= (- j i) 9) -1 (let [x (bytes-at b j)] (if (< x 128) (if (if (= x 0) (> j i) false) -1 (+ j 1)) (kotoba$doc-varint-end b i (+ j 1))))))} {:name kotoba$doc-varint-value, :params [b i e mult acc], :param-types