(defn- bytes-helpers [] [:ref :form/r] (form-edn-form bytes-helpers-text))

(defn- bytes-operation? [f [:ref :form/r]] :bool
     (or (sym-is? f "document-bytes") (sym-is? f "document-bytes-value")
         (sym-is? f "document-link") (sym-is? f "document-link-value")))



(defn helper-names [] [:ref :form/r]
     (name-set (form-append-many (form-kids-of (helpers)) (form-kids-of (bytes-helpers)))))



;; The control characters 0..31, one byte each: what a `\u00XX` escape in a
;; canonical string reads back as.
(def ^:private control-json
     "\"\\u0000\\u0001\\u0002\\u0003\\u0004\\u0005\\u0006\\u0007\\u0008\\u0009\\u000a\\u000b\\u000c\\u000d\\u000e\\u000f\\u0010\\u0011\\u0012\\u0013\\u0014\\u0015\\u0016\\u0017\\u0018\\u0019\\u001a\\u001b\\u001c\\u001d\\u001e\\u001f\"")

(defn- control-text [] :string
     (option-value-of [:option :string] (document-string-value (document-edn-read control-json)) ""))



(def ^:private control-binding "kotoba$doc-control")



;; ── the surface operations ──────────────────────────────────────────────────

(defn operations
     "The document operations this lowering answers."
     [] [:ref :form/r]
     (form-form-set
      (form-kids-of
       (form-edn-form "[document-null document-bool document-i64 document-string document-keyword document-symbol document-vector document-list document-set document-map document-count document-kind document-equal? document-set-contains? document-contains document-get document-vector-at document-list-at document-set-at document-map-entry-at document-vector-assoc document-vector-conj document-vector-drop document-vector-remove document-vector-sort document-assoc document-dissoc document-merge document-string-value document-keyword-value document-symbol-value document-bool-value document-i64-value document-edn-print document-edn-read document-bytes document-bytes-value document-link document-link-value]"))))

(defn- operation? [f [:ref :form/r]] :bool
     (and (form-is-symbol? f)
          (let [ops (form-kids-of (operations))
                n (vector-count ops)]
            (loop [i 0]
              (if (>= i n) false (if (form-eq f (typed-list-nth [:list [:ref :form/r]] ops i)) true (recur (inc i))))))))



(defn- kind-keyword [i :i64] :keyword
     (case i 0 :null 1 :bool 2 :i64 3 :f64 4 :string 5 :keyword 6 :symbol 7 :vector 8 :list 9 :set 11 :bytes 12 :link :map))



(defn- require-kind [f [:ref :form/r] lo :i64 hi :i64] [:ref :form/r]
     (form-call3 "kotoba$doc-require" f (num lo) (num hi)))



(defn- joined [open :string items [:list [:ref :form/r]] close :string] [:ref :form/r]
     (let [n (vector-count items)]
       (if (= n 0)
         (str- (string-concat open close))
         (loop [i 1 acc (form-call2 "string-concat" (str- open) (typed-list-nth [:list [:ref :form/r]] items 0))]
           (if (>= i n)
             (form-call2 "string-concat" acc (str- close))
             (recur (inc i)
                    (form-call2 "string-concat" (form-call2 "string-concat" acc (str- " ")) (typed-list-nth [:list [:ref :form/r]] items i))))))))



(defn- value-of-typed [kind :i64 f [:ref :form/r] payload [:ref :form/r] value-type :keyword] [:ref :form/r]
     (let [d (sym "document__")
           t (form-vec2 (form-keyword-form :option) (form-keyword-form value-type))]
       (form-call2 "let" (form-vec2 d f)
                   (form-call3 "if" (form-call2 "=" (form-call1 "kotoba$doc-kind" d) (num kind))
                               (form-call2 "option-some-of" t payload)
                               (form-call1 "option-none-of" t)))))



(defn- fold-set [args [:list [:ref :form/r]]] [:ref :form/r]
     (let [n (vector-count args)]
       (loop [i 0 acc (str- "#{}")]
         (if (>= i n) acc (recur (inc i) (form-call2 "kotoba$doc-set-put" acc (typed-list-nth [:list [:ref :form/r]] args i)))))))

(defn- fold-map [args [:list [:ref :form/r]]] [:ref :form/r]
     (let [n (vector-count args)]
       (loop [i 0 acc (str- "{}")]
         (if (>= (+ i 1) n)
           acc
           (recur (+ i 2) (form-call4 "kotoba$doc-map-put" acc (typed-list-nth [:list [:ref :form/r]] args i) (typed-list-nth [:list [:ref :form/r]] args (+ i 1)) (form-bool-form true)))))))

(defn- value-of [kind :i64 f [:ref :form/r] payload [:ref :form/r]] [:ref :form/r]
     (value-of-typed kind f payload (kind-keyword kind)))

(defn- kind-chain [k [:ref :form/r]] [:ref :form/r]
     (loop [index 9
            acc (form-call3 "if" (form-call2 "=" k (num 11)) (form-keyword-form :bytes)
                            (form-call3 "if" (form-call2 "=" k (num 12)) (form-keyword-form :link)
                                        (form-keyword-form :map)))]
       (if (< index 0)
         acc
         (recur (dec index) (form-call3 "if" (form-call2 "=" k (num index)) (form-keyword-form (kind-keyword index)) acc)))))

(defn- fold-merge [args [:list [:ref :form/r]]] [:ref :form/r]
     (let [n (vector-count args)]
       (loop [i 1 acc (require-kind (form-nth-of (form-form-vec args) 0) 10 10)]
         (if (>= i n) acc
           (recur (inc i) (form-call2 "kotoba$doc-merge" acc (require-kind (typed-list-nth [:list [:ref :form/r]] args i) 10 10)))))))

(defn lower
     "Rewrite one document operation onto the string slots and the helpers. The
     Kotoba twin names its let-bound temporaries `document__` / `kind__` (the host
     gensyms them); they are bound around code whose operands sit in initialiser
     position, so no capture is possible."
     [op [:ref :form/r] args [:ref :form/r]] [:ref :form/r]
     (let [a (form-kids-of args)
           a0 (form-nth-of args 0)
           a1 (form-nth-of args 1)
           a2 (form-nth-of args 2)
           n (vector-count a)
           d (sym "document__")]
       (cond
         (and (or (sym-is? op "document-vector-assoc") (sym-is? op "document-assoc")) (< n 3))
         (throw (ex-info "native document operation missing an argument"
                         {:phase :native :problem :missing-argument}))
         (sym-is? op "document-null") (str- "nil")
         (sym-is? op "document-bool") (form-call3 "if" a0 (str- "true") (str- "false"))
         (sym-is? op "document-i64") (form-call1 "kotoba$doc-dec" a0)
         (sym-is? op "document-string") (form-call1 "kotoba$doc-escape" a0)
         (sym-is? op "document-keyword") a0
         (sym-is? op "document-symbol") (form-call1 "kotoba$doc-symbol" a0)
         (sym-is? op "document-vector") (if (> n 32) (trap) (form-call1 "kotoba$doc-bounded" (joined "[" a "]")))
         (sym-is? op "document-list") (if (> n 32) (trap) (form-call1 "kotoba$doc-bounded" (joined "(" a ")")))
         (sym-is? op "document-set") (if (> n 32) (trap) (fold-set a))
         (sym-is? op "document-map") (if (> n 64) (trap) (fold-map a))
         (sym-is? op "document-count")
         (form-call2 "let" (form-vec2 d (require-kind a0 7 10))
                     (form-call3 "if" (form-call2 "=" (form-call1 "kotoba$doc-kind" d) (num 10))
                                 (form-call2 "quot" (form-call1 "kotoba$doc-forms" d) (num 2))
                                 (form-call1 "kotoba$doc-forms" d)))
         (sym-is? op "document-kind")
         (let [k (sym "kind__")]
           (form-call2 "let" (form-vec2 k (form-call1 "kotoba$doc-kind" a0)) (kind-chain k)))
         (sym-is? op "document-equal?") (form-call2 "string=?" a0 a1)
         (sym-is? op "document-set-contains?") (form-call3 "kotoba$doc-set-contains" (require-kind a0 9 9) a1 (num 2))
         (sym-is? op "document-contains")
         (form-call2 ">=" (form-call3 "kotoba$doc-map-find" (require-kind a0 10 10) a1 (num 1)) (num 0))
         (sym-is? op "document-get") (form-call2 "kotoba$doc-get" (require-kind a0 10 10) a1)
         (sym-is? op "document-vector-at") (form-call2 "kotoba$doc-nth" (require-kind a0 7 7) a1)
         (sym-is? op "document-list-at") (form-call2 "kotoba$doc-nth" (require-kind a0 8 8) a1)
         (sym-is? op "document-set-at") (form-call2 "kotoba$doc-nth" (require-kind a0 9 9) a1)
         (sym-is? op "document-map-entry-at") (form-call2 "kotoba$doc-entry-at" (require-kind a0 10 10) a1)
         (sym-is? op "document-vector-assoc") (form-call3 "kotoba$doc-vector-assoc" (require-kind a0 7 7) a1 a2)
         (sym-is? op "document-vector-conj") (form-call2 "kotoba$doc-conj" (require-kind a0 7 7) a1)
         (sym-is? op "document-vector-drop") (form-call2 "kotoba$doc-vector-drop" (require-kind a0 7 7) a1)
         (sym-is? op "document-vector-remove") (form-call2 "kotoba$doc-vector-remove" (require-kind a0 7 7) a1)
         (sym-is? op "document-vector-sort") (form-call1 "kotoba$doc-vector-sort" (require-kind a0 7 7))
         (sym-is? op "document-assoc") (form-call3 "kotoba$doc-assoc" (require-kind a0 10 10) a1 a2)
         (sym-is? op "document-dissoc") (form-call2 "kotoba$doc-dissoc" (require-kind a0 10 10) a1)
         (sym-is? op "document-merge") (fold-merge a)
         (sym-is? op "document-string-value") (value-of 4 a0 (form-call1 "kotoba$doc-unescape" d))
         (sym-is? op "document-keyword-value") (value-of 5 a0 d)
         (sym-is? op "document-symbol-value") (value-of 6 a0 d)
         (sym-is? op "document-bool-value") (value-of 1 a0 (form-call2 "string=?" d (str- "true")))
         (sym-is? op "document-i64-value") (value-of 2 a0 (form-call1 "kotoba$doc-parse-i64" d))
         ;; :bytes and :link (root ADR-2610092310): the EDN tagged literals
         ;; `#kotoba/bytes \"<hex>\"` and `#kotoba/cid \"b<base32>\"`.
         (sym-is? op "document-bytes") (form-call1 "kotoba$doc-bytes" a0)
         (sym-is? op "document-bytes-value") (value-of-typed 11 a0 (form-call1 "kotoba$doc-bytes-payload" d) :bytes)
         (sym-is? op "document-link") (form-call1 "kotoba$doc-link" a0)
         (sym-is? op "document-link-value") (value-of-typed 12 a0 (form-call1 "kotoba$doc-link-payload" d) :bytes)
         (or (sym-is? op "document-edn-print") (sym-is? op "document-edn-read")) a0
         :else (throw (ex-info "unknown native document operation"
                               {:phase :native :problem :unknown-operation})))))



(defn- any-uses? [xs [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n) false (if (uses? (typed-list-nth [:list [:ref :form/r]] xs i)) true (recur (inc i)))))))

(defn- uses? [f [:ref :form/r]] :bool
     (cond
       (form-is-seq? f)
       (or (and (operation? (form-first-of f))
                (not (sym-is? (form-first-of f) "document-edn-print"))
                (not (sym-is? (form-first-of f) "document-edn-read")))
           (any-uses? (form-rest-list f)))
       (form-is-vec? f) (any-uses? (form-kids-of f))
       :else false))



(defn- any-uses-bytes? [xs [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n) false (if (uses-bytes? (typed-list-nth [:list [:ref :form/r]] xs i)) true (recur (inc i)))))))

(defn- uses-bytes? [f [:ref :form/r]] :bool
     (cond
       (form-is-seq? f)
       (or (bytes-operation? (form-first-of f))
           (any-uses-bytes? (form-rest-list f)))
       (form-is-vec? f) (any-uses-bytes? (form-kids-of f))
       :else false))



(defn- substitute-kids [xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count xs)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n) acc (recur (inc i) (form-append-form acc (substitute-control (typed-list-nth [:list [:ref :form/r]] xs i))))))))

(defn- substitute-control [f [:ref :form/r]] [:ref :form/r]
     (cond
       (sym-is? f control-binding) (str- (control-text))
       (form-is-seq? f) (form-form-seq (substitute-kids (form-kids-of f)))
       (form-is-vec? f) (form-form-vec (substitute-kids (form-kids-of f)))
       :else f))



(defn- wanted-helpers [bytes? :bool] [:list [:ref :form/r]]
     (let [hs (if bytes?
                (form-append-many (form-kids-of (helpers)) (form-kids-of (bytes-helpers)))
                (form-kids-of (helpers)))
           n (vector-count hs)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n) acc
           (let [h (typed-list-nth [:list [:ref :form/r]] hs i)]
             (recur (inc i) (form-append-form acc (form-assoc-form h (form-keyword-form :body) (substitute-control (fget h :body))))))))))

(defn- any-body-uses? [functions [:list [:ref :form/r]]] :bool
     (let [n (vector-count functions)]
       (loop [i 0]
         (if (>= i n) false (if (uses? (fget (typed-list-nth [:list [:ref :form/r]] functions i) :body)) true (recur (inc i)))))))

(defn- any-body-uses-bytes? [functions [:list [:ref :form/r]]] :bool
     (let [n (vector-count functions)]
       (loop [i 0]
         (if (>= i n) false (if (uses-bytes? (fget (typed-list-nth [:list [:ref :form/r]] functions i) :body)) true (recur (inc i)))))))

(defn- declared-named [functions [:list [:ref :form/r]] name [:ref :form/r]] [:ref :form/r]
     (let [n (vector-count functions)]
       (loop [i 0 found (form-nil-form)]
         (if (>= i n) found
           (let [f (typed-list-nth [:list [:ref :form/r]] functions i)]
             (recur (inc i) (if (form-eq (fget f :name) name) f found)))))))

(defn- declares? [functions [:list [:ref :form/r]] name [:ref :form/r]] :bool
     (let [n (vector-count functions)]
       (loop [i 0]
         (if (>= i n) false (if (form-eq (fget (typed-list-nth [:list [:ref :form/r]] functions i) :name) name) true (recur (inc i)))))))

(defn- any-clash? [functions [:list [:ref :form/r]] wanted [:list [:ref :form/r]]] :bool
     (let [n (vector-count wanted)]
       (loop [i 0]
         (if (>= i n) false
           (let [h (typed-list-nth [:list [:ref :form/r]] wanted i)
                 name (fget h :name)]
             (if (and (declares? functions name) (not (form-eq (declared-named functions name) h)))
               true
               (recur (inc i))))))))

(defn- append-missing [functions [:list [:ref :form/r]] wanted [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count wanted)]
       (loop [i 0 acc functions]
         (if (>= i n) acc
           (let [h (typed-list-nth [:list [:ref :form/r]] wanted i)]
             (recur (inc i) (if (declares? functions (fget h :name)) acc (form-append-form acc h))))))))

(defn augment-functions
     "FUNCTIONS plus the document helpers, exactly when a body uses a document
     operation this lowering answers; idempotent; a same-named different function
     aborts."
     [functions [:ref :form/r]] [:ref :form/r]
     (let [fs (form-kids-of functions)]
       (if (not (any-body-uses? fs))
         functions
         (let [wanted (wanted-helpers (any-body-uses-bytes? fs))]
           (if (any-clash? fs wanted)
             (throw (ex-info "a program function collides with a native document helper"
                             {:phase :native :problem :helper-collision}))
             (form-form-vec (append-missing fs wanted)))))))
