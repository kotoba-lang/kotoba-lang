(ns kotoba.netcap.tls-host
  "TLS client streams -- the HOST half: the driver that does the socket work
  for kotoba.netcap.tls, on each host's own TLS stack.

    JVM   JSSE (javax.net.ssl). `connect` returns the connected
          javax.net.ssl.SSLSocket with the handshake COMPLETED, SNI sent,
          and the read timeout (SO_TIMEOUT) set. Host I/O failures are thrown
          as JSSE throws them (IOException / SSLHandshakeException ...), so a
          caller's existing catch clauses keep their meaning.
    kbb   node:tls. Node sockets are asynchronous: `connect` returns a
          js/Promise of the connected tls.TLSSocket (resolved on
          'secureConnect', rejected with the Node error). The idle timeout
          (socket.setTimeout) is :timeout-ms; Node emits 'timeout' without
          closing, as it always does.

  Trust stores differ by host and that is not hidden: :system is the JDK's
  cacerts on the JVM and Node's bundled Mozilla store on kbb.

  `connect` is the host's own door: a connector over `system-driver` granted
  `:any`, exactly where kotoba.lang.process-host/sh stands for processes. Code
  that is not the host is handed a connector (kotoba.netcap.tls/connector)
  and calls kotoba.netcap.tls/connect!.

  Also here, JVM only: `ssl-context` (the javax.net.ssl.SSLContext a request's
  :trust / :identity describe, for code that must hand one to a JDK server or
  HTTP client) and `tls-exception?`."
  (:require [kotoba.lang.text :as str]
            [kotoba.netcap.tls :as tls])
  )

(defn- hex [bs]
  (str/join (map (fn [b] (let [v (bit-and (int b) 0xff)] (str (when (< v 16) "0") )))
                 bs)))

;; ---------------------------------------------------------------------------
;; JVM: JSSE
;; ---------------------------------------------------------------------------



;; ---------------------------------------------------------------------------
;; kbb: node:tls
;; ---------------------------------------------------------------------------



(def system-driver
  "The host's TLS stack as a kotoba.netcap.tls/TlsDriver."
  (reify tls/TlsDriver
    (-connect [_ req] )))

(def ^:private host-connector (tls/connector system-driver {:allow :any}))

(defn connect
  "Open a TLS client stream on the host's own TLS stack (see the ns doc):
  kotoba.netcap.tls/connect! through a connector over `system-driver`
  granted :any. JVM: the connected SSLSocket; kbb: a promise of it."
  [req]
  (tls/connect! host-connector req))
