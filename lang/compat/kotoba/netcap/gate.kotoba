(ns kotoba.netcap.gate
  "gate -- addressed on its own.

  Split out of kotoba.lang.netcap on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.lang.wit :as w]
            [kotoba.netcap.surface-cap :refer [surface-cap]])
)

(defn gate [mgr surface]
  (when (w/allows? (:policy mgr) (surface-cap surface))
    (get-in mgr [:drivers surface])))
