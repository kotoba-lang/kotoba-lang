(ns kotoba.netcap.net
  "INet -- addressed on its own.

  Split out of kotoba.lang.netcap on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  )

(defprotocol Net
  (connect  [net host port])
  (read-net [net handle])
  (write-net [net handle data])
  (close-net [net handle])
  (send-udp [net host port data])
  (recv-udp [net handle timeout])
  (resolve  [net hostname]))
