;; kotoba.lang.edn -- a FORWARDING wrapper over `kotoba.edn`, the same alias
;; shape as kotoba.text over kotoba.string. The name the callers require
;; (`kotoba.lang.edn`) is the lang/* family; the implementation lives at
;; `kotoba.edn` (whose `read-document` is the language's inert EDN reader,
;; documented there against clojure.edn).

(ns kotoba.lang.edn
  (:require [kotoba.edn :as edn])
  (:export [read-document]))

(defn read-document [s :string] :document
  (edn/read-document s))
