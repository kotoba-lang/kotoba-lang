(ns kotoba.lang.io.file
  "The portable subset of clojure.java.io: path construction and the two
  filesystem operations that answer with a value rather than a stream.

    file  as-file  as-relative-path  make-parents  delete-file

  JVM: each var IS clojure.java.io's (delegation, not a re-implementation), so
  a JVM caller gets the same java.io.File and the same exceptions as before.

  ClojureScript on Node (the kbb engine): a file is its PATH STRING, built by
  java.io.File's own normalisation (UnixFileSystem.normalize / resolve), so
  `(str (file ...))` is the same string on both hosts. Measured against JVM
  clojure.java.io 2026-09-24 (every literal in test/kotoba/lang/io/file_test):

    (file \"a//b/\")      \"a/b\"        (file \"\" \"b\")   \"/b\"
    (file \"a\" \"\")       \"a\"          (file \"\" \"\")    \"/\"
    (file \"a\" \"/b\")     throws \"/b is not a relative path\"
    (file \"a\" nil)      throws        (file nil \"b\")  \"b\"
    (file \"./a/../b\")   \"./a/../b\"   (no .. resolution, unlike path.join)
    (make-parents p)    true created / false already there or blocked / nil no parent
    (delete-file p s)   true deleted (a file or an EMPTY directory) / s when s is
                        truthy / otherwise throws \"Couldn't delete <p>\"

  The java.io.File METHODS, as functions of a file value (see the section
  below): exists? file? directory? hidden? absolute? file-name path parent
  parent-file absolute-path absolute-file canonical-path canonical-file mkdir
  mkdirs delete create-new-file rename-to length last-modified
  set-last-modified list-names list-files can-read? can-write? can-execute?,
  and file-seq. scripts/migrate-java-io-file-interop-to-kotoba-io.cljk
  (com-junkawasaki/root) rewrites `(.exists f)` to `(io/exists? f)` with them.

  NOT here, on purpose (a caller of these keeps clojure.java.io; see
  scripts/migrate-clojure-java-io-to-kotoba-io.cljk in com-junkawasaki/root):
  reader writer input-stream output-stream (streams), resource (the JVM
  classpath), as-url (java.net.URL), copy (kotoba.io/copy is the IReader/IWriter
  drain, a different function), and the File methods with no portable answer
  (toPath toURI toURL deleteOnExit compareTo get*Space set*able setReadOnly)."
  (:refer-clojure :exclude [file-seq])
  )



(declare mkdirs)

;; ---------------------------------------------------------------------------
;; java.io.UnixFileSystem, transcribed
;; ---------------------------------------------------------------------------









;; ---------------------------------------------------------------------------
;; the public surface
;; ---------------------------------------------------------------------------

(defn as-file
  "clojure.java.io/as-file. JVM: a java.io.File. Node: the normalised path
  string. nil -> nil."
  [x]
  )

(defn as-relative-path
  "clojure.java.io/as-relative-path: the path, or throws when it is absolute."
  [x]
  )

(defn file
  "clojure.java.io/file. JVM: a java.io.File. Node: its path string."
  ([arg]
   )
  ([parent child]
   )
  ([parent child & more]
   (reduce file (file parent child) more)))

(defn make-parents
  "clojure.java.io/make-parents: mkdir -p the parent of (apply file f more).
  true when directories were created, false when they already existed or
  could not be made, nil when the path has no parent."
  [f & more]
  )

(defn delete-file
  "clojure.java.io/delete-file: delete a file or an EMPTY directory. true on
  success; otherwise `silently` when it is truthy, else throws
  \"Couldn't delete <f>\"."
  [f & [silently]]
  )

;; ---------------------------------------------------------------------------
;; java.io.File methods, as functions of a file value
;;
;; Each is the java.io.File method of the same answer:
;;
;;   exists? file? directory? hidden? absolute?      .exists .isFile .isDirectory .isHidden .isAbsolute
;;   file-name path parent parent-file               .getName .getPath .getParent .getParentFile
;;   absolute-path absolute-file                     .getAbsolutePath .getAbsoluteFile
;;   canonical-path canonical-file                   .getCanonicalPath .getCanonicalFile
;;   mkdir mkdirs delete create-new-file rename-to   .mkdir .mkdirs .delete .createNewFile .renameTo
;;   length last-modified set-last-modified          .length .lastModified .setLastModified
;;   list-names list-files                           .list .listFiles
;;   can-read? can-write? can-execute?               .canRead .canWrite .canExecute
;;   file-seq                                        clojure.core/file-seq
;;
;; JVM: the method itself, on (as-file f) -- so a java.io.File answers exactly
;; as before and a path string is accepted too. nil throws, as the method call
;; on nil did (NullPointerException on the JVM, ex-info on Node).
;;
;; Node: f is the path string kotoba.io/file makes (or any path string). The
;; answer is java.io.UnixFileSystem's, transcribed: the same syscalls where a
;; syscall answers (stat, lstat, access, mkdir, rmdir/unlink, rename,
;; open(O_CREAT|O_EXCL), realpath(3) via fs.realpathSync.native, readdir in
;; directory order via fs.opendirSync -- NOT fs.readdirSync, which sorts), the
;; same string arithmetic where none does (getName, getParent, resolve against
;; user.dir = process.cwd(), canonicalize's collapse of . and ..). Measured
;; against the JVM in test/kotoba/lang/io/file_ops_test.cljk.
;;
;; list-names / list-files return a host ARRAY (String[] / File[] on the JVM,
;; a JS array on Node), nil when the file is not a listable directory, in
;; directory order on both (java.io.File promises no order).
;; ---------------------------------------------------------------------------







(defn exists?
  "java.io.File#exists."
  [f]
  )

(defn file?
  "java.io.File#isFile: a regular file (links followed)."
  [f]
  )

(defn directory?
  "java.io.File#isDirectory (links followed)."
  [f]
  )

(defn file-name
  "java.io.File#getName: the last name of the path, \"\" for \"/\" and \"\"."
  [f]
  )

(defn hidden?
  "java.io.File#isHidden (Unix: the name starts with a dot; existence is not asked)."
  [f]
  )

(defn absolute?
  "java.io.File#isAbsolute."
  [f]
  )

(defn path
  "java.io.File#getPath: the normalised path string."
  [f]
  )

(defn parent
  "java.io.File#getParent: the parent path string, or nil."
  [f]
  )

(defn parent-file
  "java.io.File#getParentFile: the parent as a file, or nil."
  [f]
  )



(defn absolute-path
  "java.io.File#getAbsolutePath: resolved against user.dir, not normalised further."
  [f]
  )

(defn absolute-file
  "java.io.File#getAbsoluteFile."
  [f]
  )







(defn canonical-path
  "java.io.File#getCanonicalPath."
  [f]
  )

(defn canonical-file
  "java.io.File#getCanonicalFile."
  [f]
  )

(defn mkdir
  "java.io.File#mkdir: true when this one directory was made."
  [f]
  )

(defn mkdirs
  "java.io.File#mkdirs, transcribed: false when it exists; else mkdir; else
  mkdirs the CANONICAL parent and mkdir the canonical file."
  [f]
  )

(defn delete
  "java.io.File#delete: a file, a link, or an EMPTY directory; true when deleted."
  [f]
  )

(defn create-new-file
  "java.io.File#createNewFile: true when created, false when it existed; throws
  otherwise (no such directory, permission)."
  [f]
  )

(defn rename-to
  "java.io.File#renameTo: rename(2); true when renamed."
  [f dest]
  )

(defn length
  "java.io.File#length: stat size (links followed), 0 when it cannot be read."
  [f]
  )

(defn last-modified
  "java.io.File#lastModified: stat mtime in whole milliseconds (truncated), 0
  when it cannot be read."
  [f]
  )

(defn set-last-modified
  "java.io.File#setLastModified: set mtime (ms), keep atime; true when set.
  A negative time throws, as the JVM does."
  [f t]
  )



(defn list-names
  "java.io.File#list: the names in the directory (a host array), nil when it
  is not a readable directory."
  [f]
  )

(defn list-files
  "java.io.File#listFiles: the children as files (a host array), nil when it
  is not a readable directory."
  [f]
  )



(defn can-read?
  "java.io.File#canRead: access(2) R_OK."
  [f]
  )

(defn can-write?
  "java.io.File#canWrite: access(2) W_OK."
  [f]
  )

(defn can-execute?
  "java.io.File#canExecute: access(2) X_OK."
  [f]
  )

(defn file-seq
  "clojure.core/file-seq: the file and, depth first, everything under it."
  [dir]
  )

;; ---------------------------------------------------------------------------
;; java.nio.file.Files, ambient: temp files, whole-file bytes, delete-if-exists
;;
;;   temp-dir         Files/createTempDirectory  ([prefix] [dir prefix])
;;   temp-file        Files/createTempFile       ([prefix suffix] [dir prefix suffix])
;;   read-all-bytes   Files/readAllBytes
;;   write-bytes      Files/write (Path, byte[], OpenOption...)
;;   write-string     Files/writeString (Path, CharSequence, UTF_8, OpenOption...)
;;   delete-if-exists Files/deleteIfExists
;;
;; A path argument is a file value (what `file` makes) or a path string; a
;; returned path is a file value (java.io.File on the JVM, its path string on
;; Node) -- never a java.nio.file.Path. No FileAttribute: the JDK's default
;; for temp files (0600) and temp directories (0700) is what both hosts give.
;; Open options are a collection of keywords, the subset of
;; StandardOpenOption that means the same on both hosts:
;;
;;   :append :create :truncate-existing :write
;;
;; none given = the JDK default, CREATE + TRUNCATE_EXISTING + WRITE.
;;
;; JVM: each IS the Files method (the same exceptions). Node: the same
;; syscalls (mkdir 0700, open O_CREAT|O_EXCL 0600, open with the option
;; flags 0666, lstat + unlink/rmdir), the name TempFileHelper makes (prefix +
;; an unsigned random long in decimal + suffix, a suffix of nil = ".tmp" for
;; files), and the JDK's exceptions as ex-info whose message is the JDK
;; exception's getMessage and whose ex-data :kotoba.io/exception names its
;; class. read-all-bytes answers a host byte array: byte[] on the JVM, an
;; Int8Array on Node (what kbb's (.getBytes s) gives -- signed, like byte[]).
;; Measured against JDK 21 in test/kotoba/lang/io/files_test.cljk.
;; ---------------------------------------------------------------------------







(def ^:private open-option-keys #{:append :create :truncate-existing :write})

(defn- check-options! [opts]
  (doseq [o opts]
    (when-not (contains? open-option-keys o)
      (throw (ex-info (str "Unsupported open option " (pr-str o) " (kotoba.io supports "
                           ":append :create :truncate-existing :write)")
                      {:kotoba.io/op :write :option o}))))
  opts)















(defn temp-dir
  "Files/createTempDirectory: a new directory (mode 0700) named prefix + a
  random number, in `dir` or the host's temporary directory
  (java.io.tmpdir / os.tmpdir()). A nil prefix is \"\". Returns the file value."
  ([prefix]
   )
  ([dir prefix]
   ))



(defn temp-file
  "Files/createTempFile: a new empty file (mode 0600) named prefix + a random
  number + suffix (nil suffix = \".tmp\"), in `dir` or the host's temporary
  directory. Returns the file value."
  ([prefix suffix]
   )
  ([dir prefix suffix]
   ))

(defn read-all-bytes
  "Files/readAllBytes: the file's bytes as a host byte array (byte[] on the
  JVM, Int8Array on Node)."
  [f]
  )





(defn write-bytes
  "Files/write (Path, byte[], OpenOption...): write `bytes` (byte[] on the
  JVM; on Node a typed array or a sequence of byte values) to f. `opts` is a
  collection of :append :create :truncate-existing :write; none = CREATE +
  TRUNCATE_EXISTING + WRITE. Returns the file value."
  ([f bytes] (write-bytes f bytes nil))
  ([f bytes opts]
   ))

(defn write-string
  "Files/writeString (Path, CharSequence, UTF_8, OpenOption...): `s` encoded
  as UTF-8; a string that is not well-formed UTF-16 (a lone surrogate) throws,
  as the JDK encoder does (UnmappableCharacterException, \"Input length = 1\"). Options as write-bytes. Returns the file value."
  ([f s] (write-string f s nil))
  ([f s opts]
   ))

(defn delete-if-exists
  "Files/deleteIfExists: true when f (a file, a link -- not its target -- or an
  EMPTY directory) was deleted, false when there was nothing. A non-empty
  directory throws (DirectoryNotEmptyException; ex-info on Node)."
  [f]
  )
