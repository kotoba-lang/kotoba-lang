(ns kotoba.lang.repo-file
  "A repository file as text, on both hosts.

  The loaders here (authority-claims, conformance-matrix, surface-matrix,
  cli-adapter-matrix) read lang/*.edn by path. Their ClojureScript branches
  threw, so every test that reached one could only run on the JVM (root
  ADR-2610100200 group D). kotoba.io reads a file's bytes on Node as well;
  this decodes them as UTF-8."
  (:require [kotoba.io :as io]))

(defn slurp-text
  "The text of the repository file at PATH (relative to the working
  directory, or on the JVM a classpath resource). WHAT names it in the
  refusal when it is missing."
  [path what]
  )
