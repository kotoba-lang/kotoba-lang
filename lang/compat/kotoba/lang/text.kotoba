;; kotoba.lang.text -- the GUEST-ROUTE twin of `kotoba-lang/text`'s
;; `kotoba.lang.text` (the `.cljk` host library), forwarding to
;; `kotoba.string` / `kotoba.string.join`. Same shape as `clojure.string`'s
;; shim beside this directory, for the same reason, and with the same
;; measured limits.
;;
;; WHY THIS EXISTS (adr-2609111900, the self-host ceiling loop, 2026-09-12):
;; most of the compiler requires `[kotoba.lang.text :as str]`. On the host
;; runtime (nbb / JVM) that resolves to
;; `~/.gitlibs/.../text/<sha>/src/kotoba/lang/text.cljk`, whose body calls
;; host functions by qualified name in shared code (`clojure.core/format`,
;; `clojure.string/escape`, `js/parseInt`). On the self-host route -- amu's
;; project loader linking the compiler's own `.cljk` sources as guest modules
;; -- that same file is refused `qualified call is not an admitted exported
;; import`, and it always will be: host interop is a PROPERTY of that module,
;; not an implementation state. Measured at amu e595cbab, 223 sources: 42
;; modules were refused with `:source "text.cljk"`, 30 of them requiring it
;; directly -- the single largest wall, and one inside a dependency.
;;
;; So the guest route gets a module of the SAME NAME whose body is admitted.
;; A `.cljk` source keeps `[kotoba.lang.text :as str]` verbatim: the host
;; runtime keeps loading the real library (nbb's classpath never sees
;; `.kotoba`), and the project route links this one. Where the two must
;; agree is the names this module forwards, and that agreement is held by
;; `test/kotoba/lang/kotoba_lang_text_compat_test.cljk`, which calls the
;; HOST `kotoba.lang.text` as the oracle on a shared input table -- so the
;; oracle is the very function a `.cljk` author wrote against, not
;; clojure.string and not a belief about either.
;;
;; WHAT IS FORWARDED: only strict equivalents. `join` (the two-argument
;; arity), `starts-with?`, `ends-with?`, `includes?`, `blank?`, `trim`,
;; `triml`, `trimr`, `reverse`, `index-of`, `last-index-of` -- and `replace`,
;; the literal arity, which arrived in `kotoba.string` on the same day this
;; module did because 12 of the compiler's 34 `replace` call sites pass a
;; string match. Every other name of the host library is ABSENT with a
;; recorded reason in `lang/compat.edn` (`:modules :kotoba.lang.text
;; :absent`): the regex names because a `#"..."` literal is a reader
;; rejection, `split` / `split-lines` because a list of unknown length has no
;; construction, `lower` / `upper` / `capitalize` because they read the
;; host's default locale, `format` because it is variadic over untyped
;; arguments. A near-equivalent under the real name would answer, quietly,
;; wrong -- and the compiler's sources are exactly the callers that would
;; not notice.
;;
;; WHERE THE TWO DIFFER IN TYPE, AND ON PURPOSE: the host answers nil where
;; `index-of` / `last-index-of` here answer `[:option :i64]`; the host takes
;; any `coll` for `join` where this takes a `[:list :string]`; the host
;; coerces `nil` with `str` where every parameter here is `:string`. Each of
;; those is a CHECK-TIME refusal at the call site -- a module reaches its own
;; next wall -- not a different answer on an input both accept.
;;
;; FORWARDING WRAPPERS, NOT A RE-EXPORT: `(:export [name])` must name a
;; function this module defines (measured 2026-09-08,
;; `:kotoba.error/export-names-undefined`). One line per name; one
;; implementation in `kotoba.string`, which is the canonical guest string
;; library (owner, 2026-09-08).
;;
;; `join` is forwarded from `kotoba.string.join`, which is kept apart from
;; `kotoba.string` because it needs an amu that lowers `typed-list-nth`
;; (see that file's header). This module's consumers ARE the compiler's own
;; sources on the current amu, so the blast radius that keeps `join` out of
;; `clojure.string` does not apply here.
;;
;; Consumed through the ordinary project route, which needs no JVM:
;;   amu check <module>.cljk --source-path <every src root> \
;;     --source-path <this repo>/lang/compat --jvm-free
;; Two roots then carry `kotoba.lang.text` -- `text/src` the `.cljk`, this
;; directory the `.kotoba` -- and amu's project loader lets the `.kotoba`
;; twin stand in for the `.cljk` (extension priority across roots, the same
;; priority it already applied within one root; two `.kotoba` or two `.cljk`
;; are still ambiguous and refused).

(ns kotoba.lang.text
  (:require [kotoba.string :as ks]
            [kotoba.string.join :as ksj])
  (:export [join
            starts-with? ends-with? includes?
            blank? trim triml trimr reverse
            index-of last-index-of
            replace]))

(defn join [separator :string items [:list :string]] :string (ksj/join separator items))
(defn starts-with? [s :string prefix :string] :bool (ks/starts-with? s prefix))
(defn ends-with? [s :string suffix :string] :bool (ks/ends-with? s suffix))
(defn includes? [s :string substring :string] :bool (ks/includes? s substring))
(defn blank? [s :string] :bool (ks/blank? s))
(defn trim [s :string] :string (ks/trim s))
(defn triml [s :string] :string (ks/triml s))
(defn trimr [s :string] :string (ks/trimr s))
(defn reverse [s :string] :string (ks/reverse s))
(defn index-of [s :string value :string] [:option :i64] (ks/index-of s value))
(defn last-index-of [s :string value :string] [:option :i64] (ks/last-index-of s value))
(defn replace [s :string match :string replacement :string] :string (ks/replace s match replacement))
