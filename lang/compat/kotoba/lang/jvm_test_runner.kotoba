(ns kotoba.lang.jvm-test-runner
  "JVM compatibility test entry after the .cljk rename.

  Discovers `test/**/*.cljk` whose `cljk-origin.edn` origin is `.clj` or
  `.cljc`. Origin `.cljs` files (for example host-parity-portable-test)
  stayed ClojureScript on purpose so this runner must not require them."
  (:require [clojure.edn :as edn]
            [clojure.java.io :as io]
            [clojure.tools.namespace.file :as ns-file]
            [clojure.tools.namespace.find :as find]
            [clojure.tools.namespace.parse :as parse]
            [cognitect.test-runner :as runner]))

(def ^:private origin-path "cljk-origin.edn")

(def ^:private jvm-origins #{".clj" ".cljc"})

(defn- repo-path
  ^String [^java.io.File file]
  (let [root (.toPath (.getCanonicalFile (io/file ".")))
        full (.toPath (.getCanonicalFile file))]
    (.toString (.relativize root full))))

(defn- origin-map []
  (:origins (edn/read-string (slurp origin-path))))

(defn- jvm-origin?
  "Unknown new .cljk tests default to JVM; recorded .cljs origins do not."
  [path origins]
  (let [origin (get origins path)]
    (or (nil? origin) (contains? jvm-origins origin))))

(defn jvm-test-namespaces
  []
  (let [origins (origin-map)]
    (->> (find/find-sources-in-dir (io/file "test"))
         (filter (fn [^java.io.File f]
                   (jvm-origin? (repo-path f) origins)))
         (keep (fn [f]
                 (when-let [decl (ns-file/read-file-ns-decl f)]
                   (parse/name-from-ns-decl decl))))
         sort
         vec)))

(defn- explicit-selection?
  [args]
  (some #{"-n" "--namespace" "-r" "--namespace-regex" "-d" "--dir" "-v" "--var"}
        args))

(defn -main
  [& args]
  (let [extensions (:extensions find/clj)]
    (when-not (some #{".cljk"} extensions)
      (throw (ex-info "cljk test discovery is not installed; load cljk-loader first"
                      {:extensions extensions}))))
  (if (explicit-selection? args)
    (apply runner/-main args)
    (let [nss (jvm-test-namespaces)]
      (when (empty? nss)
        (throw (ex-info "no JVM .cljk test namespaces discovered under test/"
                        {:origin-path origin-path})))
      (apply runner/-main
             (mapcat (fn [ns] ["-n" (str ns)]) nss)))))
