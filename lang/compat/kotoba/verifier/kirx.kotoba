;; kotoba.verifier.kirx -- the KIR predicates the guest-route verifier needs, with no
;; dependency on the (large, still growing) kotoba.kir twin: REAL ports of kir.cljk's
;; `uses-f32?` / `uses-f64?` (over Form) and of its trap classification
;; (`budget-traps`, `oracle-inconclusive-trap`). The kotoba.kir twin forwards its
;; same-named exports here, so both routes to these names give one body.

(ns kotoba.verifier.kirx
  (:require [kotoba.form :as form])
  (:export [uses-f32? uses-f64? budget-trap? trap-inconclusive?])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                       [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]}))

;; ---------------------------------------------------------------------------
;; uses-f64? / uses-f32? -- REAL ports of kir.cljk's two predicates over Form.
;; The value ABI the verifier expects is derived from them, so they must agree
;; with the host on every program: a function mentions the width in a param
;; type or its result, or any list form anywhere in a body (maps and vectors
;; included, exactly `(tree-seq coll? seq body)`) is headed by one of the
;; width's operation symbols.

(defn- f64-op-name? [n :string] :bool
  (or (= n "f64-to-bits") (= n "f64-from-bits")
      (= n "f64-add") (= n "f64-sub") (= n "f64-mul") (= n "f64-div")
      (= n "f64-min") (= n "f64-max") (= n "f64-neg") (= n "f64-abs") (= n "f64-sqrt")
      (= n "f64-sin-quarter-turn") (= n "f64-cos-quarter-turn")
      (= n "f64-sin-bounded") (= n "f64-cos-bounded")
      (= n "f64-exp-near-zero") (= n "f64-log-near-one") (= n "f64-atan2-bounded")
      (= n "f64-exp-bounded") (= n "f64-log-bounded")
      (= n "f64-eq") (= n "f64-lt") (= n "f64-le") (= n "f64-gt") (= n "f64-ge")
      (= n "f64-unordered")
      (= n "i64-to-f64-checked") (= n "i64-to-f64-rounded")
      (= n "f64-to-i64-checked") (= n "f64-to-i64-truncating")))

(defn- f32-op-name? [n :string] :bool
  (or (= n "f32-to-bits") (= n "f32-from-bits")
      (= n "f64-to-f32-rounded") (= n "f32-to-f64-exact")
      (= n "f32-add") (= n "f32-sub") (= n "f32-mul") (= n "f32-div")
      (= n "f32-min") (= n "f32-max") (= n "f32-neg") (= n "f32-abs") (= n "f32-sqrt")
      (= n "f32-eq") (= n "f32-lt") (= n "f32-le") (= n "f32-gt") (= n "f32-ge")
      (= n "f32-unordered")
      (= n "i64-to-f32-checked") (= n "i64-to-f32-rounded")
      (= n "f32-to-i64-checked") (= n "f32-to-i64-truncating")))

(defn- float-op-name? [wide :bool n :string] :bool
  (if wide (f64-op-name? n) (f32-op-name? n)))

(defn- float-form? [wide :bool f [:ref :form/r]] :bool
  (if (form/is-seq? f)
    (or (and (> (form/count-of f) 0)
             (form/is-symbol? (form/first-of f))
             (float-op-name? wide (form/symbol-value (form/first-of f))))
        (float-kids? wide (form/kids-of f) 0))
    (if (or (form/is-vec? f) (or (form/is-set? f) (form/is-map? f)))
      (float-kids? wide (form/kids-of f) 0)
      false)))

(defn- float-kids? [wide :bool kids [:list [:ref :form/r]] i :i64] :bool
  (if (>= i (vector-count kids))
    false
    (or (float-form? wide (typed-list-nth [:list [:ref :form/r]] kids i))
        (float-kids? wide kids (+ i 1)))))

(defn- has-kid? [xs [:ref :form/r] x [:ref :form/r] i :i64] :bool
  (if (>= i (form/count-of xs))
    false
    (or (form/eq (form/nth-of xs i) x)
        (has-kid? xs x (+ i 1)))))

(defn- float-fn? [wide :bool fn-form [:ref :form/r]] :bool
  (let [ty (if wide (form/keyword-form :f64) (form/keyword-form :f32))]
    (or (form/eq (form/form-get fn-form (form/keyword-form :result)) ty)
        (or (has-kid? (form/form-get fn-form (form/keyword-form :param-types)) ty 0)
            (float-form? wide (form/form-get fn-form (form/keyword-form :body)))))))

(defn- float-fns? [wide :bool fns [:ref :form/r] i :i64] :bool
  (if (>= i (form/count-of fns))
    false
    (or (float-fn? wide (form/nth-of fns i))
        (float-fns? wide fns (+ i 1)))))

(defn uses-f64? [program [:ref :form/r]] :bool
  (float-fns? true (form/form-get program (form/keyword-form :functions)) 0))

(defn uses-f32? [program [:ref :form/r]] :bool
  (float-fns? false (form/form-get program (form/keyword-form :functions)) 0))


(defn budget-trap? [trap :keyword] :bool
  (or (= trap :budget/fuel) (or (= trap :budget/cells)
      (or (= trap :budget/bytes) (= trap :budget/frames)))))

(defn trap-inconclusive? [trap :string] :bool
  (or (= trap "budget/fuel") (or (= trap "budget/cells")
      (or (= trap "budget/bytes") (or (= trap "budget/frames")
          (= trap "host/stack-exhausted"))))))

