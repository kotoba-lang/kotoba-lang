    (= op "kernel-jump-to") true
    (= op "kernel-uefi-call4") true
    (= op "kernel-uefi-call6") true
    (= op "ucs2") true
    (= op "guid") true
    (= op "bytes-literal") true
    (= op "kernel-scratch-region") true
    (= op "kernel-function-address") true
    (= op "kernel-uefi-alloc-region") true
    (= op "kernel-isr-entry-address") true
    (= op "kernel-dot-f32") true
    (= op "kernel-dequant-dot-q8-0") true
    (= op "kernel-dequant-dot-q4-k") true
    (= op "kernel-dequant-dot-q6-k") true
    (= op "kernel-dequant-dot-iq4-xs") true
    (= op "kernel-dequant-dot-iq2-s") true
    (= op "kernel-dequant-dot-iq3-xxs") true
    (= op "kernel-dequant-dot-iq3-s") true
    :else false))

;; the quoted tail of the operations a hosted (non-kernel) target refuses
(defn kernel-target-only-tail-op? [op :string] :bool
  (cond
    (= op "kernel-boot-info") true
    (= op "kernel-read-cr2") true
    (= op "kernel-read-cr0") true
    (= op "kernel-write-cr0") true
    (= op "kernel-read-cr3") true
    (= op "kernel-write-cr3") true
    (= op "kernel-invlpg") true
    (= op "kernel-read-cs") true
    (= op "kernel-page-fault-handler-address") true
    (= op "kernel-rt-timer-handler-address") true
    (= op "kernel-page-fault-recovery-handler-address") true
    (= op "kernel-configure-page-fault-recovery") true
    (= op "kernel-double-fault-handler-address") true
    (= op "kernel-undefined-opcode-handler-address") true
    (= op "kernel-configure-double-fault-ist") true
    (= op "kernel-load-gdt-tss") true
    (= op "kernel-load-idt") true
    (= op "kernel-probe-guard-write") true
    (= op "kernel-probe-text-write") true
    (= op "kernel-probe-nx-execute") true
    (= op "kernel-probe-recoverable-guard-write") true
    (= op "kernel-probe-double-fault") true
    (= op "kernel-cli") true
    (= op "kernel-sti") true
    (= op "kernel-hlt") true
    (= op "kernel-pause") true
    (= op "kernel-out-u8") true
    (= op "kernel-out-u32") true
    (= op "kernel-in-u8") true
    (= op "kernel-in-u32") true
    (= op "kernel-read-msr") true
    (= op "kernel-write-msr") true
    (= op "kernel-cpuid-eax") true
    (= op "kernel-cpuid-ebx") true
    (= op "kernel-cpuid-ecx") true
    (= op "kernel-cpuid-edx") true
    (= op "kernel-xgetbv") true
    (= op "kernel-read-cr4") true
    (= op "kernel-write-cr4") true
    (= op "kernel-xsetbv") true
    (= op "kernel-try-lock-u32") true
    (= op "kernel-unlock-u32") true
    (= op "kernel-atomic-add-u32") true
    (= op "kernel-atomic-add-u64") true
    (= op "kernel-xchg-u32") true
    (= op "kernel-xchg-u64") true
    (= op "kernel-cmpxchg-u32") true
    (= op "kernel-cmpxchg-u64") true
    (= op "kernel-fence-load") true
    (= op "kernel-fence-store") true
    (= op "kernel-fence-full") true
    (= op "kernel-rdtsc") true
    (= op "kernel-rdtscp") true
    (= op "kernel-swapgs") true
    (= op "kernel-isr-entry-address") true
    (= op "kernel-system-table") true
    (= op "kernel-load-ptr") true
    (= op "kernel-uefi-call2") true
    (= op "kernel-jump-to") true
    (= op "kernel-uefi-call4") true
    (= op "kernel-uefi-call6") true
    (= op "kernel-scratch-region") true
    (= op "kernel-uefi-alloc-region") true
    :else false))
