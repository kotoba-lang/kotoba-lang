    (= op "kernel-hlt") true
    (= op "kernel-pause") true
    (= op "kernel-out-u8") true
    (= op "kernel-out-u32") true
    (= op "kernel-in-u8") true
    (= op "kernel-in-u32") true
    (= op "kernel-read-msr") true
    (= op "kernel-write-msr") true
