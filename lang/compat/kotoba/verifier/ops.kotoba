;; kotoba.verifier.ops -- GENERATED by scripts/gen_verifier_ops.py from osaho's
;; `kotoba/verifier.cljk`: every operation-name table of the host verifier (the
;; quoted symbol->arity maps and symbol sets) as a `cond` chain over `=` on the
;; symbol's text. A lookup allocates nothing and answers the arity (-1 when the
;; name is absent) or a bool. Do not edit by hand; regenerate.

(ns kotoba.verifier.ops
  (:export [kernel-memory-operation-arity kernel-memory-arity i64-op-arity i32-op-arity
            heap-op-arity kgraph-op-arity string-op-arity tagged-i64-op-arity f64-op-arity
            f32-op-arity vector-op-arity bytes-op-arity string-index-op-arity xml-op-arity
            decimal-op-arity region-op-arity arithmetic-op? i32-shift-op? i64-shift-op?
            comparison-op? vector-constructor-op? hetero-vector-op? region-scalar-operation?
            kernel-privileged-op-arity granted-region-op? kernel-native-tail-op? kernel-target-only-tail-op?]))

;; kernel-memory-operations (checked-memory surface): op -> arity, -1 when absent
(defn kernel-memory-operation-arity [op :string] :i64
  (cond
    (= op "kernel-load-u8") 3
    (= op "kernel-store-u8") 4
    (= op "kernel-load-u8-4k") 3
    (= op "kernel-store-u8-4k") 4
    (= op "kernel-load-u8-16k") 3
    (= op "kernel-store-u8-16k") 4
    (= op "kernel-load-u8-64k") 3
    (= op "kernel-store-u8-64k") 4
    (= op "kernel-load-u16") 3
    (= op "kernel-store-u16") 4
    (= op "kernel-load-u16-4k") 3
    (= op "kernel-store-u16-4k") 4
    (= op "kernel-load-u16-16k") 3
    (= op "kernel-store-u16-16k") 4
    (= op "kernel-load-u16-64k") 3
    (= op "kernel-store-u16-64k") 4
    (= op "kernel-load-u32") 3
    (= op "kernel-store-u32") 4
    (= op "kernel-load-u32-4k") 3
    (= op "kernel-store-u32-4k") 4
    (= op "kernel-load-u32-16k") 3
    (= op "kernel-store-u32-16k") 4
    (= op "kernel-load-u32-64k") 3
    (= op "kernel-store-u32-64k") 4
    (= op "kernel-load-u64") 3
    (= op "kernel-store-u64") 4
    (= op "kernel-load-u64-4k") 3
    (= op "kernel-store-u64-4k") 4
    (= op "kernel-load-u64-16k") 3
    (= op "kernel-store-u64-16k") 4
    (= op "kernel-load-u64-64k") 3
    (= op "kernel-store-u64-64k") 4
    (= op "slice-load-u8") 3
    (= op "slice-store-u8") 4
    (= op "slice-load-u16") 3
    (= op "slice-store-u16") 4
    (= op "slice-load-u32") 3
    (= op "slice-store-u32") 4
    (= op "slice-load-u64") 3
    (= op "slice-store-u64") 4
    (= op "kernel-subregion") 4
    :else -1))

;; kernel-memory-arities = kernel-memory-operations + the lock pair, atomics and dot kernels
(defn kernel-memory-arity [op :string] :i64
  (cond
    (= op "kernel-load-u8") 3
    (= op "kernel-store-u8") 4
    (= op "kernel-load-u8-4k") 3
    (= op "kernel-store-u8-4k") 4
    (= op "kernel-load-u8-16k") 3
    (= op "kernel-store-u8-16k") 4
    (= op "kernel-load-u8-64k") 3
    (= op "kernel-store-u8-64k") 4
    (= op "kernel-load-u16") 3
    (= op "kernel-store-u16") 4
    (= op "kernel-load-u16-4k") 3
    (= op "kernel-store-u16-4k") 4
    (= op "kernel-load-u16-16k") 3
    (= op "kernel-store-u16-16k") 4
    (= op "kernel-load-u16-64k") 3
    (= op "kernel-store-u16-64k") 4
    (= op "kernel-load-u32") 3
    (= op "kernel-store-u32") 4
    (= op "kernel-load-u32-4k") 3
    (= op "kernel-store-u32-4k") 4
    (= op "kernel-load-u32-16k") 3
    (= op "kernel-store-u32-16k") 4
    (= op "kernel-load-u32-64k") 3
    (= op "kernel-store-u32-64k") 4
    (= op "kernel-load-u64") 3
    (= op "kernel-store-u64") 4
    (= op "kernel-load-u64-4k") 3
    (= op "kernel-store-u64-4k") 4
    (= op "kernel-load-u64-16k") 3
    (= op "kernel-store-u64-16k") 4
    (= op "kernel-load-u64-64k") 3
    (= op "kernel-store-u64-64k") 4
    (= op "slice-load-u8") 3
    (= op "slice-store-u8") 4
    (= op "slice-load-u16") 3
    (= op "slice-store-u16") 4
    (= op "slice-load-u32") 3
    (= op "slice-store-u32") 4
    (= op "slice-load-u64") 3
    (= op "slice-store-u64") 4
    (= op "kernel-subregion") 4
    (= op "kernel-try-lock-u32") 3
    (= op "kernel-unlock-u32") 3
    (= op "kernel-atomic-add-u32") 4
    (= op "kernel-atomic-add-u64") 4
    (= op "kernel-xchg-u32") 4
    (= op "kernel-xchg-u64") 4
    (= op "kernel-cmpxchg-u32") 5
    (= op "kernel-cmpxchg-u64") 5
    (= op "kernel-dot-f32") 5
    (= op "kernel-dequant-dot-q8-0") 5
    (= op "kernel-dequant-dot-q4-k") 5
    (= op "kernel-dequant-dot-q6-k") 5
    (= op "kernel-dequant-dot-iq4-xs") 5
    (= op "kernel-dequant-dot-iq2-s") 5
    (= op "kernel-dequant-dot-iq3-xxs") 5
    (= op "kernel-dequant-dot-iq3-s") 5
    :else -1))

;; i64-operations: op -> arity, -1 when absent
(defn i64-op-arity [op :string] :i64
  (cond
    (= op "bit-not") 1
    (= op "i64-shift-left") 2
    (= op "i64-shift-right") 2
    (= op "u64-shift-right") 2
    :else -1))

;; i32-operations: op -> arity, -1 when absent
(defn i32-op-arity [op :string] :i64
  (cond
    (= op "i32-wrap") 1
    (= op "u32-wrap") 1
    (= op "i32-wrapping-add") 2
    (= op "i32-wrapping-mul") 2
    (= op "i32-xor") 2
    (= op "i32-shift-left") 2
    (= op "i32-shift-right") 2
    (= op "u32-shift-right") 2
    :else -1))

;; heap-operations: op -> arity, -1 when absent
(defn heap-op-arity [op :string] :i64
  (cond
    (= op "pair") 2
    (= op "pair-first") 1
    (= op "pair-second") 1
    :else -1))

;; kgraph-operations: op -> arity, -1 when absent
(defn kgraph-op-arity [op :string] :i64
  (cond
    (= op "kgraph-assert!") 3
    (= op "kgraph-get") 2
    (= op "kgraph-count") 1
    (= op "kgraph-entity-at") 2
    :else -1))

;; string-operations: op -> arity, -1 when absent
(defn string-op-arity [op :string] :i64
  (cond
    (= op "string-byte-length") 1
    (= op "string=?") 2
    (= op "string-concat") 2
    (= op "string-substring") 3
    (= op "string-code-point-at") 2
    (= op "string-contains?") 2
    (= op "string-index-of") 2
    (= op "string-replace-all") 3
    (= op "string-compare") 2
    (= op "string-fold-ascii") 1
    (= op "string-find-blank") 2
    (= op "string-skip-blank") 2
    (= op "string-index-of-from") 3
    (= op "string-compare-lines") 4
    (= op "string-find-byte") 3
    (= op "string-append-range") 4
    (= op "keyword-name") 1
    (= op "keyword-from-string") 1
    :else -1))

;; tagged-i64-operations: op -> arity, -1 when absent
(defn tagged-i64-op-arity [op :string] :i64
  (cond
    (= op "option-some") 1
    (= op "option-none") 0
    (= op "option-some?") 1
    (= op "option-value") 2
    (= op "result-ok") 1
    (= op "result-err") 1
    (= op "result-ok?") 1
    (= op "result-value") 2
    (= op "result-error") 2
    :else -1))

;; f64-operations: op -> arity, -1 when absent
(defn f64-op-arity [op :string] :i64
  (cond
    (= op "f64-add") 2
    (= op "f64-sub") 2
    (= op "f64-mul") 2
    (= op "f64-div") 2
    (= op "f64-min") 2
    (= op "f64-max") 2
    (= op "f64-abs") 1
    (= op "f64-neg") 1
    (= op "f64-sqrt") 1
    (= op "f64-from-bits") 1
    (= op "f64-to-bits") 1
    (= op "f64-eq") 2
    (= op "f64-lt") 2
    (= op "f64-le") 2
    (= op "f64-gt") 2
    (= op "f64-ge") 2
    (= op "f64-unordered") 2
    :else -1))

;; f32-operations: op -> arity, -1 when absent
(defn f32-op-arity [op :string] :i64
  (cond
    (= op "f32-add") 2
    (= op "f32-sub") 2
    (= op "f32-mul") 2
    (= op "f32-div") 2
    (= op "f32-abs") 1
    (= op "f32-neg") 1
    (= op "f32-sqrt") 1
    (= op "f32-from-bits") 1
    (= op "f32-to-bits") 1
    (= op "f32-eq") 2
    (= op "f32-lt") 2
    (= op "f32-le") 2
    (= op "f32-gt") 2
    (= op "f32-ge") 2
    (= op "f32-unordered") 2
    (= op "f32-to-f64-exact") 1
    (= op "f64-to-f32-rounded") 1
    (= op "i64-to-f32-rounded") 1
    (= op "i64-to-f64-rounded") 1
    :else -1))

;; vector-operations: op -> arity, -1 when absent
(defn vector-op-arity [op :string] :i64
  (cond
    (= op "vector-count") 1
    (= op "vector-get") 3
    (= op "vector-at") 2
    (= op "vector-drop") 2
    (= op "vector-assoc") 3
    (= op "vector-conj") 2
    (= op "vector-f64-count") 1
    (= op "vector-f64-get") 3
    (= op "vector-f64-at") 2
    (= op "vector-f64-drop") 2
    (= op "vector-f64-assoc") 3
    (= op "vector-f64-conj") 2
    (= op "vector-alloc") 1
    (= op "vector-assoc!") 3
    :else -1))

;; bytes-operations: op -> arity, -1 when absent
(defn bytes-op-arity [op :string] :i64
  (cond
    (= op "bytes-empty") 0
    (= op "bytes-count") 1
    (= op "bytes-at") 2
    (= op "bytes-slice") 3
    (= op "bytes-concat") 2
    (= op "bytes-from-vector-i64") 1
    (= op "vector-i64-from-bytes") 1
    (= op "string-from-utf8") 1
    :else -1))

;; string-index-operations: op -> arity, -1 when absent
(defn string-index-op-arity [op :string] :i64
  (cond
    (= op "string-index-new") 0
    (= op "string-index-count") 1
    (= op "string-index-contains") 2
    (= op "string-index-get") 2
    (= op "string-index-assoc") 3
    :else -1))

;; xml-operations: op -> arity, -1 when absent
(defn xml-op-arity [op :string] :i64
  (cond
    (= op "xml-path-count") 2
    (= op "xml-name-count") 2
    (= op "xml-name-text") 3
    (= op "xml-path-text") 3
    (= op "xml-path-attr") 4
    :else -1))

;; decimal-operations: op -> arity, -1 when absent
(defn decimal-op-arity [op :string] :i64
  (cond
    (= op "decimal-f64-parse") 1
    (= op "decimal-f64x3-parse") 1
    :else -1))

;; region-operations: op -> arity, -1 when absent
(defn region-op-arity [op :string] :i64
  (cond
    (= op "arena-scope") 1
    :else -1))

;; arithmetic
(defn arithmetic-op? [op :string] :bool
  (cond
    (= op "+") true
    (= op "-") true
    (= op "*") true
    (= op "quot") true
    (= op "bit-xor") true
    (= op "bit-and") true
    (= op "bit-or") true
    :else false))

;; i32-shifts
(defn i32-shift-op? [op :string] :bool
  (cond
    (= op "i32-shift-left") true
    (= op "i32-shift-right") true
    (= op "u32-shift-right") true
    :else false))

;; i64-shifts
(defn i64-shift-op? [op :string] :bool
  (cond
    (= op "i64-shift-left") true
    (= op "i64-shift-right") true
    (= op "u64-shift-right") true
    :else false))

;; comparisons
(defn comparison-op? [op :string] :bool
  (cond
    (= op "=") true
    (= op "<") true
    (= op ">") true
    (= op "<=") true
    (= op ">=") true
    :else false))

;; vector-constructors
(defn vector-constructor-op? [op :string] :bool
  (cond
    (= op "vector-new") true
    (= op "vector-f64-new") true
    :else false))

;; hetero-vector-operations
(defn hetero-vector-op? [op :string] :bool
  (cond
    (= op "hetero-vector-new") true
    (= op "hetero-vector-count") true
    (= op "hetero-vector-at") true
    (= op "hetero-vector-assoc") true
    :else false))

;; region-scalar-operations
(defn region-scalar-operation? [op :string] :bool
  (cond
    (= op "*") true
    (= op "+") true
    (= op "-") true
    (= op "<") true
    (= op "<=") true
    (= op "=") true
    (= op ">") true
    (= op ">=") true
    (= op "bit-and") true
    (= op "bit-not") true
    (= op "bit-or") true
    (= op "bit-xor") true
    (= op "f32-abs") true
    (= op "f32-add") true
    (= op "f32-div") true
    (= op "f32-eq") true
    (= op "f32-from-bits") true
    (= op "f32-ge") true
    (= op "f32-gt") true
    (= op "f32-le") true
    (= op "f32-lt") true
    (= op "f32-mul") true
    (= op "f32-neg") true
    (= op "f32-sqrt") true
    (= op "f32-sub") true
    (= op "f32-to-bits") true
    (= op "f32-to-f64-exact") true
    (= op "f32-unordered") true
    (= op "f64-abs") true
    (= op "f64-add") true
    (= op "f64-div") true
    (= op "f64-eq") true
    (= op "f64-from-bits") true
    (= op "f64-ge") true
    (= op "f64-gt") true
    (= op "f64-le") true
    (= op "f64-lt") true
    (= op "f64-max") true
    (= op "f64-min") true
    (= op "f64-mul") true
    (= op "f64-neg") true
    (= op "f64-sqrt") true
    (= op "f64-sub") true
    (= op "f64-to-bits") true
    (= op "f64-to-f32-rounded") true
    (= op "f64-unordered") true
    (= op "i32-shift-left") true
    (= op "i32-shift-right") true
    (= op "i32-wrap") true
    (= op "i32-wrapping-add") true
    (= op "i32-wrapping-mul") true
    (= op "i32-xor") true
    (= op "i64-shift-left") true
    (= op "i64-shift-right") true
    (= op "i64-to-f32-rounded") true
    (= op "i64-to-f64-rounded") true
    (= op "quot") true
    (= op "u32-shift-right") true
    (= op "u32-wrap") true
    (= op "u64-shift-right") true
    (= op "bool-not") true
    (= op "string-byte-length") true
    (= op "string-code-point-at") true
    (= op "string-index-of") true
    (= op "string-contains?") true
    (= op "string=?") true
    (= op "string-split-count") true
    (= op "string-compare") true
    (= op "string-find-blank") true
    (= op "string-skip-blank") true
    (= op "string-index-of-from") true
    (= op "string-compare-lines") true
    (= op "string-find-byte") true
    (= op "pair-first") true
    (= op "pair-second") true
    (= op "kgraph-count") true
    (= op "kgraph-get") true
    (= op "kgraph-entity-at") true
    (= op "vector-count") true
    (= op "vector-at") true
    (= op "bytes-count") true
    (= op "bytes-at") true
    (= op "option-some?") true
    (= op "option-value") true
    (= op "result-ok?") true
    (= op "result-value") true
    (= op "result-error") true
    (= op "cap-call") true
    :else false))

;; the kernel privileged operations verify-expr! admits: op -> arity
(defn kernel-privileged-op-arity [op :string] :i64
  (cond
    (= op "kernel-boot-info") 0
    (= op "kernel-read-cr0") 0
    (= op "kernel-write-cr0") 1
    (= op "kernel-read-cr2") 0
    (= op "kernel-read-cr3") 0
    (= op "kernel-write-cr3") 1
    (= op "kernel-invlpg") 1
    (= op "kernel-cli") 0
    (= op "kernel-sti") 0
    (= op "kernel-hlt") 0
    (= op "kernel-read-cs") 0
    (= op "kernel-page-fault-handler-address") 0
    (= op "kernel-rt-timer-handler-address") 0
    (= op "kernel-page-fault-recovery-handler-address") 0
    (= op "kernel-configure-page-fault-recovery") 2
    (= op "kernel-double-fault-handler-address") 0
    (= op "kernel-undefined-opcode-handler-address") 0
    (= op "kernel-configure-double-fault-ist") 2
    (= op "kernel-load-gdt-tss") 2
    (= op "kernel-load-idt") 2
    (= op "kernel-probe-guard-write") 0
    (= op "kernel-probe-text-write") 0
    (= op "kernel-probe-nx-execute") 0
    (= op "kernel-probe-recoverable-guard-write") 0
    (= op "kernel-probe-double-fault") 0
    (= op "kernel-pause") 0
    (= op "kernel-out-u8") 2
    (= op "kernel-out-u32") 2
    (= op "kernel-in-u8") 1
    (= op "kernel-in-u32") 1
    (= op "kernel-read-msr") 1
    (= op "kernel-write-msr") 2
    (= op "kernel-cpuid-eax") 2
    (= op "kernel-cpuid-ebx") 2
    (= op "kernel-cpuid-ecx") 2
    (= op "kernel-cpuid-edx") 2
    (= op "kernel-xgetbv") 1
    (= op "kernel-read-cr4") 0
    (= op "kernel-write-cr4") 1
    (= op "kernel-xsetbv") 2
    (= op "kernel-system-table") 0
    (= op "kernel-load-ptr") 2
    (= op "kernel-uefi-call2") 4
    (= op "kernel-jump-to") 2
    (= op "kernel-uefi-call4") 6
    (= op "kernel-uefi-call6") 8
    (= op "kernel-uefi-alloc-region") 6
    (= op "kernel-fence-load") 0
    (= op "kernel-fence-store") 0
    (= op "kernel-fence-full") 0
    (= op "kernel-rdtsc") 0
    (= op "kernel-rdtscp") 0
    (= op "kernel-swapgs") 0
    (= op "kernel-isr-entry-address") 1
    (= op "kernel-scratch-region") 0
    :else -1))

;; granted-region-operations
(defn granted-region-op? [op :string] :bool
  (cond
    (= op "slice-load-u8") true
    (= op "slice-load-u16") true
    (= op "slice-load-u32") true
    (= op "slice-load-u64") true
    (= op "slice-store-u8") true
    (= op "slice-store-u16") true
    (= op "slice-store-u32") true
    (= op "slice-store-u64") true
    (= op "kernel-subregion") true
    :else false))

;; the quoted tail of kernel-native-operations (the rest is kernel-memory-operations)
(defn kernel-native-tail-op? [op :string] :bool
