;; kotoba.verifier.seal -- the seal self-check over the form tree.
;;
;; WHAT IS PROVIDED (the callers' shapes, measured):
;;   canonical-text(form) :string  -- the canonical text of a form; the cache
;;     route checks its length against the 64MB string limit before sealing.
;;   sha256-form(form) :string     -- the sha256 of that canonical text's
;;     bytes (wrapped in form/string-form at every caller).
;;   valid-seal?(form) :bool       -- the seal self-check: a seal carries
;;     `:sha256`, and it is valid exactly when that value equals
;;     sha256-form of the seal WITHOUT its :sha256 entry (the measured
;;     pattern: `(= (:sha256 value) (artifact/sha256 (dissoc value :sha256)))`).
;;
;; The canonical text is the form tree's deterministic EDN rendering -- the
;; same tag table as kotoba.form (nil/bool/int/string/keyword/symbol/bytes/
;; vec/seq/set/map), rendered as the document EDN of the corresponding shape.
;; No host oracle exists for these bytes (the host route provides the names
;; through nbb shims), so this rendering is the convention; it is pinned here
;; and by the cache/provenance callers' expectations.

(ns kotoba.verifier.seal
  
  (:export [canonical-text sha256-form valid-seal?])  (:require [kotoba.form :as form] [kotoba.artifact.core :as artifact] [kotoba.bytes :as bytes])
)

;; ---- canonical text ------------------------------------------------------------------

(defn- text-of [x [:ref :form/r]] :string
  (cond
    (form/is-nil x) "nil"
    (form/is-bool x) (if (form/bool-value x) "true" "false")
    (form/is-int x) (document-edn-print (document-i64 (form/int-value x)))
    (form/is-string x) (document-edn-print (document-string (form/string-value x)))
    (form/is-keyword x) (document-edn-print (document-keyword (form/keyword-value x)))
    (form/is-symbol x) (form/string-value x)
    (form/is-bytes x) (bytes/hex (form/bytes-of x))
    (form/is-vec x) ""
    :else ""))

(defn- kids-text [x [:ref :form/r] sep :string open :string close :string] :string
  (let [n (form/count-of x)]
    (loop [i 0 acc open]
      (if (>= i n) (string-concat acc close)
        (recur (+ i 1)
               (string-concat acc
                 (string-concat (if (= i 0) "" sep) (text-of (form/nth-of x i)))))))))

(defn- text-of* [x [:ref :form/r]] :string
  (cond
    (form/is-vec x) (kids-text x " " "[" "]")
    (form/is-seq x) (kids-text x " " "(" ")")
    (form/is-set x) (kids-text x " " "#{" "}")
    (form/is-map x) (let [n (form/count-of x)]
                      (loop [i 0 acc "{"]
                        (if (>= i n) (string-concat acc "}")
                          (recur (+ i 2)
                                 (string-concat acc
                                   (string-concat (if (= i 0) "" " ")
                                     (string-concat (text-of* (form/nth-of x i))
                                       (string-concat " " (text-of* (form/nth-of x (+ i 1)))))))))))
    :else (text-of x)))

(defn canonical-text [x [:ref :form/r]] :string
  (text-of* x))

;; ---- sha256 --------------------------------------------------------------------------

(defn sha256-form [x [:ref :form/r]] :string
  (artifact/sha256 (document-string (canonical-text x))))

;; ---- the seal self-check -------------------------------------------------------------

(defn valid-seal? [x [:ref :form/r]] :bool
  (let [stored (form/form-get x (form/keyword-form :sha256))]
    (if (form/is-nil stored) false
      (form/eq stored (form/string-form (sha256-form (form/dissoc-form x (form/keyword-form :sha256))))))))
