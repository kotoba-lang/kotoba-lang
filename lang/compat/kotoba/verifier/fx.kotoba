;; kotoba.verifier.fx -- Form helpers and the native TYPE-DESCRIPTOR predicates of
;; the guest-route kotoba.verifier twin (lang/compat/kotoba/verifier.kotoba).
;;
;; Everything here is a REAL port of the host predicate of the same name in
;; osaho's `kotoba/verifier.cljk` (`native-scalar-record-type?`,
;; `native-scalar-variant-type?`, `native-scalar-variant-boundary-type?`,
;; `native-word-value-type?`, `native-handle-type?`, `handle-of?`,
;; `boxed-payload-variant-type?`), restated over the recursive `:form/r`
;; record: a type descriptor is a Form (a vector headed by a keyword, or a bare
;; keyword). The host bounds (32 record fields, 32 variant cases, depth 8 for
;; word values, 32 for records/handles) are the same numbers.
;;
;; Text is compared, never allocated: the host's operation-name sets and arity
;; maps are `cond` chains over `=` on the symbol's text in the modules that
;; use them, so a lookup allocates nothing.

(ns kotoba.verifier.fx
  (:require [kotoba.form :as form])
  (:export [rodata-valid? sym? sym-text sym-or-empty simple-sym? kw? kw-text kw-is? str? int? vec? seq-form? set-form? map-form?
            head-of head-is? arg-count first-arg second-arg third-arg
            key get-in2 has-key? nth-or-nil vec-count
            distinct-first-names?
            native-scalar-record-type? native-scalar-variant-type?
            native-scalar-variant-boundary-type? native-word-value-type?
            native-handle-type? handle-of? boxed-payload-variant-type?
            ref-type? ref-type-loose? word-field-type? valid-name? name-valid-form?
            scalar-replaced-record-type? scalar-replaced-variant-type?
            boxed-aggregate-variant-type?
            max-record-fields max-variant-cases max-handle-members
            max-symbol-chars])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                       [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]}))

(defn max-record-fields [] :i64 32)
(defn max-variant-cases [] :i64 32)
(defn max-handle-members [] :i64 32)
(defn max-symbol-chars [] :i64 128)

;; ---- Form shape predicates (the host's symbol?/keyword?/vector?/seq?/...) ----

(defn sym? [f [:ref :form/r]] :bool (form/is-symbol? f))
(defn sym-text [f [:ref :form/r]] :string (form/symbol-value f))
(defn sym-or-empty [f [:ref :form/r]] :string (if (form/is-symbol? f) (form/symbol-value f) ""))
(defn kw? [f [:ref :form/r]] :bool (form/is-keyword? f))
(defn kw-text [f [:ref :form/r]] :string
  (document-edn-print (document-keyword (form/keyword-value f))))
(defn str? [f [:ref :form/r]] :bool (form/is-string? f))
(defn int? [f [:ref :form/r]] :bool (form/is-int? f))
(defn vec? [f [:ref :form/r]] :bool (form/is-vec? f))

;; `seq?` / `set?` / `map?` are spelled `-form?` here: a module whose Kotoba reading
;; uses a document operation (`kw-text`) gets the seed's document prelude, which
;; defines `seq?` / `set?` / `map?` over :document (seed E2001 duplicate definition).
(defn seq-form? [f [:ref :form/r]] :bool (form/is-seq? f))
(defn set-form? [f [:ref :form/r]] :bool (form/is-set? f))
(defn map-form? [f [:ref :form/r]] :bool (form/is-map? f))

;; `simple-symbol?`: a symbol with no namespace part. The lone symbol "/" is
;; the division symbol, which has none.
(defn simple-sym? [f [:ref :form/r]] :bool
  (and (form/is-symbol? f)
       (or (= (string-byte-length (form/symbol-value f)) 1)
           (< (string-find-byte (form/symbol-value f) 47 0) 0))))

(defn kw-is? [f [:ref :form/r] k :keyword] :bool
  (and (form/is-keyword? f) (= (form/keyword-value f) k)))

(defn vec-count [f [:ref :form/r]] :i64 (form/count-of f))

;; nth of a list/vector Form, the nil Form when out of range (host `nth ... nil`).
(defn nth-or-nil [f [:ref :form/r] i :i64] [:ref :form/r] (form/nth-of f i))

;; (first form) of a seq, the nil Form otherwise.
(defn head-of [f [:ref :form/r]] [:ref :form/r]
  (if (form/is-seq? f) (form/first-of f) (form/nil-form)))

;; the seq is headed by the symbol whose text is NAME
(defn head-is? [f [:ref :form/r] name :string] :bool
  (and (form/is-seq? f)
       (> (form/count-of f) 0)
       (form/is-symbol? (form/first-of f))
       (string=? (form/symbol-value (form/first-of f)) name)))

;; (count args) of a call form
(defn arg-count [f [:ref :form/r]] :i64 (- (form/count-of f) 1))
(defn first-arg [f [:ref :form/r]] [:ref :form/r] (form/nth-of f 1))
(defn second-arg [f [:ref :form/r]] [:ref :form/r] (form/nth-of f 2))
(defn third-arg [f [:ref :form/r]] [:ref :form/r] (form/nth-of f 3))

;; map access by keyword, nil Form when absent
(defn key [k :keyword] [:ref :form/r] (form/keyword-form k))
(defn get-in2 [m [:ref :form/r] k1 :keyword k2 :keyword] [:ref :form/r]
  (form/form-get (form/form-get m (form/keyword-form k1)) (form/keyword-form k2)))
(defn has-key? [m [:ref :form/r] k :keyword] :bool
  (and (form/is-map? m) (form/form-has? m (form/keyword-form k))))

;; every element of the vector V (a vector of [name x] pairs) has a distinct
;; first element -- `(= (count v) (count (distinct (map first v))))`.
(defn- first-of-pair [f [:ref :form/r]] [:ref :form/r] (form/nth-of f 0))

(defn- name-seen-before? [v [:ref :form/r] i :i64 j :i64] :bool
  (if (>= j i)
    false
    (if (form/eq (first-of-pair (form/nth-of v i)) (first-of-pair (form/nth-of v j)))
      true
      (name-seen-before? v i (+ j 1)))))

(defn- distinct-from [v [:ref :form/r] i :i64] :bool
  (if (>= i (form/count-of v))
    true
    (if (name-seen-before? v i 0)
      false
      (distinct-from v (+ i 1)))))

(defn distinct-first-names? [v [:ref :form/r]] :bool (distinct-from v 0))

;; ---- names -----------------------------------------------------------------

;; `valid-name?`: a simple symbol of at most 128 characters. The host counts
;; `(count (name value))` in characters; the byte length is compared here, which
;; agrees for the ASCII names the compiler emits and is the stricter reading
;; for anything else.
(defn valid-name? [f [:ref :form/r]] :bool
  (and (simple-sym? f)
       (<= (string-byte-length (form/symbol-value f)) 128)))

(defn name-valid-form? [f [:ref :form/r]] :bool (valid-name? f))

;; ---- type descriptors --------------------------------------------------------

(defn ref-type-loose? [t [:ref :form/r]] :bool
  (and (form/is-vec? t) (= 2 (form/count-of t)) (kw-is? (form/nth-of t 0) :ref)))

(defn ref-type? [t [:ref :form/r]] :bool
  (and (form/is-vec? t) (= 2 (form/count-of t))
       (kw-is? (form/nth-of t 0) :ref)
       (form/keyword-has-namespace? (form/nth-of t 1))))

;; #{:i64 :bool :string :keyword :document}
(defn word-field-type? [t [:ref :form/r]] :bool
  (or (kw-is? t :i64) (or (kw-is? t :bool) (or (kw-is? t :string) (or (kw-is? t :keyword) (kw-is? t :document))))))

;; #{:i64 :bool :string :keyword :document :option-i64 :result-i64}
(defn- word-scalar-type? [t [:ref :form/r]] :bool
  (or (word-field-type? t) (or (kw-is? t :option-i64) (kw-is? t :result-i64))))

(defn- ns-keyword? [f [:ref :form/r]] :bool
  (and (form/is-keyword? f) (form/keyword-has-namespace? f)))

;; (native-word-value-type? type depth)
(defn native-word-value-type? [t [:ref :form/r] depth :i64] :bool
  (and (<= depth 8)
       (or (word-scalar-type? t)
           (and (form/is-vec? t)
                (> (form/count-of t) 0)
                (let [h (form/nth-of t 0)]
                  (cond
                    (or (kw-is? h :option) (or (kw-is? h :set) (kw-is? h :list)))
                    (and (= 2 (form/count-of t))
                         (or (native-word-value-type? (form/nth-of t 1) (+ depth 1))
                             (native-scalar-record-type? (form/nth-of t 1) 0)))
                    (kw-is? h :result)
                    (and (= 3 (form/count-of t))
                         (native-word-value-type? (form/nth-of t 1) (+ depth 1))
                         (native-word-value-type? (form/nth-of t 2) (+ depth 1)))
                    :else false))))))

;; every field [name type] of the record body FIELDS is admitted
(defn- record-fields-ok? [fields [:ref :form/r] i :i64 depth :i64] :bool
  (if (>= i (form/count-of fields))
    true
    (let [field (form/nth-of fields i)]
      (if (and (form/is-vec? field) (= 2 (form/count-of field))
               (form/is-keyword? (form/nth-of field 0))
               (or (word-field-type? (form/nth-of field 1))
                   (or (native-word-value-type? (form/nth-of field 1) 0)
                       (native-scalar-record-type? (form/nth-of field 1) (+ depth 1)))))
        (record-fields-ok? fields (+ i 1) depth)
        false))))

(defn native-scalar-record-type? [t [:ref :form/r] depth :i64] :bool
  (and (< depth 32)
       (form/is-vec? t) (= 3 (form/count-of t))
       (kw-is? (form/nth-of t 0) :record)
       (ns-keyword? (form/nth-of t 1))
       (form/is-vec? (form/nth-of t 2))
       (> (form/count-of (form/nth-of t 2)) 0)
       (<= (form/count-of (form/nth-of t 2)) 32)
       (record-fields-ok? (form/nth-of t 2) 0 depth)
       (distinct-first-names? (form/nth-of t 2))))

;; every case [tag payload] of the variant body CASES is a word field type or a
;; scalar record (`boundary?` narrows the word types to #{:i64 :bool})
(defn- variant-cases-ok? [cases [:ref :form/r] i :i64 boundary :bool] :bool
  (if (>= i (form/count-of cases))
    true
    (let [c (form/nth-of cases i)]
      (if (and (form/is-vec? c) (= 2 (form/count-of c))
               (form/is-keyword? (form/nth-of c 0))
               (if boundary
                 (or (or (kw-is? (form/nth-of c 1) :i64) (kw-is? (form/nth-of c 1) :bool))
                     (native-scalar-record-type? (form/nth-of c 1) 0))
                 (or (word-field-type? (form/nth-of c 1))
                     (native-scalar-record-type? (form/nth-of c 1) 0))))
        (variant-cases-ok? cases (+ i 1) boundary)
        false))))

(defn native-scalar-variant-type? [t [:ref :form/r]] :bool
  (and (form/is-vec? t) (= 3 (form/count-of t))
       (kw-is? (form/nth-of t 0) :variant)
       (ns-keyword? (form/nth-of t 1))
       (form/is-vec? (form/nth-of t 2))
       (> (form/count-of (form/nth-of t 2)) 0)
       (<= (form/count-of (form/nth-of t 2)) 32)
       (variant-cases-ok? (form/nth-of t 2) 0 false)
       (distinct-first-names? (form/nth-of t 2))))

(defn native-scalar-variant-boundary-type? [t [:ref :form/r]] :bool
  (and (form/is-vec? t) (= 3 (form/count-of t))
       (kw-is? (form/nth-of t 0) :variant)
       (ns-keyword? (form/nth-of t 1))
       (form/is-vec? (form/nth-of t 2))
       (>= (form/count-of (form/nth-of t 2)) 1)
       (<= (form/count-of (form/nth-of t 2)) 32)
       (variant-cases-ok? (form/nth-of t 2) 0 true)
       (distinct-first-names? (form/nth-of t 2))))

(defn- handle-members-ok? [members [:ref :form/r] i :i64 depth :i64] :bool
  (if (>= i (form/count-of members))
    true
    (let [m (form/nth-of members i)]
      (if (and (form/is-vec? m) (= 2 (form/count-of m))
               (form/is-keyword? (form/nth-of m 0))
               (native-handle-type? (form/nth-of m 1) (+ depth 1)))
        (handle-members-ok? members (+ i 1) depth)
        false))))

(defn- handle-members? [members [:ref :form/r] depth :i64] :bool
  (and (form/is-vec? members)
       (>= (form/count-of members) 1)
       (<= (form/count-of members) 32)
       (handle-members-ok? members 0 depth)
       (distinct-first-names? members)))

(defn- vector-members-ok? [members [:ref :form/r] i :i64 depth :i64] :bool
  (if (>= i (form/count-of members))
    true
    (if (native-handle-type? (form/nth-of members i) (+ depth 1))
      (vector-members-ok? members (+ i 1) depth)
      false)))

(defn native-handle-type? [t [:ref :form/r] depth :i64] :bool
  (and (<= depth 32)
       (or (native-word-value-type? t 0)
           (or (native-scalar-record-type? t 0)
               (and (form/is-vec? t)
                    (> (form/count-of t) 0)
                    (let [h (form/nth-of t 0)]
                      (cond
                        (kw-is? h :ref)
                        (and (= 2 (form/count-of t)) (ns-keyword? (form/nth-of t 1)))
                        (or (kw-is? h :record) (kw-is? h :variant))
                        (and (= 3 (form/count-of t))
                             (ns-keyword? (form/nth-of t 1))
                             (handle-members? (form/nth-of t 2) depth))
                        (kw-is? h :vector)
                        (and (= 2 (form/count-of t))
                             (form/is-vec? (form/nth-of t 1))
                             (>= (form/count-of (form/nth-of t 1)) 1)
                             (<= (form/count-of (form/nth-of t 1)) 32)
                             (vector-members-ok? (form/nth-of t 1) 0 depth))
                        (kw-is? h :option)
                        (and (= 2 (form/count-of t))
                             (native-handle-type? (form/nth-of t 1) (+ depth 1)))
                        (kw-is? h :result)
                        (and (= 3 (form/count-of t))
                             (native-handle-type? (form/nth-of t 1) (+ depth 1))
                             (native-handle-type? (form/nth-of t 2) (+ depth 1)))
                        :else false)))))))

;; (handle-of? head type): a vector type headed by HEAD that is a handle type
(defn handle-of? [head :keyword t [:ref :form/r]] :bool
  (and (form/is-vec? t)
       (> (form/count-of t) 0)
       (kw-is? (form/nth-of t 0) head)
       (native-handle-type? t 0)))

;; a variant with any payload other than :i64/:bool
(defn- any-non-scalar-payload? [cases [:ref :form/r] i :i64] :bool
  (if (>= i (form/count-of cases))
    false
    (let [p (form/nth-of (form/nth-of cases i) 1)]
      (if (or (kw-is? p :i64) (kw-is? p :bool))
        (any-non-scalar-payload? cases (+ i 1))
        true))))

(defn boxed-payload-variant-type? [t [:ref :form/r]] :bool
  (and (handle-of? :variant t)
       (any-non-scalar-payload? (form/nth-of t 2) 0)))

(defn- all-scalar-payloads? [cases [:ref :form/r] i :i64] :bool
  (not (any-non-scalar-payload? cases i)))

(defn scalar-replaced-record-type? [t [:ref :form/r]] :bool
  (and (native-scalar-record-type? t 0)
       (all-scalar-payloads? (form/nth-of t 2) 0)))

(defn scalar-replaced-variant-type? [t [:ref :form/r]] :bool
  (and (native-scalar-variant-type? t)
       (all-scalar-payloads? (form/nth-of t 2) 0)))

(defn- any-record-payload? [cases [:ref :form/r] i :i64] :bool
  (if (>= i (form/count-of cases))
    false
    (if (native-scalar-record-type? (form/nth-of (form/nth-of cases i) 1) 0)
      true
      (any-record-payload? cases (+ i 1)))))

(defn boxed-aggregate-variant-type? [t [:ref :form/r]] :bool
  (and (native-scalar-variant-boundary-type? t)
       (any-record-payload? (form/nth-of t 2) 0)))

;; ---- read-only literals ----------------------------------------------------------------
;; `kotoba.gmir/rodata-content?` restated (that module carries the whole GMIR
;; validator, which alone would push a verifier project past the linked-function
;; limit): CONTENT is a well-formed literal under ENCODING.

(defn- hex-digit-ok? [c :i64] :bool
  (or (and (>= c 48) (<= c 57))
      (or (and (>= c 97) (<= c 102)) (and (>= c 65) (<= c 70)))))

(defn- hex-run? [s :string from :i64 to :i64] :bool
  (if (>= from to)
    true
    (if (hex-digit-ok? (string-code-point-at s from))
      (hex-run? s (+ from 1) to)
      false)))

(defn- hex-field-ok? [s :string from :i64 to :i64 width :i64] :bool
  (and (= (- to from) width) (hex-run? s from to)))

(defn- utf16-ok? [s :string i :i64] :bool
  (if (>= i (string-byte-length s))
    true
    (let [code (string-code-point-at s i)]
      (if (or (and (<= 55296 code) (<= code 57343)) (> code 65535))
        false
        (utf16-ok? s (+ i (if (< code 128) 1 (if (< code 2048) 2 3))))))))

(defn- guid-ok? [s :string] :bool
  (let [n (string-byte-length s)
        d1 (string-find-byte s 45 0)
        d2 (if (< d1 0) -1 (string-find-byte s 45 (+ d1 1)))
        d3 (if (< d2 0) -1 (string-find-byte s 45 (+ d2 1)))
        d4 (if (< d3 0) -1 (string-find-byte s 45 (+ d3 1)))
        d5 (if (< d4 0) -1 (string-find-byte s 45 (+ d4 1)))]
    (and (>= d4 0) (< d5 0)
         (hex-field-ok? s 0 d1 8)
         (hex-field-ok? s (+ d1 1) d2 4)
         (hex-field-ok? s (+ d2 1) d3 4)
         (hex-field-ok? s (+ d3 1) d4 4)
         (hex-field-ok? s (+ d4 1) n 12))))

(defn rodata-valid? [encoding :keyword content :string] :bool
  (if (= encoding :utf-16le-nul)
    (utf16-ok? content 0)
    (if (= encoding :hex-bytes)
      (and (= 0 (rem (string-byte-length content) 2)) (hex-run? content 0 (string-byte-length content)))
      (if (= encoding :guid-mixed-endian) (guid-ok? content) false))))
