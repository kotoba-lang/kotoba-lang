(ns kotoba.json
  "Assembled from one repo per definition.

  This namespace holds no implementation. It re-exports the definitions
  that each live in their own repo, so a call site can require one name
  and a library can require only the definitions it actually uses.

  `read-str` / `write-str` are the exception: they re-export
  json.clojure-data-json from THIS repo -- clojure.data.json's contract
  (defaults, options, map order, escaping), measured against data.json 2.5.2.
  ADR-2609040930 routes clojure.data.json here, and with these two names a
  call site moves off clojure.data.json by renaming its namespace
  (scripts/migrate-clojure-data-json-to-kotoba-json.cljk in
  com-junkawasaki/root). They are NOT decode/encode: encode sorts keys and
  escapes neither `/` nor non-ASCII; decode refuses trailing input."
  {:kotoba/export [decode encode json read-str write-str]}
  (:require [kotoba.json.decode :as decode-ns]
            [kotoba.json.encode :as encode-ns]
            [kotoba.json.json :as json-ns]
            [json.clojure-data-json :as data-json-ns]))

(def decode "See kotoba.json.decode/decode." decode-ns/decode)
(def encode "See kotoba.json.encode/encode." encode-ns/encode)
(def json "See kotoba.json.json/json." json-ns/json)
(def read-str "See json.clojure-data-json/read-str." data-json-ns/read-str)
(def write-str "See json.clojure-data-json/write-str." data-json-ns/write-str)
