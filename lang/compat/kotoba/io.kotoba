(ns kotoba.io
  "Assembled from one repo per definition.

  This namespace holds no implementation. It re-exports the definitions
  that each live in their own repo, so a call site can require one name
  and a library can require only the definitions it actually uses.

  AN IMPLEMENTATION BUILT AGAINST kotoba.lang.io IS NOT ACCEPTED HERE.
  kotoba.lang.io still declares IReader, IWriter, and a protocol split into its own
  repo is a DIFFERENT protocol from the one the source namespace declares
  (ADR-2609091900). Measured 2026-09-09 on kotoba.lang.fs: a filesystem
  reified against the source protocol answers through the source namespace
  and fails through this one -- No implementation of method: :exists?.
  Build the implementation against the repo that declares the protocol here,
  or call through kotoba.lang.io.

  NOT re-exported here, on purpose: IReader, IWriter. A protocol's identity is what extend-type and reify dispatch on,
  and a copy would make an implementation silently extend nothing, so the
  protocol name stays in the one repo that declares it. Requiring that repo
  is a compile error away; a copy would not be.
"
  {:kotoba/export [buffer-writer byte-buffer copy len put reader-buffer reader-seq to-bytes as-file as-relative-path make-parents reader writer input-stream output-stream exists? file? directory? hidden? absolute? path parent parent-file absolute-path absolute-file canonical-path canonical-file mkdir mkdirs delete create-new-file rename-to length last-modified set-last-modified list-names list-files can-read? can-write? can-execute? file-seq read-all-bytes write-bytes delete-if-exists]}
  (:require [kotoba.io.reader :as ireader-ns] [kotoba.io.writer :as iwriter-ns] [kotoba.io.buffer-writer :as buffer-writer-ns] [kotoba.io.byte-buffer :as byte-buffer-ns] [kotoba.io.copy :as copy-ns] [kotoba.io.len :as len-ns] [kotoba.io.put :as put-ns] [kotoba.io.reader-buffer :as reader-buffer-ns] [kotoba.io.reader-seq :as reader-seq-ns] [kotoba.io.to-bytes :as to-bytes-ns] [kotoba.lang.io.file :as file-ns] [kotoba.lang.io.stream :as stream-ns]))

;; copy: kotoba.lang.io.stream/copy -- kotoba.io.copy/copy (drain an IReader
;; into an IWriter) when the input implements kotoba.io.reader/Reader, exactly
;; as before; otherwise clojure.java.io/copy (strings, byte arrays, files,
;; streams, readers, writers). copy-ns is still what the first case calls.
(def read! "See kotoba.io.reader/read!." ireader-ns/read!)
(def write! "See kotoba.io.writer/write!." iwriter-ns/write!)

;; The clojure.java.io-compatible portable subset (kotoba.lang.io.file, in
;; this repo): a `.cljk` consumer of clojure.java.io is moved here by
;; scripts/migrate-clojure-java-io-to-kotoba-io.cljk (com-junkawasaki/root).
;; `copy` above is clojure.java.io/copy too, for any input that is not an
;; IReader (kotoba.lang.io.stream, 2026-09-25).
(def file "See kotoba.lang.io.file/file." file-ns/file)
(def delete-file "See kotoba.lang.io.file/delete-file." file-ns/delete-file)

;; clojure.java.io's classpath lookup and stream makers (kotoba.lang.io.stream,
;; 2026-09-25): the JVM's own on the JVM, the kbb engine's own on kbb.
(def resource "See kotoba.lang.io.stream/resource." stream-ns/resource)

;; The java.io.File METHODS as functions of a file value (kotoba.lang.io.file):
;; scripts/migrate-java-io-file-interop-to-kotoba-io.cljk (com-junkawasaki/root)
;; rewrites `(.exists f)` -> `(io/exists? f)` etc. with these.
(def file-name "See kotoba.lang.io.file/file-name." file-ns/file-name)

;; java.nio.file.Files, ambient (kotoba.lang.io.file): paths in and out are
;; file values, never java.nio.file.Path.
;; scripts/migrate-java-nio-file-files-to-kotoba-io.cljk (com-junkawasaki/root)
;; rewrites `(Files/createTempDirectory "p" (make-array FileAttribute 0))` ->
;; `(io/temp-dir "p")` etc. with these.
(def temp-dir "See kotoba.lang.io.file/temp-dir." file-ns/temp-dir)
(def temp-file "See kotoba.lang.io.file/temp-file." file-ns/temp-file)
(def write-string "See kotoba.lang.io.file/write-string." file-ns/write-string)

;; ---- forwarding wrappers (the re-export convention: export names must be
;; functions this module defines). Generated from the target twins' signatures.
(defn buffer-writer
  "See kotoba.io.buffer-writer/buffer-writer."
  [buf]
  (buffer-writer-ns/buffer-writer buf))

(defn byte-buffer
  "See kotoba.io.byte-buffer/byte-buffer."
  []
  (byte-buffer-ns/byte-buffer ))

(defn copy
  "See kotoba.lang.io.stream/copy (and kotoba.io.copy/copy)."
  [input output & opts]
  (stream-ns/copy input output & opts))

(defn len
  "See kotoba.io.len/len."
  [buf]
  (len-ns/len buf))

(defn put
  "See kotoba.io.put/put."
  [buf ^bytes arr]
  (put-ns/put buf ^bytes arr))

(defn reader-buffer
  "See kotoba.io.reader-buffer/reader-buffer."
  [buf]
  (reader-buffer-ns/reader-buffer buf))

(defn reader-seq
  "See kotoba.io.reader-seq/reader-seq."
  [reader]
  (reader-seq-ns/reader-seq reader))

(defn to-bytes
  "See kotoba.io.to-bytes/to-bytes."
  [buf]
  (to-bytes-ns/to-bytes buf))

(defn as-file
  "See kotoba.lang.io.file/as-file."
  [x]
  (file-ns/as-file x))

(defn as-relative-path
  "See kotoba.lang.io.file/as-relative-path."
  [x]
  (file-ns/as-relative-path x))

(defn make-parents
  "See kotoba.lang.io.file/make-parents."
  [f & more]
  (file-ns/make-parents f & more))

(defn reader
  "See kotoba.lang.io.stream/reader."
  [x & opts]
  (stream-ns/reader x & opts))

(defn writer
  "See kotoba.lang.io.stream/writer."
  [x & opts]
  (stream-ns/writer x & opts))

(defn input-stream
  "See kotoba.lang.io.stream/input-stream."
  [x & opts]
  (stream-ns/input-stream x & opts))

(defn output-stream
  "See kotoba.lang.io.stream/output-stream."
  [x & opts]
  (stream-ns/output-stream x & opts))

(defn exists?
  "See kotoba.lang.io.file/exists?."
  [f]
  (file-ns/exists? f))

(defn file?
  "See kotoba.lang.io.file/file?."
  [f]
  (file-ns/file? f))

(defn directory?
