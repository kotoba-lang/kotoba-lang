(defn path
  "See kotoba.lang.io.file/path."
  [f]
  (file-ns/path f))

(defn parent
  "See kotoba.lang.io.file/parent."
  [f]
  (file-ns/parent f))

(defn parent-file
  "See kotoba.lang.io.file/parent-file."
  [f]
  (file-ns/parent-file f))

(defn absolute-path
  "See kotoba.lang.io.file/absolute-path."
  [f]
