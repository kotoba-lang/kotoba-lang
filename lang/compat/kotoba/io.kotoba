(ns kotoba.io
  "Assembled from one repo per definition.

  This namespace holds no implementation. It re-exports the definitions
  that each live in their own repo, so a call site can require one name
  and a library can require only the definitions it actually uses.

  AN IMPLEMENTATION BUILT AGAINST kotoba.lang.io IS NOT ACCEPTED HERE.
  kotoba.lang.io still declares IReader, IWriter, and a protocol split into its own
  repo is a DIFFERENT protocol from the one the source namespace declares
  (ADR-2609091900). Measured 2026-09-09 on kotoba.lang.fs: a filesystem
  reified against the source protocol answers through the source namespace
  and fails through this one -- No implementation of method: :exists?.
  Build the implementation against the repo that declares the protocol here,
  or call through kotoba.lang.io.

  NOT re-exported here, on purpose: IReader, IWriter. A protocol's identity is what extend-type and reify dispatch on,
  and a copy would make an implementation silently extend nothing, so the
  protocol name stays in the one repo that declares it. Requiring that repo
  is a compile error away; a copy would not be.
"
  (:refer-clojure :exclude [file-seq])
  (:require [kotoba.io.reader :as ireader-ns]
            [kotoba.io.writer :as iwriter-ns]
            [kotoba.io.buffer-writer :as buffer-writer-ns]
            [kotoba.io.byte-buffer :as byte-buffer-ns]
            [kotoba.io.copy :as copy-ns]
            [kotoba.io.len :as len-ns]
            [kotoba.io.put :as put-ns]
            [kotoba.io.reader-buffer :as reader-buffer-ns]
            [kotoba.io.reader-seq :as reader-seq-ns]
            [kotoba.io.to-bytes :as to-bytes-ns]
            [kotoba.lang.io.file :as file-ns]
            [kotoba.lang.io.stream :as stream-ns]))

(def buffer-writer "See kotoba.io.buffer-writer/buffer-writer." buffer-writer-ns/buffer-writer)
(def byte-buffer "See kotoba.io.byte-buffer/byte-buffer." byte-buffer-ns/byte-buffer)
;; copy: kotoba.lang.io.stream/copy -- kotoba.io.copy/copy (drain an IReader
;; into an IWriter) when the input implements kotoba.io.reader/Reader, exactly
;; as before; otherwise clojure.java.io/copy (strings, byte arrays, files,
;; streams, readers, writers). copy-ns is still what the first case calls.
(def copy "See kotoba.lang.io.stream/copy (and kotoba.io.copy/copy)." stream-ns/copy)
(def len "See kotoba.io.len/len." len-ns/len)
(def put "See kotoba.io.put/put." put-ns/put)
(def read! "See kotoba.io.reader/read!." ireader-ns/read!)
(def reader-buffer "See kotoba.io.reader-buffer/reader-buffer." reader-buffer-ns/reader-buffer)
(def reader-seq "See kotoba.io.reader-seq/reader-seq." reader-seq-ns/reader-seq)
(def to-bytes "See kotoba.io.to-bytes/to-bytes." to-bytes-ns/to-bytes)
(def write! "See kotoba.io.writer/write!." iwriter-ns/write!)

;; The clojure.java.io-compatible portable subset (kotoba.lang.io.file, in
;; this repo): a `.cljk` consumer of clojure.java.io is moved here by
;; scripts/migrate-clojure-java-io-to-kotoba-io.cljk (com-junkawasaki/root).
;; `copy` above is clojure.java.io/copy too, for any input that is not an
;; IReader (kotoba.lang.io.stream, 2026-09-25).
(def file "See kotoba.lang.io.file/file." file-ns/file)
(def as-file "See kotoba.lang.io.file/as-file." file-ns/as-file)
(def as-relative-path "See kotoba.lang.io.file/as-relative-path." file-ns/as-relative-path)
(def make-parents "See kotoba.lang.io.file/make-parents." file-ns/make-parents)
(def delete-file "See kotoba.lang.io.file/delete-file." file-ns/delete-file)

;; clojure.java.io's classpath lookup and stream makers (kotoba.lang.io.stream,
;; 2026-09-25): the JVM's own on the JVM, the kbb engine's own on kbb.
(def resource "See kotoba.lang.io.stream/resource." stream-ns/resource)
(def reader "See kotoba.lang.io.stream/reader." stream-ns/reader)
(def writer "See kotoba.lang.io.stream/writer." stream-ns/writer)
(def input-stream "See kotoba.lang.io.stream/input-stream." stream-ns/input-stream)
(def output-stream "See kotoba.lang.io.stream/output-stream." stream-ns/output-stream)

;; The java.io.File METHODS as functions of a file value (kotoba.lang.io.file):
;; scripts/migrate-java-io-file-interop-to-kotoba-io.cljk (com-junkawasaki/root)
;; rewrites `(.exists f)` -> `(io/exists? f)` etc. with these.
(def exists? "See kotoba.lang.io.file/exists?." file-ns/exists?)
(def file? "See kotoba.lang.io.file/file?." file-ns/file?)
(def directory? "See kotoba.lang.io.file/directory?." file-ns/directory?)
(def hidden? "See kotoba.lang.io.file/hidden?." file-ns/hidden?)
(def absolute? "See kotoba.lang.io.file/absolute?." file-ns/absolute?)
(def file-name "See kotoba.lang.io.file/file-name." file-ns/file-name)
(def path "See kotoba.lang.io.file/path." file-ns/path)
(def parent "See kotoba.lang.io.file/parent." file-ns/parent)
(def parent-file "See kotoba.lang.io.file/parent-file." file-ns/parent-file)
(def absolute-path "See kotoba.lang.io.file/absolute-path." file-ns/absolute-path)
(def absolute-file "See kotoba.lang.io.file/absolute-file." file-ns/absolute-file)
(def canonical-path "See kotoba.lang.io.file/canonical-path." file-ns/canonical-path)
(def canonical-file "See kotoba.lang.io.file/canonical-file." file-ns/canonical-file)
(def mkdir "See kotoba.lang.io.file/mkdir." file-ns/mkdir)
(def mkdirs "See kotoba.lang.io.file/mkdirs." file-ns/mkdirs)
(def delete "See kotoba.lang.io.file/delete." file-ns/delete)
(def create-new-file "See kotoba.lang.io.file/create-new-file." file-ns/create-new-file)
(def rename-to "See kotoba.lang.io.file/rename-to." file-ns/rename-to)
(def length "See kotoba.lang.io.file/length." file-ns/length)
(def last-modified "See kotoba.lang.io.file/last-modified." file-ns/last-modified)
(def set-last-modified "See kotoba.lang.io.file/set-last-modified." file-ns/set-last-modified)
(def list-names "See kotoba.lang.io.file/list-names." file-ns/list-names)
(def list-files "See kotoba.lang.io.file/list-files." file-ns/list-files)
(def can-read? "See kotoba.lang.io.file/can-read?." file-ns/can-read?)
(def can-write? "See kotoba.lang.io.file/can-write?." file-ns/can-write?)
(def can-execute? "See kotoba.lang.io.file/can-execute?." file-ns/can-execute?)
(def file-seq "See kotoba.lang.io.file/file-seq." file-ns/file-seq)

;; java.nio.file.Files, ambient (kotoba.lang.io.file): paths in and out are
;; file values, never java.nio.file.Path.
;; scripts/migrate-java-nio-file-files-to-kotoba-io.cljk (com-junkawasaki/root)
;; rewrites `(Files/createTempDirectory "p" (make-array FileAttribute 0))` ->
;; `(io/temp-dir "p")` etc. with these.
(def temp-dir "See kotoba.lang.io.file/temp-dir." file-ns/temp-dir)
(def temp-file "See kotoba.lang.io.file/temp-file." file-ns/temp-file)
(def read-all-bytes "See kotoba.lang.io.file/read-all-bytes." file-ns/read-all-bytes)
(def write-bytes "See kotoba.lang.io.file/write-bytes." file-ns/write-bytes)
(def write-string "See kotoba.lang.io.file/write-string." file-ns/write-string)
(def delete-if-exists "See kotoba.lang.io.file/delete-if-exists." file-ns/delete-if-exists)
