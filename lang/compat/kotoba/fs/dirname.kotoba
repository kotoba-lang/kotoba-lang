(ns kotoba.fs.dirname
  "dirname -- addressed on its own.

  Split out of kotoba.lang.fs on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.lang.text :as str]
            [kotoba.fs.join :refer [join]]
            [kotoba.fs.sep :refer [sep]]
            [kotoba.fs.split :refer [split]])
  )

(defn dirname [p]
  (let [parts (split p)]
    (cond
      (<= (count parts) 1) ""
      (= 2 (count parts)) (if (= "/" (first parts)) "/" "")
      :else (if (= "/" (first parts))
              (str sep (str/join sep (rest (butlast parts))))
              (str/join sep (butlast parts))))))
