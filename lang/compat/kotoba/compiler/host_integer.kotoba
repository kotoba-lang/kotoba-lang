(ns kotoba.compiler.host-integer
  "Integers across the host's two number types -- leaves with two readings
  (superproject adr-2609242330 section 1 (b), the S1 leaf pattern; the S2
  item \"Number/BigInt normalisation\").

  Under nbb the compiler's bounded EDN reader answers every integer as a
  BigInt (an i64 IS one there), while host indexes, the KIR oracle's fuel and
  Buffer.from want a Number. Under Kotoba there is one integer type, i64, so
  every leaf here is the identity or a plain decimal parse.

    bigint?         a host BigInt (false under Kotoba: there is no second type)
    narrow          a BigInt as a Number (a Number stays one)
    narrow-below-max-safe
                    a BigInt below 2^53-1 as a Number; any other value as is
    exact           decimal TEXT as an exact integer (BigInt under nbb)
    safe-integer?   an integer within +-(2^53-1)
    decimal-count   TEXT as Number(TEXT) when that is a safe integer, else nil
                    (so \"\", \" 12 \", \"1e3\" read as node's Number reads them)"
  {:kotoba/export [bigint? decimal-count exact narrow narrow-below-max-safe safe-integer?]}
  (:require [kotoba.compiler.decimal-text :as decimal-text]
            ))

(def ^:private max-safe 9007199254740991)

(defn narrow [x]
  x)

(defn exact [text]
  (decimal-text/parse text))

(defn safe-integer? [x]
  (<= (- max-safe) x max-safe))

(defn decimal-count [text]
  (when (decimal-text/decimal? text) (decimal-text/parse text)))

(defn bigint? [x]
  false)

(defn narrow-below-max-safe [x]
  x)
