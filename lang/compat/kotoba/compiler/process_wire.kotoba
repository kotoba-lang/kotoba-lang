(ns kotoba.compiler.process-wire
  "The process/spawn wire (catalog wire 20), spelled and read -- pure
  (superproject adr-2609242330 S5, section 1 (b)).

    request  <program>[ARG_SEP<arg>]...
    answer   <exit>\\n<stdout>, <exit> -1 for a child ended by a signal

  The grammar is the Linux static ELF's (superproject adr-2609251400 C3) and
  the nbb handler's (kotoba.compiler.nbb.host.process). An argument that
  itself holds \"ARG_SEP\" cannot be sent: `request` refuses it by name
  rather than let the host split it into two arguments."
  {:kotoba/export [answer-exit answer-out request]}
  (:require [kotoba.compiler.decimal-text :as decimal-text]
            [kotoba.lang.text :as text]))

(def ^:private separator "ARG_SEP")

(defn request
  "The wire request running PROGRAM with the argument vector ARGS."
  [program args]
  ;; Joined with NUL, which the token does not hold, a match can only lie
  ;; inside one part.
  (if (text/includes? (text/join "\u0000" (cons program args)) separator)
    (throw (ex-info "process/spawn argument holds the ARG_SEP token"
                    {:phase :spawn :arguments (vec (cons program args))}))
    (text/join separator (cons program args))))

(defn- newline-at [answer]
  (let [at (text/index-of answer "\n")]
    (when (nil? at)
      (throw (ex-info "process/spawn answer has no exit line" {:phase :spawn})))
    at))

(defn answer-exit
  "The child's exit status from ANSWER (-1: ended by a signal)."
  [answer]
  (let [line (subs answer 0 (newline-at answer))]
    (if (decimal-text/decimal? line)
      (decimal-text/parse line)
      (throw (ex-info "process/spawn exit line is not a decimal" {:phase :spawn :line line})))))

(defn answer-out
  "The child's captured stdout from ANSWER."
  [answer]
  (subs answer (inc (newline-at answer))))
