(ns kotoba.compiler.process-wire
  "The process/spawn wire (catalog wire 20), spelled and read -- pure
  (superproject adr-2609242330 S5, section 1 (b)).

    request  <program>[ARG_SEP<arg>]...
    answer   <exit>\\n<stdout>, <exit> -1 for a child ended by a signal

  The grammar is the Linux static ELF's (superproject adr-2609251400 C3) and
  the nbb handler's (kotoba.compiler.nbb.host.process). An argument that
  itself holds \"ARG_SEP\" cannot be sent: `request` refuses it by name
  rather than let the host split it into two arguments."
  {:kotoba/export [answer-exit answer-out request]}
  (:require [kotoba.compiler.decimal-text :as decimal-text] [kotoba.lang.text :as text]))

(def ^:private separator "ARG_SEP")

(defn- with-program
  "PROGRAM followed by ARGS, as the one sequence the wire joins."
  [program :string args [:list :string]]
  [:list :string]
  (reduce (fn [acc x] (conj acc x))
                     (typed-list-new [:list :string] program)
                     args))

(defn- as-document
     "The parts as a document vector, for the refusal's data."
     [parts [:list :string]] :document
     (reduce (fn [acc x] (document-vector-conj acc (document-string x)))
             (document-vector)
             parts))

(defn request
  "The wire request running PROGRAM with the argument vector ARGS."
  [program :string args [:list :string]]
  :string
  ;; Joined with NUL, which the token does not hold, a match can only lie
  ;; inside one part.
  (if (text/includes? (text/join "\u0000" (with-program program args)) separator)
    (throw (ex-info "process/spawn argument holds the ARG_SEP token"
                    {:phase :spawn
                     :arguments (as-document (with-program program args))}))
    (text/join separator (with-program program args))))

(defn- newline-at [answer :string]
  :i64
  (let [at (string-find-byte answer 10 0)]
    (when (< at 0)
      (throw (ex-info "process/spawn answer has no exit line" {:phase :spawn})))
    at))

(defn answer-exit
  "The child's exit status from ANSWER (-1: ended by a signal)."
  [answer :string] :i64
  (let [line (string-substring answer 0 (newline-at answer))]
    (if (decimal-text/decimal? line)
      (decimal-text/parse line)
      (throw (ex-info "process/spawn exit line is not a decimal"
                      {:phase :spawn
                       :line (document-string line)})))))

(defn answer-out
  "The child's captured stdout from ANSWER."
  [answer :string] :string
  (string-substring answer (inc (newline-at answer)) (string-byte-length answer)))
