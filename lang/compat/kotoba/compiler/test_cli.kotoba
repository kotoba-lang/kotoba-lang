(ns kotoba.compiler.test-cli
  "`amu test <file.kotoba>` -- run a source's exported `test-*` definitions
  on every semantic target and report. One implementation on both hosts
  (ADR 0348 iteration 7): `kotoba.compiler.cli` delegates here on the JVM,
  `kotoba.compiler.nbb.test-cli` is the Node entrypoint.

  `run` returns the report and the lines to print; the entrypoint prints and
  exits. A report whose `:ok` is false is a non-zero exit (1) on both hosts
  -- a failing test must not look like a passing run to a caller that only
  reads the status."
  {:kotoba/export [run]}
  (:require [kotoba.compiler.bounded-edn :as bounded-edn]
            [kotoba.compiler.manifest-mode :as manifest-mode]
            [kotoba.compiler.manifest-native :as manifest-native]
            [kotoba.compiler.posix-path :as posix-path]
            [kotoba.compiler.project :as project]
            [kotoba.compiler.project-files :as project-files]
            [kotoba.compiler.source-path :as source-path]
            [kotoba.compiler.test-profile :as test-profile]
            [kotoba.lang.text :as str]))

(defn- source-paths
  "Every `--source-path <dir>` in ARGS, in order."
  [args]
  (loop [args args acc []]
    (cond (empty? args) acc
          (= "--source-path" (first args)) (recur (nnext args) (conj acc (second args)))
          :else (recur (next args) acc))))

(defn- flat-results [report]
  (mapcat (fn [[target rows]] (map #(assoc % :target target) rows))
          (or (:results report) {})))

(defn human-lines
  "The `kotoba test:` summary line and one ` FAIL` line per failing case
  (the latter go to stderr on both routes). A `--manifest` report has its
  own lines (`kotoba.compiler.manifest-mode/human-lines`)."
  [report]
  (if (= :kotoba.conformance-report/v1 (:format report))
    (manifest-mode/human-lines report)
  (let [flat (flat-results report)
        passed (count (filter :ok flat))]
    {:out [(str "kotoba test: " passed "/" (count flat)
                (if (:ok report) " passed" " FAILED")
                " tests=" (pr-str (or (:tests report) []))
                " targets=" (pr-str (or (:targets report) [])))]
     :err (vec (for [r flat :when (not (:ok r))]
                 (str " FAIL " (:test r) " target=" (:target r) " " (or (:error r) ""))))})))

(defn- option
  "The value after the first FLAG in ARGS; a flag given without one is
  refused by name."
  [args flag]
  (when (some #{flag} args)
    (let [value (second (drop-while #(not= flag %) args))]
      (when (or (nil? value) (str/starts-with? value "--"))
        (throw (ex-info (str flag " requires a value") {:phase :usage :flag flag})))
      value)))

(defn- options [args flag]
  (loop [args args acc []]
    (cond (empty? args) acc
          (= flag (first args)) (recur (nnext args) (conj acc (second args)))
          :else (recur (next args) acc))))

(defn- fuel-option [args]
  (when-let [text (when (some #{"--fuel"} args)
                    (or (second (drop-while #(not= "--fuel" %) args)) ""))]
    (when-not (re-matches #"[1-9][0-9]*" text)
      (throw (ex-info "--fuel must be a positive decimal integer"
                      {:phase :usage :fuel text})))
    ))

(defn- native-option
  "`{:runtime-dir d :parallel n}` from `--native-runtime <dir>` or
  `--native-prepare <dir>` (which first measures a runtime into DIR,
  honouring `--loader-source-dir <dir>` / KOTOBA_LOADER_SOURCE_DIR), and
  `--native-jobs <n>` (parallel native cases, default 4); nil without either."
  [args]
  (let [runtime (option args "--native-runtime")
        prepare (option args "--native-prepare")
        jobs (option args "--native-jobs")]
    (when (and runtime prepare)
      (throw (ex-info "--native-runtime and --native-prepare are exclusive: --native-prepare <dir> measures a runtime into <dir> and uses it"
                      {:phase :usage})))
    (when (and jobs (not (re-matches #"[1-9][0-9]?" jobs)))
      (throw (ex-info "--native-jobs must be an integer from 1 to 99" {:phase :usage :native-jobs jobs})))
    (when prepare
      (manifest-native/prepare! prepare {:loader-source-dir (option args "--loader-source-dir")}))
    (when-let [dir (or runtime prepare)]
      (cond-> {:runtime-dir dir}
        jobs (assoc :parallel )))))

(defn- run-manifest
  "`test --manifest <manifest.edn> [--conformance-root <dir>] [--case <id> ...]
  [--json] [--fuel <n>] [--native-runtime <dir> | --native-prepare <dir>
  [--loader-source-dir <dir>]] [--native-jobs <n>]` (root ADR-2610092330 C0,
  C1). The conformance root -- the directory each case's :entry is relative
  to -- defaults to the manifest's own directory. Without a native runtime the
  native backends are :skipped with the reason saying how to supply one."
  [args]
  (let [manifest-path (option args "--manifest")
        native (native-option args)
        root (or (option args "--conformance-root") (posix-path/dirname manifest-path))
        only (set (map #(keyword (str/replace-first % #"^:" "")) (options args "--case")))
        manifest (bounded-edn/read-file manifest-path)]
    (when-not (and (map? manifest) (sequential? (:cases manifest)))
      (throw (ex-info "a conformance manifest is a map with a :cases vector"
                      {:phase :usage :manifest manifest-path})))
    {:report (manifest-mode/run-manifest manifest root
                                         (cond-> {:manifest-path manifest-path}
                                           (seq only) (assoc :only only)
                                           native (assoc :native native)
                                           (fuel-option args) (assoc :fuel (fuel-option args))))
     :json? (boolean (some #{"--json"} args))}))

(defn run
  "ARGS as `bin/amu` hands them: `test <file> [--json] [--fuel <n>]
  [--source-path <dir> ...]`.
  Returns `{:report r :json? bool}`; the report's `:ok` decides the exit
  status. `--fuel` is the per-test budget (each test runs on a fresh
  instance); a value that is not a positive decimal integer is refused by
  name, as `amu compile --fuel` refuses it.

  `--source-path` (2026-09-16): the tests of a module that `(:require ...)`s
  others -- a template module's tests in particular, which can only exist
  in an importer that binds its `:params` -- are the exported `test-*` of
  the LINKED unit, the same closed graph `compile --source-path` links
  through `project/link-source`. Without this flag such a file was refused
  as a malformed `:export` / unresolved namespace, so a project's tests
  could be compiled but never run."
  [args]
  (if (some #{"--manifest"} args)
    (run-manifest args)
  (let [input (source-path/admit! (second args))
        roots (source-paths args)
        linked (when (seq roots)
                 (let [graph (project-files/load-closed-graph input roots)]
                   (project/link-source (:sources graph) (:root graph))))
        json? (boolean (some #{"--json"} args))
        fuel (when (some #{"--fuel"} args)
               (let [text (second (drop-while #(not= "--fuel" %) args))]
                 (when-not (and text (re-matches #"[1-9][0-9]*" text))
                   (throw (ex-info "--fuel must be a positive decimal integer"
                                   {:phase :usage :fuel text})))
                 ))
        report (test-profile/run-source (if linked (:source linked) (bounded-edn/read-text-file input))
                                        (cond-> {}
                                          fuel (assoc :fuel fuel)
                                          linked (assoc :admit-linked-synthetics? true)))]
    {:report report :json? json?})))
