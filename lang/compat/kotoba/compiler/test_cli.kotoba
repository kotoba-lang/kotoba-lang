(ns kotoba.compiler.test-cli
  "`amu test <file.kotoba>` -- run a source's exported `test-*` definitions
  on every semantic target and report. One implementation on both hosts
  (ADR 0348 iteration 7): `kotoba.compiler.cli` delegates here on the JVM,
  `kotoba.compiler.nbb.test-cli` is the Node entrypoint.

  `run` returns the report and the lines to print; the entrypoint prints and
  exits. A report whose `:ok` is false is a non-zero exit (1) on both hosts
  -- a failing test must not look like a passing run to a caller that only
  reads the status."
  {:kotoba/export [run]}
  (:require [kotoba.compiler.bounded-edn :as bounded-edn] [kotoba.compiler.manifest-mode :as manifest-mode] [kotoba.compiler.manifest-native :as manifest-native] [kotoba.compiler.posix-path :as posix-path] [kotoba.compiler.project :as project] [kotoba.compiler.project-files :as project-files] [kotoba.compiler.source-path :as source-path] [kotoba.compiler.test-profile :as test-profile] [kotoba.lang.text :as str]))

;; Kotoba: `amu test` links a closed graph of sources (`project`), runs every
;; exported `test-*` on every semantic target through the reference
;; interpreter, and reports an open map of per-target rows. The interpreter and
;; the report are host values, so on this route the command is a refusal that
;; names the reason rather than an absent export.
(defn run [args [:list :string]] :string
     (throw (ex-info "amu test is not available on the Kotoba route"
                     {:phase :usage})))

nil
