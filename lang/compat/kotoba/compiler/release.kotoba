(ns kotoba.compiler.release
  "Release attestation: an SPDX 2.3 SBOM that is a pure function of the
  artifact bytes, and an Ed25519 statement over {artifact, sbom, target}.

  Portable since 2026-09-11 (ADR 0347): the file walk that was
  `java.nio.file` + `MessageDigest` has a `:cljs` branch on `node:fs` and
  `node:crypto` with the same refusals (regular file, no symlink, byte
  limit, SPDX-safe name). The statement, the signature and the verdicts are
  host-independent. Integers read back on the Node host are bigint, so the
  validity bounds and the recorded sizes are admitted through
  `verifier/guest-integer?` and compared through a normalizing equality."
  {:kotoba/export [attest file-identity sbom-bytes verify!]}
  (:require [kotoba.bytes :as kbytes] [kotoba.lang.coll :as coll] [kotoba.verifier :as verifier] [kotoba.verifier.signing :as signing] [kotoba.kir.target :as target] [kotoba.form :as form] [kotoba.verifier.seal :as seal] [sha2.core :as sha2] [
                       
                       ])
  
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]}))

nil
