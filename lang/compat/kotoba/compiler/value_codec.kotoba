(ns kotoba.compiler.value-codec
  "Bounded compiler/provider adapter for the org-owned canonical value codec.

  This is deliberately a host boundary, not new Kotoba source sugar. A typed
  ability chooses its own `max-bytes`, then uses the same `kotoba.value.v1`
  bytes as actor and I/O libraries."
  {:kotoba/export [encode-bounded]}
  (:require [kotoba.value.codec :as value])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]}))

;; Kotoba: the adapter is a host boundary over runtime values, type descriptors
;; and provider closures (open maps throughout); what a Kotoba caller has of it
;; is the bounded encode of a value Form, which is the guest twin of
;; `kotoba.value.codec` (encode side only; there is no CBOR decoder on this
;; route). A value over the ceiling traps.
(defn encode-bounded [value [:ref :form/r] max-bytes :i64] :bytes
     (value/encode-bounded value max-bytes))

nil
