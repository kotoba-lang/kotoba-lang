;; kotoba.compiler.refactor.finding -- GUEST-ONLY helper of the refactor twins (no host module of this name): the typed
;; form of the host's finding map, which every rule (rules/*.cljk) builds and kotoba.compiler.refactor.core consumes:
;;   {:rule :s :e :region :status :line :context :reason :kind :edits :ported? :force-apply :pass :data}
;;
;;   :finding/f = [rule :string] (the rule id keyword's name: "kwcallback" ...) [s :i64] [e :i64] [region :keyword]
;;                [status :string] ("auto" "human" "info") [line :i64] (-1 = absent)
;;                [context :string] [reason :string] [kind :string]  ("" = absent on the host)
;;                [kind-kw :bool] (the host's :kind is a keyword, else a string)
;;                [edits [:list :edit/e]] [ported :bool] [force :bool] [pass :i64]
;;                [inv [:list :finding/row]]  an inventory's :data as rows (rule-specific, see the rule)
;;   :finding/row = [a :string] [b :string] [n :i64]

(ns kotoba.compiler.refactor.finding
  (:require [kotoba.compiler.refactor.edit :as edit])
  (:export [mk with-ported with-pass with-force f-rule f-s f-e f-region f-status f-line f-context f-reason f-kind
            f-kind-kw? f-edits f-ported? f-force? f-pass f-inv fs-new fs-conj fs-count fs-nth fs-concat
            row row-a row-b row-n rows-new rows-conj rows-count rows-nth auto human u16-index u16-off])
  (:schemas {:finding/u16 [:record :finding/u16 [[:pos :vector-i64] [:delta :vector-i64]]]
             :finding/row [:record :finding/row [[:a :string] [:b :string] [:n :i64]]]
             :finding/f [:record :finding/f
                         [[:rule :string] [:s :i64] [:e :i64] [:region :keyword] [:status :string] [:line :i64]
                          [:context :string] [:reason :string] [:kind :string] [:kind-kw :bool]
                          [:edits [:list [:ref :edit/e]]] [:ported :bool] [:force :bool] [:pass :i64]
                          [:inv [:list [:ref :finding/row]]]]]}))

(defn rows-new [] [:list [:ref :finding/row]] (typed-list-new [:list [:ref :finding/row]]))
(defn row [a :string b :string n :i64] [:ref :finding/row] (record-new [:ref :finding/row] a b n))
(defn row-a [r [:ref :finding/row]] :string (record-get [:ref :finding/row] r :a))
(defn row-b [r [:ref :finding/row]] :string (record-get [:ref :finding/row] r :b))
(defn row-n [r [:ref :finding/row]] :i64 (record-get [:ref :finding/row] r :n))
(defn rows-conj [xs [:list [:ref :finding/row]] r [:ref :finding/row]] [:list [:ref :finding/row]]
  (typed-list-conj [:list [:ref :finding/row]] xs r))
(defn rows-count [xs [:list [:ref :finding/row]]] :i64 (vector-count xs))
(defn rows-nth [xs [:list [:ref :finding/row]] i :i64] [:ref :finding/row] (typed-list-nth [:list [:ref :finding/row]] xs i))

(defn mk [rule :string s :i64 e :i64 region :keyword status :string line :i64 context :string reason :string
          kind :string kind-kw :bool edits [:list [:ref :edit/e]] inv [:list [:ref :finding/row]]] [:ref :finding/f]
  (record-new [:ref :finding/f] rule s e region status line context reason kind kind-kw edits false false 0 inv))

(defn f-rule [f [:ref :finding/f]] :string (record-get [:ref :finding/f] f :rule))
(defn f-s [f [:ref :finding/f]] :i64 (record-get [:ref :finding/f] f :s))
(defn f-e [f [:ref :finding/f]] :i64 (record-get [:ref :finding/f] f :e))
(defn f-region [f [:ref :finding/f]] :keyword (record-get [:ref :finding/f] f :region))
(defn f-status [f [:ref :finding/f]] :string (record-get [:ref :finding/f] f :status))
(defn f-line [f [:ref :finding/f]] :i64 (record-get [:ref :finding/f] f :line))
(defn f-context [f [:ref :finding/f]] :string (record-get [:ref :finding/f] f :context))
(defn f-reason [f [:ref :finding/f]] :string (record-get [:ref :finding/f] f :reason))
(defn f-kind [f [:ref :finding/f]] :string (record-get [:ref :finding/f] f :kind))
(defn f-kind-kw? [f [:ref :finding/f]] :bool (record-get [:ref :finding/f] f :kind-kw))
(defn f-edits [f [:ref :finding/f]] [:list [:ref :edit/e]] (record-get [:ref :finding/f] f :edits))
(defn f-ported? [f [:ref :finding/f]] :bool (record-get [:ref :finding/f] f :ported))
(defn f-force? [f [:ref :finding/f]] :bool (record-get [:ref :finding/f] f :force))
(defn f-pass [f [:ref :finding/f]] :i64 (record-get [:ref :finding/f] f :pass))
(defn f-inv [f [:ref :finding/f]] [:list [:ref :finding/row]] (record-get [:ref :finding/f] f :inv))

(defn- copy [f [:ref :finding/f] ported :bool force :bool pass :i64] [:ref :finding/f]
  (record-new [:ref :finding/f] (f-rule f) (f-s f) (f-e f) (f-region f) (f-status f) (f-line f) (f-context f)
              (f-reason f) (f-kind f) (f-kind-kw? f) (f-edits f) ported force pass (f-inv f)))
(defn with-ported [f [:ref :finding/f] p :bool] [:ref :finding/f] (copy f p (f-force? f) (f-pass f)))
(defn with-force [f [:ref :finding/f]] [:ref :finding/f] (copy f (f-ported? f) true (f-pass f)))
(defn with-pass [f [:ref :finding/f] pass :i64] [:ref :finding/f] (copy f (f-ported? f) (f-force? f) pass))

(defn fs-new [] [:list [:ref :finding/f]] (typed-list-new [:list [:ref :finding/f]]))
(defn fs-conj [xs [:list [:ref :finding/f]] f [:ref :finding/f]] [:list [:ref :finding/f]]
  (typed-list-conj [:list [:ref :finding/f]] xs f))
(defn fs-count [xs [:list [:ref :finding/f]]] :i64 (vector-count xs))
(defn fs-nth [xs [:list [:ref :finding/f]] i :i64] [:ref :finding/f] (typed-list-nth [:list [:ref :finding/f]] xs i))
(defn fs-concat [a [:list [:ref :finding/f]] b [:list [:ref :finding/f]]] [:list [:ref :finding/f]]
  (let [n (vector-count b)] (loop [i 0 acc a] (if (>= i n) acc (recur (+ i 1) (fs-conj acc (fs-nth b i)))))))

;; shorthands: an automatic finding with edits, a human one with a reason
(defn auto [rule :string s :i64 e :i64 region :keyword line :i64 context :string kind :string kind-kw :bool
            edits [:list [:ref :edit/e]]] [:ref :finding/f]
  (mk rule s e region "auto" line context "" kind kind-kw edits (rows-new)))
(defn human [rule :string s :i64 e :i64 region :keyword line :i64 context :string reason :string kind :string
             kind-kw :bool] [:ref :finding/f]
  (mk rule s e region "human" line context reason kind kind-kw (edit/edits-new) (rows-new)))

;; ---------------------------------------------------------------------------
;; host offsets: the host counts UTF-16 units, the twins UTF-8 bytes; generated names embed an offset ("dd__<s>_1",
;; "fe-lc__<s>"), so they need the host's number. u16-index records, after every non-ASCII code point, the running
;; difference bytes - units; u16-off answers off - the difference before it (binary search).

(defn- cpw [p :i64] :i64 (if (< p 128) 1 (if (< p 2048) 2 (if (< p 65536) 3 4))))

(defn u16-index [src :string] [:ref :finding/u16]
  (let [n (string-byte-length src)]
    (loop [i 0 d 0 pos (vector-alloc 0) del (vector-alloc 0)]
      (if (>= i n)
        (record-new [:ref :finding/u16] pos del)
        (let [p (string-code-point-at src i) w (cpw p)]
          (if (= w 1)
            (recur (+ i 1) d pos del)
            (let [d2 (+ d (- w (if (>= p 65536) 2 1)))]
              (recur (+ i w) d2 (vector-conj pos (+ i w)) (vector-conj del d2)))))))))

(defn u16-off [ix [:ref :finding/u16] off :i64] :i64
  (let [pos (record-get [:ref :finding/u16] ix :pos)
        del (record-get [:ref :finding/u16] ix :delta)
        n (vector-count pos)]
    (if (or (= n 0) (< off (vector-at pos 0)))
      off
      ;; the last k with pos[k] <= off
      (loop [lo 0 hi (- n 1)]
        (if (>= lo hi)
          (- off (vector-at del lo))
          (let [mid (quot (+ lo (+ hi 1)) 2)]
            (if (<= (vector-at pos mid) off) (recur mid hi) (recur lo (- mid 1)))))))))
