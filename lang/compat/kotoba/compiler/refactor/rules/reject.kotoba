;; kotoba.compiler.refactor.rules.reject -- the GUEST-ROUTE twin of amu's `src/kotoba/compiler/refactor/rules/reject.cljk`,
;; rule (b): `reject!` call sites -> the :fe/err typed-abort shape, the host text kept as the :default arm.
;;
;; WHY A TWIN. The host rule is a `letfn` of mutually recursive visitors over host CST maps that swap findings into an
;; atom, with the position (:tail :stmt :binding :value) and a context map (:in-loop :in-lambda :in-try). The twin is
;; the same recursion over the cst twin, threading the findings list; POS is the keyword's name.
;;   (find-all src nodes) -> [:list :finding/f]   in the host's order

(ns kotoba.compiler.refactor.rules.reject
  (:require [kotoba.compiler.refactor.cst :as cst]
            [kotoba.compiler.refactor.edit :as edit]
            [kotoba.compiler.refactor.finding :as fd])
  (:export [find-all])
  (:schemas {:rj/ctx [:record :rj/ctx [[:loop :bool] [:lambda :bool] [:try :bool]]]
             :rj/env [:record :rj/env [[:src :string] [:starts [:list :i64]]]]}))

(defn- kid [n [:ref :cst/node] i :i64] [:ref :cst/node]
  (let [ks (cst/node-kids n)] (if (and (>= i 0) (< i (vector-count ks))) (typed-list-nth [:list [:ref :cst/node]] ks i) (cst/nil-node))))
(defn- nkids [n [:ref :cst/node]] :i64 (vector-count (cst/node-kids n)))
(defn- cat [a :string b :string] :string (string-concat a b))
(defn- pieces [xs [:list :string]] :string
  (let [n (vector-count xs)] (loop [i 0 acc ""] (if (>= i n) acc (recur (+ i 1) (cat acc (typed-list-nth [:list :string] xs i)))))))

(defn- e-src [en [:ref :rj/env]] :string (record-get [:ref :rj/env] en :src))
(defn- e-starts [en [:ref :rj/env]] [:list :i64] (record-get [:ref :rj/env] en :starts))
(defn- c-loop [c [:ref :rj/ctx]] :bool (record-get [:ref :rj/ctx] c :loop))
(defn- c-lambda [c [:ref :rj/ctx]] :bool (record-get [:ref :rj/ctx] c :lambda))
(defn- c-try [c [:ref :rj/ctx]] :bool (record-get [:ref :rj/ctx] c :try))
(defn- ctx [l :bool f :bool t :bool] [:ref :rj/ctx] (record-new [:ref :rj/ctx] l f t))

(defn- reject-call? [n [:ref :cst/node]] :bool (cst/call? n "reject!"))
(defn- nil-sym? [n [:ref :cst/node]] :bool (cst/sym-named? n "nil"))

;; the code text, or "" with the human reason in code-human
(defn- code-human [n [:ref :cst/node]] :string
  (let [na (- (nkids n) 1)]
    (cond (> na 3) "reject! with a data map (4-arity)"
          (< na 2) "reject! with fewer than 2 arguments"
          (= na 2) ""
          (cst/kw? (kid n 3)) ""
          (cst/sym-named? (kid n 3) "nil") ""
          :else "non-literal code argument")))

(defn- code-text [n [:ref :cst/node]] :string
  (let [na (- (nkids n) 1)]
    (cond (= na 2) "kotoba.error/subset-reject"
          (cst/kw? (kid n 3)) (let [t (cst/node-text (kid n 3))] (string-substring t 1 (string-byte-length t)))
          :else "kotoba.error/subset-reject")))

(defn- throw-text [src :string r [:ref :cst/node] code :string] :string
  (pieces (typed-list-new [:list :string] "(throw (fe-error " (cst/text src (kid r 1)) " \"" code "\" " (cst/text src (kid r 2)) "))")))

(defn- dual [kotoba :string host :string] :string
  (pieces (typed-list-new [:list :string] "#?(:kotoba " kotoba " :default " host ")")))

(defn- forbid [c [:ref :rj/ctx]] :string
  (cond (c-loop c) "inside a loop/doseq/for/dotimes body (split into answer + throw)"
        (c-lambda c) "inside a lambda"
        (c-try c) "inside try/catch"
        :else ""))

;; conditional-reject: the ok-expr text ("" = not one) and the index of the reject! argument
(defn- neg [x :string] :string (cat "(not " (cat x ")")))

(defn- cond-ok [src :string n [:ref :cst/node]] :string
  (if (not (cst/lst? n))
    ""
    (let [h (cst/head-text n) na (- (nkids n) 1) a1 (kid n 1) a2 (kid n 2) a3 (kid n 3)
          t (if (> na 0) (cst/text src a1) "")]
      (cond
        (and (string=? h "when-not") (= na 2) (reject-call? a2)) t
        (and (string=? h "when") (= na 2) (reject-call? a2)) (neg t)
        (and (string=? h "if") (= na 2) (reject-call? a2)) (neg t)
        (and (string=? h "if-not") (= na 2) (reject-call? a2)) t
        (and (string=? h "if") (= na 3) (nil-sym? a2) (reject-call? a3)) t
        (and (string=? h "if") (= na 3) (nil-sym? a3) (reject-call? a2)) (neg t)
        (and (string=? h "if-not") (= na 3) (nil-sym? a2) (reject-call? a3)) (neg t)
        :else ""))))

(defn- cond-reject [n [:ref :cst/node]] [:ref :cst/node]
  (let [h (cst/head-text n) na (- (nkids n) 1) a2 (kid n 2) a3 (kid n 3)]
    (cond
      (and (or (string=? h "when-not") (string=? h "when") (string=? h "if") (string=? h "if-not")) (= na 2)) a2
      (and (string=? h "if") (= na 3) (nil-sym? a2)) a3
      (and (string=? h "if") (= na 3) (nil-sym? a3)) a2
      :else a3)))

(defn- add [out [:list [:ref :finding/f]] en [:ref :rj/env] region :keyword node [:ref :cst/node] f [:ref :finding/f]] [:list [:ref :finding/f]]
  (fd/fs-conj out f))

(defn- line-of [en [:ref :rj/env] n [:ref :cst/node]] :i64 (edit/offset->line (e-starts en) (cst/node-s n)))

(defn- human [en [:ref :rj/env] region :keyword n [:ref :cst/node] reason :string kind :string kind-kw :bool] [:ref :finding/f]
  (fd/human "reject" (cst/node-s n) (cst/node-e n) region (line-of en n) "" reason kind kind-kw))

(defn- auto [en [:ref :rj/env] region :keyword n [:ref :cst/node] kind :string kind-kw :bool es [:list [:ref :edit/e]]] [:ref :finding/f]
  (fd/auto "reject" (cst/node-s n) (cst/node-e n) region (line-of en n) "" kind kind-kw es))

;; ---------------------------------------------------------------------------
;; visitors (forms = kids of p from index i)

(defn- visit-all [out [:list [:ref :finding/f]] en [:ref :rj/env] p [:ref :cst/node] i :i64 pos :string c [:ref :rj/ctx] region :keyword]
  [:list [:ref :finding/f]]
  (let [m (nkids p)] (loop [k i o out] (if (>= k m) o (recur (+ k 1) (visit o en (kid p k) pos c region))))))

;; a body sequence: kids of p from index i to the end
(defn- visit-body [out [:list [:ref :finding/f]] en [:ref :rj/env] p [:ref :cst/node] i :i64 pos :string c [:ref :rj/ctx] region :keyword]
  [:list [:ref :finding/f]]
  (let [m (nkids p)
        src (e-src en)]
    (loop [k i o out]
      (if (>= k m)
        o
        (let [f (kid p k)]
          (if (< k (- m 1))
            (let [ok (cond-ok src f)]
              (if (> (string-byte-length ok) 0)
                (let [r (cond-reject f)
                      ch (code-human r)
                      fb (forbid c)]
                  (recur (+ k 1)
                         (cond
                           (> (string-byte-length ch) 0) (fd/fs-conj o (human en region f ch "statement" true))
                           (> (string-byte-length fb) 0) (fd/fs-conj o (human en region f fb "statement" true))
                           :else
                           (let [code (code-text r)
                                 kotoba (pieces (typed-list-new [:list :string] "(require-k " ok " " (cst/text src (kid r 1)) " \"" code "\" " (cst/text src (kid r 2)) ")"))
                                 open (pieces (typed-list-new [:list :string] "(let [_ " (dual kotoba (cst/text src f)) "]"))]
                             (fd/fs-conj o (auto en region f "statement" true
                                                 (edit/edits-conj (edit/edits-conj (edit/edits-new) (edit/replace-node f open "reject"))
                                                                  (edit/insert-at (cst/node-e (kid p (- m 1))) ")" "reject" 1))))))))
                (recur (+ k 1) (visit o en f "stmt" c region))))
            (recur (+ k 1) (visit o en f pos c region))))))))

(defn- visit-binding-vec [out [:list [:ref :finding/f]] en [:ref :rj/env] bv [:ref :cst/node] c [:ref :rj/ctx] region :keyword]
  [:list [:ref :finding/f]]
  (let [m (nkids bv)
        src (e-src en)]
    (loop [k 0 o out]
      (if (>= (+ k 1) m)
        o
        (let [p (kid bv k) v (kid bv (+ k 1))
              ok (cond-ok src v)]
          (recur (+ k 2)
                 (if (and (cst/sym-named? p "_") (> (string-byte-length ok) 0))
                   (let [r (cond-reject v)
                         ch (code-human r)
                         fb (forbid c)]
                     (cond
                       (> (string-byte-length ch) 0) (fd/fs-conj o (human en region v ch "binding" true))
                       (> (string-byte-length fb) 0) (fd/fs-conj o (human en region v fb "binding" true))
                       :else
                       (let [code (code-text r)]
                         (fd/fs-conj o (auto en region v "binding" true
                                             (edit/edits-conj (edit/edits-new)
                                                              (edit/replace-node v (dual (pieces (typed-list-new [:list :string] "(require-k " ok " " (cst/text src (kid r 1)) " \"" code "\" " (cst/text src (kid r 2)) ")"))
                                                                                         (cst/text src v))
                                                                                 "reject")))))))
                   (visit o en v (if (reject-call? v) "binding" "value") c region))))))))

(defn- defn-head? [h :string] :bool (or (string=? h "defn") (string=? h "defn-")))
(defn- loop-head? [h :string] :bool
  (or (string=? h "loop") (string=? h "doseq") (string=? h "dotimes") (string=? h "for") (string=? h "while")))

;; arities of a defn/fn: the first vec-or-list among the args (index from 1); body after a vector, or each list arity
(defn- visit-arities [out [:list [:ref :finding/f]] en [:ref :rj/env] n [:ref :cst/node] c [:ref :rj/ctx] region :keyword]
  [:list [:ref :finding/f]]
  (let [m (nkids n)
        st (loop [k 1] (cond (>= k m) m (or (cst/vec? (kid n k)) (cst/lst? (kid n k))) k :else (recur (+ k 1))))]
    (if (cst/vec? (kid n st))
      (visit-body out en n (+ st 1) "tail" c region)
      (loop [k st o out]
        (if (>= k m) o (recur (+ k 1) (if (cst/lst? (kid n k)) (visit-body o en (kid n k) 1 "tail" c region) o)))))))

(defn- dual-written? [src :string n [:ref :cst/node]] :bool
  (let [bs (cst/rc-branches n)
        m (vector-count bs)
        kot (loop [k 0] (cond (>= k m) (cst/nil-node)
                              (string=? ":kotoba" (cst/branch-key (typed-list-nth [:list [:ref :cst/branch]] bs k)))
                              (cst/branch-form (typed-list-nth [:list [:ref :cst/branch]] bs k))
                              :else (recur (+ k 1))))]
    (and (not (cst/nil-node? kot))
         (or (cst/call? kot "require-k") (= (string-index-of (cst/text src kot) "(throw (fe-error") 0)))))

(defn- visit [out [:list [:ref :finding/f]] en [:ref :rj/env] n [:ref :cst/node] pos :string c [:ref :rj/ctx] region :keyword]
  [:list [:ref :finding/f]]
  (let [t (cst/node-type n)
        src (e-src en)]
    (cond
      (reject-call? n)
      (let [ch (code-human n) fb (forbid c)]
        (cond
          (> (string-byte-length ch) 0) (fd/fs-conj out (human en region n ch pos false))
          (> (string-byte-length fb) 0) (fd/fs-conj out (human en region n fb pos false))
          (or (string=? pos "tail") (string=? pos "binding"))
          (fd/fs-conj out (auto en region n pos false
                                (edit/edits-conj (edit/edits-new) (edit/replace-node n (dual (throw-text src n (code-text n)) (cst/text src n)) "reject"))))
          (string=? pos "stmt") (fd/fs-conj out (human en region n "unconditional reject! in statement position" "stmt" false))
          :else (fd/fs-conj out (human en region n "reject! in value position (argument of another form)" "value" false))))
      (= t :rc)
      (if (dual-written? src n)
        out
        (let [m (nkids n)]
          (loop [k 0 o out]
            (if (>= (+ k 1) m) o
                (recur (+ k 2) (visit o en (kid n (+ k 1)) pos c (cst/region-of-feature (cst/node-text (kid n k)))))))))
      (= t :meta) (visit out en (kid n 1) pos c region)
      (and (= t :prefix) (or (string=? (cst/node-prefix n) "'") (string=? (cst/node-prefix n) "`"))) out
      (= t :prefix) (visit-all out en n 0 "value" c region)
      (or (= t :vec) (= t :map) (= t :set)) (visit-all out en n 0 "value" c region)
      (= t :fnlit) (visit-all out en n 0 "value" (ctx (c-loop c) true (c-try c)) region)
      (cst/lst? n)
      (let [h (cst/head-text n)
            a1 (kid n 1)]
        (cond
          (or (= (nkids n) 0) (= (string-byte-length h) 0)) (visit-all out en n 0 "value" c region)
          (defn-head? h) (visit-arities out en n (ctx false false false) region)
          (or (string=? h "fn") (string=? h "fn*")) (visit-arities out en n (ctx (c-loop c) true (c-try c)) region)
          (or (string=? h "let") (string=? h "let*") (string=? h "with-open") (string=? h "binding"))
          (if (cst/vec? a1)
            (visit-body (visit-binding-vec out en a1 c region) en n 2 pos c region)
            out)
          (loop-head? h)
          (let [c2 (ctx true (c-lambda c) (c-try c))
                o1 (if (cst/vec? a1) (visit-all out en a1 0 "value" c2 region) out)]
            (visit-body o1 en n 2 "value" c2 region))
          (string=? h "do") (visit-body out en n 1 pos c region)
          (or (string=? h "when") (string=? h "when-not"))
          (visit-body (visit out en a1 "value" c region) en n 2 pos c region)
          (or (string=? h "when-let") (string=? h "when-some"))
          (visit-body (if (cst/vec? a1) (visit-all out en a1 0 "value" c region) out) en n 2 pos c region)
          (or (string=? h "if") (string=? h "if-not"))
          (visit-all (visit out en a1 "value" c region) en n 2 pos c region)
          (or (string=? h "if-let") (string=? h "if-some"))
          (visit-all (if (cst/vec? a1) (visit-all out en a1 0 "value" c region) out) en n 2 pos c region)
          (string=? h "cond")
          (let [m (nkids n)]
            (loop [k 1 o out]
              (if (>= k m) o
                  (let [o1 (visit o en (kid n k) "value" c region)]
                    (recur (+ k 2) (if (< (+ k 1) m) (visit o1 en (kid n (+ k 1)) pos c region) o1))))))
          (string=? h "case")
          (let [m (nkids n)
                o1 (visit out en a1 "value" c region)
                ncl (- m 2)
                ;; clauses are kids 2..: pairs [t e] (e visited when present), then the odd default once more
                o2 (loop [k 0 o o1]
                     (if (>= k ncl) o
                         (recur (+ k 2) (if (< (+ k 1) ncl) (visit o en (kid n (+ 2 (+ k 1))) pos c region) o))))]
            (if (= (bit-and ncl 1) 1) (visit o2 en (kid n (+ 2 (- ncl 1))) pos c region) o2))
          (string=? h "try")
          (let [m (nkids n)
                bend (loop [k 1] (cond (>= k m) m
                                       (or (cst/call? (kid n k) "catch") (cst/call? (kid n k) "finally")) k
                                       :else (recur (+ k 1))))
                c2 (ctx (c-loop c) (c-lambda c) true)
                o1 (visit-body-range out en n 1 bend pos c2 region)]
            (loop [k bend o o1] (if (>= k m) o (recur (+ k 1) (visit-all o en (kid n k) 1 "value" c2 region)))))
          (or (string=? h "quote") (string=? h "comment") (string=? h "declare") (string=? h "ns")) out
          (or (string=? h "def") (string=? h "defonce") (string=? h "def-")) (visit-all out en n 2 "value" c region)
          :else (visit-all out en n 0 "value" c region)))
      :else out)))

;; visit-body over kids [i, end) of p (a try body)
(defn- visit-body-range [out [:list [:ref :finding/f]] en [:ref :rj/env] p [:ref :cst/node] i :i64 end :i64 pos :string c [:ref :rj/ctx] region :keyword]
  [:list [:ref :finding/f]]
  (let [kids (loop [k i acc (typed-list-new [:list [:ref :cst/node]])]
               (if (>= k end) acc (recur (+ k 1) (typed-list-conj [:list [:ref :cst/node]] acc (kid p k)))))]
    ;; a synthetic list node holding exactly the body forms, so visit-body's "last form" is the body's last
    (visit-body out en (record-new [:ref :cst/node] :list (cst/node-s p) (cst/node-e p) kids "" "" false) 0 pos c region)))

(defn find-all [src :string nodes [:list [:ref :cst/node]]] [:list [:ref :finding/f]]
  (let [en (record-new [:ref :rj/env] src (edit/line-starts src))
        m (vector-count nodes)]
    (loop [k 0 o (fd/fs-new)]
      (if (>= k m)
        o
        (recur (+ k 1) (visit o en (typed-list-nth [:list [:ref :cst/node]] nodes k) "tail" (ctx false false false) :shared))))))
