;; kotoba.compiler.refactor.rules.lowerloops -- the GUEST-ROUTE twin of amu's
;; `src/kotoba/compiler/refactor/rules/lowerloops.cljk`, rule (f): mapv/map/filter/filterv/reduce with a one-lambda
;; callback -> a loop over kotoba.form as the :kotoba arm, the host call kept byte for byte as the :default arm.
;;   (find-all src nodes) -> [:list :finding/f]   in the host's order

(ns kotoba.compiler.refactor.rules.lowerloops
  (:require [kotoba.compiler.refactor.cst :as cst]
            [kotoba.compiler.refactor.edit :as edit]
            [kotoba.compiler.refactor.finding :as fd])
  (:export [find-all]))

(defn- kid [n [:ref :cst/node] i :i64] [:ref :cst/node]
  (let [ks (cst/node-kids n)] (if (< i (vector-count ks)) (typed-list-nth [:list [:ref :cst/node]] ks i) (cst/nil-node))))
(defn- nkids [n [:ref :cst/node]] :i64 (vector-count (cst/node-kids n)))
(defn- nodes-nth [xs [:list [:ref :cst/node]] i :i64] [:ref :cst/node] (typed-list-nth [:list [:ref :cst/node]] xs i))
(defn- cat [a :string b :string] :string (string-concat a b))

;; (fn [a b ...] body...) with plain symbol params (not &) and a non-empty body: the param count, else -1
(defn- simple-arity [n [:ref :cst/node]] :i64
  (if (and (cst/lst? n) (string=? "fn" (cst/head-text n)) (cst/vec? (kid n 1)) (> (nkids n) 2))
    (let [pv (kid n 1) m (nkids pv)]
      (if (loop [k 0] (cond (>= k m) true
                            (and (cst/sym? (kid pv k)) (not (string=? "&" (cst/node-text (kid pv k))))) (recur (+ k 1))
                            :else false))
        m
        -1))
    -1))

(defn- body-text [src :string f [:ref :cst/node]] :string
  (let [m (nkids f)]
    (loop [k 2 acc ""] (if (>= k m) acc (recur (+ k 1) (if (= k 2) (cst/text src (kid f k)) (cat acc (cat " " (cst/text src (kid f k))))))))))

(defn- lc [pfx :string id :i64] :string (cat "fe-l" (cat pfx (cat "__" (string-from-i64 id)))))

(defn- pieces [xs [:list :string]] :string
  (let [n (vector-count xs)] (loop [i 0 acc ""] (if (>= i n) acc (recur (+ i 1) (cat acc (typed-list-nth [:list :string] xs i)))))))

(defn- lower [src :string ix [:ref :finding/u16] h :string f [:ref :cst/node] coll [:ref :cst/node] init :string] :string
  (let [id (fd/u16-off ix (cst/node-s f))
        c (lc "c" id) cn (lc "n" id) i (lc "i" id) a (lc "a" id)
        ctext (cst/text src coll)
        item (pieces (typed-list-new [:list :string] "(typed-list-nth [:list [:ref :form/r]] " c " " i ")"))
        pv (kid f 1)
        p0 (cst/node-text (kid pv 0))
        p1 (cst/node-text (kid pv 1))
        bt (body-text src f)
        head (pieces (typed-list-new [:list :string] "(let [" c " (form/kids-of " ctext ") " cn " (vector-count " c ")]"))]
    (cond
      (or (string=? h "mapv") (string=? h "map"))
      (pieces (typed-list-new [:list :string] head " (" (if (string=? h "mapv") "form/form-vec" "form/form-seq")
                              " (loop [" i " 0 " a " (form/no-forms)] (if (>= " i " " cn ") " a
                              " (recur (+ " i " 1) (form/append-form " a " (let [" p0 " " item "] " bt "))))))) "))
      (or (string=? h "filter") (string=? h "filterv"))
      (pieces (typed-list-new [:list :string] head " (" (if (string=? h "filterv") "form/form-vec" "form/form-seq")
                              " (loop [" i " 0 " a " (form/no-forms)] (if (>= " i " " cn ") " a
                              " (let [" p0 " " item "] (recur (+ " i " 1) (if (do " bt ") (form/append-form " a " " p0 ") " a "))))))) "))
      :else
      (pieces (typed-list-new [:list :string] head " (loop [" i " 0 " p0 " " init "] (if (>= " i " " cn ") " p0
                              " (recur (+ " i " 1) (let [" p1 " " item "] " bt "))))) ")))))

;; str/trim: JS white space at both ends
(defn- ws? [p :i64] :bool
  (or (= p 32) (= p 9) (= p 10) (= p 11) (= p 12) (= p 13) (= p 160) (= p 8232) (= p 8233) (= p 65279)
      (= p 5760) (= p 8239) (= p 8287) (= p 12288) (and (>= p 8192) (<= p 8202))))
(defn- cpw [p :i64] :i64 (if (< p 128) 1 (if (< p 2048) 2 (if (< p 65536) 3 4))))
(defn- trim [s :string] :string
  (let [n (string-byte-length s)
        a (loop [i 0] (if (and (< i n) (ws? (string-code-point-at s i))) (recur (+ i (cpw (string-code-point-at s i)))) i))
        b (loop [i a last a] (if (>= i n) last (let [p (string-code-point-at s i)] (recur (+ i (cpw p)) (if (ws? p) last (+ i (cpw p)))))))]
    (string-substring s a b)))

;; an ancestor is an :rc whose text holds "(let [fe-lc" (already lowered)
(defn- lowered-above? [src :string vs [:list [:ref :cst/visit]] v [:ref :cst/visit]] :bool
  (loop [p (cst/visit-parent v)]
    (if (< p 0)
      false
      (let [pv (typed-list-nth [:list [:ref :cst/visit]] vs p)
            pn (cst/visit-node pv)]
        (if (and (= :rc (cst/node-type pn)) (>= (string-index-of (cst/text src pn) "(let [fe-lc") 0))
          true
          (recur (cst/visit-parent pv)))))))

(defn- one-edit [x [:ref :edit/e]] [:list [:ref :edit/e]] (edit/edits-conj (edit/edits-new) x))

(defn find-all [src :string nodes [:list [:ref :cst/node]]] [:list [:ref :finding/f]]
  (let [vs (cst/walk-visits nodes)
        nv (vector-count vs)
        starts (edit/line-starts src)
        ix (fd/u16-index src)]
    (loop [i 0 out (fd/fs-new)]
      (if (>= i nv)
        out
        (let [v (typed-list-nth [:list [:ref :cst/visit]] vs i)
              n (cst/visit-node v)]
          (if (or (not (cst/lst? n)) (lowered-above? src vs v))
            (recur (+ i 1) out)
            (let [h (cst/head-text n)
                  as (cst/args n)
                  na (vector-count as)
                  region (cst/visit-region v)
                  s (cst/node-s n) e (cst/node-e n)
                  line (edit/offset->line starts s)
                  a0 (if (> na 0) (nodes-nth as 0) (cst/nil-node))
                  fnarg (and (cst/lst? a0) (string=? "fn" (cst/head-text a0)))
                  ar (simple-arity a0)
                  f (cond
                      (and (or (string=? h "mapv") (string=? h "map") (string=? h "filterv") (string=? h "filter")) (= na 2) fnarg)
                      (cond (< ar 0) (fd/human "lowerloops" s e region line h "callback parameters are not plain symbols (run rule a first) or the body is empty" "" false)
                            (= ar 1) (fd/auto "lowerloops" s e region line h "" false
                                              (one-edit (edit/replace-node n (cat "#?(:kotoba " (cat (trim (lower src ix h a0 (nodes-nth as 1) "")) (cat " :default " (cat (cst/text src n) ")")))) "lowerloops")))
                            :else (fd/human "lowerloops" s e region line h "callback does not take exactly one simple parameter" "" false))
                      (and (string=? h "reduce") (= na 3) fnarg)
                      (cond (< ar 0) (fd/human "lowerloops" s e region line h "callback parameters are not plain symbols (run rule a first) or the body is empty" "" false)
                            (= ar 2) (fd/auto "lowerloops" s e region line h "" false
                                              (one-edit (edit/replace-node n (cat "#?(:kotoba " (cat (trim (lower src ix h a0 (nodes-nth as 2) (cst/text src (nodes-nth as 1)))) (cat " :default " (cat (cst/text src n) ")")))) "lowerloops")))
                            :else (fd/human "lowerloops" s e region line h "reduce callback does not take exactly two simple parameters" "" false))
                      :else (fd/mk "" 0 0 :shared "none" -1 "" "" "" false (edit/edits-new) (fd/rows-new)))]
              (recur (+ i 1) (if (string=? (fd/f-status f) "none") out (fd/fs-conj out f))))))))))
