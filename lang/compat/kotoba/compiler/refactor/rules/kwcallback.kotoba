;; kotoba.compiler.refactor.rules.kwcallback -- the GUEST-ROUTE twin of amu's
;; `src/kotoba/compiler/refactor/rules/kwcallback.cljk`, rule (d): a keyword used as the callback of a higher-order core
;; function becomes a lambda ((map :k xs) -> (map (fn [e] (:k e)) xs); (juxt :a :b) -> (fn [e] [(:a e) (:b e)])).
;;
;; WHY A TWIN. The host rule is a `cst/walk` callback that swaps findings (maps) into an atom; the twin is the same
;; decision over the cst twin's walk-visits, answering typed findings (kotoba.compiler.refactor.finding).
;;   (find-all src nodes accessor?) -> [:list :finding/f]   in the host's order; accessor? = opts :lower-accessor

(ns kotoba.compiler.refactor.rules.kwcallback
  (:require [kotoba.compiler.refactor.cst :as cst]
            [kotoba.compiler.refactor.edit :as edit]
            [kotoba.compiler.refactor.finding :as fd])
  (:export [find-all]))

(defn- nodes-nth [xs [:list [:ref :cst/node]] i :i64] [:ref :cst/node] (typed-list-nth [:list [:ref :cst/node]] xs i))

;; head -> index of the callback among the arguments, -1 when not a callback head
(defn- callback-index [h :string] :i64
  (cond (or (string=? h "map") (string=? h "mapv") (string=? h "filter") (string=? h "filterv") (string=? h "remove")
            (string=? h "keep") (string=? h "mapcat") (string=? h "some") (string=? h "every?") (string=? h "not-any?")
            (string=? h "not-every?") (string=? h "sort-by") (string=? h "group-by") (string=? h "take-while")
            (string=? h "drop-while") (string=? h "partition-by") (string=? h "split-with") (string=? h "max-key")
            (string=? h "min-key") (string=? h "run!") (string=? h "keep-indexed"))
        0
        (or (string=? h "update-vals") (string=? h "update-keys")) 1
        :else -1))

(defn- call-text [k :string accessor :bool] :string
  (if accessor (string-concat "(fe-get e " (string-concat k ")")) (string-concat "(" (string-concat k " e)"))))

(defn- lambda-text [ks [:list [:ref :cst/node]] from :i64 to :i64 accessor :bool] :string
  (if (= (- to from) 1)
    (string-concat "(fn [e] " (string-concat (call-text (cst/node-text (nodes-nth ks from)) accessor) ")"))
    (string-concat "(fn [e] ["
                   (string-concat (loop [i from acc ""]
                                    (if (>= i to) acc
                                        (recur (+ i 1) (string-concat acc (string-concat (if (= i from) "" " ")
                                                                                          (call-text (cst/node-text (nodes-nth ks i)) accessor))))))
                                  "])"))))

(defn- all-kw? [as [:list [:ref :cst/node]]] :bool
  (let [n (vector-count as)] (loop [i 0] (cond (>= i n) true (cst/kw? (nodes-nth as i)) (recur (+ i 1)) :else false))))
(defn- some-kw? [as [:list [:ref :cst/node]]] :bool
  (let [n (vector-count as)] (loop [i 0] (cond (>= i n) false (cst/kw? (nodes-nth as i)) true :else (recur (+ i 1))))))

(defn- last-path [vs [:list [:ref :cst/visit]] v [:ref :cst/visit]] [:ref :cst/node]
  (cond (not (cst/nil-node? (cst/visit-key v))) (cst/visit-key v)
        (< (cst/visit-parent v) 0) (cst/nil-node)
        :else (cst/visit-node (typed-list-nth [:list [:ref :cst/visit]] vs (cst/visit-parent v)))))

(defn- threading? [h :string] :bool
  (or (string=? h "->") (string=? h "->>") (string=? h "some->") (string=? h "cond->") (string=? h "as->")))

(defn- one-edit [x [:ref :edit/e]] [:list [:ref :edit/e]] (edit/edits-conj (edit/edits-new) x))

(defn find-all [src :string nodes [:list [:ref :cst/node]] accessor :bool] [:list [:ref :finding/f]]
  (let [vs (cst/walk-visits nodes)
        nv (vector-count vs)
        starts (edit/line-starts src)]
    (loop [i 0 out (fd/fs-new)]
      (if (>= i nv)
        out
        (let [v (typed-list-nth [:list [:ref :cst/visit]] vs i)
              n (cst/visit-node v)]
          (if (not (cst/lst? n))
            (recur (+ i 1) out)
            (let [h (cst/head-text n)
                  as (cst/args n)
                  na (vector-count as)
                  region (cst/visit-region v)
                  s (cst/node-s n) e (cst/node-e n)
                  line (edit/offset->line starts s)
                  ci (if (> (string-byte-length h) 0) (callback-index h) -1)
                  f (cond
                      (and (>= ci 0) (< ci na) (cst/kw? (nodes-nth as ci)))
                      (let [k (nodes-nth as ci)
                            colls (- (- na ci) 1)]
                        (if (and (or (string=? h "map") (string=? h "mapv") (string=? h "mapcat") (string=? h "keep")) (> colls 1))
                          (fd/human "kwcallback" s e region line h "multi-collection map with a keyword callback ((:k a b) is get-with-default)" "" false)
                          (fd/auto "kwcallback" s e region line h "" false
                                   (one-edit (edit/replace-node k (lambda-text as ci (+ ci 1) accessor) "kwcallback")))))
                      (and (string=? h "juxt") (> na 0) (all-kw? as)
                           (let [p (last-path vs v)] (and (cst/lst? p) (threading? (cst/head-text p)))))
                      (fd/human "kwcallback" s e region line h "juxt as a threading step: the threaded value is its argument, not a callback" "" false)
                      (and (string=? h "juxt") (> na 0) (all-kw? as))
                      (fd/auto "kwcallback" s e region line h "" false
                               (one-edit (edit/replace-node n (lambda-text as 0 na accessor) "kwcallback")))
                      (and (or (string=? h "comp") (string=? h "partial") (string=? h "some-fn") (string=? h "every-pred")) (some-kw? as))
                      (fd/human "kwcallback" s e region line h
                                (string-concat "keyword inside (" (string-concat h " ...): a composed callback needs a hand-written lambda")) "" false)
                      (and (string=? h "apply") (>= na 2)
                           (or (string=? (cst/node-text (nodes-nth as 0)) "max-key") (string=? (cst/node-text (nodes-nth as 0)) "min-key"))
                           (cst/kw? (nodes-nth as 1)))
                      (fd/auto "kwcallback" s e region line h "" false
                               (one-edit (edit/replace-node (nodes-nth as 1) (lambda-text as 1 2 accessor) "kwcallback")))
                      :else (fd/mk "" 0 0 :shared "none" -1 "" "" "" false (edit/edits-new) (fd/rows-new)))]
              (recur (+ i 1) (if (string=? (fd/f-status f) "none") out (fd/fs-conj out f))))))))))
