;; kotoba.compiler.refactor.diff -- the GUEST-ROUTE twin of amu's `src/kotoba/compiler/refactor/diff.cljk`
;; (unified diff of two texts, patience anchors + LCS for small gaps; `amu refactor plan`).
;;
;; WHY A TWIN. The host module is dynamic Clojure: regions are 4-vectors, `frequencies` / `into {}` / `for :when`
;; build the anchor map, `lis` threads three persistent vectors and a nil-able `prev`, `split-lines` and `unified` use
;; regex literals (seed: E1005 `#`; stage-0: `str/split` is not an admitted import). The guest route gets a module of
;; the SAME NAME with a typed contract, as kotoba.compiler.refactor.cst does. Host behaviour is untouched.
;;
;; THE ALGORITHM IS THE HOST'S, step for step, so the answers are identical (scripts/refactor-twin-diff/run.sh diff):
;; trim the common head and tail; the anchors are the lines that occur exactly once on each side, the longest strictly
;; increasing run of those pairs splits the problem; a gap without anchors is an LCS table when
;; (* gap-a gap-b) <= 250000, else one replaced block. The anchor map is a sort by (line, index) instead of a hash map.
;;
;; THE CONTRACT
;;   :diff/r  = [as :i64] [ae :i64] [bs :i64] [be :i64]       a changed region (0-based, half open) of two line lists
;;   :diff/cl = [removed :i64] [added :i64]
;;   (split-lines text)          -> [:list :string]   lines without terminators; a final newline makes no empty last line
;;   (regions a b)               -> [:list :diff/r]   a, b: [:list :string]
;;   (unified path old new ctx)  -> :string           "" when the texts are equal; ctx is the host's 3 by default
;;   (changed-lines old new)     -> :diff/cl
;;   accessors r-as r-ae r-bs r-be, regions-count / regions-nth, cl-removed / cl-added.
;; Strings are compared byte for byte (the host compares UTF-16 strings; equal on equal text).

(ns kotoba.compiler.refactor.diff
  (:require [kotoba.string.split :as sp])
  (:export [split-lines regions unified changed-lines
            r-as r-ae r-bs r-be regions-count regions-nth cl-removed cl-added])
  (:schemas {:diff/r [:record :diff/r [[:as :i64] [:ae :i64] [:bs :i64] [:be :i64]]]
             :diff/cl [:record :diff/cl [[:removed :i64] [:added :i64]]]}))

;; ---------------------------------------------------------------------------
;; records and lists

(defn r-as [r [:ref :diff/r]] :i64 (record-get [:ref :diff/r] r :as))
(defn r-ae [r [:ref :diff/r]] :i64 (record-get [:ref :diff/r] r :ae))
(defn r-bs [r [:ref :diff/r]] :i64 (record-get [:ref :diff/r] r :bs))
(defn r-be [r [:ref :diff/r]] :i64 (record-get [:ref :diff/r] r :be))
(defn cl-removed [c [:ref :diff/cl]] :i64 (record-get [:ref :diff/cl] c :removed))
(defn cl-added [c [:ref :diff/cl]] :i64 (record-get [:ref :diff/cl] c :added))

(defn- region [as :i64 ae :i64 bs :i64 be :i64] [:ref :diff/r] (record-new [:ref :diff/r] as ae bs be))
(defn- no-regions [] [:list [:ref :diff/r]] (typed-list-new [:list [:ref :diff/r]]))
(defn- add-region [xs [:list [:ref :diff/r]] r [:ref :diff/r]] [:list [:ref :diff/r]]
  (typed-list-conj [:list [:ref :diff/r]] xs r))
(defn regions-count [xs [:list [:ref :diff/r]]] :i64 (vector-count xs))
(defn regions-nth [xs [:list [:ref :diff/r]] i :i64] [:ref :diff/r]
  (typed-list-nth [:list [:ref :diff/r]] xs i))

(defn- no-ints [] [:list :i64] (typed-list-new [:list :i64]))
(defn- add-int [xs [:list :i64] x :i64] [:list :i64] (typed-list-conj [:list :i64] xs x))
(defn- int-at [xs [:list :i64] i :i64] :i64 (typed-list-nth [:list :i64] xs i))
(defn- no-strings [] [:list :string] (typed-list-new [:list :string]))
(defn- add-string [xs [:list :string] x :string] [:list :string] (typed-list-conj [:list :string] xs x))
(defn- str-at [xs [:list :string] i :i64] :string (typed-list-nth [:list :string] xs i))

;; join by halves: every byte is copied O(log n) times, not O(n) (immutable strings, no GC).
(defn- join-range [xs [:list :string] sep :string lo :i64 hi :i64] :string
  (if (<= (- hi lo) 1)
    (if (= hi lo) "" (str-at xs lo))
    (let [mid (quot (+ lo hi) 2)]
      (string-concat (join-range xs sep lo mid) (string-concat sep (join-range xs sep mid hi))))))

(defn- join [xs [:list :string] sep :string] :string (join-range xs sep 0 (vector-count xs)))

;; ---------------------------------------------------------------------------
;; lines

(defn split-lines [text :string] [:list :string]
  (if (string=? text "")
    (no-strings)
    (let [parts (sp/split text "\n" -1)
          n (vector-count parts)]
      (if (string=? (str-at parts (- n 1)) "")
        (loop [k 0 acc (no-strings)]
          (if (>= k (- n 1)) acc (recur (+ k 1) (add-string acc (str-at parts k)))))
        parts))))

;; ---------------------------------------------------------------------------
;; longest strictly increasing subsequence of the j values of the [i j] pairs (sorted by i). TAILS and TIDX are updated by
;; the copying `vector-assoc` (a binary search in a loop may not read a linear handle, stage-0: "used more than once"), so a
;; step costs O(len); PREV too (it is passed to walk-back, which stage-0 refuses for a linear handle).

(defn- reverse-ints [xs [:list :i64]] [:list :i64]
  (loop [k (- (vector-count xs) 1) acc (no-ints)]
    (if (< k 0) acc (recur (- k 1) (add-int acc (int-at xs k))))))

(defn- walk-back [prev :vector-i64 t :i64 acc [:list :i64]] [:list :i64]
  (if (< t 0) acc (walk-back prev (vector-at prev t) (add-int acc t))))

(defn- lis [js [:list :i64]] [:list :i64]
  (let [n (vector-count js)]
    (if (= n 0)
      (no-ints)
      (loop [k 0 len 0 tails (vector-alloc n) tidx (vector-alloc n) prev (vector-alloc n)]
        (if (= k n)
          ;; the indices k of the LIS, walked back from the last tail through prev, then put in increasing order
          (reverse-ints (walk-back prev (vector-at tidx (- len 1)) (no-ints)))
          (let [j (int-at js k) ;; leftmost tail >= j among tails[0..len), a binary search
                pos (loop [lo 0 hi len]
                      (if (< lo hi)
                        (let [mid (quot (+ lo hi) 2)]
                          (if (< (vector-at tails mid) j) (recur (+ mid 1) hi) (recur lo mid)))
                        lo))
                pv (if (> pos 0) (vector-at tidx (- pos 1)) -1)
                prev2 (vector-assoc prev k pv)
                tails2 (vector-assoc tails pos j)
                tidx2 (vector-assoc tidx pos k)]
            (recur (+ k 1) (if (= pos len) (+ len 1) len) tails2 tidx2 prev2)))))))

;; ---------------------------------------------------------------------------
;; LCS table for a small gap

;; row-major (n+1) x (m+1); cell (i, j) at i*(m+1)+j
(defn- fill-row [a [:list :string] b [:list :string] as :i64 bs :i64 n :i64 m :i64 i :i64 j :i64
                 t :vector-i64] :vector-i64
  (if (< j 0)
    t
    (let [w (+ m 1)
          right (vector-at t (+ (* i w) (+ j 1)))
          down (vector-at t (+ (* (+ i 1) w) j))
          diag (vector-at t (+ (* (+ i 1) w) (+ j 1)))
          v (if (string=? (str-at a (+ as i)) (str-at b (+ bs j)))
              (+ diag 1)
              (if (> down right) down right))]
      (fill-row a b as bs n m i (- j 1) (vector-assoc! t (+ (* i w) j) v)))))

(defn- fill-table [a [:list :string] b [:list :string] as :i64 bs :i64 n :i64 m :i64 i :i64
                   t :vector-i64] :vector-i64
  (if (< i 0)
    t
    (fill-table a b as bs n m (- i 1) (fill-row a b as bs n m i (- m 1) t))))

(defn- cell [t :vector-i64 m :i64 i :i64 j :i64] :i64 (vector-at t (+ (* i (+ m 1)) j)))

;; Changed regions between a[as,ae) and b[bs,be) by an LCS table (small inputs only), appended to out.
;; oas = -1: no open region.
(defn- lcs-regions [a [:list :string] b [:list :string] as :i64 ae :i64 bs :i64 be :i64
                    out [:list [:ref :diff/r]]] [:list [:ref :diff/r]]
  (let [n (- ae as) m (- be bs)
        t (fill-table a b as bs n m (- n 1) (vector-alloc (* (+ n 1) (+ m 1))))]
    (loop [i 0 j 0 oas -1 obs -1 out out]
      (let [closed (if (< oas 0) out (add-region out (region oas (+ as i) obs (+ bs j))))]
        (cond
          (and (= i n) (= j m)) closed
          (and (< i n) (and (< j m) (string=? (str-at a (+ as i)) (str-at b (+ bs j)))))
          (recur (+ i 1) (+ j 1) -1 -1 closed)
          (and (< j m) (or (= i n) (>= (cell t m i (+ j 1)) (cell t m (+ i 1) j))))
          (recur i (+ j 1) (if (< oas 0) (+ as i) oas) (if (< oas 0) (+ bs j) obs) out)
          :else
          (recur (+ i 1) j (if (< oas 0) (+ as i) oas) (if (< oas 0) (+ bs j) obs) out))))))

;; ---------------------------------------------------------------------------
;; anchors: lines that occur exactly once in a[as,ae) and exactly once in b[bs,be)

(defn- idx-before? [lines [:list :string] x :i64 y :i64] :bool
  (let [c (string-compare (str-at lines x) (str-at lines y))]
    (if (< c 0) true (if (> c 0) false (<= x y)))))

(defn- merge-idx [lines [:list :string] xs [:list :i64] i :i64 ys [:list :i64] j :i64
                  acc [:list :i64]] [:list :i64]
  (let [xn (vector-count xs) yn (vector-count ys)]
    (if (>= i xn)
      (if (>= j yn) acc (merge-idx lines xs i ys (+ j 1) (add-int acc (int-at ys j))))
      (if (>= j yn)
        (merge-idx lines xs (+ i 1) ys j (add-int acc (int-at xs i)))
        (if (idx-before? lines (int-at xs i) (int-at ys j))
          (merge-idx lines xs (+ i 1) ys j (add-int acc (int-at xs i)))
          (merge-idx lines xs i ys (+ j 1) (add-int acc (int-at ys j))))))))

;; indices lo..hi-1 sorted by (line, index)
(defn- sort-idx [lines [:list :string] lo :i64 hi :i64] [:list :i64]
  (if (<= (- hi lo) 1)
    (if (= hi lo) (no-ints) (add-int (no-ints) lo))
    (let [mid (quot (+ lo hi) 2)]
      (merge-idx lines (sort-idx lines lo mid) 0 (sort-idx lines mid hi) 0 (no-ints)))))

;; first position p in sorted (indices into lines) whose line >= s
(defn- first-geq [lines [:list :string] sorted [:list :i64] s :string] :i64
  (loop [lo 0 hi (vector-count sorted)]
    (if (< lo hi)
      (let [mid (quot (+ lo hi) 2)]
        (if (< (string-compare (str-at lines (int-at sorted mid)) s) 0) (recur (+ mid 1) hi) (recur lo mid)))
      lo)))

;; the run of equal lines starting at p: its length
(defn- run-length [lines [:list :string] sorted [:list :i64] p :i64] :i64
  (let [n (vector-count sorted) s (str-at lines (int-at sorted p))]
    (loop [q (+ p 1)]
      (if (and (< q n) (string=? (str-at lines (int-at sorted q)) s)) (recur (+ q 1)) (- q p)))))

;; the b-index of the line a[i] when it is unique on both sides, else -1
(defn- partner [a [:list :string] b [:list :string] sa [:list :i64] pa :i64 sb [:list :i64]] :i64
  (if (not= (run-length a sa pa) 1)
    -1
    (let [s (str-at a (int-at sa pa))
          q (first-geq b sb s)]
      (if (and (< q (vector-count sb)) (string=? (str-at b (int-at sb q)) s) (= (run-length b sb q) 1))
        (int-at sb q)
        -1))))

;; jmap[i - as] = the partner of a[i] PLUS ONE (0: none; a fresh vector is all zeros)
(defn- fill-partners [a [:list :string] b [:list :string] as :i64 sa [:list :i64] sb [:list :i64]
                      p :i64 jmap :vector-i64] :vector-i64
  (if (>= p (vector-count sa))
    jmap
    (let [i (int-at sa p)
          j (partner a b sa p sb)]
      (fill-partners a b as sa sb (+ p 1) (vector-assoc! jmap (- i as) (+ j 1))))))

;; ---------------------------------------------------------------------------
;; diff-range

(defn- head-len [a [:list :string] b [:list :string] as :i64 ae :i64 bs :i64 be :i64 k :i64] :i64
  (if (and (< (+ as k) ae) (and (< (+ bs k) be) (string=? (str-at a (+ as k)) (str-at b (+ bs k)))))
    (head-len a b as ae bs be (+ k 1))
    k))

(defn- tail-len [a [:list :string] b [:list :string] as :i64 ae :i64 bs :i64 be :i64 k :i64] :i64
  (if (and (< as (- ae k)) (and (< bs (- be k)) (string=? (str-at a (- (- ae k) 1)) (str-at b (- (- be k) 1)))))
    (tail-len a b as ae bs be (+ k 1))
    k))

;; walk the anchors (increasing pair indices ks), diffing the gaps between them
(defn- diff-gaps [a [:list :string] b [:list :string] ae :i64 be :i64 pi [:list :i64] pj [:list :i64]
                  ks [:list :i64] q :i64 pa :i64 pb :i64 out [:list [:ref :diff/r]]] [:list [:ref :diff/r]]
  (if (>= q (vector-count ks))
    (diff-into a b pa ae pb be out)
    (let [k (int-at ks q) i (int-at pi k) j (int-at pj k)]
      (diff-gaps a b ae be pi pj ks (+ q 1) (+ i 1) (+ j 1) (diff-into a b pa i pb j out)))))

;; the i (which = 0) or the j (which = 1) of every anchor candidate, in increasing i
(defn- pair-list [as :i64 ae :i64 jmap :vector-i64 i :i64 which :i64 acc [:list :i64]] [:list :i64]
  (if (>= i ae)
    acc
    (let [j (- (vector-at jmap (- i as)) 1)]
      (if (< j 0)
        (pair-list as ae jmap (+ i 1) which acc)
        (pair-list as ae jmap (+ i 1) which (add-int acc (if (= which 0) i j)))))))

(defn- diff-into [a [:list :string] b [:list :string] as0 :i64 ae0 :i64 bs0 :i64 be0 :i64
                  out [:list [:ref :diff/r]]] [:list [:ref :diff/r]]
  (let [head (head-len a b as0 ae0 bs0 be0 0)
        as (+ as0 head) bs (+ bs0 head)
        tail (tail-len a b as ae0 bs be0 0)
        ae (- ae0 tail) be (- be0 tail)]
    (cond
      (and (= as ae) (= bs be)) out
      (or (= as ae) (= bs be)) (add-region out (region as ae bs be))
      :else
      (let [sa (sort-idx a as ae)
            sb (sort-idx b bs be)
            jmap (fill-partners a b as sa sb 0 (vector-alloc (- ae as)))
            pi (pair-list as ae jmap as 0 (no-ints))
            pj (pair-list as ae jmap as 1 (no-ints))
            ks (lis pj)]
        (if (> (vector-count ks) 0)
          (diff-gaps a b ae be pi pj ks 0 as bs out)
          (if (<= (* (- ae as) (- be bs)) 250000)
            (lcs-regions a b as ae bs be out)
            (add-region out (region as ae bs be))))))))

(defn regions [a [:list :string] b [:list :string]] [:list [:ref :diff/r]]
  (diff-into a b 0 (vector-count a) 0 (vector-count b) (no-regions)))

;; ---------------------------------------------------------------------------
;; unified

(defn- range-text [start :i64 len :i64] :string
  (cond (= len 0) (string-concat (string-from-i64 (if (> start 0) start 0)) ",0")
        (= len 1) (string-from-i64 (+ start 1))
        :else (string-concat (string-from-i64 (+ start 1)) (string-concat "," (string-from-i64 len)))))

(defn- imax [x :i64 y :i64] :i64 (if (> x y) x y))
(defn- imin [x :i64 y :i64] :i64 (if (< x y) x y))

;; the first region index of the group after the one starting at g0: regions g0..(end-1) form a group
(defn- group-end [rs [:list [:ref :diff/r]] g :i64 ctx :i64] :i64
  (let [n (vector-count rs)]
    (if (>= (+ g 1) n)
      n
      (if (<= (- (r-as (regions-nth rs (+ g 1))) (r-ae (regions-nth rs g))) (* 2 ctx))
        (group-end rs (+ g 1) ctx)
        (+ g 1)))))

(defn- lines-with [prefix :string xs [:list :string] from :i64 to :i64 acc [:list :string]] [:list :string]
  (if (>= from to)
    acc
    (lines-with prefix xs (+ from 1) to (add-string acc (string-concat prefix (str-at xs from))))))

(defn- hunk-body [a [:list :string] b [:list :string] rs [:list [:ref :diff/r]] g :i64 gend :i64
                  pa :i64 end-a :i64 acc [:list :string]] [:list :string]
  (if (>= g gend)
    (lines-with " " a pa end-a acc)
    (let [r (regions-nth rs g)]
      (hunk-body a b rs (+ g 1) gend (r-ae r) end-a
                 (lines-with "+" b (r-bs r) (r-be r)
                             (lines-with "-" a (r-as r) (r-ae r)
                                         (lines-with " " a pa (r-as r) acc)))))))

(defn- hunk [a [:list :string] b [:list :string] rs [:list [:ref :diff/r]] g :i64 gend :i64 ctx :i64] :string
  (let [first-r (regions-nth rs g)
        last-r (regions-nth rs (- gend 1))
        start-a (imax 0 (- (r-as first-r) ctx))
        start-b (imax 0 (- (r-bs first-r) ctx))
        end-a (imin (vector-count a) (+ (r-ae last-r) ctx))
        end-b (imin (vector-count b) (+ (r-be last-r) ctx))
        body (hunk-body a b rs g gend start-a end-a (no-strings))]
    (string-concat
     (string-concat "@@ -" (string-concat (range-text start-a (- end-a start-a))
                                          (string-concat " +" (string-concat (range-text start-b (- end-b start-b)) " @@\n"))))
     (string-concat (join body "\n") "\n"))))

(defn- hunks [a [:list :string] b [:list :string] rs [:list [:ref :diff/r]] g :i64 ctx :i64
              acc [:list :string]] [:list :string]
  (if (>= g (vector-count rs))
    acc
    (let [gend (group-end rs g ctx)]
      (hunks a b rs gend ctx (add-string acc (hunk a b rs g gend ctx))))))

(defn- strip-slashes [path :string k :i64] :string
  (if (and (< k (string-byte-length path)) (= (string-code-point-at path k) 47))
    (strip-slashes path (+ k 1))
    (string-substring path k (string-byte-length path))))

(defn unified [path :string old :string new :string ctx :i64] :string
  (if (string=? old new)
    ""
    (let [a (split-lines old) b (split-lines new)
          rs (regions a b)
          rel (strip-slashes path 0)]
      (string-concat
       (string-concat "--- a/" (string-concat rel (string-concat "\n+++ b/" (string-concat rel "\n"))))
       (join (hunks a b rs 0 ctx (no-strings)) "")))))

(defn- sum-removed [rs [:list [:ref :diff/r]] k :i64 acc :i64] :i64
  (if (>= k (vector-count rs)) acc
      (sum-removed rs (+ k 1) (+ acc (- (r-ae (regions-nth rs k)) (r-as (regions-nth rs k)))))))

(defn- sum-added [rs [:list [:ref :diff/r]] k :i64 acc :i64] :i64
  (if (>= k (vector-count rs)) acc
      (sum-added rs (+ k 1) (+ acc (- (r-be (regions-nth rs k)) (r-bs (regions-nth rs k)))))))

(defn changed-lines [old :string new :string] [:ref :diff/cl]
  (let [rs (regions (split-lines old) (split-lines new))]
    (record-new [:ref :diff/cl] (sum-removed rs 0 0) (sum-added rs 0 0))))
