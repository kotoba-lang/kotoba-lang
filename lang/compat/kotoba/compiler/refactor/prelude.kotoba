;; Helper definitions the rewrites call.  Each has a host reading (byte-for-byte what Clojure's own destructuring /
;; keyword lookup does) and a Kotoba reading over kotoba.form.  They are inserted once, after the `ns` form, when a rewrite
;; that needs them has been applied (see kotoba.compiler.refactor.core/ensure-prelude).
(ns kotoba.compiler.refactor.prelude
  {:kotoba/export [order text-of has?]})

;; ---------------------------------------------------------------------------
;; Kotoba reading: the forms of the guest twin kotoba-lang lang/compat/kotoba/compiler/refactor/prelude.kotoba
;; (claude/refactor-twins-parity 1c7260f), moved verbatim, each in a #?(:kotoba ...) form; the last one carries the
;; host reading (the whole host program, unchanged) as its :default arm.  The twin's header follows.
;; kotoba.compiler.refactor.prelude -- the GUEST-ROUTE twin of amu's `src/kotoba/compiler/refactor/prelude.cljk`
;; (GENERATED by scripts/refactor-twin-diff/gen_prelude.py from the host file; do not edit by hand).
;;
;; The host module is two vars: `defs` (a map from helper name to the text of its definition) and `order` (the names in
;; insertion order). A map of strings has no exported Kotoba spelling, and a module with no export is refused (seed E6009),
;; so the twin is the same data behind two functions:
;;   (order)        -> [:list :string]   the host's `order`
;;   (text-of name) -> :string           the host's `(get defs name)`; "" for a name that is not a helper
;;   (has? name)    -> :bool             the host's `(contains? defs name)`
;; The texts are the host's, byte for byte (they are the Kotoba/host `#?` readings amu inserts into a rewritten source).


(defn order [] [:list :string]
  (typed-list-new [:list :string] "fe-nth" "fe-nthnext" "fe-get" "fe-get-or"))

(defn text-of [name :string] :string
  (cond
    (string=? name "fe-nth")
    ";; amu-refactor: positional access.  Host: what [a b] destructuring does; Kotoba: Form child, nil-form past the end.
#?(:kotoba
   (defn- fe-nth [f [:ref :form/r] i :i64] [:ref :form/r] (form/nth-of f i))
   :default
   (defn- fe-nth [c i] (nth c i nil)))"
    (string=? name "fe-nthnext")
    ";; amu-refactor: the rest after the first i children (nil / nil-form when none).
#?(:kotoba
   (defn- fe-nthnext [f [:ref :form/r] i :i64] [:ref :form/r]
     (let [n (form/count-of f)]
       (if (>= i n)
         (form/nil-form)
         (form/form-seq (loop [j i acc (form/no-forms)]
                          (if (>= j n) acc (recur (+ j 1) (form/append-form acc (form/nth-of f j)))))))))
   :default
   (defn- fe-nthnext [c i] (nthnext c i)))"
    (string=? name "fe-get")
    ";; amu-refactor: keyword lookup.  Host: `get`; Kotoba: form-get with a keyword Form.
#?(:kotoba
   (defn- fe-get [m [:ref :form/r] k :keyword] [:ref :form/r] (form/form-get m (form/keyword-form k)))
   :default
   (defn- fe-get [m k] (get m k)))"
    (string=? name "fe-get-or")
    ";; amu-refactor: keyword lookup with a default used only when the key is ABSENT (get's not-found, not nil-punning).
#?(:kotoba
   (defn- fe-get-or [m [:ref :form/r] k :keyword d [:ref :form/r]] [:ref :form/r]
     (if (form/form-has? m (form/keyword-form k)) (form/form-get m (form/keyword-form k)) d))
   :default
   (defn- fe-get-or [m k d] (get m k d)))"
    :else ""))

(defn has? [name :string] :bool
  (or (string=? name "fe-nth") (string=? name "fe-nthnext") (string=? name "fe-get") (string=? name "fe-get-or")))
