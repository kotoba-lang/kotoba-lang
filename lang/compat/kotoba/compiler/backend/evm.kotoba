(ns kotoba.compiler.backend.evm
  "Fail-closed checked-KIR to EVM bytecode lowering.

  The first vertical slice owns one Ethereum ABI surface: a pure, zero-arity
  `main() -> int64`.  It intentionally rejects storage, calls, capabilities,
  parameters, additional functions, and every KIR expression outside bounded
  i64 literals, addition, and multiplication.  The emitted creation bytecode
  deploys a conventional EVM runtime with a selector dispatcher, ABI-word
  return, and revert-on-unknown-selector behavior."
  {:kotoba/export [abi emit max-expression-depth max-expression-nodes selector-main target-name verify-artifact!]}
  (:require [kotoba.form :as form] [kotoba.bytes :as kbytes] [kotoba.verifier.seal :as seal] [kotoba.kir.target :as target] [kotoba.artifact.core :as artifact] [kotoba.kir.cljs-i64 :as i64])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]}))

nil
nil
nil
nil

nil

nil

;; This file is .cljc, so it claims both runtimes. Until 2026-08-25 the two
;; functions below were written only for the JVM and the claim was false in
;; three separate ways, none of which the JVM suite could see:
;;
;;   1. `Long/MIN_VALUE` is not a symbol ClojureScript can resolve, so the
;;      namespace did not even LOAD there -- measured with the resolved
;;      classpath, the only one of amu's fifteen .cljc namespaces that failed.
;;      Its neighbours use the same constant and load fine because theirs sit
;;      inside `#?(:clj ...)`, which the cljs reader strips before it is read.
;;   2. `integer?` does not recognise a JS bigint, and on ClojureScript every
;;      .kotoba integer VALUE is a bigint (`kotoba.kir.cljs-i64`'s docstring
;;      states this and gives the reason: plain cljs numbers are doubles and
;;      lose precision above 2^53). So `i64?` would have answered false for
;;      every literal it was handed.
;;   3. cljs bitwise ops coerce to int32, so `unsigned-bit-shift-right` by 56
;;      is a shift by 24 -- `56 & 31`. That one is the dangerous kind: it
;;      returns a number rather than failing, and would have emitted wrong
;;      PUSH8 operands silently.
;;
;; Both branches are held to byte-for-byte identity by
;; `test/nbb/run.cljk`'s evm case against the JVM's pinned bytes.

nil

nil

nil

nil                     ; AND = i64 wrapping

nil

nil

nil

nil

nil

nil

;; ---------------------------------------------------------------------------
;; THE KOTOBA READING. Same lowering, same bytes, over Forms: the KIR and the
;; artifact are `:form/r` (kotoba.form), expressions are its ints and
;; `(+ a b)` / `(* a b)` lists, byte vectors are `:vector-i64`. The constants
;; are functions (an export is a function). The digests are the canonical-text
;; SHA-256 of kotoba.verifier.seal, the text the hosts' `artifact/sha256`
;; hashes. A rejected KIR/artifact TRAPS (`assert`): an export cannot abort with
;; a value a caller sees (host: ex-info {:phase :evm-lowering ..}).

(defn target-name [] :keyword :evm256-kotoba-v1)

(defn selector-main [] :vector-i64
     (vector-conj (vector-conj (vector-conj (vector-conj (vector-i64) 223) 254) 173) 208))

(defn max-expression-nodes [] :i64 16)

(defn max-expression-depth [] :i64 12)

(defn- trap-form [] [:ref :form/r]
     (let [refused (assert (= 1 0))] (form/nil-form)))

(defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r]
     (form/form-get m (form/keyword-form k)))

(defn- has? [m [:ref :form/r] k :keyword] :bool
     (form/form-has? m (form/keyword-form k)))

(defn- put [m [:ref :form/r] k :keyword v [:ref :form/r]] [:ref :form/r]
     (form/assoc-form m (form/keyword-form k) v))

(defn- empty-map [] [:ref :form/r] (form/form-map (form/no-forms)))

(defn- append-from [out :vector-i64 b :vector-i64 i :i64] :vector-i64
     (if (>= i (vector-count b))
       out
       (append-from (vector-conj out (vector-at b i)) b (+ i 1))))

(defn- append-bytes [a :vector-i64 b :vector-i64] :vector-i64
     (append-from a b 0))

;; the 8 big-endian bytes of the word, shifts 56 down to 0
(defn- word-bytes [word :i64 shift :i64 out :vector-i64] :vector-i64
     (if (< shift 0)
       out
       (word-bytes word (- shift 8) (vector-conj out (bit-and 255 (u64-shift-right word shift))))))

;; number of nodes of an admitted expression, or -1 when it is not admitted
;; (depth, shape or size)
(defn- expr-nodes-total [left :i64 right :i64] :i64
     (if (< right 0)
       -1
       (if (> (+ 1 (+ left right)) 16) -1 (+ 1 (+ left right)))))

(defn- expr-nodes [f [:ref :form/r] depth :i64] :i64
     (if (> depth 12)
       -1
       (if (form/is-int? f)
         1
         (if (form/is-seq? f)
           (if (= 3 (form/count-of f))
             (if (form/is-symbol? (form/nth-of f 0))
               (if (or (string=? "+" (form/symbol-value (form/nth-of f 0)))
                       (string=? "*" (form/symbol-value (form/nth-of f 0))))
                 (let [left (expr-nodes (form/nth-of f 1) (+ depth 1))]
                   (if (< left 0)
                     -1
                     (expr-nodes-total left (expr-nodes (form/nth-of f 2) (+ depth 1)))))
                 -1)
               -1)
             -1)
           -1))))

(defn- emit-expr [f [:ref :form/r]] :vector-i64
     (if (form/is-int? f)
       (word-bytes (form/int-value f) 56 (vector-conj (vector-i64) 103))
       (append-bytes
        (append-bytes
         (append-bytes (emit-expr (form/nth-of f 1)) (emit-expr (form/nth-of f 2)))
         (vector-conj (vector-conj (vector-i64)
                                   (if (string=? "+" (form/symbol-value (form/nth-of f 0))) 1 2))
                      103))
        (vector-conj (vector-conj (vector-conj (vector-conj (vector-conj (vector-conj (vector-conj (vector-conj
                       (vector-conj (vector-i64) 255) 255) 255) 255) 255) 255) 255) 255) 22))))

(defn- no-or-empty? [f [:ref :form/r]] :bool
     (if (form/is-nil? f) true (= 0 (form/count-of f))))

;; the single admitted `main`: a pure zero-arity function returning :i64
(defn- admitted? [kir [:ref :form/r]] :bool
     (let [functions (fget kir :functions)
           function (form/first-of functions)]
       (if (or (form/eq (fget kir :format) (form/keyword-form :kotoba.kir/v3))
               (form/eq (fget kir :format) (form/keyword-form :kotoba.kir/v4)))
         (if (form/eq (fget kir :entry) (form/symbol-form "main"))
           (if (form/eq (fget kir :exports) (form/form-vec (form/one-form (form/symbol-form "main"))))
             (if (= 1 (form/count-of functions))
               (if (form/eq (fget function :name) (form/symbol-form "main"))
                 (if (no-or-empty? (fget function :params))
                   (if (no-or-empty? (fget function :param-types))
                     (if (form/eq (fget function :result) (form/keyword-form :i64))
                       (if (no-or-empty? (fget kir :effects))
                         (if (no-or-empty? (fget function :effects))
                           (>= (expr-nodes (fget function :body) 0) 0)
                           false)
                         false)
                       false)
                     false)
                   false)
                 false)
               false)
             false)
           false)
         false)))

;; The dispatcher and result are fixed byte strings of the host: PUSH1 0
;; CALLDATALOAD PUSH1 224 SHR PUSH4 selector EQ PUSH1 body JUMPI REVERT(0,0)
;; JUMPDEST, then SIGNEXTEND byte 7, MSTORE(0, value), RETURN(0, 32).
(defn- hex-bytes [text :string] :vector-i64
     (option-value-of [:option :vector-i64] (kbytes/unhex text) (vector-i64)))

(defn- runtime-bytes [body [:ref :form/r]] :vector-i64
     (append-bytes
      (append-bytes (hex-bytes "60003560e01c63dffeadd01460145760006000fd5b") (emit-expr body))
      (hex-bytes "60070b60005260206000f3")))

(defn- creation-bytes [runtime :vector-i64] :vector-i64
     (let [size (vector-count runtime)]
       (append-bytes
        (vector-conj (vector-conj (vector-conj (vector-conj (vector-conj (vector-conj (vector-conj (vector-conj
         (vector-conj (vector-conj (vector-conj (vector-conj (vector-i64)
          96) size) 96) 12) 96) 0) 57) 96) size) 96) 0) 243)
        runtime)))

(defn- ints-form [v :vector-i64 i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count v))
       acc
       (ints-form v (+ i 1) (form/append-form acc (form/int-form (vector-at v i))))))

(defn- bytes-form-of [v :vector-i64] [:ref :form/r]
     (form/form-vec (ints-form v 0 (form/no-forms))))

(defn abi [] [:ref :form/r]
     (form/edn-form "[{:type \"function\" :name \"main\" :stateMutability \"pure\" :inputs [] :outputs [{:name \"\" :type \"int64\"}]}]"))

(defn- limits [] [:ref :form/r]
     (put (put (put (put (empty-map) :expression-nodes (form/int-form 16))
                    :expression-depth (form/int-form 12))
               :runtime-bytes (form/int-form 255))
          :ambient-precompiles (form/bool-form false)))

(defn- emit-admitted [kir [:ref :form/r]] [:ref :form/r]
     (let [body (fget (form/first-of (fget kir :functions)) :body)
           runtime (runtime-bytes body)]
       (if (> (vector-count runtime) 255)
         (trap-form)
         (let [creation (creation-bytes runtime)
               runtime-form (bytes-form-of runtime)
               creation-form (bytes-form-of creation)]
           (put (put (put (put (put (put (put (put (put (put (put (empty-map)
              :format (form/keyword-form :evm/v1))
              :target (form/keyword-form (target-name)))
              :target-profile (form/from-document (target/profile (target-name))))
              :abi (abi))
              :selector (bytes-form-of (selector-main)))
              :kir kir)
              :kir-sha256 (form/string-form (seal/sha256-form kir)))
              :runtime-bytes runtime-form)
              :creation-bytes creation-form)
              :runtime-sha256 (form/string-form (seal/sha256-form runtime-form)))
              :creation-sha256 (form/string-form (seal/sha256-form creation-form)))))))

(defn emit [kir [:ref :form/r]] [:ref :form/r]
     (if (admitted? kir)
       (put (emit-admitted kir) :limits (limits))
       (trap-form)))

(defn- exact-keys? [candidate [:ref :form/r]] :bool
     (if (form/is-map? candidate)
       (if (= 24 (form/count-of candidate))
         (if (has? candidate :format)
           (if (has? candidate :target)
             (if (has? candidate :target-profile)
               (if (has? candidate :abi)
                 (if (has? candidate :selector)
                   (if (has? candidate :kir)
                     (if (has? candidate :kir-sha256)
                       (if (has? candidate :runtime-bytes)
                         (if (has? candidate :creation-bytes)
                           (if (has? candidate :runtime-sha256)
                             (if (has? candidate :creation-sha256)
                               (has? candidate :limits)
                               false)
                             false)
                           false)
                         false)
                       false)
                     false)
                   false)
                 false)
               false)
             false)
           false)
         false)
       false))

(defn verify-artifact! [candidate [:ref :form/r]] [:ref :form/r]
     (if (exact-keys? candidate)
       (if (form/eq (emit (fget candidate :kir)) candidate)
         candidate
         (trap-form))
       (trap-form)))
