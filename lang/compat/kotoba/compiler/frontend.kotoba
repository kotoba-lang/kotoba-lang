(ns kotoba.compiler.frontend
  {:kotoba/export [analyze analyze-forms capability-id->name capability-registry forbidden-heads kernel-region-report lint lint-forms max-bindings max-expression-nodes max-function-docstring-chars max-functions max-list-items max-lowered-nodes max-namespace-capabilities max-namespace-docstring-chars namespace-attr-map->clauses namespace-attr-map-clauses namespace-attr-map-keys read-error read-forms read-forms-result source-operation-registry]}
  (:require [kotoba.compiler.frontend.base :as base]
            [kotoba.compiler.frontend.kernel-region :as kernel-region]
            [kotoba.compiler.frontend.closure-types :as closure-types]
            [kotoba.compiler.frontend.expand :as expand]
            [kotoba.compiler.frontend.namespace-defs :as namespace-defs]
            [kotoba.compiler.frontend.validate :as validate]
            [kotoba.compiler.frontend.infer :as infer]
            [kotoba.compiler.frontend.record-projection :as record-projection]
            [kotoba.compiler.frontend.desugar :as desugar]
            [kotoba.compiler.frontend.row :as row]
            [kotoba.compiler.frontend.hiccup]
            [kotoba.compiler.frontend.state-ability :as state-ability]
            [kotoba.compiler.frontend.analyze :as analyze]
            [kotoba.compiler.frontend.lint :as lint-core])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :form/rd [:record :form/rd [[:form [:ref :form/r]] [:pos :i64]]]
                                 ;; a refusal: the Kotoba-route `reject!` throws one (ADR 0007)
                                 :fe/err [:record :fe/err [[:msg :string] [:code :string] [:form [:ref :form/r]] [:phase :string] [:data [:ref :form/r]]]]
                                 :fe/namespace-attr-clauses [:record :fe/namespace-attr-clauses [[:clauses [:list [:ref :form/r]]]]]
                                 :kotoba.reader/out [:record :kotoba.reader/out [[:forms [:list [:ref :form/r]]] [:err :string] [:at :i64]]]
                                 ;; the desugar env and its results (docs/selfhost-frontend-typemodel-design.md 1.2)
                                 :fe/env [:record :fe/env [[:counter :i64] [:result [:ref :form/r]] [:none :bool] [:arities [:ref :form/r]] [:lexical [:ref :form/r]] [:types [:ref :form/r]] [:docfns [:ref :form/r]] [:loop-counter :i64] [:tbl [:ref :form/r]] [:schemas [:ref :form/r]] [:lazy :bool] [:abort-ctx :string] [:used-caps [:ref :form/r]] [:options [:ref :form/r]] [:helpers [:ref :form/r]] [:shapes [:ref :form/r]] [:lambda-counter :i64] [:lambdas [:ref :form/r]] [:loop-result [:ref :form/r]] [:loop-known [:ref :form/r]] [:dispatchers [:ref :form/r]] [:uses-apply :bool] [:uses-lazy :bool] [:contracts [:ref :form/r]]]]
                                 :fe/dr [:record :fe/dr [[:env [:ref :fe/env]] [:form [:ref :form/r]]]]
                                 :fe/drs [:record :fe/drs [[:env [:ref :fe/env]] [:forms [:list [:ref :form/r]]]]]
                                 :ana/ir [:record :ana/ir [[:ok :bool] [:val [:ref :form/r]] [:err [:ref :fe/err]]]]}))

(defn capability-registry [] [:ref :form/r]
  (base/capability-registry))

(defn max-functions [] :i64
  (namespace-defs/max-functions))

(defn max-namespace-capabilities [] :i64
  (namespace-defs/max-namespace-capabilities))

(defn max-namespace-docstring-chars [] :i64
  (namespace-defs/max-namespace-docstring-chars))

(defn namespace-attr-map-clauses [attr-map [:ref :form/r]
                                  explicit-clauses [:list [:ref :form/r]]]
  [:ref :fe/namespace-attr-clauses]
  (namespace-defs/namespace-attr-map-clauses attr-map explicit-clauses))

;; `namespace-attr-map->clauses` on the Kotoba route is TWO arguments. The
;; host's third argument `reject-fn` is a host refusal CALLBACK, and the
;; Kotoba route has no function values -- its refusal model is a throw
;; (`require-k`, ADR 0007), which is exactly namespace-defs' own route twin.
;; Same refusals (unknown key named, declared twice), different reporting
;; shape: thrown, not called back.
(defn namespace-attr-map->clauses [attr-map [:ref :form/r]
                                   explicit-clauses [:list [:ref :form/r]]]
  [:list [:ref :form/r]]
  (namespace-defs/namespace-attr-map->clauses attr-map explicit-clauses))

(defn read-error [message :string] [:ref :fe/err]
  (base/fe-read-error message))

(defn read-forms-result [source :string] [:ref :kotoba.reader/out]
  (base/read-forms-result source))

;; The rest of the facade's public surface gets its Kotoba-route twin here: the
;; same delegations as the host `def`s below answer (base / namespace-defs /
;; validate / expand / kernel-region / analyze), one export name per twin. A
;; constant is a no-arg defn on this route -- the convention every max-* twin
;; already follows.
(defn capability-id->name [] [:ref :form/r]
  (base/capability-id->name))

(defn source-operation-registry [] [:ref :form/r]
  (base/source-operation-registry))

(defn read-forms [source :string] [:ref :form/r]
  (base/read-forms source))

(defn forbidden-heads [] [:ref :form/r]
  (namespace-defs/forbidden-heads))

(defn namespace-attr-map-keys [] [:ref :form/r]
  (namespace-defs/namespace-attr-map-keys))

(defn kernel-region-report [functions [:list [:ref :form/r]]] [:ref :form/r]
  (kernel-region/kernel-region-report functions))

(defn max-bindings [] :i64
  (validate/max-bindings))

(defn max-expression-nodes [] :i64
  (validate/max-expression-nodes))

(defn max-list-items [] :i64
  (validate/max-list-items))

(defn max-function-docstring-chars [] :i64
  (expand/max-function-docstring-chars))

(defn max-lowered-nodes [] :i64
  (analyze/max-lowered-nodes))

;; Facade over the split modules (amu refactor split). Each name is re-exported as a value;
;; a ^:dynamic var is a SNAPSHOT here: rebind it through its owning module (see the split report).
