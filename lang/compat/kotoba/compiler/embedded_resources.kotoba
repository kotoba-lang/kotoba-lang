;; GENERATED by scripts/gen-embedded-resources.cljk from resources/ -- do not edit.
;; To change a text: edit the resource, then run the script. The portable test
;; kotoba.compiler.embedded-resources-test refuses a stale copy.
(ns kotoba.compiler.embedded-resources
  "The classpath resources kotoba.compiler.backend-qualification reads, as
  compile-time text
  (superproject adr-2609242330 S3, decision (b')). `resource-text` answers
  what `(slurp (io/resource path))` answered for these paths, and nil for
  any other path, as io/resource did for a path not on the classpath."
  {:kotoba/export [resource-text]})

(defn- text-0
  "resources/kotoba/lang/backend-provider-qualification-v2.edn"
  [] :string
  "{:kotoba.backend-provider-qualification/format :v2\n ;; Bound to provider-conformance-v1.edn as of ececbcd, which added the\n ;; datagram/link-frame/can-frame kits (ids 27-29). Hash and count re-derived\n ;; 2026-08-30: sha256 via kotoba.artifact.core/sha256, count via\n ;; (count (mapcat :capabilities (:kits manifest))) = 13.\n :provider-manifest {:format :kotoba.provider-conformance/v1\n                     :sha256 \"d97f11507f122b3a5eb0931fe0e7898afc733899eaa89b6d4ca07c0e8e01e3fe\"\n                     :capability-count 13}\n :backends\n {:wasmtime {:manifest-gate :required\n             :execution-surface :wasmtime-component-v1\n             :execution-status :pending\n             :gaps [:nested-canonical-request-result-abi\n                    :recursive-schema-component-representation\n                    :production-provider-components\n                    :component-runtime-semantic-vectors\n                    :bounded-wasi-0.3-async\n                    :minimum-wasmtime-43]\n             :evidence {}}\n  :native {:manifest-gate :required\n           :execution-surface :aiueos-c-free-bare-metal-v1\n           :execution-status :pending\n           :gaps [:typed-provider-syscall-abi\n                  :nested-request-result-host-codec\n                  :native-provider-semantic-vectors\n                  :c-free-aiueos-cpl3-syscall-substrate]\n           ;; Hosted kexe clock-v1 (ADR 0266) is an oracle, not this surface.\n           :evidence {}}\n  :cljs {:manifest-gate :required\n         :execution-surface :nbb-process-v1\n         :execution-status :qualified\n         :gaps []\n         :evidence {:runtime-boundary \"kotoba.compiler.backend-cljs-test/real-nbb-round-trips-full-i64-provider-values\"\n                    :semantic-vectors \"kotoba.compiler.backend-cljs-test/typed-provider-dispatch-runs-all-application-kit-contracts\"}}}}\n")

(defn- text-1
  "resources/kotoba/lang/capability-catalog.edn"
  [] :string
  "{:kotoba.lang.capability-catalog/version 1\n :kotoba.lang.capability-catalog/authority \"kotoba-lang/kotoba-lang\"\n :kotoba.lang.capability-catalog/status :w2-semantic-authority\n :kotoba.lang.capability-catalog/wire-profile :compiler-cap-call-v1\n :kotoba.lang.capability-catalog/elaboration\n {:source-arity 1\n  :request-type :infer-from-argument\n  :result-type :infer-from-context\n  :authority :host-bound-ability\n  :numeric-id :not-user-facing}\n;; CLASSIFICATION (`:kotoba.security/classification`, root ADR-2607280100 D5).\n;;\n;; Every entry declares one, and the declaration is part of the LANGUAGE\n;; SPEC rather than something a caller passes in. That is the whole point:\n;; ADR-2607280100's problem 3 is that a classification supplied by the\n;; caller can be OMITTED, and an omission is indistinguishable from a\n;; correct declaration -- it fails open and nothing says so. A label that\n;; lives on the effect descriptor cannot be omitted by a caller, and a\n;; capability added here WITHOUT one cannot be compiled at all\n;; (`kotoba.compiler.effect-classification` refuses; see amu).\n;;\n;; The label is the CLEARANCE A SUBJECT MUST HOLD to be granted this\n;; authority -- `kotoba.security.abac`'s no-read-up reading of a resource\n;; classification -- and NOT the classification of any one call's payload.\n;; A payload label is a runtime fact; this is a static property of the\n;; authority. `secret/get` cannot be exercised below `:restricted` no\n;; matter what secret is fetched; `hash/sha256` crosses no boundary at all.\n;;\n;; The four labels are `kotoba.security.information-flow/ranks` and nothing\n;; else. There is exactly one lattice (ADR-2607280100 D1) and this file\n;; does not restate it -- a label this catalog writes that that lattice\n;; cannot rank is refused at compile time, in the same breath as a missing\n;; one, because an unrankable declaration and no declaration leave the\n;; judgment with equally nothing to compare.\n;;\n;;   :public       crosses no trust boundary and carries no subject data\n;;   :internal     this program's own surfaces -- its log, its screen, its\n;;                 stdout/stderr, how it was invoked, where it was started\n;;   :confidential someone else's data or an external service: durable\n;;                 state, storage, objects, the network, a filesystem, a\n;;                 model provider\n;;   :restricted   authority over credentials, other processes, other\n;;                 applications' screens, raw buses, or code selection\n :capabilities\n {:identity/sign\n  {:source-operation identity/sign :effect :identity/sign :compiler-wire-id 1\n   :kotoba.security/classification :restricted}\n  :identity/verify\n  {:source-operation identity/verify :effect :identity/verify :compiler-wire-id 2\n   :kotoba.security/classification :public}\n  :hash/sha256\n  {:source-operation hash/sha256 :effect :hash/sha256 :compiler-wire-id 3\n   :kotoba.security/classification :public}\n  :http/post\n  {:source-operation http/post :effect :http/post :compiler-wire-id 4\n   :kotoba.security/classification :confidential\n   :source-status :friendly-qualified}\n  :log/read\n  {:source-operation log/read :effect :log/read :compiler-wire-id 5\n   :kotoba.security/classification :internal}\n  :log/append\n  {:source-operation log/append :effect :log/append :compiler-wire-id 6\n   :kotoba.security/classification :internal}\n  :clock/now\n  {:source-operation clock/now :effect :clock/now :compiler-wire-id 7\n   :kotoba.security/classification :public}\n  :state/transact\n  {:source-operation state/transact :effect :state/transact :compiler-wire-id 8\n   :kotoba.security/classification :confidential}\n  :ui/commit\n  {:source-operation ui/commit :effect :ui/commit :compiler-wire-id 9\n   :kotoba.security/classification :internal}\n  :ui/next-event\n  {:source-operation ui/next-event :effect :ui/next-event :compiler-wire-id 10\n   :kotoba.security/classification :internal}\n  :llm/generate\n  {:source-operation llm/generate :effect :llm/generate :compiler-wire-id 11\n   :kotoba.security/classification :confidential\n   :source-status :friendly-qualified}\n  :storage/transact\n  {:source-operation storage/transact :effect :storage/transact :compiler-wire-id 12\n   :kotoba.security/classification :confidential\n   :source-status :friendly-qualified}\n  :http/get-stream\n  {:source-operation http/get-stream :effect :http/get-stream :compiler-wire-id 13\n   :kotoba.security/classification :confidential}\n  :object/get-stream\n  {:source-operation object/get-stream :effect :object/get-stream :compiler-wire-id 14\n   :kotoba.security/classification :confidential}\n  :object/put-block\n  {:source-operation object/put-block :effect :object/put-block :compiler-wire-id 15\n   :kotoba.security/classification :confidential}\n  :object/compare-and-set-ref\n  {:source-operation object/compare-and-set-ref\n   :effect :object/compare-and-set-ref\n   :compiler-wire-id 16\n   :kotoba.security/classification :confidential}\n  :http/accept\n  {:source-operation http/accept :effect :http/accept :compiler-wire-id 17\n   :kotoba.security/classification :confidential\n   :source-status :friendly-qualified}\n  :http/reply\n  {:source-operation http/reply :effect :http/reply :compiler-wire-id 18\n   :kotoba.security/classification :confidential\n   :source-status :friendly-qualified}\n  ;; T8.3 ops kits (provider ADR 0143–0151 / guest host surfaces 0260–0267).\n  ;; Wire ids match provider kit :capability :id (scoped-fs→fs/transact 19 … entropy 23).\n  :fs/transact\n  {:source-operation fs/transact :effect :fs/transact :compiler-wire-id 19\n   :kotoba.security/classification :confidential\n   :source-status :friendly-qualified}\n  ;; process/spawn -- run ONE program and answer \"<exit>\\n<stdout>\".\n  ;;\n  ;; ONE request grammar and ONE grant on every host that answers wire 20\n  ;; (superproject adr-2609251400 C3, 2026-09-25; the owner's decision that\n  ;; the kexe loader answers it too). Until then there were two: the kbb js\n  ;; host took a decimal INDEX into the policy's invocation table (the guest\n  ;; supplied no command bytes), the loader-less Linux static ELF took the\n  ;; argv form below, and the kexe loader answered the identity stub -- so\n  ;; one program meant three different things on three hosts.\n  ;;\n  ;; Why the argv form and not the index form. The index form IS narrower:\n  ;; the guest cannot choose an argument, so no argument can be injected\n  ;; into a granted program (`sh -c`, `git -c core.sshCommand=`, `find\n  ;; -exec`). That is recorded, not dismissed. It lost for two concrete\n  ;; reasons: (1) the callers that need spawn compute their argv (amu's own\n  ;; nbb modules -- classpath, package_lock, test_profile -- call spawnSync\n  ;; with arguments built at run time), and a table of literal rows cannot\n  ;; express them, so the index form would push those callers to a second,\n  ;; wider wire; (2) the argv form's authority is still the grant's: nothing\n  ;; runs but a program the grant names, by its canonical absolute path, and\n  ;; the SEALED spelling is what is executed. What the argv form gives up is\n  ;; stated in :grant :authority below: granting a program grants every\n  ;; argument vector of it, so granting an interpreter grants arbitrary code\n  ;; with the process's own uid. A policy that wants fixed invocations\n  ;; grants a program that takes none.\n  :process/spawn\n  {:source-operation process/spawn :effect :process/spawn :compiler-wire-id 20\n   :kotoba.security/classification :restricted\n   :source-status :friendly-qualified\n   :request \"<program>[ARG_SEP<arg>]...\"\n   :request-rules\n   [\"ARG_SEP separates the program from each argument; there is no quoting, and an argument cannot contain ARG_SEP\"\n    \"<program> is non-empty; a request holding a NUL byte, or an empty program, is malformed (a plain trap, not a named refusal)\"\n    \"<program> containing / must be byte-equal to a granted program; a bare name is looked up ONLY among the granted programs' last segments, ONLY when :path-lookup is true, and $PATH is never read\"\n    \"the guest's spelling is argv[0]; the granted spelling is what is executed\"\n    \"at most 32 arguments after the program, and at most 4,096 bytes of argv strings with their NULs\"]\n   :answer \"<exit>\\n<stdout>: the child's exit code in decimal, -1 when a signal ended it; then exactly the bytes it wrote to stdout\"\n   :child\n   [\"environment: empty except the variables :env names, copied from the host process's own environment\"\n    \"stdin: a pipe at EOF; stdout: captured, at most 16,384 bytes; stderr: the host's own fd 2\"\n    \"no descriptor but 0, 1 and 2 (the rest are closed across execve)\"\n    \"working directory: the :fs/app-data scope root when one is granted (the first entry when a host holds several), else inherited\"\n    \"no_new_privs where the OS has it (Linux: PR_SET_NO_NEW_PRIVS; macOS and the js host have no equivalent -- recorded, not emulated)\"\n    \"a 10 s wall deadline; the direct child is killed with SIGKILL when it passes (its own children are not -- there is no process group)\"\n    \"the capability grant is not inherited: the child is an ordinary process with the host's uid, filesystem and network (NOT a sandbox)\"]\n   :grant\n   {:shape {:programs [\"<canonical absolute path>\"] :path-lookup false :env [\"<NAME>\"]}\n    :programs \"1..16 distinct canonical absolute paths: no empty, . or .. segment, no trailing /, not /\"\n    :path-lookup \"true or false (default false); when true the programs' last segments must differ\"\n    :env \"0..16 names, each 1..255 bytes without = or NUL (default none)\"\n    :authority \"a granted program may be run with ANY argument vector the grammar admits\"\n    :carriers\n    {:amu-compile-policy \":spawn (top level, target-neutral); the linux-static target also reads the older :linux-static :spawn spelling, and refuses a policy that spells it both ways\"\n     :kexe-loader \"KEXE_CAP_RESOURCES_20 (programs, colon-separated), KEXE_SPAWN_ENV (names, colon-separated), KEXE_SPAWN_PATH_LOOKUP=1; a packaged command bakes all three in and ignores the environment\"\n     :kbb-js \":kotoba.policy/spawn in the kbb policy, with :proc/exec (the kbb name kbb compiles to :process/spawn) in :kotoba.policy/capabilities\"}}\n   :refusals\n   {:reason-prefix \":spawn/\"\n    :trap \"KEXE_TRAP {:kind :capability :capability :process/spawn :reason :spawn/<name>}\"\n    :exit :capability/refused\n    :names [:argv-budget :program-not-granted :path-lookup-denied :output-budget\n            :timeout :exec-failed :isolation-unavailable :setup-failed]}\n   ;; Every host that answers wire 20 takes this grammar: the static image and\n   ;; the kexe loader from ONE compiled decision module (amu\n   ;; tools/linux_static_handlers.kotoba; the loader runs the program from\n   ;; its unsandboxed supervisor), the kbb js host (kotoba-lang/kotoba\n   ;; bin/kbb_js.cljk) restating the same rules in its own provider.\n   :answered-by #{:linux-static :kexe-loader :kbb-js}}\n  :secret/get\n  {:source-operation secret/get :effect :secret/get :compiler-wire-id 21\n   :kotoba.security/classification :restricted\n   :source-status :friendly-qualified}\n  :git/run\n  {:source-operation git/run :effect :git/run :compiler-wire-id 22\n   :kotoba.security/classification :confidential\n   :source-status :friendly-qualified}\n  ;; entropy/draw -- a decimal byte count N (1..256) -> 2N lowercase hex\n  ;; characters from the host's CSPRNG. The Linux static ELF answers it with\n  ;; getrandom(2), flags 0, and refuses BY NAME (:entropy/unavailable) when\n  ;; the kernel has none, rather than reading a device node the grant does\n  ;; not name (superproject adr-2609251400 C3, 2026-09-25). The kexe loader\n  ;; answers it from the same decisions with getrandom(2) on Linux and\n  ;; getentropy(2) on macOS.\n  :entropy/draw\n  {:source-operation entropy/draw :effect :entropy/draw :compiler-wire-id 23\n   :kotoba.security/classification :public\n   :source-status :friendly-qualified\n   :request \"<N>, decimal, 1..256\"\n   :answer \"2N lowercase hex characters\"\n   :refusals {:trap \"KEXE_TRAP {:kind :capability :capability :entropy/draw :reason :entropy/unavailable}\"\n              :exit :capability/refused}\n   :answered-by #{:linux-static :kexe-loader}}\n  ;; Dataspace kit (root ADR-2608154100). Named source: dataspace/transact.\n  :dataspace/transact\n  {:source-operation dataspace/transact :effect :dataspace/transact\n   :compiler-wire-id 24\n   :kotoba.security/classification :confidential\n   :source-status :friendly-qualified}\n  ;; Stream ingress kit (root ADR-2608150900). A bidirectional frame stream --\n  ;; a telephone call's media, a websocket, a pipe -- where http-ingress is\n  ;; one request paired to one reply. Frames in and frames out are separate\n  ;; capabilities because they are separate authorities: a guest that may hear\n  ;; a stream has not thereby been allowed to speak into it.\n  :stream/accept\n  {:source-operation stream/accept :effect :stream/accept\n   :compiler-wire-id 25\n   :kotoba.security/classification :confidential\n   :source-status :friendly-qualified}\n  :stream/send\n  {:source-operation stream/send :effect :stream/send\n   :compiler-wire-id 26\n   :kotoba.security/classification :confidential\n   :source-status :friendly-qualified}\n  ;; Transport kits. Datagram, raw link, and CAN frame access remain distinct\n  ;; authorities even when one provider implements more than one of them.\n  :net/datagram\n  {:source-operation net/datagram :effect :net/datagram :compiler-wire-id 27\n   :kotoba.security/classification :confidential\n   :source-status :friendly-qualified}\n  :link/frame\n  {:source-operation link/frame :effect :link/frame :compiler-wire-id 28\n   :kotoba.security/classification :restricted\n   :source-status :friendly-qualified}\n  :can/frame\n  {:source-operation can/frame :effect :can/frame :compiler-wire-id 29\n   :kotoba.security/classification :restricted\n   :source-status :friendly-qualified}\n  ;; Lisp-facing `eval` is syntax sugar for this typed, host-bound operation.\n  ;; The request names a checked definition by CID; it is never source text or\n  ;; an ambient namespace lookup.\n  :code/eval\n  {:source-operation code/eval :effect :code/eval\n   :compiler-wire-id 30\n   :kotoba.security/classification :restricted\n   :source-status :friendly-unqualified-alias\n   :source-alias eval}\n  ;; Screen surface (ADR-2609031100). Observing a screen and acting on it are\n  ;; separate authorities, the way stream/accept and stream/send are: a guest\n  ;; that may SEE a screen has not thereby been allowed to press anything on\n  ;; it. The act request carries the digest of the tree the guest read, and a\n  ;; host revalidates that digest before every effect.\n  ;;\n  ;; THESE ARRIVED BY THE WRONG ROUTE. kotoba-sema c823461 added them to its\n  ;; VENDORED COPY of this file -- a language-surface change made in a\n  ;; consumer -- and amu's copy of the same authority shadowed kotoba-sema's\n  ;; on amu's classpath, so the two ids were invisible to the compiler that\n  ;; would have to lower them. The FIRST run of\n  ;; `scripts/check-vendored-copies-fleet.cljk` found it on 2026-09-03; until\n  ;; that run nothing had ever compared the copies. They are promoted here\n  ;; rather than reverted because ADR-2609031100 is accepted and\n  ;; owner-directed, and its own Consequences already name this file as where\n  ;; the change belongs -- the defect was the filing, not the decision.\n  ;;\n  ;; RESERVED, NOT YET BOUND -- measured 2026-09-03. No capability kit names\n  ;; either id; a fleet-wide search for the two names returned this file,\n  ;; kotoba-sema's copy, the frontend that reads it, and two ADRs, and nothing\n  ;; else; and `kotoba-lang/screen`, the library ADR-2609031100 designs, does\n  ;; not exist yet. That is what this catalog is -- names and stable wire ids\n  ;; for host-bound abilities, fixed before the host exists. Nine of the\n  ;; thirty entries above have no kit either, `code/eval` (30) among them.\n  :screen/observe\n  {:source-operation screen/observe :effect :screen/observe\n   :compiler-wire-id 31\n   :kotoba.security/classification :restricted\n   :source-status :friendly-qualified}\n  :screen/act\n  {:source-operation screen/act :effect :screen/act\n   :compiler-wire-id 32\n   :kotoba.security/classification :restricted\n   :source-status :friendly-qualified}\n  ;; kbb ops-script surface (ADR-2607181900 readiness gate slice 3): the\n  ;; semantic wire ids for the host provider capabilities kbb's\n  ;; bootstrap host already implements (runtime capability ids 258 env/read\n  ;; and 253 fs/browse in kotoba-core-contracts — those are the RUNTIME\n  ;; id space; these are the COMPILER wire ids, and the two spaces are\n  ;; distinct by design: the kbb host maps wire id -> runtime op). Scoped\n  ;; like :fs/transact — resource scope = granted env var NAMES /\n  ;; directory trees, never :any in production policies.\n  :env/read\n  {:source-operation env/read :effect :host/env-read\n   :compiler-wire-id 33\n   :kotoba.security/classification :restricted}\n  :fs/browse\n  {:source-operation fs/browse :effect :host/fs-browse\n   :compiler-wire-id 34\n   :kotoba.security/classification :confidential}\n  ;; fs/browse-dir (runtime id 261, kotoba-core-contracts) — directory\n  ;; listing WITH an is-dir flag per entry, for the kotoba-lang/find\n  ;; recursive tree-walk. Wire id 36 so native (amu KEXE / kbb --backend\n  ;; js) guests can lower it against the js/native provider; same effect\n  ;; family as fs/browse (:host/fs-browse-dir).\n  :fs/browse-dir\n  {:source-operation fs/browse-dir :effect :host/fs-browse-dir\n   :compiler-wire-id 36\n   :kotoba.security/classification :confidential}\n  ;; fs/app-data (runtime id 202, kotoba-core-contracts) — sandboxed\n  ;; fs read/write narrowed to the granted path scope (never :any in\n  ;; production policies). Wire id 35 so native (amu KEXE) guests can\n  ;; lower fs-read/fs-write against the loader provider table\n  ;; (ADR-2609051100 slice 4).\n  ;;\n  ;; :forms -- the request forms of wire 35, told apart by an ASCII token (the\n  ;; path precedes it, any content follows it), and which native host answers\n  ;; each. Until 2026-09-25 this list lived only in the comments of amu\n  ;; tools/kexe_loader.c. `:status :proposed` marks a form a host answers\n  ;; before the kexe loader does; none is proposed now. fsync, make-temp-dir\n  ;; and stat-nofollow left :proposed on 2026-09-25 (superproject\n  ;; adr-2609251400 C3), OWNER on 2026-09-26 (adr-2609242330, selfhost stage\n  ;; 2): the loader and the static image answer them from the same compiled\n  ;; decisions (amu tools/linux_static_handlers.kotoba). amu refuses a\n  ;; kexe-loader program whose literals carry the token of a form the loader\n  ;; does not answer, by name.\n  ;; No token contains another, so a host that does not know a form cannot\n  ;; take it for a different one.\n  :fs/app-data\n  {:source-operation fs/app-data :effect :host/fs-app-data\n   :compiler-wire-id 35\n   :kotoba.security/classification :confidential\n   :forms\n   {:read {:token nil :request \"<path>\" :answer \"the file's bytes\"\n           :answered-by #{:kexe-loader :linux-static}}\n    :write {:token \"WRITE_SEP\" :request \"<path>WRITE_SEP<content>\" :answer \"the content\"\n            :answered-by #{:kexe-loader :linux-static}}\n    :append {:token \"APPEND_SEP\" :request \"<path>APPEND_SEP<content>\"\n             :answer \"the content; the file must exist\"\n             :answered-by #{:kexe-loader :linux-static}}\n    :exists {:token \"EXISTS_SEP\" :request \"<path>EXISTS_SEP\" :answer \"\\\"1\\\" / \\\"0\\\"\"\n             :answered-by #{:kexe-loader :linux-static}}\n    :range {:token \"RANGE_SEP\" :request \"<path>RANGE_SEP<offset>:<length>\"\n            :answer \"exactly those bytes\"\n            :answered-by #{:kexe-loader :linux-static}}\n    :stat {:token \"STAT_SEP\" :request \"<path>STAT_SEP\"\n           :answer \"\\\"<mode&0777> <size> <blocks> <is-dir>\\\", \\\"\\\" when absent; a final symlink is not followed and reads as absent\"\n           :answered-by #{:kexe-loader :linux-static}}\n    :mtime {:token \"MTIME_SEP\" :request \"<path>MTIME_SEP\" :answer \"st_mtime seconds, \\\"\\\" when absent\"\n            :answered-by #{:kexe-loader :linux-static}}\n    :chmod {:token \"CHMOD_SEP\" :request \"<path>CHMOD_SEP<1..6 octal digits>\"\n            :answer \"\\\"1\\\" / \\\"0\\\"; permission bits only\"\n            :answered-by #{:kexe-loader :linux-static}}\n    :mkdir {:token \"MKDIR_SEP\" :request \"<path>MKDIR_SEP\" :answer \"\\\"1\\\" / \\\"0\\\"\"\n            :answered-by #{:kexe-loader :linux-static}}\n    :unlink {:token \"UNLINK_SEP\" :request \"<path>UNLINK_SEP\" :answer \"\\\"1\\\" / \\\"0\\\"\"\n             :answered-by #{:kexe-loader :linux-static}}\n    :rmdir {:token \"RMDIR_SEP\" :request \"<path>RMDIR_SEP\" :answer \"\\\"1\\\" / \\\"0\\\"\"\n            :answered-by #{:kexe-loader :linux-static}}\n    :rename {:token \"RENAME_SEP\" :request \"<from>RENAME_SEP<to>\" :answer \"\\\"1\\\" / \\\"0\\\"\"\n             :answered-by #{:kexe-loader :linux-static}}\n    :fsync {:token \"FSYNC_SEP\" :request \"<path>FSYNC_SEP\"\n            :answer \"\\\"1\\\" once fsync(2) returned, \\\"0\\\" when the file cannot be opened or the flush fails\"\n            :answered-by #{:kexe-loader :linux-static}}\n    :make-temp-dir {:token \"MKTEMP_SEP\" :request \"<dir>MKTEMP_SEP<prefix>\"\n                    :answer \"the absolute path of a NEW directory <dir>/<prefix><6 of [0-9a-z]>, mode 0700 (mkdtemp); \\\"\\\" when <dir> cannot be opened\"\n                    :answered-by #{:kexe-loader :linux-static}}\n    :stat-nofollow {:token \"NOFOLLOW_SEP\" :request \"<path>NOFOLLOW_SEP\"\n                    :answer \"\\\"<mode&0777> <size> <blocks> <kind>\\\" of the final component ITSELF, kind 0 file / 1 directory / 2 symlink / 3 other; \\\"\\\" when absent\"\n                    :answered-by #{:kexe-loader :linux-static}}\n    ;; Proposed by the nbb compiler's verdict cache (superproject\n    ;; adr-2609242330 S5, 2026-09-25): its owner-only rule needs the owner of\n    ;; a directory or entry and this process's uid, which no other form\n    ;; carries. Answered since 2026-09-26 by the kexe loader (fstatat\n    ;; AT_SYMLINK_NOFOLLOW beneath the scope; the euid read once before the\n    ;; sandbox is installed) and the static ELF (O_PATH | O_NOFOLLOW, fstat,\n    ;; geteuid), from the same decisions (form 15, token 14); amu's nbb\n    ;; handler answers it with lstat + geteuid.\n    :owner {:token \"OWNER_SEP\" :request \"<path>OWNER_SEP\"\n            :answer \"\\\"<owner uid> <process euid>\\\" of the final component ITSELF (not followed), \\\"\\\" when absent\"\n            :answered-by #{:kexe-loader :linux-static}}}\n   ;; :answer-kinds -- what a form's payload is. Every form above is\n   ;; `[:string :string]`, the one pair `typed-cap-call` admits for a named\n   ;; wire. `:bytes` is proposed (superproject adr-2609242330 S5, 2026-09-25):\n   ;; the compiler reads and publishes BINARY files (wasm, kexe, the loader),\n   ;; which are not UTF-8 and so cannot be a Kotoba string. amu's nbb handler\n   ;; answers it (`fs/app-data-bytes`); no Kotoba source can name it until the\n   ;; frontend admits a `[:string :bytes]` / `[:bytes :string]` pair.\n   :answer-kinds\n   {:string {:forms :all}\n    :bytes {:status :proposed :forms #{:read :range :write :append}\n            :request \"the READ / RANGE request as text; WRITE / APPEND as <path><TOKEN> followed by the content BYTES\"\n            :answer \"READ / RANGE: the bytes; WRITE / APPEND: the content bytes\"}}}\n  ;; io/write — the bytes a COMMAND writes to its standard output. Wire id\n  ;; 37.\n  ;;\n  ;; Request is the bytes; the result is the DECIMAL COUNT of bytes written,\n  ;; as text. Two constraints pick that shape and neither is a preference:\n  ;;\n  ;;   * `[:string :string]` is one of the four generic type pairs\n  ;;     `kotoba.kir`'s native gate admits for `typed-cap-call` (the others\n  ;;     are i64, option-i64, result-i64). `:string -> :i64` is not among\n  ;;     them and would need a named provider contract, which is a change to\n  ;;     the gate rather than to this catalog.\n  ;;   * the result must be SHORT. A native guest's strings live in one\n  ;;     65,536-byte arena that is a bump allocator and never reclaims\n  ;;     (`kexe_loader.c`, no assignment to `string_pool_used` other than\n  ;;     `+=`), so echoing the payload back -- the shape `fs/app-data`'s\n  ;;     write form uses -- would charge every write twice. A count costs a\n  ;;     handful of bytes whatever the payload is, and is still verifiable.\n  ;;\n  ;; The effect is `:host/io-write`, which is deliberately NOT the\n  ;; `:host/log-append` family: a command's standard output is its answer,\n  ;; not an audit record, and the two must not share a grant.\n  :io/write\n  {:source-operation io/write :effect :host/io-write\n   :compiler-wire-id 37\n   :kotoba.security/classification :internal}\n  ;; cli/args — the arguments a COMMAND was invoked with. Wire id 38.\n  ;;\n  ;; `:string -> :string`, so the index travels as decimal text: the empty\n  ;; request answers the COUNT, a decimal answers that argument zero-based,\n  ;; and past the end answers the empty string. The empty request is what\n  ;; makes the count unambiguous -- an index is a non-empty decimal, so no\n  ;; index can collide with it, and a guest cannot instead probe for the\n  ;; first empty answer because an empty ARGUMENT is legal and looks the\n  ;; same.\n  ;;\n  ;; Like :io/write this carries no resource scope, and for the same reason:\n  ;; the guest names nothing and chooses nothing. The grant means exactly\n  ;; \"may see how this process was invoked\".\n  :cli/args\n  {:source-operation cli/args :effect :host/cli-args\n   :compiler-wire-id 38\n   :kotoba.security/classification :internal}\n  ;; io/write-error — the bytes a COMMAND writes to its DIAGNOSTIC output.\n  ;; Wire id 39. Same `:string -> :string` shape as :io/write and the same\n  ;; decimal byte count for a result; the difference is the destination and,\n  ;; more importantly, the AUTHORITY.\n  ;;\n  ;; Its own effect and deliberately not :host/io-write. A command's standard\n  ;; output is its answer and its diagnostic output is not: a pipeline reads\n  ;; one and a person reads the other, and a grant that carried both would let\n  ;; a guest put into the answer what it was only permitted to complain with.\n  ;; Six commands in this family had shipped saying \"the error paths are not\n  ;; matched\" because there was no capability to match them with.\n  :io/write-error\n  {:source-operation io/write-error :effect :host/io-write-error\n   :compiler-wire-id 39\n   :kotoba.security/classification :internal}\n  ;; sys/cwd — the directory the process was started in. Wire id 40.\n  ;;\n  ;; The empty request answers an absolute path; there is no other form. It\n  ;; carries no resource scope, like :io/write and :cli/args, and for the\n  ;; same reason: the guest names nothing and chooses nothing. The grant\n  ;; means exactly \"may see where this process was started\".\n  ;;\n  ;; Its own effect, and specifically NOT :host/env-read, though `pwd` is\n  ;; often described as reading $PWD. Measured 2026-09-10: /bin/pwd -L\n  ;; VALIDATES $PWD against the real directory and prints the physical path\n  ;; when they disagree -- with PWD=/tmp it printed the physical path anyway.\n  ;; So the environment variable is not the answer, it is a hint the real\n  ;; answer is checked against, and a grant to read environment variables\n  ;; therefore cannot supply it. That is why this is a wire and not another\n  ;; request form.\n  :sys/cwd\n  {:source-operation sys/cwd :effect :host/sys-cwd\n   :compiler-wire-id 40\n   :kotoba.security/classification :internal}\n  ;; io/read — the bytes a COMMAND reads from its standard input. Wire id 41.\n  ;;\n  ;; Measured 2026-09-16 over 1,268,018 Bash calls in 558 agent transcripts\n  ;; (superproject ADR-2609161710): head is invoked as a LATER pipeline\n  ;; segment 97% of the time, tail 94%, cut 97%, tr 99%, sort 97%, uniq 99%,\n  ;; wc 84%, awk 81%, grep 67%. A later segment reads standard input. Every\n  ;; command built on :cli/args + :fs/app-data + :io/write can only be the\n  ;; FIRST segment, so without this wire the commands cannot sit where they\n  ;; are called.\n  ;;\n  ;; Two request forms. The EMPTY request answers everything up to EOF; a\n  ;; DECIMAL request answers at most that many bytes of what has not been\n  ;; answered yet, and the empty string at EOF -- the form `head` needs to\n  ;; stop reading when it has its lines, so that `yes | head` ends. Both\n  ;; forms share one cursor: bytes are answered once.\n  ;;\n  ;; Its own effect and NOT :host/fs-app-data: the guest names no path and\n  ;; the grant carries no scope. Standard input is whatever the CALLER\n  ;; connected -- a pipe, a file the caller could open, a terminal -- and a\n  ;; grant to read it must not become a grant to open files, nor the other\n  ;; way round. It is also NOT :host/cli-args, though both describe how the\n  ;; process was invoked: argv is bounded and known at start, stdin is\n  ;; unbounded and arrives as the guest asks.\n  :io/read\n  {:source-operation io/read :effect :host/io-read\n   :compiler-wire-id 41\n   :kotoba.security/classification :internal}\n  ;; gpu/compute — a compute dispatch on the host's GPU. Wire id 42. Root\n  ;; ADR-2609182400 C (owner 2026-09-18: 「native からの GPU dispatch を amu\n  ;; compiler native binary で対応」).\n  ;;\n  ;; `:string -> :string`, one ASCII request line, an answer in decimal or\n  ;; hex: INFO / ALLOC <bytes> / MAP <path> <offset> <length> / WRITE <handle>\n  ;; <offset> <hex> / READ <handle> <offset> <length> / PIPELINE <spv-path>\n  ;; <bindings> / BEGIN / DISPATCH <pipeline> <x> <y> <z> <handle>... /\n  ;; SUBMIT (answers the submit->fence nanoseconds) / FREE <handle>. The\n  ;; grammar is the loader's (amu tools/kexe_gpu_vulkan.c); the guest names\n  ;; handles it was answered and workgroup counts, and the weights of a model\n  ;; reach the device by PATH (MAP) rather than through this string, which is\n  ;; bounded by the string pool.\n  ;;\n  ;; The mechanism runs in the SUPERVISOR, not in the sandboxed guest: a\n  ;; Vulkan driver needs syscalls the guest is not admitted, and the guest\n  ;; reaches it over a pipe. Every decision -- which kernel, which shape,\n  ;; which layer, what to sample -- stays in the .kotoba program; the\n  ;; provider decides nothing.\n  ;;\n  ;; Its own effect and NOT :host/fs-app-data, though MAP and PIPELINE name\n  ;; a path: what the grant carries is \"may run compute on this host's GPU\n  ;; and read back what it computed\", and a file grant must not carry that,\n  ;; nor this grant open files for the guest to read.\n  :gpu/compute\n  {:source-operation gpu/compute :effect :host/gpu-compute\n   :compiler-wire-id 42\n   :kotoba.security/classification :internal}\n  ;; net/listen .. net/write -- native TCP, compiler wires 43..47 (root\n  ;; ADR-2609261900 stage B: the agent-centric write plane). One authority\n  ;; per direction, as :stream/accept 25 / :stream/send 26 are: a guest that\n  ;; may take connections has not thereby been allowed to open them, and one\n  ;; that may read a connection has not been allowed to write into it.\n  ;;\n  ;; A BROKER. The sockets are the kexe loader's SUPERVISOR's (amu\n  ;; tools/kexe_loader.c); the guest's sandbox (Linux seccomp, macOS\n  ;; Seatbelt) is NOT widened -- the guest writes a request on a pipe and\n  ;; reads the answer, as :process/spawn 20 and :gpu/compute 42 do. Every\n  ;; decision on the way (request grammar, address scope, handle range,\n  ;; bounds, refusal names) is amu tools/kexe_loader_decisions.kotoba.\n  ;;\n  ;; `:string -> :string`. Handles are decimal 1..16, issued per execution\n  ;; by the broker, shared by listeners and connections. An ENVIRONMENTAL\n  ;; outcome is an answer word no handle, hex or count can spell (\"timeout\",\n  ;; \"refused\", \"unreachable\", \"reset\", \"closed\"); a GUEST BUG -- a malformed\n  ;; request, a handle out of range or not open, an address the grant does\n  ;; not name, a bound exceeded -- is refused BY NAME (trap, exit\n  ;; :capability/refused), never answered with something that looks like\n  ;; data. Timeouts are 0..30000 ms (the loader's wall budget still bounds\n  ;; the run); a read answers at most 16,384 bytes and a write takes at most\n  ;; 16,384. Only IPv4 dotted-quad addresses. The static Linux image carries\n  ;; no handler for these wires and refuses them at packaging, by name.\n  :net/listen\n  {:source-operation net/listen :effect :net/listen :compiler-wire-id 43\n   :kotoba.security/classification :confidential\n   :source-status :friendly-qualified\n   :request \"<ipv4>:<port>\"\n   :answer \"<listener-handle>\"\n   :grant {:scope \"exact <ipv4>:<port> entries; kexe loader: KEXE_CAP_RESOURCES_43, comma-separated\"}\n   :refusals {:trap \"KEXE_TRAP {:kind :capability :capability :net/listen :reason :net/<name>}\"\n              :exit :capability/refused\n              :names [:malformed-request :address-not-granted :handle-budget\n                      :listen-failed :setup-failed]}\n   :answered-by #{:kexe-loader}}\n  :net/accept\n  {:source-operation net/accept :effect :net/accept :compiler-wire-id 44\n   :kotoba.security/classification :confidential\n   :source-status :friendly-qualified\n   :request \"<listener-handle> <timeout-ms>\"\n   :answer \"<connection-handle> | timeout\"\n   :refusals {:trap \"KEXE_TRAP {:kind :capability :capability :net/accept :reason :net/<name>}\"\n              :exit :capability/refused\n              :names [:malformed-request :handle-out-of-range :handle-not-open\n                      :handle-budget :timeout-budget :setup-failed]}\n   :answered-by #{:kexe-loader}}\n  :net/dial\n  {:source-operation net/dial :effect :net/dial :compiler-wire-id 45\n   :kotoba.security/classification :confidential\n   :source-status :friendly-qualified\n   :request \"<ipv4>:<port> <timeout-ms>\"\n   :answer \"<connection-handle> | timeout | refused | unreachable\"\n   :grant {:scope \"exact <ipv4>:<port> entries; kexe loader: KEXE_CAP_RESOURCES_45, comma-separated\"}\n   :refusals {:trap \"KEXE_TRAP {:kind :capability :capability :net/dial :reason :net/<name>}\"\n              :exit :capability/refused\n              :names [:malformed-request :address-not-granted :handle-budget\n                      :timeout-budget :setup-failed]}\n   :answered-by #{:kexe-loader}}\n  :net/read\n  {:source-operation net/read :effect :net/read :compiler-wire-id 46\n   :kotoba.security/classification :confidential\n   :source-status :friendly-qualified\n   :request \"<connection-handle> <max-bytes 1..16384> <timeout-ms>\"\n   :answer \"the bytes read as lowercase hex, \\\"\\\" at end of stream | timeout | reset\"\n   :refusals {:trap \"KEXE_TRAP {:kind :capability :capability :net/read :reason :net/<name>}\"\n              :exit :capability/refused\n              :names [:malformed-request :handle-out-of-range :handle-not-open\n                      :byte-budget :timeout-budget]}\n   :answered-by #{:kexe-loader}}\n  :net/write\n  {:source-operation net/write :effect :net/write :compiler-wire-id 47\n   :kotoba.security/classification :confidential\n   :source-status :friendly-qualified\n   :request \"<connection-handle> <lowercase hex, 1..16384 bytes>; or \\\"<connection-handle>\\\" alone, which closes it\"\n   :answer \"<bytes-written> | reset; closed for the close form\"\n   :refusals {:trap \"KEXE_TRAP {:kind :capability :capability :net/write :reason :net/<name>}\"\n              :exit :capability/refused\n              :names [:malformed-request :handle-out-of-range :handle-not-open\n                      :byte-budget]}\n   :answered-by #{:kexe-loader}}}\n :invariants\n [:semantic-name-is-qualified-keyword\n  :source-operation-is-qualified-symbol\n  :wire-id-is-unique-and-stable\n  :effect-is-semantic-not-authority\n  :effect-declares-a-classification-the-one-lattice-can-rank\n  :host-revalidates-target-operation-quota-deadline-revocation-and-receipt]}\n")

(defn- text-2
  "resources/kotoba/lang/provider-conformance-v1.edn"
  [] :string
  "{:kotoba.provider-conformance/format :v1\n :invariants [:registered-name-and-id\n              :exact-provider-map\n              :bounded-request-type\n              :bounded-result-type\n              :deny-by-default-runtime\n              :validate-request-before-provider\n              :validate-result-after-provider]\n :kits\n [{:name :state :version 1\n   :resource \"kotoba/lang/capability-kits/state-v1.edn\"\n   :capabilities [{:name :state/transact :id 8}]}\n  {:name :ui :version 1\n   :resource \"kotoba/lang/capability-kits/ui-v1.edn\"\n   :capabilities [{:name :ui/commit :id 9} {:name :ui/next-event :id 10}]}\n  {:name :http :version 1\n   :resource \"kotoba/lang/capability-kits/http-v1.edn\"\n   :capabilities [{:name :http/post :id 4}]}\n  {:name :llm :version 1\n   :resource \"kotoba/lang/capability-kits/llm-v1.edn\"\n   :capabilities [{:name :llm/generate :id 11}]}\n  {:name :storage :version 1\n   :resource \"kotoba/lang/capability-kits/storage-v1.edn\"\n   :capabilities [{:name :storage/transact :id 12}]}\n  {:name :clock :version 1\n   :resource \"kotoba/lang/capability-kits/clock-v1.edn\"\n   :capabilities [{:name :clock/now :id 7}]}\n  {:name :log :version 1\n   :resource \"kotoba/lang/capability-kits/log-v1.edn\"\n   :capabilities [{:name :log/read :id 5} {:name :log/append :id 6}]}\n  {:name :dataspace :version 1\n   :resource \"kotoba/lang/capability-kits/dataspace-v1.edn\"\n   :capabilities [{:name :dataspace/transact :id 24}]}\n  ;; net/datagram, link/frame, can/frame (2026-08-30): providers are\n  ;; kotoba.compiler.support.{net-datagram,link-frame,can-frame}-provider\n  ;; in THIS repository's own test tree, not the production `provider.*`\n  ;; package (kotoba-lang/provider) the other 8 kits above use -- see\n  ;; test/kotoba/compiler/support/net_datagram_provider.cljk's docstring.\n  {:name :datagram :version 1\n   :resource \"kotoba/lang/capability-kits/datagram-v1.edn\"\n   :capabilities [{:name :net/datagram :id 27}]}\n  {:name :link-frame :version 1\n   :resource \"kotoba/lang/capability-kits/link-frame-v1.edn\"\n   :capabilities [{:name :link/frame :id 28}]}\n  {:name :can-frame :version 1\n   :resource \"kotoba/lang/capability-kits/can-frame-v1.edn\"\n   :capabilities [{:name :can/frame :id 29}]}]}\n")

(defn resource-text
  "The embedded text of `path`, or nil (none) for a path not embedded."
  [path :string] [:option :string]
  (cond
    (string=? path "kotoba/lang/backend-provider-qualification-v2.edn")
    (option-some-of [:option :string] (text-0))
    (string=? path "kotoba/lang/capability-catalog.edn")
    (option-some-of [:option :string] (text-1))
    (string=? path "kotoba/lang/provider-conformance-v1.edn")
    (option-some-of [:option :string] (text-2))
    :else (option-none-of [:option :string])))
