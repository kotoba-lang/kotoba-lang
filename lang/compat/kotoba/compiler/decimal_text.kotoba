(ns kotoba.compiler.decimal-text
  "Decimal integer text, read -- pure, with one leaf per host primitive
  (superproject adr-2609242330 section 1 (b)). The compiler reads decimals
  from the wire answers of its abilities (STAT fields, exit statuses);
  Kotoba has no integer-parse builtin (only decimal-f64-parse), and nbb's
  parse-long is not Kotoba, so the algorithm is written once here.

    decimal?  an optional `-` and then 1..18 ASCII digits
    parse     the value of a `decimal?` TEXT (0 for any other text)
    fields    the space-separated decimals of TEXT (a STAT / NOFOLLOW /
              OWNER answer), [] for the empty answer"
  {:kotoba/export [decimal? fields parse]})

;; ---- leaves ----

(defn- len [s :string] :i64
  (string-byte-length s))

(defn- byte-is? [s :string i :i64 b :i64] :bool
  (= i (string-find-byte s b i)))

(defn- next-space
  "The offset of the first space at or after FROM, or -1."
  [s :string from :i64] :i64
  (string-find-byte s 32 from))

(defn- cut [s :string start :i64 end :i64] :string
  (string-substring s start end))

(defn- push [v :vector-i64 x :i64] :vector-i64
  (vector-conj v x))

;; ---- the algorithm ----

(defn- digit-at
  "The digit at offset I of S, or -1."
  [s :string i :i64] :i64
  (loop [d 0]
    (if (> d 9)
      -1
      (if (byte-is? s i (+ 48 d)) d (recur (inc d))))))

(defn- start [s :string] :i64
  (if (and (> (len s) 0) (byte-is? s 0 45)) 1 0))

(defn decimal? [s :string] :bool
  (let [from (start s)
        n (len s)]
    (and (> n from)
         (<= (- n from) 18)
         (loop [i from]
           (if (>= i n)
             true
             (if (< (digit-at s i) 0) false (recur (inc i))))))))

(defn parse [s :string] :i64
  (if (decimal? s)
    (let [from (start s)
          n (len s)
          magnitude (loop [i from acc 0]
                      (if (>= i n) acc (recur (inc i) (+ (* acc 10) (digit-at s i)))))]
      (if (= from 1) (- 0 magnitude) magnitude))
    0))

(defn fields [s :string] :vector-i64
  (let [n (len s)]
    (loop [i 0 acc (vector-i64)]
      (if (>= i n)
        acc
        (let [j (next-space s i)]
          (if (< j 0)
            (push acc (parse (cut s i n)))
            (recur (inc j) (push acc (parse (cut s i j))))))))))
