(ns kotoba.compiler.project-files
  "Guest twin (the Kotoba reading) of amu src/kotoba/compiler/project_files.cljk: the transitive closure of a
  multi-module guest from explicit source roots, read through wire 35 (:fs/app-data). Same rules and sentences as the
  host: per-root extension priority (.kotoba, .cljk, .cljc), cross-root ambiguity refused except one .kotoba standing
  in for .cljk/.cljc twins, containment of every discovered path segment-wise under a source root, declared namespace
  = required namespace, one file per namespace, `max-project-modules`. Owner: agent WALL2 (2026-10-04).

  Named difference: the guest has no realpath. A path is normalised as TEXT (`.`, `..`, repeated `/`), so a symlink
  inside a source root that points outside it is not detected here; the loader's own wire-35 scope (which IS
  realpath-checked) still refuses any read outside the granted directories. A relative path is resolved against
  nothing: the caller passes absolute paths (bin/amu resolves against its cwd), and a relative one is refused as not
  readable."
  {:kotoba/export [load-closed-graph]}
  (:require [kotoba.form :as form]
            [kotoba.sema :as sema]
            [kotoba.compiler.frontend.base :as base]
            [kotoba.compiler.project :as project])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                       [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
             :fe/err [:record :fe/err [[:msg :string] [:code :string] [:form [:ref :form/r]] [:phase :string] [:data [:ref :form/r]]]]
             :pf/st [:record :pf/st [[:sources [:ref :form/r]] [:paths [:ref :form/r]] [:roots [:list :string]]]]}))

(defn- g [m [:ref :form/r] x :keyword] [:ref :form/r] (base/fget m x))
(defn- p [m [:ref :form/r] x :keyword v [:ref :form/r]] [:ref :form/r] (base/fput m x v))
(defn- emptym [] [:ref :form/r] (form/form-map (form/no-forms)))
(defn- m1 [k1 :keyword v1 [:ref :form/r]] [:ref :form/r] (p (emptym) k1 v1))

(defn- fail [msg :string data [:ref :form/r]] :i64
  (throw (record-new [:ref :fe/err] msg "" (form/nil-form) "project-link" (p data :phase (form/keyword-form :project-link)))))

(defn- need [ok :bool msg :string data [:ref :form/r]] :i64 (if ok 0 (fail msg data)))

(defn- sep [w :string] :string (string-concat w "_SEP"))

(defn- starts-with? [s :string prefix :string] :bool
  (and (>= (string-byte-length s) (string-byte-length prefix))
       (string=? (string-substring s 0 (string-byte-length prefix)) prefix)))

(defn- ends-with? [s :string suffix :string] :bool
  (let [n (string-byte-length s) k (string-byte-length suffix)]
    (and (>= n k) (string=? (string-substring s (- n k) n) suffix))))

;; ---- paths as text

(defn- segments [s :string i :i64 start :i64 acc [:list :string]] [:list :string]
  (let [n (string-byte-length s)]
    (if (>= i n)
      (typed-list-conj [:list :string] acc (string-substring s start n))
      (if (= 47 (string-code-point-at s i))
        (segments s (+ i 1) (+ i 1) (typed-list-conj [:list :string] acc (string-substring s start i)))
        (segments s (+ i 1) start acc)))))

(defn- drop-last-seg [acc [:list :string] i :i64 out [:list :string]] [:list :string]
  (if (>= i (- (vector-count acc) 1)) out (drop-last-seg acc (+ i 1) (typed-list-conj [:list :string] out (typed-list-nth [:list :string] acc i)))))

(defn- normal-segs [segs [:list :string] i :i64 acc [:list :string]] [:list :string]
  (if (>= i (vector-count segs))
    acc
    (let [s (typed-list-nth [:list :string] segs i)]
      (normal-segs segs (+ i 1)
        (cond (or (string=? s "") (string=? s ".")) acc
              (string=? s "..") (if (> (vector-count acc) 0) (drop-last-seg acc 0 (typed-list-new [:list :string])) acc)
              :else (typed-list-conj [:list :string] acc s))))))

(defn- join-segs [segs [:list :string] i :i64 acc :string] :string
  (if (>= i (vector-count segs)) acc (join-segs segs (+ i 1) (string-concat acc (string-concat "/" (typed-list-nth [:list :string] segs i))))))

;; the absolute path P with `.`, `..` and repeated separators removed ("/" for the root)
(defn- normalize [path :string] :string
  (let [j (join-segs (normal-segs (segments path 0 0 (typed-list-new [:list :string])) 0 (typed-list-new [:list :string])) 0 "")]
    (if (= 0 (string-byte-length j)) "/" j)))

(defn- exists? [path :string] :bool
  (let [a (typed-cap-call :fs/app-data :string :string (string-concat path (sep "EXISTS")))]
    (and (> (string-byte-length a) 0) (= 49 (string-code-point-at a 0)))))

;; STAT: "<mode> <size> <blocks> <isdir>", empty when it cannot be stat'ed
(defn- stat-isdir [path :string] :i64
  (let [a (typed-cap-call :fs/app-data :string :string (string-concat path (sep "STAT")))
        n (string-byte-length a)]
    (cond (= n 0) -1
          (= 49 (string-code-point-at a (- n 1))) 1
          :else 0)))

(defn- directory? [path :string] :bool (= 1 (stat-isdir path)))
(defn- regular-file? [path :string] :bool (and (= 0 (stat-isdir path)) (exists? path)))

(defn- real-path [value :string] :string
  (let [ok (need (and (starts-with? value "/") (>= (stat-isdir (normalize value)) 0)) "project path is not readable" (emptym))]
    (normalize value)))

(defn- under-root? [candidate :string root :string] :bool
  (or (string=? candidate root)
      (starts-with? candidate (if (string=? root "/") "/" (string-concat root "/")))))

(defn- under-any? [candidate :string roots [:list :string] i :i64] :bool
  (if (>= i (vector-count roots))
    false
    (if (under-root? candidate (typed-list-nth [:list :string] roots i)) true (under-any? candidate roots (+ i 1)))))

;; ---- namespace -> file

(defn- relative-from [s :string i :i64 acc :string] :string
  (if (>= i (string-byte-length s))
    acc
    (let [c (string-code-point-at s i)]
      (relative-from s (+ i 1) (string-concat acc (cond (= c 46) "/" (= c 45) "_" :else (string-substring s i (+ i 1))))))))

(defn- namespace-relative [ns [:ref :form/r]] :string (relative-from (form/symbol-value ns) 0 ""))

(defn- ext [i :i64] :string (cond (= i 0) ".kotoba" (= i 1) ".cljk" :else ".cljc"))

(defn- first-in-root [root :string relative :string i :i64] :string
  (if (>= i 3)
    ""
    (let [c (string-concat root (string-concat "/" (string-concat relative (ext i))))]
      (if (regular-file? c) c (first-in-root root relative (+ i 1))))))

(defn- existing [roots [:list :string] relative :string i :i64 acc [:list :string]] [:list :string]
  (if (>= i (vector-count roots))
    acc
    (let [f (first-in-root (typed-list-nth [:list :string] roots i) relative 0)]
      (existing roots relative (+ i 1) (if (> (string-byte-length f) 0) (typed-list-conj [:list :string] acc f) acc)))))

(defn- guest-native [xs [:list :string] i :i64 acc [:list :string]] [:list :string]
  (if (>= i (vector-count xs))
    acc
    (guest-native xs (+ i 1) (if (ends-with? (typed-list-nth [:list :string] xs i) ".kotoba") (typed-list-conj [:list :string] acc (typed-list-nth [:list :string] xs i)) acc))))

(defn- module-path [roots [:list :string] ns [:ref :form/r]] :string
  (let [found (existing roots (namespace-relative ns) 0 (typed-list-new [:list :string]))
        n (vector-count found)
        ok (need (> n 0) (string-concat "required module " (string-concat (form/symbol-value ns) " is missing from the explicit source paths"))
                 (m1 :module ns))]
    (if (= n 1)
      (typed-list-nth [:list :string] found 0)
      (let [g2 (guest-native found 0 (typed-list-new [:list :string]))
            ok2 (need (= 1 (vector-count g2)) "namespace resolves from multiple explicit source paths" (m1 :module ns))]
        (typed-list-nth [:list :string] g2 0)))))

(defn- attributed? [e [:ref :fe/err]] :bool
  (let [d (record-get [:ref :fe/err] e :data)] (and (form/is-map? d) (form/form-has? d (form/keyword-form :source-module)))))

(defn- module-info-attributed [source :string real :string expected [:ref :form/r]] [:ref :form/r]
  (try (project/module-info (sema/read-forms source))
       (catch [:ref :fe/err] e
         (throw (if (attributed? e)
                  e
                  (let [d0 (record-get [:ref :fe/err] e :data)
                        d (if (form/is-map? d0) d0 (emptym))
                        who (if (form/is-nil? expected) (g d :namespace) expected)
                        d1 (p d :source-file (form/string-form real))]
                    (record-assoc [:ref :fe/err] e :data (if (form/is-nil? who) d1 (p d1 :source-module who)))))))))

(defn- st [sources [:ref :form/r] paths [:ref :form/r] roots [:list :string]] [:ref :pf/st] (record-new [:ref :pf/st] sources paths roots))

(defn- visit [file :string expected [:ref :form/r] s [:ref :pf/st]] [:ref :pf/st]
  (let [real (real-path file)
        roots (record-get [:ref :pf/st] s :roots)
        ok (need (or (form/is-nil? expected) (under-any? real roots 0)) "project module escapes the explicit source paths" (m1 :module expected))
        source (typed-cap-call :fs/app-data :string :string real)
        info (module-info-attributed source real expected)
        declared (g info :namespace)
        ok2 (need (or (form/is-nil? expected) (form/eq expected declared)) "resolved path namespace does not match requirement"
                  (p (m1 :module expected) :declared declared))
        previous (form/form-get (record-get [:ref :pf/st] s :paths) declared)
        ok3 (need (or (form/is-nil? previous) (string=? (form/string-value previous) real)) "namespace resolves to multiple project files"
                  (m1 :module declared))
        sources (record-get [:ref :pf/st] s :sources)]
    (if (form/form-has? sources declared)
      s
      (let [ok4 (need (< (quot (form/count-of sources) 2) (project/max-project-modules)) "project module count exceeds limit"
                      (m1 :limit (form/int-form (project/max-project-modules))))
            s1 (st (form/assoc-form sources declared (form/string-form source))
                   (form/assoc-form (record-get [:ref :pf/st] s :paths) declared (form/string-form real))
                   roots)]
        (visit-requires (g info :requires) 0 s1)))))

(defn- visit-requires [requires [:ref :form/r] i :i64 s [:ref :pf/st]] [:ref :pf/st]
  (if (>= i (form/count-of requires))
    s
    (let [dep (g (form/nth-of requires i) :namespace)]
      (visit-requires requires (+ i 1) (visit (module-path (record-get [:ref :pf/st] s :roots) dep) dep s)))))

(defn- real-roots [paths [:list :string] i :i64 acc [:list :string]] [:list :string]
  (if (>= i (vector-count paths)) acc (real-roots paths (+ i 1) (typed-list-conj [:list :string] acc (real-path (typed-list-nth [:list :string] paths i))))))

(defn- check-dirs [roots [:list :string] i :i64] :i64
  (if (>= i (vector-count roots))
    0
    (let [ok (need (directory? (typed-list-nth [:list :string] roots i)) "source path must be a readable directory" (emptym))]
      (check-dirs roots (+ i 1)))))

;; the paths map in sorted order of the namespace text (`(into (sorted-map) ..)`)
(defn- insert-entry [ks [:list [:ref :form/r]] k [:ref :form/r] i :i64 out [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (vector-count ks))
    (form/append-form out k)
    (let [x (typed-list-nth [:list [:ref :form/r]] ks i)]
      (if (> (string-compare (form/symbol-value x) (form/symbol-value k)) 0)
        (form/append-many (form/append-form out k) (rest-from ks i (form/no-forms)))
        (insert-entry ks k (+ i 1) (form/append-form out x))))))

(defn- rest-from [ks [:list [:ref :form/r]] i :i64 out [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (vector-count ks)) out (rest-from ks (+ i 1) (form/append-form out (typed-list-nth [:list [:ref :form/r]] ks i)))))

(defn- sorted-keys [m [:ref :form/r] j :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= (+ j 1) (form/count-of m)) acc (sorted-keys m (+ j 2) (insert-entry acc (form/nth-of m j) 0 (form/no-forms)))))

(defn- sorted-map-of [m [:ref :form/r] ks [:list [:ref :form/r]] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (vector-count ks))
    acc
    (let [k (typed-list-nth [:list [:ref :form/r]] ks i)]
      (sorted-map-of m ks (+ i 1) (form/assoc-form acc k (form/form-get m k))))))

(defn load-closed-graph
  "The transitive closure rooted at INPUT (an absolute path) from explicit SOURCE-PATHS (absolute directories):
  {:sources {ns text} :root ns :paths {ns path}} (project_files.cljk `load-closed-graph`)."
  [input :string source-paths [:list :string]] [:ref :form/r]
  (let [roots (real-roots source-paths 0 (typed-list-new [:list :string]))
        root-path (real-path input)
        ok (need (> (vector-count roots) 0) "at least one source path is required" (emptym))
        ok2 (check-dirs roots 0)
        s0 (st (emptym) (emptym) roots)
        s (visit root-path (form/nil-form) s0)
        paths (record-get [:ref :pf/st] s :paths)]
    (p (p (m1 :sources (record-get [:ref :pf/st] s :sources)) :root (form/nth-of (record-get [:ref :pf/st] s :sources) 0))
       :paths (sorted-map-of paths (sorted-keys paths 0 (form/no-forms)) 0 (emptym)))))
