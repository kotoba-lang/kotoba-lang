(ns kotoba.compiler.project-files
  
  "Resolve the transitive closure of a multi-module guest from explicit source
  roots. One namespace on both compiler hosts since 2026-09-11 (ADR 0348
  iteration 3); until then it was a JVM file and a Node twin
  (`kotoba.compiler.nbb.project-files`) kept identical by hand.

  What the path resolver is FOR, rather than incidental behaviour, and so
  what the two hosts share verbatim:

  - Extension priority (`.kotoba`, `.cljk`, `.cljc`) is local to ONE root. The
    same namespace present under two explicit roots is ambiguous and rejected;
    it must never be settled by argument order.
  - One exception, settled by KIND and not by order (2026-09-12, adr-2609111900):
    a `.kotoba` module in one root stands in for a `.cljk` / `.cljc` of the
    same namespace in another. A dual-runtime source is what the HOST runtime
    loads through its own classpath; the guest-native twin beside it on the
    project route is the module the guest route was always going to link --
    the same priority this loader already applies within one root, carried
    across roots. `kotoba-lang/lang/compat/kotoba/lang/text.kotoba` shadowing
    `text/src/kotoba/lang/text.cljk` is the case it exists for. Two `.kotoba`
    or two `.cljk` in two roots are still ambiguous and still refused, in
    either argument order.
  - Every discovered path is resolved through the real path before use, and
    must lie under one of the source roots. The root module is exempt because
    it was named explicitly rather than discovered by namespace.
  - The declared namespace must equal the one that was required, and one
    namespace may not resolve to two files.

  Containment is compared segment-wise on both hosts -- `java.nio.file.Path`'s
  `startsWith` on the JVM, an explicit separator check on Node. A raw string
  prefix would accept `/src-evil` as living under `/src`, which is the whole
  class of bug this check exists to stop, and it would do so silently."
  {:kotoba/export [load-closed-graph]}
  
    (:require [kotoba.lang.text :as str] [kotoba.sema :as sema] [kotoba.compiler.project :as project])
)

(def ^:private extensions [".kotoba" ".cljk" ".cljc"])

(defn- reject! [message data]
  (throw (ex-info message (assoc data :phase :project-link))))

;; ── host seams ─────────────────────────────────────────────────────────────

(defn- real-path [value]
  (try
    
    (catch  _
      (reject! "project path is not readable" {}))))

(defn- directory? [p]
  )

(defn- regular-file? [p]
  )

(defn- under-root?
  "Segment-wise containment."
  [candidate root]
  )

(defn- resolve-under [root relative]
  )

(defn- read-source [real]
  )

;; ── the contract ───────────────────────────────────────────────────────────

(defn- namespace-relative [namespace]
  (-> (str namespace) (str/replace "." "/") (str/replace "-" "_")))

(defn- module-path [source-roots namespace]
  (let [relative (namespace-relative namespace)
        existing (keep (fn [source-root]
                         ;; Extension priority remains local to one package
                         ;; root. The same namespace in two explicit roots is
                         ;; ambiguous and must never be shadowed by argument
                         ;; order.
                         (first (filter regular-file?
                                        (map #(resolve-under source-root (str relative %))
                                             extensions))))
                       source-roots)]
    (cond
      (empty? existing)
      ;; The sentence carries the NAME. Measured 2026-09-12 (adr-2609111900,
      ;; measurement 14): 28 of the compiler's own 225 modules were refused
      ;; with this sentence and the histogram could not say which module
      ;; was missing -- the name was in ex-data, and the CLI report keeps
      ;; only the message. A refusal that does not say what is missing
      ;; cannot be acted on from the outside.
      (reject! (str "required module " namespace " is missing from the explicit source paths")
               {:module namespace})
      (= (count existing) 1)
      (first existing)
      :else
      ;; Across roots, exactly one guest-native `.kotoba` stands in for any
      ;; number of dual-runtime `.cljk` / `.cljc` twins; anything else is the
      ;; ambiguity the docstring refuses.
      (let [guest-native (filterv #(str/ends-with? (str %) ".kotoba") existing)]
        (if (= 1 (count guest-native))
          (first guest-native)
          (reject! (str "namespace " namespace " resolves from multiple explicit source paths: "
                        (str/join ", " (map str existing)))
                   {:module namespace
                    :candidates (mapv str existing)
                    :guest-native (mapv str guest-native)}))))))

;; A refusal raised while parsing one module's header (a string host import,
;; a malformed :require, an unknown clause) is that module's refusal, not the
;; root's. Without `:source-module` / `:source-file` the CLI's `:source` fell
;; back to the ROOT file the caller named, so the selfhost scoreboard counted
;; one module's wall once per importer (superproject adr-2609242330 S5,
;; 2026-09-25: 20 reachable "string host module" rows traced to fewer
;; modules). The module is the namespace that was required (`expected`), or
;; for the root, the namespace the header itself declares when it parsed that
;; far (`:namespace` in the refusal's data).
(defn- module-info-attributed [source real expected]
  (try
    (project/module-info (sema/read-forms source))
    (catch  error
      (let [data (ex-data error)]
        (if (or (not (map? data)) (contains? data :source-module))
          (throw error)
          (throw (ex-info (ex-message error)
                          (cond-> (assoc data :source-file (str real))
                            (some? (or expected (:namespace data)))
                            (assoc :source-module (or expected (:namespace data))))
                          error)))))))

(defn load-closed-graph
  "Load only the transitive closure rooted at input from explicit source
  directories. The explicitly selected root may live beside those directories;
  dependency real-path checks reject symlink escape and cross-root namespace
  ambiguity. project/link-source owns the aggregate graph and source bounds."
  [input source-paths]
  (let [source-roots (mapv real-path (if (sequential? source-paths)
                                       source-paths [source-paths]))
        root-path (real-path input)]
    (when (empty? source-roots)
      (reject! "at least one source path is required" {}))
    (doseq [source-root source-roots]
      (when-not (directory? source-root)
        (reject! "source path must be a readable directory" {})))
    (let [sources (volatile! {})
          paths (volatile! {})]
      (letfn [(visit [file expected]
                (let [real (real-path file)]
                  ;; The root is explicitly selected, not discovered by
                  ;; namespace. Only discovered dependencies are confined.
                  (when (and expected
                             (not-any? #(under-root? real %) source-roots))
                    (reject! "project module escapes the explicit source paths"
                             {:module expected}))
                  (let [source (read-source real)
                        info (module-info-attributed source real expected)
                        declared (:namespace info)]
                    (when (and expected (not= expected declared))
                      (reject! "resolved path namespace does not match requirement"
                               {:module expected :declared declared}))
                    (when-let [previous (get @paths declared)]
                      (when-not (= previous real)
                        (reject! "namespace resolves to multiple project files"
                                 {:module declared})))
                    (when-not (contains? @sources declared)
                      (when (>= (count @sources) project/max-project-modules)
                        (reject! "project module count exceeds limit"
                                 {:limit project/max-project-modules}))
                      (vswap! sources assoc declared source)
                      (vswap! paths assoc declared real)
                      (doseq [{dependency :namespace} ]
                        (visit (module-path source-roots dependency) dependency)))
                    declared)))]
        (let [root-namespace (visit root-path nil)]
          {:sources @sources :root root-namespace
           :paths (into (sorted-map) (map (fn [[k v]] [k (str v)])) @paths)})))))
