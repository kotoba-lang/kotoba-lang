(ns kotoba.compiler.posix-path
  "POSIX path strings, computed -- node:path's posix `basename` / `dirname` /
  `join` / `normalize`, the algorithm and not a call.

  superproject adr-2609242330 section 1 (b): joining and splitting a path
  string observes nothing and changes nothing, so it is a pure function and
  not an fs ability. The compiler used node:path for these four; this module
  answers the same strings (scripts/test-posix-path.cljk compares it with
  node:path over the compiler's own paths and a seeded random corpus).

  Why not kotoba.lang.fs: its `join` does not resolve `.` / `..` and drops a
  trailing slash, and its `basename` of \"/a/b/\" differs -- the compiler's
  output paths and diagnostics are spelled by node:path today, and a path
  written differently is a different artifact location.

  Only `/` is a separator. The path is read as its SEGMENTS -- the
  non-empty runs between slashes, found by a forward search for the next
  `/` -- and every offset the algorithm ever holds is 0, the length, a
  slash, or one past a slash. That is why the leaves below may count in
  different units per host -- bytes under Kotoba, UTF-16 units under
  ClojureScript -- and give the same answer, and why no offset ever falls
  inside a UTF-8 sequence (a Kotoba string refuses such an offset by name).
  Run under the KIR reference interpreter and under nbb against node:path:
  test/nbb/host_abilities.cljk."
  {:kotoba/export [basename dirname join normalize]})

;; ---- leaves: the only host-specific lines, one per primitive ----

(defn- len [s :string] :i64
  (string-byte-length s))

(defn- next-slash
  "The offset of the first `/` at or after FROM, or -1."
  [s :string from :i64] :i64
  (string-find-byte s 47 from))

(defn- dot-at? [s :string i :i64] :bool
  (= i (string-find-byte s 46 i)))

(defn- cut [s :string start :i64 end :i64] :string
  (string-substring s start end))

(defn- cat2 [a :string b :string] :string
  (string-concat a b))

(defn- push [v :vector-i64 x :i64] :vector-i64
  (vector-conj v x))

;; ---- segments ----

(defn- segments
  "P's non-empty segments as a flat vector [start0 end0 start1 end1 ...].
  Kotoba's loop-result inference types a loop EXIT written `(conj v x)` as
  i64 (`expected vector-i64, got i64`, measured 2026-09-25); `push` is
  `vector-conj` there and `conj` on nbb."
  [p :string] :vector-i64
  (let [n (len p)]
    (loop [i 0 j (next-slash p 0) acc (vector-i64)]
      (if (>= i n)
        acc
        (if (< j 0)
          (push (push acc i) n)
          (if (> j i)
            (recur (inc j) (next-slash p (inc j)) (push (push acc i) j))
            (recur (inc j) (next-slash p (inc j)) acc)))))))

(defn- slash-first? [p :string] :bool
  (and (> (len p) 0) (= 0 (next-slash p 0))))

(defn- slash-last? [p :string] :bool
  (let [n (len p)]
    (and (> n 0)
         (let [segs (segments p)]
           (or (= 0 (count segs))
               (< (nth segs (- (count segs) 1)) n))))))

;; ---- node:path posix, lib/path.js ----

(defn basename
  "The last segment of P, trailing slashes ignored; \"\" for \"\" and \"/\"."
  [p :string] :string
  (let [segs (segments p)
        k (count segs)]
    (if (= 0 k)
      ""
      (cut p (nth segs (- k 2)) (nth segs (- k 1))))))

(defn dirname
  "Everything before the slash that precedes the last segment of P: \".\"
  when there is none, \"/\" for a root child, \"//\" for the one node:path
  spelling of that."
  [p :string] :string
  (if (= 0 (len p))
    "."
    (let [root? (slash-first? p)
          segs (segments p)
          k (count segs)
          end (if (= 0 k) -1 (- (nth segs (- k 2)) 1))]
      (cond
        (< end 1) (if root? "/" ".")
        (and root? (= end 1)) "//"
        :else (cut p 0 end)))))

(defn- dot-segment? [p start end]
  (and (= 1 (- end start)) (dot-at? p start)))

(defn- dot-dot-segment? [p start end]
  (and (= 2 (- end start)) (dot-at? p start) (dot-at? p (+ start 1))))

(defn- poppable?
  "STACK's top segment exists and is not itself `..`."
  [p :string stack :vector-i64] :bool
  (and (> (count stack) 0)
       (not (dot-dot-segment? p (nth stack (- (count stack) 2)) (nth stack (- (count stack) 1))))))

(defn- resolved-segments
  "node:path normalizeString over P's segments, as a stack of [start end]
  pairs: `.` is dropped, `..` pops a segment that is not itself `..`, and is
  kept when nothing can be popped and ABOVE-ROOT allows it."
  [p :string above-root :bool] :vector-i64
  (let [segs (segments p)
        k (count segs)]
    (loop [i 0 stack (vector-i64)]
      (if (>= i k)
        stack
        (if (dot-segment? p (nth segs i) (nth segs (+ i 1)))
          (recur (+ i 2) stack)
          (if (dot-dot-segment? p (nth segs i) (nth segs (+ i 1)))
            (if (poppable? p stack)
              (recur (+ i 2) (pop (pop stack)))
              (if above-root
                (recur (+ i 2) (push (push stack (nth segs i)) (nth segs (+ i 1))))
                (recur (+ i 2) stack)))
            (recur (+ i 2) (push (push stack (nth segs i)) (nth segs (+ i 1))))))))))

(defn- spell
  "The segments of STACK (offsets into P) joined by `/`."
  [p :string stack :vector-i64] :string
  (let [k (count stack)]
    (loop [i 0 out ""]
      (if (>= i k)
        out
        (recur (+ i 2)
               (if (= 0 i)
                 (cut p (nth stack i) (nth stack (+ i 1)))
                 (cat2 (cat2 out "/") (cut p (nth stack i) (nth stack (+ i 1))))))))))

(defn normalize
  "node:path posix normalize: resolve `.` / `..`, collapse repeated slashes,
  keep one trailing slash if P had one; \".\" for \"\"."
  [p :string] :string
  (if (= 0 (len p))
    "."
    (let [absolute? (slash-first? p)
          trailing? (slash-last? p)
          body (spell p (resolved-segments p (not absolute?)))
          spelled (cond
                    (and (= 0 (len body)) absolute?) ""
                    (= 0 (len body)) (if trailing? "./" ".")
                    trailing? (cat2 body "/")
                    :else body)]
      (cond
        (and absolute? (= 0 (len spelled))) "/"
        absolute? (cat2 "/" spelled)
        :else spelled))))

(defn join
  "node:path posix join of A and B: the non-empty parts joined by `/`, then
  normalized; \".\" when both are empty."
  [a :string b :string] :string
  (let [joined (cond (and (= 0 (len a)) (= 0 (len b))) ""
                     (= 0 (len a)) b
                     (= 0 (len b)) a
                     :else (cat2 (cat2 a "/") b))]
    (if (= 0 (len joined)) "." (normalize joined))))
