(ns kotoba.compiler.coverage-evidence
  {:kotoba/export [sign verify verify-bundle]}
  (:require [kotoba.form :as form]
                         [kotoba.verifier.seal :as seal]
            [kotoba.verifier :as verifier]
            [kotoba.verifier.signing :as signing] [kotoba.artifact.core :as artifact])
  ;; Kotoba: an envelope, a claim and a trust policy are the recursive `:form/r`
  ;; record of kotoba.form, hashed with kotoba.verifier.seal (a `:document` is
  ;; bounded to 32 items) and signed by the Form twin of kotoba.verifier.signing.
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]}))

nil
nil
nil
nil

nil

nil

nil

nil

nil

nil

;; ---------------------------------------------------------------------------
;; THE KOTOBA READING. Same checks, same order, over Forms. A host `throw`
;; (ex-info) is a TRAP here (`assert`): an export cannot abort with a value a
;; caller sees. `now` is an i64.

(defn- trap-form [] [:ref :form/r]
     (let [refused (assert (= 1 0))] (form/nil-form)))

(defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r]
     (form/form-get m (form/keyword-form k)))

(defn- has? [m [:ref :form/r] k :keyword] :bool
     (form/form-has? m (form/keyword-form k)))

(defn- put [m [:ref :form/r] k :keyword v [:ref :form/r]] [:ref :form/r]
     (form/assoc-form m (form/keyword-form k) v))

(defn- empty-map [] [:ref :form/r] (form/form-map (form/no-forms)))

(defn- member-from [xs [:list [:ref :form/r]] x [:ref :form/r] i :i64] :bool
     (if (>= i (vector-count xs))
       false
       (if (form/eq (typed-list-nth [:list [:ref :form/r]] xs i) x)
         true
         (member-from xs x (+ i 1)))))

(defn- member? [s [:ref :form/r] x [:ref :form/r]] :bool
     (member-from (form/kids-of s) x 0))

(defn- lower-hex? [c :i64] :bool
     (if (>= c 48) (if (<= c 57) true (if (>= c 97) (<= c 102) false)) false))

(defn- hex64-from [s :string i :i64] :bool
     (if (>= i 64)
       true
       (if (lower-hex? (string-code-point-at s i)) (hex64-from s (+ i 1)) false)))

(defn- sha256? [f [:ref :form/r]] :bool
     (if (form/is-string? f)
       (if (= 64 (string-byte-length (form/string-value f)))
         (hex64-from (form/string-value f) 0)
         false)
       false))

;; every kid satisfies: 0 keyword, 1 native-or-wasm keyword
(defn- all-kids-from [xs [:list [:ref :form/r]] mode :i64 i :i64] :bool
     (if (>= i (vector-count xs))
       true
       (let [f (typed-list-nth [:list [:ref :form/r]] xs i)
             ok (if (= mode 0)
                  (form/is-keyword? f)
                  (if (form/is-keyword? f)
                    (or (= :native (form/keyword-value f)) (= :wasm (form/keyword-value f)))
                    false))]
         (if ok (all-kids-from xs mode (+ i 1)) false))))

(defn- nonempty-set-of? [f [:ref :form/r] mode :i64] :bool
     (if (form/is-set? f)
       (if (> (form/count-of f) 0) (all-kids-from (form/kids-of f) mode 0) false)
       false))

(defn- claim-shape? [claim [:ref :form/r]] :bool
     (if (form/is-map? claim)
       (if (= 16 (form/count-of claim))
         (if (has? claim :platform)
           (if (has? claim :paths)
             (if (has? claim :target-profiles)
               (if (has? claim :conformance-sha256)
                 (if (has? claim :runtime-sha256)
                   (if (has? claim :ci-run-url)
                     (if (has? claim :tested-at) (has? claim :expires) false)
                     false)
                   false)
                 false)
               false)
             false)
           false)
         false)
       false))

(defn- claim-times? [claim [:ref :form/r]] :bool
     (let [tested-at (fget claim :tested-at)
           expires (fget claim :expires)]
       (if (verifier/guest-integer? tested-at)
         (if (> (form/int-value tested-at) 0)
           (if (verifier/guest-integer? expires)
             (< (form/int-value tested-at) (form/int-value expires))
             false)
           false)
         false)))

(defn- valid-claim? [claim [:ref :form/r]] :bool
     (if (claim-shape? claim)
       (if (form/is-keyword? (fget claim :platform))
         (if (nonempty-set-of? (fget claim :paths) 1)
           (if (nonempty-set-of? (fget claim :target-profiles) 0)
             (if (sha256? (fget claim :conformance-sha256))
               (if (sha256? (fget claim :runtime-sha256))
                 (if (form/is-string? (fget claim :ci-run-url))
                   (if (>= (string-length (form/string-value (fget claim :ci-run-url))) 1)
                     (if (<= (string-length (form/string-value (fget claim :ci-run-url))) 2048)
                       (claim-times? claim)
                       false)
                     false)
                   false)
                 false)
               false)
             false)
           false)
         false)
       false))

(defn sign [claim [:ref :form/r] key [:ref :form/r]] [:ref :form/r]
     (if (valid-claim? claim)
       (if (signing/valid-key? key)
         (let [statement (put (put (put claim :format (form/keyword-form :kotoba.coverage-evidence-statement/v1))
                                   :signer (fget key :signer))
                              :public-key (fget key :public-key))]
           (put (put (put (empty-map) :format (form/keyword-form :kotoba.signed-coverage-evidence/v1))
                     :statement statement)
                :signature (form/string-form (signing/sign-value key statement))))
         (trap-form))
       (trap-form)))

;; the claim keys of a statement, as a map (`select-keys`: absent keys are left out)
(defn- pick [statement [:ref :form/r] m [:ref :form/r] k :keyword] [:ref :form/r]
     (if (has? statement k) (put m k (fget statement k)) m))

(defn- claim-of [statement [:ref :form/r]] [:ref :form/r]
     (pick (pick (pick (pick (pick (pick (pick (pick (pick (empty-map) statement :platform)
                                                    statement :paths)
                                               statement :target-profiles)
                                          statement :conformance-sha256)
                                     statement :runtime-sha256)
                                statement :ci-run-url)
                           statement :tested-at)
                      statement :expires)
                 statement :expires))

(defn- statement-shape? [statement [:ref :form/r]] :bool
     (if (form/is-map? statement)
       (if (= 22 (form/count-of statement))
         (if (has? statement :format)
           (if (has? statement :signer) (has? statement :public-key) false)
           false)
         false)
       false))

(defn- statement-ok? [statement [:ref :form/r] envelope [:ref :form/r]] :bool
     (if (statement-shape? statement)
       (if (form/eq (fget statement :format) (form/keyword-form :kotoba.coverage-evidence-statement/v1))
         (if (valid-claim? (claim-of statement))
           (if (form/is-string? (fget statement :public-key))
             (if (form/eq (fget statement :signer)
                          (form/string-form (signing/signer-id (form/string-value (fget statement :public-key)))))
               (form/is-string? (fget envelope :signature))
               false)
             false)
           false)
         false)
       false))

(defn- envelope-ok? [envelope [:ref :form/r]] :bool
     (if (form/is-map? envelope)
       (if (= 6 (form/count-of envelope))
         (if (has? envelope :format)
           (if (has? envelope :statement)
             (if (has? envelope :signature)
               (form/eq (fget envelope :format) (form/keyword-form :kotoba.signed-coverage-evidence/v1))
               false)
             false)
           false)
         false)
       false))

(defn- trusted-now? [trust [:ref :form/r] statement [:ref :form/r] digest [:ref :form/r] now :i64] :bool
     (let [signer (fget statement :signer)]
       (if (member? (fget trust :trusted-signers) signer)
         (if (member? (fget trust :revoked-signers) signer)
           false
           (if (member? (fget trust :revoked-artifacts) digest)
             false
             (if (< now (form/int-value (fget statement :tested-at)))
               false
               (< now (form/int-value (fget statement :expires))))))
         false)))

(defn- summary-of [statement [:ref :form/r] digest [:ref :form/r]] [:ref :form/r]
     (put (put (put (put (put (empty-map) :digest digest)
                         :platform (fget statement :platform))
                    :paths (fget statement :paths))
               :target-profiles (fget statement :target-profiles))
          :signer (fget statement :signer)))

(defn verify [envelope [:ref :form/r] trust [:ref :form/r] now :i64] [:ref :form/r]
     (if (envelope-ok? envelope)
       (let [checked (signing/validate-trust! trust)
             statement (fget envelope :statement)
             digest (form/string-form (seal/sha256-form statement))]
         (if (statement-ok? statement envelope)
           (if (signing/verify-value (form/string-value (fget statement :public-key)) statement
                                     (form/string-value (fget envelope :signature)))
             (if (trusted-now? trust statement digest now)
               (summary-of statement digest)
               (trap-form))
             (trap-form))
           (trap-form)))
       (trap-form)))

;; the digests of the verified entries, checked for duplicates
(defn- verify-each [bundle [:ref :form/r] trust [:ref :form/r] now :i64 i :i64 out [:ref :form/r]] [:ref :form/r]
     (if (>= i (form/count-of bundle))
       out
       (verify-each bundle trust now (+ i 1)
                    (form/form-vec (form/append-form (form/kids-of out)
                                                     (verify (form/nth-of bundle i) trust now))))))

(defn- digest-seen? [verified [:ref :form/r] i :i64 j :i64] :bool
     (if (>= j i)
       false
       (if (form/eq (fget (form/nth-of verified i) :digest) (fget (form/nth-of verified j) :digest))
         true
         (digest-seen? verified i (+ j 1)))))

(defn- any-duplicate-from? [verified [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of verified))
       false
       (if (digest-seen? verified i 0) true (any-duplicate-from? verified (+ i 1)))))

(defn verify-bundle [bundle [:ref :form/r] trust [:ref :form/r] now :i64] [:ref :form/r]
     (if (form/is-vec? bundle)
       (if (<= (form/count-of bundle) 256)
         (let [verified (verify-each bundle trust now 0 (form/form-vec (form/no-forms)))]
           (if (any-duplicate-from? verified 0)
             (trap-form)
             verified))
         (trap-form))
       (trap-form)))
