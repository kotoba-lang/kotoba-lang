(ns kotoba.compiler.kexe-indexes
  "The host indexes inside a sealed `.kexe`, narrowed after a read.

  KIR function metadata `:closure-param-indexes` and
  `:i64-pair-chain-param-indexes` are HOST indexes into `:params`, not guest
  i64 values: `kotoba.kir/validated-closure-param-indexes` and its
  `i64-pair-chain` sibling check them with `integer?` and use them with
  `nth`. `kir/lower` writes them as host numbers; the bounded artifact
  readers hand back a BigInt for every integer token on nbb, which is right
  for a value and wrong for an index -- `(integer? BigInt)` is false there.

  So an artifact with ANY closure verified at compile time (the in-memory map
  holds Numbers) and was refused by the verifier's oracle re-execution after
  a read-back, as `native artifact oracle evaluation rejected` (cause:
  `closure parameter indexes are malformed`). `extract-native` met it first
  (2026-09-15) and narrowed in `cli-support/read-artifact-file!`; `amu sign`,
  `verify` and `verify-signed` read through `bounded-edn` and kept refusing
  every closure program compile had reported `:oracle {:status :verified}`
  for (2026-10-09, nine kotoba-lang conformance cases). One function, used by
  every reader that hands an artifact to the verifier.

  The seal and a signature statement are over canonical bytes in which a
  BigInt and a Number of the same value print identically, so narrowing
  changes neither."
  {:kotoba/export [narrow-artifact narrow-envelope structural-index-keys]}
  (:require [kotoba.compiler.host-integer :as host-integer]))

(def structural-index-keys
  [:closure-param-indexes :i64-pair-chain-param-indexes])

(defn narrow-artifact
  "ARTIFACT with every function's structural indexes as host numbers; any
  value that is not an artifact-shaped map is returned as is, for the
  verifier to refuse by name."
  [artifact]
  (if (and (map? artifact) (vector? (get-in artifact [:program :functions])))
    (update-in artifact [:program :functions]
               (fn [functions]
                 (mapv (fn [function]
                         (reduce (fn [function key]
                                   (if (and (map? function) (sequential? (get function key)))
                                     (update function key #(mapv host-integer/narrow %))
                                     function))
                                 function structural-index-keys))
                       functions)))
    artifact))

(defn narrow-envelope
  "A signed envelope (`:kotoba.signed-kexe/v1`) with its `:artifact`
  narrowed; the envelope's key set is unchanged."
  [envelope]
  (if (and (map? envelope) (contains? envelope :artifact))
    (update envelope :artifact narrow-artifact)
    envelope))
