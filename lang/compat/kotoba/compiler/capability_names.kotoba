(ns kotoba.compiler.capability-names
  "The user-facing spelling of a capability grant.

  `[:cap/call 3]` is the WIRE form. The compiled artifact, KIR, admission and
  the host runtime all agree on that integer, and changing it is an ABI break.
  It is not, however, something a person should have to read or write:
  `lang/capability-catalog.edn` says `:numeric-id :not-user-facing`, and the
  `:implicit-ability-elaboration` stage in `lang/elaboration-pipeline.edn`
  carries the rule `:no-user-facing-numeric-ids`.

  Measured 2026-08-31, the CLI did exactly what those two forbid. A guest with
  one `(hash/sha256 s)` call -- no `:capabilities` clause, no `cap-call`, no
  number anywhere in its source -- was answered with

      :effects #{[:cap/call 3]}
      :admission {:minimal-policy {:allow #{[:cap/call 3]}} ...}

  so writing the `--policy` file it asks for meant looking up that `hash/sha256`
  is 3. Under nbb it was worse than inconvenient: the id is a JavaScript BigInt,
  which prints as `#object[BigInt 3]`, so the `:minimal-policy` the CLI printed
  was not readable EDN and could not be pasted back at all.

  This namespace is that translation, and ONLY that translation. It sits at the
  boundary where the compiler talks to a person:

    - `name-grants` rewrites wire ids to catalog names on the way OUT (what
      `check` prints, and what an error envelope reports).
    - `wire-policy` rewrites catalog names to wire ids on the way IN (what
      `--policy` accepts), before admission and before provenance sees it.

  Nothing between those two boundaries changes. HIR, KIR, admission, the
  emitters and the emitted bytes keep the integer they have always had, so a
  policy file written the old way hashes to the same `:policy-sha256` and
  produces the same artifact, byte for byte.

  A grant whose id is NOT in the catalog is left numeric on the way out. There
  is no name to give it: the only way to reach such an id is to write
  `(cap-call 200 x)` -- a literal integer -- in the guest source, and inventing
  a name for it would be a lie. An id the catalog DOES know is named even when
  the source spelled it numerically, because the name is the more useful of two
  true answers."
  ;; Exports in the ns ATTR-MAP (grammar `:ns :attr-map`): the spelling both
  ;; hosts accept -- SCI's `ns` refuses an `(:export ...)` clause, and `amu
  ;; check` in project mode refuses a module without one. Public functions
  ;; only; `id->name` / `name->id` are defs and an export must be a function.
  {:kotoba/export [named-grant name-grants wire-grant wire-policy]}
  (:require [kotoba.lang.coll :as coll] [kotoba.sema :as sema] [kotoba.form :as form] [kotoba.kir.cljs-i64 :as i64])
  ;; Kotoba: a grant, an effect row and a policy are EDN values, i.e. the
  ;; recursive `:form/r` record (kotoba.form), and the two catalog tables are
  ;; kotoba.sema's functions answering a map Form (`capability-id->name`,
  ;; `capability-registry`). Same names, same exports, same answers.
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                 [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]}))

;; ---------------------------------------------------------------------------
;; Kotoba reading. A def may not alias a function on the Kotoba route (the
;; catalog tables are functions of kotoba.sema there), so the host defs
;; `id->name` / `name->id` have no Kotoba reading and the functions below read
;; the tables through kotoba.sema directly. Grants are `:form/r` vectors; a
;; wire id is an int Form (the reader keeps integers as int Forms, so there is
;; no BigInt normalisation to do: `wire-int` / `host-wire-int` are host-only).
(defn- grant? [x [:ref :form/r]] :bool
     (and (form/is-vec? x)
          (= 2 (form/count-of x))
          (form/eq (form/nth-of x 0) (form/keyword-form :cap/call))))

(defn named-grant
     "`[:cap/call 3]` -> `[:cap/call :hash/sha256]`; a grant already spelled with
     a name, and a grant whose id has no catalog name, are returned unchanged."
     [grant [:ref :form/r]] [:ref :form/r]
     (if (grant? grant)
       (let [id (form/nth-of grant 1)]
         (if (form/is-int? id)
           (let [nm (form/form-get (sema/capability-id->name) id)]
             (if (form/is-keyword? nm)
               (form/vec2 (form/nth-of grant 0) nm)
               grant))
           grant))
       grant))

(defn- rebuild [f [:ref :form/r] kids [:list [:ref :form/r]]] [:ref :form/r]
     (let [t (form/tag-of f)]
       (cond (= t 6) (form/form-seq kids)
             (= t 7) (form/form-vec kids)
             (= t 8) (form/form-set kids)
             :else (form/form-map kids))))

(defn- name-kids
     "The kids of F from I on, each through `name-grants`, appended to ACC."
     [f [:ref :form/r] i :i64 n :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i n)
       acc
       (name-kids f (inc i) n (form/append-form acc (name-grants (form/nth-of f i))))))

(defn name-grants
     "Every `[:cap/call <id>]` anywhere inside VALUE rewritten to its catalog
     name, bottom-up (the host's `postwalk named-grant`)."
     [value [:ref :form/r]] [:ref :form/r]
     (let [t (form/tag-of value)]
       (if (and (>= t 6) (<= t 9))
         (let [xs (form/kids-of value)
               n (vector-count xs)]
           (named-grant (rebuild value (name-kids value 0 n (form/no-forms)))))
         (named-grant value))))

(defn wire-grant
     "`[:cap/call :hash/sha256]` -> `[:cap/call 3]`, the inverse of `named-grant`.
     An unregistered name is a hard refusal (closed world)."
     [grant [:ref :form/r]] [:ref :form/r]
     (if (and (grant? grant) (form/is-keyword? (form/nth-of grant 1)))
       (let [id (form/form-get (sema/capability-registry) (form/nth-of grant 1))]
         (if (form/is-int? id)
           (form/vec2 (form/nth-of grant 0) id)
           (throw (ex-info (string-concat "policy names an unregistered capability: "
                                          (document-edn-print (document-keyword (form/keyword-value (form/nth-of grant 1)))))
                           {:phase :admission}))))
       grant))

(defn- member? [acc [:list [:ref :form/r]] x [:ref :form/r] i :i64] :bool
     (if (>= i (vector-count acc))
       false
       (if (form/eq (typed-list-nth [:list [:ref :form/r]] acc i) x)
         true
         (member? acc x (inc i)))))

(defn- conj-distinct [acc [:list [:ref :form/r]] x [:ref :form/r]] [:list [:ref :form/r]]
     (if (member? acc x 0) acc (form/append-form acc x)))

(defn- wire-grants [set [:ref :form/r] i :i64 n :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i n)
       acc
       (wire-grants set (inc i) n (conj-distinct acc (wire-grant (form/nth-of set i))))))

(defn wire-policy
     "A policy read from `--policy` with its `:allow` set in the wire form; the
     other keys are left to their own evaluators."
     [policy [:ref :form/r]] [:ref :form/r]
     (let [allow (form/form-get policy (form/keyword-form :allow))]
       (if (form/is-set? allow)
         (let [n (form/count-of allow)]
           (form/assoc-form policy (form/keyword-form :allow)
                            (form/form-set (wire-grants allow 0 n (form/no-forms)))))
         policy)))

;; ---------------------------------------------------------------------------
;; Host reading (Clojure / nbb), unchanged.
nil
