(ns kotoba.compiler.nbb.output-set
  "Deterministic commit marker for a primary artifact and its provenance."
  {:kotoba/export [descriptor format serialize verify!]}
  (:require [kotoba.compiler.nbb.compile-cache :as digest]
            [kotoba.compiler.host-integer :as host-integer]
            [kotoba.compiler.posix-path :as posix-path]
            [kotoba.compiler.text-bytes :as text-bytes]
            [kotoba.form :as form]
                         [kotoba.bytes :as kbytes]
                         [sha2.core :as sha2])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]}))

nil

nil

nil

nil

nil

nil

nil

nil

;; ---------------------------------------------------------------------------
;; THE KOTOBA READING. A marker is a `:form/r` (kotoba.form), the artifact is
;; `:bytes` and the provenance is text; the host's dynamic "text or bytes" value
;; is those two typed positions. The digest is over the printed payload, so the
;; payload is PRINTED here in the host's entry order (`{:format .., :files [..]}`,
;; each file `{:role .., :name .., :sha256 .., :size ..}`), not through a sorted
;; canonical text. A rejected marker TRAPS (`assert`): an export cannot abort
;; with a value a caller sees (host: ex-info "output set is not committed").

(defn format [] :keyword :kotoba.output-set/v1)

(defn- trap-form [] [:ref :form/r]
     (let [refused (assert (= 1 0))] (form/nil-form)))

(defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r]
     (form/form-get m (form/keyword-form k)))

(defn- put [m [:ref :form/r] k :keyword v [:ref :form/r]] [:ref :form/r]
     (form/assoc-form m (form/keyword-form k) v))

(defn- empty-map [] [:ref :form/r] (form/form-map (form/no-forms)))

(defn- pr-text [s :string] :string
     (document-edn-print (document-string s)))

(defn- bytes-sha256 [data :bytes] :string
     (kbytes/hex (sha2/sha256 (vector-i64-from-bytes data))))

(defn- identity-text [role :string name :string sha :string size :i64] :string
     (string-concat "{:role :"
      (string-concat role
       (string-concat ", :name "
        (string-concat (pr-text name)
         (string-concat ", :sha256 "
          (string-concat (pr-text sha)
           (string-concat ", :size "
            (string-concat (string-from-i64 size) "}")))))))))

(defn- payload-text [output :string artifact :bytes provenance :string] :string
     (string-concat "{:format :kotoba.output-set/v1, :files ["
      (string-concat (identity-text "artifact" (posix-path/basename output)
                                    (bytes-sha256 artifact) (bytes-count artifact))
       (string-concat " "
        (string-concat (identity-text "provenance" (posix-path/basename (string-concat output ".provenance.edn"))
                                      (digest/sha256 provenance) (string-byte-length provenance))
         "]}")))))

(defn- identity-form [role :keyword name :string sha :string size :i64] [:ref :form/r]
     (put (put (put (put (empty-map) :role (form/keyword-form role))
                    :name (form/string-form name))
               :sha256 (form/string-form sha))
          :size (form/int-form size)))

(defn descriptor [output :string artifact :bytes provenance :string] [:ref :form/r]
     (put (put (put (empty-map) :format (form/keyword-form (format)))
               :files (form/form-vec
                       (form/two-forms
                        (identity-form :artifact (posix-path/basename output)
                                       (bytes-sha256 artifact) (bytes-count artifact))
                        (identity-form :provenance (posix-path/basename (string-concat output ".provenance.edn"))
                                       (digest/sha256 provenance) (string-byte-length provenance)))))
          :sha256 (form/string-form (digest/sha256 (payload-text output artifact provenance)))))

;; the printed descriptor: the payload with the digest of its own text appended
(defn serialize [output :string artifact :bytes provenance :string] :string
     (let [payload (payload-text output artifact provenance)]
       (string-concat (string-substring payload 0 (- (string-byte-length payload) 1))
        (string-concat ", :sha256 "
         (string-concat (pr-text (digest/sha256 payload)) "}")))))

;; a marker is a map whose :files is a vector of two maps carrying non-negative sizes
(defn- file-shape? [f [:ref :form/r]] :bool
     (if (form/is-map? f)
       (let [size (fget f :size)]
         (if (form/is-int? size) (>= (form/int-value size) 0) false))
       false))

(defn- marker-shape? [marker [:ref :form/r]] :bool
     (if (form/is-map? marker)
       (let [files (fget marker :files)]
         (if (form/is-vec? files)
           (if (= 2 (form/count-of files))
             (if (file-shape? (form/nth-of files 0)) (file-shape? (form/nth-of files 1)) false)
             false)
           false))
       false))

(defn verify! [output :string artifact :bytes provenance :string marker [:ref :form/r]] [:ref :form/r]
     (if (marker-shape? marker)
       (if (form/eq (fget marker :format) (form/keyword-form (format)))
         (if (form/eq (descriptor output artifact provenance) marker)
           marker
           (trap-form))
         (trap-form))
       (trap-form)))
