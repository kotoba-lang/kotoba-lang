(ns kotoba.compiler.nbb.test-cli
  "Node entrypoint for `amu test`. The command is `kotoba.compiler.test-cli`;
  this file prints and answers the exit status. Unlike the other entrypoints
  it does not go through `support/execute!`, because the human report is
  text, not EDN, and a failing test is exit 1 rather than a thrown refusal.

  Output goes through the io/write and io/write-error abilities, the
  arguments through cli/args (superproject adr-2609242330 S5). The status is
  `main`'s result; handing it to the OS is the mechanism layer's job."
  {:kotoba/export [main]}
  (:require [kotoba.artifact.core :as artifact]
            [kotoba.compiler.nbb.cli-support :as support]
            [kotoba.compiler.test-cli :as test-cli]
            
            ))

(defn main
  "Run `amu test` over ARGS, print its report, and answer the exit status."
  [args]
  (let [outcome (try {:ran (test-cli/run args)}
                     (catch :default error
                       {:refused (support/refusal error (second args))}))]
    (if-let [{:keys [status stderr]} (:refused outcome)]
      (do (io/write-error stderr) status)
      (let [{:keys [report json?] :as ran} (:ran outcome)]
        (if-not ran
          0
          (do
            (if json?
              (io/write (str (pr-str (artifact/edn-safe report)) "\n"))
              (let [{:keys [out err]} (test-cli/human-lines report)]
                (doseq [line out] (io/write (str line "\n")))
                (doseq [line err] (io/write-error (str line "\n")))))
            (if (:ok report) 0 1)))))))


