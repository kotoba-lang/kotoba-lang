(ns kotoba.compiler.nbb.x86-64-cli
  "nbb native compiler entrypoint for the targets whose artifact the
  ELF64 / PE32+ / linux-static packagers (`kotoba.compiler.nbb.native-package`)
  serve: every x86-64 target, `extract-native`, and the two PACKAGED AArch64
  targets `aarch64-aiueos-kernel-v1` (ELF64 kernel image) and
  `aarch64-linux-static` (static ELF).

  The packaged AArch64 pair used to have an entry of its own
  (`nbb/aarch64_packaged_cli`, 15d9fcccf). ADR 0366 retired it: one nbb entry
  fewer on the product path, and the packagers stay in exactly one entry's
  closure. The ISA emitter is chosen from the target's backend; every other
  AArch64 target (aarch64-macos included) stays on
  `kotoba.compiler.nbb.aarch64-cli`, whose closure carries no packager."
  {:kotoba/export []}
  (:require [kotoba.compiler.nbb.cli :as native-cli]
            [kotoba.compiler.nbb.cli-support :as support]
            [kotoba.compiler.nbb.compile-cache :as compile-cache]
            [kotoba.compiler.nbb.native-package :as native-package]
            [kotoba.kir.target :as target-profile]
            [kotoba.native.aarch64 :as aarch64]
            [kotoba.native.x86-64 :as x86-64]))

(def ^:private aarch64-packaged-targets
  "The AArch64 target names routed here (bin/amu `aarch64PackagedTargets`,
  bin/kotoba). Any other AArch64 target is refused by name: it belongs to
  `kotoba.compiler.nbb.aarch64-cli`."
  #{"aarch64-aiueos-kernel-v1" "aarch64-linux-static"})

(defn- isa
  "[backend emit-program] for the --target on the command line. No target
  (extract-native) and every x86-64 target answer the x86-64 pair, as before."
  [args]
  (let [target-name (support/option args "--target")
        backend (some-> (get native-cli/targets target-name) target-profile/backend)]
    (if (= :aarch64-kotoba-v1 backend)
      (if (contains? aarch64-packaged-targets target-name)
        [:aarch64-kotoba-v1 aarch64/emit-program]
        (support/usage-error!
         (str "error: target " target-name " has no packaged form; it is served by "
              "kotoba.compiler.nbb.aarch64-cli")))
      [:x86_64-kotoba-v1 x86-64/emit-program])))

(defn- run! [args context]
  ;; A worker is locked to one target (checked when it starts, below); its
  ;; ISA is that target's, whatever a request spells.
  (let [[backend emit-program] (if (and context
                                        (= :aarch64-kotoba-v1 (target-profile/backend (:target context))))
                                 [:aarch64-kotoba-v1 aarch64/emit-program]
                                 (if context
                                   [:x86_64-kotoba-v1 x86-64/emit-program]
                                   (isa args)))]
    (native-cli/run! args backend emit-program native-package/package context)))

(let [args (support/command-line-args)]
 (if (= "worker" (first args))
  (let [target-name (support/option args "--target")
        target (get native-cli/targets target-name)
        backend (some-> target target-profile/backend)
        _ (when-not (or (= :x86_64-kotoba-v1 backend)
                        (and (= :aarch64-kotoba-v1 backend)
                             (contains? aarch64-packaged-targets target-name)))
            (support/usage-error!
             (str "error: packaged native worker does not cover target " target-name)))
        context (assoc (compile-cache/create-context) :target target)]
    (support/serve! #(run! % context) target))
  (support/execute! #(run! % nil))))
