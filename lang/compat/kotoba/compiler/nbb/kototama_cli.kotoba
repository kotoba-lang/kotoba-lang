(ns kotoba.compiler.nbb.kototama-cli
  "JDK-free Kototama program compiler entrypoint."
  (:require [kotoba.artifact.core :as artifact]
            [kotoba.compiler.core :as compiler]
            [kotoba.compiler.capability-names :as cap-names]
            [kotoba.compiler.definition-identity :as definition-identity]
            [kotoba.compiler.nbb.cli-support :as support]
            [kotoba.compiler.nbb.io :as io]
            [kotoba.compiler.nbb.package-lock :as package-lock]
            [kotoba.compiler.nbb.output-set :as output-set]
            [kotoba.compiler.nbb.project-source :as project-source]))

(defn- package-verdict! [resolved definitions]
  (when-let [packages (:packages resolved)]
    (let [computed (keep :cid (vals (:entries definitions)))
          verdict (package-lock/verify-definitions (:dependencies packages) computed)]
      (package-lock/report packages verdict))))

(def ^:private targets
  #{"kototama" "kototama-core-v1"})

(defn- compile! [args]
  (let [target-name (or (support/option args "--target") "kototama")
        _ (when-not (contains? targets target-name)
            (support/usage-error! (str "error: nbb Kototama path does not cover target " target-name)))
        resolved (project-source/resolve-source! args)
        input (:input resolved)
        output (or (support/option args "--output") (str input ".kototama"))
        policy (cap-names/wire-policy (support/read-policy args))
        metadata (merge (support/emit-metadata args)
                        (project-source/analyze-opts policy (:linked? resolved)))
        result (support/timed "kototama-compile"
                              #(compiler/compile-kototama (:source resolved) policy metadata))
        definitions (definition-identity/describe {:hir (:hir result) :kir (:kir result)})
        package-result (package-verdict! resolved definitions)
        provenance-text (pr-str (artifact/edn-safe (:provenance result)))
        provenance-output (str output ".provenance.edn")
        publication-output (str output ".publication.edn")
        publication-text (output-set/serialize output (:program-bytes result) provenance-text)]
    (support/timed "output-set-write"
                   #(io/write-set! [{:path output :bytes (:program-bytes result)}
                                    {:path provenance-output :text provenance-text}
                                    {:path publication-output :text publication-text}]))
    (merge {:ok true :target (:target result) :output output
            :provenance-output provenance-output :publication-output publication-output
            :format (:format result) :cid (:program-cid result)
            :packages package-result}
           (project-source/inputs-record resolved))))

(defn- run! [args]
  (case (first args)
    "compile" (compile! args)
    (support/usage-error! (str "error: nbb Kototama path does not cover command " (first args)))))

(defn- worker! [args]
  (let [target-name (or (support/option args "--target") "kototama")]
    (when-not (contains? targets target-name)
      (support/usage-error! (str "error: Kototama worker does not cover target " target-name)))
    (support/serve! run! :kototama-core-v1)))

(when (seq (support/command-line-args))
  (let [args (support/command-line-args)]
    (if (= "worker" (first args))
      (worker! args)
      (support/execute! run!))))
