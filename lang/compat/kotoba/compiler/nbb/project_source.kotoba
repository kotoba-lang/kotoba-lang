(ns kotoba.compiler.nbb.project-source
  
  "How a compile's source text is found: one file, a path-resolved closed
  graph, or a CID-pinned one.

  This lived inside `kotoba.compiler.nbb.wasm-cli`, which is why project mode
  was a Wasm-only capability on the JDK-free route. Nothing in it is
  Wasm-specific -- `kotoba.compiler.project/link-source` is portable `.cljc`
  and both resolvers beneath it already were -- so the native driver refused a
  module that declared `` for no reason other than where the
  function was written. Measured 2026-09-02 against a two-module fixture on
  `x86_64-aiueos-kernel-v1`: `--source-path` and `--unpinned` were BOTH read
  and BOTH ignored, and the refusal was byte-identical to the one you get with
  neither flag (`:kotoba.error/namespace-require-needs-project`) -- an
  invocation naming its source roots and one that did not got the same answer.

  Not in `cli-support`: `link-source` requires `kotoba.sema`, and that
  namespace deliberately keeps the frontend out of its load closure so
  `output-set-cli` does not pay 15.8s to verify a signature. Both drivers that
  require this one already load `kotoba.sema`."
  {:kotoba/export [resolve-single-source! source-roots]}
    (:require [kotoba.compiler.nbb.cli-support :as support] [kotoba.compiler.nbb.io :as io])
)

;; Kotoba: the surface is the single-file compile. A linked graph, a module
;; lock and a package lock all return open maps (`{:sources :source-map
;; :module-order :project ...}`) built by `project/link-source`, which is not
;; on this route, so each is refused by name instead of read and ignored (the
;; failure that motivated the host namespace).
(defn source-roots [args [:list :string]] [:list :string]
     (support/options args "--source-path"))

(defn- option-is-set? [args [:list :string] flag :string] :i64
     (let [value (support/option args flag)]
       (if (option-some?-of [:option :string] value) 1 0)))

(defn resolve-single-source! [args [:list :string]] :string
     (cond
       (< (vector-count args) 2)
       (throw (ex-info "missing source input" {:phase :usage}))
       (> (vector-count (source-roots args)) 0)
       (throw (ex-info "--source-path (a linked project) is not available on the Kotoba route" {:phase :usage}))
       (= (option-is-set? args "--module-lock") 1)
       (throw (ex-info "--module-lock is not available on the Kotoba route" {:phase :usage}))
       (= (option-is-set? args "--package-lock") 1)
       (throw (ex-info "--package-lock is not available on the Kotoba route" {:phase :usage}))
       :else
       (io/read-text-file (support/source! (typed-list-nth [:list :string] args 1)))))

nil
