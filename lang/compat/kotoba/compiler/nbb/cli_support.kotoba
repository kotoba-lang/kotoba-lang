(ns kotoba.compiler.nbb.cli-support
  "Shared, backend-free support for the split nbb compiler entrypoints.

  Keeping policy decoding and the CLI error contract here is important: the
  Wasm/native split may reduce namespace load time, but must not create two
  subtly different admission boundaries."
  {:kotoba/export [capability-policy command-line-args emit-metadata error-phase execute! exit-code oracle-fuel option options parse-policy-material read-artifact-file! read-edn-file! read-policy read-policy-material refusal-text serve! source! timed usage-error!]}
  (:require [kotoba.compiler.diagnostic :as diagnostic]
            [kotoba.compiler.kotoba-reader :as kr]
            [kotoba.compiler.posix-path :as posix-path]
            [kotoba.compiler.text-bytes :as text-bytes]
            [kotoba.compiler.host-integer :as host-integer]
            [kotoba.compiler.decimal-text :as decimal-text]
            [kotoba.compiler.bounded-edn :as bounded-edn]
            [kotoba.form :as form]
            [kotoba.compiler.kexe-indexes :as kexe-indexes]
            [kotoba.compiler.json-text :as json-text]
            [kotoba.compiler.nbb.io :as nbb-io]
            [kotoba.compiler.source-path :as source-path]
            ;; Abilities (superproject adr-2609242330 S5). Under Kotoba
            ;; `env/read`, `clock/now`, `cli/args`, `io/write` and
            ;; `io/write-error` are catalog operations (wires 33, 7, 38, 37,
            ;; 39) whose handlers come from the target profile; under nbb
            ;; these aliases name the mechanism-layer handlers, the only
            ;; place a host module is required by string.
            
            
            
            
            ;; Not an ability: loading, the event loop and handing the exit
            ;; status to the OS (adr-2609242330 section 1 (c)(2)).
            )
  ;; Kotoba: an EDN value is the recursive `:form/r` record (kotoba.form), the
  ;; same schema `kotoba.compiler.bounded-edn` answers with.
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]}))

;; Opt-in phase timings go to stderr behind a stable marker. Normal stdout and
;; artifact bytes remain unchanged.
;;
;; Under Kotoba a def value cannot perform a capability call and module state
;; is absent, so the flag is a function of the environment and the timing
;; state does not exist: `timed` runs its thunk, and the timing helpers have no Kotoba reading
;; (only the host `execute!` reads them). One arity and one type per name: the
;; Kotoba thunk answers a Form, the dynamic value every phase of the route has.
;; A thunk that can abort cannot be a fn literal on Kotoba (E2135), so a phase
;; whose body can refuse calls the body directly instead of through `timed`.
nil

;; The monotonic clock in milliseconds. clock/now answers nanoseconds as
;; decimal text; phases are differences of two readings, so the clock's
;; origin does not matter (performance.now's did not either).
nil

nil

(defn timed [phase :string f [:fn [[] [:ref :form/r]]]] [:ref :form/r]
     (f))

nil

nil

(defn- option-at [args [:list :string] flag :string i :i64] [:option :string]
     (if (>= i (vector-count args))
       (option-none-of [:option :string])
       (if (= flag (typed-list-nth [:list :string] args i))
         (if (< (+ i 1) (vector-count args))
           (option-some-of [:option :string] (typed-list-nth [:list :string] args (+ i 1)))
           (option-none-of [:option :string]))
         (option-at args flag (+ i 1)))))

(defn option [args [:list :string] flag :string]
  [:option :string]
  (option-at args flag 0))

;; Repeated flags. `--source-path` may appear more than once and each
;; occurrence is a separate package root, so taking only the first would
;; silently compile against a subset of the roots the caller named -- the
;; graph would still link if the missing root happened to be unused, which is
;; the failure that looks like a pass.
(defn- options-from [args [:list :string] flag :string i :i64 acc [:list :string]] [:list :string]
     (if (>= (+ i 1) (vector-count args))
       acc
       (options-from args flag (+ i 1)
                     (if (= flag (typed-list-nth [:list :string] args i))
                       (conj acc (typed-list-nth [:list :string] args (+ i 1)))
                       acc))))

(defn options [args [:list :string] flag :string]
  [:list :string]
  (options-from args flag 0 (typed-list-new [:list :string])))

(defn usage-error! [message :string] :string
  (throw (ex-info message {:phase :usage})))

(defn source! [path] (source-path/admit! path))

;; Kotoba: the host's reading below (`read-edn-form!` over nbb-io's
;; `read-text-file`): the file through nbb-io's Kotoba read (refusals by name,
;; no trap), read by the kotoba reader with the policy bounds (200000 nodes,
;; 4096-char tokens, 128 depth, 1 MiB strings) and no dispatch preflight
;; (`bounded-edn/read-reader-text-limits`), and the answer is the Form. Until
;; 2026-10-10 this was `bounded-edn/read-file` (its own READ, which trapped on
;; a path it cannot serve, and its preflight). The host definition stays where
;; it was, in the host-only region.
(defn read-edn-file! [path :string] [:ref :form/r]
     ;; the reads abort, and across the module boundary their abort is this
     ;; function's (ADR 0363)
     (bounded-edn/read-reader-text-limits (nbb-io/read-text-file path) (cs-max-policy-nodes) (cs-max-policy-depth)))

;; Everything from here to `command-line-args` decodes, narrows and reports on
;; host values: EDN maps, BigInts, `ex-info` data and `catch :default`. A
;; Kotoba module has no open map and no catchable raise, so this region is
;; the host route's alone; the Kotoba surface is the argument helpers above
;; and the entry contract below.
nil

;; Kotoba readings of the policy, build-metadata and artifact helpers above.
;; Every value is the `:form/r` Form (the host's maps), so the host keys are
;; Form keywords. Named differences from the host route:
;;   - the policy is read by `bounded-edn/read-edn-text` (the host walks the
;;     kotoba reader's forms with the same bounds; a dispatch form other than a
;;     set is refused here by bounded-edn's preflight);
;;   - `--fuel` admits at most 18 digits (`decimal-text/decimal?`), the host any
;;     length; past 2^53-1 both are refused later by `kotoba.kir`;
;;   - there is no BigInt, so an artifact needs no index narrowing and
;;     `oracle-fuel` answers the i64 itself; a policy `:budgets :fuel` that is not
;;     an integer is refused here, where the host hands it to `kir/lower`.
(defn- cs-kw [k :keyword] [:ref :form/r] (form/keyword-form k))

(defn- cs-get [m [:ref :form/r] k :keyword] [:ref :form/r] (form/form-get m (cs-kw k)))

(defn- cs-put [m [:ref :form/r] k :keyword v [:ref :form/r]] [:ref :form/r] (form/assoc-form m (cs-kw k) v))

(defn- cs-empty [] [:ref :form/r] (form/form-map (form/no-forms)))

;; A policy file's and a module lock's bounds (the host's max-policy-nodes / -depth).
(defn- cs-max-policy-nodes [] :i64 200000)

(defn- cs-max-policy-depth [] :i64 128)

;; `read-artifact-file!`'s bounds (the host's max-artifact-nodes / -depth).
(defn- cs-max-artifact-nodes [] :i64 4194304)

(defn- cs-max-artifact-depth [] :i64 512)

(defn read-artifact-file! [path :string] [:ref :form/r]
     (bounded-edn/read-reader-text-limits (nbb-io/read-artifact-text-file path)
                                          (cs-max-artifact-nodes) (cs-max-artifact-depth)))

(defn read-policy-material [args [:list :string]] [:ref :form/r]
     (let [path (option args "--policy")]
       (if (option-some?-of [:option :string] path)
         (cs-put (cs-put (cs-empty) :present? (form/bool-form true))
                 :text (form/string-form (nbb-io/read-text-file (option-value-of [:option :string] path ""))))
         (cs-put (cs-put (cs-empty) :present? (form/bool-form false)) :text (form/string-form "")))))

(defn parse-policy-material [material [:ref :form/r]] [:ref :form/r]
     (if (form/bool-value (cs-get material :present?))
       (bounded-edn/read-reader-text-limits (form/string-value (cs-get material :text))
                                            (cs-max-policy-nodes) (cs-max-policy-depth))
       (cs-empty)))

(defn read-policy [args [:list :string]] [:ref :form/r]
     (parse-policy-material (read-policy-material args)))

(defn- cs-flag? [args [:list :string] flag :string i :i64] :bool
     (if (>= i (vector-count args))
       false
       (if (= flag (typed-list-nth [:list :string] args i))
         true
         (cs-flag? args flag (+ i 1)))))

(defn- cs-fuel-refusal [] [:ref :form/r]
     (throw (ex-info "--fuel must be a positive decimal integer" {:phase :usage})))

(defn emit-metadata [args [:list :string]] [:ref :form/r]
     (if (cs-flag? args "--fuel" 0)
       (let [o (option args "--fuel")
             text (option-value-of [:option :string] o "")]
         (if (option-some?-of [:option :string] o)
           ;; a signed decimal whose value is not positive is what the host's
           ;; [0-9]+ refuses plus its zero check (\"-0\" and \"-5\" included)
           (if (decimal-text/decimal? text)
             (let [fuel (decimal-text/parse text)]
               (if (> fuel 0)
                 (cs-put (cs-empty) :fuel (form/int-form fuel))
                 (cs-fuel-refusal)))
             (cs-fuel-refusal))
           (cs-fuel-refusal)))
       (cs-empty)))

(defn- cs-declared-fuel [declared [:ref :form/r]] [:option :i64]
     (if (form/is-int? declared)
       (option-some-of [:option :i64] (form/int-value declared))
       (throw (ex-info "the declared fuel budget must be an integer" {:phase :decode}))))

(defn oracle-fuel [metadata [:ref :form/r] policy [:ref :form/r]] [:option :i64]
     (let [declared (cs-get metadata :fuel)]
       (if (form/is-nil? declared)
         (let [budget (cs-get (cs-get policy :budgets) :fuel)]
           (if (form/is-nil? budget)
             (option-none-of [:option :i64])
             (cs-declared-fuel budget)))
         (cs-declared-fuel declared))))

(defn capability-policy [policy [:ref :form/r]] [:ref :form/r]
     (if (form/is-map? policy)
       (form/dissoc-form (form/dissoc-form policy (cs-kw :language-profile)) (cs-kw :budgets))
       policy))

(defn- arguments-from [count :i64 i :i64 acc [:list :string]] [:list :string]
     (if (>= i count)
       acc
       (arguments-from count (+ i 1) (conj acc (cli/args (str i))))))

(defn command-line-args
  "The arguments this entrypoint was invoked with, through the cli/args
  ability: the empty request answers the count, a decimal the argument."
  [] [:list :string]
  (arguments-from (decimal-text/parse (cli/args "")) 0 (typed-list-new [:list :string])))

(defn execute!
     [run! [:fn [[[:list :string]] :string]]] :i64
     (let [stdout (run! (command-line-args))]
       (when (> (string-byte-length stdout) 0) (io/write stdout))
       0))

;; Kotoba reading of the error contract for an entry's `main` (the host's `invoke*`, `error-report` and
;; `exit-code` in the region above): the phase of a caught refusal (`:phase` of its ex-info data, `:internal`
;; without one), the host's exit-code table entry for entry, and a REDUCED `:kotoba.cli-error/v1` report (format,
;; ok, error, message; no `:diagnostic`/`:details`, the message is not refined by kotoba.compiler.diagnostic).
(defn error-phase [e :document] :keyword
     (option-or (document-keyword-value (option-or (document-get (ex-data e) (document-keyword :phase)) (document-null)))
                :internal))

(defn exit-code [phase :keyword] :i64
     (cond
       (= phase :usage) 64
       (or (= phase :decode) (= phase :read) (= phase :subset) (= phase :admission) (= phase :verify)
           (= phase :coverage) (= phase :project-link) (= phase :module-lock) (= phase :test)) 65
       (= phase :definition-identity) 66
       (or (= phase :signature) (= phase :sign) (= phase :trust) (= phase :runtime-identity)) 77
       (= phase :output) 74
       (or (= phase :execute) (= phase :native-executor)) 69
       (= phase :receipt) 76
       :else 70))

(defn refusal-text [phase :keyword message :string] :string
     (string-concat "{:format :kotoba.cli-error/v1, :ok false, :error "
      (string-concat (document-edn-print (document-keyword phase))
       (string-concat ", :message "
        (string-concat (document-edn-print (document-string (if (= phase :internal) "internal compiler error" message)))
                       "}\n")))))

(defn serve! [run! target]
     (usage-error! "worker mode is not available on the Kotoba route"))
