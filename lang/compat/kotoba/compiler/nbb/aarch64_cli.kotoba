(ns kotoba.compiler.nbb.aarch64-cli
  "AArch64-only nbb native compiler entrypoint, without the artifact packagers.

  The ELF64 / PE32+ / linux-static packagers (`kotoba.compiler.nbb.native-package`)
  serve only `aarch64-aiueos-kernel-v1` and `aarch64-linux-static`; those two
  targets are routed to `kotoba.compiler.nbb.x86-64-cli`, the packaged native
  entry (ADR 0366). Everything
  else (aarch64-macos included) has no packaged form, so this entry's closure
  does not load them. A packaged target that reaches this entry anyway is
  refused by name, never written as artifact EDN under an executable's name."
  {:kotoba/export [main run]}
  (:require [kotoba.compiler.nbb.cli :as native-cli]
                         [kotoba.compiler.nbb.cli-support :as support]))

(defn run [args [:list :string]] :i64
     (if (and (> (vector-count args) 0) (string=? (typed-list-nth [:list :string] args 0) "worker"))
       (let [w (io/write-error (support/refusal-text :usage "error: worker mode is not available on the Kotoba route"))]
         64)
       (try (let [w (io/write (native-cli/run! args))] 0)
            (catch e (let [phase (support/error-phase e)
                           w (io/write-error (support/refusal-text phase (ex-message e)))]
                       (support/exit-code phase))))))

(defn main [] :i64 (run (support/command-line-args)))
