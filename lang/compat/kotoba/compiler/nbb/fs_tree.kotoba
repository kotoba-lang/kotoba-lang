(ns kotoba.compiler.nbb.fs-tree
  "Directory-level operations the compiler's nbb commands used node:fs for,
  spelled as fs/app-data (wire 35) and fs/browse (wire 34) requests
  (superproject adr-2609242330 S5). The decisions -- what counts as present,
  which parents to create, that a symlink is removed and never followed --
  are here; the handler answers one host call per request.

    exists?            anything at P, a final symlink followed (existsSync)
    directory?         a directory at P, followed (statSync().isDirectory())
    kind               the final component itself: 0 file, 1 directory,
                       2 symlink, 3 other, nil absent (NOFOLLOW)
    entries            DIR's names, bytewise sorted (fs/browse)
    make-directories!  DIR and every missing parent (mkdirSync recursive)
    remove-tree!       DIR and everything under it, symlinks unlinked and
                       never followed; failures ignored (rmSync recursive
                       force)"
  {:kotoba/export [directory? entries exists? kind make-directories! remove-tree!]}
  (:require [kotoba.compiler.decimal-text :as decimal-text]
            [kotoba.compiler.posix-path :as posix-path]
            [kotoba.lang.text :as text]
            ))

(defn- fields [answer]
  (when (seq answer)
    (decimal-text/fields answer)))

(defn exists? [p]
  (not= "" (fs/app-data (str p "STAT_SEP"))))

(defn directory? [p]
  (= 1 (nth (fields (fs/app-data (str p "STAT_SEP"))) 3 nil)))

(defn kind [p]
  (nth (fields (fs/app-data (str p "NOFOLLOW_SEP"))) 3 nil))

(defn entries [dir]
  (let [answer (fs/browse dir)]
    (if (= "" answer)
      []
      (mapv #(first (text/split % #"\t")) (text/split answer #"\n")))))

(defn make-directories!
  "Create DIR and any missing parent; throws when DIR is still not there."
  [dir]
  (let [parent (posix-path/dirname dir)]
    (when (and (not= parent dir) (not (exists? parent)))
      (make-directories! parent))
    (when-not (= "1" (fs/app-data (str dir "MKDIR_SEP")))
      (when-not (directory? dir)
        (throw (ex-info "directory could not be created" {:phase :fs :dir dir}))))))

(defn remove-tree!
  "Remove DIR and everything under it; a failure is ignored."
  [dir]
  (try
    (doseq [name (entries dir)]
      (let [p (str dir "/" name)]
        (if (= 1 (kind p))
          (remove-tree! p)
          (fs/app-data (str p "UNLINK_SEP")))))
    (fs/app-data (str dir "RMDIR_SEP"))
    (catch :default _ nil)))
