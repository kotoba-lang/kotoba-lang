(ns kotoba.compiler.nbb.check-cli
  "`amu check` as an entry of its own.

  `check` used to be answered by `kotoba.compiler.nbb.wasm-cli`, whose closure
  carries the Wasm emitter, the component tooling and the typed-value runtime
  that a check never calls. The self-hosted build has one target and three
  commands (`check`, `compile`, `refactor`); this entry is the `check` one, and
  its closure is the check driver (`kotoba.compiler.nbb.check-driver`) alone.
  Same command, same answer, byte for byte: both entries call the same
  `check!`."
  {:kotoba/export [main run]}
  (:require [kotoba.compiler.nbb.check-driver :as driver]
            [kotoba.compiler.nbb.cli-support :as support]
            [kotoba.compiler.project :as project]
            [kotoba.form :as form])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                 [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]}))

(defn- run-check [args [:list :string]] :string
     (string-concat (project/pr-text (driver/check! args)) "\n"))

(defn run [args [:list :string]] :i64
     (if (and (> (vector-count args) 0) (string=? (typed-list-nth [:list :string] args 0) "check"))
       (try (let [w (io/write (run-check args))] 0)
            (catch e (let [phase (support/error-phase e)
                           w (io/write-error (support/refusal-text phase (ex-message e)))]
                       (support/exit-code phase))))
       (let [w (io/write-error (support/refusal-text :usage (string-concat "error: nbb check path does not cover command "
                                                                          (if (> (vector-count args) 0) (typed-list-nth [:list :string] args 0) ""))))]
         64)))

(defn main [] :i64 (run (support/command-line-args)))

nil
