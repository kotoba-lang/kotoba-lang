(ns kotoba.compiler.nbb.host.entry
  "MECHANISM LAYER -- loading and running an entrypoint on nbb/Node
  (superproject adr-2609242330 S5, section 1 (c)(2): the event loop, argv
  in, the exit status out). Not Kotoba source, and not an ability: the ADR
  makes the exit status the entry's RETURN VALUE, so a compiler module
  computes a status and this layer is what hands it to the OS. Under Kotoba
  the entry's status is its result; under nbb, `exit!` below delivers it.

  The stdin event functions are the Node stream plumbing the compiler
  worker (`cli-support/serve!`) is driven by. They only register callbacks;
  every framing and limit decision stays in the caller. See
  kotoba.compiler.nbb.host.io for the layer's contract."
  {:kotoba/export []})

(defn exit!
  "End the process with STATUS."
  [status]
  (.exit js/process status))

(defn exit-soon!
  "End the process with STATUS after the current event-loop turn, so a write
  queued in this turn is flushed first."
  [status]
  (js/setImmediate #(.exit js/process status)))

(defn on-stdin-data!
  "Call F with each chunk (a byte buffer) that arrives on standard input."
  [f]
  (.on js/process.stdin "data" f))

(defn on-stdin-end!
  "Call F once standard input reaches EOF."
  [f]
  (.on js/process.stdin "end" f))

(defn pause-stdin!
  "Stop reading standard input."
  []
  (.pause js/process.stdin))
