(ns kotoba.compiler.nbb.host.clock
  "MECHANISM LAYER -- the nbb/Node handler of the clock/now ability, text
  form (catalog wire 7; superproject adr-2609242330 S5, section 1 (c)). Not
  Kotoba source: a compiler module writes `(clock/now \"monotonic\")` and
  requires this namespace only under `#?(:cljs ...)`.

    \"wall\"      -> milliseconds since the Unix epoch, decimal
    \"monotonic\" -> nanoseconds of the monotonic clock, decimal

  The same two forms the kexe loader and the static ELF handler answer;
  anything else throws. See kotoba.compiler.nbb.host.io."
  {:kotoba/export []})

(defn now
  "clock/now 7, text form."
  [form]
  (case form
    "wall" (str (js/Date.now))
    "monotonic" (str (js/process.hrtime.bigint))
    (throw (ex-info "clock/now request must be \"wall\" or \"monotonic\""
                    {:phase :host :request form}))))
