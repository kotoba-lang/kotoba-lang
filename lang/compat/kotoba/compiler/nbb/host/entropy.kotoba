(ns kotoba.compiler.nbb.host.entropy
  "MECHANISM LAYER -- the nbb/Node handler of the entropy/draw ability
  (catalog wire 23; superproject adr-2609242330 S5, section 1 (c)). Not
  Kotoba source: a compiler module writes `(entropy/draw \"16\")` and
  requires this namespace only under `#?(:cljs ...)`.

  The request is a decimal byte count N, 1..256; the answer is 2N lowercase
  hex characters from the host's CSPRNG -- the catalog's shape, and what the
  Linux static ELF answers with getrandom(2). Here it is one
  crypto.randomBytes call. A request outside the wire's shape throws by name
  (the static image traps). See kotoba.compiler.nbb.host.io."
  {:kotoba/export [draw]}
  )

(defn draw
             "entropy/draw 23 (the ability itself; its handler comes from the target profile)."
             [request :string] :string
             (entropy/draw request))
