(ns kotoba.compiler.nbb.host.sys
  "MECHANISM LAYER -- facts about the nbb/Node process that a compiler module
  reads and no catalog ability carries (superproject adr-2609242330 S5,
  section 1 (c)). Not Kotoba source: required only under `#?(:cljs ...)`,
  and every caller gives the Kotoba reading its own `:default` branch.

    cwd              the working directory (catalog sys/cwd 40's answer)
    windows?         whether the host is Windows -- the compiler's durability
                     and ownership rules name Windows as a stated non-claim
                     (no directory handles, no POSIX owner or mode bits)
    tmpdir           os.tmpdir()
    runtime-version  the Node version, part of the toolchain identity
    argv             the process argv (the runtime's own flags, e.g. the nbb
                     --classpath, which cli/args does not carry)
    path-delimiter   the classpath separator of this platform
    homedir          os.homedir()

  Each is one property read; nothing here decides. See
  kotoba.compiler.nbb.host.io."
  {:kotoba/export [cwd]}
    (:require [ :as os])
)

(defn cwd
           "sys/cwd 40 (the ability itself)."
           [request :string] :string
           (sys/cwd request))






