(ns kotoba.compiler.nbb.host.io
  "MECHANISM LAYER -- the nbb/Node handler of the stdio abilities
  (superproject adr-2609242330 S5, section 1 (c)). Not Kotoba source.

  A compiler module names these operations as abilities -- `(io/write s)`,
  `(io/write-error s)`, `(io/read request)` -- and requires this namespace
  only under `#?(:cljs ...)`. Under Kotoba the same call elaborates to
  `typed-cap-call` on the catalog wire (io/write 37, io/write-error 39,
  io/read 41) and its handler comes from the target profile (the Linux
  static ELF handlers, amu tools/linux_static_handlers.kotoba). Under nbb
  the alias resolves here, and each function is one Node call.

  The request and answer shapes are the catalog's (`:string -> :string`):
  a write answers the decimal count of UTF-8 bytes written, as the kexe
  loader and the static ELF handler do. Nothing here decides anything; a
  request outside the wire's shape throws.

  kotoba-lang scripts/measure-selfhost-distance.cljk lists this directory
  as the named mechanism-layer exception, not as a refused module."
  {:kotoba/export []}
  (:refer-clojure :exclude [read])
  (:require ["node:fs" :as fs]))

(defn- byte-count [text]
  (str (.byteLength js/Buffer text "utf8")))

(defn write
  "io/write 37: TEXT to fd 1; answers the decimal byte count."
  [text]
  (.write js/process.stdout text)
  (byte-count text))

(defn write-error
  "io/write-error 39: TEXT to fd 2; answers the decimal byte count."
  [text]
  (.write js/process.stderr text)
  (byte-count text))

;; io/read 41 keeps one cursor for both forms, and the decimal form holds an
;; incomplete UTF-8 tail for the next answer (the loader's
;; incomplete_utf8_tail, the static handler's op 9).
(def ^:private held (volatile! (.alloc js/Buffer 0)))

(defn- utf8-tail-length [buffer]
  (let [n (.-length buffer)]
    (loop [back 0]
      (if (or (>= back 3) (>= back n))
        0
        (let [b (aget buffer (- n 1 back))]
          (cond
            (= 0x80 (bit-and b 0xC0)) (recur (inc back))
            (>= b 0xF0) (if (< back 3) (inc back) 0)
            (>= b 0xE0) (if (< back 2) (inc back) 0)
            (>= b 0xC0) (if (< back 1) (inc back) 0)
            :else 0))))))

(defn- decode [buffer]
  (.decode (js/TextDecoder. "utf-8" #js {:fatal true}) buffer))

(defn read
  "io/read 41: the empty REQUEST answers everything to EOF; a decimal
  REQUEST answers at most that many bytes not yet answered, the empty
  string at EOF."
  [request]
  (if (= "" request)
    (let [rest (.readFileSync fs 0)
          all (.concat js/Buffer #js [@held rest])]
      (vreset! held (.alloc js/Buffer 0))
      (decode all))
    (do
      (when-not (re-matches #"[0-9]{1,19}" request)
        (throw (ex-info "io/read request must be empty or a decimal count"
                        {:phase :host :request request})))
      (let [want (js/Number request)
            buffer (.alloc js/Buffer want)
            got (if (pos? want)
                  (try (.readSync fs 0 buffer 0 want nil)
                       (catch :default error
                         (if (= "EOF" (.-code error)) 0 (throw error))))
                  0)
            all (.concat js/Buffer #js [@held (.subarray buffer 0 got)])
            hold (if (zero? got) 0 (utf8-tail-length all))]
        (vreset! held (.subarray all (- (.-length all) hold)))
        (decode (.subarray all 0 (- (.-length all) hold)))))))
