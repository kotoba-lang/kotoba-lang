(ns kotoba.compiler.nbb.host.cli
  "MECHANISM LAYER -- the nbb/Node handler of the cli/args ability
  (catalog wire 38; superproject adr-2609242330 S5, section 1 (c)). Not
  Kotoba source: a compiler module writes `(cli/args request)` and requires
  this namespace only under `#?(:cljs ...)`. The empty REQUEST answers the
  argument count, a decimal answers that argument (zero-based) or the empty
  string past the end -- the catalog's shape. The arguments are the ones nbb
  hands the script (`*command-line-args*`), which is what every entrypoint
  read before this layer existed. See kotoba.compiler.nbb.host.io."
  {:kotoba/export []})

(defn args
  "cli/args 38."
  [request]
  (let [argv (vec *command-line-args*)]
    (if (= "" request)
      (str (count argv))
      (do
        (when-not (re-matches #"[0-9]{1,19}" request)
          (throw (ex-info "cli/args request must be empty or a decimal index"
                          {:phase :host :request request})))
        (nth argv (js/Number request) "")))))
