(ns kotoba.compiler.nbb.host.process
  "MECHANISM LAYER -- the nbb/Node handler of the process/spawn ability
  (catalog wire 20; superproject adr-2609242330 S5, section 1 (c)). Not
  Kotoba source: a compiler module writes `(process/spawn request)` and
  requires this namespace only under `#?(:cljs ...)`.

  The wire is the Linux static ELF's (superproject adr-2609251400 C3):

    request  <program>[ARG_SEP<arg>]...
    answer   <exit>, a newline, then the child's stdout
             (<exit> is -1 for a child ended by a signal)

  THE GRANT. The static image seals `:linux-static :spawn {:programs ...
  :path-lookup ... :env ...}` from the compile policy. This profile's grant
  is the data below, and the handler holds to the same posture where Node
  allows it:

    * no shell -- child_process.spawnSync with an explicit argv, shell false;
    * programs: only the names in `programs`. \"node\" is the running Node
      binary (process.execPath), never a `node` found on PATH; \"git\" is
      looked up on the child's PATH (the static grant's `:path-lookup true`).
      Any other name, and any absolute path that is not a granted one, is
      refused by name (:spawn/program-not-granted);
    * the child's environment is empty except the names in `env`;
    * stdin is at EOF, stdout is captured, stderr is the parent's own
      (the static image passes fd 2 through the same way);
    * output: `max-output` bytes (the largest the compiler's spawnSync calls
      allowed before this layer, 64 MiB); more is refused by name
      (:spawn/output-budget);
    * a child that cannot be started is refused by name (:spawn/exec-failed).

  Where this profile departs from the catalog's `:process/spawn` rules
  (kotoba-lang lang/capability-catalog.edn, one grammar for every host), by
  name, and why: \"git\" is looked up on $PATH (the compiler has no canonical
  path for it to seal); no 32-argument / 4,096-byte argv budget (`amu test`
  passes a whole generated ES module as one `-e` argument); 64 MiB of output,
  not 16 KiB; no 10 s deadline (`git clone` of a package has none today); no
  descriptor closing beyond Node's defaults and no no_new_privs (Node has no
  such option -- the catalog records the js host the same way). A request
  that is not the wire's shape (empty program, NUL) throws. See
  kotoba.compiler.nbb.host.io."
  {:kotoba/export []}
  (:require ["node:child_process" :as child]))

(def programs
  "Granted program name -> what Node is asked to run."
  {"node" :exec-path
   "git" "git"})

(def env
  "Environment names the child inherits; every other name is dropped."
  ["PATH" "HOME" "USER" "LOGNAME" "LANG" "LC_ALL" "LC_CTYPE"
   "TMPDIR" "TMP" "TEMP" "SYSTEMROOT" "SystemRoot" "USERPROFILE" "APPDATA"
   "LOCALAPPDATA" "SSH_AUTH_SOCK" "GIT_SSH" "GIT_SSH_COMMAND" "GIT_ASKPASS"
   "GIT_TERMINAL_PROMPT" "GIT_CONFIG_GLOBAL" "GIT_CONFIG_NOSYSTEM"
   "XDG_CONFIG_HOME" "HTTP_PROXY" "HTTPS_PROXY" "NO_PROXY"
   "http_proxy" "https_proxy" "no_proxy"])

(def max-output (* 64 1024 1024))

(defn- refuse! [reason detail]
  (throw (ex-info (str "process/spawn refused: " (name reason))
                  (merge {:phase :host :reason reason} detail))))

(defn- program-path [program]
  (let [granted (get programs program)]
    (cond
      (= :exec-path granted) (.-execPath js/process)
      (string? granted) granted
      (= program (.-execPath js/process)) program
      :else (refuse! :spawn/program-not-granted {:program program}))))

(defn- child-env []
  (let [out #js {}]
    (doseq [k env]
      (when-some [v (aget js/process.env k)]
        (aset out k v)))
    out))

(defn spawn
  "process/spawn 20."
  [request]
  (when (.includes request "\u0000")
    (throw (ex-info "process/spawn request must not hold NUL" {:phase :host})))
  (let [[program & args] (vec (.split request "ARG_SEP"))]
    (when (= "" program)
      (throw (ex-info "process/spawn request names no program" {:phase :host})))
    (let [r (.spawnSync child (program-path program) (clj->js (vec args))
                        #js {:shell false
                             :env (child-env)
                             :stdio #js ["ignore" "pipe" "inherit"]
                             :encoding "utf8"
                             :maxBuffer max-output})
          error (.-error r)]
      (cond
        (and error (= "ENOBUFS" (.-code error)))
        (refuse! :spawn/output-budget {:program program :limit max-output})

        error
        (refuse! :spawn/exec-failed {:program program :code (.-code error)})

        :else
        (str (if (some? (.-status r)) (.-status r) -1) "\n" (or (.-stdout r) ""))))))
