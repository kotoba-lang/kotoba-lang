(ns kotoba.compiler.text-bytes
  "Text and bytes, measured and converted -- leaves with two readings
  (superproject adr-2609242330 section 1 (b), the S1 leaf pattern).

  Under Kotoba a string IS its UTF-8 bytes and bytes are the `:bytes` type,
  so each leaf is a builtin (`string-byte-length`, `bytes-count`,
  `string-from-utf8`, `string-to-utf8`). Under nbb a string is UTF-16 and bytes are a
  Uint8Array, and each leaf is the Node call the compiler used before
  (Buffer.byteLength, .length, a fatal TextDecoder). Not abilities:
  measuring or decoding a value observes nothing.

  `utf8-text` refuses what is not canonical UTF-8 in both readings: the
  fatal decoder throws, `string-from-utf8` traps by name."
  {:kotoba/export [byte-at bytes-from-ints bytes-length concat-bytes empty-bytes index-of-byte slice-bytes utf8-bytes utf8-length utf8-text utf8-text-lossy utf8-valid?]})

(defn utf8-length
  "The number of bytes TEXT occupies in UTF-8."
  [text :string] :i64
  (string-byte-length text))

(defn bytes-length
  "The number of bytes in BYTES."
  [bytes :bytes] :i64
  (bytes-count bytes))

(defn utf8-text
  "BYTES decoded as UTF-8; refused when they are not canonical UTF-8."
  [bytes :bytes] :string
  (string-from-utf8 bytes))

(defn bytes-from-ints
  "Bytes holding the integers of INTS in order, each already 0..255."
  [ints :vector-i64] :bytes
  (bytes-from-vector-i64 ints))

(defn utf8-bytes
  "TEXT's UTF-8 bytes. The Kotoba primitive preserves every UTF-8 byte,
  including continuation bytes above 127."
  [text :string] :bytes
  (string-to-utf8 text))

(defn utf8-text-lossy
  "BYTES decoded as UTF-8, an invalid sequence read as U+FFFD -- what
  Buffer#toString(\"utf8\") answers. Kotoba has no lossy decoder, so its
  reading refuses such bytes by name (string-from-utf8)."
  [bytes :bytes] :string
  (string-from-utf8 bytes))

(defn empty-bytes
  "Bytes of length 0."
  [] :bytes
  (bytes-empty))

(defn concat-bytes
  "A followed by B."
  [a :bytes b :bytes] :bytes
  (bytes-concat a b))

(defn byte-at
  "The byte at offset I of BYTES, 0..255."
  [bytes :bytes i :i64] :i64
  (bytes-at bytes i))

(defn slice-bytes
  "BYTES from START (inclusive) to END (exclusive). Under nbb a view that
  shares the buffer (subarray), as the callers used before."
  [bytes :bytes start :i64 end :i64] :bytes
  (bytes-slice bytes start end))

(defn index-of-byte
  "The first offset of the byte B in BYTES, or -1."
  [bytes :bytes b :i64] :i64
  (loop [i 0]
                (cond (>= i (bytes-count bytes)) -1
                      (= b (bytes-at bytes i)) i
                      :else (recur (inc i)))))

;; Kotoba only (2026-10-10): whether BYTES are canonical UTF-8, so a reader can
;; refuse malformed input BY NAME before `string-from-utf8`, which traps (the
;; loader's value trap :utf8/invalid-byte, exit 120) and leaves nothing to
;; catch. The walk is the loader's utf8_invalid_reason (tools/kexe_loader.c,
;; = osaho kotoba.kir.value/utf8-invalid-at): no stray continuation byte, no
;; overlong lead (C0 C1, E0 below A0, F0 below 90), no surrogate (ED A0..),
;; nothing above U+10FFFF (F4 90.., F5..), no truncated sequence. It accepts
;; exactly what `string-from-utf8` accepts, and what the host's fatal
;; TextDecoder accepts. The host readings keep their decoder's own refusal.
(defn- utf8-continuation? [b :i64] :bool
     (= 128 (bit-and b 192)))

(defn utf8-valid? [bytes :bytes] :bool
     (let [n (bytes-count bytes)]
       (loop [i 0]
         (if (>= i n)
           true
           (let [b0 (bytes-at bytes i)]
             (cond
               (< b0 128) (recur (+ i 1))
               (or (< b0 194) (> b0 244)) false
               (>= (+ i 1) n) false
               :else
               (let [b1 (bytes-at bytes (+ i 1))
                     k (if (< b0 224) 1 (if (< b0 240) 2 3))]
                 (if (or (not (utf8-continuation? b1))
                         (and (= b0 224) (< b1 160))
                         (and (= b0 240) (< b1 144))
                         (and (= b0 237) (>= b1 160))
                         (and (= b0 244) (>= b1 144))
                         (>= (+ i k) n)
                         (and (>= k 2) (not (utf8-continuation? (bytes-at bytes (+ i 2)))))
                         (and (>= k 3) (not (utf8-continuation? (bytes-at bytes (+ i 3))))))
                   false
                   (recur (+ i (+ k 1)))))))))))
