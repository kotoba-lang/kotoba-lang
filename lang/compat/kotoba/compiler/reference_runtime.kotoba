(ns kotoba.compiler.reference-runtime
  "Portable CLJ/CLJS reference application runtime. This is the executable
  language oracle; AOT/JIT backends qualify against the same KIR and vectors."
  {:kotoba/export [max-providers runtime-format]}
  (:require  [kotoba.compiler.authority :as authority] [kotoba.kir :as ir]))

;; Kotoba: an exported constant is a function returning it. The runtime itself
;; is the host route's alone -- it interprets KIR with open provider maps
;; (`{:invoke f :scope f}`), arbitrary host closures and BigInt-keyed sets, none
;; of which a Kotoba module can hold -- so the Kotoba surface is its format and
;; its provider ceiling, which a caller compares against.
(defn runtime-format [] :keyword :kotoba.reference-runtime/v1)
(defn max-providers [] :i64 256)

nil
