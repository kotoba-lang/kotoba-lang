(ns kotoba.compiler.json-text
  "JSON text of a vector of scalars -- the compiler's cache-key material --
  as one leaf with two readings (superproject adr-2609242330 section 1
  (b), the S1 leaf pattern).

  Under Kotoba the leaf is the pure library, kotoba-lang/json
  (`kotoba.lang.json/encode`). Under nbb it is `JSON.stringify`, because the
  pure library runs interpreted there and was measured 2026-09-25 at 513 ms
  against 4.1 ms for one 500,000-character string -- and the compile cache
  key serializes the whole source text on every compile. Both readings give
  the same bytes for a vector of strings, booleans and nils:
  test/nbb/host_abilities.cljk compares them over a seeded random corpus of
  escapes, control characters and non-ASCII text.

  Vectors only, and on purpose. For a MAP the two readings differ: the pure
  library writes keys sorted, JSON.stringify in the map's iteration order
  (measured 2026-09-25). The worker responses and the timing report are
  maps, so they stay on the host's JSON in cli-support until a key-order
  contract is chosen; a cache key must be the same bytes in both readings,
  because it is hashed and reported (`:emit-cache-key`).

  Not an ability: serializing a value observes nothing, so there is no
  handler and no grant -- only a faster reading of the same function."
  {:kotoba/export [decode-object encode-array encode-value]}
  ;; The pure library is the Kotoba reading's dependency only: nbb takes the
  ;; :cljs branch and never loads it (compile_cache is loaded from a bare
  ;; `src` classpath by test/nbb/compile_cache.cljk).
  (:require [kotoba.lang.json :as json]))

(defn encode-array
  "ITEMS -- a vector of strings, booleans and nils -- as JSON text."
  [items :document]
  :string
  (json/encode items))

;; Maps, and reading. Under nbb these stay the host's JSON -- a named
;; exception (superproject adr-2609242330 S5, S2 item): the pure library
;; writes a map's keys sorted where JSON.stringify keeps insertion order, so
;; the worker responses and the timing report would change bytes; and pure
;; decode was measured 2026-09-25 at 0.13 ms against 0.010 ms for a typical
;; 170-byte worker request and 27 ms against 0.21 ms at the 60 KB bound,
;; with different error messages for a malformed line. Under Kotoba the
;; reading is the pure library.

(defn encode-value
  "VALUE (maps, vectors, strings, numbers, booleans, nil; keyword keys) as
  JSON text."
  [value :document]
  :string
  (json/encode value))

(defn keyword-key
     [k :document] :document
     (match-option (document-string-value k) [:option :string]
       (none k)
       (some s (document-keyword (keyword-from-string s)))))

(defn member-of
     [v :document k :document] :document
     (match-option (get v k) [:option :document]
       (none (document-null))
       (some x x)))

(defn walk-doc
     [v :document] :document
     (cond (map? v) (reduce (fn [acc k] (assoc acc (keyword-key k) (walk-doc (member-of v k)))) (document-map) (keys v))
           (vector? v) (walk-items v)
           :else v))

(defn- walk-items
     [v :document] :document
     (let [n (document-count v)]
       (loop [i 0 acc (document-vector)]
         (if (>= i n)
           acc
           (recur (inc i)
                  (document-vector-conj acc (walk-doc (option-value-of [:option :document]
                                                                       (document-vector-at v i)
                                                                       (document-null)))))))))

(defn decode-object
  "JSON TEXT as a value, object keys as keywords."
  [text :string]
  :document
  (walk-doc (json/decode text)))
