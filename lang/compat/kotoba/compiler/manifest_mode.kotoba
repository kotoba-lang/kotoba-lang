(ns kotoba.compiler.manifest-mode
  "`amu test --manifest <manifest.edn>` -- the one conformance runner of root
  ADR-2610092330 (step C0).

  Reads a language conformance manifest (kotoba-lang's
  `lang/conformance/manifest.edn` is the one it exists for) and runs every
  case on the backends this runner can drive that the case's class declares
  (required or optional), compares with the case's :expect, and answers one
  report keyed by case id and backend:

    {case-id {backend {:status :pass|:fail|:refused|:skipped
                       :value v :reason r :required? bool}}}

  Backends driven (C0): `:kir`, `:js-kotoba-v1`, `:wasm32-kotoba-v1` -- the
  three targets `amu test` already runs, through the same emitters and probes
  (`kotoba.compiler.test-profile/call-source`) -- and `:compiler-admit`, the
  frontend admission an `:expect-error` case is about.

  Native (C1): given a measured runtime (`:native {:runtime-dir d}`), the
  host's own native backend (`:native-aarch64` on an arm64 host,
  `:native-x86_64` on an x64 one) runs every in-scope :run case whose class
  lists it: compile for the host target, sign with the runtime's key, run
  under its measured loader, compare `[:result :result]` with :expect
  (`kotoba.compiler.manifest-native`). A compile refusal is `:refused` with
  the compiler's message. The other ISA's native backend, and the host's
  without a runtime, are `:skipped` with a reason that says why and, for the
  latter, how to supply one.

  Out of scope, reported under `:skipped-cases` with a reason rather than run:
  every case whose class has `:profile :host-compat` (the host-clj /
  host-cljs embeds belong to kotoba-lang's own host runners).

  A report is `:ok` only when at least one case ran and every REQUIRED
  backend of every in-scope case is `:pass`. Zero cases run is a failure, not
  a vacuous pass (ADR-2610092330 decision 7). An optional backend's `:fail`,
  `:refused` or `:skipped` is reported with its reason and does not change
  `:ok`."
  {:kotoba/export [backend-targets driven-backends human-lines native-backends no-runtime-reason
                  run-manifest runner-name]}
  (:require [kotoba.compiler.bounded-edn :as bounded-edn]
            [kotoba.compiler.core :as compiler]
            [kotoba.compiler.manifest-native :as manifest-native]
            [kotoba.compiler.posix-path :as posix-path]
            [kotoba.compiler.project :as project]
            [kotoba.compiler.project-files :as project-files]
            [kotoba.compiler.source-path :as source-path]
            [kotoba.compiler.test-profile :as test-profile]
            [kotoba.compiler.host-integer :as host-integer]
            [kotoba.lang.text :as str]
            [kotoba.sema :as sema]))

(def runner-name
  "The name kotoba-lang's `:executed-by` can cite for a row this runner
  produced."
  "kotoba-lang/amu amu test --manifest")

(def backend-targets
  "Manifest backend id -> the `amu test` target that drives it."
  {:kir :jvm-kir
   :js-kotoba-v1 :js
   :wasm32-kotoba-v1 :wasm})

(def driven-backends
  (conj (set (keys backend-targets)) :compiler-admit))

(def native-backends #{:native-aarch64 :native-x86_64})

(def no-runtime-reason
  (str "no measured native runtime: pass --native-runtime <dir> (key.edn,"
       " pinned-trust.edn, runtime.edn, kotoba-loader), or --native-prepare <dir>"
       " to measure one there first (KOTOBA_LOADER_SOURCE_DIR / --loader-source-dir"
       " names the reviewed kexe_loader.c)"))

(def ^:private not-yet-driven
  {:host-clj "host-compat backend; driven by kotoba-lang's host runners, not amu"
   :host-cljs "host-compat backend; driven by kotoba-lang's host runners, not amu"})

(def ^:private run-kinds #{:run :compile-expr})
(def ^:private admit-kinds #{:expect-error :extension-error})

(defn- integer-like? [x]
  (or (integer? x) (host-integer/bigint? x)))

(defn- show
  "VALUE as a report sentence spells it: an integer as its decimal text (a
  BigInt's `pr-str` under nbb is `#object[BigInt 42]`)."
  [value]
  (if (integer-like? value) (str value) (pr-str value)))

(defn- same-value?
  "`=`, except that an integer compares by its decimal text: under nbb the
  manifest's integers and the KIR oracle's are BigInts while a decoded probe
  value may be either, and on the JVM a Long and a BigInt of one value are
  not `=`."
  [expected actual]
  (if (and (integer-like? expected) (integer-like? actual))
    (= (str expected) (str actual))
    (= expected actual)))

(defn- class-of [manifest kase]
  (get-in manifest [:case-classes (:class kase)]))

(defn- required-of [manifest kase]
  (set (or (:required-backends kase) (:required-backends (class-of manifest kase)))))

(defn- optional-of [manifest kase]
  (let [required (required-of manifest kase)]
    (set (remove required (or (:optional-backends kase)
                              (:optional-backends (class-of manifest kase)))))))

(defn- out-of-scope-reason [manifest kase]
  (let [klass (class-of manifest kase)]
    (cond
      (nil? (:class kase)) nil
      (nil? klass) nil
      (= :host-compat (:profile klass))
      (str "class " (:class kase) " has :profile :host-compat; host-clj/host-cljs "
           "embeds are run by kotoba-lang's host runners, not by amu (C0 scope)"))))

;; --- sources ----------------------------------------------------------------

(defn- entry-path [root entry]
  (posix-path/join root entry))

(defn- case-source
  "{:source text :linked? bool} for a :run / :compile-expr case, or throws."
  [root kase]
  (case (:kind kase)
    :compile-expr
    (let [fname (or (:function kase) "main")]
      (when-not (string? (:expr kase))
        (throw (ex-info "a :compile-expr case needs an :expr string" {:phase :manifest})))
      {:source (str "(ns conformance.expr (:export [" fname "]))\n"
                    "(defn " fname " [] " (:expr kase) ")\n")
       :linked? false})
    (let [entry (:entry kase)
          _ (when-not (string? entry)
              (throw (ex-info "the case names no :entry" {:phase :manifest})))
          path (source-path/admit! (entry-path root entry))]
      (if-let [roots (seq (:source-paths kase))]
        (let [graph (project-files/load-closed-graph path (mapv #(posix-path/join root %) roots))
              linked (project/link-source (:sources graph) (:root graph))]
          {:source (:source linked) :linked? true})
        {:source (bounded-edn/read-text-file path) :linked? false}))))

;; --- rows -----------------------------------------------------------------

(defn- row
  ([status required?] {:status status :required? required?})
  ([status required? more] (merge {:status status :required? required?} more)))

;; --- native -----------------------------------------------------------------

(defn- native-job
  "The `manifest-native/run-jobs` job for KASE, or `{:refused why}` when its
  source cannot be named."
  [root kase]
  (try
    (case (:kind kase)
      :compile-expr
      {:id (:id kase) :source (:source (case-source root kase))
       :function (or (:function kase) "main") :args (vec (or (:args kase) []))}
      (let [entry (:entry kase)
            _ (when-not (string? entry)
                (throw (ex-info "the case names no :entry" {:phase :manifest})))
            path (source-path/admit! (entry-path root entry))]
        {:id (:id kase) :entry path
         :source-paths (mapv #(posix-path/join root %) (:source-paths kase))
         :function (or (:function kase) "main") :args (vec (or (:args kase) []))}))
    (catch  error
      {:id (:id kase) :refused (or (ex-message error) (str error))})))

(defn- backends-of [manifest kase]
  (into (required-of manifest kase) (optional-of manifest kase)))

(defn- native-results
  "Run every in-scope :run / :compile-expr case whose backends include the
  host's native backend, when NATIVE names a runtime. Answers `{case-id
  answer}` (see `manifest-native/run-jobs`)."
  [root manifest cases native host]
  (when (and native host)
    (let [wanted (filter #(and (run-kinds (:kind %))
                               (contains? (:expect %) :kotoba)
                               (contains? (backends-of manifest %) host))
                         cases)
          jobs (map #(native-job root %) wanted)
          refused (into {} (for [j jobs :when (:refused j)]
                             [(:id j) {:refused (str "source: " (:refused j)) :phase :source}]))
          ran (manifest-native/run-jobs (remove :refused jobs) (:runtime-dir native)
                                        {:parallel (:parallel native)})]
      (merge (:results ran) refused))))

(defn- native-row [kase backend required native host answers]
  (let [req? (contains? required backend)
        expect (get-in kase [:expect :kotoba])
        answer (get answers (:id kase))]
    (cond
      (admit-kinds (:kind kase))
      (row :skipped req? {:reason "an admission case has nothing to execute"})
      (not (run-kinds (:kind kase)))
      (row :skipped req? {:reason (str "unknown case :kind " (pr-str (:kind kase)))})
      (not= host backend)
      (row :skipped req? {:reason (str "native backends run on their own ISA only; this host's is "
                                       (if host (name host) "none"))})
      (nil? native)
      (row :skipped req? {:reason no-runtime-reason})
      (not (contains? (:expect kase) :kotoba))
      (row :skipped req? {:reason "the case has no :expect :kotoba value"})
      (contains? answer :value)
      (if (same-value? expect (:value answer))
        (row :pass req? {:value (:value answer)})
        (row :fail req? {:value (:value answer)
                         :reason (str "expected " (show expect) ", got " (show (:value answer)))}))
      (contains? answer :trap)
      (row :fail req? {:reason (str "trap: " (:trap answer))})
      (contains? answer :refused)
      (row :refused req? {:reason (str (name (:phase answer)) ": " (:refused answer))})
      :else
      (row :skipped req? {:reason "the native run answered nothing for this case"}))))

(defn- run-rows
  "Rows for a :run / :compile-expr case on its driven execution backends."
  [root kase backends required fuel]
  (let [exec (filter backend-targets backends)
        expect (get-in kase [:expect :kotoba])
        targets (mapv backend-targets exec)]
    (cond
      (empty? exec) {}

      (not (contains? (:expect kase) :kotoba))
      (into {} (for [b exec]
                 [b (row :skipped (contains? required b)
                         {:reason "the case has no :expect :kotoba value"})]))

      :else
      (let [prepared (try {:ok (case-source root kase)}
                          (catch  error
                            {:error (or (ex-message error) (str error))}))]
        (if-let [why (:error prepared)]
          (into {} (for [b exec]
                     [b (row :refused (contains? required b)
                             {:reason (str "source: " why)})]))
          (let [{:keys [source linked?]} (:ok prepared)
                case-fuel (:fuel kase)
                answers (test-profile/call-source
                         source (or (:function kase) "main") (vec (or (:args kase) []))
                         (cond-> {:targets targets}
                           (or case-fuel fuel) (assoc :fuel (host-integer/narrow (or case-fuel fuel)))
                           linked? (assoc :admit-linked-synthetics? true)))]
            (into {}
                  (for [b exec
                        :let [answer (get answers (backend-targets b))
                              req? (contains? required b)]]
                    [b (cond
                         (contains? answer :value)
                         (if (same-value? expect (:value answer))
                           (row :pass req? {:value (:value answer)})
                           (row :fail req? {:value (:value answer)
                                            :reason (str "expected " (show expect)
                                                         ", got " (show (:value answer)))}))
                         (= :run (:phase answer))
                         (row :fail req? {:reason (str "trap: " (:error answer))})
                         :else
                         (row :refused req? {:reason (str (name (or (:phase answer) :compile))
                                                          ": " (:error answer))}))]))))))))

(defn- admit-row
  "The :compiler-admit row of an :expect-error / :extension-error case."
  [root kase required?]
  (let [needle (:error-contains kase)
        refusal (try
                  (let [path (entry-path root (:entry kase))]
                    (source-path/admit! path)
                    ;; The frontend first (what kotoba-lang's own runners
                    ;; call), then amu's admission on top of it: a fixture the
                    ;; frontend admits can still be refused by policy, and
                    ;; that refusal is the one this compiler would print.
                    (when (= :expect-error (:kind kase))
                      (let [source (bounded-edn/read-text-file path)]
                        (sema/analyze source)
                        (compiler/check-source source {} {})))
                    nil)
                  (catch  error
                    (or (ex-message error) (str error))))]
    (cond
      (not (string? needle))
      (row :skipped required? {:reason "the case has no :error-contains string"})
      (nil? refusal)
      (row :fail required? {:reason (str "admitted; expected a refusal containing " (pr-str needle))})
      (str/includes? refusal needle)
      (row :pass required? {:value refusal})
      :else
      (row :fail required? {:value refusal
                            :reason (str "refused for another reason; expected the message to contain "
                                         (pr-str needle))}))))

(defn- case-rows [root manifest kase fuel native host native-answers]
  (let [required (required-of manifest kase)
        optional (optional-of manifest kase)
        backends (sort (into required optional))
        kind (:kind kase)
        undriven (into {}
                       (for [b backends :when (and (not (driven-backends b))
                                                   (not (native-backends b)))]
                         [b (row :skipped (contains? required b)
                                 {:reason (get not-yet-driven b
                                               (str "backend " b " is not known to this runner"))})]))]
    (merge undriven
           (into {} (for [b backends :when (native-backends b)]
                      [b (native-row kase b required native host native-answers)]))
           (cond
             (run-kinds kind)
             (merge (run-rows root kase backends required fuel)
                    (when (contains? (set backends) :compiler-admit)
                      {:compiler-admit (row :skipped (contains? required :compiler-admit)
                                            {:reason "a :run case has no admission expectation"})}))
             (admit-kinds kind)
             (merge (into {} (for [b backends :when (backend-targets b)]
                               [b (row :skipped (contains? required b)
                                       {:reason "an admission case has nothing to execute"})]))
                    (when (contains? (set backends) :compiler-admit)
                      {:compiler-admit (admit-row root kase (contains? required :compiler-admit))}))
             :else
             (into {} (for [b backends :when (driven-backends b)]
                        [b (row :skipped (contains? required b)
                                {:reason (str "unknown case :kind " (pr-str kind))})]))))))

;; A backend the case records in `:unexecuted-backends` is DEFERRED: it is
;; expected not to pass, and its row says so instead of counting as a required
;; failure. A deferral is not a parking space, so both ways out are checked:
;; a deferred backend that passes is `:deferral-outlived` (the record outlived
;; what it excused -- move the backend to :executed-by), and a deferral that
;; names `:refused-with` must still be refused with that text.
(defn- apply-deferrals [kase rows]
  (reduce-kv
   (fn [rows backend deferral]
     (if-let [r (get rows backend)]
       (assoc rows backend
              (cond
                (= :pass (:status r))
                (assoc r :status :deferral-outlived
                       :reason (str "recorded in :unexecuted-backends (as of " (:as-of deferral)
                                    ") but it passes: move it to :executed-by"))

                (and (string? (:refused-with deferral))
                     (not (str/includes? (str (:reason r)) (:refused-with deferral))))
                (assoc r :status :deferral-reason-changed
                       :reason (str "deferred as refused with " (pr-str (:refused-with deferral))
                                    ", measured " (pr-str (:reason r))))

                :else
                (assoc r :status :deferred :measured (:status r) :required? false)))
       rows))
   rows
   (or (:unexecuted-backends kase) {})))

;; --- report -----------------------------------------------------------------

(defn- ran? [rows]
  (some #(contains? #{:pass :fail :refused :deferred :deferral-outlived :deferral-reason-changed}
                     (:status %))
        (vals rows)))

(defn- required-failures [results]
  (vec (for [[id rows] results
             [backend r] rows
             :when (and (:required? r) (not= :pass (:status r)))]
         {:case id :backend backend :status (:status r) :reason (:reason r)})))

(defn- by-backend [results]
  (reduce (fn [acc [_ rows]]
            (reduce (fn [acc [backend r]]
                      (update-in acc [backend (:status r)] (fnil inc 0)))
                    acc rows))
          (sorted-map) results))

(defn run-manifest
  "Run MANIFEST (a map) with fixtures under ROOT. `opts`: `:fuel`,
  `:only` (a set of kase ids), `:native` (`{:runtime-dir d :parallel n}`, a
  measured native runtime; absent, native rows are :skipped saying how to
  supply one). Answers the report."
  [manifest root {:keys [fuel only manifest-path native]}]
  (let [cases (cond->> (:cases manifest)
                (seq only) (filter #(contains? only (:id %))))
        skipped (into (sorted-map)
                      (keep (fn [c] (when-let [why (out-of-scope-reason manifest c)]
                                      [(:id c) why])))
                      cases)
        in-scope (remove #(contains? skipped (:id %)) cases)
        host (manifest-native/host-backend)
        native-answers (native-results root manifest in-scope native host)
        results (into (sorted-map)
                      (map (fn [c] [(:id c) (apply-deferrals c (case-rows root manifest c fuel
                                                                          native host native-answers))]))
                      in-scope)
        ran (count (filter ran? (vals results)))
        failures (required-failures results)]
    {:format :kotoba.conformance-report/v1
     :runner runner-name
     :manifest manifest-path
     :conformance-root root
     :driven-backends (vec (sort (cond-> driven-backends (and native host) (conj host))))
     :native (if (and native host)
               {:backend host :runtime-dir (:runtime-dir native)}
               {:backend host :skipped (if host no-runtime-reason "this host has no native backend")})
     :ok (boolean (and (pos? ran) (empty? failures)))
     :totals {:cases (count cases)
              :in-scope (count in-scope)
              :ran ran
              :skipped-cases (count skipped)
              :required-failures (count failures)
              :by-backend (by-backend results)}
     :results results
     :skipped-cases skipped
     :required-failures failures}))

(defn human-lines
  "Summary lines (stdout) and one line per non-passing row that matters
  (stderr): every :fail / :refused, and a required :skipped."
  [report]
  (let [{:keys [cases in-scope ran skipped-cases required-failures by-backend]} (:totals report)]
    {:out (into [(str "kotoba test --manifest: " (if (:ok report) "ok" "FAILED")
                      " cases=" cases " in-scope=" in-scope " ran=" ran
                      " skipped-cases=" skipped-cases
                      " required-failures=" required-failures)]
                (concat
                 (for [[backend counts] by-backend]
                   (str "  " (name backend) ": "
                        (str/join " " (for [s [:pass :fail :refused :skipped]]
                                        (str (name s) "=" (get counts s 0))))))
                 (let [{:keys [backend runtime-dir skipped]} (:native report)]
                   [(str "  native: " (if backend (name backend) "none")
                         (if runtime-dir (str " runtime=" runtime-dir) (str " skipped: " skipped)))])))
     :err (vec (concat
                (for [[id rows] (:results report)
                      [backend r] (sort-by key rows)
                      :when (or (contains? #{:fail :refused :deferral-outlived :deferral-reason-changed}
                                           (:status r))
                                (and (:required? r) (= :skipped (:status r))))]
                  (str " " (if (:required? r) "FAIL" "WARN") " " (name id)
                       " backend=" (name backend) " status=" (name (:status r))
                       (if (:required? r) " required" " optional")
                       (when (:reason r) (str " " (:reason r)))))
                (when (zero? ran)
                  [" FAIL no case ran: a conformance run over zero cases is not a pass"])))}))
