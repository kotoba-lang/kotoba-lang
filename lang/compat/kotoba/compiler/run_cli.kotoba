(ns kotoba.compiler.run-cli
  "`amu measure-runtime` and `amu run` -- the two commands that execute
  something: build and measure the reviewed kexe loader, and run one export
  of a signed native artifact under it and write the receipt.

  One implementation on both hosts (ADR 0348 iteration 8). The executor is
  `kototama.native.executor`, portable since 2026-09-11, and it is a
  RUNTIME, not a compiler leaf: the entrypoints hand its two functions in
  (see `executor-fn`) and it lives under the `:native-run` alias of deps.edn
  (recorded in deps-lock.edn; `bin/amu` puts that closure on the classpath
  for exactly these two commands), so a compile never carries the loader
  builder and a toolchain walk in its dependency closure. Absent, the
  refusal names the alias.

  `run` RETURNS `{:value ... :exit 120}` for a trapped execution rather
  than exiting: the entrypoint decides the process, the command decides the
  answer. `:now` and the receipt's integers follow the trust plane's rules
  (`kotoba.compiler.trust-cli`)."
  {:kotoba/export [commands dispatch!]}
  (:require ))

;; Kotoba: the two commands execute a signed native artifact under a loader
;; through an executor plugin handed in as a map of host closures, and read
;; and write open EDN maps (envelope, trust, policy, receipt). None of that
;; has a Kotoba spelling, and the plugin is a runtime with no Kotoba host, so
;; on this route the surface is the command names and a refusal that names
;; the reason -- the same shape `cli-support/serve!` takes for worker mode.
(defn commands [] [:list :string]
     (typed-list-new [:list :string] "measure-runtime" "run"))

(defn dispatch! [args [:list :string]] :string
     (throw (ex-info "amu run and measure-runtime are not available on the Kotoba route"
                     {:phase :usage})))

nil
