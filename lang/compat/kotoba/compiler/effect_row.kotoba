(ns kotoba.compiler.effect-row
  "What an inferred effect row holds, and which of its members a capability
  policy decides on.

  Until kotoba-sema e42b74ef a row had one kind of member, `[:cap/call <id>]`:
  an authority the function exercises, which a `--policy` must grant. The
  typed abort ability (kotoba-lang `lang/abort-ability.edn`, slice 1) adds a
  second kind, the bare keyword `:abort`: a TRACKED CONTROL EFFECT. It says the
  function may leave its caller's scope through a typed abort, which the
  frontend has already lowered to a `[:result T E]` value before any consumer
  here sees the body. It names no authority, so there is nothing for a policy
  to grant, and `kotoba.kir.admission/check` -- which decides by
  `(set/difference required allowed)` and only admits `[:cap/call <int>]`
  into `:allow` -- can neither be told to permit it nor asked to.

  Measured 2026-09-02 on this CLI at the pin bump: a module whose helper
  throws and whose `main` catches has the module row `#{:abort}` (the union
  of function rows, one of which aborts), and `amu compile --target wasm32`
  answered `capability policy denies required effects` for a program that
  exercises no capability at all. Every `admission/check` call in this
  repository was handed the raw row.

  This namespace is the one place that knows the difference, so that the
  sites which destructure a row -- `(first effect)`, `[[effect id]]`,
  `(second effect)` -- do not each rediscover that a keyword has no `first`.

  Narrowing is by KNOWN control effect, never by shape. A member this
  namespace does not recognise is kept and reaches admission, where it is
  refused as a grant nobody made. Dropping every non-vector would turn a
  misspelt or newly invented row member into a silent pass -- the shape of
  failure where an unmeasured check returns what a passing check returns.

  Provenance, the interface report, the logic manifest and `check`'s printed
  `:effects` all keep the row as the frontend inferred it, `:abort` included:
  a reader of those is entitled to know the function aborts. Only the
  admission decision is narrowed."
  ;; Exports in the ns ATTR-MAP (grammar `:ns :attr-map`): the spelling both
  ;; hosts accept -- SCI's `ns` refuses an `(:export ...)` clause, and `amu
  ;; check` in project mode refuses a module without one.
  {:kotoba/export [control-effect? grant? grants admissible check]}
  (:require [kotoba.compiler.effect-classification :as classification]
            [kotoba.kir.admission :as admission]
            [kotoba.form :as form] [kotoba.lang.coll :as set])
  ;; Kotoba: a row, a HIR and a policy are `:form/r` values (kotoba.form), and
  ;; kotoba.kir.admission's typed reading takes and answers Forms (osaho, 2026-10-10:
  ;; until then the policy crossed as a `:document`, whose containers hold at most 32
  ;; items, and a policy with 33 or more grants trapped).
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                 [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]}))

(defn control-effects [] [:ref :form/r]
     (form/form-set (form/two-forms (form/keyword-form :abort) (form/keyword-form :state))))

(defn control-effect? [member [:ref :form/r]] :bool
     (or (form/eq member (form/keyword-form :abort)) (form/eq member (form/keyword-form :state))))

(defn grant? [member [:ref :form/r]] :bool
     (and (form/is-vec? member) (= 2 (form/count-of member))
          (form/eq (form/nth-of member 0) (form/keyword-form :cap/call))))

(defn- er-has? [xs [:list [:ref :form/r]] x [:ref :form/r] i :i64] :bool
     (if (>= i (vector-count xs)) false (if (form/eq (typed-list-nth [:list [:ref :form/r]] xs i) x) true (er-has? xs x (+ i 1)))))

(defn- er-grants [members [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of members))
       acc
       (let [m (form/nth-of members i)]
         (er-grants members (+ i 1) (if (or (control-effect? m) (er-has? acc m 0)) acc (form/append-form acc m))))))

(defn grants
     "ROW without its control effects (a set); every member not a known control effect stays."
     [members [:ref :form/r]] [:ref :form/r]
     (form/form-set (er-grants members 0 (form/no-forms))))

(defn admissible [hir [:ref :form/r]] [:ref :form/r]
     (form/assoc-form hir (form/keyword-form :effects) (grants (form/form-get hir (form/keyword-form :effects)))))

(defn- er-as-set [f [:ref :form/r]] [:ref :form/r]
     (if (form/is-vec? f) (form/form-set (form/kids-of f)) f))

(defn- er-update [m [:ref :form/r] k :keyword g :i64] [:ref :form/r]
     ;; M with K's value as a set (G 0), or with the :allow of K's map value as a set (G 1); a key M lacks stays absent
     (let [v (form/form-get m (form/keyword-form k))]
       (if (or (not (form/is-map? m)) (not (form/form-has? m (form/keyword-form k))))
         m
         (form/assoc-form m (form/keyword-form k) (if (= g 0) (er-as-set v) (er-update v :allow 0))))))

;; admission's typed reading answers its sets as vectors (a document has no set; "a set in a document tree is a
;; vector without duplicates"): the fields the host answers as sets are sets again here
(defn- er-sets [d [:ref :form/r]] [:ref :form/r]
     (let [abac (form/form-get d (form/keyword-form :abac))
           attrs (form/form-get abac (form/keyword-form :abac/attributes))
           res (form/form-get attrs (form/keyword-form :resource))
           act (form/form-get attrs (form/keyword-form :action))
           attrs2 (if (form/is-map? attrs)
                    (form/assoc-form (form/assoc-form attrs (form/keyword-form :resource) (er-update res :effects 0))
                                     (form/keyword-form :action) (er-update act :capabilities 0))
                    attrs)
           abac2 (if (form/is-map? abac) (form/assoc-form abac (form/keyword-form :abac/attributes) attrs2) abac)
           d1 (er-update (er-update (er-update d :required 0) :unused-grants 0) :minimal-policy 1)]
       (form/assoc-form d1 (form/keyword-form :abac) abac2)))

(defn check
     "`kotoba.kir.admission/check` over the grants of HIR's members, after the classification check, with the
     classification facts added (the host's `check`)."
     [hir [:ref :form/r] policy [:ref :form/r]] [:ref :form/r]
     (let [narrowed (admissible hir)
           members (form/form-get narrowed (form/keyword-form :effects))
           facts (classification/check! members)
           armed (classification/arm policy (form/form-get facts (form/keyword-form :classification/effective)))
           armed-policy (form/nth-of armed 0)
           armed-label (form/nth-of armed 1)
           decided (admission/check (form/assoc-form (form/form-map (form/no-forms)) (form/keyword-form :effects) members)
                                    armed-policy)
           r1 (form/assoc-form (er-sets decided) (form/keyword-form :classification/effective)
                               (form/form-get facts (form/keyword-form :classification/effective)))
           r2 (form/assoc-form r1 (form/keyword-form :classification/labels)
                               (form/form-get facts (form/keyword-form :classification/labels)))
           r3 (form/assoc-form r2 (form/keyword-form :classification/no-read-up)
                               (form/keyword-form (if (form/is-nil? armed-label) :unarmed :armed)))]
       (form/assoc-form r3 (form/keyword-form :classification/unknown-subject-clearance)
                        (classification/unknown-subject-clearance armed-policy))))

;; ---------------------------------------------------------------------------
;; Host reading (Clojure / nbb), unchanged.
nil
