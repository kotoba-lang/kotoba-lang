(ns kotoba.compiler.provenance
  {:kotoba/export [attach descriptor schema verify!]}
  (:require [kotoba.form :as form] [kotoba.bytes :as kbytes] [kotoba.verifier.seal :as seal] [kotoba.kir.compatibility :as compatibility] [sha2.core :as sha2] [kotoba.artifact.core :as artifact] [kotoba.compiler.definition-identity :as definition-identity] [ :as crypto])
  
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]}))

(defn schema [] :keyword :kotoba.provenance/v1)

;; Same JVM `MessageDigest`/Node `node:crypto` split
;; `kotoba.artifact.core/sha256` uses -- see that namespace's own
;; comment for why. `hex` uses `clojure.core/format`, which doesn't exist
;; in cljs at all (not just "throws" -- `format`'s cljs branch is
;; ITSELF unused, `node:crypto`'s `.digest "hex"` already returns a hex
;; string), so it's behind the reader-conditional too, not just its call
;; site.


;; ── the pure path (adr-2609242330 S1) ─────────────────────────────────────
;; What every `:default` below is built from. Bytes are a vector of ints
;; 0..255; text is UTF-8 already in Kotoba, so its bytes are its code points
;; re-encoded, read at byte offsets. The host branches must answer the same
;; strings -- test/kotoba/compiler/provenance_pure_test.cljk runs these
;; functions on nbb against node:crypto / Buffer.

nil

nil

nil

(defn- raw-sha256 [bytes :vector-i64] :string
  (kbytes/hex (sha2/sha256 bytes)))
nil
(defn- text-sha256 [value :string] :string
  (hash/sha256 value))
nil
nil
(defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r]
     (form/form-get m (form/keyword-form k)))

(defn- put [m [:ref :form/r] k :keyword v [:ref :form/r]] [:ref :form/r]
     (form/assoc-form m (form/keyword-form k) v))

(defn- empty-map [] [:ref :form/r] (form/form-map (form/no-forms)))

;; The host's truthiness: neither nil nor false.
(defn- present? [f [:ref :form/r]] :bool
     (if (form/is-nil? f)
       false
       (if (form/is-bool? f) (form/bool-value f) true)))

;; A byte string (a bytes leaf, or a vector of ints) as ints 0..255.
(defn- form-bytes [f [:ref :form/r]] :vector-i64
     (if (form/is-bytes? f)
       (vector-i64-from-bytes (form/bytes-of f))
       (let [n (form/count-of f)]
         (loop [i 0 out (vector-i64)]
           (if (>= i n)
             out
             (recur (+ i 1) (vector-conj out (bit-and (form/int-value (form/nth-of f i)) 255))))))))

(defn- bytes-identity [format [:ref :form/r] bytes [:ref :form/r]] [:ref :form/r]
     (let [v (form-bytes bytes)]
       (put (put (put (empty-map) :format format)
                 :sha256 (form/string-form (raw-sha256 v)))
            :size (form/int-form (vector-count v)))))

(defn- outputs [result [:ref :form/r]] [:ref :form/r]
     (let [fmt (fget result :format)
           m0 (empty-map)
           m1 (if (form/eq fmt (form/keyword-form :wasm/v1))
                (put m0 :primary (bytes-identity (form/keyword-form :wasm) (fget result :bytes)))
                m0)
           m2 (if (form/eq fmt (form/keyword-form :wasm-component/v1))
                (put m1 :primary (bytes-identity (form/keyword-form :wasm-component) (fget result :bytes)))
                m1)
           m3 (if (form/eq fmt (form/keyword-form :cljs/v1))
                (put m2 :primary (put (put (put (empty-map) :format (form/keyword-form :cljs-source))
                                           :sha256 (form/string-form (text-sha256 (form/string-value (fget result :source)))))
                                      :size (form/int-form (string-byte-length (form/string-value (fget result :source))))))
                m2)
           m4 (if (form/eq fmt (form/keyword-form :javascript/v1))
                (put m3 :primary (put (put (put (empty-map) :format (form/keyword-form :javascript-source))
                                           :sha256 (form/string-form (text-sha256 (form/string-value (fget result :source)))))
                                      :size (form/int-form (string-byte-length (form/string-value (fget result :source))))))
                m3)
           m5 (if (form/eq fmt (form/keyword-form :kexe/v1))
                (put m4 :primary (put (put (empty-map) :format (form/keyword-form :kotoba.kexe/v1))
                                      :sha256 (fget (fget result :artifact) :sha256)))
                m4)
           creation (fget result :creation-bytes)
           m6 (if (form/eq fmt (form/keyword-form :evm/v1))
                (put m5 :primary
                     (put (put (put (empty-map) :format (form/keyword-form :evm-creation-bytes))
                               :sha256 (if (present? (fget result :creation-sha256))
                                         (fget result :creation-sha256)
                                         (form/string-form (raw-sha256 (form-bytes creation)))))
                          :size (form/int-form (form/count-of creation))))
                m5)
           binary (fget result :binary)
           m7 (if (present? binary)
                (put m6 :binary (bytes-identity (fget binary :format) (fget binary :bytes)))
                m6)
           object (fget result :object)]
       (if (present? object)
         (put m7 :object (bytes-identity (fget object :format) (fget object :bytes)))
         m7)))

;; Kotoba: the definition graph (`definition-identity/describe`) needs the
;; capability catalog, which no Kotoba module can read yet, so a result that
;; does not already carry its `:definitions` report gets the named marker the
;; host uses for "unavailable" rather than an empty report.
(defn- definitions-of [result [:ref :form/r]] [:ref :form/r]
     (let [defs (fget result :definitions)]
       (if (form/eq (fget defs :contract) (form/keyword-form :kotoba.definition-identity/v1))
         defs
         (put (put (put (empty-map) :contract (form/keyword-form :kotoba.definition-identity/v1))
                   :entries (form/keyword-form :unavailable))
              :reason (form/keyword-form :no-capability-catalog)))))

;; Kotoba: one arity (source policy build-metadata result); the host's
;; three-argument form supplies `{}` for the metadata.
(defn descriptor [source :string policy [:ref :form/r] build-metadata [:ref :form/r] result [:ref :form/r]]
     [:ref :form/r]
     (let [profile (fget result :target-profile)
           payload0
        (put (put (put (put (put (put (put (put (put (put (put (put (put (put (empty-map)
              :format (form/keyword-form (schema)))
              :builder (form/keyword-form :kotoba-compiler/v1))
              :compiler (form/string-form (compatibility/compiler-version)))
              :language (form/keyword-form (compatibility/language-version)))
              :source-sha256 (form/string-form (text-sha256 source)))
              :policy-sha256 (form/string-form (seal/sha256-form policy)))
              :build-metadata-sha256 (form/string-form (seal/sha256-form build-metadata)))
              :hir-sha256 (form/string-form (seal/sha256-form (fget result :hir))))
              :kir-sha256 (form/string-form (seal/sha256-form (fget result :kir))))
              :target (fget result :target))
              :target-profile-sha256 (form/string-form
                                      (seal/sha256-form (if (present? profile)
                                                          profile
                                                          (fget (fget result :artifact) :target-profile)))))
              :compatibility-sha256 (form/string-form (seal/sha256-form (fget result :compatibility))))
              :definitions (definitions-of result))
              :outputs (outputs result))
           ;; ADR 0365: the emitting backend, present only when it is not
           ;; the built-in emitter (as on the host reading below)
           emitter (fget result :emitter)
           ;; one binding per name (the Kotoba subset refuses a duplicate let binding)
           payload (if (present? emitter) (put payload0 :emitter emitter) payload0)]
       (put payload :sha256 (form/string-form (seal/sha256-form payload)))))

(defn attach [source :string policy [:ref :form/r] build-metadata [:ref :form/r] result [:ref :form/r]]
     [:ref :form/r]
     (let [provenance (descriptor source policy build-metadata result)
           attached (put result :provenance provenance)
           manifest (fget result :manifest)]
       (if (present? manifest)
         (put attached :manifest (put manifest :kotoba.artifact/provenance provenance))
         attached)))

(defn- sha256-equal? [a :string b :string] :bool
  (let [n (string-byte-length a)]
                (and (= n (string-byte-length b))
                     (zero? (loop [i 0 acc 0]
                              (if (< i n)
                                (recur (inc i) (bit-or acc (bit-xor (string-code-point-at a i)
                                                                    (string-code-point-at b i))))
                                acc))))))

;; Kotoba: an export cannot abort with a value a caller sees, so a rejected
;; provenance TRAPS (`assert`), as kotoba.verifier/verify-artifact! does; the
;; host throws ex-info "compilation provenance rejected".
(defn- reject! [] [:ref :form/r]
     (let [refused (assert (= 1 0))] (form/nil-form)))

(defn verify! [source :string policy [:ref :form/r] build-metadata [:ref :form/r] result [:ref :form/r]]
     [:ref :form/r]
     (let [actual (fget result :provenance)
           expected (descriptor source policy build-metadata (form/dissoc-form result (form/keyword-form :provenance)))]
       (if (and (form/is-map? actual)
                (form/eq (form/keys-of expected) (form/keys-of actual))
                (seal/valid-seal? actual)
                (sha256-equal? (form/string-value (fget actual :sha256))
                               (form/string-value (fget expected :sha256))))
         actual
         (reject!))))
