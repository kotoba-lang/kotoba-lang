;; The byte-offset counterparts to the `clojure.string` functions that could
;; not be provided under their Clojure names.
;;
;; `lang/compat.edn` records `clojure.string/index-of` as ABSENT, and the
;; reason is not that it is hard: it is that Clojure returns a CHARACTER index
;; and every index in Kotoba is a UTF-8 BYTE offset. The two agree on ASCII and
;; diverge silently on anything else. `(index-of "aあb" "b")` is 2 in Clojure
;; and 4 here, and a caller who believed the name would slice at 2 -- which
;; `string-substring` REFUSES, because 2 splits あ. The trap is the good case;
;; the bad case is a haystack where 2 happens to land on a boundary and the
;; wrong substring comes back with no complaint.
;;
;; So the answer is not a better `index-of`. It is a differently NAMED
;; function, in a `kotoba.*` namespace, that says in the name which kind of
;; index it returns. A caller reaching for `str/index-of` has to stop and
;; change the call, which is exactly the moment to notice that the number
;; means something else now.
;;
;; The offset this returns is directly usable with `string-substring`,
;; `string-code-point-at` and `string-byte-length`, all of which are addressed
;; the same way. That is the composition it is FOR.
;;
;; `utf16-index-of` and `utf16-last-index-of` (2026-09-02) answer the OTHER
;; index: the UTF-16 code-unit index, which is the number
;; `clojure.string/index-of` and `last-index-of` return -- a code point below
;; U+10000 is one unit, anything above is two. Same scan, counting units
;; instead of bytes. They are still not under the Clojure names, for one
;; reason that was measured rather than stylistic, and that STOPPED BEING
;; TRUE on 2026-09-08: Clojure answers nil when the needle is absent, the
;; exact spelling of which is an option-valued result, and such a function
;; used to refuse to lower to wasm32 -- for the WHOLE project, even when
;; nothing called it ("unsupported typed Wasm expression", exit 70, measured
;; 2026-09-02 against amu bb51dc14). Re-measured against amu 9092ee34 it
;; lowers and runs, so `clojure.string/index-of` and `last-index-of` now
;; exist under their own names, returning `[:option :i64]`, built on the
;; scans below rather than beside them.
;;
;; These three STAY, and are not deprecated. They answer a number a caller
;; can compose with where the option has to be opened first, and
;; `byte-index-of` answers a different index entirely -- the only one of the
;; three usable with `string-substring` and `string-code-point-at`. The -1 is
;; still not nil, and the name is still the warning: reach for the Clojure
;; name when the absence matters, for these when the arithmetic does.
;;
;; Consumed through the ordinary project route, which needs no JVM:
;;   amu check app.kotoba --source-path <app> --source-path <this repo>/lang/compat --jvm-free
;;
;; COST, stated because recursion in a guest is fuel-bounded: the scan is
;; naive. It tries every code-point boundary of the haystack in turn, and at
;; each one compares code point by code point until the needle runs out or a
;; pair differs -- so O(haystack code points x needle code points) `let`/`if`
;; steps in the worst case, and one `string-code-point-at` per compared code
;; point. There is no `string-contains?` pre-check to short-circuit an absent
;; needle: that builtin answers the same question by a second mechanism, and
;; if the two ever disagreed this function would return -1 while a match
;; existed. A single mechanism that is slower is worth more here than two that
;; must agree.

(ns kotoba.string
  (:export [byte-index-of utf16-index-of utf16-last-index-of
            starts-with? ends-with? includes?
            blank? trim triml trimr reverse
            index-of last-index-of
            replace]))

;; UTF-8 width from the code point itself. Advancing by this is what keeps
;; every offset this function produces or consumes on a code-point boundary --
;; `string-code-point-at` REFUSES an interior byte, so an off-by-one here would
;; trap rather than answer wrongly.
(defn- code-point-width [point :i64] :i64
  (if (< point 128)
    1
    (if (< point 2048)
      2
      (if (< point 65536) 3 4))))

;; Whether `needle` continues at `n-index` matches `s` continuing at `s-index`.
;; Two cursors rather than one, because the needle's offsets are its own: the
;; same code point can sit at byte 1 of the needle and byte 3 of the haystack.
;;
;; Compared code point by code point rather than by one `string-substring`,
;; for the reason `starts-with?` is: the end of a candidate window need not be
;; a boundary. `(string-substring "あa" 0 1)` refuses, so the substring form
;; would TRAP while searching "あa" for "a" -- where the answer is 3.
(defn- match-from? [s :string needle :string s-index :i64 n-index :i64] :bool
  (if (= n-index (string-byte-length needle))
    true
    (if (= s-index (string-byte-length s))
      false
      (let [in-string (string-code-point-at s s-index)
            in-needle (string-code-point-at needle n-index)]
        (if (= in-string in-needle)
          (match-from? s needle
                       (+ s-index (code-point-width in-needle))
                       (+ n-index (code-point-width in-needle)))
          false)))))

;; The candidate offsets are the code-point boundaries of `s`, in order, and
;; the byte length itself -- a needle can end exactly at the end of the
;; haystack, so the last boundary has to be tried before giving up.
(defn- scan-from [s :string needle :string index :i64] :i64
  (if (match-from? s needle index 0)
    index
    (if (= index (string-byte-length s))
      -1
      (scan-from s needle
                 (+ index (code-point-width (string-code-point-at s index)))))))

;; The byte offset at which `needle` first occurs in `s`, or -1.
;;
;; The empty needle answers 0, which is what `clojure.string/index-of` answers
;; and what makes the result composable: `(string-substring s 0 0)` is "".
;; It is handled here rather than in the scan because `string-contains?`
;; refuses an empty needle and because `match-from?` would answer true at the
;; first boundary anyway -- stating it is cheaper than proving it.
(defn byte-index-of [s :string needle :string] :i64
  (if (= (string-byte-length needle) 0)
    0
    (scan-from s needle 0)))

;; UTF-16 code units a code point occupies: one below U+10000, else a
;; surrogate pair. This is the unit java.lang.String indexes in.
(defn- utf16-width [point :i64] :i64
  (if (< point 65536) 1 2))

(defn- scan-utf16 [s :string needle :string index :i64 units :i64] :i64
  (if (match-from? s needle index 0)
    units
    (if (= index (string-byte-length s))
      -1
      (let [point (string-code-point-at s index)]
        (scan-utf16 s needle
                    (+ index (code-point-width point))
                    (+ units (utf16-width point)))))))

;; The UTF-16 unit index at which `needle` first occurs in `s`, or -1. The
;; empty needle answers 0 at the first boundary, as String.indexOf does.
(defn utf16-index-of [s :string needle :string] :i64
  (scan-utf16 s needle 0 0))

;; Every boundary is tried and the last match kept, so the empty needle
;; answers the UTF-16 length -- which is what String.lastIndexOf("") answers.
(defn- scan-utf16-last [s :string needle :string index :i64 units :i64 best :i64] :i64
  (let [found (if (match-from? s needle index 0) units best)]
    (if (= index (string-byte-length s))
      found
      (let [point (string-code-point-at s index)]
        (scan-utf16-last s needle
                         (+ index (code-point-width point))
                         (+ units (utf16-width point))
                         found)))))

;; The UTF-16 unit index at which `needle` last occurs in `s`, or -1.
(defn utf16-last-index-of [s :string needle :string] :i64
  (scan-utf16-last s needle 0 0 -1))


;; ---------------------------------------------------------------------------
;; The eight functions that moved here from `clojure.string` on 2026-09-08,
;; when the owner made this the canonical guest string library.
;;
;; Nothing about them changed: they are byte-for-byte the definitions that were
;; in `lang/compat/clojure/string.kotoba`, and the same oracle -- clojure.string
;; itself, called on the same inputs -- still holds them. What changed is which
;; namespace owns them. `clojure.string` is now a forwarding shim over these
;; (see that file's header for the measured call-site count and the removal
;; condition), and `kotoba.text` is an alias over these, because root
;; ADR-2609040930's replacement router points `clojure.string` at `kotoba.text`
;; and that name resolved to nothing.
;;
;; A bare re-export is NOT expressible here -- measured 2026-09-08:
;;
;;   (ns kotoba.text (:require [kotoba.string :as ks]) (:export [byte-index-of]))
;;   -> :kotoba.error/export-names-undefined
;;      "namespace exports must name declared public functions:
;;       byte-index-of is not defined in this module"
;;
;; so the shim and the alias are one-line FORWARDING WRAPPERS. That keeps one
;; implementation, which is the point, at the cost of one call frame.
;;
;; `code-point-width` above is shared: this module already had its own copy for
;; the index scans and the moved functions used an identical one, so the merge
;; removed a duplicate rather than creating one.

;; Compared code point by code point rather than with one `string-substring`,
;; because `(string-substring "あ" 0 1)` refuses -- so the substring form would
;; TRAP on `(starts-with? "あ" "a")` where the answer is false.
(defn- prefix-from? [s :string prefix :string index :i64] :bool
  (if (= index (string-byte-length prefix))
    true
    (let [in-string (string-code-point-at s index)
          in-prefix (string-code-point-at prefix index)]
      (if (= in-string in-prefix)
        (prefix-from? s prefix (+ index (code-point-width in-prefix)))
        false))))

(defn starts-with? [s :string prefix :string] :bool
  (if (> (string-byte-length prefix) (string-byte-length s))
    false
    (prefix-from? s prefix 0)))

;; Whether `target` is a code-point boundary of `s`. A suffix of valid UTF-8
;; can only begin on one, so a target that is not a boundary answers false --
;; which is also why this is a scan and not arithmetic.
(defn- boundary-at? [s :string target :i64 index :i64] :bool
  (if (= index target)
    true
    (if (> index target)
      false
      (boundary-at? s target (+ index (code-point-width (string-code-point-at s index)))))))

(defn ends-with? [s :string suffix :string] :bool
  (let [length (string-byte-length s)
        suffix-length (string-byte-length suffix)]
    (if (> suffix-length length)
      false
      (if (boundary-at? s (- length suffix-length) 0)
        (string=? (string-substring s (- length suffix-length) length) suffix)
        false))))

;; `string-contains?` is exact for a non-empty needle -- verified on multi-byte
;; input -- but REFUSES an empty one (`empty-string-search-needle`), where
;; Clojure answers true. That single case is the whole reason this is not just
;; an alias.
(defn includes? [s :string substring :string] :bool
  (if (= (string-byte-length substring) 0)
    true
    (string-contains? s substring)))

;; java.lang.Character.isWhitespace, as a predicate over code points, which is
;; what clojure.string's blank?/trim/triml/trimr test. Its definition (JDK 21,
;; Unicode 15): SPACE_SEPARATOR, LINE_SEPARATOR or PARAGRAPH_SEPARATOR EXCEPT
;; the non-breaking U+00A0, U+2007 and U+202F; plus U+0009..U+000D and
;; U+001C..U+001F. Written out as ranges rather than derived, and checked
;; against the JVM itself for every code point below U+3100 and every code
;; point the JVM says is whitespace, in the oracle test. U+0085 (NEL) and
;; U+00A0 are the two a Unicode White_Space table would get wrong here.
(defn- whitespace? [point :i64] :bool
  (cond
    (< point 9) false
    (<= point 13) true      ; U+0009..U+000D
    (< point 28) false
    (<= point 31) true      ; U+001C..U+001F
    (= point 32) true       ; SPACE
    (= point 5760) true     ; U+1680 OGHAM SPACE MARK
    (< point 8192) false
    (<= point 8198) true    ; U+2000..U+2006
    (= point 8199) false    ; U+2007 FIGURE SPACE, non-breaking
    (<= point 8202) true    ; U+2008..U+200A
    (= point 8232) true     ; U+2028 LINE SEPARATOR
    (= point 8233) true     ; U+2029 PARAGRAPH SEPARATOR
    (= point 8287) true     ; U+205F MEDIUM MATHEMATICAL SPACE
    (= point 12288) true    ; U+3000 IDEOGRAPHIC SPACE
    :else false))

(defn- blank-from? [s :string index :i64] :bool
  (if (= index (string-byte-length s))
    true
    (let [point (string-code-point-at s index)]
      (if (whitespace? point)
        (blank-from? s (+ index (code-point-width point)))
        false))))

;; True of the empty string, as in Clojure. (Clojure also answers true for
;; nil; there is no nil string here to ask about.)
(defn blank? [s :string] :bool
  (blank-from? s 0))

;; The byte offset of the first code point that is not whitespace, or the
;; byte length when every one is.
(defn- left-edge [s :string index :i64] :i64
  (if (= index (string-byte-length s))
    index
    (let [point (string-code-point-at s index)]
      (if (whitespace? point)
        (left-edge s (+ index (code-point-width point)))
        index))))

;; The byte offset just past the last code point that is not whitespace,
;; scanning forward from `index` and carrying `end` -- so it starts at the
;; left edge when trim calls it, and at 0 with an `end` of 0 when trimr does.
(defn- right-edge [s :string index :i64 end :i64] :i64
  (if (= index (string-byte-length s))
    end
    (let [point (string-code-point-at s index)
          after (+ index (code-point-width point))]
      (right-edge s after (if (whitespace? point) end after)))))

(defn triml [s :string] :string
  (string-substring s (left-edge s 0) (string-byte-length s)))

(defn trimr [s :string] :string
  (string-substring s 0 (right-edge s 0 0)))

(defn trim [s :string] :string
  (let [left (left-edge s 0)]
    (string-substring s left (right-edge s left left))))

;; One code point at a time onto the front of the result. StringBuilder's
;; reverse treats a surrogate pair as one character, so this agrees with
;; clojure.string/reverse on astral code points too -- asserted with an emoji
;; in the oracle test, not assumed.
(defn- reverse-from [s :string index :i64 out :string] :string
  (if (= index (string-byte-length s))
    out
    (let [width (code-point-width (string-code-point-at s index))]
      (reverse-from s (+ index width)
                    (string-concat (string-substring s index (+ index width)) out)))))

(defn reverse [s :string] :string
  (reverse-from s 0 ""))

;; ---------------------------------------------------------------------------
;; index-of / last-index-of. The UTF-16 index Clojure returns, and Clojure's
;; nil, spelled as the option that nil IS in a typed guest.
;;
;; The SCAN is not repeated here. `kotoba.string/utf16-index-of` already
;; answers the number, measured against clojure.string/index-of itself on
;; 2026-09-02; these wrap its -1 sentinel back into the absence Clojure
;; actually returns. Two mechanisms that must agree is the defect this file
;; keeps refusing elsewhere (see `includes?` and its single non-alias case),
;; so there is exactly one scan and it lives here -- these two are one
;; comparison on top of it. They arrived in `clojure.string` in #653 and moved
;; here with everything else on 2026-09-08; the calls lost their `ks/` prefix
;; because the scan is now in the same module.
;;
;; WHAT THE CALLER GETS, and it is not nil: `[:option :i64]`. A `.cljc` line
;; reading `(if-let [i (str/index-of s x)] ...)` becomes `if-some`, and the
;; arithmetic-on-nil NPE that Clojure would have thrown at the caller becomes
;; a type error at check time. That is the whole reason to prefer this
;; spelling over `kotoba.string/utf16-index-of`'s -1, which a caller can
;; thread into `+` and get a number back from.
;;
;; ARITY: the two-argument arity only, as everywhere else in this file.
;; clojure.string/index-of also takes a from-index and also takes a CHARACTER
;; rather than a string; neither has a counterpart here, and both are an arity
;; or type refusal at check time rather than a different answer.
;;
;; COST: exactly `kotoba.string/utf16-index-of`'s -- one naive scan, O(haystack
;; code points x needle code points) worst case, fuel-bounded like any guest
;; recursion. The wrapper adds one comparison.

;; -1 is `utf16-index-of`'s absent; nothing else can produce it, because a
;; UTF-16 index is never negative.
(defn- found-or-absent [unit-index :i64] [:option :i64]
  (if (= unit-index -1)
    (option-none-of [:option :i64])
    (option-some-of [:option :i64] unit-index)))

;; The UTF-16 code-unit index at which `value` first occurs in `s`, or absent.
;; The empty needle answers 0, as clojure.string/index-of does.
(defn index-of [s :string value :string] [:option :i64]
  (found-or-absent (utf16-index-of s value)))

;; The UTF-16 code-unit index at which `value` last occurs in `s`, or absent.
;; The empty needle answers the UTF-16 LENGTH of `s`, which is what
;; String.lastIndexOf("") answers -- asserted in the oracle, not assumed.
(defn last-index-of [s :string value :string] [:option :i64]
  (found-or-absent (utf16-last-index-of s value)))

;; ---------------------------------------------------------------------------
;; 2026-09-12: replace, the LITERAL arity.
;;
;; Asked for by the self-host loop (adr-2609111900): the compiler's own
;; sources call `kotoba.lang.text/replace` 34 times, 12 of them with a string
;; match (`(str/replace ns "." "/")`, `(str/replace k "/" "+")`, ...). The
;; `:absent` entry that stood here since 2026-09-02 said "nothing in this
;; workspace has asked for it yet"; that is no longer true, and this is the
;; oracle it said it needed.
;;
;; WHAT IT ANSWERS: `kotoba.lang.text/replace` with a STRING match -- every
;; non-overlapping occurrence of `match` in `s`, left to right, replaced by
;; `replacement` taken LITERALLY (no `$1`, no `\\`; a string match never sees
;; the template expander on the host either, as that function's own comment
;; says). An EMPTY match answers `s` unchanged, which is what
;; `kotoba.lang.text/replace` answers -- it returns `s` before looking for
;; anything. That is the one place this is NOT `clojure.string/replace`:
;; `String.replace("", "x")` on the JVM, and the escaped `RegExp` on
;; ClojureScript, both interleave -- "abc" becomes "xaxbxcx" -- so
;; `clojure.string`'s shim keeps `replace` absent and says so
;; (`lang/compat.edn` `:modules :clojure.string :absent replace`).
;;
;; The regex arity is not here and cannot be: a `#"..."` literal is a reader
;; rejection in guest source (`:measured :regex-literal`), so a call site
;; with a pattern is refused before any function is chosen. A `.cljk` line
;; `(str/replace s #"\s+" " ")` reaches its own next wall, not a wrong answer.
;;
;; ONE MECHANISM: `string-replace-all`, the builtin every backend lowers (KIR
;; `str/replace` on the host, kotoba-script `stringReplaceAll`, kotoba-wasm
;; the `kotoba:typed` intrinsic, and amu's browser host `split/join`). It
;; TRAPS on an empty needle (`empty-string-replacement-needle`), which is
;; why the empty case is decided here before it is called -- the same shape
;; as `includes?` above and its one non-alias case.
;;
;; COST: whatever the host's literal replace costs, once; plus the typed
;; string ceiling -- a result over 65,536 bytes is `typed string is
;; oversized` on the wasm host and `bounded-string!` on KIR, a trap and not a
;; truncation.
(defn replace [s :string match :string replacement :string] :string
  (if (= (string-byte-length match) 0)
    s
    (string-replace-all s match replacement)))
