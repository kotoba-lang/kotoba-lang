;; kotoba.form -- the form tree, the compiler's own S-expression shape.
;;
;; A form is the record every `:kotoba` reading walks: `form/r` = a CST-like
;; node (`:tag` discriminates, `:kids` holds children). The record shape is not
;; invented here: it is declared the same way by every caller's `:schemas`
;; (the closed-namespace-table rule -- structurally equal declarations are one
;; shared type), the reference declaration being
;; `kotoba.compiler.nbb.check-driver`'s `:form/r`.
;;
;; WHAT IS PROVIDED: the constructors, predicates, field readers and the
;; map/seq operations every caller of `kotoba.form` reaches for. The tag table
;; is this module's own (nothing outside compares `:tag` directly); the
;; document bridges (`from-document` / `edn-form`) carry the mapping.
;;
;; ⚠ This is the guest twin of the host's form helpers. The oracle is the
;; host route itself: the same calls answer the same shapes there.

(ns kotoba.form
  (:export [append-form append-many assoc-form bool-form bool-value
            bytes-form bytes-of count-of dissoc-form edn-form eq first-of
            form-get form-has form-map form-seq form-set form-vec
            from-document int-form int-value
            is-bool is-bytes is-int is-keyword is-map is-nil is-seq is-set
            is-string is-symbol is-true is-vec
            keys-of keyword-form keyword-has-namespace keyword-value
            kids-of last-of nil-form no-forms nth-of one-form
            string-form string-value symbol-form symbol-value
            is-bool? is-bytes? is-int? is-keyword? is-map? is-nil? is-seq?
            is-set? set-contains? is-string? is-symbol? is-true? is-vec?])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                       [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]}))

;; tag table (this module's own): 1 nil, 2 bool, 3 int, 4 string, 5 keyword,
;; 6 symbol, 7 bytes, 8 vec, 9 list/seq, 10 set, 11 map.
(defn- node [t :i64 s :string n :i64 k :keyword kids [:list [:ref :form/r]] span :i64 data :bytes] [:ref :form/r]
  (record-new [:ref :form/r] t s n k kids span data))

(defn- empty-kids [] [:list [:ref :form/r]] (typed-list-new [:list [:ref :form/r]]))
(defn- nth-form [xs [:list [:ref :form/r]] i :i64] [:ref :form/r]
  (typed-list-nth [:list [:ref :form/r]] xs i))
(defn- count-form [xs [:list [:ref :form/r]]] :i64
  (vector-count xs))
(defn- conj-form [xs [:list [:ref :form/r]] x [:ref :form/r]] [:list [:ref :form/r]]
  (typed-list-conj [:list [:ref :form/r]] xs x))


;; ---- constructors ------------------------------------------------------------------

(defn nil-form [] [:ref :form/r] (node 1 "" 0 :k/nil (empty-kids) 0 (bytes-empty)))
(defn bool-form [b :bool] [:ref :form/r] (node 2 "" (if b 1 0) :k/bool (empty-kids) 0 (bytes-empty)))
(defn int-form [n :i64] [:ref :form/r] (node 3 "" n :k/int (empty-kids) 0 (bytes-empty)))
(defn string-form [s :string] [:ref :form/r] (node 4 s 0 :k/string (empty-kids) 0 (bytes-empty)))
(defn keyword-form [k :keyword] [:ref :form/r] (node 5 "" 0 k (empty-kids) 0 (bytes-empty)))
(defn symbol-form [s :string] [:ref :form/r] (node 6 s 0 :k/symbol (empty-kids) 0 (bytes-empty)))
(defn bytes-form [d :bytes] [:ref :form/r] (node 7 "" 0 :k/bytes (empty-kids) 0 d))

(defn one-form [x [:ref :form/r]] [:list [:ref :form/r]]
  (typed-list-conj [:list [:ref :form/r]] (empty-kids) x))

(defn no-forms [] [:list [:ref :form/r]] (empty-kids))

(defn append-form [xs [:list [:ref :form/r]] x [:ref :form/r]] [:list [:ref :form/r]]
  (typed-list-conj [:list [:ref :form/r]] xs x))

(defn append-many [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (let [n (count-form ys)]
    (loop [i 0 acc xs]
      (if (>= i n) acc (recur (+ i 1) (conj-form acc (nth-form ys i)))))))

(defn form-seq [xs [:list [:ref :form/r]]] [:ref :form/r] (node 9 "" 0 :k/seq xs 0 (bytes-empty)))
(defn form-vec [xs [:list [:ref :form/r]]] [:ref :form/r] (node 8 "" 0 :k/vec xs 0 (bytes-empty)))
(defn form-set [xs [:list [:ref :form/r]]] [:ref :form/r] (node 10 "" 0 :k/set xs 0 (bytes-empty)))

(defn form-map [xs [:list [:ref :form/r]]] [:ref :form/r] (node 11 "" 0 :k/map xs 0 (bytes-empty)))

;; ---- document bridges ---------------------------------------------------------------

;; The form tree and a :document carry the same shapes; `from-document` is the
;; structural copy (the tag table above), `edn-form` its reader composition.
(defn from-document [d :document] [:ref :form/r]
  (let [k (document-kind d)]
    (cond
      (= k :null) (nil-form)
      (= k :bool) (bool-form (option-value-of [:option :bool] (document-bool-value d) false))
      (= k :i64) (int-form (option-value-of [:option :i64] (document-i64-value d) 0))
      (= k :string) (string-form (option-value-of [:option :string] (document-string-value d) ""))
      (= k :keyword) (keyword-form (option-value-of [:option :keyword] (document-keyword-value d) :k/none))
      (= k :symbol) (symbol-form (document-edn-print d))
      (= k :vector) (form-vec (doc-items d 0))
      (= k :list) (form-seq (doc-items d 0))
      (= k :map) (form-map (doc-entries d 0))
      ;; :set: the document surface has no set-at; enumeration is a named gap
      ;; (document-set-at), so a set copies as the empty set for now.
      (= k :set) (form-set (empty-kids))
      :else (nil-form))))

(defn- doc-items [d :document i :i64] [:list [:ref :form/r]]
  (let [n (document-count d)]
    (loop [j i acc (empty-kids)]
      (if (>= j n) acc (recur (+ j 1) (conj-form acc (from-document (option-value-of [:option :document] (document-vector-at d j) (document-null)))))))))

(defn- doc-entries [d :document i :i64] [:list [:ref :form/r]]
  (let [n (document-count d)]
    (loop [j i acc (empty-kids)]
      (if (>= j n) acc
        (let [e (option-value-of [:option :document] (document-map-entry-at d j) (document-null))]
          (recur (+ j 1)
                 (conj-form (conj-form acc (from-document (option-value-of [:option :document] (document-vector-at e 0) (document-null))))
                            (from-document (option-value-of [:option :document] (document-vector-at e 1) (document-null))))))))))

(defn edn-form [s :string] [:ref :form/r]
  (from-document (document-edn-read s)))

;; ---- predicates --------------------------------------------------------------------

(defn is-nil [x [:ref :form/r]] :bool (= (record-get [:ref :form/r] x :tag) 1))
(defn is-bool [x [:ref :form/r]] :bool (= (record-get [:ref :form/r] x :tag) 2))
(defn is-int [x [:ref :form/r]] :bool (= (record-get [:ref :form/r] x :tag) 3))
(defn is-string [x [:ref :form/r]] :bool (= (record-get [:ref :form/r] x :tag) 4))
(defn is-keyword [x [:ref :form/r]] :bool (= (record-get [:ref :form/r] x :tag) 5))
(defn is-symbol [x [:ref :form/r]] :bool (= (record-get [:ref :form/r] x :tag) 6))
(defn is-bytes [x [:ref :form/r]] :bool (= (record-get [:ref :form/r] x :tag) 7))
(defn is-vec [x [:ref :form/r]] :bool (= (record-get [:ref :form/r] x :tag) 8))
(defn is-seq [x [:ref :form/r]] :bool (= (record-get [:ref :form/r] x :tag) 9))
(defn is-set [x [:ref :form/r]] :bool (= (record-get [:ref :form/r] x :tag) 10))
(defn is-map [x [:ref :form/r]] :bool (= (record-get [:ref :form/r] x :tag) 11))
(defn is-true [x [:ref :form/r]] :bool (if (= (record-get [:ref :form/r] x :tag) 2) (= (record-get [:ref :form/r] x :n) 1) false))

;; ---- value readers -----------------------------------------------------------------

(defn bool-value [x [:ref :form/r]] :bool (= (record-get [:ref :form/r] x :n) 1))
(defn int-value [x [:ref :form/r]] :i64 (record-get [:ref :form/r] x :n))
(defn string-value [x [:ref :form/r]] :string (record-get [:ref :form/r] x :s))
(defn symbol-value [x [:ref :form/r]] :string (record-get [:ref :form/r] x :s))
(defn keyword-value [x [:ref :form/r]] :keyword (record-get [:ref :form/r] x :k))
(defn bytes-of [x [:ref :form/r]] :bytes (record-get [:ref :form/r] x :data))
(defn keyword-has-namespace [x [:ref :form/r]] :bool
  ;; the builtin of the same name is shadowed by this export, so the answer is
  ;; derived: a namespaced keyword prints its name part alone differently.
  (let [k (record-get [:ref :form/r] x :k)]
    (if (= k (keyword-from-string (keyword-name k))) false true)))

;; ---- tree navigation ---------------------------------------------------------------

(defn kids-of [x [:ref :form/r]] [:list [:ref :form/r]] (record-get [:ref :form/r] x :kids))
(defn count-of [x [:ref :form/r]] :i64 (count-form (record-get [:ref :form/r] x :kids)))
(defn nth-of [x [:ref :form/r] i :i64] [:ref :form/r] (nth-form (record-get [:ref :form/r] x :kids) i))
(defn first-of [x [:ref :form/r]] [:ref :form/r] (nth-form (record-get [:ref :form/r] x :kids) 0))
(defn last-of [x [:ref :form/r]] [:ref :form/r] (nth-form (record-get [:ref :form/r] x :kids) (- (count-form (record-get [:ref :form/r] x :kids)) 1)))

;; ---- map operations (a map form's kids alternate key form, value form) --------------

(defn form-has [m [:ref :form/r] k [:ref :form/r]] :bool
  (let [xs (record-get [:ref :form/r] m :kids)
        n (count-form xs)]
    (loop [i 0]
      (if (>= i n) false
        (if (eq (nth-form xs i) k) true (recur (+ i 2)))))))

(defn form-get [m [:ref :form/r] k [:ref :form/r]] [:ref :form/r]
  (let [xs (record-get [:ref :form/r] m :kids)
        n (count-form xs)]
    (loop [i 0]
      (if (>= i n) (nil-form)
        (if (eq (nth-form xs i) k) (nth-form xs (+ i 1)) (recur (+ i 2)))))))

(defn assoc-form [m [:ref :form/r] k [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
  (let [xs (record-get [:ref :form/r] m :kids)
        n (count-form xs)]
    (loop [i 0 acc (empty-kids)]
      (if (>= i n)
        (node 11 "" 0 :k/map (conj-form (conj-form acc k) v) 0 (bytes-empty))
        (if (eq (nth-form xs i) k)
          (recur (+ i 2) (conj-form (conj-form acc k) v))
          (recur (+ i 2) (conj-form (conj-form acc (nth-form xs i)) (nth-form xs (+ i 1)))))))))

(defn dissoc-form [m [:ref :form/r] k [:ref :form/r]] [:ref :form/r]
  (let [xs (record-get [:ref :form/r] m :kids)
        n (count-form xs)]
    (loop [i 0 acc (empty-kids)]
      (if (>= i n)
        (node 11 "" 0 :k/map acc 0 (bytes-empty))
        (if (eq (nth-form xs i) k)
          (recur (+ i 2) acc)
          (recur (+ i 2) (conj-form (conj-form acc (nth-form xs i)) (nth-form xs (+ i 1)))))))))

(defn keys-of [m [:ref :form/r]] [:list [:ref :form/r]]
  (let [xs (record-get [:ref :form/r] m :kids)
        n (count-form xs)]
    (loop [i 0 acc (empty-kids)]
      (if (>= i n) acc (recur (+ i 2) (conj-form acc (nth-form xs i)))))))

;; The callers' spelling carries the question mark (measured: is-map? 33,
;; is-nil? 25 sites vs the bare names 0); these are the forwarding names.
(defn is-nil? [x [:ref :form/r]] :bool (is-nil x))
(defn is-bool? [x [:ref :form/r]] :bool (is-bool x))
(defn is-int? [x [:ref :form/r]] :bool (is-int x))
(defn is-string? [x [:ref :form/r]] :bool (is-string x))
(defn is-keyword? [x [:ref :form/r]] :bool (is-keyword x))
(defn is-symbol? [x [:ref :form/r]] :bool (is-symbol x))
(defn is-bytes? [x [:ref :form/r]] :bool (is-bytes x))
(defn is-vec? [x [:ref :form/r]] :bool (is-vec x))
(defn is-seq? [x [:ref :form/r]] :bool (is-seq x))
(defn is-set? [x [:ref :form/r]] :bool (is-set x))

(defn set-contains?
  "Membership of a form value in a form set (kids walk)."
  [s [:ref :form/r] x [:ref :form/r]] :bool
  (let [n (count-of s)] (loop [i 0] (if (>= i n) false (if (eq (nth-of s i) x) true (recur (+ i 1)))))))

(defn is-map? [x [:ref :form/r]] :bool (is-map x))
(defn is-true? [x [:ref :form/r]] :bool (is-true x))

;; ---- equality ----------------------------------------------------------------------

(defn- bytes-eq? [a :bytes b :bytes] :bool
  (let [n (bytes-count a)]
    (if (= n (bytes-count b))
      (loop [i 0]
        (if (>= i n) true
          (if (= (bytes-at a i) (bytes-at b i)) (recur (+ i 1)) false)))
      false)))

(defn eq [a [:ref :form/r] b [:ref :form/r]] :bool
  (if (= (record-get [:ref :form/r] a :tag) (record-get [:ref :form/r] b :tag))
    (let [t (record-get [:ref :form/r] a :tag)]
      (if (or (= t 1) (= t 2))
        (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
        (if (= t 3) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
          (if (or (= t 4) (= t 6)) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
            (if (= t 5) (= (record-get [:ref :form/r] a :k) (record-get [:ref :form/r] b :k))
              (if (= t 7) (bytes-eq? (record-get [:ref :form/r] a :data) (record-get [:ref :form/r] b :data))
                (let [xs (record-get [:ref :form/r] a :kids)
                      ys (record-get [:ref :form/r] b :kids)
                      nx (count-form xs)
                      ny (count-form ys)]
                  (if (= nx ny)
                    (loop [i 0]
                      (if (>= i nx) true
                        (if (eq (nth-form xs i) (nth-form ys i)) (recur (+ i 1)) false)))
                    false))))))))
    false))
