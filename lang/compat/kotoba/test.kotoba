(ns kotoba.test
  
  "Assembled from one repo per definition.

  This namespace holds no implementation (except the clojure.test-compatible
  section described below, which forwards to the host runner). It re-exports the definitions
  that each live in their own repo, so a call site can require one name
  and a library can require only the definitions it actually uses.

  AN IMPLEMENTATION BUILT AGAINST kotoba.lang.test IS NOT ACCEPTED HERE.
  kotoba.lang.test still declares IGenerator, and a protocol split into its own
  repo is a DIFFERENT protocol from the one the source namespace declares
  (ADR-2609091900). Measured 2026-09-09 on kotoba.lang.fs: a filesystem
  reified against the source protocol answers through the source namespace
  and fails through this one -- No implementation of method: :exists?.
  Build the implementation against the repo that declares the protocol here,
  or call through kotoba.lang.test.

  NOT re-exported here, on purpose: IGenerator, RNG. A protocol's identity is what extend-type and reify dispatch on,
  and a copy would make an implementation silently extend nothing, so the
  protocol name stays in the one repo that declares it. Requiring that repo
  is a compile error away; a copy would not be.

  kotoba.lang.test's macros are not re-exported: are, deftest, is, testing.
  A macro var cannot be copied -- (def x other/x) on one is a compile error:
  Can't take value of a macro. Require kotoba.lang.test for those.

  THE clojure.test-COMPATIBLE SURFACE (the one section that is not a
  re-export). deftest, is, are, testing, use-fixtures, async,
  run-tests, successful?, report -- the names a call site rewritten from
  `[clojure.test :refer [...]]` / `[clojure.test :as t]` to kotoba.test must
  find here, with `(is (thrown? C ...))` and `(is (thrown-with-msg? C re ...))`.

  They are defined against the HOST test runner (clojure.test on the JVM,
  cljs.test on the kbb engine / nbb), not against kotoba.lang.test's own
  registry, on purpose: a test is only a test if the repo's runner finds it
  and counts it. `kbb -M:test` substitutes cljs.test/run-tests over every
  `*_test` namespace and exits on ITS counters; cognitect.test-runner does
  the same with clojure.test's. kotoba.lang.test/deftest attaches no `:test`
  metadata and its `is` never reaches those counters, so a suite rewritten
  onto it ran 0 tests and exited 0 (measured 2026-09-07 on kotoba-lang/dance,
  adr-2809061500). Forwarding to the host makes the rewrite count-preserving
  by construction: every `is` produces exactly the report event it produced
  before, and the migration tool checks that (before == after) per repo.
  This namespace is now the ONE place that names the host test framework;
  replacing the host runner later is an edit here, not at 12,000 call sites.

  NOT covered, on purpose (a call site using them is refused by
  scripts/migrate-clojure-test-to-kotoba-test.cljk rather than rewritten):
  assert-expr / do-report / *report-counters* / *testing-vars* /
  *testing-contexts* / inc-report-counter / test-var / test-vars / test-ns /
  run-all-tests / with-test / set-test / compose-fixtures / join-fixtures /
  deftest- (0 call sites in the workspace, and the kbb engine's own
  cljs.test/deftest- fails with `Unable to resolve symbol:
  sci.configs.cljs.test/test-var`, measured 2026-09-23),
  and auto-resolved keywords through the alias (`::t/default` would move
  from :cljs.test/default to :kotoba.test/default and silently stop
  matching). `report` IS covered: it is the host multimethod itself (the
  object, not a copy), so `(defmethod t/report [:cljs.test/default
  :end-run-tests] ...)` still installs the exit-code hook runner scripts use.

  `run-tests` here is clojure.test's (namespaces in, host summary out). The
  registry runner that used to be re-exported under this name had no caller
  in the workspace (rg over orgs/, 2026-09-23: 0 requires of kotoba.test);
  it is kotoba.test.run-tests/run-tests and stays re-exported as
  run-registered-tests.

  Runtime: .cljk is loaded by the kbb engine (SCI, :cljs branch) and, for
  .cljc copies, by the JVM (:clj branch). A ClojureScript compiler build
  would need ; no .cljk reaches one.

  Value vars are not re-exported either: *contexts*, *current-test*, *report*, alphabet. `(def x other/x)` copies, which is harmless for a function and makes
  with-redefs through this namespace a SILENT no-op for a value -- measured
  on kotoba.lang.edn, where three assertions passed against nothing at all.
  Require the repo that defines the value.
"
    (:require [kotoba.test] [kotoba.test.generator :as igenerator-ns] [kotoba.test.rng :as rng-ns] [kotoba.test.are-eq :as are-eq-ns] [kotoba.test.for-all :as for-all-ns] [kotoba.test.gen-bool :as gen-bool-ns] [kotoba.test.gen-element :as gen-element-ns] [kotoba.test.gen-from-spec :as gen-from-spec-ns] [kotoba.test.gen-int :as gen-int-ns] [kotoba.test.gen-string :as gen-string-ns] [kotoba.test.make-rng :as make-rng-ns] [kotoba.test.next-int :as next-int-ns] [kotoba.test.next-long :as next-long-ns] [kotoba.test.quickcheck :as quickcheck-ns] [kotoba.test.record-error :as record-error-ns] [kotoba.test.record-fail :as record-fail-ns] [kotoba.test.record-pass :as record-pass-ns] [kotoba.test.register-test :as register-test-ns] [kotoba.test.registered-tests :as registered-tests-ns] [kotoba.test.run-tests :as run-tests-ns] [kotoba.test.run-tests-report :as run-tests-report-ns] [kotoba.test.shrink-int :as shrink-int-ns] [kotoba.test.throws :as throws-ns])
)

(def ->RNG "See kotoba.test.rng/->RNG." rng-ns/->RNG)
(def are-eq? "See kotoba.test.are-eq/are-eq?." are-eq-ns/are-eq?)
(def for-all "See kotoba.test.for-all/for-all." for-all-ns/for-all)
(def gen "See kotoba.test.generator/gen." igenerator-ns/gen)
(def gen-bool "See kotoba.test.gen-bool/gen-bool." gen-bool-ns/gen-bool)
(def gen-element "See kotoba.test.gen-element/gen-element." gen-element-ns/gen-element)
(def gen-from-spec "See kotoba.test.gen-from-spec/gen-from-spec." gen-from-spec-ns/gen-from-spec)
(def gen-int "See kotoba.test.gen-int/gen-int." gen-int-ns/gen-int)
(def gen-string "See kotoba.test.gen-string/gen-string." gen-string-ns/gen-string)
(def make-rng "See kotoba.test.make-rng/make-rng." make-rng-ns/make-rng)
(def map->RNG "See kotoba.test.rng/map->RNG." rng-ns/map->RNG)
(def next-int "See kotoba.test.next-int/next-int." next-int-ns/next-int)
(def next-long "See kotoba.test.next-long/next-long." next-long-ns/next-long)
(def quickcheck "See kotoba.test.quickcheck/quickcheck." quickcheck-ns/quickcheck)
(def record-error! "See kotoba.test.record-error/record-error!." record-error-ns/record-error!)
(def record-fail! "See kotoba.test.record-fail/record-fail!." record-fail-ns/record-fail!)
(def record-pass! "See kotoba.test.record-pass/record-pass!." record-pass-ns/record-pass!)
(def register-test! "See kotoba.test.register-test/register-test!." register-test-ns/register-test!)
(def registered-tests "See kotoba.test.registered-tests/registered-tests." registered-tests-ns/registered-tests)
(def run-registered-tests "See kotoba.test.run-tests/run-tests (the registry runner; `run-tests` below is clojure.test's)." run-tests-ns/run-tests)
(def run-tests-report "See kotoba.test.run-tests-report/run-tests-report." run-tests-report-ns/run-tests-report)
(def shrink-int "See kotoba.test.shrink-int/shrink-int." shrink-int-ns/shrink-int)
(def throws? "See kotoba.test.throws/throws?." throws-ns/throws?)

;; ---------------------------------------------------------------------------
;; clojure.test-compatible surface -- forwards to the host runner.
;; See the namespace docstring for why the host and not kotoba.lang.test.
;; Each macro expands to the host macro of the same name with the same
;; arguments, so the expansion a runner sees is the one it saw before the
;; call site was rewritten.
;; ---------------------------------------------------------------------------

(defmacro deftest
  "clojure.test/deftest (host). Defines a var with :test metadata, so the
  repo's runner (kbb -M:test, cognitect.test-runner, cljs.test/run-tests)
  discovers it."
  [name & body]
  `(host/deftest ~name ~@body))

(defmacro is
  "clojure.test/is (host). `(is (thrown? C body))` and
  `(is (thrown-with-msg? C re body))` are the host's own special forms and
  report exactly as before."
  ([form] `(host/is ~form))
  ([form msg] `(host/is ~form ~msg)))

(defmacro are
  "clojure.test/are (host): one `is` per row."
  [argv expr & args]
  `(host/are ~argv ~expr ~@args))

(defmacro testing
  "clojure.test/testing (host)."
  [string & body]
  `(host/testing ~string ~@body))

(defmacro use-fixtures
  "clojure.test/use-fixtures (host), :once or :each, for the namespace that
  expands it."
  [type & fns]
  `(host/use-fixtures ~type ~@fns))



(def run-tests
  "clojure.test/run-tests (host): namespaces in, the host's summary out; the
  current namespace when called with none."
  host/run-tests)

(def successful?
  "clojure.test/successful? (host)."
  host/successful?)

(def report
  "clojure.test/report (host) -- the multimethod OBJECT, not a copy, so a
  `defmethod` through this name installs a method the host runner calls."
  host/report)
