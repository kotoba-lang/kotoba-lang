(ns glb
  "GLB binary container codec — chunk framing only, no glTF-JSON or VRM
  semantics. Extracted per ADR-0048 §5 (`com-junkawasaki/root`,
  `90-docs/adr/0048-global-format-standards-kotoba-clj-wasm-no-rust.md`): the
  12-byte-header + JSON-chunk + BIN-chunk container format used by both `.glb`
  (glTF 2.0 binary) and `.vrm` (a glTF 2.0 extension) was implemented twice,
  independently — write-only in `kotoba-lang/gltf` (`export-glb-byte-seq`) and
  read-only in `kotoba-lang/vrm` (`vrm.glb/parse-glb`). This repo is the single
  canonical implementation both migrate to depend on via `:local/root`.

  Bytes are represented as a portable byte-int sequence (`(vec bytes)`, each
  element 0-255) so this namespace stays platform-neutral; callers on the JVM
  can `byte-array` the result, cljs callers can `js/Uint8Array.` it.

  Two API tiers:

  - `write-glb` / `parse-glb` — the ergonomic, map-based entry points. `:json`
    may be a plain CLJC map (auto-encoded via `glb.json/->json`) or already-
    serialized bytes/a string (used as-is, no re-encoding); `parse-glb`
    JSON-decodes the JSON chunk for you (via `glb.json/parse`).
  - `write-glb-raw` / `parse-glb-raw` — the low-level, bytes-in/bytes-out tier
    (no JSON encode/decode at all), for callers that already have serialized
    JSON bytes and want pure chunk framing, or that parse the JSON chunk
    themselves with a different/domain-specific JSON layer (e.g.
    `kotoba-lang/vrm`'s `vrm.glb` facade, which must keep returning raw JSON
    bytes for its own downstream `vrm.json`/`vrm.parse` pipeline)."
  (:require [glb.json]))

;; ---------------------------------------------------------------------------
;; Constants
;; ---------------------------------------------------------------------------

(def glb-magic 0x46546C67)      ;; "glTF" little-endian
(def glb-version 2)
(def chunk-type-json 0x4E4F534A) ;; "JSON"
(def chunk-type-bin 0x004E4942)  ;; "BIN\0"

;; ---------------------------------------------------------------------------
;; Little-endian byte encoding (pure integer math; portable both platforms)
;; ---------------------------------------------------------------------------

(defn u32->le-bytes
  "u32 -> 4 little-endian byte ints (0-255), matching Rust's `u32::to_le_bytes`."
  [x]
  (let [x (bit-and (long x) 0xFFFFFFFF)]
    [(bit-and x 0xFF)
     (bit-and (bit-shift-right x 8) 0xFF)
     (bit-and (bit-shift-right x 16) 0xFF)
     (bit-and (bit-shift-right x 24) 0xFF)]))

(defn le-bytes->u32
  "Inverse of `u32->le-bytes` — 4 little-endian byte ints -> u32."
  [[b0 b1 b2 b3]]
  (bit-or b0
          (bit-shift-left b1 8)
          (bit-shift-left b2 16)
          (bit-shift-left b3 24)))

(defn- u32-at
  "Read a little-endian u32 from byte-int vector `data` at offset `off`."
  [data off]
  (le-bytes->u32 [(nth data off) (nth data (+ off 1)) (nth data (+ off 2)) (nth data (+ off 3))]))

(defn string->byte-seq
  "UTF-8 encode a string to a vector of byte ints (0-255)."
  [s]
  )

(defn byte-seq->string
  "Decode a vector (or seq) of byte ints (0-255) as UTF-8."
  [bytes]
  )

(defn pad-len
  "Number of zero/space-padding bytes needed to round `n` up to a 4-byte
  boundary."
  [n]
  (mod (- 4 (mod n 4)) 4))

;; ---------------------------------------------------------------------------
;; Write (raw tier — bytes in, bytes out, no JSON involved)
;; ---------------------------------------------------------------------------

(defn write-glb-raw
  "Write GLB bytes (byte-int vector) from already-serialized JSON bytes +
  binary buffer bytes (both byte-int vectors; `bin` may be nil, treated as
  empty). Pure chunk framing: 12-byte header (magic/version/total-length),
  then the JSON chunk (space-padded to 4 bytes), then the BIN chunk
  (zero-padded to 4 bytes)."
  [json bin]
  (let [json (vec json)
        bin (vec (or bin []))
        json-pad (pad-len (count json))
        json-chunk-len (+ (count json) json-pad)
        bin-pad (pad-len (count bin))
        bin-chunk-len (+ (count bin) bin-pad)
        total-len (+ 12 8 json-chunk-len 8 bin-chunk-len)]
    (vec (concat
          ;; 12-byte header: magic + version + total length
          (u32->le-bytes glb-magic)
          (u32->le-bytes glb-version)
          (u32->le-bytes total-len)
          ;; JSON chunk
          (u32->le-bytes json-chunk-len)
          (u32->le-bytes chunk-type-json)
          json
          (repeat json-pad (int \space))
          ;; BIN chunk
          (u32->le-bytes bin-chunk-len)
          (u32->le-bytes chunk-type-bin)
          bin
          (repeat bin-pad 0)))))

;; ---------------------------------------------------------------------------
;; Parse (raw tier — bytes in, bytes out, no JSON involved)
;; ---------------------------------------------------------------------------

(defn parse-glb-raw
  "Parse raw GLB bytes (byte-int vector) into `{:json [byte-ints] :bin
  (nilable [byte-ints])}` — the JSON chunk is returned as raw UTF-8 bytes, not
  decoded. Throws `ex-info` on malformed input."
  [data]
  (let [data (vec data)
        n (count data)]
    (when (< n 12) (throw (ex-info "invalid GLB: too short for GLB header" {})))
    (let [magic (u32-at data 0)]
      (when (not= magic glb-magic) (throw (ex-info "invalid GLB: invalid magic" {}))))
    (let [version (u32-at data 4)]
      (when (not= version glb-version) (throw (ex-info "invalid GLB: unsupported GLB version" {}))))
    (let [total-len (u32-at data 8)]
      (when (< n total-len) (throw (ex-info "invalid GLB: data shorter than declared length" {}))))
    (when (< n 20) (throw (ex-info "invalid GLB: too short for JSON chunk header" {})))
    (let [json-len (u32-at data 12)
          json-type (u32-at data 16)]
      (when (not= json-type chunk-type-json) (throw (ex-info "invalid GLB: first chunk is not JSON" {})))
      (let [json-end (+ 20 json-len)]
        (when (< n json-end) (throw (ex-info "invalid GLB: JSON chunk truncated" {})))
        (let [json (subvec data 20 json-end)
              bin (when (>= n (+ json-end 8))
                    (let [bin-len (u32-at data json-end)
                          bin-type (u32-at data (+ json-end 4))]
                      (when (= bin-type chunk-type-bin)
                        (let [bin-start (+ json-end 8)
                              bin-end (+ bin-start bin-len)]
                          (when (>= n bin-end) (subvec data bin-start bin-end))))))]
          {:json json :bin bin})))))

;; ---------------------------------------------------------------------------
;; Write / parse (ergonomic tier — map in/out, auto JSON encode/decode)
;; ---------------------------------------------------------------------------

(defn- json-value->bytes
  "`:json` may be a plain CLJC map/vector (auto-encoded), a string (encoded as
  UTF-8 as-is, assumed already-serialized JSON text), or a byte-int
  seq/vector (used verbatim, assumed already-serialized JSON bytes)."
  [json]
  (cond
    (map? json) (string->byte-seq (glb.json/->json json))
    (string? json) (string->byte-seq json)
    (nil? json) []
    :else (vec json)))

(defn write-glb
  "Write a complete GLB byte sequence from `{:json <map-or-pre-serialized-
  json-bytes-or-string> :bin <byte-seq-or-nil>}`. When `:json` is a map (or
  any non-string sequential-of-non-ints ambiguity aside — maps only trigger
  auto-encoding), it is serialized with `glb.json/->json` first; strings and
  byte sequences are treated as already-serialized JSON and used as-is."
  [{:keys [json bin]}]
  (write-glb-raw (json-value->bytes json) bin))

(defn parse-glb
  "Parse raw GLB bytes (byte-int vector) into `{:json <parsed-map> :bin
  (nilable [byte-ints])}` — the JSON chunk is UTF-8 decoded and JSON-parsed
  (via `glb.json/parse`) for you. Use `parse-glb-raw` if you want the raw
  JSON bytes instead (e.g. to parse with a different JSON layer)."
  [data]
  (let [{:keys [json bin]} (parse-glb-raw data)]
    {:json (glb.json/parse (byte-seq->string json))
     :bin bin}))
