;; clojure.set -- the four finite-set operations the compiler's own sources
;; call, as a TEMPLATE module over the element type.
;;
;; WHAT THIS IS. `#{:a :b}` in guest source lowers to a typed set
;; `[:set :keyword]`, and a typed set of any element type answers to
;; `typed-set-count` / `typed-set-contains` / `typed-set-conj` /
;; `typed-set-disj` / `typed-set-nth`. Those five are the structure; this file
;; is the algebra over them, written once and instantiated per element type
;; by amu's project linker (`(:params [elem ...])`, ADR adr-2609113100).
;; Each function is the clojure.set definition restated over a bounded,
;; finite set: union is s1 with every member of s2 conjoined; difference is
;; s1 with every member of s2 disjoined (a member absent from s1 is a no-op,
;; as `disj` is); intersection is the members of s1 that s2 contains; subset?
;; is "every member of s1 is in s2", true of the empty set. The oracle is
;; clojure.set itself: test/kotoba/lang/clojure_set_compat_test.cljk runs
;; this text on the KIR interpreter over every pair of subsets of a
;; five-element universe -- 1,024 pairs per function -- and compares.
;;
;; WHY `(:params [elem :keyword])` AND NOT `(:params [elem])`. The modules
;; that need this are DUAL-RUNTIME: the compiler's own sources keep loading on
;; nbb / Clojure while they are being admitted here, and their
;; `(:require [clojure.set :as set])` cannot carry a `:with {elem :keyword}`
;; -- measured 2026-09-11: ClojureScript 1.12.42 refuses the spec ("Only :as,
;; :refer and :rename options supported in :require / :require-macros");
;; Clojure 1.12.5 and nbb load it only because they ignore libspec options
;; they do not know. So the template carries its own default: a `:require`
;; without `:with` is the require with `:with {elem :keyword}` -- same
;; instantiation, same text, same definition CIDs as an importer that spells
;; it out. `:keyword` because that is what the compiler's sets are: measured
;; over the 16 of its modules that require clojure.set, the operands are
;; effect rows, capability ids and map-key sets (keywords) in all but three
;; (symbol heads in kotoba-sema's frontend, CID strings in amu's package
;; lock, path strings in amu's coverage). A module whose sets are not keyword
;; sets is REFUSED at the first such call, by type, at the call site:
;; `expression type mismatch: expected [:set :keyword], got [:set :string]`.
;; Nothing is inferred from a call site; the binding is written here.
;;
;; A Kotoba-only importer chooses another element type the ordinary way:
;;   (:require [clojure.set :as symset :with {elem :symbol}])
;;
;; WHAT IS NOT HERE, and why (each recorded in `lang/compat.edn` too):
;;   * the other arities. clojure.set/union is variadic over zero or more
;;     sets, intersection and difference over one or more. This language has
;;     no variadic function; each arity is a written clause, and the compiler's
;;     own call sites are the two-argument shape in all but two places
;;     (`(apply set/union ...)` / `(reduce set/union ...)`, which pass the
;;     function as a VALUE and are a different wall). Two-argument only, so
;;     an arity this file does not answer is refused by count, never by a
;;     different answer.
;;   * `superset?` -- subset? with the arguments swapped; absent under THIS
;;     name until a call site needs it (none of the compiler's sources does).
;;     It IS provided under the host coll's name by
;;     `lang/compat/kotoba/lang/coll.kotoba`, the guest-route twin of
;;     kotoba.lang.coll, which restates this file's four bodies as
;;     set-union / set-difference / set-intersection / subset? and adds it.
;;   * `select`, `project`, `rename-keys`, `rename`, `index`, `map-invert`,
;;     `join` -- relations (sets of maps) and predicates as values; neither
;;     has a typed spelling here yet. Absent by name, with the reason in
;;     `lang/compat.edn`, rather than approximated.
;;
;; NOT `stdlib.i64-set`. That artifact (`lang/stdlib/i64_set.kotoba`) is the
;; same algebra over a SORTED PAIR CHAIN of i64 -- a different structure
;; with a different contract (sorted, i64-only, no `#{...}` literal reaches
;; it). This file is the algebra over the language's own typed set.
;;
;; Consumed through the ordinary project route, which needs no JVM:
;;   amu check app.cljk --source-path <app> --source-path <this repo>/lang/compat --jvm-free

(ns clojure.set
  (:params [elem :keyword])
  (:export [union difference intersection subset?]))

;; s1 with every member of s2 conjoined. `conj` reaches the typed set through
;; the friendly surface; `typed-set-nth` walks s2 by index, so this is
;; O(|s2|) steps of a fuel-bounded loop.
(defn union [s1 [:set elem] s2 [:set elem]] [:set elem]
  (loop [i 0 acc s1]
    (if (< i (count s2))
      (recur (+ i 1) (conj acc (typed-set-nth [:set elem] s2 i)))
      acc)))

;; s1 with every member of s2 disjoined. clojure.set/difference walks the
;; smaller set when s1 is the smaller; the SET it answers is the same either
;; way, and this walks s2 unconditionally.
(defn difference [s1 [:set elem] s2 [:set elem]] [:set elem]
  (loop [i 0 acc s1]
    (if (< i (count s2))
      (recur (+ i 1) (disj acc (typed-set-nth [:set elem] s2 i)))
      acc)))

;; The members of s1 that s2 contains, built up from the empty set.
;; `contains?` does not reach a typed set through the friendly surface (it is
;; a map head there), so the primitive is spelled.
(defn intersection [s1 [:set elem] s2 [:set elem]] [:set elem]
  (loop [i 0 acc (typed-set-new [:set elem])]
    (if (< i (count s1))
      (let [x (typed-set-nth [:set elem] s1 i)]
        (recur (+ i 1) (if (typed-set-contains [:set elem] s2 x) (conj acc x) acc)))
      acc)))

;; Every member of s1 is in s2; vacuously true of an empty s1, as
;; clojure.set/subset? is. Stops at the first member that is not.
(defn subset? [s1 [:set elem] s2 [:set elem]] :bool
  (loop [i 0]
    (if (< i (count s1))
      (if (typed-set-contains [:set elem] s2 (typed-set-nth [:set elem] s1 i))
        (recur (+ i 1))
        false)
      true)))
