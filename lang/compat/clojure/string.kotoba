;; clojure.string -- the host string library's guest twin, forwarding over
;; kotoba.lang.text where it has the name and implementing the rest over the
;; string builtins (string-concat, string-byte-length, string-code-point-at,
;; string-from-i64, string-find-byte, string-substring, string-index-of...).
;;
;; The callers spell these `str/join`, `str/replace`, `str/split`, ... (measured
;; at scale: join 745, replace 568, starts-with? 475 sites). This is the
;; forwarding-wrapper convention (kotoba.text over kotoba.string).

(ns clojure.string
  (:require [kotoba.lang.text :as text])
  (:export [join replace starts-with? ends-with? includes? blank? trim triml
            trimr reverse index-of last-index-of split split-lines lower-case
            upper-case capitalize escape]))

(defn- strs [] [:list :string] (typed-list-new [:list :string]))
(defn- sconj [xs [:list :string] s :string] [:list :string] (typed-list-conj [:list :string] xs s))
(defn- utf16-next [s :string i :i64] :i64 (+ i (if (< (string-code-point-at s i) 65536) 1 2)))

;; ---- forwarding (kotoba.lang.text's surface) ----------------------------------------

(defn starts-with? [s :string p :string] :bool (text/starts-with? s p))
(defn ends-with? [s :string p :string] :bool (text/ends-with? s p))
(defn includes? [s :string p :string] :bool (text/includes? s p))
(defn blank? [s :string] :bool (text/blank? s))
(defn trim [s :string] :string (text/trim s))
(defn triml [s :string] :string (text/triml s))
(defn trimr [s :string] :string (text/trimr s))
(defn reverse [s :string] :string (text/reverse s))
(defn index-of [s :string p :string] [:option :i64] (text/index-of s p))
(defn last-index-of [s :string p :string] [:option :i64] (text/last-index-of s p))
(defn replace [s :string p :string r :string] :string (text/replace s p r))

;; ---- implemented over the string builtins ------------------------------------------

(defn- fold [s :string] :string
  ;; ASCII lowercasing; non-ASCII scalars pass through.
  (let [n (string-byte-length s)]
    (loop [i 0 acc ""]
      (if (>= i n) acc
        (let [c (string-code-point-at s i)
              c2 (if (and (>= c 65) (<= c 90)) (+ c 32) c)]
          (recur (+ i 1) (string-concat acc (string-from-i64 c2))))))))
(defn- fold-up [s :string] :string
  (let [n (string-byte-length s)]
    (loop [i 0 acc ""]
      (if (>= i n) acc
        (let [c (string-code-point-at s i)
              c2 (if (and (>= c 97) (<= c 122)) (- c 32) c)]
          (recur (+ i 1) (string-concat acc (string-from-i64 c2))))))))
(defn lower-case [s :string] :string (fold s))
(defn upper-case [s :string] :string (fold-up s))

(defn- is-space? [c :i64] :bool (or (= c 32) (= c 9) (= c 10) (= c 13) (= c 12) (= c 11)))

(defn split-lines [s :string] [:list :string]
  (let [n (string-byte-length s)]
    (loop [i 0 start 0 acc (strs)]
      (if (>= i n) (sconj acc (string-substring s start n))
        (let [c (string-code-point-at s i)]
          (if (= c 10)
            (recur (+ i 1) (+ i 1) (sconj acc (string-substring s start i)))
            (if (= c 13)
              (if (and (< (+ i 1) n) (= (string-code-point-at s (+ i 1)) 10))
                (recur (+ i 2) (+ i 2) (sconj acc (string-substring s start i)))
                (recur (+ i 1) (+ i 1) (sconj acc (string-substring s start i))))
              (recur (+ i 1) start acc))))))))

(defn split [s :string sep :string] [:list :string]
  (let [n (string-byte-length s)
        sn (string-byte-length sep)]
    (if (= sn 0)
      (split-lines s)
      (loop [i 0 start 0 acc (strs)]
        (if (>= i n) (sconj acc (string-substring s start n))
          (if (and (<= (+ i sn) n) (= (string-substring s i (+ i sn)) sep))
            (recur (+ i sn) (+ i sn) (sconj acc (string-substring s start i)))
            (recur (utf16-next s i) start acc)))))))

(defn join [sep :string xs [:list :string]] :string
  (let [n (vector-count xs)]
    (loop [i 0 acc ""]
      (if (>= i n) acc
        (recur (+ i 1) (string-concat acc (string-concat (if (= i 0) "" sep) (typed-list-nth [:list :string] xs i))))))))

(defn capitalize [s :string] :string
  (if (= (string-byte-length s) 0) s
    (string-concat (fold (string-substring s 0 1))
                   (string-substring s 1 (string-byte-length s)))))

(defn escape [s :string cmap [:map :i64 :string]] :string
  (let [n (string-byte-length s)]
    (loop [i 0 acc ""]
      (if (>= i n) acc
        (let [c (string-code-point-at s i)
              repl (option-value-of [:option :string] (typed-map-get [:map :i64 :string] cmap c) "")]
        (recur (utf16-next s i)
               (string-concat acc (if (> (string-byte-length repl) 0) repl (string-from-i64 c)))))))))
