;; clojure.string -- a DECLARED-TEMPORARY compat shim over `kotoba.string`.
;;
;; This file used to hold the definitions. On 2026-09-08 the owner made
;; `kotoba.string` the canonical guest string library and everything moved
;; there; what is left here forwards, one line per name, so there is exactly
;; one implementation.
;;
;; WHY IT IS NOT SIMPLY DELETED, measured 2026-09-08 rather than assumed:
;;
;;   grep -rl --include='*.kotoba' '\[clojure\.string' orgs | wc -l
;;   -> 74
;;
;;   network-awai/app-hyakka        66
;;   kotoba-lang/loop-system-dynamics 6
;;   kotoba-lang/lang-pure-wt         1
;;   kotoba-lang/kotoba-lang          1
;;
;; Deleting the namespace stops 74 guest modules from resolving their
;; `(:require [clojure.string :as str])`. Rewriting those 74 call sites is a
;; separate migration with its own decision; this workspace's rule is that a
;; rename does not travel on the back of an unrelated change.
;;
;; REMOVAL CONDITION, so this does not become permanent by default: this file
;; goes when the count above reaches 0. `lang/compat.edn`'s
;; `:modules :clojure.string :shim` records the same number and date, and
;; re-running that one command is the whole of the check.
;;
;; WHY FORWARDING WRAPPERS AND NOT A RE-EXPORT: a bare re-export is not
;; expressible in this subset. Measured 2026-09-08 at amu 9092ee34:
;;
;;   (ns kotoba.text (:require [kotoba.string :as ks]) (:export [byte-index-of]))
;;   -> :kotoba.error/export-names-undefined
;;      "namespace exports must name declared public functions:
;;       byte-index-of is not defined in this module"
;;
;; So each name below is a one-line call into `kotoba.string`. One
;; implementation, one extra call frame, no second copy to drift.
;;
;; WHAT IS NOT HERE: `join`. It lives in `kotoba.string.join` because it needs
;; a newer amu than these do -- see that file's header. Putting it here would
;; make all 74 call sites above need that amu, which is the defect this
;; arrangement exists to avoid.
;;
;; The absent names -- lower-case, upper-case, capitalize, split, split-lines,
;; replace, replace-first -- are absent for the reasons `lang/compat.edn`
;; records, and moving the definitions did not change any of them. index-of and
;; last-index-of are NOT among them any more: #653 landed them on
;; [:option :i64] on 2026-09-08, and they forward from here like the rest.

(ns clojure.string
  (:require [kotoba.string :as ks])
  (:export [starts-with? ends-with? includes?
            blank? trim triml trimr reverse
            index-of last-index-of]))

(defn starts-with? [s :string prefix :string] :bool (ks/starts-with? s prefix))
(defn ends-with? [s :string suffix :string] :bool (ks/ends-with? s suffix))
(defn includes? [s :string substring :string] :bool (ks/includes? s substring))
(defn blank? [s :string] :bool (ks/blank? s))
(defn trim [s :string] :string (ks/trim s))
(defn triml [s :string] :string (ks/triml s))
(defn trimr [s :string] :string (ks/trimr s))
(defn reverse [s :string] :string (ks/reverse s))

;; index-of / last-index-of arrived in #653, on the same day and into this
;; file, and moved to kotoba.string with everything else. They answer
;; [:option :i64] -- Clojure's nil, spelled as the option nil IS in a typed
;; guest -- rather than kotoba.string/utf16-index-of's -1 sentinel, which a
;; caller can thread into arithmetic. The recorded blocker for that spelling
;; (an option-returning function refusing to lower to wasm32 for the whole
;; project) was re-measured CLOSED at amu 9092ee34 on 2026-09-08.
(defn index-of [s :string value :string] [:option :i64] (ks/index-of s value))
(defn last-index-of [s :string value :string] [:option :i64] (ks/last-index-of s value))
