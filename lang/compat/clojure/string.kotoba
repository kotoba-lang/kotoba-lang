;; clojure.string, for source that is being moved to Kotoba.
;;
;; A `.cljc` module carries `(:require [clojure.string :as str])`, and the
;; point of this file is that the line survives the move: the namespace
;; resolves here through the ordinary project route
;; (`--source-path <this directory's parent's parent>`), so `str/includes?`
;; keeps meaning what it meant.
;;
;; WHAT IS HERE IS ONLY WHAT IS EXACTLY EQUIVALENT. Kotoba's string surface is
;; addressed in UTF-8 BYTES -- `string-length` on "aあb" is 5, not 3, and
;; `string-code-point-at` takes a byte offset (both measured 2026-08-31). Three
;; of `clojure.string`'s functions are indifferent to that and are here; the
;; rest are not, and are listed in `lang/compat.edn` with the reason rather
;; than provided in an approximate form. An approximate `lower-case` or
;; `index-of` under the real name is the shape of defect this whole workspace
;; keeps writing rules about: it answers, and the answer is quietly wrong.
;;
;; Cost, stated because it is not free: `ends-with?` walks the haystack once by
;; code point to find whether the suffix begins on a boundary, and recursion
;; here is fuel-bounded like any other guest recursion.

(ns clojure.string
  (:export [starts-with? ends-with? includes?]))

;; UTF-8 width from the code point itself, which is what lets the scans below
;; advance without ever landing inside a code point -- `string-substring` and
;; `string-code-point-at` REFUSE a split index rather than returning something
;; wrong, so an off-by-one here would be a trap, not a false answer.
(defn- code-point-width [point :i64] :i64
  (if (< point 128)
    1
    (if (< point 2048)
      2
      (if (< point 65536) 3 4))))

;; Compared code point by code point rather than with one `string-substring`,
;; because `(string-substring "あ" 0 1)` refuses -- so the substring form would
;; TRAP on `(starts-with? "あ" "a")` where the answer is false.
(defn- prefix-from? [s :string prefix :string index :i64] :bool
  (if (= index (string-byte-length prefix))
    true
    (let [in-string (string-code-point-at s index)
          in-prefix (string-code-point-at prefix index)]
      (if (= in-string in-prefix)
        (prefix-from? s prefix (+ index (code-point-width in-prefix)))
        false))))

(defn starts-with? [s :string prefix :string] :bool
  (if (> (string-byte-length prefix) (string-byte-length s))
    false
    (prefix-from? s prefix 0)))

;; Whether `target` is a code-point boundary of `s`. A suffix of valid UTF-8
;; can only begin on one, so a target that is not a boundary answers false --
;; which is also why this is a scan and not arithmetic.
(defn- boundary-at? [s :string target :i64 index :i64] :bool
  (if (= index target)
    true
    (if (> index target)
      false
      (boundary-at? s target (+ index (code-point-width (string-code-point-at s index)))))))

(defn ends-with? [s :string suffix :string] :bool
  (let [length (string-byte-length s)
        suffix-length (string-byte-length suffix)]
    (if (> suffix-length length)
      false
      (if (boundary-at? s (- length suffix-length) 0)
        (string=? (string-substring s (- length suffix-length) length) suffix)
        false))))

;; `string-contains?` is exact for a non-empty needle -- verified on multi-byte
;; input -- but REFUSES an empty one (`empty-string-search-needle`), where
;; Clojure answers true. That single case is the whole reason this is not just
;; an alias.
(defn includes? [s :string substring :string] :bool
  (if (= (string-byte-length substring) 0)
    true
    (string-contains? s substring)))
