;; clojure.walk -- restated over `:document`, the one value type of this
;; language that carries arbitrary nested EDN, which is exactly the data
;; clojure.walk walks when the data is EDN.
;;
;; WHY THIS EXISTS (adr-2609111900, the self-host ceiling loop, 2026-09-12):
;; at selfhost-distance measurement 16 (amu 5d8e23e4, 225 compiler sources
;; on the project route) 15 modules were refused
;;   `required module clojure.walk is missing from the explicit source paths`
;; -- a wall, not a defect: nothing on the guest route answered to the name.
;; The corpus calls it 25 times (reader survey the same day): walk/postwalk
;; 14, walk/prewalk 6, walk/walk 1, walk/keywordize-keys 1,
;; walk/stringify-keys 1, walk/postwalk-replace 1, walk/prewalk-replace 1.
;;
;; WHAT IS PROVIDED: the four names that take DATA -- `prewalk-replace`,
;; `postwalk-replace`, `keywordize-keys`, `stringify-keys` -- each the
;; clojure.walk definition restated over a document: children of a map are
;; its entries, walked as `[k v]` vectors (clojure.walk hands the visitor a
;; MapEntry, which IS a vector of two, and rebuilds with `into {}`: a
;; two-vector is an entry, a map contributes its entries, anything else has
;; no meaning -- see `entry-into`); vectors, lists and sets element-wise,
;; sets deduplicated as `(into #{} ...)` deduplicates; scalars are leaves.
;; `prewalk-replace` replaces on the way IN and descends into the
;; replacement; `postwalk-replace` descends and replaces on the way OUT, the
;; rebuilt entry and the rebuilt map both being candidates. The two `-keys`
;; convert every map's string keys with `keyword-from-string` (namespace at
;; the first slash, as `keyword`) and keyword keys with `keyword-name`
;; (`name`: the namespace is DROPPED, as clojure.walk drops it). The oracle
;; is clojure.walk itself: test/kotoba/lang/clojure_walk_compat_test.cljk
;; runs this text on the KIR interpreter over 36 EDN forms x 6 replacement
;; maps and compares values and container shapes.
;;
;; WHAT IS NOT HERE, and why (each recorded in `lang/compat.edn` too):
;;   * `walk`, `prewalk`, `postwalk` -- the three that take a FUNCTION, and
;;     21 of the corpus's 25 call sites. A document -> document function
;;     cannot be a parameter: `(defn apply-doc [f [:fn [[:document]
;;     :document]] d :document] :document (f d))` is refused
;;       `callable parameter types currently require the i64 closure ABI`
;;     (:kotoba.error/callable-parameter-type, measured 2026-09-12 at amu
;;     b6052761 through `amu check --jvm-free`; guest-grammar.edn
;;     :callable-type :parameter-types is #{:i64}, lang/surface-status.edn
;;     :typed-closure-parameters is :not-yet-implemented). Absent by name
;;     until that lands, rather than approximated under the real name.
;;   * `prewalk-demo`, `postwalk-demo` (print to the host's stdout),
;;     `macroexpand-all` (there are no macros here).
;;
;; WHERE THE TWO DIFFER IN TYPE, AND ON PURPOSE: every parameter and result
;; is `:document` where the host takes any Clojure data. A `[:vector :i64]`
;; operand is a CHECK-TIME refusal at the call site (`expression type
;; mismatch: expected document, got vector-i64`), not a different answer on
;; an input both accept.
;;
;; WHERE THE TWO DIFFER IN ANSWER, each asserted in the oracle test:
;;   * equality. clojure.walk compares with `=`, under which `[1 2]` and
;;     `(1 2)` are one value; document equality tells them apart. So the
;;     lookup key into the replacement map (whose keys are canonicalised
;;     once, `canon-keys`) and the members of a rebuilt set are compared
;;     through `canon` -- every list respelled as a vector -- taken only
;;     when the form's EDN text holds a `(`, so the ordinary case pays
;;     nothing. NOT canonicalised: the walked map itself. A walk that
;;     PRODUCES a list key beside its vector twin keeps both entries where
;;     the host keeps one. Numbers keep the JVM's identity (an i64 is never
;;     an f64), which ClojureScript's `=` does not have.
;;   * key collisions. `(keywordize-keys {"a" 1 :a 2})` is `{:a 2}` on the
;;     host and `(keywordize-keys {:a 2 "a" 1})` is `{:a 1}` -- `into {}`
;;     takes the literal's entry order and the later wins, so ONE map value
;;     has two answers there. A document map has one order (its keys sorted)
;;     and this answers one thing for the value.
;;   * an entry replaced by something that is not an entry TRAPS here
;;     (`assert`, which is :division-by-zero: the portable trap ABI has no
;;     message channel) where the host throws; a one-vector replacement
;;     traps where the two hosts disagree with each other.
;;   * `keyword-from-string` TRAPS :invalid-keyword-source on a string the
;;     reader could not read back as a keyword (empty, a leading colon,
;;     whitespace or delimiters) where clojure.core/keyword mints one.
;;   * a replacement map that is not a document map TRAPS
;;     :document-map-required at its first lookup, where the host's
;;     `contains?` is false on nil and an index test on a vector.
;;   * a container placed at depth 8 makes a document of depth 9, which
;;     TRAPS `document exceeds depth limit`; the host has no limit.
;;
;; HOW IT IS BUILT, and the three measured shapes it has to keep:
;;   * a list or set is rebuilt through its EDN text. The admitted document
;;     operations (kotoba-sema document-fixed-operations at b82c7bb3) grow a
;;     vector (`document-vector-conj`) and a map (`document-assoc`), read a
;;     list by index, and read a set only by membership -- there is no
;;     document-list-conj, document-set-conj or document-set-nth, and
;;     `document-list` / `document-set` take a static item count. So a set's
;;     members are read by printing it and reading `[...]` back, and a
;;     rebuilt vector becomes a list or set by printing it and reading
;;     `(...)` / `#{...}` back -- the same print/read pair the language's own
;;     round-trip conformance asserts (amu document_edn_test `same`), on
;;     ASCII delimiters, so no byte offset splits a code point.
;;   * `visit` holds its four loops (map / vector / list / set) in TAIL
;;     position and finishes in the loops' exits. kotoba-sema b82c7bb3
;;     refuses a function with two loops whose results are both used off
;;     the tail -- the second's `(document-vector)` init is checked against
;;     :i64 (`expression type mismatch: expected i64, got document`,
;;     reproduced with two `(g (loop [i 0 acc (document-vector)] ...))` in
;;     one function). A frontend implementation state, recorded in
;;     lang/compat.edn; when it is fixed nothing here has to change.
;;   * the recursive group is 5. The definition identity hashes a strongly
;;     connected component as a unit and refuses one larger than 8 members
;;     (`:definition-cid :recursive-group-too-large`); `visit` and its four
;;     loop helpers are the whole cycle, `canon` and its helpers a separate
;;     one of 4. A draft with separate visit / children / entry-visit and
;;     three loop wrappers made a group of 9 and every dependent definition
;;     `:dependency-unavailable`.
;;
;; DEPTH. The walk is recursive: two guest frames per document level, and a
;; document is at most 8 deep, so nothing here is fuel-bounded by depth. On
;; the KIR reference interpreter run by SCI on Node with Node's default
;; stack, though, the host stack is the ceiling (measured 2026-09-12: a
;; vector nested 3 deep answers and 4 traps `fuel-exhausted
;; :host-stack-exhausted`; prewalk-replace over a map holding a map traps at
;; depth 2); the oracle test runs its deep table in a child
;; Node with `--stack-size=4000`, where every depth answers. A harness
;; property, not the language's.
;;
;; Consumed through the ordinary project route, which needs no JVM:
;;   amu check app.kotoba --source-path <app> --source-path <this repo>/lang/compat --jvm-free

(ns clojure.walk
  (:export [prewalk-replace postwalk-replace keywordize-keys stringify-keys]))

;; ---------------------------------------------------------------------------
;; reading a container

;; The indexed reads answer [:option :document]; every index here is below the
;; container's own count, so the fallback is never taken.
(defn- item-at [v :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at v i) (document-null)))

(defn- list-item-at [l :document i :i64] :document
  (option-value-of [:option :document] (document-list-at l i) (document-null)))

(defn- entry-at [m :document i :i64] :document
  (option-value-of [:option :document] (document-map-entry-at m i) (document-null)))

;; The text between a container's delimiters: `open` bytes off the front, one
;; off the back. Every delimiter this file strips is ASCII, so the byte
;; offsets never split a code point.
(defn- inner-text [s :string open :i64] :string
  (string-substring s open (- (string-length s) 1)))

;; A set's members as a vector, through its EDN text: `#{a b}` -> `[a b]`.
(defn- set-items [s :document] :document
  (document-edn-read (string-concat "[" (string-concat (inner-text (document-edn-print s) 2) "]"))))

;; A vector as a list, through its EDN text: `[a b]` -> `(a b)`.
(defn- vector-as-list [v :document] :document
  (document-edn-read (string-concat "(" (string-concat (inner-text (document-edn-print v) 1) ")"))))

;; A vector as a set, through its EDN text: `[a b]` -> `#{a b}`. The items
;; must already be distinct under document equality, or the read refuses.
(defn- vector-as-set [v :document] :document
  (document-edn-read (string-concat "#{" (string-concat (inner-text (document-edn-print v) 1) "}"))))

;; ---------------------------------------------------------------------------
;; equality: clojure.walk compares with `=`, under which a list and a vector
;; of the same items are ONE value; document equality tells them apart. So a
;; lookup key and a set member are compared through `canon`, the form with
;; every list respelled as a vector -- only when the form's text has a `(`
;; in it, so the ordinary case pays nothing (see the header).

(defn- has-equal? [v :document x :document] :bool
  (loop [i 0]
    (if (< i (document-count v))
      (if (document-equal? (item-at v i) x) true (recur (+ i 1)))
      false)))

;; The items of `v` with later duplicates dropped, as `(into #{} v)` drops
;; them -- under document equality.
(defn- distinct-by-equal [v :document] :document
  (loop [i 0 acc (document-vector)]
    (if (< i (document-count v))
      (let [x (item-at v i)]
        (recur (+ i 1) (if (has-equal? acc x) acc (document-vector-conj acc x))))
      acc)))

;; `d` with every list, at any depth, respelled as a vector.
(defn- canon [d :document] :document
  (let [kind (document-kind d)]
    (if (= :map kind)
      (loop [i 0 acc (document-map)]
        (if (< i (document-count d))
          (let [e (entry-at d i)]
            (recur (+ i 1) (document-assoc acc (canon (item-at e 0)) (canon (item-at e 1)))))
          acc))
      (if (= :vector kind)
        (loop [i 0 acc (document-vector)]
          (if (< i (document-count d))
            (recur (+ i 1) (document-vector-conj acc (canon (item-at d i))))
            acc))
        (if (= :list kind)
          (loop [i 0 acc (document-vector)]
            (if (< i (document-count d))
              (recur (+ i 1) (document-vector-conj acc (canon (list-item-at d i))))
              acc))
          (if (= :set kind)
            (let [items (set-items d)]
              (loop [i 0 acc (document-vector)]
                (if (< i (document-count items))
                  (recur (+ i 1) (document-vector-conj acc (canon (item-at items i))))
                  (vector-as-set (distinct-by-equal acc)))))
            d))))))

;; `d` as clojure.walk's `=` would see it: canonical when it holds a list,
;; itself otherwise (a `(` can also sit inside a string, which only costs a
;; needless canon).
(defn- seq-key [d :document] :document
  (if (string-contains? (document-edn-print d) "(") (canon d) d))

(defn- has-seq-equal? [v :document x :document] :bool
  (let [cx (seq-key x)]
    (loop [i 0]
      (if (< i (document-count v))
        (if (document-equal? (seq-key (item-at v i)) cx) true (recur (+ i 1)))
        false))))

;; The items of `v` with later duplicates dropped, as `(into #{} v)` drops
;; them -- under clojure.walk's `=`.
(defn- distinct-by-seq-equal [v :document] :document
  (loop [i 0 acc (document-vector)]
    (if (< i (document-count v))
      (let [x (item-at v i)]
        (recur (+ i 1) (if (has-seq-equal? acc x) acc (document-vector-conj acc x))))
      acc)))

;; The replacement map with its keys canonical, so that `document-get` with
;; a canonical lookup key finds `[1 2]` and `(1 2)` alike. A smap that is
;; not a map passes through and traps at its first lookup.
(defn- canon-keys [smap :document] :document
  (if (= :map (document-kind smap))
    (loop [i 0 acc (document-map)]
      (if (< i (document-count smap))
        (let [e (entry-at smap i)]
          (recur (+ i 1) (document-assoc acc (canon (item-at e 0)) (item-at e 1))))
        acc))
    smap))

;; ---------------------------------------------------------------------------
;; rebuilding a map from walked entries

;; `(into {} entries)`: a two-item vector is an entry, a map contributes its
;; entries, anything else has no meaning as an entry and TRAPS here (the host
;; throws).
(defn- entry-into [m :document e :document] :document
  (if (= :map (document-kind e))
    (document-merge m e)
    (do (assert (= :vector (document-kind e)))
        (assert (= 2 (document-count e)))
        (document-assoc m (item-at e 0) (item-at e 1)))))

;; `(if (contains? smap x) (smap x) x)`.
(defn- replace-if [smap :document form :document] :document
  (option-value-of [:option :document] (document-get smap (seq-key form)) form))

(defn- keywordize-key [k :document] :document
  (if (= :string (document-kind k))
    (document-keyword (keyword-from-string (option-value-of [:option :string] (document-string-value k) "")))
    k))

(defn- stringify-key [k :document] :document
  (if (= :keyword (document-kind k))
    (document-string (keyword-name (option-value-of [:option :keyword] (document-keyword-value k) :none)))
    k))

;; ---------------------------------------------------------------------------
;; the traversal: one engine for the four exports, selected by `mode`

;; What happens to a rebuilt node on the way OUT. :post: it is a candidate
;; for replacement. The others: nothing.
(defn- finish [mode :keyword smap :document built :document] :document
  (if (= :post mode) (replace-if smap built) built))

;; What happens to a map entry `[k v]` on the way out, after its key and
;; value have been visited (clojure.walk hands the visitor a MapEntry, a
;; vector of two). :post: the entry itself is a candidate for replacement.
;; :kw / :str: the key is converted. (:pre never comes here: an entry is
;; visited whole, see `visit`.)
(defn- entry-after [mode :keyword smap :document walked :document] :document
  (if (= :post mode)
    (replace-if smap walked)
    (if (= :kw mode)
      (document-vector (keywordize-key (item-at walked 0)) (item-at walked 1))
      (document-vector (stringify-key (item-at walked 0)) (item-at walked 1)))))

;; One node. :pre replaces on the way in (`subject`), the others on the way
;; out (`finish`); between the two, a container is rebuilt from its visited
;; children and a scalar is itself. Four loops in one function, every one in
;; tail position, on purpose: the loops desugar to helper functions, and the
;; strongly connected group {visit + its helpers} is what the definition
;; identity hashes as a unit -- see the header.
(defn- visit [mode :keyword smap :document form :document] :document
  (let [subject (if (= :pre mode) (replace-if smap form) form)
        kind (document-kind subject)]
    (if (= :map kind)
      (loop [i 0 acc (document-map)]
        (if (< i (document-count subject))
          (let [e (entry-at subject i)]
            (recur (+ i 1)
                   (entry-into acc (if (= :pre mode)
                                     (visit mode smap e)
                                     (entry-after mode smap (document-vector (visit mode smap (item-at e 0))
                                                                             (visit mode smap (item-at e 1))))))))
          (finish mode smap acc)))
      (if (= :vector kind)
        (loop [i 0 acc (document-vector)]
          (if (< i (document-count subject))
            (recur (+ i 1) (document-vector-conj acc (visit mode smap (item-at subject i))))
            (finish mode smap acc)))
        (if (= :list kind)
          (loop [i 0 acc (document-vector)]
            (if (< i (document-count subject))
              (recur (+ i 1) (document-vector-conj acc (visit mode smap (list-item-at subject i))))
              (finish mode smap (vector-as-list acc))))
          (if (= :set kind)
            (let [items (set-items subject)]
              (loop [i 0 acc (document-vector)]
                (if (< i (document-count items))
                  (recur (+ i 1) (document-vector-conj acc (visit mode smap (item-at items i))))
                  (finish mode smap (vector-as-set (distinct-by-seq-equal acc))))))
            (finish mode smap subject)))))))

;; ---------------------------------------------------------------------------
;; the exports

(defn prewalk-replace [smap :document form :document] :document
  (visit :pre (canon-keys smap) form))

(defn postwalk-replace [smap :document form :document] :document
  (visit :post (canon-keys smap) form))

(defn keywordize-keys [m :document] :document
  (visit :kw (document-map) m))

(defn stringify-keys [m :document] :document
  (visit :str (document-map) m))
