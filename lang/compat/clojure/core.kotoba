;; clojure.core's error-carrying trio, for source that is being moved to
;; Kotoba: `ex-info`, `ex-message`, `ex-data`.
;;
;; These exist because the typed abort ability (`lang/abort-ability.edn`) can
;; carry a `:document` as its error type E -- measured 2026-09-02, `(throw
;; (ex-info "empty" ...))` gives the throwing function the interface
;; `[:result :i64 :document]`, a `catch` binds the document, and it survives
;; propagation through a caller that writes no throw of its own. So the shape
;; a `.cljc` module already writes -- a message and a data map, thrown, caught,
;; read back -- moves across without changing at the call sites.
;;
;; WHAT THIS IS NOT. `clojure.core/ex-info` returns an ExceptionInfo, which is
;; a Throwable: it has a class, a stack trace, a cause, and it can be thrown by
;; the ambient `throw` this language does not have. This one returns a
;; `:document`, an ordinary value with two entries. That is not an
;; approximation of a Throwable; it is a different thing that answers the three
;; questions the trio is used for. `lang/compat.edn` states the divergences,
;; and the two that can bite are:
;;
;;   * `(ex-message e)` and `(ex-data e)` TRAP on a document that is not a map
;;     (`document-map-required`, measured 2026-09-02) where clojure.core
;;     answers nil for anything that is not an ExceptionInfo. Nothing is
;;     silently wrong -- the program stops -- but it stops rather than
;;     answering, and Clojure would have answered.
;;   * There is no nil. A document with no `:message` reads as "", and one with
;;     no `:data` as `(document-null)`. Clojure returns nil for both, and nil
;;     is a value this language does not have.
;;
;; The one-argument arity of `ex-info` (message only) and the three-argument
;; one (message, data, cause) are absent: a cause is another Throwable, and
;; there is no Throwable here to be one.
;;
;; Consumed through the ordinary project route, which needs no JVM:
;;   amu check app.cljk --source-path <app> --source-path <this repo>/lang/compat --jvm-free

(ns clojure.core
  (:export [ex-info ex-message ex-data]))

;; The two entries, under the keywords clojure.core uses for the same two
;; questions. `data` is a document the caller built; nothing here inspects it,
;; so any document shape survives the round trip unchanged.
(defn ex-info [msg :string data :document] :document
  (document-map (document-keyword :message) (document-string msg)
                (document-keyword :data) data))

;; `document-get` answers `[:option :document]` and `document-string-value`
;; answers `[:option :string]`, so both are unwrapped. The defaults are what
;; makes this total where clojure.core returns nil.
(defn ex-message [e :document] :string
  (option-or (document-string-value
              (option-or (document-get e (document-keyword :message)) (document-null)))
             ""))

(defn ex-data [e :document] :document
  (option-or (document-get e (document-keyword :data)) (document-null)))
