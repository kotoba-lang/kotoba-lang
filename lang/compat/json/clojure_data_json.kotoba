(ns json.clojure-data-json
  "clojure.data.json's `read-str` / `write-str` CONTRACT, pure .cljc, re-exported
  as kotoba.json/read-str and kotoba.json/write-str.

  Why not json.data-json: that namespace forwards to json.core, whose encoder
  sorts map keys, never escapes `/` or non-ASCII, writes 32.0 as 32 and writes
  a set as the string \"#{...}\". clojure.data.json does none of those, so a
  call site moved from clojure.data.json onto it would change the bytes it
  produces. json.data-json keeps its behaviour (39 repositories already depend
  on it); this namespace is the one a clojure.data.json call site can be
  renamed onto.

  Every default below was measured against org.clojure/data.json 2.5.2 on the
  JVM (2026-09-24) and is pinned by test/json/clojure_data_json_test.cljk:

    write-str   :escape-slash true         a/b -> a\\/b
                :escape-unicode true       non-ASCII -> \\uXXXX (lower-case hex,
                                           UTF-16 code units: an emoji is two)
                :escape-js-separators true U+2028/2029 escaped even when
                                           :escape-unicode is false
                control chars              \\b \\f \\n \\r \\t named, the rest \\u00XX;
                                           U+007F is written raw
                map order                  the map's own iteration order
                keyword / symbol           (name x), so :a/b -> \"b\"
                set, list, any coll        a JSON array
                number                     (str x); a ratio as a double;
                                           NaN / Infinity throw
                uuid                       its string; an inst -> ISO-8601
                                           instant (JVM: DateTimeFormatter/
                                           ISO_INSTANT, millis only when non-zero)
                :key-fn                    default: name of a keyword/symbol,
                                           str of anything else, nil throws
                :value-fn (fn [k v])       k is the ORIGINAL key; returning the
                                           value-fn itself omits the entry
                :indent true               2 spaces, \"k\": v, {} and [] stay empty
                anything else              throws (a character, a fn, ...)
    read-str    one value after leading whitespace; TRAILING INPUT IS IGNORED
                (\"1 2\" -> 1), empty or blank input throws unless
                :eof-error? false (then :eof-value)
                integers -> long (JVM: a BigInt past Long range); a fraction or
                exponent -> double; object keys are strings unless :key-fn
                :value-fn (fn [k v]) gets the key AFTER :key-fn; returning the
                value-fn itself omits the entry
                :bigdec true is not implemented and throws (it is refused by
                the migration tool rather than approximated)

  On ClojureScript a number has one type, so 32.0 is written 32 there -- the
  same value; clojure.data.json has no ClojureScript build to differ from."
  )

;; ---------------------------------------------------------------------------
;; write
;; ---------------------------------------------------------------------------

(defn- buf [] )
(defn- add [b s]  b)
(defn- buf-str [b] )

(def ^:private hex-digits "0123456789abcdef")

(defn- hex4 [n]
  (str (nth hex-digits (bit-and (bit-shift-right n 12) 0xf))
       (nth hex-digits (bit-and (bit-shift-right n 8) 0xf))
       (nth hex-digits (bit-and (bit-shift-right n 4) 0xf))
       (nth hex-digits (bit-and n 0xf))))

(defn- code-unit [s i]
  )

(defn- write-string [sb s {:keys [escape-slash escape-unicode escape-js-separators]}]
  (add sb "\"")
  (let [n (count s)]
    (loop [i 0]
      (when (< i n)
        (let [c (code-unit s i)]
          (cond
            (= c 0x22) (add sb "\\\"")
            (= c 0x5c) (add sb "\\\\")
            (= c 0x2f) (add sb (if escape-slash "\\/" "/"))
            (= c 0x08) (add sb "\\b")
            (= c 0x0c) (add sb "\\f")
            (= c 0x0a) (add sb "\\n")
            (= c 0x0d) (add sb "\\r")
            (= c 0x09) (add sb "\\t")
            (< c 0x20) (add sb (str "\\u" (hex4 c)))
            (< c 0x80) (add sb (subs s i (inc i)))
            escape-unicode (add sb (str "\\u" (hex4 c)))
            (and escape-js-separators (or (= c 0x2028) (= c 0x2029))) (add sb (str "\\u" (hex4 c)))
            :else (add sb (subs s i (inc i))))
          (recur (inc i))))))
  (add sb "\""))

(defn- default-write-key-fn [k]
  (cond
    (or (keyword? k) (symbol? k)) (name k)
    (nil? k) (throw (ex-info "JSON object properties may not be nil" {}))
    :else (str k)))

(defn- default-value-fn [_k v] v)

(defn- type-name [x] )

(defn- write-number [sb x]
  )

(defn- write-inst [x]
  )

(defn- host-array? [x]
  )

(declare write-value)

(defn- indent! [sb opts depth]
  (when (:indent opts)
    (add sb "\n")
    (dotimes [_ depth] (add sb "  "))))

(defn- write-object [sb m opts depth]
  (let [{:keys [key-fn value-fn]} opts
        entries (keep (fn [[k v]]
                        (let [v' (value-fn k v)]
                          (when-not (identical? v' value-fn) [(key-fn k) v'])))
                      m)]
    (if (empty? entries)
      (add sb "{}")
      (do (add sb "{")
          (loop [[[k v] & more] entries first? true]
            (when-not first? (add sb ","))
            (indent! sb opts (inc depth))
            (write-string sb (str k) opts)
            (add sb (if (:indent opts) ": " ":"))
            (write-value sb v opts (inc depth))
            (when more (recur more false)))
          (indent! sb opts depth)
          (add sb "}")))))

(defn- write-array [sb xs opts depth]
  (if (empty? xs)
    (add sb "[]")
    (do (add sb "[")
        (loop [[x & more] xs first? true]
          (when-not first? (add sb ","))
          (indent! sb opts (inc depth))
          (write-value sb x opts (inc depth))
          (when more (recur more false)))
        (indent! sb opts depth)
        (add sb "]"))))

(defn- write-value [sb x opts depth]
  (cond
    (nil? x) (add sb "null")
    (boolean? x) (add sb (if x "true" "false"))
    (string? x) (write-string sb x opts)
    (or (keyword? x) (symbol? x)) (write-string sb (name x) opts)
    (number? x) (write-number sb x)
    (map? x) (write-object sb x opts depth)
    (coll? x) (write-array sb (seq x) opts depth)
    
    (host-array? x) (write-array sb (seq x) opts depth)
    (uuid? x) (write-string sb (str x) opts)
    (inst? x) (write-string sb (write-inst x) opts)
    :else (throw (ex-info (str "Don't know how to write JSON of class " (type-name x)) {:value x}))))

(defn- kw-opts
  "clojure.data.json takes trailing keyword arguments only."
  [opts]
  (if (even? (count opts))
    (apply hash-map opts)
    (throw (ex-info "options must be keyword/value pairs, as in clojure.data.json" {:opts opts}))))

(defn write-str
  "clojure.data.json/write-str: `(write-str x & options)`. See the ns doc."
  [x & options]
  (let [o (kw-opts options)
        opts {:escape-slash (get o :escape-slash true)
              :escape-unicode (get o :escape-unicode true)
              :escape-js-separators (get o :escape-js-separators true)
              :indent (boolean (:indent o))
              :key-fn (or (:key-fn o) default-write-key-fn)
              :value-fn (or (:value-fn o) default-value-fn)}
        sb (buf)]
    (write-value sb x opts 0)
    (buf-str sb)))

;; ---------------------------------------------------------------------------
;; read
;; ---------------------------------------------------------------------------

(defn- err [msg pos] (throw (ex-info (str "JSON error (" msg ")") {:pos pos})))

(defn- ws? [c] (or (= c 0x20) (= c 0x09) (= c 0x0a) (= c 0x0d)))

(defn- skip-ws [s i]
  (let [n (count s)]
    (loop [i i] (if (and (< i n) (ws? (code-unit s i))) (recur (inc i)) i))))

(defn- hex-val [s i]
  (let [c (code-unit s i)]
    (cond (<= 48 c 57) (- c 48)
          (<= 97 c 102) (+ 10 (- c 97))
          (<= 65 c 70) (+ 10 (- c 65))
          :else (err "invalid unicode escape" i))))

(defn- read-json-string [s i]
  (let [n (count s)
        sb (buf)]
    (loop [i (inc i)]
      (when (>= i n) (err "end-of-file inside string" i))
      (let [c (code-unit s i)]
        (cond
          (= c 0x22) [(buf-str sb) (inc i)]
          (= c 0x5c)
          (do (when (>= (inc i) n) (err "end-of-file inside string" i))
              (let [e (code-unit s (inc i))]
                (case (int e)
                  0x22 (do (add sb "\"") (recur (+ i 2)))
                  0x5c (do (add sb "\\") (recur (+ i 2)))
                  0x2f (do (add sb "/") (recur (+ i 2)))
                  0x62 (do (add sb "\b") (recur (+ i 2)))
                  0x66 (do (add sb "\f") (recur (+ i 2)))
                  0x6e (do (add sb "\n") (recur (+ i 2)))
                  0x72 (do (add sb "\r") (recur (+ i 2)))
                  0x74 (do (add sb "\t") (recur (+ i 2)))
                  0x75 (do (when (> (+ i 6) n) (err "end-of-file inside unicode escape" i))
                           (let [cp (+ (* 4096 (hex-val s (+ i 2))) (* 256 (hex-val s (+ i 3)))
                                       (* 16 (hex-val s (+ i 4))) (hex-val s (+ i 5)))]
                             (add sb )
                             (recur (+ i 6))))
                  (err "invalid escaped char" i))))
          :else (do (add sb (subs s i (inc i))) (recur (inc i))))))))

(def ^:private number-re #"-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?")

(defn- read-number [s i]
  (let [n (count s)
        end (loop [j i]
              (if (and (< j n) (let [c (code-unit s j)]
                                 (or (<= 48 c 57) (= c 0x2d) (= c 0x2b) (= c 0x2e) (= c 0x65) (= c 0x45))))
                (recur (inc j)) j))
        token (subs s i end)]
    (when-not (re-matches number-re token) (err "invalid number literal" i))
    ;; clojure.data.json ends a number only at whitespace , ] } or the end:
    ;; "1x" and "1/" are invalid literals there, not 1 followed by junk.
    (when (and (< end n) (let [c (code-unit s end)]
                           (not (or (ws? c) (= c 0x2c) (= c 0x5d) (= c 0x7d)))))
      (err "invalid number literal" i))
    [(if (re-find #"[.eE]" token)
       
       )
     end]))

(defn- lit [s i word v]
  (if (= word (subs s i (min (count s) (+ i (count word)))))
    [v (+ i (count word))]
    (err (str "expected " word) i)))

(declare read-value)

(defn- read-array [s i opts]
  (let [i (skip-ws s (inc i))]
    (if (and (< i (count s)) (= 0x5d (code-unit s i)))
      [[] (inc i)]
      (loop [i i out (transient [])]
        (let [[v j] (read-value s i opts)
              j (skip-ws s j)]
          (when (>= j (count s)) (err "EOF in array" j))
          (case (int (code-unit s j))
            0x2c (recur (inc j) (conj! out v))
            0x5d [(persistent! (conj! out v)) (inc j)]
            (err "unexpected character in array" j)))))))

(defn- read-object [s i {:keys [key-fn value-fn] :as opts}]
  (let [i (skip-ws s (inc i))]
    (if (and (< i (count s)) (= 0x7d (code-unit s i)))
      [{} (inc i)]
      (loop [i i out (transient {})]
        (let [i (skip-ws s i)]
          (when-not (and (< i (count s)) (= 0x22 (code-unit s i))) (err "object key must be a string" i))
          (let [[k j] (read-json-string s i)
                j (skip-ws s j)]
            (when-not (and (< j (count s)) (= 0x3a (code-unit s j))) (err "missing entry in object" j))
            (let [[v j] (read-value s (inc j) opts)
                  k' (key-fn k)
                  v' (value-fn k' v)
                  out (if (identical? v' value-fn) (dissoc! out k') (assoc! out k' v'))
                  j (skip-ws s j)]
              (when (>= j (count s)) (err "EOF in object" j))
              (case (int (code-unit s j))
                0x2c (recur (inc j) out)
                0x7d [(persistent! out) (inc j)]
                (err "unexpected character in object" j)))))))))

(defn- read-value [s i opts]
  (let [i (skip-ws s i)]
    (when (>= i (count s)) (err "end-of-file" i))
    (let [c (code-unit s i)]
      (cond
        (= c 0x22) (read-json-string s i)
        (= c 0x7b) (read-object s i opts)
        (= c 0x5b) (read-array s i opts)
        (= c 0x74) (lit s i "true" true)
        (= c 0x66) (lit s i "false" false)
        (= c 0x6e) (lit s i "null" nil)
        (or (= c 0x2d) (<= 48 c 57)) (read-number s i)
        :else (err (str "unexpected character: " (subs s i (inc i))) i)))))

(defn read-str
  "clojure.data.json/read-str: `(read-str string & options)`. See the ns doc."
  [s & options]
  (let [o (kw-opts options)
        opts {:key-fn (or (:key-fn o) identity)
              :value-fn (or (:value-fn o) default-value-fn)}]
    (when (:bigdec o)
      (throw (ex-info ":bigdec is not implemented by kotoba.json/read-str" {:opts o})))
    (when-not (string? s)
      (throw (ex-info "read-str requires a string" {:value s})))
    (if (and (false? (get o :eof-error? true)) (= (skip-ws s 0) (count s)))
      (:eof-value o)
      (first (read-value s 0 opts)))))
