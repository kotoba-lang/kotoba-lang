(ns vmm.fdt
  "Build the devicetree blob an arm64 Linux guest boots with.

  Every size, offset, alignment and name offset comes from
  `kotoba/fdt_core.kotoba`, executed from the shipped KIR. This namespace
  marshals: it writes big-endian u32 tokens at the planned offsets, formats
  hex unit-addresses, and NUL-pads strings. It decides nothing -- the one
  thing it holds is the template ORDER (which node follows which), and
  `test/vmm/fdt_test.cljk` pins that order by parsing a built blob back.

  The device addresses are plan data threaded in by the monitor: the uart
  and virtio map is `exit-core`'s (passed through, never re-typed here),
  the GICv3 placement is QEMU `virt`'s, and the memory/initrd/bootargs are
  the boot plan `vmm.arm64-boot/plan` produced."
  (:require [vmm.oracle :as oracle]))

(defn- c [f args] (oracle/call :fdt f args))
(defn- r [f args] (oracle/call-result :fdt f args))

;; ---------------------------------------------------------------------------
;; Byte marshaling. The only arithmetic here is encoding already-decided
;; values into the big-endian wire form DTSpec fixes.

(defn- be32 [n]
  (let [q #(quot % 256)]
    [(rem (q (q (q n))) 256) (rem (q (q n)) 256) (rem (q n) 256) (rem n 256)]))

(defn- be64 [n]
  (into (be32 (quot n 4294967296)) (be32 (rem n 4294967296))))

(defn- utf8-bytes [s]
  )

(defn- name-bytes [s]
  ;; NUL-terminated, padded to 4 bytes (DTSpec 5.4).
  (let [raw (conj (utf8-bytes s) 0)
        pad (rem (- 4 (rem (count raw) 4)) 4)]
    (into raw (repeat pad 0))))

(defn- prop-bytes [nameoff value-bytes]
  ;; FDT_PROP: token 3, value length, name offset, value, pad to 4.
  (let [pad (rem (- 4 (rem (count value-bytes) 4)) 4)]
    (into (into (into (be32 3) (be32 (count value-bytes)))
                (be32 nameoff))
          (into value-bytes (repeat pad 0)))))

(defn- prop-u32 [nameoff n] (prop-bytes nameoff (be32 n)))
(defn- prop-u64 [nameoff n] (prop-bytes nameoff (be64 n)))
(defn- prop-str [nameoff s] (prop-bytes nameoff (utf8-bytes s)))
(defn- prop-empty [nameoff] (prop-bytes nameoff []))

(defn- hex [n]
  )

;; ---------------------------------------------------------------------------
;; The template. Node order is fixed: root, chosen, memory, cpus, cpu,
;; psci, intc, timer, pl011, then one virtio_mmio node per device.

(defn- struct-bytes
  [{:keys [bootargs ram-base ram-size initrd-start initrd-end
           uart-base uart-size gicd-base gicd-size gicr-base gicr-size
           virtio-base virtio-stride virtio-count]}]
  (let [;; name offsets are core decisions (fdt-core str-* exports)
        s-addr (c :str-address-cells [])
        s-size (c :str-size-cells [])
        s-dtyp (c :str-device-type [])
        s-reg (c :str-reg [])
        s-boot (c :str-bootargs [])
        s-ird0 (c :str-initrd-start [])
        s-ird1 (c :str-initrd-end [])
        s-comp (c :str-compatible [])
        s-emeth (c :str-enable-method [])
        s-meth (c :str-method [])
        s-icell (c :str-interrupt-cells [])
        s-ictlr (c :str-interrupt-controller [])
        s-phand (c :str-phandle [])
        s-ints (c :str-interrupts [])
        s-aon (c :str-always-on [])
        begin (fn [nm] (into (be32 1) (name-bytes nm)))
        end (be32 2)
        nodes
        [(begin "")
         (prop-u32 s-addr 2) (prop-u32 s-size 2)
         (begin "chosen")
         (prop-str s-boot (str bootargs "\u0000"))
         (prop-u64 s-ird0 initrd-start) (prop-u64 s-ird1 initrd-end)
         end
         (begin (str "memory@" (hex ram-base)))
         (prop-str s-dtyp "memory\u0000")
         (prop-bytes s-reg (into (be64 ram-base) (be64 ram-size)))
         end
         (begin "cpus")
         (prop-u32 s-addr 1) (prop-u32 s-size 0)
         (begin "cpu")
         (prop-str s-dtyp "cpu\u0000")
         (prop-str s-comp "arm,arm-v8\u0000")
         (prop-u32 s-reg 0)
         (prop-str s-emeth "psci\u0000")
         end
         end
         (begin "psci")
         (prop-str s-comp "arm,psci-1.0\u0000")
         (prop-str s-meth "hvc\u0000")
         end
         (begin "intc")
         (prop-str s-comp "arm,gic-v3\u0000")
         (prop-u32 s-icell 3)
         (prop-empty s-ictlr)
         (prop-bytes s-reg (into (into (be64 gicd-base) (be64 gicd-size))
                                 (into (be64 gicr-base) (be64 gicr-size))))
         (prop-u32 s-phand 1)
         end
         (begin "timer")
         (prop-str s-comp "arm,armv8-timer\u0000")
         (prop-empty s-aon)
         (prop-bytes s-ints (into [] (mapcat be32 [1 13 4 1 14 4 1 11 4 1 10 4])))
         end
         (begin "pl011")
         (prop-str s-comp "arm,pl011\u0000")
         (prop-bytes s-reg (into (be64 uart-base) (be64 uart-size)))
         (prop-bytes s-ints (into [] (mapcat be32 [0 1 4])))
         end]]
    (-> (reduce into [] nodes)
        (into (mapcat
               (fn [i]
                 (let [addr (+ virtio-base (* i virtio-stride))]
                   (concat (be32 1)
                           (name-bytes (str "virtio_mmio@" (hex addr)))
                           (prop-str s-comp "virtio,mmio\u0000")
                           (prop-bytes s-reg (into (be64 addr)
                                                   (be64 virtio-stride)))
                           (prop-bytes s-ints (into [] (mapcat be32
                                                               [0 (+ 16 i) 1])))
                           (be32 2))))
               (range virtio-count)))
        (into (be32 2))                ;; the root node's own END_NODE
        (into (be32 9)))))

(def ^:private strings-block
  ;; The strings block content the core pins the offsets of (fdt-core
  ;; str-* / size-dt-strings). Built once from the same names.
  (let [names ["#address-cells" "#size-cells" "device_type" "reg" "bootargs"
               "linux,initrd-start" "linux,initrd-end" "compatible"
               "enable-method" "method" "#interrupt-cells"
               "interrupt-controller" "phandle" "interrupts" "always-on"]]
    (into [] (mapcat #(conj (utf8-bytes %) 0) names))))

(defn plan
  "Compute the blob's header numbers without emitting bytes.

  Returns `{:ok? true :totalsize n :off-dt-struct n :off-dt-strings n
  :size-dt-struct n :size-dt-strings n :virtio-name-digits n}` or
  `{:ok? false :reason \"fdt/...\"}`."
  [{:keys [bootargs ram-base virtio-base virtio-stride virtio-count]}]
  (let [ba (inc (count (utf8-bytes bootargs)))
        b (r :admit-bootargs [ba])]
    (if-not (:ok? b)
      b
      (let [rn (r :admit-ram-name [ram-base])]
        (if-not (:ok? rn)
          rn
          (let [first-addr virtio-base
                last-addr (if (> virtio-count 0)
                            (+ virtio-base (* (dec virtio-count) virtio-stride))
                            0)
                vn (r :admit-virtio-names [first-addr last-addr virtio-count])]
            (if-not (:ok? vn)
              vn
              (let [digits (:value vn)
                    total (c :totalsize [ba ram-base digits virtio-count])
                    blob (r :admit-blob [total])]
                (if-not (:ok? blob)
                  blob
                  {:ok? true
                   :totalsize total
                   :off-dt-struct (c :off-dt-struct [])
                   :off-dt-strings (c :off-dt-strings [ba ram-base digits
                                                       virtio-count])
                   :size-dt-struct (c :size-dt-struct [ba ram-base digits
                                                       virtio-count])
                   :size-dt-strings (c :size-dt-strings [])
                   :virtio-name-digits digits})))))))))

(defn build
  "Build the DTB for `plan-map`. Returns `{:ok? true :bytes [..] :plan p}`
  or `{:ok? false :reason \"fdt/...\"}`. `:bytes` is a vector of byte
  values (0..255), big-endian on the wire, total length `:totalsize`."
  [plan-map]
  (let [p (plan plan-map)]
    (if-not (:ok? p)
      p
      (let [{:keys [totalsize off-dt-struct off-dt-strings
                    size-dt-struct size-dt-strings]} p
            header (into [] (mapcat be32
                                    [(c :fdt-magic []) totalsize off-dt-struct
                                     off-dt-strings (c :off-mem-rsvmap [])
                                     (c :fdt-version []) (c :fdt-last-comp [])
                                     0 size-dt-strings size-dt-struct]))
            rsvmap (repeat (c :fdt-rsvmap-bytes []) 0)
            body (struct-bytes plan-map)]
        {:ok? true
         :plan p
         :bytes (into [] (concat header rsvmap body strings-block))}))))
