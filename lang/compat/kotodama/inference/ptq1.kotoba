(ns kotodama.inference.ptq1
  "PTQ1_0 kernel and host-runtime catalog.

  Kernel sources are shipped as classpath resources so a consumer of the
  inference library uses the same bytes as the parity and benchmark gates.
  Host runtimes remain explicit: a kernel-parity candidate is not silently
  promoted to a production-serving runtime.")

(def format-spec
  {:ggml/type 143
   :ggml/name :ptq1-0
   :ggml/block-elements 128
   :ggml/block-bytes 28
   :ggml/layout [:qs-24 :qh-2 :f16-scale]})

(def kernel-artifacts
  {:matvec
   {:resource "kotodama/inference/kernels/native/kdot_f32_r1.comp"
    :shader-language :glsl-compute
    :roles #{:decode :single-position}}
   :matvec-positions
   {:resource "kotodama/inference/kernels/native/kdot_f32_p.comp"
    :shader-language :glsl-compute
    :compile-defines #{:PFIX}
    :roles #{:prefill :batched-position}}
   :dual-swiglu
   {:resource "kotodama/inference/kernels/native/kdot_ptq1_dual_r1.comp"
    :shader-language :glsl-compute
    :roles #{:decode :fused-gate-up-silu}}
   :embedding
   {:resource "kotodama/inference/kernels/native/embed_iq4xs.comp"
    :shader-language :glsl-compute
    :compile-defines #{:PTQ1}
    :roles #{:token-embedding}}
   :signed-hadamard
   {:resource "kotodama/inference/kernels/native/hadamard_signed.comp"
    :shader-language :glsl-compute
    :roles #{:folded-weight-basis :embedding-inverse :gdn-reorder}}})

(def host-runtimes
  {:kotoba-vulkan
   {:runtime/repository "kotoba-lang/inference"
    :runtime/kernel-set :kotodama/ptq1-v1
    :runtime/backends #{:vulkan}
    :runtime/qualification :full-token-b70
    :runtime/production? false}
   :prism-vulkan-int-dot
   {:runtime/repository "PrismML-Eng/llama.cpp"
    :runtime/revision "3ae4f51087d8d9292eda16ee00cec54e798ea576"
    :runtime/backends #{:vulkan}
    :runtime/qualification :production-k16
   :runtime/production? true}
   :prism-metal-row5
   {:runtime/repository "PrismML-Eng/llama.cpp"
    :runtime/revision "239413b3ec1f4e99309780ae20bd7024e1e3d361"
    :runtime/backends #{:metal}
    :runtime/qualification :kernel-parity-m1-max
    :runtime/production? false}
   :prism-metal-graph-fusions
   {:runtime/repository "PrismML-Eng/llama.cpp"
    :runtime/revision "bdc23b56b4458b9f1655aec5287f3ab56ee8daaa"
    :runtime/backends #{:metal}
    :runtime/qualification :kernel-parity-m1-m4-speed-rejected
    :runtime/production? false}})

(defn kernel-artifact
  "Return a named shipped kernel artifact, refusing unknown roles."
  [id]
  (or (get kernel-artifacts id)
      (throw (ex-info "unknown PTQ1 kernel artifact"
                      {:kernel/id id
                       :kernel/available (vec (sort (keys kernel-artifacts)))}))))

(defn host-runtime
  "Return a named host runtime. When `production?` is true, candidates with
  only kernel or canary evidence fail closed."
  ([id] (host-runtime id false))
  ([id production?]
   (let [runtime (or (get host-runtimes id)
                     (throw (ex-info "unknown PTQ1 host runtime"
                                     {:runtime/id id
                                      :runtime/available (vec (sort (keys host-runtimes)))})))]
     (when (and production? (not (:runtime/production? runtime)))
       (throw (ex-info "PTQ1 host runtime is not production-qualified"
                       {:runtime/id id
                        :runtime/qualification (:runtime/qualification runtime)})))
     runtime)))
