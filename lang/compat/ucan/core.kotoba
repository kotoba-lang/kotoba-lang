(ns ucan.core
  "Bounded UCAN Delegation v1 (`ucan/dlg@1.0.0`) signing and verification.

  Wire bytes are canonical DAG-CBOR. The only cryptosuite in this profile is
  Ed25519 + did:key. Full UCAN policy evaluation is intentionally outside this
  namespace; `exact-resource` is a closed, auditable integration profile."
  (:require [clojure.string :as str] [cbor.core :as cbor] [did.core :as did] [ed25519.core :as ed] [multiformats.core :as mf]))

(def delegation-tag "ucan/dlg@1.0.0")

(def varsig-ed25519-dag-cbor
  "Varsig v1: prefix 0x34, version 1, EdDSA/Ed25519, DAG-CBOR."
  )

(def ^:private required-payload-fields
  #{"iss" "aud" "sub" "cmd" "pol" "nonce" "exp"})
(def ^:private optional-payload-fields #{"meta" "nbf"})
(def ^:private max-safe-integer 9007199254740991)

(defn- fail! [problem message data]
  (throw (ex-info message (assoc data :ucan/problem problem))))

(defn- bytes-like? [x]
  )

(defn- byte-count [x]
  )

(defn- unsigned-bytes [x]
  (mapv #(bit-and (int %) 0xff) (seq x)))

(defn- bytes= [a b]
  (and (bytes-like? a) (bytes-like? b)
       (= (unsigned-bytes a) (unsigned-bytes b))))

(defn- base-did [x]
  (when-not (and (string? x) (did/did? x))
    (fail! :ucan/invalid-did "UCAN principal must be a DID" {:value x}))
  (:did (did/parse x)))

(defn- safe-time? [x]
  (and (integer? x) (<= (- max-safe-integer) x max-safe-integer)))

(defn- valid-command? [command]
  (and (string? command)
       (= command (str/lower-case command))
       (str/starts-with? command "/")
       (or (= command "/") (not (str/ends-with? command "/")))
       (not (str/includes? command "//"))))

(defn- command-covers? [parent child]
  (or (= parent "/")
      (= parent child)
      (str/starts-with? child (str parent "/"))))

(defn- validate-payload! [payload]
  (when-not (map? payload)
    (fail! :ucan/payload-not-map "UCAN payload must be a map" {}))
  (let [fields (set (keys payload))]
    (when-not (every? string? fields)
      (fail! :ucan/non-string-field "UCAN payload keys must be strings" {}))
    (when-not (every? fields required-payload-fields)
      (fail! :ucan/missing-field "UCAN payload is missing a required field"
             {:missing (set (remove fields required-payload-fields))}))
    (when-let [unknown (seq (remove #(or (required-payload-fields %)
                                         (optional-payload-fields %))
                                   fields))]
      (fail! :ucan/unknown-field "UCAN payload contains unsupported fields"
             {:fields (set unknown)})))
  (doseq [field ["iss" "aud"]] (base-did (get payload field)))
  (when (some? (get payload "sub")) (base-did (get payload "sub")))
  (when-not (valid-command? (get payload "cmd"))
    (fail! :ucan/invalid-command "UCAN command is not a lowercase slash path"
           {:command (get payload "cmd")}))
  (when-not (vector? (get payload "pol"))
    (fail! :ucan/invalid-policy "UCAN policy must be a vector" {}))
  (let [nonce (get payload "nonce")]
    (when-not (and (bytes-like? nonce) (pos? (byte-count nonce))
                   (<= (byte-count nonce) 64))
      (fail! :ucan/invalid-nonce "UCAN nonce must contain 1..64 bytes" {})))
  (when (and (contains? payload "nbf")
             (not (safe-time? (get payload "nbf"))))
    (fail! :ucan/invalid-nbf "UCAN nbf must be a safe integer" {}))
  (let [exp (get payload "exp")]
    (when-not (or (nil? exp) (safe-time? exp))
      (fail! :ucan/invalid-exp "UCAN exp must be null or a safe integer" {})))
  (when (and (contains? payload "meta")
             (not (and (map? (get payload "meta"))
                       (<= (count (get payload "meta")) 32)
                       (every? string? (keys (get payload "meta"))))))
    (fail! :ucan/invalid-meta "UCAN meta must be a bounded string-keyed map" {}))
  payload)

(defn exact-resource
  "Closed policy profile: return the one URI constrained by
  `[[\"==\" \".resource\" <uri>]]`, or throw. This is deliberately not a
  partial implementation of the general UCAN policy language."
  [payload]
  (let [policy (get payload "pol")]
    (when-not (and (= 1 (count policy))
                   (vector? (first policy))
                   (= 3 (count (first policy)))
                   (= ["==" ".resource"] (subvec (first policy) 0 2))
                   (string? (nth (first policy) 2))
                   (re-matches #"[a-z][a-z0-9+.-]*:.+" (nth (first policy) 2)))
      (fail! :ucan/unsupported-policy
             "this profile requires one exact .resource URI predicate" {}))
    (nth (first policy) 2)))

(defn- canonical-decode [wire]
  (when-not (bytes-like? wire)
    (fail! :ucan/not-bytes "UCAN envelope must be bytes" {}))
  (let [decoded (try (cbor/decode wire)
                     (catch  e
                       (fail! :ucan/invalid-cbor "UCAN envelope is not valid CBOR"
                              {:cause })))
        encoded (cbor/encode decoded)]
    (when-not (bytes= wire encoded)
      (fail! :ucan/non-canonical "UCAN envelope must be canonical DAG-CBOR" {}))
    decoded))

(defn- cid-base58-dag-cbor [wire]
  (let [body (concat (seq (mf/varint 1))
                     (seq (mf/varint mf/codec-dag-cbor))
                     (seq (mf/multihash-sha256 wire)))]
    (str "z" (mf/base58btc body))))

(defn token-cid
  "Return the normative base58btc CIDv1/dag-cbor/sha2-256 token identifier."
  [wire]
  (canonical-decode wire)
  (cid-base58-dag-cbor wire))

(defn sign-delegation
  "Sign a string-keyed Delegation v1 payload using a raw 32-byte Ed25519 seed.
  Returns canonical DAG-CBOR envelope bytes."
  [seed payload]
  (validate-payload! payload)
  (let [issuer (base-did (get payload "iss"))
        signer (ed/did-key-from-seed seed)]
    (when-not (= issuer signer)
      (fail! :ucan/issuer-key-mismatch "payload issuer does not match signing key"
             {:issuer issuer :signer signer}))
    (let [sig-payload {"h" varsig-ed25519-dag-cbor delegation-tag payload}
          signed-bytes (cbor/encode sig-payload)
          signature (ed/sign seed signed-bytes)]
      (cbor/encode [signature sig-payload]))))

(defn verify-delegation
  "Verify one canonical Ed25519/did:key Delegation v1 envelope.
  Returns only inert verified data; it does not mint authority."
  [wire]
  (let [envelope (canonical-decode wire)]
    (when-not (and (vector? envelope) (= 2 (count envelope)))
      (fail! :ucan/invalid-envelope "UCAN envelope must be a two-element array" {}))
    (let [[signature sig-payload] envelope]
      (when-not (and (bytes-like? signature) (= 64 (byte-count signature)))
        (fail! :ucan/invalid-signature "UCAN signature must contain 64 bytes" {}))
      (when-not (and (map? sig-payload)
                     (= #{"h" delegation-tag} (set (keys sig-payload))))
        (fail! :ucan/invalid-sig-payload "UCAN signature payload fields are invalid" {}))
      (when-not (bytes= varsig-ed25519-dag-cbor (get sig-payload "h"))
        (fail! :ucan/unsupported-varsig "UCAN Varsig is outside this profile" {}))
      (let [payload (validate-payload! (get sig-payload delegation-tag))
            issuer (base-did (get payload "iss"))
            signed-bytes (cbor/encode sig-payload)]
        (when-not (try (ed/verify-did issuer signed-bytes signature)
                       (catch  _ false))
          (fail! :ucan/bad-signature "UCAN Ed25519 signature did not verify" {}))
        {:ucan/cid (cid-base58-dag-cbor wire)
         :ucan/payload payload}))))

(defn verify-chain
  "Verify a root-to-leaf vector of Delegation v1 envelope bytes.

  Required options:
  - `:now` safe integer epoch seconds
  - `:revoked?` CID -> exactly true/false (unknown fails closed)
  - `:resource!` verified payload -> normalized resource string

  Optional bounds default to 16 tokens and 1 MiB total. Authority can only
  shrink: subject and resource remain exact, command stays equal or descends,
  time is checked per token, and every parent audience aligns to child issuer."
  [chain {:keys [now revoked? resource! max-depth max-bytes]
          :or {max-depth 16 max-bytes 1048576}}]
  (when-not (and (vector? chain) (seq chain) (<= (count chain) (inc max-depth))
                 (safe-time? now) (fn? revoked?) (fn? resource!)
                 (integer? max-bytes) (pos? max-bytes)
                 (<= (reduce + (map #(if (bytes-like? %) (byte-count %) max-bytes)
                                    chain))
                     max-bytes))
    (fail! :ucan/invalid-chain-input "UCAN chain input or bounds are invalid" {}))
  (let [verified (mapv verify-delegation chain)
        payloads (mapv :ucan/payload verified)
        cids (mapv :ucan/cid verified)
        root (first payloads)
        leaf (peek payloads)
        subject (get root "sub")
        resources (mapv resource! payloads)]
    (when (nil? subject)
      (fail! :ucan/powerline-root "a Powerline cannot be a root delegation" {}))
    (when-not (= (base-did (get root "iss")) (base-did subject))
      (fail! :ucan/root-not-self-certifying
             "root issuer must equal the delegation subject" {}))
    (doseq [[cid payload] (map vector cids payloads)]
      (let [revoked (revoked? cid)
            nbf (get payload "nbf" 0)
            exp (get payload "exp")]
        (when-not (or (true? revoked) (false? revoked))
          (fail! :ucan/revocation-unknown "revocation state must be known"
                 {:cid cid}))
        (when revoked
          (fail! :ucan/revoked "UCAN delegation is revoked" {:cid cid}))
        (when (< now nbf)
          (fail! :ucan/not-yet-valid "UCAN delegation is not yet valid" {:cid cid}))
        (when (and (some? exp) (> now exp))
          (fail! :ucan/expired "UCAN delegation has expired" {:cid cid}))
        (when (nil? (get payload "sub"))
          (fail! :ucan/powerline-unsupported
                 "Powerline is not supported by this bounded profile" {:cid cid}))
        (when-not (= (base-did subject) (base-did (get payload "sub")))
          (fail! :ucan/subject-mismatch "UCAN subject changed within the chain"
                 {:cid cid}))))
    (doseq [i (range 1 (count payloads))]
      (let [parent (nth payloads (dec i))
            child (nth payloads i)]
        (when-not (= (base-did (get parent "aud"))
                     (base-did (get child "iss")))
          (fail! :ucan/principal-misalignment
                 "parent audience does not match child issuer" {:index i}))
        (when-not (command-covers? (get parent "cmd") (get child "cmd"))
          (fail! :ucan/command-amplification
                 "child command is broader than its parent" {:index i}))
        (when-not (= (nth resources (dec i)) (nth resources i))
          (fail! :ucan/resource-amplification
                 "resource changed within the bounded equality profile"
                 {:index i}))))
    {:ucan/valid? true
     :ucan/problems []
     :ucan/root-iss (base-did (get root "iss"))
     :ucan/audience (base-did (get leaf "aud"))
     :ucan/resources (set resources)
     :ucan/expires (let [xs (keep #(get % "exp") payloads)]
                     (when (seq xs) (apply min xs)))
     :ucan/depth (dec (count payloads))
     :ucan/attenuated? true}))
