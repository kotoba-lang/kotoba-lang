(ns block.cache.worker
  "A Cloudflare Workers Cache API tier.

  This is the only thing on that platform that plays the role Hummock gives a
  local SSD: colo-local, survives the isolate, orders of magnitude closer than
  R2. It is not a substitute for the memory tier and is not meant to be — put
  `block.cache/memory` in front of it with `block.cache/async-tiered`, which
  promotes on a hit so the memory tier learns what is hot.

  Two properties a caller must know:

  - **The Cache API is per-colo.** A read served at a different edge is a
    miss, and that is correct rather than unfortunate: the alternative is a
    cross-colo coherence protocol for a cache whose keys cannot go stale
    anyway. Expect a cold first read per colo, not a global hit rate.
  - **Writes are best-effort and eviction is Cloudflare's.** An entry can
    disappear at any time for reasons this code cannot see. That is
    acceptable here for exactly one reason: a CID-keyed cache has no
    correctness stake in retention, only a performance one."
  (:require [block.cache :as bc]))

(def ^:private origin
  "A synthetic origin. Cache API keys are Requests, so a CID becomes a URL
  under a host that resolves to nothing — these entries must never be
  fetchable from outside this Worker."
  "https://block-cache.kotobase.invalid/b/")

(defn- req [cid] (js/Request. (str origin (js/encodeURIComponent cid))))

(defn cache-api
  "An `IAsyncBlockCache` over `caches.default` (or a supplied cache).

  `:max-age` only tells Cloudflare how long it MAY keep an entry; it is not a
  correctness parameter, because the key is content-addressed and cannot go
  stale. Default one day.

  With no Cache API available this degrades to a cache that stores and finds
  nothing, rather than throwing — a missing local tier should cost latency,
  not availability."
  ([] (cache-api {}))
  ([{:keys [cache max-age] :or {max-age 86400}}]
   (let [c (or cache (some-> (.-caches js/globalThis) (.-default)))]
     (reify bc/IAsyncBlockCache
       (-lookup-async [_ cid]
         (if-not c
           (js/Promise.resolve nil)
           (-> (.match c (req cid))
               (.then (fn [resp]
                        (when resp
                          (-> (.arrayBuffer resp)
                              (.then (fn [buf] (js/Uint8Array. buf)))))))
               (.catch (fn [_] nil)))))
       (-store-async! [_ cid bytes]
         (if-not c
           (js/Promise.resolve nil)
           ;; best-effort: a cache write must never fail a read it was only
           ;; meant to accelerate.
           (-> (.put c (req cid)
                     (js/Response. bytes
                                   #js {:headers #js {"cache-control" (str "max-age=" max-age)
                                                      "content-type" "application/octet-stream"}}))
               (.catch (fn [_] nil)))))))))
