(ns mailer.core
  (:require [kotoba.lang.text :as str]
            [mail.message :as message]
            [mail.receipt :as receipt]))

(def supported-providers #{:resend :smtp :ses})

(def provider-capabilities
  {:resend #{"mail/send" "net/fetch" "secrets/get:resend-api-key"}
   :smtp #{"mail/send" "smtp/send" "secrets/get:smtp-credentials"}
   :ses #{"mail/send" "aws/ses-send" "secrets/get:aws-credentials"}})

(defn provider-config [provider attrs]
  (when-not (supported-providers provider)
    (throw (ex-info "unsupported mail provider" {:provider provider})))
  (merge {:mailer.provider/id provider
          :mailer.provider/required-capabilities (provider-capabilities provider)}
         attrs))

(defn- address-wire [address]
  (let [a (message/normalize-address address)]
    ;; `mail.message/normalize-address` accepts either spelling of the email key
    ;; (`:email` or `:mail.address/email`) and copies every other key through
    ;; untouched, so a display name arrives under whichever key the caller wrote.
    ;; Reading only the namespaced one dropped the name of every address spelled
    ;; `{:email _ :name _}` without saying so.
    (if-let [display-name (or (:mail.address/name a) (:name a))]
      {:email (:mail.address/email a) :name display-name}
      (:mail.address/email a))))

(defn- media-type
  "The media type of a MIME content-type, without parameters and case-folded.

  `text/plain`, `text/plain; charset=utf-8` and `TEXT/Plain; charset=\"utf-8\"`
  all name the same type: RFC 2045 puts the parameters in the value, not in the
  type's identity. Comparing the whole header string instead made a part whose
  charset was spelled differently invisible."
  [content-type]
  (some-> content-type
          (str/split #";")
          first
          str/trim
          str/lower
          not-empty))

(defn- body-of [parts content-type]
  (some #(when (= content-type (media-type (:mail.part/content-type %)))
           (:mail.part/body %))
        parts))

(defn- message-wire [m]
  (message/assert-valid-message m)
  (let [parts (:mail/parts m)
        text (body-of parts "text/plain")
        html (body-of parts "text/html")]
    ;; `mail.message/validation-errors` only asks whether the message has parts,
    ;; so a message carrying nothing but parts this wire format cannot express
    ;; is valid. Building the request anyway produced a well-formed instruction
    ;; to send an email with no body at all -- the failure would have surfaced at
    ;; the recipient, not here. Refuse instead.
    (when-not (or text html)
      (throw (ex-info "mail message has no text/plain or text/html part to send"
                      {:mail/subject (:mail/subject m)
                       :mail.part/content-types (mapv :mail.part/content-type parts)})))
    (merge {:from (address-wire (:mail/from m))
            :to (mapv address-wire (:mail/to m))
            :cc (mapv address-wire (:mail/cc m))
            :bcc (mapv address-wire (:mail/bcc m))
            :subject (:mail/subject m)}
           (when-let [reply-to (:mail/reply-to m)]
             {:reply_to (address-wire reply-to)})
           (when text {:text text})
           (when html {:html html}))))

(defn request
  "Return a host-executable provider request for an approved mail effect."
  [provider effect]
  (let [m (:mail.effect/message effect)]
    (when-not (= :mail/send (:mail.effect/type effect))
      (throw (ex-info "mailer request requires mail/send effect" {:effect effect})))
    (case provider
      :resend
      {:mailer.request/provider :resend
       :mailer.request/capabilities (provider-capabilities :resend)
       :http/method :post
       :http/url "https://api.resend.com/emails"
       :http/auth-secret :resend-api-key
       :http/json (message-wire m)}

      :smtp
      {:mailer.request/provider :smtp
       :mailer.request/capabilities (provider-capabilities :smtp)
       :smtp/action :send
       :smtp/credentials-secret :smtp-credentials
       :smtp/message (message-wire m)}

      :ses
      {:mailer.request/provider :ses
       :mailer.request/capabilities (provider-capabilities :ses)
       :aws/action :ses-send-email
       :aws/credentials-secret :aws-credentials
       :aws/payload (message-wire m)}

      (throw (ex-info "unsupported mail provider" {:provider provider})))))

(defn materialize-receipt [effect provider-result]
  (receipt/receipt effect
                   (:provider provider-result)
                   {:message-id (:message-id provider-result)
                    :status (:status provider-result)}))
