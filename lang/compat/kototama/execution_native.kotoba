(ns kototama.execution-native
  "Native v2 mechanism composition over the existing measured executor.
  The launcher supplies the plugin; this namespace imports no native engine."
  {:kotoba/export [mechanisms]}
  (:require [kotoba.artifact.execution :as blocks]
            [kotoba.artifact.core :as artifact]
            [kotoba.value.codec :as value]
            [kotoba.abi.target :as target]) [kotoba.form :as form])
 [kotoba.form :as form]
;; amu-refactor: positional access.  Host: what [a b] destructuring does; Kotoba: Form child, nil-form past the end.
#?(:kotoba
   (defn- fe-nth [f [:ref :form/r] i :i64] [:ref :form/r] (form/nth-of f i))
   :default
   (defn- fe-nth [c i] (nth c i nil)))

;; amu-refactor: keyword lookup.  Host: `get`; Kotoba: form-get with a keyword Form.
#?(:kotoba
   (defn- fe-get [m [:ref :form/r] k :keyword] [:ref :form/r] (form/form-get m (form/keyword-form k)))
   :default
   (defn- fe-get [m k] (get m k)))


(defn- reject! [reason]
  (throw (ex-info "native v2 mechanism refused" {:phase :execution-native :reason reason})))

(defn- canonical-value [x]
  (cond
    
    
    (and (integer? x) (or (< x -9007199254740991) (> x 9007199254740991))) (value/int64 x)
    (and (number? x) (not (integer? x))) (value/float64 x)
    (vector? x) (mapv canonical-value x)
    (map? x) (into {} (map (fn [dd__781_1] (let [k (fe-nth dd__781_1 0) v (fe-nth dd__781_1 1)] [(canonical-value k) (canonical-value v)])) x))
    (set? x) (set (map canonical-value x))
    (seq? x) (apply list (map canonical-value x))
    :else x))

(defn mechanisms
  "PLUGIN is the actual native executor's prepare/execute/close! functions.
  Admission independently stages and measures the loader through prepare,
  then closes it; execution revalidates signatures, runtime and effect policy.
  TRUST/POLICY/LOADER-PATH/CLOCK! are launcher-owned, never packet fields."
  [plugin trust policy loader-path clock!]
  (when-not (and (= #{:prepare :execute :close!} (set (keys plugin)))
                 (every? fn? (vals plugin)) (fn? clock!)
                 (string? loader-path) (seq loader-path))
    (reject! :invalid-launcher))
  {:inspect!
   (fn [envelope runtime]
     (let [session ((:prepare plugin) envelope trust
                    {:now (quot (clock!) 1000) :runtime runtime :loader-path loader-path})]
       (try
         (let [artifact (:artifact session) target-id (:target artifact)
               profile (get target/profiles target-id)
               interface {:format :kotoba.native-interface/v2
                          :entry (get-in artifact [:program :entry]) :exports (get-in artifact [:program :exports])
                          :functions (mapv #(select-keys % [:name :params :result :effects])
                                           (get-in artifact [:program :functions]))}]
           (when-not (and (= [] (get-in artifact [:program :signature :params]))
                          (= :i64 (get-in artifact [:program :signature :result])))
             (reject! :pure-zeroarg-i64-required))
           (when-not (and (contains? #{nil :on} (get-in artifact [:limits :fuel-metering]))
                          (let [fuel (get-in artifact [:limits :fuel])]
                            ))
             (reject! :explicit-native-fuel-required))
           (when (seq (:effects artifact)) (reject! :native-effect-provider-not-v2-wired))
           (when-not (and (= :native (:family profile))
                          (= (get-in profile [:layout :isa]) (get-in artifact [:target-profile :isa]))
                          (= (get-in profile [:layout :abi]) (get-in artifact [:target-profile :abi]))
                          (or (= :portable (get-in profile [:layout :os]))
                              (= (get-in profile [:layout :os]) (get-in artifact [:target-profile :os])))
                          (= :supervisor (:mode (:layout profile)))
                          (contains? (:context-versions profile) (canonical-value (get-in artifact [:context-abi :version]))))
             (reject! :unsupported-native-profile))
           {:target target-id :profile :sync
            :artifact-cid (:cid (blocks/block :artifact-envelope
                           {:format :kotoba.signed-native-reference/v2
                            :sealed-bytes (artifact/canonical-bytes envelope)}))
            :interface-cid (:cid (blocks/block :interface interface))
            :runtime-identity (:cid (blocks/block :runtime (canonical-value runtime)))
            :layout (assoc (:layout profile) :context-version (canonical-value (get-in artifact [:context-abi :version])))})
         (finally ((:close! plugin) session)))))
   :execute!
   (fn [dd__4068_1]
     (let [artifact (fe-get dd__4068_1 :artifact)
           runtime (fe-get dd__4068_1 :runtime)
           input (fe-get dd__4068_1 :input)]
       (when-not (and (map? input) (= #{:entry :arguments} (set (keys input)))
                    (symbol? (:entry input)) (vector? (:arguments input)))
       (reject! :invalid-native-input))
     (let [observed ((:execute plugin) artifact trust policy {:args (:arguments input)}
                     {:now (quot (clock!) 1000) :entry (:entry input)
                      :runtime runtime :loader-path loader-path})
           result (canonical-value {:evidence (:evidence observed) :report (:report observed)
                   :started-at (:started-at observed) :finished-at (:finished-at observed)})]
       (if (= :ok (get-in observed [:evidence :status]))
         result
         (throw (ex-info "native guest trapped" {:execution-outcome {:status :trap :value result}}))))))})
