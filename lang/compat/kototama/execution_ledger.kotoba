(ns kototama.execution-ledger
  "Node host durable use ledger. Explicit private storage, atomic lock and
  fsync-before-effect; an abandoned lock or corrupt journal fails closed."
  {:kotoba/export [open-ledger!]}
    (:require )
)

(defn- reject! [reason]
  (throw (ex-info "execution ledger denied" {:phase :execution-ledger :reason reason})))



(defn open-ledger!
  "DIRECTORY must already exist, be owned by this UID and mode 0700. Keep it
  across restarts. Crash locks require operator recovery, never automatic reset.
  Trusted storage and a monotone host epoch are required; this is not a defense
  against privileged disk rollback or a distributed consensus implementation."
  [directory]
  )
