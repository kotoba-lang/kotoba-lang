;; envelope.qualify — what the deployed ML-KEM-768 module actually does,
;; measured rather than read off its version string.
;;
;; `kotoba.security.crypto-policy/evaluate-pq-provider` decides whether a
;; post-quantum provider is qualified, and it is deliberately unwilling to
;; infer that from an algorithm label. It wants a module digest it can bind
;; to, known-answer tests, encapsulation and decapsulation verified
;; separately, invalid ciphertext rejected, and a module load that fails
;; closed. This namespace produces exactly that evidence by running the
;; module, and produces NOTHING when it cannot run — an evidence map whose
;; fields are absent is refused by that evaluator, which is the point.
;;
;;   (-> (qualify/qualify {:module-digest measured
;;                         :expected-module-digest pinned
;;                         :implementation-version "0.5.4"
;;                         :vectors vectors})
;;       (.then #(policy/evaluate-pq-provider % pinned)))
;;
;; The digest is a PARAMETER, not something read from disk here: this half
;; of the repo runs in a Worker and a browser, where there is no file to
;; read. `scripts/qualify-mlkem.cljk` is the host that measures it.
(ns envelope.qualify
  (:require ["@noble/post-quantum/ml-kem.js" :refer [ml_kem768]]
            [envelope.kem :as kem]
            [envelope.seal :as seal]
            [envelope.seal-sync :as seal-sync]
            [kotoba.signal.x25519 :as x25519]))

(def provider-id
  "The identity `evaluate-pq-provider` records. It names the module, not the
  wrapper: `envelope.kem` is a binding, and qualifying a binding would say
  nothing about the code that computes the shared secret."
  :noble/ml-kem-768)

(def algorithms [:ml-kem-768])

(def module-files
  "The files inside @noble/post-quantum that implement ML-KEM, in the order
  the digest folds them. `_crystals.js` holds the lattice arithmetic and
  `utils.js` the coders; leaving either out would bind a digest to a third
  of the module and read as though it bound all of it."
  ["_crystals.js" "ml-kem.js" "utils.js"])

(def pinned-module-digest
  "sha256 over `<file> <sha256>` lines for `module-files`, newline-terminated.

  Measured 2026-09-06 against @noble/post-quantum 0.5.4. package.json asks
  for an exact version rather than a range for this one dependency, because
  a range makes the deployed provider unmeasured and `evaluate-pq-provider`
  binds to a module, not to a version string. When this stops matching, the
  installed module changed: re-run `scripts/qualify-mlkem.cljk`, read what
  it says about the known answers, and move the pin deliberately.

  What it does NOT cover: @noble/hashes (SHA3/SHAKE) and @noble/curves,
  which ml-kem.js imports from other packages. Those are covered only by
  the known-answer test, which cannot pass with a broken SHAKE."
  "sha256:4d51638aa53788fea271e9da65818b55961822da060a3adc51eda02e2b3f3b86")

(defn- bytes= [^js a ^js b]
  (and (some? a) (some? b)
       (= (.-length a) (.-length b))
       (every? #(= (aget a %) (aget b %)) (range (.-length a)))))

(defn- module!
  "The module, or a throw. Every path that uses ML-KEM goes through here, so
  a digest that does not match the pin refuses at the point of use rather
  than being noted somewhere and stepped over."
  [module-digest expected-module-digest]
  (when-not (and (string? expected-module-digest) (seq expected-module-digest))
    (throw (ex-info "no pinned ML-KEM module digest" {})))
  (when-not (= module-digest expected-module-digest)
    (throw (ex-info "ML-KEM module digest does not match the pin"
                    {:measured module-digest :expected expected-module-digest})))
  ml_kem768)

(defn- module-load-fails-closed?
  "Probe the refusal, rather than asserting it. Same function, a digest that
  is wrong by one character: if it returns a module, the fail-closed claim
  is false and must be reported false."
  [expected-module-digest]
  (try (module! (str expected-module-digest "0") expected-module-digest)
       false
       (catch :default _ true)))

;; ── the checks ───────────────────────────────────────────────────────────

(defn- kat-decapsulation
  "Known answers, from an implementation that is not this one. The vectors
  in kotoba-lang/security were generated by BouncyCastle; agreeing with them
  is a cross-implementation result, which is the only kind that means
  anything here — a module checked against its own output agrees always."
  [mlkem vectors]
  (every? (fn [{:keys [decapsulation-key ciphertext shared-secret]}]
            (try (bytes= shared-secret (.decapsulate mlkem ciphertext decapsulation-key))
                 (catch :default _ false)))
          vectors))

(defn- encapsulation-round-trips
  "Encapsulate to a FOREIGN encapsulation key and open it with the foreign
  decapsulation key. ML-KEM encapsulation is randomised, so there is no
  known answer to compare against; what can be shown is that this module's
  encapsulation is openable by the key pair another implementation made."
  [mlkem vectors]
  (every? (fn [{:keys [encapsulation-key decapsulation-key]}]
            (try (let [enc (.encapsulate mlkem encapsulation-key)]
                   (bytes= (.-sharedSecret enc)
                           (.decapsulate mlkem (.-cipherText enc) decapsulation-key)))
                 (catch :default _ false)))
          vectors))

(defn- malformed-ciphertext-throws?
  [mlkem {:keys [decapsulation-key]}]
  (try (.decapsulate mlkem (js/Uint8Array. 10) decapsulation-key)
       false
       (catch :default _ true)))

(defn- corrupt-ciphertext-rejected-sync?
  "The same measurement through `envelope.seal-sync`, the second opener of
  hybrid wraps. Both openers call this module through `envelope.kem`, so the
  qualification covers both only if both refuse: a backend that is not
  measured here would be using a provider whose evidence was taken from
  somebody else's code path."
  []
  (let [r (seal-sync/generate-hybrid-recipient)
        wrap (seal-sync/wrap-bytes-hybrid (js/Uint8Array. #js [1 2 3 4 5 6 7 8]) r "qualify/aad")
        ct (seal-sync/unb64url (:wrap/pq-ct wrap))
        _ (aset ct 0 (bit-xor (aget ct 0) 1))
        corrupted (assoc wrap :wrap/pq-ct (seal-sync/b64url ct))]
    (try (seal-sync/unwrap-bytes-hybrid corrupted r "qualify/aad")
         false
         (catch :default _ true))))

(defn- corrupt-ciphertext-rejected
  "ML-KEM implicit rejection: a well-formed but corrupted ciphertext yields a
  DIFFERENT shared secret instead of an error, so the module alone cannot
  reject it. Rejection happens one layer up, and that is where it is
  measured: corrupt the encapsulation inside a real hybrid wrap and require
  the AEAD to refuse -- in envelope.seal AND in envelope.seal-sync, since
  either one opening it would be the module's silence passing as rejection.
  Reporting the module's silence as rejection would be reporting a check
  that never ran."
  []
  (let [x (x25519/generate-keypair)
        pq (kem/generate-keypair)
        recipient {:pub (:pub x) :pq-pub (:pub pq)}
        secret (js/Uint8Array. #js [1 2 3 4 5 6 7 8])]
    (-> (seal/wrap-bytes-hybrid secret recipient "qualify/aad")
        (.then (fn [wrap]
                 (let [ct (seal/unb64url (:wrap/pq-ct wrap))
                       _ (aset ct 0 (bit-xor (aget ct 0) 1))
                       corrupted (assoc wrap :wrap/pq-ct (seal/b64url ct))]
                   (-> (seal/unwrap-bytes-hybrid
                        corrupted {:priv (:priv x) :pq-priv (:priv pq)} "qualify/aad")
                       (.then (constantly false))
                       (.catch (constantly true))
                       (.then #(and % (corrupt-ciphertext-rejected-sync?))))))))))

;; ── the evidence ─────────────────────────────────────────────────────────

(defn qualify
  "-> Promise<evidence map for `evaluate-pq-provider`>.

  VECTORS is a non-empty seq of {:id :encapsulation-key :decapsulation-key
  :ciphertext :shared-secret}, the last four Uint8Arrays. Empty vectors are
  refused rather than passed: a known-answer test over no known answers
  returns the same `true` as one that ran, and that is the shape of failure
  this repo is supposed to make impossible."
  [{:keys [module-digest expected-module-digest implementation-version vectors]}]
  (let [vectors (vec vectors)
        base {:provider/id provider-id
              :provider/implementation-version implementation-version
              :provider/module-digest module-digest
              :provider/algorithms algorithms
              :qualification/vectors-checked (count vectors)
              :qualification/vector-ids (mapv :id vectors)}]
    (cond
      (empty? vectors)
      (js/Promise.resolve
       (assoc base :qualification/refused :no-vectors))

      (not= module-digest expected-module-digest)
      (js/Promise.resolve
       (assoc base :qualification/refused :module-digest-mismatch
              :provider/module-load-failed-closed?
              (module-load-fails-closed? expected-module-digest)))

      :else
      (let [mlkem (module! module-digest expected-module-digest)
            ;; One measurement, reported under both names it answers, and
            ;; said out loud in :qualification/note. The evaluator asks for
            ;; known-answer tests and for decapsulation separately; here the
            ;; known answers ARE decapsulations, so running the check twice
            ;; would only make one result look like two.
            decapsulation-ok (kat-decapsulation mlkem vectors)]
        (-> (corrupt-ciphertext-rejected)
            (.then (fn [aead-rejects?]
                     (assoc base
                            :provider/known-answer-tests-passed? decapsulation-ok
                            :provider/decapsulation-verified? decapsulation-ok
                            :provider/encapsulation-verified?
                            (encapsulation-round-trips mlkem vectors)
                            :provider/invalid-ciphertext-rejected?
                            (and (malformed-ciphertext-throws? mlkem (first vectors))
                                 aead-rejects?)
                            :provider/module-load-failed-closed?
                            (module-load-fails-closed? expected-module-digest)
                            :qualification/note
                            (str "known-answer-tests and decapsulation are the same "
                                 "measurement: the vectors' known answers are "
                                 "decapsulations. Encapsulation is checked against "
                                 "foreign key pairs, not against a known answer, "
                                 "because ML-KEM encapsulation is randomised.")))))))))
