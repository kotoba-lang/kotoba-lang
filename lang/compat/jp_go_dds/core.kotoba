(ns jp-go-dds.core
  "デジタル庁デザインシステム(DADS)の HTML コンポーネント例
  (digital-go-jp/design-system-example-components-html, MIT)を cljc hiccup で
  提供するライブラリ。ADR-2607141915 (com-junkawasaki/root)。

  - markup と class 名(`dads-*`)は上流の HTML 例に忠実に従う。CSS は
    resources/jp_go_dds/dds.css に vendor(上流 commit と MIT 表記入り。
    scripts/vendor.sh で再生成 — 手編集禁止)。
  - light mode 前提(上流に dark palette は無い)。`page` は color-scheme light を明示。
  - 上流に無い layout 補助(container/section/grid/stack/card/hero)は
    `dds-ext-*` prefix + ext-css で明確に区別する(上流 class と混ぜない)。
  - 純 cljc — 描画は kotoba-lang/html(html.core/->html)。"
  (:require [kotoba.lang.text :as str]
            [css.core :as css]
            ;; JVM だけ。`jp-go-dds.kotoba-oracle` は `.clj` で、ClojureScript
            ;; の consumer に `kotoba.kir` を classpath へ足させないための
            ;; 境界そのもの（同 ns の docstring 参照）。cljs から見ると
            ;; このファイルは 2026-08-12 以前と 1 バイトも変わらない。
            ) [kotoba.form :as form])
 [kotoba.form :as form]
;; amu-refactor: positional access.  Host: what [a b] destructuring does; Kotoba: Form child, nil-form past the end.
#?(:kotoba
   (defn- fe-nth [f [:ref :form/r] i :i64] [:ref :form/r] (form/nth-of f i))
   :default
   (defn- fe-nth [c i] (nth c i nil)))

;; amu-refactor: keyword lookup.  Host: `get`; Kotoba: form-get with a keyword Form.
#?(:kotoba
   (defn- fe-get [m [:ref :form/r] k :keyword] [:ref :form/r] (form/form-get m (form/keyword-form k)))
   :default
   (defn- fe-get [m k] (get m k)))


;; --- the decisions that live in kotoba/ ---------------------------------------
;;
;; Each pair below is one rule. The `-host` half is the ClojureScript path and
;; the other half is what the JVM runs: `kotoba/*.kotoba`, compiled, shipped
;; under `resources/jp_go_dds/oracle/`, executed by `jp-go-dds.kotoba-oracle`.
;;
;; They are all the same shape — a rule handed ONE decision's worth of data, a
;; couple of scalars or one small fixed record. That is not a coincidence, it is
;; the boundary: the KIR entry boundary accepts a `:document` of at most 32
;; members (measured 2026-08-12), so the rules that walk a whole options list or
;; the whole token table (80-odd entries) cannot cross and are not delegated. See
;; `jp-go-dds.kotoba-oracle-test` for the numbers.



(defn- heading-tag-host [level] (str "h" level))

(defn- heading-tag
  "見出しレベル → タグ名。JVM では `kotoba/components.kotoba` が答える。

  委譲するかどうかは**データ**が決める（成果物が読めたかどうかではない）:
  guest は `:i64` を取るので、整数でないレベルは host 経路のままにする。"
  [level]
  )

(defn- banner-heading-tag
  "notification-banner の見出しタグ。`kotoba/select_banner.kotoba` の側の
  `heading-tag` —— banner はそちらの core が持っている決定。"
  [level]
  )

(defn- button-tag-host [href] (if href "a" "button"))

(defn- button-tag
  "`:href` があれば `<a>`、無ければ `<button>`。JVM では
  `kotoba/button.kotoba` が答える。

  guest の `:btn/opts` は属性 passthrough を `:extra :document` として持つが、
  `tag` はそれを読まない —— なので空の document を渡す。渡さないのではなく
  空を渡すのは、record が宣言どおりの形でなければ entry boundary が値ごと
  拒否するため（実測: `\"value is not the declared record type\"`）。

  ## `:href \"\"` は guest に渡さない（実測 2026-08-12）

  `.kotoba` 側の規約は「省略可能な値は `:string` で、`\"\"` が『無い』を意味
  する」（`button.kotoba` の \"Absent is the empty string here\"）。一方この
  host は Clojure の真偽値で分岐するので、**空文字の href は『有る』**——
  `(button \"OK\" {:href \"\"})` は今日 `<a href=\"\">` を出す。

  つまり guest の型は「空」と「無い」を同じ値に潰しており、`\"\"` をそのまま
  渡すと `<button>` が返って**既存の出力が黙って変わる**。170 の依存先を持つ
  base design system でそれをやる理由が無いので、この 1 点だけ host 経路に
  残す。判断しているのは**データ**であって、成果物が読めたかどうかではない
  （`kotoba-oracle-test` がこの境界を、落ちうる向きで固定している）。"
  [href]
  )

(defn- row-header-cell?-host [row-header? i]
  (boolean (and row-header? (zero? i))))

(defn- row-header-cell?
  "その body セルが行見出しか。JVM では `kotoba/table.kotoba` が答える。

  1 セルぶんの値（bool と添字）しか渡らないので、表がどれだけ大きくても
  entry boundary の 32 要素上限に触れない —— 表そのものを渡す設計だったら
  33 行目で拒否されていた。"
  [row-header? i]
  )

(defn- option-placeholder?-host [v] (or (nil? v) (= "" v)))

(defn- option-placeholder?
  "value が空の option は placeholder（disabled かつ selected）。
  JVM では `kotoba/select_banner.kotoba` が答える。"
  [v]
  )

(defn- option-selected?-host [v value]
  (boolean (and (some? value) (= (str v) (str value)))))

(defn- option-selected?
  "現在値と一致する option か。**文字列として**比べる —— options は数値や
  keyword を持つことがあり、`=` だと 18 と \"18\" が一致しない。

  JVM では `kotoba/select_banner.kotoba` が答える。この規則は既に一度実害を
  出している（`select` の docstring にある inkan の 18mm/12mm）ので、正本が
  2 つある状態を残す理由が特に無い。option 1 個ぶんの record しか渡らない
  —— options 全体を渡す `selected-count` は 33 個目で拒否される（都道府県の
  select は 47 個）。"
  [v value]
  )

;; --- primitives ---------------------------------------------------------------

(defn button
  "DADS button。opts: :type(:solid-fill|:outline|:text 既定 :solid-fill)
  :size(\"lg\"|\"md\"|\"sm\"|\"xs\" 既定 \"md\") :href(あれば <a>) :submit? :disabled :id :aria-label"
  ([label] (button label {}))
  ([label {:keys [type size href submit? disabled id aria-label]
           extra :attrs
           :or {type :solid-fill size "md"}}]
   ;; :attrs は任意属性の passthrough(data-* / aria-* / hx-* 等)。上流の
   ;; class / data-type / data-size は **後**に merge しており consumer からは
   ;; 上書きできない — component の同一性を壊させないため。これが無いと
   ;; consumer は selectable hook を得るために DADS button の CSS を app 側へ
   ;; 複製することになる(kotoba-ui.shell が :attrs を持つのと同じ理由)。
   (let [attrs (cond-> (merge (or extra {})
                              {:class "dads-button"
                               :data-type (name type)
                               :data-size size})
                 id (assoc :id id)
                 aria-label (assoc :aria-label aria-label))]
     ;; どちらの要素になるかは `kotoba/button.kotoba` の決定（`button-tag`）。
     (if (= "a" (button-tag href))
       [:a (assoc attrs :href href) label]
       [:button (cond-> (assoc attrs :type (if submit? "submit" "button"))
                  disabled (assoc :disabled true))
        label]))))

(defn heading
  "DADS heading。level 1-6、size は上流の data-size(\"64\"〜\"16\")。"
  ([level text] (heading level text {}))
  ([level text {:keys [size id]
                :or {size (get {1 "45" 2 "32" 3 "24" 4 "20" 5 "18" 6 "16"} level "20")}}]
   [(keyword (heading-tag level))
    (cond-> {:class "dads-heading" :data-size size} id (assoc :id id))
    text]))

(defn accordion
  "DADS accordion(native details/summary)。opts: :id :open? :heading-level(既定 3)"
  [summary-text content {:keys [id open? heading-level] :or {heading-level 3}}]
  [:details (cond-> {:class "dads-accordion"} open? (assoc :open true))
   [:summary (cond-> {:class "dads-accordion__summary"} id (assoc :id id))
    [:span {:class "dads-accordion__icon"}
     [:svg {:class "dads-accordion__icon-svg" :width 24 :height 24
            :viewBox "0 0 24 24" :aria-hidden "true"}
      [:path {:d "M3.3 7.3L12 16L20.7 7.3" :fill "none"
              :stroke "currentcolor" :stroke-width 2}]]]
    [(keyword (heading-tag heading-level)) summary-text]]
   [:div {:class "dads-accordion__content"} content]])

(defn input-text
  "DADS input-text(素の input。ラベルは form-field で)。opts は input 属性を透過。"
  [{:keys [size] :or {size "md"} :as opts}]
  [:span {:class "dads-input-text"}
   [:input (-> opts
               (dissoc :size)
               (assoc :class "dads-input-text__input" :data-size size)
               (update :type #(or % "text")))]])

(defn textarea
  [{:keys [rows] :or {rows 4} :as opts}]
  [:span {:class "dads-textarea"}
   [:textarea (-> opts (assoc :class "dads-textarea__textarea" :rows rows))]])

(defn checkbox
  "DADS checkbox。opts: :id :checked :disabled :size(既定 \"md\")"
  [label {:keys [id checked disabled size] :or {size "md"}}]
  [:label {:class "dads-checkbox" :data-size size}
   [:span {:class "dads-checkbox__checkbox"}
    [:input (cond-> {:class "dads-checkbox__input" :type "checkbox"}
              id (assoc :id id)
              checked (assoc :checked true)
              disabled (assoc :disabled true))]]
   [:span {:class "dads-checkbox__label"} label]])

(defn radio
  "DADS radio。markup は上流 radio/playground.html に忠実
  (label.dads-radio > span.dads-radio__radio > input + span.dads-radio__label)。

  CSS は core の束(dds.css)に入っていないので、使うページは
  `(jp-go-dds.css/css-for [:radio])` を app-css の前に足すこと。

  opts: :name(必須相当) :value :id :checked :disabled :size(既定 \"md\")"
  [label {:keys [name value id checked disabled size] :or {size "md"}}]
  [:label {:class "dads-radio" :data-size size}
   [:span {:class "dads-radio__radio"}
    [:input (cond-> {:class "dads-radio__input" :type "radio"}
              name (assoc :name name)
              value (assoc :value value)
              id (assoc :id id)
              checked (assoc :checked true)
              disabled (assoc :disabled true))]]
   [:span {:class "dads-radio__label"} label]])

(defn form-field
  "DADS form-control-label で control を包む。
  opts: :label :for :support :size(既定 \"md\") :support-id
  :requirement(必須/任意マーカーのテキスト) :required?(true で赤字)
  :status(グレーの塗りバッジ。状態表示用で必須マーカーではない)"
  [{:keys [label for support status requirement required? size support-id]
    :or {size "md"}} control]
  [:div {:class "dads-form-control-label" :data-size size}
   [:label (cond-> {:class "dads-form-control-label__label"} for (assoc :for for))
    label
    ;; 必須/任意の表示は __requirement(data-required=true で赤字)。
    ;; __status はグレーの塗りバッジで、「入力済み」等の状態表示用の別物 ——
    ;; 必須マーカーに __status を使うのは意味的に誤り(実測でこれをやっていた)。
    (when requirement
      [:span {:class "dads-form-control-label__requirement"
              :data-required (if required? "true" "false")}
       requirement])
    (when status [:span {:class "dads-form-control-label__status"} status])]
   (when support
     [:p (cond-> {:class "dads-form-control-label__support-text"}
           support-id (assoc :id support-id))
      support])
   [:div control]])

(defn select
  "DADS select。markup は上流 select/with-form-control-label.html に忠実
  (span.dads-select > span.dads-select__control > select + chevron svg)。

  opts: :id :name :size(既定 \"md\") :required :disabled :aria-describedby
        :value(現在値。一致する option を selected にする)
        :error(あれば dads-select__error-text を出す)
        :attrs(select への追加属性)
  options: [[value label] ...]。value が nil/\"\" の項目は placeholder として
  disabled + selected にする(上流の「選択してください」と同じ扱い)。

  **`:value` を渡さないと『先頭の option が選ばれている』HTML になる。** SSR で
  既定値を持つフォーム(設定画面・編集フォーム)ではこれが黙った誤りになる ——
  consumer 側は「18mm を既定にした」つもりでも、実際に選ばれるのは options の
  先頭(12mm)で、しかも見た目は正常なので気付かない(実測 2026-07-30、
  cloud-itonami/inkan の印影サイズが 18.0mm のつもりで 12.0mm で描画されていた)。"
  [{:keys [id name size required disabled aria-describedby value error attrs]
    :or {size "md"}}
   options]
  [:span {:class "dads-select"}
   [:span {:class "dads-select__control"}
    (into [:select (cond-> (merge {:class "dads-select__select" :data-size size} attrs)
                     id (assoc :id id)
                     name (assoc :name name)
                     required (assoc :required true)
                     disabled (assoc :disabled true)
                     aria-describedby (assoc :aria-describedby aria-describedby))]
          (map (fn [dd__10420_1]
                 (let [v (fe-nth dd__10420_1 0) label (fe-nth dd__10420_1 1)]
                   (cond
                   ;; どの option が placeholder / selected かは
                   ;; `kotoba/select_banner.kotoba` の決定。
                   (option-placeholder? v)
                   [:option {:value "" :disabled true :selected true} label]
                   ;; 値の比較は str 経由 —— options は数値や keyword を持つことが
                   ;; あり、`=` だと 18 と "18" が一致せず selected が付かない。
                   (option-selected? v value)
                   [:option {:value v :selected true} label]
                   :else
                   [:option {:value v} label])))
               options))
    [:svg {:class "dads-select__chevron" :width 16 :height 16
           :viewBox "0 0 24 24" :aria-hidden "true"}
     [:path {:d "M12 17L3 8L4 7L12 15L20 7L21 8L12 17Z" :fill "currentcolor"}]]]
   (when error
     [:span {:class "dads-select__error-text"} error])])

(defn language-selector
  "DADS language selector。上流 language-selector/playground.html の
  language-selector + menu-list-box + menu-list markup に忠実。

  `languages` は `{:code \"ja\" :label \"日本語\" :href \"?lang=ja\"}` の列。
  opts:
  - :id-prefix   複数配置時に一意な id の接頭辞（既定 language-selector）
  - :current     現在言語の code
  - :size        opener の sm|md（既定 sm）
  - :style       text|outlined|filled（既定 text）
  - :text-weight normal|bold（既定 normal）
  - :attrs       root への追加属性

  オープナーは現在の言語名。:opener-label で表記を指定できる。7言語以上では検索欄を表示する。各言語名は
  その言語自身の表記を渡す。開閉・Escape・矢印キーの挙動はホスト側が
  data-language-selector-* hookへ一度だけ委譲して実装する。"
  [{:keys [id-prefix current languages size style text-weight attrs opener-label search-label empty-label]
    :or {id-prefix "language-selector" size "sm" style "text"
         text-weight "normal" search-label "Search languages" empty-label "No matching languages"}}]
  (let [opener-id (str id-prefix "-opener")
        popup-id (str id-prefix "-popup")
        current (some-> current name)
        current-label (or opener-label (:label (first (filter #(= current (name (:code %))) languages))) "Language")]
    [:div (merge {:class "dads-language-selector"
                  :data-language-selector true}
                 attrs)
     [:div {:class "dads-menu-list-box"}
      [:button {:id opener-id
                :class "dads-menu-list-box__opener"
                :type "button"
                :data-language-selector-opener true
                :aria-label (str "Language: " current-label)
                :aria-controls popup-id
                :aria-expanded "false"
                :data-size size
                :data-style style
                :data-text-weight text-weight}
       [:svg {:class "dads-menu-list-box__opener-icon"
              :width 24 :height 24 :viewBox "0 0 24 24"
              :fill "currentcolor" :aria-hidden "true"}
        [:path {:d "M12 21.5A9.5 9.5 0 0 1 2.5 12c0-5.2 4.3-9.5 9.5-9.5s9.6 4.3 9.5 9.5c0 5.2-4.3 9.5-9.5 9.5Zm0-1.5c1-1.3 1.7-2.8 2.1-4.3H10c.4 1.5 1 3 2.1 4.3Zm-2-.3c-.8-1.2-1.4-2.6-1.7-4H5c1 2 3 3.5 5.2 4Zm4 0c2.2-.5 4-2 5-4h-3.3c-.4 1.4-1 2.8-1.8 4Zm-9.7-5.5H8a13 13 0 0 1 0-4.4H4.3a8 8 0 0 0 0 4.4Zm5.2 0h5c.2-1.5.2-3 0-4.4h-5c-.2 1.5-.2 3 0 4.4Zm6.5 0h3.7a8 8 0 0 0 0-4.4H16c.2 1.5.2 3 0 4.4Zm-.3-5.9H19c-1-2-3-3.5-5.2-4 .8 1.2 1.4 2.6 1.8 4Zm-5.8 0H14A12 12 0 0 0 12 4a12 12 0 0 0-2.1 4.3Zm-5 0h3.4c.4-1.4 1-2.8 1.8-4-2.3.5-4.1 2-5.2 4Z"}]]
       [:span {:data-language-selector-current true} current-label]
       [:svg {:class "dads-menu-list-box__opener-arrow"
              :width 16 :height 16 :viewBox "0 0 24 24"
              :fill "currentcolor" :aria-hidden "true"}
        [:path {:d "m20.5 6.6-8 8-8-8L3.1 8l9.4 9.4L21.9 8l-1.4-1.4Z"}]]]
      [:div {:id popup-id :class "dads-menu-list-box__popup"
             :data-language-selector-popup true :hidden true}
       (when (> (count languages) 6)
         [:input {:type "search" :class "dads-input-text dads-language-selector__search"
                  :data-language-selector-search true :aria-label search-label
                  :placeholder search-label :autocomplete "off" :spellcheck "false"}])
       [:p {:data-language-selector-empty true :role "status" :hidden true} empty-label]
       (into
        [:ul {:class "dads-menu-list" :data-language-selector-menu true}]
        (map
         (fn [dd__14648_1]
           (let [code (fe-get dd__14648_1 :code)
                 label (fe-get dd__14648_1 :label)
                 href (fe-get dd__14648_1 :href)
                 aliases (fe-get dd__14648_1 :aliases)]
             (let [code (name code)
                 selected? (= current code)]
             [:li
              [:a (cond-> {:class "dads-menu-list__item"
                           :data-language-selector-item true
                           :data-language-selector-keywords (str code " " label " " aliases)
                           :href href :lang code :hreflang code
                           :data-type "box" :data-size "regular"}
                    selected? (assoc :data-current true
                                     :aria-current "true"))
               [:svg {:class (str "dads-menu-list__front-icon "
                                  "dads-language-selector__check")
                      :width 24 :height 24 :viewBox "0 0 24 24"
                      :fill "currentcolor" :aria-hidden "true"}
                [:path {:d "m9.5 18-5.7-5.7 1.5-1.4 4.2 4.3L18.7 6l1.4 1.4L9.5 18Z"}]]
               [:bdi {:class "dads-menu-list__label"} label]]])))
         languages))]]]))

(defn table
  "DADS table。{:caption :headers [..] :rows [[..]..] :row-header? bool}
  row-header? true なら各行の先頭セルを th scope=row にする。"
  [{:keys [caption headers rows row-header?]}]
  [:div {:class "dads-table"}
   [:table {:class "dads-table__table"}
    (when caption [:caption caption])
    (when (seq headers)
      [:thead
       (into [:tr]
             (map (fn [h] [:th {:class "dads-table__col-header" :scope "col"} h])
                  headers))])
    (into [:tbody]
          (map (fn [row]
                 (into [:tr]
                       (map-indexed
                        (fn [i cell]
                          ;; どのセルが行見出しかは `kotoba/table.kotoba` の決定。
                          ;; `scope` は styling ではなく accessibility semantics
                          ;; なので、tag と一緒に 1 箇所で決まる必要がある。
                          (if (row-header-cell? row-header? i)
                            [:th {:class "dads-table__row-header" :scope "row"} cell]
                            [:td cell]))
                        row)))
               rows))]])

(defn chip-label
  "DADS chip-label。opts: :color(\"blue\"|\"gray\"|…) :style(既定 \"text\")"
  ([label] (chip-label label {}))
  ([label {:keys [color style] :or {color "blue" style "text"}}]
   [:span {:class "dads-chip-label" :data-style style :data-color color} label]))

(defn divider
  ([] (divider {}))
  ([_opts] [:hr {:class "dads-divider"}]))

;; notification-banner の icon path は上流 src/components/notification-banner/
;; {success,error,warning,info-1}.html をそのまま写したもの。fill="Canvas" も
;; 上流どおり(CSS system color = バナー背景色で抜く指定)。
(def ^:private banner-icons
  {:success {:label "成功"
             :paths [[:circle {:cx 12 :cy 12 :r 10 :fill "currentcolor"}]
                     [:path {:d "m17.6 9.6-7 7-4.3-4.3L7.7 11l2.9 2.9 5.7-5.6 1.3 1.4Z" :fill "Canvas"}]]}
   :error   {:label "エラー"
             :paths [[:path {:d "M8.25 21 3 15.75v-7.5L8.25 3h7.5L21 8.25v7.5L15.75 21h-7.5Z" :fill "currentcolor"}]
                     [:path {:d "m12 13.4-2.85 2.85-1.4-1.4L10.6 12 7.75 9.15l1.4-1.4L12 10.6l2.85-2.85 1.4 1.4L13.4 12l2.85 2.85-1.4 1.4L12 13.4Z" :fill "Canvas"}]]}
   :warning {:label "警告"
             :paths [[:path {:d "M1 21 12 2l11 19H1Z" :fill "currentcolor"}]
                     [:path {:d "M13 15h-2v-5h2v5Z" :fill "Canvas"}]
                     [:circle {:cx 12 :cy 17 :r 1 :fill "Canvas"}]]}
   :info-1  {:label "インフォメーション"
             :paths [[:circle {:cx 12 :cy 12 :r 10 :fill "currentcolor"}]
                     [:circle {:cx 12 :cy 8 :r 1 :fill "Canvas"}]
                     [:path {:d "M11 11h2v6h-2z" :fill "Canvas"}]]}
   :info-2  {:label "インフォメーション"
             :paths [[:circle {:cx 12 :cy 12 :r 10 :fill "currentcolor"}]
                     [:circle {:cx 12 :cy 8 :r 1 :fill "Canvas"}]
                     [:path {:d "M11 11h2v6h-2z" :fill "Canvas"}]]}})

(defn- banner-type-name
  "type を guest が受け取れる文字列にする。nil や想定外の値は空文字にして、
  未知として `icon-type` の fallback に委ねる（host 側で先に判断しない）。"
  [t]
  (if (or (keyword? t) (string? t)) (name t) ""))

(defn- banner-icon-type-host [t]
  (if (contains? banner-icons (keyword t)) t "info-1"))

(defn- banner-icon-type
  "未知の banner type を `info-1` に落とす規則。JVM では
  `kotoba/select_banner.kotoba` が答える。"
  [t]
  (let [t (banner-type-name t)]
    ))

(defn- banner-icon-label-host [t]
  (:label (get banner-icons (keyword (banner-icon-type-host t)))))

(defn- banner-icon-label
  "その banner type の `aria-label`。JVM では
  `kotoba/select_banner.kotoba` が答える —— icon の意味を読み上げに出す文字列
  なので、type → icon の対応と同じ場所で決まる必要がある。"
  [t]
  (let [t (banner-type-name t)]
    ))

(defn notification-banner
  "DADS notification-banner。opts:
  :type(:success|:error|:warning|:info-1|:info-2 既定 :info-1)
  :style(\"standard\"|\"color-chip\" 既定 \"standard\")
  :heading(見出しテキスト。必須相当) :heading-level(既定 2)
  :timestamp({:datetime \"2024-07-01\" :text \"2024年7月1日\"})
  :actions(hiccup の seq。無ければ actions ブロックを出さない)
  :id(root の id) :attrs(root への追加属性)

  上流との差分: 上流の例は常に閉じるボタンを持つが、閉じる挙動は JS 依存なので
  本ライブラリでは既定で出さない(静的 SSR ページに動かない閉じるボタンを置かない)。
  必要なら :closable? true + :close-id で上流どおりの markup を出す。"
  [{:keys [type style heading heading-level timestamp actions id attrs
           closable? close-id close-label]
    :or {type :info-1 style "standard" heading-level 2
         close-label "閉じる" close-id "notification-banner-close"}}
   & body]
  (let [;; 未知の type を info-1 に落とす規則と、その type のラベルは
        ;; `kotoba/select_banner.kotoba` の決定。SVG の path は幾何であって
        ;; 判断ではないので、表はこちらに残る。
        resolved (banner-icon-type type)
        label (banner-icon-label type)
        {:keys [paths]} (get banner-icons (keyword resolved))]
    [:div (cond-> (merge {:class "dads-notification-banner"
                          :data-style style
                          :data-type (name type)}
                         attrs)
            id (assoc :id id))
     [(keyword (banner-heading-tag heading-level)) {:class "dads-notification-banner__heading"}
      (into [:svg {:class "dads-notification-banner__icon" :width 24 :height 24
                   :viewBox "0 0 24 24" :role "img" :aria-label label}]
            paths)
      [:span {:class "dads-notification-banner__heading-text"} heading]]
     (when closable?
       [:button {:class "dads-notification-banner__close" :type "button"
                 :aria-labelledby close-id}
        [:svg {:class "dads-notification-banner__close-icon" :width 24 :height 24
               :viewBox "0 0 24 24" :aria-hidden "true"}
         [:path {:d "m6.4 18.6-1-1 5.5-5.6-5.6-5.6 1.1-1 5.6 5.5 5.6-5.6 1 1.1L13 12l5.6 5.6-1 1L12 13l-5.6 5.6Z"
                 :fill "currentcolor"}]]
        [:span {:id close-id :class "dads-notification-banner__close-label"} close-label]])
     (into [:div {:class "dads-notification-banner__body"}
            (when timestamp
              [:p {:class "dads-notification-banner__timestamp"}
               [:time {:datetime (:datetime timestamp)} (:text timestamp)]])]
           body)
     (when (seq actions)
       (into [:div {:class "dads-notification-banner__actions"}] actions))]))

;; --- the rest of the vendored catalogue (2026-09-16) ----------------------------
;;
;; 40 components are vendored under resources/jp_go_dds/components/, and until
;; 2026-09-16 only 14 of them had a hiccup wrapper here — the other 26 were CSS
;; that no page could reach without hand-writing the upstream markup. Below,
;; each wrapper follows the upstream example HTML at the vendored commit
;; (3b34f4c) class for class; the ones upstream drives with a script carry
;; the `data-behavior` marker that `jp-go-dds.behavior/script` answers
;; (modal-dialog / drawer → dialog, menu-list-box → menu, tab → tabs), so a
;; page gets the behaviour by shipping ONE file instead of one per pattern.
;; Where upstream's script is a whole application (calendar's month engine,
;; the carousel's slide machine, file-upload's validation), the wrapper
;; emits the static view — a month grid from data, the single key visual,
;; the input + drop area — and says so in its docstring; it does not pretend.

(def ^:private icon-external
  "上流 link / utility-link の「新規タブで開きます」アイコン。"
  [:path {:d "M22 6V9H9V39H39V26H42V42H6V6H22ZM42 6V20H39V11.2L21 29L19 27L36.8 9H28V6H42Z" :fill "currentcolor"}])

(def ^:private icon-chevron-down
  [:path {:d "M12 17L3 8L4 7L12 15L20 7L21 8L12 17Z" :fill "currentcolor"}])

(def ^:private icon-close-120
  [:path {:d "M32 95L25 88L53 60L25 32L32 25L60 53L88 25L95 32L67 60L95 88L88 95L60 67L32 95Z" :fill "currentcolor"}])

(def ^:private icon-hamburger
  [:path {:d "M3 18V16H21V18H3ZM3 13V11H21V13H3ZM3 8V6H21V8H3Z" :fill "currentcolor"}])

(defn- visually-hidden [& body]
  (into [:span {:class "dads-u-visually-hidden"}] body))

(defn blockquote
  "DADS blockquote。body は段落などの hiccup。"
  [& body]
  (into [:blockquote {:class "dads-blockquote"}] body))

(defn link
  "DADS link。opts: :href :external?(target=_blank + 新規タブアイコン) :attrs
  :external-label(アイコンの読み上げ、既定「新規タブで開きます」)"
  ([label] (link label {}))
  ([label {:keys [href external? attrs external-label]
           :or {href "#" external-label "新規タブで開きます"}}]
   (let [a (merge attrs {:class "dads-link" :href href})]
     (if external?
       [:a (assoc a :target "_blank" :rel "noopener")
        label
        [:svg {:class "dads-link__icon" :width 16 :height 16 :viewBox "0 0 48 48"
               :role "img" :aria-label external-label}
         icon-external]]
       [:a a label]))))

(defn utility-link
  "DADS utility-link(先頭アイコン付きの補助リンク)。opts: :href :external?
  :lead-icon(hiccup の svg 子要素。無ければ出さない) :attrs"
  [label {:keys [href external? lead-icon attrs external-label]
          :or {href "#" external-label "新規タブで開きます"}}]
  [:a (merge attrs (cond-> {:class "dads-utility-link" :href href}
                     external? (assoc :target "_blank" :rel "noopener")))
   (when lead-icon
     [:svg {:class "dads-utility-link__lead-icon" :width 16 :height 16 :viewBox "0 0 24 24"
            :fill "currentcolor" :aria-hidden "true"} lead-icon])
   [:span {:class "dads-utility-link__label"} label]
   (when external?
     [:svg {:class "dads-utility-link__tail-icon" :width 16 :height 16 :viewBox "0 0 48 48"
            :fill "currentcolor" :role "img" :aria-label external-label}
      icon-external])])

(defn list
  "DADS list。opts: :marker(\"number\" で番号付き。番号は各 li の先頭 span に
  上流どおり著者が書く) :spacing(\"4\"|\"8\"|…)。items は li の中身の hiccup。"
  [{:keys [marker spacing attrs] :or {spacing "4"}} & items]
  (into [:ul (merge attrs (cond-> {:class "dads-list" :data-spacing spacing}
                            marker (assoc :data-marker marker)))]
        (map (fn [item] [:li item]) items)))

(defn description-list
  "DADS description-list。items は `{:term hiccup :description hiccup}` の列。
  opts: :marker(上流 data-marker。\"custom\" のとき term 側に著者がマーカーを置く)"
  [{:keys [marker attrs]} items]
  (into [:dl (merge attrs (cond-> {:class "dads-description-list"} marker (assoc :data-marker marker)))]
        (map (fn [dd__25651_1]
               (let [term (fe-get dd__25651_1 :term) description (fe-get dd__25651_1 :description)]
                 [:div {:class "dads-description-list__item"}
                [:dt term] [:dd description]]))
             items)))

(defn breadcrumb
  "DADS breadcrumb。items は `{:href :label}` の列で、最後の項目(href 無し)が
  現在地(aria-current=page)。opts: :label(読み上げ用、既定「現在位置」)
  :home-icon?(先頭項目に家アイコン) :id-prefix"
  [{:keys [label home-icon? id-prefix] :or {label "現在位置" id-prefix "breadcrumb"}} items]
  (let [label-id (str id-prefix "-label")
        sep [:span {:class "dads-breadcrumb__separator"}
             [:svg {:class "dads-breadcrumb__separator-icon" :width 12 :height 12 :viewBox "0 0 12 12" :aria-hidden "true"}
              [:path {:d "M4.5 11L4 10.5L8 6.5L4 2.5L4.5 2L9 6.5L4.5 11Z" :fill "currentcolor"}]]]
        n (count items)]
    [:nav {:class "dads-breadcrumb" :aria-labelledby label-id}
     [:span {:id label-id :class "dads-u-visually-hidden"} label]
     (into [:ol {:class "dads-breadcrumb__list"}]
           (map-indexed
            (fn [i dd__26638_1]
              (let [href (fe-get dd__26638_1 :href) label (fe-get dd__26638_1 :label)]
                (let [last? (= i (dec n))]
                [:li {:class "dads-breadcrumb__item"}
                 (if (and href (not last?))
                   [:a {:class "dads-breadcrumb__link" :href href}
                    (when (and home-icon? (zero? i))
                      [:svg {:class "dads-breadcrumb__link-icon" :width 16 :height 16 :viewBox "0 0 16 16" :aria-hidden "true"}
                       [:path {:d "M3 13L3 6L8 2L13 6V13H9V9H7V13H3Z" :fill "currentcolor"}]])
                    label]
                   [:span {:aria-current "page"} label])
                 (when-not last? sep)])))
            items))]))

(defn image
  "DADS image(figure)。opts: :src :srcset :alt(必須相当) :width :height
  :bordered? :caption :caption-style(\"dashed\" 等、上流 data-style) :attrs"
  [{:keys [src srcset alt width height bordered? caption caption-style attrs]}]
  [:figure (merge attrs {:class "dads-image"})
   [:div (cond-> {:class "dads-image__image-area"} bordered? (assoc :data-bordered true))
    [:img (cond-> {:class "dads-image__img" :src src :alt (or alt "")}
            srcset (assoc :srcset srcset)
            width (assoc :width width)
            height (assoc :height height))]]
   (when caption
     [:figcaption (cond-> {:class "dads-image__caption"} caption-style (assoc :data-style caption-style))
      caption])])

(defn disclosure
  "DADS disclosure(native details/summary。behavior 不要)。opts: :id :open?
  :back-link?(内容末尾に「先頭に戻る」リンク。上流どおり summary の id を要する)
  :back-label"
  [summary-text content {:keys [id open? back-link? back-label] :or {id "disclosure"}}]
  (let [summary-id (str id "-summary")]
    [:details (cond-> {:class "dads-disclosure"} open? (assoc :open true))
     [:summary {:id summary-id :class "dads-disclosure__summary"}
      [:svg {:class "dads-disclosure__icon" :width 24 :height 24 :viewBox "0 0 24 24" :aria-hidden "true"}
       [:circle {:cx 12 :cy 12 :r 11 :fill "currentcolor"}]
       [:circle {:class "dads-disclosure__icon-circle" :cx 12 :cy 12 :r 8 :fill "currentcolor"}]
       [:path {:class "dads-disclosure__icon-triangle" :d "M17 10H7L12 15L17 10Z" :fill "Canvas"}]]
      summary-text]
     [:div {:class "dads-disclosure__content"}
      content
      (when back-link?
        [:a {:class "dads-disclosure__back-link" :href (str "#" summary-id)}
         [:svg {:class "dads-disclosure__back-link-icon" :width 24 :height 24 :fill "none" :aria-hidden "true"}
          [:path {:d "M6 7V14.5C6 16.8 8.2 19 10.5 19C12.8 19 15 16.8 15 14.5V6M10.709 9.7L15 5.414L19.291 9.7" :stroke "currentcolor" :stroke-width 2}]]
         (or back-label (str "「" summary-text "」の先頭に戻る"))])]]))

(defn emergency-banner
  "DADS emergency-banner。opts: :heading :timestamp({:datetime :text})
  :action({:href :label :external?}) :heading-level(既定 2)。body は本文 hiccup。"
  [{:keys [heading timestamp action heading-level attrs] :or {heading-level 2}} & body]
  [:article (merge attrs {:class "dads-emergency-banner"})
   [:header {:class "dads-emergency-banner__header"}
    [(keyword (heading-tag heading-level)) {:class "dads-emergency-banner__heading"} heading]
    (when timestamp
      [:time {:class "dads-emergency-banner__timestamp" :datetime (:datetime timestamp)} (:text timestamp)])]
   (into [:div {:class "dads-emergency-banner__body"}] body)
   (when action
     [:div {:class "dads-emergency-banner__action"}
      [:a (cond-> {:class "dads-emergency-banner__button" :href (:href action)}
            (:external? action) (assoc :target "_blank" :rel "noopener"))
       (:label action)
       (when (:external? action)
         [:span {:class "dads-emergency-banner__button-icon"}
          [:svg {:class "dads-emergency-banner__button-icon-glyph" :width 16 :height 16 :viewBox "0 0 48 48"
                 :role "img" :aria-label "新規タブで開きます"} icon-external]])]])])

(defn hamburger-menu-button
  "DADS hamburger-menu-button。opts: :label(既定「メニュー」) :close?(閉じる形)
  :attrs(`behavior/dialog-open-attrs` や disclosure の aria-expanded/aria-controls
  をここで渡す)"
  [{:keys [label close? attrs] :or {label "メニュー"}}]
  [:button (merge {:type "button"} attrs {:class "dads-hamburger-menu-button"})
   (if close?
     [:svg {:class "dads-hamburger-menu-button__icon" :width 24 :height 24 :viewBox "0 0 120 120" :aria-hidden "true"} icon-close-120]
     [:svg {:class "dads-hamburger-menu-button__icon" :width 24 :height 24 :viewBox "0 0 24 24" :aria-hidden "true"} icon-hamburger])
   label])

(defn horizontal-menu
  "DADS horizontal-menu。items は `{:href :label :icon(svg 子要素 hiccup)
  :chevron? :current?}` の列。opts: :attrs :label(nav の aria-label)"
  [{:keys [attrs label]} items]
  (into [:ul (merge attrs (cond-> {:class "dads-horizontal-menu"} label (assoc :aria-label label)))]
        (map (fn [dd__31407_1]
               (let [href (fe-get dd__31407_1 :href)
                     label (fe-get dd__31407_1 :label)
                     icon (fe-get dd__31407_1 :icon)
                     chevron? (fe-get dd__31407_1 :chevron?)
                     current? (fe-get dd__31407_1 :current?)]
                 [:li {:class "dads-horizontal-menu__item"}
                [:a (cond-> {:class "dads-horizontal-menu__item-inner" :href (or href "#")}
                      current? (assoc :aria-current "page"))
                 (when icon
                   [:svg {:class "dads-horizontal-menu__front-icon" :width 24 :height 24 :viewBox "0 0 24 24"
                          :fill "currentcolor" :aria-hidden "true"} icon])
                 [:span {:class "dads-horizontal-menu__label"} label]
                 (when chevron?
                   [:svg {:class "dads-horizontal-menu__chevron" :width 16 :height 16 :viewBox "0 0 24 24" :aria-hidden "true"}
                    icon-chevron-down])]]))
             items)))

(defn menu-list
  "DADS menu-list(単体の縦メニュー。popup にするなら menu-list-box)。items は
  `{:label :href(あれば <a>) :icon :external? :current? :attrs}` の列。
  opts: :type(\"standard\"|\"box\" 既定 \"standard\") :size(\"regular\"|\"small\") :role"
  [{:keys [type size attrs] :or {type "standard" size "regular"}} items]
  (into [:ul (merge attrs {:class "dads-menu-list"})]
        (map (fn [dd__32549_1]
               (let [label (fe-get dd__32549_1 :label)
                     href (fe-get dd__32549_1 :href)
                     icon (fe-get dd__32549_1 :icon)
                     external? (fe-get dd__32549_1 :external?)
                     current? (fe-get dd__32549_1 :current?)
                     item-attrs (fe-get dd__32549_1 :attrs)]
                 (let [base (merge item-attrs (cond-> {:class "dads-menu-list__item" :data-type type :data-size size}
                                              current? (assoc :aria-current "page")))
                     body [(when icon
                             [:svg {:class "dads-menu-list__front-icon" :width 24 :height 24 :viewBox "0 0 24 24"
                                    :fill "currentcolor" :aria-hidden "true"} icon])
                           [:span {:class "dads-menu-list__label"} label
                            (when external?
                              [:svg {:class "dads-menu-list__tail-icon" :width 16 :height 16 :viewBox "0 0 48 48"
                                     :role "img" :aria-label "新規タブで開きます"} icon-external])]]]
                 [:li (if href
                        (into [:a (cond-> (assoc base :href href) external? (assoc :target "_blank" :rel "noopener"))] body)
                        (into [:button (assoc base :type "button")] body))])))
             items)))

(defn menu-list-box
  "DADS menu-list-box — a popover menu on `behavior` (data-behavior=menu).
  opts: :id(必須。opener / menu の id を派生) :label(opener のテキスト)
  :icon(opener の先頭アイコン svg 子要素) :size(\"sm\"|\"md\")
  :style(\"text\"|\"outlined\"|\"filled\") :text-weight(\"normal\"|\"bold\")
  :align(:end 既定 | :start) :placement(:down 既定 | :up) :attrs
  items は menu-list と同じ列(`role=menuitem` が付く)。

  popup は data-menu-popup + data-chrome=float(shinkansen :chrome-layers が
  測る層 marker)+ hidden で出る。開閉・矢印・Escape・外側 click は
  jp-go-dds.behavior/script が答える。"
  [{:keys [id label icon size style text-weight align placement attrs]
    :or {size "sm" style "text" text-weight "normal" align :end placement :down}}
   items]
  (let [opener-id (str id "-opener") menu-id (str id "-menu")]
    [:div (merge attrs (cond-> {:class "dads-menu-list-box" :id id :data-behavior "menu"}
                         (= align :start) (assoc :data-menu-align "start")
                         (= placement :up) (assoc :data-menu-placement "up")))
     [:button {:id opener-id :class "dads-menu-list-box__opener" :type "button"
               :data-menu-opener true :aria-controls menu-id :aria-haspopup "menu"
               :aria-expanded "false" :data-size size :data-style style :data-text-weight text-weight}
      (when icon
        [:svg {:class "dads-menu-list-box__opener-icon" :width 24 :height 24 :viewBox "0 0 24 24"
               :fill "currentcolor" :aria-hidden "true"} icon])
      label
      [:svg {:class "dads-menu-list-box__opener-arrow" :width 16 :height 16 :viewBox "0 0 24 24"
             :fill "currentcolor" :aria-hidden "true"}
       [:path {:d "m20.5 6.6-8 8-8-8L3.1 8l9.4 9.4L21.9 8l-1.4-1.4Z"}]]]
     [:div {:class "dads-menu-list-box__popup" :data-menu-popup true :data-chrome "float" :hidden true}
      (into [:ul {:id menu-id :class "dads-menu-list" :role "menu" :aria-labelledby opener-id}]
            (map (fn [dd__35560_1]
                   (let [label (fe-get dd__35560_1 :label)
                         href (fe-get dd__35560_1 :href)
                         icon (fe-get dd__35560_1 :icon)
                         external? (fe-get dd__35560_1 :external?)
                         current? (fe-get dd__35560_1 :current?)
                         item-attrs (fe-get dd__35560_1 :attrs)]
                     (let [base (merge item-attrs (cond-> {:class "dads-menu-list__item" :data-type "box" :data-size "regular" :role "menuitem"}
                                                  current? (assoc :aria-current "page")))
                         body [(when icon
                                 [:svg {:class "dads-menu-list__front-icon" :width 24 :height 24 :viewBox "0 0 24 24"
                                        :fill "currentcolor" :aria-hidden "true"} icon])
                               [:span {:class "dads-menu-list__label"} label]]]
                     [:li {:role "presentation"}
                      (if href
                        (into [:a (cond-> (assoc base :href href) external? (assoc :target "_blank" :rel "noopener"))] body)
                        (into [:button (assoc base :type "button")] body))])))
                 items))]]))

(defn modal-dialog
  "DADS modal-dialog — a `<dialog>` on `behavior` (data-behavior=dialog).
  opts: :id(必須) :heading :heading-level(既定 2) :actions(hiccup の seq。
  閉じるボタンには `behavior/dialog-close-attrs` を渡す) :close-label(既定「閉じる」)
  :scroll(\"inner\"|\"outer\" 上流 data-scroll) :backdrop-click(:close で背景 click
  が閉じる。既定は何もしない — contracts.edn :settings-sheet) :attrs。body は本文。
  開くコントロールには `behavior/dialog-open-attrs` を渡す。"
  [{:keys [id heading heading-level actions close-label scroll backdrop-click attrs]
    :or {heading-level 2 close-label "閉じる"}} & body]
  (let [title-id (str id "-title")]
    [:dialog (merge attrs (cond-> {:id id :class "dads-modal-dialog" :aria-labelledby title-id :data-behavior "dialog"}
                            scroll (assoc :data-scroll scroll)
                            (= backdrop-click :close) (assoc :data-backdrop-click "close")))
     [:div {:class "dads-modal-dialog__dialog"}
      [:div {:class "dads-modal-dialog__header"}
       [(keyword (heading-tag heading-level)) {:id title-id :class "dads-modal-dialog__heading" :tabindex "-1" :autofocus true} heading]
       [:button {:class "dads-modal-dialog__close" :type "button" :command "close" :commandfor id}
        [:svg {:class "dads-modal-dialog__close-icon" :width 24 :height 24 :viewBox "0 0 120 120" :aria-hidden "true"} icon-close-120]
        close-label]]
      (into [:div {:class "dads-modal-dialog__body"}] body)
      (when (seq actions)
        (into [:div {:class "dads-modal-dialog__actions"}] actions))]]))

(defn drawer
  "DADS drawer — a `<dialog>` on `behavior`, slid in from :placement(\"right\"
  既定|\"left\")。opts: :id(必須) :heading(読み上げ用。上流どおり visually hidden)
  :close-label :attrs。body は本文。開くのは hamburger-menu-button +
  `behavior/dialog-open-attrs`。"
  [{:keys [id heading placement close-label attrs] :or {placement "right" heading "メニュー" close-label "閉じる"}} & body]
  (let [heading-id (str id "-heading")]
    [:dialog (merge attrs {:id id :class "dads-drawer" :data-placement placement :aria-labelledby heading-id :data-behavior "dialog"})
     [:h2 {:id heading-id :class "dads-u-visually-hidden"} heading]
     [:div {:class "dads-drawer__header"}
      (hamburger-menu-button {:label close-label :close? true :attrs {:command "close" :commandfor id}})]
     (into [:div {:class "dads-drawer__body"}] body)]))

(defn tab
  "DADS tab — on `behavior` (data-behavior=tabs)。tabs は
  `{:id :label :panel(hiccup) :selected?}` の列(selected? が無ければ先頭)。
  opts: :id(必須。tab / panel の id を派生) :label(tablist の aria-label)
  :position(\"top\" 既定|\"bottom\") :attrs

  上流 tab/playground-aria.html の形: a[role=tab][aria-selected] + div[role=tabpanel]。
  選ばれていない panel は hidden で出す(script 無しでも 1 枚だけ見える)。"
  [{:keys [id label position attrs]} tabs]
  (let [tabs (if (some :selected? tabs) tabs (assoc-in (vec tabs) [0 :selected?] true))
        tab-id (fn [t] (str id "-tab-" (:id t)))
        panel-id (fn [t] (str id "-panel-" (:id t)))]
    [:div (merge attrs (cond-> {:id id :class "dads-tab" :data-behavior "tabs"} position (assoc :data-position position)))
     (into [:div (cond-> {:class "dads-tab__list" :role "tablist"} label (assoc :aria-label label))]
           (map (fn [t]
                  [:a {:id (tab-id t) :class "dads-tab__tab" :href (str "#" (panel-id t)) :role "tab"
                       :aria-controls (panel-id t)
                       :aria-selected (if (:selected? t) "true" "false")
                       :tabindex (if (:selected? t) "0" "-1")}
                   [:span (:label t)]])
                tabs))
     (into [:div {:class "dads-tab__panels"}]
           (map (fn [t]
                  [:div (cond-> {:id (panel-id t) :class "dads-tab__panel" :role "tabpanel" :tabindex "0"
                                 :aria-labelledby (tab-id t)}
                          (not (:selected? t)) (assoc :hidden true))
                   (:panel t)])
                tabs))]))

(defn page-navigation
  "DADS page-navigation。opts: :style(:arrow 既定|:text|:outline) :size(\"lg\"|\"md\")
  :counter(\"5 / 9,999\" のような文字列) :prev({:label :href :disabled? :attrs})
  :next(同) :label(nav の aria-label、既定「ページ」)"
  [{:keys [style size counter prev next label attrs] :or {style :arrow size "lg" label "ページ"}}]
  (let [ctl (fn [control dd__40754_1]
              (let [href (fe-get dd__40754_1 :href)
                    disabled? (fe-get dd__40754_1 :disabled?)
                    lbl (fe-get dd__40754_1 :label)
                    ca (fe-get dd__40754_1 :attrs)]
                (let [prev? (= control "prev")
                    arrow (if prev?
                            [:path {:d "m7.9 12 8-8-1.4-1.4L5.1 12l9.4 9.4 1.4-1.4z" :fill "currentcolor"}]
                            [:path {:d "M9 2.6 7.6 4l8 8-8 8L9 21.4l9.4-9.4z" :fill "currentcolor"}])
                    text (or lbl (if prev? "前のページ" "次のページ"))]
                (if (= style :arrow)
                  (let [a (merge ca (cond-> {:class "dads-page-navigation__arrow-button" :data-size size :data-control control}
                                      disabled? (assoc :disabled true)))]
                    (if href
                      [:a (assoc a :href href) [:svg {:width 24 :height 24 :viewBox "0 0 24 24" :aria-hidden "true"} arrow] (visually-hidden text)]
                      [:button (assoc a :type "button") [:svg {:width 24 :height 24 :viewBox "0 0 24 24" :aria-hidden "true"} arrow] (visually-hidden text)]))
                  (let [a (merge ca (cond-> {:class "dads-button" :data-type (if (= style :text) "text" "outline") :data-size size :data-control control}
                                      disabled? (assoc :disabled true)))
                        icon [:svg {:class "dads-button__icon" :width 24 :height 24 :viewBox "0 0 24 24" :aria-hidden "true"} arrow]
                        body (if prev? [icon text] [text icon])]
                    (if href (into [:a (assoc a :href href)] body) (into [:button (assoc a :type "button")] body)))))))]
    [:nav (merge attrs {:class "dads-page-navigation" :aria-label label})
     (when prev (ctl "prev" prev))
     (when counter [:span {:class "dads-page-navigation__counter"} counter])
     (when next (ctl "next" next))]))

(defn progress-indicator
  "DADS progress-indicator。opts: :variant(:spinner 既定|:linear|:static)
  :value(0-100。無ければ不確定ループ) :label :type(\"stacked\" 既定|\"inlined\")
  :intent(\"passive\" 既定|\"active\") :active?(既定 true) :size(spinner の px、既定 48)
  上流は custom element だが CSS は class に効くので div で出す。値は上流 script と
  同じく `--value` custom property で渡す(bar の stroke-dashoffset が読む)。"
  [{:keys [variant value label type intent active? size attrs]
    :or {variant :spinner type "stacked" intent "passive" active? true size 48}}]
  (let [root (merge attrs (cond-> {:class "dads-progress-indicator" :data-type type :intent intent
                                   :role "progressbar" :aria-label (or label "読み込み中")}
                            active? (assoc :active true)
                            value (assoc :aria-valuenow value :aria-valuemin 0 :aria-valuemax 100
                                         :style {:--value value})
                            (nil? value) (assoc :aria-busy "true")))
        indeterminate (nil? value)]
    [:div root
     (case variant
       :linear
       [:svg (cond-> {:class "dads-progress-indicator__linear" :width 240 :height 4 :viewBox "0 0 240 4"
                      :stroke "currentcolor" :fill "none" :aria-hidden "true"}
               indeterminate (assoc :data-indeterminate true))
        [:line {:class "dads-progress-indicator__track" :x1 0 :y1 2 :x2 240 :y2 2 :stroke-width 4}]
        [:line {:class "dads-progress-indicator__bar" :x1 0 :y1 2 :x2 240 :y2 2 :stroke-width 4 :pathLength 100}]
        [:line {:class "dads-progress-indicator__border" :x1 0 :y1 3.5 :x2 240 :y2 3.5 :stroke-width 1}]]
       :static
       [:svg {:class "dads-progress-indicator__static" :width size :height size :viewBox "0 0 48 48" :fill "none" :aria-hidden "true"}
        [:path {:fill "currentcolor" :d "M17 15c0 2.5 2.2 7 7 7s7-5 7-7H17ZM15 42h18c0-2-1-4.5-1-4.5L24 34l-8 3.5S15 40 15 42Z"}]
        [:path {:fill "none" :stroke "currentcolor" :stroke-width 2 :d "M24 24C34.5 24 35.5 6 35.5 4.8V4M24 24C13.5 24 12.5 6 12.5 4.8V4M24 24c7 0 11.5 11.8 11.5 18.3V44M24 24c-7 0-11.5 11.8-11.5 18.3V44M9 4h30M9 44h30"}]
        [:circle {:cx 24 :cy 28 :r 1 :fill "currentcolor"}]
        [:circle {:cx 24 :cy 31 :r 1 :fill "currentcolor"}]]
       ;; :spinner
       [:svg (cond-> {:class "dads-progress-indicator__spinner" :width size :height size :viewBox "0 0 48 48"
                      :stroke "currentcolor" :fill "none" :aria-hidden "true"}
               indeterminate (assoc :data-indeterminate true))
        [:circle {:class "dads-progress-indicator__track" :cx 24 :cy 24 :r 22 :stroke-width 4}]
        [:g [:g [:circle {:class "dads-progress-indicator__bar" :cx 24 :cy 24 :r 22 :stroke-width 4 :pathLength 100}]]]
        [:circle {:class "dads-progress-indicator__border" :cx 24 :cy 24 :r 24 :stroke-width 1}]])
     (when label
       [:span {:class "dads-progress-indicator__label"} label
        (when value [:span {:class "dads-progress-indicator__percentage"} (str value "%")])])]))

(defn resource-list
  "DADS resource-list(1 件)。opts: :style(\"list\" 既定|\"frame\") :title :label
  :support :sub :icon(svg 子要素) :href(あれば body が <a>) :action({:label :attrs}
  末尾の操作ボタン、無ければ出さない) :heading-level(既定 2) :attrs"
  [{:keys [style title label support sub icon href action heading-level attrs] :or {style "list" heading-level 2}}]
  (let [body-attrs (cond-> {:class "dads-resource-list__body"} href (assoc :href href))
        body [(when icon [:svg {:width 24 :height 24 :viewBox "0 0 24 24" :fill "currentcolor" :aria-hidden "true"} icon])
              [:div {:class "dads-resource-list__contents"}
               [(keyword (heading-tag heading-level)) {:class "dads-resource-list__title"} title]
               (when label [:div {:class "dads-resource-list__label"} [:p label]])
               (when support [:div {:class "dads-resource-list__support"} [:p support]])]
              (when sub [:div {:class "dads-resource-list__sub"} [:p sub]])]]
    [:div (merge attrs {:class "dads-resource-list" :data-style style})
     (into [(if href :a :div) body-attrs] body)
     (when action
       [:div {:class "dads-resource-list__action"}
        [:button (merge {:type "button"} (:attrs action) {:class "dads-resource-list__action-button"})
         [:svg {:width 24 :height 24 :viewBox "0 0 24 24" :fill "currentcolor" :role "img" :aria-label (:label action)}
          [:circle {:cx 12 :cy 4.5 :r 1.5}] [:circle {:cx 12 :cy 12 :r 1.5}] [:circle {:cx 12 :cy 19.5 :r 1.5}]]]])]))

(defn search-box
  "DADS search-box。opts: :size(\"lg\" 既定|\"md\") :scopes([[value label] …]。
  無ければ検索対象 select を出さない) :scope-label(既定「検索対象」)
  :scope-name(既定 \"scope\") :q-name(既定 \"q\") :q-label(既定「検索」)
  :q-value :placeholder :submit-label(既定「検索」) :form({:action :method}
  あれば <form> で包む) :detail(hiccup。詳細検索の disclosure 内容) :attrs"
  [{:keys [size scopes scope-label scope-name q-name q-label q-value placeholder submit-label form detail attrs]
    :or {size "lg" scope-label "検索対象" scope-name "scope" q-name "q" q-label "検索" submit-label "検索"}}]
  (let [box [:div (merge attrs {:class "dads-search-box" :data-size size})
             [:div {:class "dads-search-box__fields"}
              (when (seq scopes)
                [:label {:class "dads-search-box__select"}
                 [:span scope-label]
                 (into [:select {:name scope-name}] (map (fn [dd__47905_1] (let [v (fe-nth dd__47905_1 0)
                                                                           l (fe-nth dd__47905_1 1)] [:option {:value v} l])) scopes))
                 [:svg {:width 16 :height 16 :viewBox "0 0 24 24" :aria-hidden "true"} icon-chevron-down]])
              [:label {:class "dads-search-box__input"}
               [:svg {:width 24 :height 24 :viewBox "0 0 24 24" :aria-hidden "true"}
                [:path {:d "m21 20.5-6-6a7.4 7.4 0 0 0 1.9-5A7.4 7.4 0 0 0 9.5 2 7.5 7.5 0 1 0 14 15.5l6 6 1-1ZM3.5 9.5a6 6 0 0 1 6-6 6 6 0 0 1 6 6 6 6 0 0 1-6 6 6 6 0 0 1-6-6Z" :fill "currentcolor"}]]
               (visually-hidden q-label)
               [:input (cond-> {:type "search" :name q-name}
                         q-value (assoc :value q-value)
                         placeholder (assoc :placeholder placeholder))]]]
             (when detail
               [:details {:class "dads-search-box__detail dads-disclosure"}
                [:summary {:class "dads-disclosure__summary"}
                 [:svg {:class "dads-disclosure__icon" :width 24 :height 24 :viewBox "0 0 24 24" :aria-hidden "true"}
                  [:circle {:cx 12 :cy 12 :r 11 :fill "currentcolor"}]
                  [:circle {:class "dads-disclosure__icon-circle" :cx 12 :cy 12 :r 8 :fill "currentcolor"}]
                  [:path {:class "dads-disclosure__icon-triangle" :d "M17 10H7L12 15L17 10Z" :fill "Canvas"}]]
                 "詳細検索"]
                [:div {:class "dads-disclosure__content"} detail]])
             [:button {:class "dads-button" :type "submit" :data-type "solid-fill" :data-size size} submit-label]]]
    (if form
      [:form {:action (:action form) :method (or (:method form) "get") :role "search"} box]
      box)))

(defn step-navigation
  "DADS step-navigation。steps は `{:title :description :state(\"reached\"|\"current\"
  |nil) :href}` の列。opts: :orientation(\"horizontal\" 既定|\"vertical\")
  :size(\"normal\" 既定|\"small\") :reached(到達済みステップ数、読み上げ文に使う)
  :summary(読み上げ文を自分で渡す) :attrs"
  [{:keys [orientation size reached summary attrs] :or {orientation "horizontal" size "normal"}} steps]
  (let [n (count steps)
        reached (or reached (count (filter #(contains? #{"reached" "current"} (:state %)) steps)))]
    [:div (merge attrs {:class "dads-step-navigation" :data-orientation orientation :data-size size})
     [:p {:class "dads-u-visually-hidden"} (or summary (str "全" n "ステップ中、" reached "ステップ目まで到達済み"))]
     (into [:ul]
           (map-indexed
            (fn [i dd__50287_1]
              (let [title (fe-get dd__50287_1 :title)
                    description (fe-get dd__50287_1 :description)
                    state (fe-get dd__50287_1 :state)
                    href (fe-get dd__50287_1 :href)]
                [:li (cond-> {:class "dads-step-navigation__step"}
                     state (assoc :data-state state)
                     (zero? i) (assoc :data-first true)
                     (= i (dec n)) (assoc :data-last true))
               [(if href :a :span) (cond-> {:class "dads-step-navigation__header"} href (assoc :href href))
                (visually-hidden "ステップ")
                [:span {:class "dads-step-navigation__number"} (inc i)]
                [:span {:class "dads-step-navigation__title"} title]]
               (when description [:p {:class "dads-step-navigation__description"} description])]))
            steps))]))

(defn toc
  "DADS toc(目次)。items は `{:href :label :children([…])}` の列(nested は上流
  toc/nested.html どおり dads-list の入れ子)。opts: :heading(既定「このページの目次」)
  :id(既定 \"toc\") :spacing(既定 \"8\")"
  [{:keys [heading id spacing attrs] :or {heading "このページの目次" id "toc" spacing "8"}} items]
  (let [heading-id (str id "-heading")
        render (fn render [items]
                 (into [:ul {:class "dads-list" :data-spacing spacing}]
                       (map (fn [dd__51430_1]
                              (let [href (fe-get dd__51430_1 :href)
                                    label (fe-get dd__51430_1 :label)
                                    children (fe-get dd__51430_1 :children)]
                                [:li [:a {:class "dads-link" :href href} label]
                               (when (seq children) (render children))]))
                            items)))]
    [:nav (merge attrs {:class "dads-toc" :aria-labelledby heading-id})
     [:h2 {:id heading-id :class "dads-toc__heading"} heading]
     (render items)]))

(defn carousel-single
  "DADS carousel の key-visual-single(1 枚の静的キービジュアル)。
  上流の複数枚 carousel は 9KB の slide machine(carousel.js)が動かす別物で、
  この wrapper は担わない — 複数枚が要る場所はそれを移植してから。
  opts: :src :srcset :alt :width :height :href(あれば link)"
  [{:keys [src srcset alt width height href attrs]}]
  [:div (merge attrs {:class "dads-carousel-single"})
   [(if href :a :span) (cond-> {:class "dads-carousel-single__link"} href (assoc :href href))
    [:img (cond-> {:class "dads-carousel-single__image" :src src :alt (or alt "")}
            srcset (assoc :srcset srcset) width (assoc :width width) height (assoc :height height))]]])

(defn- day-of-week
  "0 = 日曜。Sakamoto の式(proleptic Gregorian)。"
  [y m d]
  (let [t [0 3 2 5 0 3 5 1 4 6 2 4]
        y (if (< m 3) (dec y) y)]
    (mod (+ y (quot y 4) (- (quot y 100)) (quot y 400) (nth t (dec m)) d) 7)))

(defn- days-in-month [y m]
  (case m
    (1 3 5 7 8 10 12) 31
    (4 6 9 11) 30
    (if (or (and (zero? (mod y 4)) (pos? (mod y 100))) (zero? (mod y 400))) 29 28)))

(defn calendar
  "DADS calendar の**静的な月表示**。上流の calendar.js(月送り・年 select・
  キーボード grid)は 14KB のアプリケーションで、ここには載せない — この
  wrapper は与えた年月の grid を描くだけで、日付ボタンの click は
  `:day-attrs` の attrs(`data-*` / `command` 等)で host が扱う。
  opts: :year :month(1-12) :selected(日) :disabled(#{日}) :min :max(日)
  :heading(読み上げ用の h2。既定「YYYY年M月」) :weekday-labels(既定 日〜土)
  :day-attrs(fn [day] → attrs) :prev({:href :label}) :next(同) :year-options
  ([[value label] …]、あれば年 select を出す) :attrs"
  [{:keys [year month selected disabled min max heading weekday-labels day-attrs prev next year-options attrs]
    :or {weekday-labels ["日" "月" "火" "水" "木" "金" "土"] disabled #{}}}]
  (let [first-dow (day-of-week year month 1)
        n (days-in-month year month)
        cells (concat (repeat first-dow nil) (range 1 (inc n)))
        cells (concat cells (repeat (mod (- 7 (mod (count cells) 7)) 7) nil))
        weeks (partition 7 cells)
        heading (or heading (str year "年" month "月"))
        nav-btn (fn [dd__53808_1 icon]
                  (let [href (fe-get dd__53808_1 :href) label (fe-get dd__53808_1 :label)]
                    (let [a {:class "dads-button dads-calendar__nav-button" :data-size "sm" :data-type "outline"}]
                    (if href
                      [:a (assoc a :href href) [:svg {:width 16 :height 16 :viewBox "0 0 16 16" :role "img" :aria-label label} icon]]
                      [:button (assoc a :type "button") [:svg {:width 16 :height 16 :viewBox "0 0 16 16" :role "img" :aria-label label} icon]]))))]
    [:div (merge attrs {:class "dads-calendar" :role "application"})
     [:div {:class "dads-u-visually-hidden"} [:h2 {:aria-live "polite"} heading]]
     [:div {:class "dads-calendar__controls"}
      (when (seq year-options)
        (select {:size "sm" :value year :attrs {:aria-label "年"}} year-options))
      [:div {:class "dads-calendar__navigation"}
       (when prev (nav-btn (merge {:label "前の月"} prev) [:path {:d "m5.27 8 5.33-5.33-.93-.94L3.4 8l6.27 6.27.93-.94L5.27 8Z" :fill "currentcolor"}]))
       [:p {:class "dads-calendar__current-month"} heading]
       (when next (nav-btn (merge {:label "次の月"} next) [:path {:d "m6 1.73-.93.94L10.4 8l-5.33 5.33.93.94L12.27 8 6 1.73Z" :fill "currentcolor"}]))]]
     [:table {:class "dads-calendar__table" :role "grid"}
      [:thead (into [:tr] (map (fn [l] [:th {:class "dads-calendar__header-cell" :scope "col"} l]) weekday-labels))]
      (into [:tbody]
            (map (fn [week]
                   (into [:tr]
                         (map (fn [d]
                                (if d
                                  (let [off? (or (contains? disabled d) (and min (< d min)) (and max (> d max)))]
                                    [:td {:class "dads-calendar__data-cell"}
                                     [:button (merge {:type "button"} (when day-attrs (day-attrs d))
                                                     (cond-> {:class "dads-calendar__date"
                                                              :aria-label (str year "年" month "月" d "日")}
                                                       (= d selected) (assoc :data-selected true :aria-selected "true")
                                                       off? (assoc :disabled true)))
                                      d]])
                                  [:td {:class "dads-calendar__data-cell"}]))
                              week)))
                 weeks))]]))

(defn date-picker
  "DADS date-picker の separated 型(年 / 月 / 日の 3 入力。popup calendar は
  date-picker.js の担当で、ここには載せない)。opts: :id-prefix :size(\"md\" 既定)
  :value({:year :month :day}) :error(文字列。data-error + error text)
  :disabled? :readonly? :name-prefix(name を \"<prefix>-year\" 等にする) :attrs"
  [{:keys [id-prefix size value error disabled? readonly? name-prefix attrs] :or {id-prefix "date-picker" size "md"}}]
  (let [error-id (str id-prefix "-error-text")
        input (fn [k label]
                [:label {:class (str "dads-date-picker__" (name k))}
                 [:span {:class "dads-date-picker__label"} label]
                 [:input (cond-> {:class "dads-date-picker__input" :type "text" :inputmode "numeric" :pattern "[0-9]+"
                                  :id (str id-prefix "-" (name k))}
                           name-prefix (assoc :name (str name-prefix "-" (name k)))
                           (get value k) (assoc :value (get value k))
                           error (assoc :aria-invalid "true" :aria-describedby error-id)
                           disabled? (assoc :disabled true)
                           readonly? (assoc :readonly true))]])]
    [:div (merge attrs {:class "dads-date-picker" :data-type "separated"})
     [:div {:class "dads-date-picker__controls" :data-size size}
      [:div (cond-> {:class "dads-date-picker__inputs"}
              error (assoc :data-error true)
              disabled? (assoc :data-disabled true)
              readonly? (assoc :data-readonly true))
       (input :year "年") (input :month "月") (input :day "日")]]
     (when error
       [:p {:id error-id :class "dads-date-picker__error-text"} error])]))

(defn file-upload
  "DADS file-upload の静的な形(input[type=file] + ドロップ領域の案内)。上流の
  file-upload.js(件数・容量の検証、ドラッグ＆ドロップ、選択済み一覧の描画)は
  19KB のアプリケーションでここには載せない — 選択は `<label class=dads-button
  for=input>` で script 無しに開き、検証は form の受け側が行う。
  opts: :id(必須) :name :accept :multiple? :label(既定「ファイルを選択」)
  :hint(既定「または、このエリア内にドラッグ＆ドロップ」) :describedby :attrs"
  [{:keys [id name accept multiple? label hint describedby attrs]
    :or {label "ファイルを選択" hint "または、このエリア内にドラッグ＆ドロップ"}}]
  [:div (merge attrs {:class "dads-file-upload"})
   [:input (cond-> {:id id :class "dads-file-upload__input" :type "file"}
             name (assoc :name name) accept (assoc :accept accept) multiple? (assoc :multiple true)
             describedby (assoc :aria-describedby describedby))]
   [:div {:class "dads-file-upload__inner"}
    [:div {:class "dads-file-upload__drop-area"}
     [:div {:class "dads-file-upload__button-area"}
      [:label {:class "dads-button" :data-type "outline" :data-size "md" :for id} label]
      [:p hint]]]]])

;; --- dds-ext: what DADS does not have, on behavior --------------------------

(defn combobox
  "combobox(入力 + 候補 listbox)— DADS に無い pattern を DADS の input-text と
  menu-list の class で組み、`behavior`(data-behavior=combobox)が動かす。
  opts: :id(必須) :name(hidden input の name。選ばれた value が入る)
  :label(input の aria-label。form-field で包むなら :for id) :placeholder
  :value :value-label(初期表示) :empty-label(既定「候補がありません」) :size :attrs
  options は `{:value :label :keywords}` の列。"
  [{:keys [id name label placeholder value value-label empty-label size attrs] :or {empty-label "候補がありません" size "md"}} options]
  (let [list-id (str id "-listbox")
        current (some #(when (= (str (:value %)) (str value)) %) options)]
    [:div (merge attrs (cond-> {:id (str id "-combobox") :class "dads-input-text" :data-behavior "combobox"}
                         value (assoc :data-value (str value))))
     [:input (cond-> {:id id :class "dads-input-text__input" :data-size size :type "text" :role "combobox"
                      :autocomplete "off" :spellcheck "false"
                      :aria-autocomplete "list" :aria-expanded "false" :aria-controls list-id}
               label (assoc :aria-label label)
               placeholder (assoc :placeholder placeholder)
               (or value-label current) (assoc :value (or value-label (:label current))))]
     (when name [:input {:type "hidden" :name name :value (or value "") :data-combobox-value true}])
     [:ul {:id list-id :class "dads-menu-list" :role "listbox" :data-chrome "float" :hidden true
           :aria-label (or label "候補")}
      (map-indexed (fn [i dd__60487_1]
                     (let [value (fe-get dd__60487_1 :value)
                           label (fe-get dd__60487_1 :label)
                           keywords (fe-get dd__60487_1 :keywords)]
                       [:li {:role "presentation"}
                      [:div (cond-> {:id (str list-id "-" i) :class "dads-menu-list__item" :data-type "box" :data-size "regular"
                                     :role "option" :aria-selected "false" :data-value (str value) :data-label label}
                              keywords (assoc :data-combobox-keywords keywords))
                       [:span {:class "dads-menu-list__label"} label]]]))
                   options)
      [:li {:role "presentation"} [:p {:class "dads-menu-list__label" :data-combobox-empty true :hidden true} empty-label]]]]))

(defn toast-region
  "toast の live region(1 文書に 1 つ、body の末尾)。`behavior` が
  jpGoDds.behavior.toast() でここに .dds-ext-toast を追加する。
  opts: :id :close-label(既定「閉じる」) :attrs"
  [{:keys [id close-label attrs] :or {id "toast" close-label "閉じる"}}]
  [:div (merge attrs {:id id :class "dds-ext-toast-region" :data-behavior "toast" :role "status"
                      :aria-live "polite" :aria-atomic "false" :data-close-label close-label})])

(defn toast
  "server-rendered な toast 1 件(page load 時に既に出ているもの。`behavior` が
  timeout で閉じる)。opts: :text :action({:label :attrs}) :timeout(ms、0 で残る、
  既定 6000) :tone(:error|:success) :close-label"
  [{:keys [text action timeout tone close-label] :or {timeout 6000 close-label "閉じる"}}]
  [:div (cond-> {:class "dds-ext-toast" :data-timeout timeout} tone (assoc :data-tone (name tone)))
   [:p {:class "dds-ext-toast__text"} text]
   (when action
     [:button (merge {:type "button"} (:attrs action) {:class "dds-ext-toast__action"}) (:label action)])
   [:button {:type "button" :class "dds-ext-toast__close" :data-toast-close true :aria-label close-label} "×"]])

;; --- layout 拡張(上流に無い。dds-ext-* prefix、ext-css が対) --------------------

(def ext-rules
  "上流に無い layout 補助を **EDN で** 書いたもの(生 CSS 記法を持ち込まない)。
  DADS token のみ参照し raw hex は書かない。

  map ではなく `[selector decls]` の **ベクタ列**にしているのは順序のため —
  Clojure の map は要素数が閾値を超えるとハッシュ順になり、CSS のカスケード
  (後勝ち)が壊れる。"
  [[".dds-ext-container" {:max-width "64rem" :margin-inline "auto"
                          ;; page は viewport-fit=cover を張るので notch /
                          ;; home indicator の領域はこちらの責任になる。これが
                          ;; 無いと notched device で内容がその下に潜る。
                          :padding-inline (str "max(1rem,env(safe-area-inset-left)) "
                                               "max(1rem,env(safe-area-inset-right))")}]
   [".dds-ext-section" {:padding-block "3rem"
                        :border-top "1px solid var(--color-neutral-solid-gray-200)"}]
   [".dds-ext-section:first-of-type" {:border-top "none"}]
   ;; `min(…,100%)` は装飾ではない。`minmax(19rem,1fr)` の track は 19rem より
   ;; 細くなれないので、container がそれより狭い画面ではグリッドが container を
   ;; はみ出し、**ページ全体が横スクロールする**。実測 2026-09-07:
   ;; kotoba-lang.org を 320px 幅で開くと 32px の横スクロールが出ており、
   ;; 原因は `:min "19rem"` / `"21rem"` を渡した grid だった(360px 以上では
   ;; 出ないので、狭い端末だけで再現する)。`min()` を噛ませると track は
   ;; 「指定値」と「container 幅」の小さい方まで縮み、1 列に落ちる。
   [".dds-ext-grid" {:display "grid"
                     :grid-template-columns
                     "repeat(auto-fill,minmax(min(var(--dds-ext-grid-min,16rem),100%),1fr))"
                     :gap "1.5rem"}]
   [".dds-ext-grid>*" {:min-width 0}]
   [".dds-ext-stack" {:display "flex" :flex-direction "column"
                      :gap "var(--dds-ext-stack-gap,1rem)"}]
   [".dds-ext-row" {:display "flex" :flex-wrap "wrap" :gap "1rem" :align-items "center"}]
   [".dds-ext-card" {:border "1px solid var(--color-neutral-solid-gray-200)"
                     :border-radius 12 :padding "1.5rem"
                     :background "var(--color-neutral-white)"}]
   [".dds-ext-hero" {:padding-block "4rem 3rem" :text-align "center"}]
   [".dds-ext-hero .dads-heading" {:margin "0 0 1rem"}]
   [".dds-ext-center" {:display "flex" :flex-direction "column" :align-items "center"
                       :gap "1rem" :text-align "center"}]
   [".dds-ext-lead" {:color "var(--color-neutral-solid-gray-600)"
                     :font-size "1.125rem" :line-height 1.7 :margin 0}]
   ["body" {:margin 0 :background "var(--color-neutral-white)"
            :color "var(--color-neutral-solid-gray-800)"
            :font-family "var(--font-family-sans)"}]
   ["img,svg" {:max-width "100%" :height "auto"}]
   ;; 上流 .dads-table は overflow を持たず .dads-table__table にも width 指定が
   ;; 無いので、列が多い/内容が長い表は狭い viewport で**ページ全体**を横スクロール
   ;; させる(実測: 500px 幅で body scrollWidth が clientWidth を超える)。表は
   ;; 自分の中だけでスクロールさせる。上流 class を触るが、これは restyle ではなく
   ;; はみ出しの封じ込め(ext-rules は既に body / img,svg も指定している)。
   [".dads-table" {:max-width "100%" :min-width 0 :overflow-x "auto"}]
   ;; light-only を CSS にも明示する。上流デジタル庁に dark palette は無く
   ;; (ADR-2607261600 決定2)、`page` は meta を張っているが、form control を
   ;; light に従わせるには CSS 側の宣言も要る。dark を自作するのではなく
   ;; 「light だけである」ことを述べている。
   [":root" {:color-scheme "light"}]
   ;; Top as well as bottom. `ext-rules` ships in the stylesheet a WebView app
   ;; reads from its own bundle, and that is the surface with an inset at the
   ;; top; see `tokens/a11y-css` for what was measured on 2026-09-06.
   ["body" {:padding-top "env(safe-area-inset-top)"
            :padding-bottom "env(safe-area-inset-bottom)"}]])

(def ext-media
  "viewport / 入力デバイス依存の ext 規則。上流の vendored subset は
  safe-area / tap-target / breakpoint を持たないため、DADS を素で使うと
  kotoba-lang/design-quality の決定論的 HIG/WCAG 監査(ADR-2607132300)で
  65.34 になる(safe-area 0.13 / tap-targets 0.13 / responsive 0.07 /
  color-scheme 0.06 を落とす)。これは design system 層の欠落であって
  個々のページの責任ではないので、各 consumer の app CSS ではなくここに置く。

  entry が少ないので map の順序は問題にならない(ext-rules がベクタ列なのは
  カスケード順のため — そちらの docstring 参照)。"
  {;; HIG は touch で 44pt 以上を要求する。coarse pointer に限定し、desktop では
   ;; DADS 自身の寸法を保つ(全環境で太らせない)。
   "(pointer:coarse)"
   [[".dads-button,.dads-accordion__summary,.dads-menu-list-box__opener"
     {:min-height "44px"}]]

   "(max-width:48rem)"
   [[".dds-ext-section" {:padding-block "2rem"}]
    [".dds-ext-hero" {:padding-block "2.5rem 2rem"}]
    [".dds-ext-grid" {:--dds-ext-grid-min "100%"}]]})

(def ext-css
  "ext-rules + ext-media を CSS 文字列にしたもの(page が <style> に流し込む)。"
  (css/css {:rules ext-rules :media ext-media}))

(defn container [& children] (into [:div {:class "dds-ext-container"}] children))
(defn section
  [{:keys [title id]} & children]
  (into [:section (cond-> {:class "dds-ext-section"} id (assoc :id id))
         (when title (heading 2 title {:size "32"}))]
        children))
(defn grid
  [{:keys [min]} & children]
  (into [:div (cond-> {:class "dds-ext-grid"}
                min (assoc :style {:--dds-ext-grid-min min}))]
        children))
(defn stack [& children] (into [:div {:class "dds-ext-stack"}] children))
(defn row [& children] (into [:div {:class "dds-ext-row"}] children))
(defn card [& children] (into [:div {:class "dds-ext-card"}] children))
