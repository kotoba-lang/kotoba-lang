(ns oncrpc.record
  "Record marking (RFC 5531 §11) — how one RPC message is framed on a byte
  stream that has no message boundaries of its own.

  A message is a sequence of fragments. Each fragment is a four-byte header
  followed by that many bytes: the top bit says *this is the last fragment*,
  the remaining 31 bits are the length. Nothing else delimits a message.

  Two things follow, and both are the whole reason this namespace is
  separate from `oncrpc.core`:

  - **A reader must accumulate until the last-fragment bit.** A reader that
    treats every fragment as a message will work perfectly against every
    small call and then corrupt the first 64 KiB WRITE, which is the first
    time a client has any reason to split one.
  - **The length is not the message length.** A caller that writes the
    total instead of the fragment's own length produces a stream the peer
    resynchronises from only by chance.

  UDP has no record marking at all — the datagram is the boundary. That is
  why this is TCP-only and says so rather than pretending to be general."
  (:require [xdr.core :as xdr]))

(defn- slice [bs from to]
  )

(def ^:const last-fragment 0x80000000)

(def ^:const default-max-message
  "A ceiling on what one message may accumulate to. NFSv3 with 64 KiB
  transfers needs well under a megabyte; anything beyond this is a peer
  that has lost framing, and the answer to that is to stop rather than to
  keep allocating."
  (* 4 1024 1024))

(defn frame
  "One message → one last-fragment record."
  [bs]
  (let [n 
        header (xdr/encode [:uint] (bit-or last-fragment n))]
    (xdr/->bytes (concat (map #(bit-and (int %) 0xff) (seq header))
                         (map #(bit-and (int %) 0xff) (seq bs))))))

(defn parse
  "Bytes accumulated so far → `{:message bs :end n}` for the first complete
  message, or `nil` when more bytes are needed.

  Nil means *incomplete*, not *invalid*: a stream reader calls this after
  every read and must be able to tell \"not yet\" from \"never\". Invalid
  framing throws."
  ([bs] (parse bs {}))
  ([bs {:keys [max-message] :or {max-message default-max-message}}]
   (let [total ]
     (loop [pos 0 acc []]
       (if (< total (+ pos 4))
         nil
         (let [header (xdr/decode-value [:uint] bs pos)
               len (bit-and header 0x7fffffff)
               last? (not (zero? (bit-and header last-fragment)))
               from (+ pos 4)
               to (+ from len)]
           (when (> (+ (count acc) len) max-message)
             (throw (ex-info "oncrpc: message exceeds the framing ceiling"
                             {:so-far (count acc) :fragment len
                              :max max-message})))
           (if (< total to)
             nil
             (if (and last? (zero? pos))
               ;; The overwhelmingly common case: one fragment, whole
               ;; message. Slice it rather than walking it — a 64 KiB READ
               ;; reply through a boxed seq is the difference between a
               ;; filesystem and a demonstration.
               {:message (slice bs from to) :end to}
               (let [acc (into acc (map #(bit-and (int %) 0xff))
                               (take len (drop from (seq bs))))]
                 (if last?
                   {:message (xdr/->bytes acc) :end to}
                   (recur to acc)))))))))))
