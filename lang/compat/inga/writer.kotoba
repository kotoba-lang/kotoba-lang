(ns inga.writer
  "Who may write a ref. Opt-in per ref, checked where records become state.

  `inga.ref/project` keeps the first committed record per `[ref seq]` and
  never asks who wrote it. Without a policy, anyone who can reach a node's
  submit path can take the next sequence of any ref, and the quorum will
  certify it. Measured on the v5 score chain (2026-10-07): inga-node's
  `/submit` requires only `ref` and `cid`.

  A policy maps refs to the writers allowed on them:

      {\"yataverse/lake\"   #{\"did:key:z6Mk…operator\"}
       \"yataverse/graph/\" #{\"did:key:z6Mk…mirror\"}}

  A key ending in `/` is a prefix. An exact key beats a prefix, and a longer
  prefix beats a shorter one. A ref that no key covers is unrestricted. That
  is what makes the policy opt-in, so turning it on for one ref changes
  nothing for any other.

  A record on a covered ref must carry `writer` (a did:key in the set) and
  `sig`, a signature by that writer over `signing-text`. The text covers the
  chain id and every field a record may carry, so a signed record cannot be
  replayed at another sequence, onto another ref, onto another chain, or
  with any field changed. A record with any other field is refused.

  `verify-fn` is injected, `(verify-fn writer text sig) -> boolean`, for the
  same reason `inga.attest` injects its curve: this namespace has no crypto
  dependency, and the curve lives at the edge.

  Where it runs: `admit` is the predicate `inga.ref/project` filters with.
  A record that fails it is still in the block (the quorum ordered it), but
  it never becomes state. It cannot take a sequence, so the next authorized
  record at that sequence wins. Every node and every reader that applies the
  same policy derives the same head, because the check is a pure function of
  the record. Rejecting such records before voting would also keep them out
  of blocks; that needs a validation seam in `inga.replica`, which this does
  not add."
  (:require [kotoba.lang.text :as str]))

(def record-version "inga.ref-record/v2")

(def signed-fields
  "Every field a covered record may carry besides `writer` and `sig`. All of
  them are signed, so a copy of a signed record with any field changed does
  not verify (v1 signed only ref/seq/cid/prev, and a copy with a different
  `v` or `height` could be ordered first and win)."
  ["ref" "seq" "cid" "prev" "v" "height"])

(defn signing-text
  "The exact text a writer signs: the version, the chain id (so a record
  signed for one chain cannot be replayed on another), then every signed
  field as `name=value`, newline-separated, absent as empty."
  [chain-id record]
  (apply str "inga/ref-record/v2\n" "chain=" chain-id "\n"
         (for [f signed-fields] (str f "=" (let [v (get record f)] (if (nil? v) "" v)) "\n"))))

(defn- entry
  "A policy value is a writer set, or {\"writers\" #{...} \"from_seq\" n}.
  `from_seq` grandfathers history: records below it were committed before the
  policy existed and are admitted as they are, so enabling a policy on a ref
  that already has unsigned history does not erase its head."
  [v]
  (if (set? v) {:writers v :from-seq 0} {:writers (get v "writers") :from-seq (or (get v "from_seq") 0)}))

(defn writers-for
  "The policy entry ({:writers :from-seq}) covering `ref-name`, or nil when
  the policy leaves it unrestricted."
  [policy ref-name]
  (when (string? ref-name)
    (some-> (or (get policy ref-name)
                (some->> (keys policy)
                         (filter #(and (str/ends-with? % "/") (str/starts-with? ref-name %)))
                         (sort-by count >)
                         first
                         (get policy)))
            entry)))

(defn refusal
  "nil when `record` may become state under `policy` on chain `chain-id`,
  else a keyword saying why not. Total: a malformed record is refused, never
  thrown on, because refused records stay in committed blocks and one bad
  record must not stop every reader from projecting."
  [policy chain-id verify-fn record]
  (let [ref-name (get record "ref")]
    (if-not (string? ref-name)
      (when (seq policy) :malformed)
      (when-let [{:keys [writers from-seq]} (writers-for policy ref-name)]
        (let [seq' (get record "seq") writer (get record "writer") sig (get record "sig")]
          (cond
            (not (integer? seq')) :malformed
            (< seq' from-seq) nil
            (not (every? (set (concat signed-fields ["writer" "sig"])) (keys record))) :unexpected-field
            (not (and (string? writer) (string? sig))) :unsigned
            (not (contains? writers writer)) :writer-not-allowed
            ;; Literally true: a verifier that returns a promise (WebCrypto) is
            ;; truthy before it resolves, and must not admit everything.
            (not (true? (try (verify-fn writer (signing-text chain-id record) sig)
                             (catch  _ false))))
            :bad-signature
            :else nil))))))

(defn admit
  "The predicate `inga.ref/project` filters committed records with."
  [policy chain-id verify-fn]
  (fn [record] (nil? (refusal policy chain-id verify-fn record))))
