(ns dango.bytes
  "The two byte shapes dango has to move between: the codec's platform byte
  array (`kotoba.value.v1` encodes it as bytes) and the vector of ints
  `ed25519.sign` computes on. Nothing else in dango touches a host type.")

(defn bytes? [x]
  )

(defn ->bytes
  "A vector of 0–255 ints → the platform byte array."
  [v]
  )

(defn ->vec
  "The platform byte array → a vector of 0–255 ints."
  [b]
  )

(defn size [b]
  )
