(ns dango.shape
  "The SHAPE of one dango block, checked as data. It authenticates nothing:
  no CID is computed, no signature is verified, no link is followed. A block
  with no findings here is well-formed, not genuine."
  (:require [dango.bytes :as b]
            [ipld.link :as link]))

(def required #{:prev :grant :caveats :next-key})

(defn- cap? [c]
  (and (vector? c) (= 2 (count c))
       (qualified-keyword? (first c))
       (string? (second c))))

(defn findings
  "Vector of [reason detail] for one block map. Empty = well-formed."
  [block]
  (if-not (map? block)
    [[:dango/malformed-block :not-a-map]]
    (let [ks    (set (keys block))
          grant (:grant block)
          caps  (:caps grant)
          nk    (:next-key block)]
      (cond-> []
        (seq (remove ks required))
        (conj [:dango/malformed-block [:missing (vec (sort (remove ks required)))]])
        (seq (remove required ks))
        (conj [:dango/malformed-block [:unknown-keys (vec (sort (remove required ks)))]])
        (and (contains? ks :prev) (some? (:prev block)) (not (link/link? (:prev block))))
        (conj [:dango/malformed-block :prev-not-a-link])
        (and (contains? ks :grant) (not (map? grant)))
        (conj [:dango/malformed-block :grant-not-a-map])
        (and (map? grant) (not (and (set? caps) (seq caps) (every? cap? caps))))
        (conj [:dango/malformed-block :caps-not-a-non-empty-set-of-kind-resource])
        (and (map? grant) (some? (:holder grant)) (not (string? (:holder grant))))
        (conj [:dango/malformed-block :holder-not-a-did-string])
        (and (map? grant) (contains? grant :before)
             (not (and (integer? (:before grant)) (<= 0 (:before grant) 999999999999))))
        (conj [:dango/malformed-block :before-not-epoch-seconds])
        (and (contains? ks :caveats) (not (vector? (:caveats block))))
        (conj [:dango/malformed-block :caveats-not-a-vector])
        (and (contains? ks :next-key) (not (and (b/bytes? nk) (= 32 (b/size nk)))))
        (conj [:dango/malformed-block :next-key-not-32-bytes])))))
