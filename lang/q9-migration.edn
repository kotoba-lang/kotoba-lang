 :whole-component-build-contract
 {:rule
  "A migration lands only as a complete component entry. Extracting a predicate, decision core, or hand-flattened scalar shadow while the namespace continues to execute in Clojure is not a Q9 migration."
  :public-cli
  {:source-check "kotoba check --safe <entry.kotoba|entry.cljk>"
   :source-build "kotoba compile <entry.kotoba|entry.cljk> --target <target> --output <artifact>"
   :package-build "kotoba rad build --project <repository> --profile release"
   :distribution :verified-native-executable
   :jvm-launcher-forbidden true
   :internal-namespace-entry-forbidden true}
  :amu
  {:runtime :nbb-node
   :source-check "amu check <entry.kotoba|entry.cljk> --jvm-free"
   :compile "amu compile <entry.kotoba|entry.cljk> --target <target> --jvm-free --output <artifact>"
   :jvm-fallback :fail-closed
   :unsupported-target :migration-blocked}
  :acceptance-environment
  {:jvm-installed :not-required
   :forbidden-processes ["java" "javac" "clojure" "clj"]
   :java-home :invalid-or-unset
   :process-trace-required true
   :dependency-lock-required true}
  :policy-gate
  {:command "bb scripts/check-q9-migration.bb"
   :runtime :babashka-native
   :jvm-required false}
  :required-for-every-declared-target true
  :artifact-equivalence
  {:same-payload-cid true
   :same-definition-cids true
   :same-exports true
   :same-imports true
   :same-effects true
   :same-resource-bounds true
   :wrapper-provenance-may-differ true}
  :component-closure
  {:all-public-exports-covered true
   :transitive-source-closure-covered true
   :host-functionality :explicit-capability-import
   :ambient-host-fallback-forbidden true}
  :oracle-parity
  {:jvm-required false
   :retained-cljc-runtime :nbb-cljs
   :other-oracles [:content-addressed-golden-vectors :native :wasm]
   :jvm-observations :historical-non-gating}
  :forbidden
  [:decision-core-only-shadow
   :function-only-parity-as-migration-proof
   :caller-precomputed-business-decision
   :unchecked-extension-rename
   :single-build-path-only
   :jvm-build-or-test-dependency
   :implicit-jvm-fallback]
  :legacy-decision-cores
  {:status :historical-evidence-only
   :new-consumer-cutover false
   :expansion false
   :required-successor :whole-component-build}}

