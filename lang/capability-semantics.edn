{:kotoba.lang.capability-semantics/version 2
 :kotoba.lang.capability-semantics/as-of "2026-08-30"
 :kotoba.lang.capability-semantics/qualification :q2
 :terms
 {:effect :statically-inferred-possible-operation
  :intent :concrete-operation-requested-by-this-run
  :grant :delegated-upper-bound-never-runtime-authority
  :capability :unforgeable-post-authorization-runtime-value
  :receipt :evidence-for-every-allowed-or-denied-attempt}
 :identity-keys [:cap/kind :cap/resource :cap/holder :cap/expires :cap/provenance]
 :grant-keys [:grant/kind :grant/resources :grant/expires :grant/id]
 :policy-keys [:policy/allow :policy/forbid-wildcard]
 :receipt-requirements
 [:receipt/cap :receipt/at :receipt/call :receipt/outcome]
 :rules
 {:plain-resource-is-not-authority true
  :unknown-kind :deny
  :missing-grant :deny
  :expired-grant :deny
  :missing-static-effect :deny
  :runtime-unavailable :deny
  :empty-intersection :deny
  :effective-scope :statically-possible-intersect-requested-intersect-delegated-intersect-local-policy-intersect-runtime-available
  :scope-attenuation-only true
  :biscuit-role :delegated-grant-only
  :only-local-authorizer-may-allow true
  :handler-receives :concrete-post-intersection-capability
  :attempt-always-receipted true
  :raw-bearer-in-public-car :forbidden
  :production-effective-wildcard :forbidden
  :wildcard-fixtures
  "The :any fixtures exercise intersection algebra only. A production local policy MUST set :policy/forbid-wildcard true, so :any can never become effective authority."}
 :logic
 {:format :kotoba.logic-manifest/v1
  :source-syntax :inert-closed-list-ast
  :wire-facts :bounded-nary-tuples
  :predicate-origins
  {"amu:" :verified-compiler-manifest
   "vm:" :current-execution-request
   "grant:" :verified-attenuated-delegation
   "policy:" :local-authorizer
   "runtime:" :provider-world-and-revocation-plane
   "receipt:" :execution-evidence}
  :provenance-rule :same-predicate-vocabulary-does-not-imply-same-authority
  :compiler-facts :must-be-bound-to-definition-kir-effects-semantics-and-world-cids
  :token-facts :must-not-be-visible-as-trusted-compiler-policy-or-runtime-facts
  :carv2-role :indexed-transport-not-authority
  :bearer-storage :ephemeral-or-recipient-encrypted-only}
 :kinds
 #{:graph-read :graph-write :infer
   :host/clipboard-read :host/clipboard-write :host/http :host/fs-read
   ;; kbb ADR-2607181900 env/read / capability id 258
   :host/env-read
   ;; kbb ADR-2607181900 fs/browse / capability id 253 (slice 2)
   :host/fs-browse
   ;; kbb ADR-2607181900 proc/exec / capability id 259 (slice 2)
   :host/proc-exec
   :net/connect :crypto/tls :net/transport
   :component/http :component/database
   :secret/use-scram-sha256 :secret/use-postgresql-cancel
   :host/fs-write :host/keychain-read :host/keychain-write :host/notify
   :host/ledger-append :host/graph-assert :host/graph-retract
   :host/graph-get-objects :host/graph-query :host/log-write
   :host/clock-monotonic :host/random-bytes :host/topic-publish
   :host/topic-subscribe :host/pci-config :host/dma-map :host/irq-subscribe
   :host/mmio-map :host/identity-keypair :host/identity-sign
   :host/identity-verify :host/hash-sha256 :host/http-post :host/log-read
   :host/kami-engine :vrm/asset-read :vrm/compose :vrm/preview :vrm/export
   :vrm/publish
   ;; web-wide crawl (com-junkawasaki/root ADR-2607252400)
   :host/cc-cdx-query :host/cc-warc-extract
   :host/corpus-append :host/corpus-publish
   :dataspace/transact}
 :revocation
 {:compile-time "Signed package/module admission checks the current revoked signer set."
  :call-time "Expired or absent delegated grants are denied on every guarded host call."
  :long-running "Hosts must re-authorize at effect time; an admission-time grant is not a perpetual lease."
  :fail-closed true}}
