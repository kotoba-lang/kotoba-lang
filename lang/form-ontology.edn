;; KOTOBA-985 design draft: projecting Kotoba IPLD Form data into a searchable
;; ontology and re-verifying derived facts. This file is a proposal, not an
;; adopted contract. It changes no Definition CID, no payload version and no
;; runtime authority.
;;
;; Boundary being preserved:
;;   lang/pure-form.ipldsch + lang/pure-form.edn  = source Form shape on IPLD
;;   lang/code-identity.edn payload-v2             = checked typed KIR identity
;; A form block CID addresses source; a Definition CID addresses checked meaning.
;; They are different identifiers and this spec never substitutes one for the
;; other.

{:kotoba.lang.form-ontology/version 1
 :kotoba.lang.form-ontology/status :proposed
 :kotoba.lang.form-ontology/as-of "2026-11-27"
 :kotoba.lang.form-ontology/issue "KOTOBA-985"
 :kotoba.lang.form-ontology/authority "kotoba-lang/kotoba-lang"
 :kotoba.lang.form-ontology/design-note "docs/lang/form-ontology-and-derivation.md"
 :provenance
 "Awai OS item #473 handoff (msg_653b0617823f) assigned the stopped KOTOBA-985
  design to KotobaSpec item #486. Linear KOTOBA-985 was Backlog, unassigned,
  with no comments; the earlier chat produced no output. This draft compares
  the design only; implementation needs a named implementer and scope."

 :inputs
 {:form-shape ["lang/pure-form.ipldsch" "lang/pure-form.edn"]
  :checked-identity "lang/code-identity.edn :definition-cid payload-v2"
  :typed-eval "lang/typed-eval.edn"
  :related-proof-plan "KOTOBA-963..965 (Amu Lean 4 SIR proofs; separate proof targets)"}

 :non-goals
 [:payload-v3-or-any-definition-cid-change
  :implementation-of-projection-query-or-verifier
  :authority-or-execution-admission-from-a-cid
  :full-owl-reasoning-or-shacl-conformance-claim
  :production-deploy-or-linear-status-change]

 :identity
 {:entity-iri "Stable IRI for the thing a fact is about. For content-addressed
   Kotoba definitions the IRI is derived from the immutable Definition CID, so
   renaming display metadata does not move the entity. Names stay metadata."
  :version-cid "CID of the versioned content: Definition CID for checked
   definitions, source block CID for IPLD form blocks, rules CID for rule sets,
   evidence CID for review artifacts. A CID is a value, not an authority."
  :evidence "Source CID plus block-internal IPLD path. A CID alone does not
   locate a node inside a block; path segments are map keys, list indexes and
   link boundaries in order."
  :cid-carrier "CID values are strings in EDN specs and IPLD Link values at IPLD
   boundaries. They are never RDF IRIs by themselves."
  :iri-base "https://kotoba-lang.org/ns/kotoba#"
  :keyword-iri "Keyword kotoba/x projects to <https://kotoba-lang.org/ns/kotoba#x>.
   Standard terms keep their W3C IRIs (rdf:type, rdfs:subClassOf, prov:*)."}

 :vocabulary
 {:classes
  [{:id :kotoba/Form
    :version :source-block-cid
    :meaning "An IPLD node conforming to the Form union in pure-form.ipldsch.
     Shape validity is not checked Kotoba."}
   {:id :kotoba/Module
    :version :source-block-cid
    :meaning "A pure-form Module list: ns header plus exported definitions."}
   {:id :kotoba/ProgramVersion
    :version :definition-cid
    :meaning "A checked definition projected for search. Carries the DefCID as
     its version and optional source-form evidence. This is the entity the
     first acceptance query targets."}
   {:id :kotoba/Review
    :version :evidence-cid
    :meaning "A review or approval artifact. Its evidence CID locates the bytes;
     evidencePath locates the reviewed statement inside that block."}
   {:id :kotoba/RuleSet
    :version :rules-cid
    :meaning "A finite, versioned set of inference rules stored as IPLD data."}
   {:id :kotoba/Fact
    :version :fact-cid-or-assertion-id
    :meaning "A reified quad or statement. :kotoba/fact-kind separates asserted
     source facts from derived facts."}
   {:id :kotoba/Derivation
    :version :derivation-cid
    :meaning "Proof that a conclusion follows from premises under a rule set and
     data root. Re-verification recomputes it; it is not an authority grant."}
   {:id :kotoba/InferenceStep
    :version :step-id
    :meaning "One rule application inside a Derivation."}]

  :predicates
  [{:id :kotoba/inBlock :domain :kotoba/Form :range :cid
    :meaning "Block CID containing this form node."}
   {:id :kotoba/blockPath :domain :kotoba/Form :range :ipld-path
    :meaning "Path from the block root to this form node."}
   {:id :kotoba/formKind :domain :kotoba/Form :range :string
    :meaning "Form union discriminant: Bool Int String Bytes Link Call Tagged."}
   {:id :kotoba/formTag :domain :kotoba/Form :range :string
    :meaning "Keyed-union discriminant for tagged maps: sym kw f64 vec set map."}
   {:id :kotoba/definitionCid :domain :kotoba/ProgramVersion :range :cid
    :meaning "payload-v2 Definition CID. Never a form block CID."}
   {:id :kotoba/sourceBlockCid :domain :kotoba/ProgramVersion :range :cid
    :meaning "IPLD source block CID when the definition came from a pure form.
     Absent or marked :legacy/:unknown for non-pure sources."}
   {:id :kotoba/sourceKind :domain :kotoba/ProgramVersion :range :keyword
    :meaning ":pure-form, :legacy-cljk-edn or :unknown. Keeps the Form/DefCID
     boundary visible in the graph."}
   {:id :kotoba/displayName :domain :kotoba/ProgramVersion :range :string
    :meaning "Human-readable name. Metadata only; not identity."}
   {:id :kotoba/dependsOn :domain :kotoba/ProgramVersion :range :kotoba/ProgramVersion
    :meaning "Resolved dependency edge between projected definitions."}
   {:id :kotoba/dependsOnDefinitionCid :domain :kotoba/ProgramVersion :range :cid
    :meaning "The sealed dependency Definition CID from payload-v2, kept even
     when the dependency is not yet projected."}
   {:id :kotoba/reviewedBy :domain :kotoba/ProgramVersion :range :iri
    :meaning "Reviewer identity as an IRI. Identity is not authorization."}
   {:id :kotoba/hasReview :domain :kotoba/ProgramVersion :range :kotoba/Review
    :meaning "Link to the review artifact."}
   {:id :kotoba/evidenceCid :domain :kotoba/Review :range :cid
    :meaning "CID of the evidence bytes."}
   {:id :kotoba/evidencePath :domain :kotoba/Review :range :ipld-path
    :meaning "Path inside the evidence block to the reviewed statement."}
   {:id :kotoba/reviewScope :domain :kotoba/Review :range :cid
    :meaning "CID of what was reviewed: a Definition CID, source block CID or
     rules CID. Scope is explicit so a review cannot be silently widened."}
   {:id :kotoba/validFrom :domain :kotoba/ProgramVersion :range :string
    :meaning "Optional validity start (ISO-8601). Absence means unbounded start."}
   {:id :kotoba/validTo :domain :kotoba/ProgramVersion :range :string
    :meaning "Optional validity end. Revocation is a new root/fact, not an edit
     of history."}
   {:id :kotoba/supersededBy :domain :kotoba/ProgramVersion :range :kotoba/ProgramVersion
    :meaning "Later version that replaces this one, when known."}
   {:id :kotoba/factKind :domain :kotoba/Fact :range :keyword
    :meaning ":asserted for source projection, :derived for rule output,
     :retracted for explicitly withdrawn facts in a later root."}
   {:id :kotoba/subject :domain :kotoba/Fact :range :term
    :meaning "Fact subject: IRI or CID value."}
   {:id :kotoba/predicate :domain :kotoba/Fact :range :iri
    :meaning "Fact predicate IRI."}
   {:id :kotoba/object :domain :kotoba/Fact :range :term
    :meaning "Fact object term."}
   {:id :kotoba/graphRoot :domain :kotoba/Fact :range :cid
    :meaning "Data root CID whose closure the fact was projected from."}
   {:id :kotoba/derivedBy :domain :kotoba/Fact :range :kotoba/Derivation
    :meaning "Derivation that produced this fact, when :fact-kind is :derived."}
   {:id :kotoba/dataRootCid :domain :kotoba/Derivation :range :cid
    :meaning "Data root the premises were read from. Swapping it must fail."}
   {:id :kotoba/ruleSetCid :domain :kotoba/Derivation :range :cid
    :meaning "Rule set version applied. Swapping it must fail."}
   {:id :kotoba/conclusion :domain :kotoba/Derivation :range :kotoba/Fact
    :meaning "The fact this derivation concludes."}
   {:id :kotoba/premise :domain :kotoba/Derivation :range :kotoba/Fact
    :meaning "A premise fact. Premises are re-read from dataRootCid, not trusted
     from the derivation alone."}
   {:id :kotoba/step :domain :kotoba/Derivation :range :kotoba/InferenceStep
    :meaning "Ordered inference steps."}
   {:id :kotoba/ruleRef :domain :kotoba/InferenceStep :range :term
    :meaning "Rule identifier inside ruleSetCid (id plus optional path)."}
   {:id :kotoba/stepPremise :domain :kotoba/InferenceStep :range :kotoba/Fact
    :meaning "Premises consumed by this step."}
   {:id :kotoba/stepConclusion :domain :kotoba/InferenceStep :range :kotoba/Fact
    :meaning "Fact produced by this step."}
   {:id :kotoba/proofFormatVersion :domain :kotoba/Derivation :range :string
    :meaning "Version of the derivation record format, e.g. kotoba/derivation/v1."}]}

 :projection
 {:mapping-version "kotoba/form-ontology/v1"
  :vocabulary-version "kotoba/form-ontology/v1"
  :deterministic "Same dataRootCid + mapping-version + vocabulary-version must
   produce the same fact set. Rebuild is from the root closure, not from a
   previous projection. Updates and revocations enter as a new root; old roots
   remain re-buildable."
  :ipld-form
  [{:when "Every IPLD block reachable from dataRootCid"
    :emit [{:type :kotoba/Form, :inBlock "<block-cid>", :blockPath []}]
    :note "Emit one Form fact per node the query needs; full traversal is
     bounded by the same selector/budget rules as other IPLD reads."}
   {:when "Form union kind is Tagged with a keyed discriminant"
    :emit [{:formTag "<sym|kw|f64|vec|set|map>"}]}
   {:when "Form union kind is Link"
    :emit [{:object "<cid>"}]
    :note "A link is a CID value. Do not treat it as a Definition CID."}]
  :checked-definition
  [{:when "A checked typed KIR definition is admitted under code-identity.edn"
    :emit [{:type :kotoba/ProgramVersion
            :definitionCid "<payload-v2 DefCID>"
            :sourceBlockCid "<pure-form block CID or absent>"
            :sourceKind "<pure-form|legacy-cljk-edn|unknown>"
            :displayName "<namespace/name metadata>"
            :dependsOnDefinitionCid "<each payload-v2 dependency CID>"}]
    :note "Dependencies come from the sealed payload-v2 dependency list. A
     dependency CID is kept as a CID even before the dependency is projected."}
   {:when "A review artifact is admitted with an evidence CID and scope"
    :emit [{:type :kotoba/Review :evidenceCid "<cid>" :evidencePath "<path>"
            :reviewScope "<reviewed CID>"}
           {:type :kotoba/ProgramVersion :reviewedBy "<reviewer-iri>"
            :hasReview "<review>"}]}]
  :derived-facts
  [{:when "A rule in ruleSetCid fires on facts read from dataRootCid"
    :emit [{:type :kotoba/Fact :factKind :derived :derivedBy "<derivation>"}]
    :note "Only rule output is :derived. Source projection facts are :asserted.
     A fact is never marked derived without a Derivation record."}]}

 :derivation
 {:record "kotoba/derivation/v1"
  :required-fields [:dataRootCid :ruleSetCid :conclusion :premise :step
                    :proofFormatVersion]
  :step-fields [:ruleRef :stepPremise :stepConclusion]
  :rules-start
  [{:id :type-inheritance/v1
    :kind :subclass
    :premise ["?x rdf:type ?sub", "?sub rdfs:subClassOf ?super"]
    :conclusion "?x rdf:type ?super"
    :note "Finite rule over asserted and already-derived facts. The example in
     KOTOBA-985 is ProgramVersion(x) with ProgramVersion subClassOf Artifact
     deriving Artifact(x)."}]
  :reverification
  "Recompute the conclusion from dataRootCid and ruleSetCid. Accept only if the
   recomputed fact set contains the conclusion and every step's premises are
   present in that root or earlier steps. Reject when dataRootCid, ruleSetCid
   or any premise is swapped, when a step cites a rule outside ruleSetCid, or
   when proofFormatVersion is unknown."
  :not-proven
  "A Derivation proves the stated rule application over the stated data and
   rules. It does not prove the source program correct, the rules sound, the
   reviewer authorized, or the definition executable."}

 :verification-layers
 [{:layer :L0-bytes-cid
   :checks "CID/digest verification of blocks; IPLD Schema shape for Form;
    SHACL-like required-field checks where a profile declares them."
   :guarantee "Bytes are the addressed bytes and forms have the pinned shape.
    Not checked Kotoba, not DefCID, not authority."}
  {:layer :L1-projection-determinism
   :checks "Rebuild fact set from dataRootCid + mapping-version +
    vocabulary-version; compare fact-set identity."
   :guarantee "Same inputs give same facts; updates/revocations are visible as
    a new root. Does not prove the mapping is the right ontology."}
  {:layer :L2-derivation-reverification
   :checks "Recompute Derivation conclusions; negative controls swap data root,
    rule set CID and premises."
   :guarantee "The stated derivation is valid for the stated inputs. Does not
    prove rule soundness or source truth."}
  {:layer :L3-program-proof-connection
   :checks "Future: bind DefCID, typed KIR semantics and SIR/machine-code proofs
    from KOTOBA-963..965 as separate proof targets."
   :guarantee "Deferred. This spec only fixes which CID is the version and which
    CID is evidence; it claims no KIR/SIR/target equivalence."}]

 :acceptance
 {:ac1-program-version-review-query
  "From one fixed root, a query returns a ProgramVersion's dependency CIDs and
   its Review evidence CID/path together. See form-ontology-conformance/positive."
  :ac2-deterministic-rebuild
  "Same root + mapping + vocabulary rebuilds the same fact set; a later root
   reflects update/revocation. See positive/deterministic_rebuild.edn."
  :ac3-derivation-reverification
  "One type-inheritance Derivation re-verifies; swapped dataRootCid,
   ruleSetCid or premise is rejected. See positive/type_inheritance_derivation.edn
   and negative/swapped_*.edn."
  :ac4-verification-layer-record
  "This file's :verification-layers and :boundary record the adopted layer and
   its limits, and name the Form grammar, DefCID and SIR proof plan it touches."
  :boundary-check "A form block CID used where a Definition CID is required is
   rejected. See negative/form_cid_as_defcid.edn."}

 :implementation-scope
 {:status :needs-owner-assignment
  :spec-owner "KotobaSpec"
  :candidate-implementers
  [{:repo "kotoba-lang/kotoba" :area "IPLD/CID codecs, datom/graph ingest, host providers"}
   {:repo "kotoba-lang/kcp" :area "Kotobase datomic/graph query surface"}
   {:repo "network-awai-apex" :area "Awai query/UI surface and file-format profiles"}
   {:repo "kotoba-lang/amu" :area "typed KIR / DefCID producer (existing)"}]
  :note "This issue is design + conformance record only. Naming the implementer
   and the first slice is a separate decision; no product code changes here."}}
