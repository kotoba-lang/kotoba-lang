;; CI5 — the receipt names a weaker guard than the component boundary allows.
;; guard-ability-call skips component admission, and for a request that is not
;; a capability value it falls through to guard-call, skipping the effect gate.
{:receipt {:format :kotoba.wit-package/v1
           :target :wasm-component-kotoba-v1
           :imports [:component/http]
           :host-binding {:contract :kotoba.component.host-binding/v1
                          :required-guard :guard-ability-call
                          :imports {:component/http :guard-ability-call}}}
 :handler-imports [:component/http]}
