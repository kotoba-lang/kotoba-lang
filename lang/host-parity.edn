 :acceptance
 {:browser-linkable-statuses #{:yes :coop-or-inject :inject}
  :min-browser-ratio 0.0
  :honest-gaps [:global-browser-parity-10-of-59
                :deferred-provider-components-38
                :llm-infer-browser-absent :http-post-needs-coop-or-inject
                :http-get-requires-finite-quota-and-https-scope
                :scram-secret-provider-browser-absent
                :tls-channel-binding-browser-absent]}

 ;; L5: declarative cross-host conformance. A fixture is pure data; runners
 ;; (kotoba.lang.host-parity/run-conformance) assert expected availability.
 ;; Rule: host status :no => :capability-absent (never ambient success).
 :conformance
 {:schema :kotoba.lang.host-conformance/v1
  :rule "missing host import == capability absence"
  :linkable-statuses #{:yes :coop-or-inject :inject}
  ;; T8.4 expansion (2026-07-28): critical crypto/http/log/random/kagi/transport
  ;; fixtures. :component-link is intentionally NOT linkable here (provider
  ;; packaging gap) — guests must treat those as capability-absent until AOT.
  ;; T8.4: pg wire/SCRAM/pool are :inject (linkable) via fail-closed providers.
  :cases
  [;; ── crypto / hash (all hosts) ─────────────────────────────────────
   {:id :sha256-hex-all-available
    :import :sha256-hex :hosts [:jvm :browser :node] :expect :available}
   {:id :gen-keypair-all-available
    :import :gen-keypair :hosts [:jvm :browser :node] :expect :available}
   {:id :sign-all-available
    :import :sign :hosts [:jvm :browser :node] :expect :available}
   {:id :verify-all-available
    :import :verify :hosts [:jvm :browser :node] :expect :available}
   {:id :random-bytes-all-available
    :import :random-bytes :hosts [:jvm :browser :node] :expect :available}
   {:id :clock-monotonic-all
    :import :clock-monotonic :hosts [:jvm :browser :node] :expect :available}
   {:id :log-read-all-available
    :import :log-read :hosts [:jvm :browser :node] :expect :available}
   {:id :log-write-all-available
    :import :log-write :hosts [:jvm :browser :node] :expect :available}

   ;; ── kagi (decision-aware; browser native boundary) ────────────────
   {:id :kagi-sign-jvm-available
    :import :kagi-sign :host :jvm :expect :available}
   {:id :kagi-sign-browser-absent
    :import :kagi-sign :host :browser :expect :capability-absent
    :note "intentional native boundary — key never enters browser guest"}
   {:id :kagi-sign-node-inject-available
    :import :kagi-sign :host :node :expect :available
    :note "node :inject counts as linkable"}

   ;; ── HTTP surface ──────────────────────────────────────────────────
   {:id :http-post-jvm-available
    :import :http-post :host :jvm :expect :available}
   {:id :http-post-browser-linkable
    :import :http-post :host :browser :expect :available
    :note "coop-or-inject counts as available for linkability"}
   {:id :http-post-node-linkable
    :import :http-post :host :node :expect :available}
   {:id :http-get-browser-inject-available
    :import :http-get :host :browser :expect :available
    :note "browser :inject"}
   {:id :http-get-jvm-component-link-absent
    :import :http-get :host :jvm :expect :capability-absent
    :note "jvm :component-link not in linkable-statuses until signed AOT packaging"}
   {:id :http-get-node-component-link-absent
    :import :http-get :host :node :expect :capability-absent
    :note "node :component-link same honesty as jvm until AOT"}

   ;; ── transport / TLS native boundary on browser ────────────────────
   {:id :transport-connect-browser-absent
    :import :transport-connect :host :browser :expect :capability-absent}
   {:id :transport-connect-jvm-inject-available
    :import :transport-connect :host :jvm :expect :available}
   {:id :tls-open-browser-absent
    :import :tls-open :host :browser :expect :capability-absent}
   {:id :tls-open-jvm-inject-available
    :import :tls-open :host :jvm :expect :available}
   {:id :tls-server-end-point-browser-absent
    :import :tls-server-end-point :host :browser :expect :capability-absent}
   {:id :tls-server-end-point-jvm-available
    :import :tls-server-end-point :host :jvm :expect :available}

   ;; ── LLM ───────────────────────────────────────────────────────────
   {:id :llm-infer-jvm-available
    :import :llm-infer :host :jvm :expect :available}
   {:id :llm-infer-browser-absent
    :import :llm-infer :host :browser :expect :capability-absent}
   {:id :llm-infer-node-available
    :import :llm-infer :host :node :expect :available
    :note "node status is :inject — still linkable under inject opts"}

   ;; ── SCRAM / cancel native boundary ────────────────────────────────
   {:id :scram-sha256-browser-absent
    :import :scram-sha256 :host :browser :expect :capability-absent}
   {:id :scram-sha256-jvm-available
    :import :scram-sha256 :host :jvm :expect :available}
   {:id :pg-cancel-browser-absent
    :import :pg-cancel :host :browser :expect :capability-absent}
   ;; ── T8.4 pg wire/SCRAM/pool inject (jvm/node linkable; browser absent) ──
   {:id :pg-open-jvm-inject-available
    :import :pg-open :host :jvm :expect :available
    :note "T8.4 wire fail-closed inject"}
   {:id :pg-open-browser-absent
    :import :pg-open :host :browser :expect :capability-absent}
   {:id :pg-open-scram-jvm-inject-available
    :import :pg-open-scram :host :jvm :expect :available}
   {:id :pg-open-scram-browser-absent
    :import :pg-open-scram :host :browser :expect :capability-absent}
   {:id :pg-prepare-jvm-inject-available
    :import :pg-prepare :host :jvm :expect :available}
   {:id :pg-execute-batch-jvm-inject-available
    :import :pg-execute-batch :host :jvm :expect :available}
   {:id :pg-pool-open-jvm-inject-available
    :import :pg-pool-open :host :jvm :expect :available}
   {:id :pg-pool-open-browser-absent
    :import :pg-pool-open :host :browser :expect :capability-absent}
]}

 :runtime-hosts
 {:kototama-tender {:host :jvm :repo "kotoba-lang/kototama"}
  :wasm-webcomponent {:host :browser :repo "kotoba-lang/wasm-webcomponent"}
  :node-actor-host {:host :node :repo "kotoba-lang/wasm-webcomponent"}}}
