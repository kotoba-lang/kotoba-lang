;; Clojure namespaces a `.cljc` module can keep requiring after it moves to
;; Kotoba, and -- as loudly as what is provided -- what is deliberately NOT
;; here.
;;
;; A shim is only worth having if it is exact. Kotoba's string surface is
;; addressed in UTF-8 bytes (`string-length` of "aあb" is 5; `string-code-point-at`
;; takes a byte offset; a split index REFUSES rather than returning something
;; wrong -- all measured 2026-08-31). Three of `clojure.string`'s functions are
;; indifferent to that. The rest are not, and providing them approximately
;; under their real names would answer, quietly, wrong.
;;
;; Where such a function is worth having anyway, it lives here under a
;; DIFFERENT name in a `kotoba.*` namespace, saying in the name what it
;; actually answers -- `kotoba.string/byte-index-of` for the byte-offset half
;; of `clojure.string/index-of`. The absent entry then points at it, so the
;; reason and the replacement are one lookup apart. A caller reaching for the
;; Clojure name has to stop and change the call, which is the moment to notice
;; that the number means something else now.
;;
;; Consumed through the ordinary project route, which needs no JVM:
;;   amu check app.cljk --source-path <app> --source-path <this repo>/lang/compat --jvm-free
{:kotoba.lang.compat/version 1
 :kotoba.lang.compat/authority "kotoba-lang/kotoba-lang"
 :kotoba.lang.compat/workspace-adr
 "90-docs/adr/2608311750-cljk-migration-cost-is-not-effects.edn"

 :measured
 {:as-of "2026-08-31"
  :string-length-is :utf8-bytes
  :evidence "(string-length \"aあb\") = 5, (string-byte-length \"aあb\") = 5, (string-code-point-at \"aあb\" 1) = 12354, (string-substring \"aあb\" 1 2) refused with \"string substring index splits a UTF-8 code point\""
  :oracle "clojure.string itself, called from the test on the same 16 inputs; 48 of 48 comparisons agree"}

 :modules
 {:clojure.string
  {:path "lang/compat/clojure/string.kotoba"
   :provides #{starts-with? ends-with? includes?}
   :equivalence :exact
   :costs {:ends-with? "walks the haystack once by code point to find whether the suffix begins on a boundary; recursion here is fuel-bounded like any other guest recursion"}
   :hazards
   {:substring-prefix "(string-substring \"あ\" 0 1) refuses, so a substring-based starts-with? TRAPS where the answer is false. Compared by code point instead."
    :empty-needle "string-contains? refuses an empty needle (empty-string-search-needle) where clojure.string answers true, which is why includes? is not an alias."}
   :absent
   {index-of
    {:reason "clojure.string returns a CHARACTER index; every index in Kotoba is a UTF-8 byte offset. The two agree on ASCII and diverge silently on anything else, which is the failure this file exists to avoid."
     :what-would-be-needed "a character-index abstraction, or an honestly-named byte-offset function in a kotoba.* namespace"
     :resolved "2026-09-01, by the second of those: kotoba.string/byte-index-of. Nothing named index-of is added to this module -- a name that promises Clojure semantics and delivers byte offsets is the defect, not the fix. A character-index abstraction is still absent; nothing in this workspace has yet needed one."
     :instead kotoba.string/byte-index-of}
    last-index-of
    {:reason "same index question as index-of."
     :what-would-be-needed "the same choice index-of took, scanning from the end. Not written because no call site measured in this workspace needs it; the shape is kotoba.string/byte-index-of's."}
    blank?
    {:reason "clojure.string tests Character/isWhitespace over the whole Unicode whitespace set. An ASCII-only answer differs on U+3000, which is not a corner case in this workspace."}
    trim
    {:reason "same Unicode whitespace question as blank?, and it returns a string, so the divergence propagates instead of staying in a predicate."}
    triml {:reason "same as trim."}
    trimr {:reason "same as trim."}
    lower-case
    {:reason "clojure.string case-folds over Unicode. An ASCII-only fold answers for every input and is wrong for most of them."}
    upper-case {:reason "same as lower-case."}
    capitalize {:reason "same as lower-case, plus the first-character question."}
    split
    {:reason "returns a sequence, and takes a regex; neither the return type nor the pattern surface exists here yet."}
    split-lines {:reason "same sequence return as split."}
    join
    {:reason "consumes a sequence. Expressible once a list type crosses this boundary; not expressible against the string surface alone."}
    replace
    {:reason "takes a regex or a string; the regex arity has no counterpart, and providing only the string arity under the same name would accept a pattern and do the wrong thing."}
    replace-first {:reason "same as replace."}
    reverse
    {:reason "clojure.string reverses by character. Byte reversal would corrupt every multi-byte code point."}}}

  ;; Not a Clojure namespace. The honest counterpart to one of the absent
  ;; names above, under a name that says which kind of index it answers.
  :kotoba.string
  {:path "lang/compat/kotoba/string.kotoba"
   :provides #{byte-index-of}
   :replaces {byte-index-of clojure.string/index-of}
   :equivalence :byte-offset-not-character-index
   :measured
   {:as-of "2026-09-01"
    :oracle "a naive search over (.getBytes s \"UTF-8\") written independently of the Kotoba source, in test/kotoba/lang/kotoba_string_compat_test.clj; 28 inputs, all agreeing, 18 of them with a multi-byte haystack"
    :divergence "(byte-index-of \"aあb\" \"b\") = 4 where (clojure.string/index-of \"aあb\" \"b\") = 2; asserted, not assumed, so the argument for the name cannot quietly evaporate"
    :route "amu check <entry> --source-path <app> --source-path lang/compat --jvm-free, exit 0, module-order [kotoba.string app]"
    :executed "not only lowered: compiled to wasm32 (2,279 bytes, exit 0, JVM-free), instantiated through amu runtime/browser-host.mjs, main() = 4n for (byte-index-of \"a\u3042b\" \"b\") and 3n for (byte-index-of \"\u3042a\" \"a\"). wasm32-browser also compiles (2,292 bytes)."}
   :costs
   {:byte-index-of "a naive scan: every code-point boundary of the haystack in turn, and at each one a code-point-by-code-point compare until the needle ends or a pair differs -- O(haystack code points x needle code points) steps worst case, and one string-code-point-at per compared code point. Recursion here is fuel-bounded like any other guest recursion."}
   :hazards
   {:no-contains-precheck "string-contains? would short-circuit an absent needle, but it answers the same question by a second mechanism; if the two ever disagreed this function would return -1 while a match existed. One slower mechanism beats two that must agree."
    :empty-needle "answers 0, matching clojure.string/index-of, and handled before the scan because string-contains? refuses an empty needle."
    :self-synchronising "the scan only looks at code-point boundaries, and that loses nothing: a valid UTF-8 needle begins with an ASCII byte or a lead byte, never a continuation byte, so a byte-level occurrence cannot start inside a code point."}}}}
