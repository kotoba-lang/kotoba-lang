    lower-case {:reason "see :modules :kotoba.string :absent lower-case."}
    upper-case {:reason "see :modules :kotoba.string :absent upper-case."}
    capitalize {:reason "see :modules :kotoba.string :absent capitalize."}
    split {:reason "see :modules :kotoba.string :absent split."}
    split-lines {:reason "see :modules :kotoba.string :absent split-lines."}
    replace {:reason "PROVIDED in kotoba.string as of 2026-09-12, and deliberately NOT forwarded here: kotoba.string/replace answers s for an empty match (kotoba.lang.text's answer, the library it is the guest half of), where clojure.string/replace with an empty string match would interleave -- (clojure.string/replace \"abc\" \"\" \"x\") is \"xaxbxcx\" on both hosts. A forwarder under THIS name would answer that one input wrong. See :modules :kotoba.string :provided-not-in-clojure-string replace."}
