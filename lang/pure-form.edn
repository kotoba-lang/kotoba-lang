;; The spelling of pure `.kotoba` (JUN-950). Decided here; not implemented.
;; docs/adr/ADR-target-portable-canonical-form.md section 2.1 explains why.
;;
;; A form that a reader does not find below is sugar or undecided: it belongs to
;; the `.cljk` and `.edn` surfaces, or to :undecided.
{:kotoba.lang.pure-form/version 1
 :kotoba.lang.pure-form/status :decided-not-implemented
 :kotoba.lang.pure-form/decided-on "2026-11-07"
 :kotoba.lang.pure-form/provenance
 "Owner decision D2 sets the direction: pure, IPLD, Unison-like. The owner then
  asked for the spelling to be settled, and these choices were made under that
  instruction. Each stays open to change by a later decision."
 :kotoba.lang.pure-form/data-model-schema "lang/pure-form.ipldsch"
 :kotoba.lang.pure-form/identity
 {:definition-cid "lang/code-identity.edn, over checked typed KIR, unchanged"
  :form-block-cid "A form's block has a CID like any block. It addresses source and is never a Definition CID."
  :payload-v3 :undecided}

 ;; A spelling is sugar when it has the same Definition CID as a spelling below.
 ;; Measured on amu origin/main 1754ff26f; see
 ;; docs/evidence/target-portable-core-20261107/README.md.
 :sugar-test
 {:same-cid-measured [[(-> 1 g g) (g (g 1))]
                      [(inc 1) (+ 1 1)]
                      [(not= 1 2) (not (= 1 2))]
                      [(cond (< 1 2) 1 :else 0) (if (< 1 2) 1 0)]
                      [(defn- h [] :i64 1) (defn h [] :i64 1)]
                      [(loop [i 0] (if (= i 3) i (recur (+ i 1))))
                       "(def lp (lam [i :i64] :i64 (if (= i 3) i (lp (+ i 1))))) and a call of lp"]]
  :different-cid-measured [[(+ 1 2 3) (+ (+ 1 2) 3)]
                           [(+ 1 2 3) (+ 1 (+ 2 3))]
                           [(and a b) (if a b false)]
                           [(and a b) (let [t a] (if t b t))]]}

 :reader
 {:admitted ["( )" "[ ]" "{ }" "#{ }" "string" "integer" "decimal float" "symbol" "keyword" "; comment"]
  :refused ["#?" "#(" "#_" "'" "`" "~" "@" "^" "\\"]
  :not-in-the-form [:comments :whitespace :source-spans]}

 :module
 {:shape "(ns NAME (:export [...]) (:require ...) (:capabilities #{...}) (:schemas {...}))"
  :replaces ["{:kotoba/export [...]} and the other ns attribute maps"]
  :visibility "Being listed in :export. defn- has no pure spelling."}

 :forms
 {def {:shape "(def NAME VALUE)"}
  lam {:top-level "(lam [x T ...] R BODY), with every parameter and the result annotated"
       :inner "(lam [x ...] BODY), never annotated; the type comes from the context"
       :why "Position decides, so each meaning has one spelling, and a definition's source shows its interface."}
  let {:shape "(let [x E ...] BODY)" :body-forms 1 :binder :simple-symbol}
  if {:shape "(if TEST THEN ELSE)"}
  do {:shape "(do FORM ...)"}
  and {:shape "(and A B)" :why "No other spelling measured has its Definition CID."}
  or {:shape "(or A B)" :why "As and."}
  call {:shape "(f a ...)" :rule "A named head is written as prefix."}
  app {:shape "(app OPERATOR a ...)" :rule "Only for a computed operator."}
  ref {:shape "(ref \"bafy...\")"
       :rule "Reads the definition with that CID and is a Link in the Data Model. A name is a bare symbol, so (ref name) and fn-ref have no pure spelling."}
  handle {:shape "(handle BODY (catch e HANDLER))" :with [throw] :profile :kotoba-core}
  perform {:shape "(perform :ns/op v ...)" :profile :kotoba-cap}
  rel {:shape "(rel e a v)" :profile :kotoba-cap :decision :D6}
  query {:shape "(query e a)" :profile :kotoba-cap :decision :D6}}

 :iteration
 {:spelling "A tail-recursive def. Tail calls are proper."
  :why "loop lowers to a helper with the same Definition CID as the tail-recursive def."}

 :operators
 {:arithmetic "Binary (+ a b) on :i64. A float operation is named, as in (f64-add a b)."
  :variadic :sugar-its-desugar-contract-is-undecided}

 :data
 {:records "A [:record ...] descriptor, usually [:ref :ns/name] from (:schemas), with record-new and three-argument record-get"
  :variants "variant-new and variant-match with a descriptor"
  :options-results "option-* and result-* builtins"
  :closed-literals "A closed [...], {...} or #{...} is written as that literal. Other values use constructors."
  :multi-arity "One def per arity, each with its own name and type"
  :sugar [defrecord ->T map->T defprotocol definterface extend-type extend-protocol defmulti defmethod
          variadic-defn destructuring match case when when-not if-let when-let if-some when-some
          cond -> ->> some-> as-> doseq dotimes try loop recur inc dec not= defn defn- fn-ref
          defdesugar document]}

 ;; Each entry is on the IPLD Data Model. lang/pure-form.ipldsch pins the shape.
 :data-model
 {:list-form {:kind :list :example "(+ 1 2) -> [{\"sym\" \"+\"} 1 2]"}
  :integer {:kind :int :range :i64 :why "DAG-CBOR assumes the signed 64-bit range."}
  :string {:kind :string :encoding :utf-8}
  :true-false {:kind :bool}
  :nil {:kind :null :position "Inside lists and entries. Null is not a kinded-union kind."}
  :bytes {:kind :bytes}
  :cid {:kind :link}
  :symbol {:kind :map :form {"sym" "name"} :why "The Data Model has no symbol kind."}
  :keyword {:kind :map :form {"kw" "name"} :why "The Data Model has no keyword kind."}
  :f64 {:kind :map :form {"f64" "8 bytes, big-endian IEEE-754"}
        :why "The Data Model excludes NaN and infinities and advises avoiding Float."}
  :vector {:kind :map :form {"vec" []} :why "Distinguishes it from a call."}
  :set {:kind :map :form {"set" []} :order :encoded-element-bytes-unsigned}
  :map {:kind :map :form {"map" [["key" "value"]]} :order :encoded-key-bytes-unsigned
        :why "A form's map key can be any form. DAG-CBOR map keys are strings."}}

 :ipld-layers
 {:data-model "Every pure form has the representation above."
  :schema "lang/pure-form.ipldsch pins source shape. It does not pin checkedness; the checker does (root adr-2609076000 decision 4)."
  :adl "Not part of the grammar. A layout is declared in a schema with `representation advanced` and implemented by a module pinned by CID at the existing ADL boundary."}

 :undecided
 [:state-ability-with-and-resume :dataspace :typed-eval-form :local-state-atom :variadic-arithmetic-desugar
  :payload-v3 :record-schema-as-ipld-schema-mapping :link-and-bytes-in-the-document-type]}
