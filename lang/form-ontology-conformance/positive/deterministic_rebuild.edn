;; AC2: rebuilding the fact set from the same root, mapping version and
;; vocabulary version yields the same facts. A new root is a new fact set; it
;; is not an in-place edit of the old one.

{:kotoba.lang.form-ontology.case/id :positive-deterministic-rebuild
 :kotoba.lang.form-ontology.case/kind :accept
 :kotoba.lang.form-ontology.case/acceptance :ac2-deterministic-rebuild
 :data-root-cid "bafyreigqeocmakhluccfdbaylvuypgapm3fzfui4ras6hniuzzgkxrxgbm"
 :mapping-version "kotoba/form-ontology/v1"
 :vocabulary-version "kotoba/form-ontology/v1"

 :rebuild
 {:from :data-root-cid
  :with [:mapping-version :vocabulary-version]
  :must-produce :same-fact-set}

 :update
 {:new-root-cid "bafyreickqt3r773jzwo5sfhz2da47svc3apzqvemstzeldbsbxxr4l5fvi"
  :meaning "A later root that adds or revokes a fact. It must rebuild to a
   different fact set while the old root remains rebuildable."}

 :expect
 {:verdict :accept
  :fact-set-equal-to "positive/program_version_review_query.edn"
  :update-fact-set :must-differ
  :old-root :must-remain-rebuildable
  :note "Determinism is a property of (dataRootCid, mapping-version,
   vocabulary-version). It does not claim the mapping is the right ontology."}}
