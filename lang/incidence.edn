{:kotoba.lang.incidence/version 1
 :model :content-addressed-incidence
 :identity
 {:codec :dag-cbor
  :cid-version 1
  :hash :sha2-256
  :order-insensitive #{:incidence/roles
                       :incidence/parents
                       :incidence/evidence
                       :incidence/policies}
  :integrity-is-not-authority true}
 :block
 {:required #{:incidence/kind
              :incidence/roles
              :incidence/facts
              :incidence/parents
              :incidence/evidence
              :incidence/policies}
  :unknown-top-level-fields :reject
  :roles {:key :keyword
          :participants [:non-empty-set :typed-ref]}
  :typed-ref
  {:cid :immutable-internal-identity
   :did :interoperable-principal-identifier
   :uri :external-resource-identifier}}
 :history
 {:form :immutable-dag
  :edges :incidence/parents
  :append-rule :all-parents-known
  :state :verified-projection}
 :coordination
 {:model :syndicate-dataspace
  :assertion :addressed-incidence
  :retraction {:kind :dataspace/retracted
               :target :assertion-cid
               :semantics :monotonic-tombstone}
  :observation {:query :inert-edn
                :match [:kind :role-participant]
                :callbacks :runtime-layer}
  :facet-lifecycle
  {:state :inert-edn
   :owner :typed-ref
   :assert :addressed-incidence
   :duplicate-assert :idempotent
   :stop :single-targeted-retraction
   :duplicate-stop :idempotent
   :publish :capability-guarded-runtime-effect}
  :publication
  {:port :lexically-injected-append-function
   :effect :host/ledger-append
   :resource :exact-dataspace-string
   :input :verified-addressed-incidence
   :admission [:declared-effect :verified-delegation :local-policy]
   :provider-receives :concrete-post-intersection-capability
   :attempt-receipt :required
   :transport :adapter}}
 :organization
 {:root-kind :organization/constitution
  :kinds #{:person :agent :organization :system}
  :identity :constitution-incidence-cid
  :membership {:add :organization/member-added
               :remove :organization/member-removed
               :conflict-model :observed-remove-set
               :remove-target :member-added-cid}}
 :adapters
 {:holochain {:source-chain-action :incidence-block
              :action-hash :incidence-cid
              :previous-action :incidence/parents}
  :valueflows {:economic-event :incidence-block
               :provider-receiver-resource :incidence/roles}
  :syndicate {:assertion :incidence-block
              :withdrawal :targeted-incidence}
  :ucan {:issuer :grantor
         :audience :grantee
         :capability-resource :resource
         :proof-chain :incidence/evidence}
  :zcap {:controller :grantor
         :invocation-target :resource
         :parent-capability :incidence/parents}
  :w3c-vc {:issuer :issuer
           :credential-subject :subject
           :credential-evidence :incidence/evidence}
  :w3c-did {:identifier [:ref/type :did]}}
 :security
 {:cid-means :integrity
  :cid-does-not-mean #{:authentication :authorization :delegation-validity}
  :effect-admission
  [:verify-signature-and-proof-chain
   :intersect-delegation-with-local-policy
   :mint-concrete-capability-value
   :guard-host-effect]
  :unverified-external-object :data-only
  :data-authority-separation
  {:edn :inert-data
   :tagged-capability-literal :forbidden
   :capability-reference :runtime-admitted-value
   :lexical-possession :authority-upper-bound
   :ambient-jvm-authority :forbidden
   :macro-expansion :pure-or-rejected}
  :ocap
  {:target :ordinary-unforgeable-runtime-reference
   :current-enforcement
   #{:typed-capability-value :affine-use :effect-row
     :delegation-local-policy-intersection :host-guard}
   :serializable-as-edn false
   :remote-reference-protocol :runtime-adapter
   :candidate :ocapn}}}
