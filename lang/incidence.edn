{:kotoba.lang.incidence/version 1
 :model :content-addressed-incidence
 :identity
 {:codec :dag-cbor
  :cid-version 1
  :hash :sha2-256
  :order-insensitive #{:incidence/roles
                       :incidence/parents
                       :incidence/evidence
                       :incidence/policies}
  :integrity-is-not-authority true}
 :block
 {:required #{:incidence/kind
              :incidence/roles
              :incidence/facts
              :incidence/parents
              :incidence/evidence
              :incidence/policies}
  :unknown-top-level-fields :reject
  :roles {:key :keyword
          :participants [:non-empty-set :typed-ref]}
  :typed-ref
  {:cid :immutable-internal-identity
   :did :interoperable-principal-identifier
   :uri :external-resource-identifier}}
 :history
 {:form :immutable-dag
  :edges :incidence/parents
  :append-rule :all-parents-known
  :state :verified-projection}
 :coordination
 {:model :syndicate-dataspace
  :assertion :addressed-incidence
  :retraction {:kind :dataspace/retracted
               :target :assertion-cid
               :semantics :monotonic-tombstone}
  :observation {:query :inert-edn
                :match [:kind :role-participant]
                :callbacks :runtime-layer}
  :replication
  {:model :verified-cid-set-union
   :consensus false
   :ingest :bounded-atomic-hash-verification
   :orphans :retain-and-request-missing-parents
   :anti-entropy {:inventory :stable-bounded-cid-pages
                  :pull-order [:missing-parent :other-unknown]
                  :export :exact-known-cids}
   :projection :requires-complete-parent-closure
   :convergence :order-independent-set-union
   :durability-quorum
   {:input :opaque-verified-readbacks
    :distinct-by :authenticated-peer
    :same-binding #{:dataspace :incidence-cid
                    :constitution-cid :issuer-did}
    :threshold :lexical-policy
    :output :opaque-replication-certificate
    :does-not-prove #{:physical-medium :retention-period
                      :byzantine-consensus}}}
  :facet-lifecycle
  {:state :inert-edn
   :owner :typed-ref
   :assert :addressed-incidence
   :duplicate-assert :idempotent
   :stop :single-targeted-retraction
   :duplicate-stop :idempotent
   :publish :capability-guarded-runtime-effect}
  :publication
  {:port :lexically-injected-append-function
   :effect :host/ledger-append
   :resource :exact-dataspace-string
   :input :verified-addressed-incidence
   :admission [:declared-effect :verified-delegation :local-policy]
   :verified-delegation :opaque-host-admitted-runtime-value
   :provider-receives :concrete-post-intersection-capability
   :attempt-receipt :required
   :transport
   {:kind :adapter
    :ocapn {:profile "ocapn-captp-1.0-draft-2026-08-15"
            :session :opaque-authenticated-runtime-value
            :reference :opaque-session-bound-live-reference
            :operation :op/deliver
            :payload [:method :dataspace :incidence-cid
                      :canonical-dag-cbor-bytes]
            :wire :canonical-syrup-bounded-preserves-profile
            :session-lifecycle [:starting :active :aborted]
            :single-active-session :per-peer-lexical-registry
            :sturdyref-resolution :requires-live-resolver-capability
            :delivery-modes
            {:enqueue-only {:answer-position false
                            :resolve-me false
                            :receipt-means :local-session-enqueue}
             :settled-result
             {:runtime-authority :opaque-captp-runtime
              :runtime-owns #{:resolver :answer-position
                              :promise-settlement :answer-gc
                              :import-export-wire-count-gc}
              :receipt-kind :dataspace/append-durable
              :receipt-binding [:dataspace :incidence-cid]
             :receipt-means :authenticated-remote-durability-claim
              :receipt-does-not-prove :physical-persistence}
             :signed-readback
             {:runtime-authority :opaque-readback-verifier
              :operation :append-incidence-readback
              :statement-kind :dataspace/signed-readback
              :statement-binding
              #{:dataspace :incidence-cid :readback-cid
                :constitution-cid :issuer-did :authenticated-peer
                :session-transcript-cid :one-shot-challenge
                :issued-at-ms :expires-at-ms :verification-method}
              :proof-purpose :assertionMethod
              :freshness {:clock :injected-capability
                          :challenge :injected-one-shot-capability
                          :maximum-age :lexical-policy}
              :success :opaque-verified-readback
              :serialized-lookalike :rejected
              :receipt-means :fresh-organization-signed-readback-claim
              :receipt-does-not-prove :independent-physical-persistence}}
            :implemented-directional
            {:outbound #{:op/start-session :op/deliver
                         :op/gc-answers :op/gc-exports :op/abort}
             :inbound #{:op/deliver-to-resolver :op/gc-exports :op/abort}}
            :deferred-operations
            #{:op/listen :op/get :op/tag :op/untag
              :third-party-handoff :promise-pipelining}
            :netlayer-owns
            #{:reliable-in-order-channel :channel-encryption
              :session-key-generation
              :start-session-signature-verification}}}}}
 :organization
 {:root-kind :organization/constitution
  :kinds #{:person :agent :organization :system}
 :identity :constitution-incidence-cid
  :external-identity
  {:did :constituent-typed-ref
   :resolution-and-proof :injected-verifier-capability
   :verification-relationship :assertionMethod
   :admission :opaque-verified-organization-binding
   :binds #{:constitution-cid :organization-kind :did
            :authorized-session-peers :verification-method
            :binding-evidence-cid}}
 :membership {:add :organization/member-added
               :remove :organization/member-removed
               :conflict-model :observed-remove-set
               :remove-target :member-added-cid}
  :governance
  {:policy {:kind :organization/governance-policy
            :identity :policy-incidence-cid
            :binds #{:constitution-cid :governors :threshold :actions}}
   :proposal {:kind :organization/proposal
              :binds #{:policy-cid :payload-cid :action :conflict-key}}
   :approval {:kind :organization/approval
              :proof :external-evidence-cid
              :admission :opaque-verified-approval
              :binds #{:approval-cid :proposal-cid :constitution-cid
                       :governor :evidence-cid}}
   :enactment {:kind :organization/enacted
               :requires :distinct-verified-governor-threshold
               :output :opaque-enacted-decision
               :publishable :addressed-incidence}
   :concurrency {:same-proposal :collapse-certificates
                 :same-conflict-key :explicit-branch-conflict
                 :wall-clock-winner :forbidden
                 :total-order :external-consensus-adapter}}}
 :adapters
 {:holochain {:source-chain-action :incidence-block
              :action-hash :incidence-cid
              :previous-action :incidence/parents}
  :valueflows {:economic-event :incidence-block
               :provider-receiver-resource :incidence/roles}
  :syndicate {:assertion :incidence-block
              :withdrawal :targeted-incidence}
  :ucan {:issuer :grantor
         :audience :grantee
         :capability-resource :resource
         :proof-chain :incidence/evidence
         :admission :opaque-verified-delegation
         :adapter :kotoba.lang.interop-verifiers/ucan-delegation-verifier
         :verifier-owns #{:envelope-decoding :signature-verification
                          :proof-chain-resolution :expiry-validation}
         :kotoba-enforces #{:closed-result-shape :exact-audience
                            :attenuation :bounded-depth
                            :bounded-resources :kotoba-capability-uri}}
  :zcap {:controller :grantor
         :invocation-target :resource
         :parent-capability :incidence/parents}
  :w3c-vc {:issuer :issuer
           :credential-subject :subject
           :credential-evidence :incidence/evidence
           :proof-type :DataIntegrityProof
           :proof-purpose :assertionMethod
           :admission :opaque-verified-organization-binding}
  :w3c-did {:identifier [:ref/type :did]
            :verification-relationship :assertionMethod
            :adapter :kotoba.lang.interop-verifiers/did-vc-organization-binding-verifier
            :verifier-owns #{:did-resolution :status-checking
                             :json-ld-processing :cryptosuite-verification}
            :kotoba-enforces #{:bounded-methods :bounded-subjects
                               :bounded-authorized-peers
                               :did-document-id :method-controller
                               :assertion-method :cryptosuite-allowlist
                               :proof-purpose :constitution-cid}}}
 :security
 {:cid-means :integrity
  :cid-does-not-mean #{:authentication :authorization :delegation-validity}
  :effect-admission
  [:verify-signature-and-proof-chain
   :mint-opaque-verified-delegation
   :intersect-delegation-with-local-policy
   :mint-concrete-capability-value
   :guard-host-effect]
  :unverified-external-object :data-only
  :data-authority-separation
  {:edn :inert-data
   :tagged-capability-literal :forbidden
   :capability-reference :runtime-admitted-value
   :lexical-possession :authority-upper-bound
   :ambient-jvm-authority :forbidden
   :macro-expansion :pure-or-rejected}
  :trusted-admission
  {:delegation-input :opaque-verified-delegation
   :session-input :opaque-authenticated-session
   :organization-binding-input :opaque-verified-organization-binding
   :signed-readback-output :opaque-verified-readback
   :governance-approval-input :opaque-verified-approval
   :governance-enactment-output :opaque-enacted-decision
   :replication-quorum-output :opaque-replication-certificate
   :serialized-proof :inert-evidence
   :boolean-authenticated :rejected
   :caller-constructed-grants :rejected}
  :ocap
  {:target :ordinary-unforgeable-runtime-reference
   :current-enforcement
   #{:typed-capability-value :affine-use :effect-row
     :delegation-local-policy-intersection :host-guard}
   :serializable-as-edn false
   :remote-reference-protocol :runtime-adapter
   :candidate :ocapn}}}
