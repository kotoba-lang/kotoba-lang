{:kotoba.lang.pure-product-profile/version 1
 :kotoba.lang.pure-product-profile/status :accepted
 :kotoba.lang.pure-product-profile/adr "docs/adr/ADR-product-value-abi-v1.md"
 :kotoba.lang.pure-product-profile/summary
 "Surface that pure-product oracles may use must execute on product KIR (wasm32-kotoba-v1 + kotoba.kir/execute)."

 :value-types
 #{:i64 :string :bool
   [:option :i64] [:option :string] [:option :bool]
   :keyword
   ;; T4.4 dual-backend pilot: homogeneous i64→i64 maps (compiler#426)
   [:map :i64 :i64]}

 :control-sugar
 #{if when cond case if-some when-some match-option
   if-let when-let if-not when-not and or}

 :string-ops
 #{string-concat string-join string=? string-substring string-byte-length
   string-length string-from-i64 string-contains? string-split-count string-fold-case
   string-code-point-at}
 ;; string-join: sep + ≤8 parts → nested string-concat (compiler T4.2 / ADR 0162)
 ;; string-split-count: T4.2 dual-backend (compiler#427); full string-split collection deferred

 :typed-map-ops
 #{typed-map-new typed-map-count typed-map-contains typed-map-get
   typed-map-assoc typed-map-dissoc typed-map-equal typed-map-entry-at}
 ;; Evidence: compiler#426 / ADR 0176 dual-backend pilot on [:map :i64 :i64]

 :forbidden-patterns
 ["has-* :i64 sentinels for optional strings when [:option :string] works"
  "ttl -1 sentinel when [:option :i64] works"
  "base-65536 public packs when a small record/hetero-vector export is available"
  "hardcoded if-some to [:option :i64] only"]

 :execution
 {:compile-target :wasm32-kotoba-v1
  :artifact :kir
  :runner "kotoba.kir/execute"
  :note "Production murakumo oracles ship precompiled KIR; compiler is test/gen only."}


 :admission
 {:compiler-flag :language-profile
  :value :pure-product
  :rules
  ["reject ns :capabilities"
   "reject cap-call"
   "require empty effects after analyze"
   "reject pure-product-disallowed sugar (doseq/dotimes/defmulti/…)"
   "product KIR + wasm32-kotoba-v1 must execute admitted surface"]
  :semantics "docs/lang/semantics-ssot.md §5 Pure-product profile"}

 :examples
 ["examples/product-value-abi-v1/claim_sub.kotoba"]
 :structural-args
 {:wbs "T5.1"
  :adr "docs/adr/ADR-reliability-t51-structural-args.md"
  :preference [:record :option :hetero-vector :flat-arity<=5]
  :forbidden-new-public-packs true
  :max-parameters 5
  :max-parameters-policy "keep-5-use-records"
  :max-parameters-adr "docs/adr/ADR-reliability-t54-max-parameters.md"
  :note "New pure-product public APIs prefer records/options over base-N packs or arity growth. T5.4: do not raise max-parameters without a new security ADR."}
}
