;; kotoba.lang.code-identity — frozen definition-CID test vectors (CI1).
;;
;; CI1's admission rule is "byte-for-byte deterministic identity". These
;; vectors are that rule made checkable: kotoba.lang.code-identity-test
;; recomputes every :canonical-hex and :definition-cid below and fails if
;; any one moves. They are also the cross-implementation reference for CI6.
;;
;; DO NOT hand-edit a hash to make a test pass. A changed identity means
;; either a real semantic change (bump :payload-version and regenerate) or
;; a bug in the canonical encoding.
;;
;; Regenerate:  clojure -M -e "(load-file \"scripts/gen_code_identity_fixtures.clj\")"

{:kotoba.lang.code-identity-vectors/version 1
 :payload-version 3
 :codec :dag-cbor
 :multihash :sha2-256
 :vectors
 [
  {:id :pure-const
   :note "The minimal closed pure definition: no dependencies, no effects."
   :definition #:definition{:profile-version 4, :desugar-contract-version 1, :kir {:op :const, :value 1}, :effect-row #{}, :interface {:arity 0, :result :i64}, :dependencies []}
   :canonical-hex ""
   :definition-cid "bafyreiewl2qfij35g3byq4bozuz3p3qekxqp5pao3ftywhbhuu7xfoqiwu"}

  {:id :effect-row-http
   :note "Same KIR as :pure-const but requiring http authority — MUST NOT share its identity."
   :definition #:definition{:profile-version 4, :desugar-contract-version 1, :kir {:op :const, :value 1}, :effect-row #{:host/http}, :interface {:arity 0, :result :i64}, :dependencies []}
   :canonical-hex ""
   :definition-cid "bafyreifqszjusrbr3lwrgra7g3dh6xbsg6mnmiqfbgibwmqrh7cpevla5i"}

  {:id :effect-row-two
   :note "Effect row members are a set: source order is not semantic."
   :definition #:definition{:profile-version 4, :desugar-contract-version 1, :kir {:op :const, :value 1}, :effect-row #{:host/clock-monotonic :host/http}, :interface {:arity 0, :result :i64}, :dependencies []}
   :canonical-hex ""
   :definition-cid "bafyreigu4dyifru26bjf24llcdv6lquboqzliuvlzi43qlgvm2ufdys4gu"}

  {:id :desugar-contract-2
   :note "Same KIR, later desugar contract — identity must move."
   :definition #:definition{:profile-version 4, :desugar-contract-version 2, :kir {:op :const, :value 1}, :effect-row #{}, :interface {:arity 0, :result :i64}, :dependencies []}
   :canonical-hex ""
   :definition-cid "bafyreifod2hrqmwqgl4yorsa7ig4yogb2joaj4awxzl7yquebgqinqvkbq"}

  {:id :profile-5
   :note "Same KIR, later profile version — identity must move."
   :definition #:definition{:profile-version 5, :desugar-contract-version 1, :kir {:op :const, :value 1}, :effect-row #{}, :interface {:arity 0, :result :i64}, :dependencies []}
   :canonical-hex ""
   :definition-cid "bafyreiauecnqaoveormzcij4awlnilesxjib6lwtfatfztxzmgwi3s46ii"}

  {:id :interface-arity-1
   :note "The declared interface participates in identity."
   :definition #:definition{:profile-version 4, :desugar-contract-version 1, :kir {:op :const, :value 1}, :effect-row #{}, :interface {:arity 1, :params [:i64], :result :i64}, :dependencies []}
   :canonical-hex ""
   :definition-cid "bafyreid6azo6pj6utnfpne3ksxscia4qs3kyetgydb7lhh7yu4baaxttom"}

  {:id :dependencies-two
   :note "Direct definition dependencies participate; their order does not."
   :definition #:definition{:profile-version 4, :desugar-contract-version 1, :kir {:op :const, :value 1}, :effect-row #{}, :interface {:arity 0, :result :i64}, :dependencies ["bafyreiavgzqi4f5li6tit3qqxixqaiqrgn7v4djk4kczdbnup67bediviy" "bafyreiho6mssyvojsh2yp7fjzoehhfwzwwdako5lnvyz2owmzb3267s6hm"]}
   :canonical-hex ""
   :definition-cid "bafyreiegiibcppxausjr33xbuuddeprbcalzlmnyokf7o7norhymtjnlrm"}

  {:id :kir-nested-collections
   :note "Exercises every branch of the canonical domain: nil, bool, big int, string, keyword, symbol, vector, list, set, map."
   :definition #:definition{:profile-version 4, :desugar-contract-version 1, :kir {:op :do, :forms [{:op :const, :value nil} {:op :const, :value true} {:op :const, :value #:kotoba.lang.code-identity{:i64 "9007199254740993"}} {:op :const, :value #:kotoba.lang.code-identity{:i64 "-9007199254740993"}} {:op :const, :value "text"} {:op :const, :value :a-keyword} {:op :const, :value a-symbol} {:op :vec, :items [1 2 3]} {:op :list, :items (1 2 3)} {:op :set, :items #{:y :x}} {:op :map, :entries {:k "v", 1 :one}}]}, :effect-row #{}, :interface {:arity 0, :result :i64}, :dependencies []}
   :canonical-hex ""
   :definition-cid "bafyreibqhkrbuvdievbttzva4wxes6as4up52nezehv5u3bwkyvq6gyiru"}

  {:id :kir-f64
   :note "f64 literals travel as exact IEEE-754 bits, never as a platform float."
   :definition #:definition{:profile-version 4, :desugar-contract-version 1, :kir {:op :const, :type :f64, :value #:kotoba.lang.code-identity{:f64 "3ff8000000000000"}}, :effect-row #{}, :interface {:arity 0, :result :i64}, :dependencies []}
   :canonical-hex ""
   :definition-cid "bafyreidwqtpvhorgzx7dkjkbju2lvdtwmwh3zpry4zm77fehi36jsncqoq"}

  {:id :kir-keyword-vs-string
   :note "A keyword and the string of the same name are distinct identity inputs."
   :definition #:definition{:profile-version 4, :desugar-contract-version 1, :kir {:op :pair, :a :name, :b "name"}, :effect-row #{}, :interface {:arity 0, :result :i64}, :dependencies []}
   :canonical-hex ""
   :definition-cid "bafyreieprzcxv652jrhovpfp5jdn3w267llkx5k2eyohtmmmqpvd4iku4a"}]}
