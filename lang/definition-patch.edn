{:kotoba.lang.definition-patch/version 1
 :kotoba.lang.definition-patch/status :implemented
 :kotoba.lang.definition-patch/authority "kotoba-lang/kotoba-lang"
 :kotoba.lang.definition-patch/decision
 "docs/adr/ADR-kotoba-definition-patch-share.md"
 :kotoba.lang.definition-patch/identity "lang/code-identity.edn"
 :kotoba.lang.definition-patch/facade
 "src/kotoba/lang/definition_patch.cljc"

 ;; The hasher is consumed, not reimplemented. Ports pin is 94f03a58
 ;; (green run https://github.com/kotoba-lang/kotoba-lang/actions/runs/33647273774).
 ;; 45795b6c, 61e5e79c, 245493fc, and 48d7d3cb are historical only, not the live pin.
 :hasher
 {:authority :kotoba.kir/definition-identity
  :payload-version 2
  :facade "src/kotoba/lang/code_identity.cljc"
  :implementation "kotoba.kir.definition-identity"
  :repo "kotoba-lang/kotoba-kir"
  :refused :kotoba.codebase/typed-code}

 :unit
 {:interchange :definition-cid-ops-and-name-mappings
  :not #{:source-file-copy :source-tree-bytes :source-tree-cid
         :typed-code-cid :wasm-artifact-cid}}

 :identity-is-not-authority
 {:definition-cid :identity
  :patch-apply :name-binding-only
  :does-not-grant [:code-eval :capability :wit-world-admission
                   :package-lock-admission :host-eval]}

 :ops #{:add :replace :remove}

 :parallel-hasher
 {:status :second-implementation-to-be-migrated
  :namespace :kotoba.codebase/typed-code
  :rule :fail-closed
  :measured-cids-are-not-definition-cids
  ;; Copied from lang/code-identity.edn :identity-implementations
  ;; :measured-difference :cases, 2026-09-02. These strings identify the
  ;; typed-code algorithm, not payload-v2 :definition-cid.
  #{"bafyreihetwjs6fjj63z5zqnho7befbvw2h5igtmvujuaaiqfnjrg5uq7yq"
    "bafyreibsdyuxvctmdtocmrwidacdflmq7disy7h2oogvsf4u2hyye75gcq"}
  :unknown-typed-code-cid-without-payload :unmeasured
  :payload-rehash :authority-facade-only}

 :not-a-unison-clone
 {:source :clojure-shaped
  :execution :wasm-component-first
  :packages :cid-edn
  :copied-unison-source false}

 :unmeasured
 [:network-transport
  :kotobase-persistence
  :concurrent-patch-merge
  :patch-document-cid
  :cljs-apply-share-parity]

 :non-goals
 [:unison-syntax
  :global-unison-codebase
  :second-hasher
  :typed-code-interchange
  :source-tree-cid-as-unit
  :host-eval
  :load-string
  :reader-eval
  :guest-grammar-rewrite
  :typed-eval-rewrite
  :hold-lift]}
