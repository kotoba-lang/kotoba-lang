# The pure Kotoba source form on the IPLD Data Model.
#
# One form per Data Model kind where a kind exists. What the Data Model has no
# kind for is a single-entry map, so the schema itself discriminates every
# node. This pins shape only. Being valid here is not being checked Kotoba, and
# a form's block CID is not its Definition CID.
#
# Null is not a representation kind for a kinded union, so nil is nullable
# inside lists and entries, and a bare nil is not a top-level form.

type Form union {
  | Bool bool
  | Int int
  | String string
  | Bytes bytes
  | Link link
  | Call list
  | Tagged map
} representation kinded

type Call [nullable Form]
type Module [Form]

type Tagged union {
  | Symbol "sym"
  | Keyword "kw"
  | F64 "f64"
  | Vector "vec"
  | FormSet "set"
  | FormMap "map"
} representation keyed

type Symbol string
type Keyword string
type F64 bytes
type Vector [nullable Form]
type FormSet [nullable Form]
type FormMap [Entry]

type Entry struct {
  key nullable Form
  value nullable Form
} representation tuple
