 {:TB1 {:summary "Abolishes arbitrary 65,536-byte app cap via 4-layer limit separation and >= 512 KiB..1 MiB Docs profile default (8 MiB ceiling)."
        :spec-refs [[:limit-layers :native-runtime-ceiling]
