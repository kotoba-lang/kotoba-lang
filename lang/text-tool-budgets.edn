;; KOTOBA-989 / PR #897 Spec-Gap Escalation: Native Docs & Text-Processing Tool
;; Input Size and Memory Budget Policy (v1 proposed).
;;
;; Separates compile-time literal bounds (`lang/limits.edn` :language/static),
;; portable cross-backend value bounds (`lang/limits.edn` :language/value),
;; native runtime ceilings (`8 MiB` value / `256 MiB..1 GiB` pool), and
;; application-level DoS budgets (`:tool-profiles`).
;;
;; Mutates NO existing lang/limits.edn v1 entries in this proposal; records
;; cross-repo audit findings and Decision Gate D1 aligned with AmuSpec Item #593.

{:kotoba.lang.text-tool-budgets/version 1
 :kotoba.lang.text-tool-budgets/status :proposed
 :kotoba.lang.text-tool-budgets/as-of "2026-11-27"
 :kotoba.lang.text-tool-budgets/issue "KOTOBA-989"
 :kotoba.lang.text-tool-budgets/authority "kotoba-lang/kotoba-lang"
 :kotoba.lang.text-tool-budgets/design-note "docs/lang/text-builder-and-tool-budgets.md"

 :principle
 {:statement
  "Per superproject adr-2609242100 (lang/limits.edn), what a program may DO is
   language; how much it may USE and how it is STOPPED is the target profile.
   Application tools MUST NOT hardcode arbitrary 65,536-byte input cliffs that
   conflate static string-literal bounds with runtime document/file budgets."
  :adr "adr-2609242100-kotoba-safety-is-language-resource-is-target-profile"
  :grammar-distinction "lang/guest-grammar.edn:175 (`a longer string is a value a function builds, or a file a capability reads`)"}

 :limit-layers
 {:language-static-literals
  {:string-literal-bytes 65536
   :module-string-literal-bytes 65536
   :max-source-bytes 8388608
   :authority "lang/limits.edn v1 :language/static & lang/guest-grammar.edn :admission-limits"
   :role "Static compile-time code/literal bounds only; never a runtime document cap."}
  :language-value-portable
  {:string-value-bytes 65536
   :bytes-value-bytes 65536
   :document-utf8-bytes 65536
   :boundary-traversal-bytes 1048576
   :authority "lang/limits.edn v1 :language/value & :language/boundary"
   :observed-cross-repo-drift
   "AmuSpec static audit (kotoba@bab283448, amu@87ec570a, kotoba-lang@86478b60)
    found that kotoba/lib/kotoba.osaho/src/kotoba/kir/value.cljk:9-36 already
    raised `string-value-byte-limit` and `bytes-value-byte-limit` to 8,388,608
    (8 MiB) on 2026-10-02 (amu ADR 0362, keeping `string-literal-byte-limit`
    at 65536), whereas lang/limits.edn v1, lang/guest-grammar.edn (all 3 sites),
    xml.cljk:438 (#?(:kotoba)), core.cljk:752, nbb/cli.cljk:463,
    admission_test.cljk:176-227, ios-aot-artifact.edn:1, browser-host.mjs, and
    kotoba_android_host.h:15 remain at 65536."
   :role "Cross-backend portable value bounds (KIR, ESM, Wasm, native). Kept unchanged in lang/limits.edn v1 pending Decision Gate D1."}
  :native-runtime-ceiling
  {:value-max-bytes 8388608
   :string-pool-default-bytes 65536
   :string-pool-linux-runner-bytes 268435456
   :string-pool-address-space-max-bytes 1073741824
   :fs2-kind-8-9-value-max-bytes 8388608
   :env-override-audit
   "AmuSpec verified that current selfhost runtimes (`amu/seed/76,77,82,macos`)
    do NOT read the `KEXE_STRING_POOL` environment variable (so
    `site/native/build_support.py:47,53`'s `KEXE_STRING_POOL=268435456` env var
    is ignored; Linux static-rt uses its hardcoded `KXRT-POOL = 268435456`).
    Additionally, macOS Mach-O pool exhaustion currently traps via raw `brk #0`
    (`SIGTRAP`) instead of structured `KEXE_TRAP` + exit `120`."
   :sources
   ["amu/src/kotoba/compiler/runner_cap_dispatch.cljk:79 (KEXE_BYTES_VALUE_LIMIT = 8388608)"
    "amu/seed/76-x86_64-static-rt.kotoba:51,55 (KXRT-POOL = 268435456, KXRT-VALUE-MAX = 8388608; KEXE_STRING_POOL env unread)"
    "amu/seed/macos-fs2-runtime-packager.kotoba:5 (MAX-FS2-VALUE = 8388608; KEXE_STRING_POOL env unread; raw brk #0 on exhaustion)"
    "kotoba/lib/kotoba.osaho/src/kotoba/kir/value.cljk:9-36 (string/bytes-value-byte-limit = 8388608 since 2026-10-02)"
    "kotoba-lang/site/native/build_support.py:47,53 (sets KEXE_STRING_POOL=268435456)"
    "kotoba-lang/lang/limits.edn:307-308 (KEXE_STRING_POOL override contract up to 1073741824)"]
   :role "Actual native binary capacity envelope when running bounded native tools."}
  :tool-profile-budgets
  {:authority "lang/text-tool-budgets.edn (this file)"
   :role "Explicit, fail-closed, application-declared DoS bounds sized for real documents while staying well inside native-runtime-ceiling."}}

 :decision-gates
 {:D1-portable-string-value-bound
  {:status :owner-gate-open-at-amuspec-item-593
   :amuspec-alignment "AmuSpec concurs with :option-a and holds the single owner decision gate on AmuSpec Item #593 (do not duplicate owner prompt from KotobaSpec)."
   :question "Should lang/limits.edn :language/value :string-value-bytes remain 65536 (v1) while >64 KiB outputs use :text-builder chunks and native tool profiles, or be raised in a coordinated cross-repo v2 wave?"
   :recommended :option-a
   :options
   {:option-a
    {:label "Keep lang/limits.edn v1 at 65536; route >64 KiB through :text-builder chunks & native tool budgets"
     :pros
     ["Zero breaking change to lang/limits.edn v1, kotoba.lang.limits-test, or amu value_bounds_agreement_test"
      "Protects core.cljk:752, nbb/cli.cljk:463, admission_test.cljk:176-227, ios-aot-artifact.edn:1, browser-host.mjs, and kotoba_android_host.h:15"
      "Works identically on Wasm/ESM/KIR via text-builder-finish-chunks and FS2 kind 10/11 chunked I/O"
      "Native Docs/CLI tools immediately handle >= 512 KiB..1 MiB inputs (up to 8 MiB native ceiling) without lowering portable :document-utf8-bytes guardrails"]
     :cons
     ["Cross-backend portable programs exceeding 64 KiB output must call text-builder-finish-chunks or chunked :io/write instead of single-string text-builder-finish"
      "3-way drift against kotoba.osaho value.cljk (8 MiB) must still be explicitly documented as host/runtime ceiling vs portable v1 bound"]}
    :option-b
    {:label "Coordinated lang/limits.edn v2 raise of :string-value-bytes (e.g. 65536 -> 1048576 or 8388608)"
     :pros ["Single :string values above 64 KiB become valid on every portable backend, reconciling osaho/value.cljk 8 MiB drift"]
     :cons
     ["Requires synchronized updates across kotoba-lang (limits.edn, guest-grammar.edn), kotoba (xml.cljk:438), kotoba-script, kotoba-verifier, and amu (core.cljk:752, nbb/cli.cljk:463, admission_test.cljk:176-227, ios-aot-artifact.edn:1, browser-host.mjs, kotoba_android_host.h:15, tools/kexe_loader_boundary.kotoba, value_bounds_agreement_test, seed/runtime/document-runtime.json)"
      "Blocked on owner ruling in AmuSpec Item #593 and Amu runtime fixes (KEXE_STRING_POOL env wiring & macOS KEXE_TRAP)"]}}}}

 :tool-profiles
 {:docs-static-renderer
  {:applies-to ["site/native/docs_page.kotoba" "test/site/native/docs_page_file.kotoba" "site/native/check_docs.py"]
   :max-single-input-bytes
   {:default 1048576
    :min-floor 524288
    :hard-ceiling 8388608
    :note "1 MiB default (>= 512 KiB practical floor, eliminating the 65,536-byte cliff for 16-22 language matrices); hard-capped at 8 MiB native KXRT-VALUE-MAX / max-source-bytes."}
   :max-single-output-bytes
   {:default 4194304
    :hard-ceiling 8388608
    :chunked-stream-max-chunk 65536
    :note "Up to 4 MiB rendered HTML under native single-output budget, or arbitrary bounded streaming in <= 64 KiB chunks via text-builder-finish-chunks / :io/write."}
   :max-inline-nesting-depth 6
   :required-refusal-controls
   [{:name :positive-above-legacy-64kib
     :input-bytes 131072
     :expected :accept
     :why "Proves the legacy 65,536-byte app cliff is removed for multi-byte UTF-8 Markdown."}
    {:name :input-above-profile-limit
     :input-bytes 1048577
     :expected :refuse-fail-closed
     :exit-code 7
     :stdout-bytes 0
     :why "Proves bounded DoS protection triggers cleanly at max-single-input-bytes + 1."}
    {:name :utf8-boundary-preservation
     :expected :accept
     :why "Preserves multi-byte UTF-8 scalar boundaries across slices and chunk splits."}
    {:name :raw-html-escaped
     :expected :accept
     :why "Raw HTML syntax is escaped as text."}
    {:name :unsafe-link-refused
     :expected :refuse-fail-closed
     :exit-code 7}]}

  :cli-text-tool
  {:applies-to ["Native formatters, linters, indexers, static-site generators"]
   :max-single-input-bytes
   {:default 8388608
    :chunked-above 8388608
    :fs2-contract :string-byte-chunks-v1
    :note "Single-read tools bounded at 8 MiB; larger inputs MUST use FS2 kind-10 :string-byte-chunks-v1."}
   :max-single-output-bytes
   {:default 8388608
    :chunked-above 8388608
    :fs2-contract :byte-chunks-v1
    :note "Larger outputs MUST stream via text-builder-finish-chunks / :io/write or FS2 kind-11 :byte-chunks-v1."}}}

 :memory-and-concurrency-guardrails
 {:M1-metadata-body-separation
  {:rule "A single-page renderer MUST NOT load all M full chapter bodies into one `:document` vector solely to read `# title` for navigation/TOC/pager."
   :offending-pattern "test/site/native/docs_page_file.kotoba:5-11 reads and SHA-256 hashes all 14 (15 in PR #897) full Markdown files per single page render, violating :document-utf8-bytes = 65536 and scaling total build I/O+hash work as O(M^2 * N)."
   :required-pattern "Stage a lightweight `docs-index.edn` containing only `[slug title source-relpath source-sha256]` per entry (< 4 KiB aggregate, well within :document-utf8-bytes = 65536) and read + SHA-256 verify ONLY the single active chapter file."}

  :M2-linear-pool-and-arena-hygiene
  {:rule "Per-page peak string-pool allocation MUST scale linearly O(N) with active document bytes `N` and transient work MUST run inside `(arena-scope ...)`."
   :budgets
   {:tier-1-text-builder "peak_string_pool_bytes <= 16 * N + 262144 (256 KiB baseline overhead)"
    :tier-0-interim-chunked "peak_string_pool_bytes <= 64 * N + 524288 (512 KiB baseline overhead)"}
   :arena-scope-rule "Per-file SHA-256 input digest checks (returning :bool) and transient metadata validation MUST stay wrapped in `(arena-scope ...)`."}

  :M3-host-concurrency-budget
  {:rule "Parallel worker execution of native binaries MUST bound worker count `J` against available host RAM and measured per-worker peak RSS."
   :incident-basis "On 2026-11-27 18:18 JST, running 3x parallel `entry.macho` workers on coordinator host `jacob` drove swap usage to 93.9% because lazily faulted native arenas amplify O(N^2) touches into physical RSS."
   :formula "J = max(1, min(requested_jobs, floor(ram_budget_mib / max(1, measured_peak_rss_per_worker_mib))))"
   :host-policy
   {:coordinator-zone-b "Default `--jobs 1` on coordinator/constrained hosts (`jacob`); never launch heavy parallel native builds there."
    :heavy-build-zone-a "Route parallel native builds (`--jobs > 1`) to Zone A (`21mbp`, per ops/host-topology.md) within measured RSS budget."}}}

 :migration-targets
 {:note "Tracked for follow-up AFTER PR #897 lands; NO product files edited in this spec PR."
  :targets
  [{:file "site/native/docs_page.kotoba"
    :lines "16-18,60-73,104-132,160 (PR #897 line 192)"
    :change "Replace remainder-copy `find` with `string-index-of-from`, move `inline`/`markdown` from O(N^2) `string-concat` to Tier-0 interim (now) / `:text-builder` (KOTOBA-989), and raise source bound from 65,536 to `:docs-static-renderer :max-single-input-bytes` (1,048,576)."
    :migration-guardrails
    ["Keep `(if (or (< i 0) (> i (size s))) -1 ...)` around `string-index-of-from` in `find` (`docs_page.kotoba:16-18`): callers pass `(+ end 1)` past EOF when a file lacks a trailing newline, and `string-index-of-from` traps if `from > len` (AmuSpec audit)."
     "Do NOT touch `docs_page.kotoba:9` (`(< c 65536)`): that constant is the UTF-8 BMP (`U+10000`) 3-byte vs 4-byte code-point width threshold, NOT a 64 KiB buffer limit."]}
   {:file "test/site/native/docs_page_file.kotoba"
    :lines "5-11"
    :change "Read lightweight `docs-index.edn` for TOC/pager and verify + load only the target page's Markdown source."}
   {:file "site/native/docs_build.py"
    :lines "11-16,64-69"
    :change "Stage `docs-index.edn` alongside pins and enforce M3 worker RAM budget."}
   {:file "site/native/check_docs.py"
    :lines "140-141"
    :change "Update `source-size-bound` negative control to 1,048,577 bytes and add positive control for >64 KiB UTF-8 Markdown (131,072 bytes)."}]}

