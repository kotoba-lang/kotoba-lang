  :TB3 {:summary "Enforces host worker concurrency RAM/RSS guardrails preventing swap exhaustion (M3)."
        :spec-refs [[:memory-and-concurrency-guardrails :M3-host-concurrency-budget]]
        :conformance [:positive-docs-tool-large-input-within-budget]}
  :TB4 {:summary "Preserves lang/limits.edn v1 invariance via Decision Gate D1 Option A while documenting Option B cross-repo requirements."
        :spec-refs [[:decision-gates :D1-portable-string-value-bound :options :option-a]
