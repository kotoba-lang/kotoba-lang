;; Required compiler capability inventory. Preserve all twelve entries.
;; This data alone grants no authority and proves no provider qualification.
;; The old hosted scoreboard/drivers are retired; see
;; docs/native-selfhost-harness-retirement.md for their corpus/provenance.
;; The current contract requires Amu selfhost-produced native artifacts for
;; check/build/packaging/execution. Node/NBB/KBB/JVM and C-loader handlers
;; are not fallback routes.
;; Exact sealed native providers, source/lock pins and positive/refusal/
;; authority/resource behavior must be qualified for the whole compiler.
{:allow #{[:cap/call :cli/args]
          [:cap/call :clock/now]
          [:cap/call :entropy/draw]
          [:cap/call :env/read]
          [:cap/call :fs/app-data]
          [:cap/call :fs/browse]
          [:cap/call :hash/sha256]
          [:cap/call :io/read]
          [:cap/call :io/write]
          [:cap/call :io/write-error]
          [:cap/call :process/spawn]
          [:cap/call :sys/cwd]}}
