{:kotoba.lang.code-identity/version 1
 :kotoba.lang.code-identity/status :proposed
 :kotoba.lang.code-identity/authority "kotoba-lang/kotoba-lang"
 :kotoba.lang.code-identity/decision
 "docs/adr/ADR-kotoba-code-identity-and-abilities.md"
 :kotoba.lang.code-identity/execution-boundary
 "90-docs/adr/2607252500-kotoba-wasm-component-first-execution-boundary.edn"
 :kotoba.lang.code-identity/migration
 "docs/kotoba-centered-migration-plan.md"
 :kotoba.lang.code-identity/workspace-adr
 "90-docs/adr/2607279200-kotoba-clojure-shaped-safety-elaboration-migration.edn"

 :identities
 {:source-tree-cid
  {:proves :authored-input
   :does-not-prove [:typed-semantics :authority :component-equivalence]}
  :definition-cid
  {:status :planned
   :canonical-input [:typed-kir :profile-version :desugar-contract-version
                     :effect-row :interface :direct-definition-dependencies]
   :excludes [:source-formatting :package-name :git-ref :wasm-compiler-incidental-output]
   :scope :closed-deterministic-pure-definition
   :note "Identity is computed after desugar, type/effect checking, and ability elaboration."}
  :component-cid
  {:proves :reproducible-wasm-artifact
   :requires [:toolchain-profile :build-evidence]}
  :component-admission
  {:status :planned
   :requires [:component-cid :wit-world-cid :target-identity :resource-limits]
   :owner :kototama
   :rule "Only kototama may link an admitted component; definition identity alone never authorizes instantiation."}
  :package-manifest-cid
  {:proves :signed-package-declaration
   :binds [:repo-rid :source-tree-cid :capability-requests :dependency-locks]}}

 :ability
 {:definition "Unforgeable resource-scoped capability value consumed by a provider call."
  :source-model "Ordinary named operations; numeric IDs and portable envelopes are elaboration targets."
  :requires [:effect-row :narrow-wit-import :target :operation-bounds
             :runtime-capability-intersection :receipt]
  :does-not-grant [:ambient-authority :unchecked-provider-access]
  :affinity :capability-boundary-only}

 :elaboration-order
 [:closed-reader
  :bounded-pure-desugar
  :name-module-resolution
  :type-schema-inference
  :interprocedural-effect-inference
  :implicit-ability-elaboration
  :typed-hir-kir
  :definition-cid
  :restricted-esm-or-wasm-component
  :host-grant-policy-provider-binding]

 :link-invariant
 [:typed-ability-effect
  :declared-wasm-import
  :locked-definition-or-component-identity
  :kototama-wit-world-target-and-limit-admission
  :policy-and-delegation-intersection
  :tender-binding
  :provider-resource-revalidation
  :receipt]

 :non-goals
 [:unison-syntax
  :global-codebase-namespace
  :general-effect-handlers
  :broad-wasi-grants
  :ordinary-app-native-aot
  :runtime-eval
  :ambient-loading
  :ambient-io
  :implicit-durable-execution
  :framework-specific-application-dsl]

 :stages
 {:ci0 :contract
  :ci1 :canonical-typed-kir-and-vectors
  :ci2 :pure-definition-manifest-and-fixtures
  :ci3 :negative-identity-fixtures
  :ci4 :safe-build-lock-verification
  :ci5 :typed-ability-host-abi
  :ci6 :cross-implementation-conformance
  :ci7 :friendly-source-operation-elaboration}

 :implementation
 {:ci0 {:status :implemented
        :evidence ["docs/adr/ADR-kotoba-code-identity-and-abilities.md"
                   "lang/code-identity.edn"
                   "docs/kotoba-centered-migration-plan.md"]}
  :ci1 {:status :pending
        :remaining "Canonical typed-KIR encoding and definition-CID test vectors after elaboration."}
  :ci2 {:status :pending
        :remaining "Pure definition export/import manifest fields and positive fixtures."}
  :ci3 {:status :pending
        :remaining "Negative fixtures for hash/profile/interface/dependency mismatch."}
  :ci4 {:status :pending
        :remaining "Safe-build verifies definition identity against package lock."}
  :ci5 {:status :partial
        :evidence ["src/kotoba/lang/capability_values.cljc"
                   "src/kotoba/lang/capability_host.cljc"]
        :remaining "Compiler WIT lowering must exclusively select guard-component-ability-call for effectful imports."}
  :ci6 {:status :pending
        :remaining "Cross-implementation identity/WIT/revocation/receipt conformance."}
  :ci7 {:status :pending
        :remaining "Friendly source operations elaborate to the same typed ability/effect KIR across project and single-source builds."}}}
