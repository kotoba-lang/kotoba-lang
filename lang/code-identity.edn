 :identities
 {:source-tree-cid
  {:proves :authored-input
   :does-not-prove [:typed-semantics :authority :component-equivalence]}
  :definition-cid
  {:status :implemented
   :implementation "src/kotoba/lang/code_identity.cljc"
   :payload-version 2
   :canonical-input [:typed-kir :profile-version :desugar-contract-version
                     :effect-row :interface :direct-definition-dependencies]
   :excludes [:source-formatting :package-name :git-ref :wasm-compiler-incidental-output]
   :scope :closed-deterministic-pure-definition
   :codec :dag-cbor
   :multihash :sha2-256
   :note "Identity is computed after desugar, type/effect checking, and ability elaboration."
   ;; Payload version 1 sealed only profile-version, typed-kir, interface and
   ;; dependencies, and addressed pr-str output under a dag-cbor label. Both
   ;; were defects: a pure definition and an effectful one with identical KIR
   ;; shared a CID, and pr-str is not byte-identical across implementations.
   :supersedes {:payload-version 1
                :reason [:effect-row-unsealed :desugar-contract-version-unsealed
                         :codec-mislabelled :not-cross-implementation-deterministic]}
   :exact-value-forms
   {:reason "A ClojureScript reader rounds integer literals past 2^53-1 and has one number type, so some values are corrupted before any encoder sees them."
    :i64 "kotoba.lang.code-identity/i64 — exact decimal text; plain integers admitted within ±(2^53-1)"
    :f64 "kotoba.lang.code-identity/f64 — exact IEEE-754 bits as 16 hex characters; raw platform floats are refused"}}
  :component-cid
  {:proves :reproducible-wasm-artifact
   :requires [:toolchain-profile :build-evidence]}
  :component-admission
  {:status :planned
   :requires [:component-cid :wit-world-cid :target-identity :resource-limits]
   :owner :kototama
   :rule "Only kototama may link an admitted component; definition identity alone never authorizes instantiation."}
  :package-manifest-cid
  {:proves :signed-package-declaration
   :binds [:repo-rid :source-tree-cid :capability-requests :dependency-locks]}}

 :ability
 {:definition "Unforgeable resource-scoped capability value consumed by a provider call."
  :source-model "Ordinary named operations; numeric IDs and portable envelopes are elaboration targets."
  :requires [:effect-row :narrow-wit-import :target :operation-bounds
             :runtime-capability-intersection :receipt]
  :does-not-grant [:ambient-authority :unchecked-provider-access]
  :affinity :capability-boundary-only}

 :elaboration-order
 [:closed-reader
  :bounded-pure-desugar
  :name-module-resolution
  :type-schema-inference
  :interprocedural-effect-inference
  :implicit-ability-elaboration
  :typed-hir-kir
  :definition-cid
  :restricted-esm-or-wasm-component
  :host-grant-policy-provider-binding]

 :link-invariant
 [:typed-ability-effect
  :declared-wasm-import
  :locked-definition-or-component-identity
  :kototama-wit-world-target-and-limit-admission
  :policy-and-delegation-intersection
  :tender-binding
  :provider-resource-revalidation
  :receipt]

 :non-goals
 [:unison-syntax
  :global-codebase-namespace
  :general-effect-handlers
  :broad-wasi-grants
  :ordinary-app-native-aot
  :runtime-eval
  :ambient-loading
  :ambient-io
  :implicit-durable-execution
  :framework-specific-application-dsl]

 :stages
 {:ci0 :contract
  :ci1 :canonical-typed-kir-and-vectors
  :ci2 :pure-definition-manifest-and-fixtures
  :ci3 :negative-identity-fixtures
  :ci4 :safe-build-lock-verification
  :ci5 :typed-ability-host-abi
  :ci6 :cross-implementation-conformance
  :ci7 :friendly-source-operation-elaboration}

 :implementation
 {:ci0 {:status :implemented
        :evidence ["docs/adr/ADR-kotoba-code-identity-and-abilities.md"
                   "lang/code-identity.edn"
                   "docs/kotoba-centered-migration-plan.md"]}
  :ci1 {:status :implemented
        :evidence ["src/kotoba/lang/code_identity.cljc"
                   "lang/code-identity-vectors.edn"
                   "scripts/gen_code_identity_fixtures.clj"
                   "test/kotoba/lang/code_identity_test.clj"]
        :note "Canonical DAG-CBOR encoding over a closed, injective, tagged value domain; 10 frozen vectors are recomputed by the test suite."}
  :ci2 {:status :implemented
        :evidence ["src/kotoba/lang/package_registry.cljc"
                   "lang/code-identity-conformance/positive/alias_resolves_to_definition_cids.edn"
                   "lang/code-identity-conformance/positive/locked_definition_admitted.edn"]
        :note ":registry/definition-cids resolves through the signed record to :dep/definition-cids, so a name is an alias and never a substitution point."}
  :ci3 {:status :implemented
        :evidence ["lang/code-identity-conformance/manifest.edn"
                   "lang/code-identity-conformance/negative/"]
        :note "One negative fixture per sealed canonical input (body, profile, interface, dependency, effect-row, desugar-contract) plus the linking rules themselves."}
  :ci4 {:status :implemented
        :evidence ["src/kotoba/lang/code_identity.cljc"
                   "lang/code-identity-conformance/negative/unresolved_dependency.edn"
                   "lang/code-identity-conformance/negative/unresolved_definition.edn"]
        :note "admit-build closes the omission hole: verify-locked-definitions alone returns ok? true when a build presents nothing, which is the mutable-name fallback reached by omission. A dependency pinning definition CIDs must now actually resolve all of them."}
  :ci5 {:status :implemented
        :evidence ["src/kotoba/lang/capability_values.cljc"
                   "src/kotoba/lang/capability_host.cljc"
                   "lang/capability-conformance/positive/component_binding_dispatch.edn"
                   "lang/capability-conformance/negative/component_binding_not_a_component_capability.edn"
                   "lang/capability-conformance/negative/component_binding_host_binding_guard_mismatch.edn"
                   "kotoba-lang/kotoba-component src/kotoba/component/wit.cljc (emit :host-binding)"]
        :note "Both halves. Emit: kotoba.component.wit/emit returns :host-binding {:contract :kotoba.component.host-binding/v1 :required-guard :guard-component-ability-call :imports {<import> <guard>}} covering every effectful import, on both the typed-capability-v3 and default branches, without perturbing the WIT text or its sha256. Host: bind-component-imports reads that declaration and refuses an undeclared, mismatched, or incomplete one, alongside a non-component target, a handler for an undeclared import, and a declared import left unbound. Each bound entry supplies :call and :handler itself, so a caller cannot substitute a weaker guard. The weaker guards stay public for non-component hosts -- guard-ability-call falls through to guard-call for a request that is not a capability value and skips the effect gate, which guard-component-ability-call denies as :component-ability-invalid; a negative fixture pins that difference."
        :residual-risk ["A host that ignores bind-component-imports and calls a guard directly is still unconstrained; this makes the correct route checkable, not mandatory at the language level."
                        "The declaration binds the host entry point, not the provider implementation behind it; provider-side resource revalidation remains its own obligation."]}
  :ci6 {:status :implemented
        :evidence ["scripts/verify_code_identity_cljs.cljs"
                   "scripts/verify_capability_conformance_cljs.cljs"]
        :note "All three layers are covered. Identity: all 10 frozen vectors produce identical canonical bytes and CIDs under ClojureScript (nbb) and Clojure -- this runner is what found that integer literals past 2^53-1 are rounded by the cljs reader before any encoder runs, which the i64 exact form now refuses rather than hides. Capability: all 24 conformance cases (component-binding, host-dispatch, intersection, effects, receipts, and cacao grant/revocation) reach the same verdict under both. Because the manifest pins the expected denial reason per negative case, agreement means the same reason fired, not merely that both denied -- verified by a negative control that corrupts one expected reason and observes exactly one disagreement."
        :wit-evidence "kotoba-lang/kotoba-component: src/kotoba/component/wit.cljc, lang/wit-vectors.edn, scripts/verify_wit_cljs.cljs"
        :wit-note "The WIT layer is now comparable and compared. kotoba.component.wit was ported from .clj to .cljc -- only two of its 344 lines were JVM-bound (contract loading and SHA-256), while the 340 that matter, WIT identifier canonicalization and the Kotoba->WIT type mapping, were already portable. Five frozen vectors covering a pure export, one capability, two capabilities sharing an interface, capabilities spanning interfaces in non-sorted call order, and the scalar/string type mapping all emit byte-identical text and identical digests under Clojure and ClojureScript. Negative control: corrupting one import name in the table yields 3 disagreements across 5 vectors."
        :residual-risk ["Receipts are compared field-wise by the checkers, not hashed. If receipt bytes ever become a cross-implementation contract, they need their own frozen-vector table like the identity one."
                        "The typed-capability-v3 WIT profile remains JVM-only: its authoritative source is a classpath resource in kotoba-lang/abi whose accessor is :clj-only. Requesting it under ClojureScript rejects explicitly rather than diverging, but that one profile is not cross-implementation verified."
                        "Quota and deadline enforcement is asserted by the capability fixtures at the policy layer; it is not separately measured against a running provider under both implementations."]}
  :ci7 {:status :implemented
        :evidence ["kotoba-lang/compiler: src/kotoba/compiler/project.cljc (capability-operation?)"
                   "kotoba-lang/compiler: test/kotoba/compiler/ci7_elaboration_parity_test.clj"]
        :note "Asking the question found that friendly capability operations did not elaborate in project builds -- they did not compile at all. project/link-source treated every namespaced call as a module import and rejected (clock/now seed) with 'qualified call is not an admitted exported import', while the identical single-file source compiled. capability-operation? now consults the capability registry, with module imports still resolved first so an explicit :require alias always wins over a capability of the same name. With that fixed the parity holds: same wire id, same typed ability call, same inferred effect closure, same admission verdict, and same missing grant under an empty policy on both paths. The admission rule also holds -- no source in the fixtures names a capability id or a callback."
        :residual-risk ["Provenance is dropped by project linking. Linking analyzes each module first, so the linked source carries the elaborated (typed-cap-call <id> ...) under synthetic names; :named-operations and the :source-operation metadata do not survive, so a diagnostic raised during a project build cannot point back at the friendly operation the author wrote. Pinned by provenance-is-lost-by-project-linking, which asserts current behaviour and is to be updated rather than deleted when the linker preserves provenance."
                        "The numeric wire id appears in the linked intermediate source. This is internal to the compiler's own stages and does not violate the admission rule, which constrains what an author must write; it is pinned by the-numeric-id-is-internal-not-user-facing."]}
}}
