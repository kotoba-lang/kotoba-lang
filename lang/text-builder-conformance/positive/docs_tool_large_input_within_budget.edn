;; AC6 / TB1 / TB2 / TB3 positive control: native Docs static renderer accepts
;; Markdown inputs > 65,536 bytes up to its 1,048,576-byte profile limit while
;; separating lightweight index metadata (M1), capping peak pool growth linearly
;; inside arena-scope (M2), and honoring worker RSS concurrency bounds (M3).

{:kotoba.lang.text-builder.case/id :positive-docs-tool-large-input-within-budget
 :kotoba.lang.text-builder.case/kind :accept
 :kotoba.lang.text-builder.case/acceptance [:AC6 :TB1 :TB2 :TB3]
 :spec-file "lang/text-tool-budgets.edn"
 :spec-key-paths [[:limit-layers :native-runtime-ceiling]
                  [:tool-profiles :docs-static-renderer :max-single-input-bytes]
                  [:tool-profiles :docs-static-renderer :max-single-output-bytes]
                  [:memory-and-concurrency-guardrails :M1-metadata-body-separation]
                  [:memory-and-concurrency-guardrails :M2-linear-pool-and-arena-hygiene]
                  [:memory-and-concurrency-guardrails :M3-host-concurrency-budget]]

 :inputs
 [{:name :above-legacy-64kib-utf8
   :markdown-bytes 131072
   :sample-multibyte "言語比較行列🙂\n"
   :chapter-index-bytes 2048}
  {:name :exact-profile-1mib-boundary
   :markdown-bytes 1048576
   :chapter-index-bytes 2048}]

 :expect
 {:verdict :accept
  :exit-code 42
  :single-chapter-body-read-count 1
  :single-chapter-sha256-in-arena-scope true
  :metadata-index-under-document-utf8-limit true
  :peak-pool-bytes-linear-bound "tier-1 <= 16*N + 262144; tier-0 <= 64*N + 524288"
  :coordinator-default-jobs 1}}
