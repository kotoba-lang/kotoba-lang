;; AC3 positive control: multi-level private helpers threading :text-builder
;; via :linear-return and reading non-consuming byte-length/remaining before
;; finalization.

{:kotoba.lang.text-builder.case/id :positive-linear-returning-helper-chain
 :kotoba.lang.text-builder.case/kind :accept
 :kotoba.lang.text-builder.case/acceptance [:AC3]
 :spec-file "lang/text-builder.edn"
 :spec-key-paths [[:tiers :tier-1-standard-text-builder :ownership :linear-return-rule]
                  [:tiers :tier-1-standard-text-builder :ownership :inspect-rule]
                  [:operations :text-builder-byte-length]
                  [:operations :text-builder-remaining]]

 :program-sketch
 "(defn- esc-into [b :text-builder s :string] :text-builder
    (let [n (string-byte-length s)]
      (loop [i 0 from 0 acc b]
        (if (>= i n)
          (text-builder-append-range acc s from n)
          (let [c (string-code-point-at s i)]
            (if (= c 60)
              (let [acc1 (text-builder-append-range acc s from i)
                    acc2 (text-builder-append acc1 \"&lt;\")]
                (recur (+ i 1) (+ i 1) acc2))
              (recur (+ i (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4)) from acc)))))))
  (defn- inline-into [b :text-builder s :string] :text-builder
    (let [b1 (text-builder-append b \"<p>\")
          b2 (esc-into b1 s)]
      (text-builder-append b2 \"</p>\")))
  (defn main [] :string
    (let [b0 (text-builder-new 256)
          b1 (inline-into b0 \"a<b\")
          len (text-builder-byte-length b1)
          rem (text-builder-remaining b1)
          b2 (text-builder-append b1 (if (= (+ len rem) 256) \"!\" \"?\"))]
      (text-builder-finish b2)))"

 :expect
 {:verdict :accept
  :compile-admitted true
  :linear-return-helpers [esc-into inline-into]
  :expected-utf8 "<p>a&lt;b</p>!"
  :cross-backend-identical-output true}}
