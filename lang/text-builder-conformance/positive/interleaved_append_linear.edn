;; AC1 positive control: interleaving temporary string allocations between
;; builder appends MUST stay O(N) amortized with copy factor <= 3.0 and MUST NOT
;; depend on global string_pool_used top.

{:kotoba.lang.text-builder.case/id :positive-interleaved-append-linear
 :kotoba.lang.text-builder.case/kind :accept
 :kotoba.lang.text-builder.case/acceptance [:AC1]
 :spec-file "lang/text-builder.edn"
 :spec-key-paths [[:complexity-contract :interleaving-invariance]
                  [:complexity-contract :copy-factor-max-geometric]
                  [:complexity-contract :no-eager-max-allocation]]

 :workload
 {:description "For k in 0..M-1, allocate a temporary string (string-concat \"tmp-\" (string-from-i64 k)) between every (text-builder-append b \"abcd1234\") call; measure at N1=4096 bytes (M1=512) and N2=65536 bytes (M2=8192)."
  :program-sketch
  "(defn main [] :i64
     (let [b0 (text-builder-new 131072)
           b1 (loop [i 0 b b0]
                (if (>= i 8192)
                  b
                  (let [_tmp (string-concat \"tmp-\" (string-from-i64 i))]
                    (recur (+ i 1) (text-builder-append b \"abcd1234\")))))
           out (text-builder-finish b1)]
       (string-byte-length out)))"
  :small-n-bytes 4096
  :large-n-bytes 65536
  :small-limit-arg 131072}

 :expect
 {:verdict :accept
  :output-bytes 65536
  :copied-bytes-ratio-max 3.0
  :no-eager-reserve-at-new "A 512-byte build with max-bytes=8388608 MUST NOT reserve 8 MiB in RSS or :budget/bytes."
  :cross-backend-identical-output true}}
