;; AC2 positive control: text-builder-append-range (zero intermediate string),
;; text-builder-append-i64 (including i64 MIN), and text-builder-append-code-point
;; over ASCII + 3-byte CJK + 4-byte emoji UTF-8 scalars.

{:kotoba.lang.text-builder.case/id :positive-append-range-utf8-boundaries
 :kotoba.lang.text-builder.case/kind :accept
 :kotoba.lang.text-builder.case/acceptance [:AC2]
 :spec-file "lang/text-builder.edn"
 :spec-key-paths [[:operations :text-builder-append-range]
                  [:operations :text-builder-append-i64]
                  [:operations :text-builder-append-code-point]]

 :input
 {:source-text "prefix:日本語🙂:suffix"
  :slice-start 7
  :slice-end 20
  :i64-values [0 -9223372036854775808]
  :code-points [65 26085 128578]}

 :program-sketch
 "(defn main [] :string
    (let [src \"prefix:日本語🙂:suffix\"
          b0 (text-builder-new 256)
          b1 (text-builder-append-range b0 src 7 20)
          b2 (text-builder-append b1 \"|\")
          b3 (text-builder-append-i64 b2 0)
          b4 (text-builder-append b3 \"|\")
          b5 (text-builder-append-i64 b4 -9223372036854775808)
          b6 (text-builder-append b5 \"|\")
          b7 (text-builder-append-code-point b6 65)
          b8 (text-builder-append-code-point b7 26085)
          b9 (text-builder-append-code-point b8 128578)]
      (text-builder-finish b9)))"

 :expect
 {:verdict :accept
  :expected-utf8 "日本語🙂|0|-9223372036854775808|A日🙂"
  :intermediate-substring-handles 0
  :cross-backend-identical-output true}}
