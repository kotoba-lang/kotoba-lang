;; AC3 negative control: reusing a consumed :text-builder handle MUST be
;; refused at compile time (:kotoba.error/affine-use).
;; Baseline vs Candidate isolates ONLY the reused handle b0.

{:kotoba.lang.text-builder.case/id :negative-affine-double-use
 :kotoba.lang.text-builder.case/kind :reject
 :kotoba.lang.text-builder.case/acceptance [:AC3]
 :spec-file "lang/text-builder.edn"
 :spec-key-paths [[:tiers :tier-1-standard-text-builder :ownership :compile-time-refusals]]

 :baseline
 {:verdict :accept
  :program
  "(defn main [] :string
     (let [b0 (text-builder-new 64)
           b1 (text-builder-append b0 \"a\")
           b2 (text-builder-append b1 \"b\")]
       (text-builder-finish b2)))"
  :expected-utf8 "ab"}

 :candidate
 {:verdict :reject
  :mutation "Second append reuses consumed b0 instead of b1."
  :program
  "(defn main [] :string
     (let [b0 (text-builder-new 64)
           b1 (text-builder-append b0 \"a\")
           b2 (text-builder-append b0 \"b\")]
       (text-builder-finish b2)))"}

 :expect
 {:verdict :reject
  :phase :compile
  :code :kotoba.error/affine-use
  :offending-binding :b0}}
