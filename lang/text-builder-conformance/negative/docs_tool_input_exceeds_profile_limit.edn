;; TB1 negative control: native Docs renderer MUST fail-closed when input
;; exceeds :docs-static-renderer :max-single-input-bytes (1,048,576), emitting
;; exit 7 and zero stdout bytes.
;; Baseline uses exact limit 1,048,576; candidate mutates only length to +1.

{:kotoba.lang.text-builder.case/id :negative-docs-tool-input-exceeds-profile-limit
 :kotoba.lang.text-builder.case/kind :reject
 :kotoba.lang.text-builder.case/acceptance [:TB1]
 :spec-file "lang/text-tool-budgets.edn"
 :spec-key-paths [[:tool-profiles :docs-static-renderer :max-single-input-bytes]
                  [:tool-profiles :docs-static-renderer :required-refusal-controls]]

 :baseline
 {:verdict :accept
  :profile :docs-static-renderer
  :max-single-input-bytes 1048576
  :input-bytes 1048576
  :expected-exit 42}

 :candidate
 {:verdict :reject
  :mutation "Input byte length increased by 1 byte (1,048,576 -> 1,048,577)."
  :profile :docs-static-renderer
  :max-single-input-bytes 1048576
  :input-bytes 1048577}

 :expect
 {:verdict :reject
  :phase :tool-boundary
  :exit-code 7
  :stdout-bytes 0
  :partial-html-allowed false}}
