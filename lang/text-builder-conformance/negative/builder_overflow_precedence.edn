;; AC4 negative control: builder logical capacity trap :text-builder/overflow
;; (stage 3) MUST fire deterministically BEFORE host :budget/bytes (stage 4),
;; producing the exact same trap on all backends (KIR, ESM, Wasm, Native).

{:kotoba.lang.text-builder.case/id :negative-builder-overflow-precedence
 :kotoba.lang.text-builder.case/kind :reject
 :kotoba.lang.text-builder.case/acceptance [:AC4]
 :spec-file "lang/text-builder.edn"
 :spec-key-paths [[:trap-precedence]
                  [:cross-backend-equivalence]]

 :baseline
 {:verdict :accept
  :max-bytes 8
  :chunks ["abcd" "efgh"]
  :total-bytes 8
  :expected-utf8 "abcdefgh"}

 :candidate
 {:verdict :reject
  :mutation "Second chunk extended by 1 byte ('efghi') -> total 9 > max-bytes 8 while host string pool (e.g. 65536) still has headroom."
  :max-bytes 8
  :chunks ["abcd" "efghi"]
  :total-bytes 9
  :host-string-pool-bytes 65536}

 :expect
 {:verdict :reject
  :phase :runtime
  :trap-stage 3
  :trap :text-builder/overflow
  :must-not-report :budget/bytes
  :cross-backend-identical-trap true}

 :reference-oracle-regression-note
 "AmuSpec audited that `kotoba/lib/kotoba.osaho/src/kotoba/kir.cljk:4181-4182,4213-4215`
  currently omits `value/bounded-string!` and `charge-bytes!` on `string-fold-ascii`
  and `string-append-range`. Implementations of `:text-builder` (especially
  `text-builder-append-range`) on the KIR oracle MUST enforce stage 2-3 builder
  bounds and stage 4 `:budget/bytes` charging without bypassing `charge-bytes!`."}
