;; AC2 negative control: text-builder-append-range slicing mid-codepoint MUST
;; trap :substring/code-point-boundary (stage 2) even when capacity suffices.
;; Baseline slices on exact 3-byte code-point boundary [0, 3); candidate slices
;; mid-character [0, 2).

{:kotoba.lang.text-builder.case/id :negative-append-range-mid-utf8-codepoint
 :kotoba.lang.text-builder.case/kind :reject
 :kotoba.lang.text-builder.case/acceptance [:AC2]
 :spec-file "lang/text-builder.edn"
 :spec-key-paths [[:operations :text-builder-append-range]
                  [:trap-precedence]]

 :baseline
 {:verdict :accept
  :source "日a"
  :start 0
  :end 3
  :max-bytes 64
  :expected-utf8 "日"}

 :candidate
 {:verdict :reject
  :mutation "end moved from 3 to 2 (middle of 3-byte UTF-8 char E6 97 A5)"
  :source "日a"
  :start 0
  :end 2
  :max-bytes 64}

 :expect
 {:verdict :reject
  :phase :runtime
  :trap-stage 2
  :trap :substring/code-point-boundary}}
