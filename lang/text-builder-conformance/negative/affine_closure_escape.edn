;; AC3 negative control: capturing :text-builder inside a closure or exporting
;; it across module boundary MUST be refused at compile time.
;; Baseline threads through a private :linear-return helper; candidate escapes
;; into an `fn` closure and public `:export`.

{:kotoba.lang.text-builder.case/id :negative-affine-closure-escape
 :kotoba.lang.text-builder.case/kind :reject
 :kotoba.lang.text-builder.case/acceptance [:AC3]
 :spec-file "lang/text-builder.edn"
 :spec-key-paths [[:tiers :tier-1-standard-text-builder :ownership :compile-time-refusals]
                  [:tiers :tier-1-standard-text-builder :ownership :linear-return-rule]]

 :baseline
 {:verdict :accept
  :program
  "(ns test.tb (:export [main]))
   (defn- add-piece [b :text-builder s :string] :text-builder
     (text-builder-append b s))
   (defn main [] :string
     (let [b0 (text-builder-new 64)
           b1 (add-piece b0 \"ok\")]
       (text-builder-finish b1)))"
  :expected-utf8 "ok"}

 :candidate
 {:verdict :reject
  :mutation "Capture b0 inside fn literal and attempt public export of :text-builder."
  :cases
  [{:kind :closure-capture
    :program
    "(ns test.tb (:export [main]))
     (defn main [] :string
       (let [b0 (text-builder-new 64)
             f (fn [s :string] (text-builder-append b0 s))]
         (text-builder-finish (f \"x\"))))"
    :expected-code :kotoba.error/affine-escape}
   {:kind :public-export
    :program
    "(ns test.tb (:export [make-b]))
     (defn make-b [] :text-builder
       (text-builder-new 64))"
    :expected-code :kotoba.error/affine-export}]}

 :expect
 {:verdict :reject
  :phase :compile
  :codes #{:kotoba.error/affine-escape :kotoba.error/affine-export}}}
