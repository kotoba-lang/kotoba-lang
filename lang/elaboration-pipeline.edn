{:kotoba.lang.elaboration-pipeline/version 1
 :kotoba.lang.elaboration-pipeline/authority "kotoba-lang/kotoba-lang"
 :kotoba.lang.elaboration-pipeline/status :w1-named-operation-elaboration
 :kotoba.lang.elaboration-pipeline/workspace-adr
 "90-docs/adr/2607279200-kotoba-clojure-shaped-safety-elaboration-migration.edn"
 :kotoba.lang.elaboration-pipeline/migration-plan
 "docs/kotoba-centered-migration-plan.md"
 :kotoba.lang.elaboration-pipeline/code-identity
 "lang/code-identity.edn"
 :kotoba.lang.elaboration-pipeline/source-surface-authority
 "lang/guest-grammar.edn"
 :kotoba.lang.elaboration-pipeline/surface-status
 "lang/surface-status.edn"
 :kotoba.lang.elaboration-pipeline/capability-catalog
 "lang/capability-catalog.edn"

 ;; Contract versions sealed into definition identity and release artifacts.
 :contract-versions
 {:language-profile 4
  :guest-grammar 2
  :surface-status 1
  :desugar-contract 1
  :typed-kir 1
  :capability-catalog 1
  :semantic-cid 1
  :elaboration-pipeline 1
  :code-identity 1
  :portable-effect 1}

 :pipeline
 [{:id :closed-reader
   :owner "kotoba-lang/amu + kotoba-lang/kotoba"
   :input :source-text
   :output :forms
   :rules [:closed-edn-subset :fail-closed-on-unknown-reader-macro]}
  {:id :bounded-pure-desugar
   :owner "kotoba-lang/amu"
   :input :forms
   :output :core-forms
   :rules [:registered-defdesugar-only :node-depth-bounded :no-host-ops]}
  {:id :name-module-resolution
   :owner "kotoba-lang/amu"
   :input :core-forms
   :output :resolved-graph
   :rules [:closed-require-export :no-ambient-require]}
  {:id :type-schema-inference
   :owner "kotoba-lang/amu"
   :input :resolved-graph
   :output :typed-graph
   :rules [:closed-schemas :fail-closed-on-mismatch]}
  {:id :interprocedural-effect-inference
   :owner "kotoba-lang/amu"
   :input :typed-graph
   :output :effect-typed-graph
   :rules [:fixpoint-over-calls :declaration-is-ceiling-not-floor]}
  {:id :implicit-ability-elaboration
   :owner "kotoba-lang/amu"
   :input :effect-typed-graph
   :output :ability-elaborated-graph
   :rules [:named-ops-to-typed-abilities :no-user-facing-numeric-ids]}
  {:id :typed-hir-kir
   :owner "kotoba-lang/amu"
   :input :ability-elaborated-graph
   :output :typed-kir
   :rules [:deterministic-encoding]}
  {:id :definition-cid
   :owner "kotoba-lang/kotoba-lang + kotoba-lang/kotoba"
   :input :typed-kir
   :output :definition-identity
   :rules [:alpha-rename-independent :contract-versions-sealed]}
  {:id :target-lowering
   :owner "kotoba-lang/amu"
   :input :typed-kir
   :output :artifact
   :targets #{:restricted-esm :wasm-component}
   :rules [:exact-imports :deny-by-default-admission]}
  {:id :host-binding
   :owner "kototama + selected host"
   :input :artifact
   :output :admitted-execution
   :rules [:grant-policy-intersection :quota-deadline-revocation-receipt]}]

 :source-programming-model
 {:keeps #{:def :defn :ns :let :if :loop-recur :map :vector :set
           :destructuring :higher-order-functions :records :protocols
           :bounded-pure-desugar}
  :not-user-facing #{:numeric-capability-id :wit-import-syntax
                     :portable-effect-envelope :provider-callback
                     :host-object}
  :explicit-capability-values-only-for #{:attenuation :delegation
                                        :resource-scope :quota :deadline}}

 :vendored-consumers
 ["resources/kotoba/lang/guest-grammar.edn"
  "resources/kotoba/lang/capability-catalog.edn"
  "../amu/resources/kotoba/lang/guest-grammar.edn"
  "../kotoba/resources/kotoba/lang/guest-grammar.edn"
  "../grammar/resources/kotoba/lang/guest-grammar.edn"]

 :portable-backends #{:compiler :kotoba-wasm :kotoba-cljs}

 :w1-slice
 {:status :implemented-partial
  :compiler-ops ["friendly namespaced call heads" "effect ceilings on defn"
                 "source-operation metadata" "named-operations on HIR"]
  :fixtures ["examples/w1-pure.kotoba" "examples/w1-effect-named.kotoba"
             "examples/w1-denial-ceiling.kotoba"]
  :tests ["test/kotoba/compiler/w1_elaboration_test.clj"]
  :note "Scalar cap-call path first; typed-cap-call friendly sugar remains follow-up."}

 :w0-exit-gate
 ["guest-grammar.edn is the only source-surface authority"
  "every compiler-admitted form is classified by surface-status.edn"
  "portable claims require full backend set and conformance evidence or remain partial"
  "vendored consumer copies byte-match the authority"
  "contract versions are recorded in elaboration-pipeline.edn"]}
