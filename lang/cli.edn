{:kotoba.cli.contract/version 2
 :kotoba.cli.contract/scope
 {:owner :kotoba-lang
  :authority :cljc-edn
  :host-adapter-targets [:rust]
  :description "Data-first command contract for the public kotoba CLI. Host CLIs should adapt to this contract instead of defining protocol semantics."}
 :kotoba.cli.contract/tier-labels
 {:m0 {:label "M0"
       :meaning "Documented command surface and option vocabulary."}
  :m1 {:label "M1"
       :meaning "Machine-readable command contract suitable for host adapters."}
  :m2 {:label "M2"
       :meaning "Validated command contract with conformance fixtures."}
  :m3 {:label "M3"
       :meaning "Host adapters are generated or mechanically checked against the contract."}}
 :kotoba.cli.contract/option-types
 {:boolean {:description "Presence flag or explicit boolean value."}
  :string  {:description "Single string argument."}
  :path    {:description "Filesystem path interpreted by the host adapter."}
  :edn     {:description "EDN value or path to an EDN document, as specified by the option."}
  :enum    {:description "One value from the option's :values vector."}
  :int     {:description "Integer value."}}
 :kotoba.cli.contract/commands
 [{:id :run
   :tier :m1
   :summary "Compile and run a Kotoba entry point."
   :positionals [{:id :entry
                  :type :path
                  :required? false
                  :description "Kotoba, CLJ, CLJC, or CLJS source file. Optional when :expr is supplied."}]
   :options [{:id :expr
              :flags ["-e" "--expr"]
              :type :string
              :description "Inline expression compiled as exported main; compile-and-run sugar, not runtime eval."}
             {:id :source-path
              :flags ["-S" "--source-path"]
              :type :path
              :repeatable? true
              :env "KOTOBA_SOURCE_PATH"
              :description "Namespace source root. KOTOBA_CLJ_PATH remains a compatibility alias outside this contract."}
             {:id :target
              :flags ["--target"]
              :type :enum
              :values [:kotoba :clj :cljs]
              :default :kotoba
              :description "Reader target for portable source."}
             {:id :function
              :flags ["--function"]
              :type :string
              :default "main"
              :description "Exported function to invoke."}
             {:id :arg
              :flags ["--arg"]
              :type :edn
              :repeatable? true
              :description "EDN argument passed to the entry function."}
             {:id :json
              :flags ["--json"]
              :type :boolean
              :description "Emit machine-readable JSON result."}]}
  {:id :compile
   :tier :m1
   :summary "Compile Kotoba-family source to a target artifact. Web .kotoba uses checked KIR and the restricted kotoba-script backend; .cljs remains ClojureScript."
   :positionals [{:id :entry :type :path :required? false
                  :description ".kotoba, .cljc, or .cljk source file; omitted when --project is used."}]
   :options [{:id :target :flags ["--target"] :type :enum
              :values [:web :wasm] :default :wasm
              :description "Compilation target."}
             {:id :prelude :flags ["--prelude"] :type :path
              :description "Explicit portable source prelude prepended before the entry source. No prelude is loaded implicitly."}
             {:id :output :flags ["-o" "--output"] :type :path
              :description "Output artifact path."}
             {:id :project :flags ["--project"] :type :path
              :description "Closed multi-module Kotoba project manifest."}
             {:id :semantic :flags ["--semantic"] :type :boolean
              :default false
              :description "Fail closed unless semantic definition identities can be derived and bound to the artifact."}
             {:id :semantic-receipt :flags ["--semantic-receipt"] :type :path
              :description "Write the signed semantic supply-chain receipt as EDN; implies --semantic."}
             {:id :signing-key :flags ["--signing-key"] :type :path
              :description "EDN file containing the Ed25519 seed used to sign a v2 semantic receipt."}
             {:id :spdx :flags ["--spdx"] :type :path
              :description "Write the SPDX 2.3 JSON projection bound by the semantic receipt."}
             {:id :build-cache :flags ["--build-cache"] :type :path
              :description "Signed shared-cache config; requires a semantic receipt and exact compiler git pin."}
             {:id :json :flags ["--json"] :type :boolean
              :description "Emit machine-readable diagnostics."}]}
  {:id :codebase
   :tier :m2
   :summary "Operate on the CID-verified codebase, signed shared cache, and actor/IPLD transport."
   :subcommands [:init :import :inspect :resolve :run :merge :list :search :log :gc
                 :network-init :network-publish :network-private-publish
                 :network-keyset :network-head :network-sync
                 :network-private-sync :network-replicate
                 :cache-publish :cache-fetch :provider-discover]
   :positionals [{:id :subject
                  :type :string
                  :required? false
                  :description "Source path, definition name, CID, or network head depending on the subcommand."}]
   :options [{:id :store
              :flags ["--store"]
              :type :path
              :required? true
              :description "Local CID-verified codebase root."}
             {:id :namespace
              :flags ["--namespace"]
              :type :string
              :description "Mutable namespace name selecting an immutable head."}
             {:id :expected-head
              :flags ["--expected-head"]
              :type :string
              :description "Expected namespace head CID for compare-and-set updates."}
             {:id :base
              :flags ["--base"]
              :type :string
              :description "Verified merge-base commit CID."}
             {:id :left
              :flags ["--left"]
              :type :string
              :description "Left namespace commit CID."}
             {:id :right
              :flags ["--right"]
              :type :string
              :description "Right namespace commit CID."}
             {:id :peer
              :flags ["--peer"]
              :type :string
              :repeatable? true
              :description "Explicit peer URL or peer descriptor; discovery is not implied."}
             {:id :min-replicas
              :flags ["--min-replicas"]
              :type :int
              :description "Minimum fully verified peer receipts required for replication."}
             {:id :apply
              :flags ["--apply"]
              :type :boolean
              :default false
              :description "Apply a destructive operation such as reachable-block GC; otherwise return a plan."}
             {:id :json
              :flags ["--json"]
              :type :boolean
              :description "Emit machine-readable codebase results."}]}
  {:id :check
   :tier :m1
   :summary "Validate Kotoba source, contracts, or package metadata without running it."
   :positionals [{:id :input
                  :type :path
                  :required? false
                  :description "Source file, package manifest, lock file, or contract document."}]
   :options [{:id :kind
              :flags ["--kind"]
              :type :enum
              :values [:source :semantic-code :semantic-test :package :lock :cli-contract :auto]
              :default :auto
              :description "Validation domain."}
             {:id :source-path
              :flags ["-S" "--source-path"]
              :type :path
              :repeatable? true
              :description "Namespace source root for source checks."}
             {:id :target
              :flags ["--target"]
              :type :enum
              :values [:kotoba :clj :cljs]
              :default :kotoba
              :description "Reader target for portable source checks."}
             {:id :safe
              :flags ["--safe"]
              :type :boolean
              :default true
              :description "Apply the capability-safe Kotoba profile."}
             {:id :test-manifest
              :flags ["--test-manifest"]
              :type :path
              :description "Bounded semantic-test manifest containing named pure function cases."}
             {:id :test-receipt
              :flags ["--test-receipt"]
              :type :path
              :description "Write the signed semantic test receipt as EDN."}
             {:id :signing-key
              :flags ["--signing-key"]
              :type :path
              :description "Ed25519 key used to sign a new semantic test receipt."}
             {:id :build-cache
              :flags ["--build-cache"]
              :type :path
              :description "Optional signed shared-cache lookup/publish config for semantic tests."}
             {:id :json
              :flags ["--json"]
              :type :boolean
              :description "Emit machine-readable diagnostics."}]}
  {:id :db
   :tier :m1
   :summary "Interact with the Kotoba data substrate through explicit data operations."
   :subcommands [:connect :query :transact :pull :status]
   :options [{:id :db
              :flags ["--db"]
              :type :string
              :required? true
              :description "Database alias, URI, or environment-selected handle."}
             {:id :operation
              :flags ["--op"]
              :type :enum
              :values [:connect :query :transact :pull :status]
              :description "Data operation. Mirrors the supported subcommands for adapters without nested command support."}
             {:id :input
              :flags ["-f" "--file"]
              :type :path
              :description "EDN query, transaction, or pull request file."}
             {:id :param
              :flags ["--param"]
              :type :edn
              :repeatable? true
              :description "EDN parameter binding for query-like operations."}
             {:id :json
              :flags ["--json"]
              :type :boolean
              :description "Emit machine-readable result."}]}
  {:id :git
   :tier :m1
   :summary "Expose Kotoba repository operations as data, not shell-specific behavior."
   :subcommands [:init :status :commit :sync]
   :options [{:id :repo
              :flags ["--repo"]
              :type :path
              :default "."
              :description "Repository root."}
             {:id :operation
              :flags ["--op"]
              :type :enum
              :values [:init :status :commit :sync]
              :description "Repository operation. Mirrors subcommands for simple host adapters."}
             {:id :message
              :flags ["-m" "--message"]
              :type :string
              :description "Commit message for commit-like operations."}
             {:id :ref
              :flags ["--ref"]
              :type :string
              :description "Branch, tag, or revision reference."}
             {:id :json
              :flags ["--json"]
              :type :boolean
              :description "Emit machine-readable repository status."}]}
  {:id :rad
   :tier :m1
   :summary "Run rapid application development workflows over Kotoba packages."
   :subcommands [:new :build :test :export]
   :options [{:id :project
              :flags ["--project"]
              :type :path
              :default "."
              :description "Project root."}
             {:id :operation
              :flags ["--op"]
              :type :enum
              :values [:new :build :test :export]
              :description "RAD operation. Mirrors subcommands for simple host adapters."}
             {:id :template
              :flags ["--template"]
              :type :string
              :description "Project or artifact template."}
             {:id :profile
              :flags ["--profile"]
              :type :enum
              :values [:dev :test :release]
              :default :dev
              :description "Build or test profile."}
             {:id :output
              :flags ["-o" "--output"]
              :type :path
              :description "Output path for build/export artifacts."}
             {:id :json
              :flags ["--json"]
              :type :boolean
              :description "Emit machine-readable workflow result."}]}
  {:id :deploy
   :tier :m1
   :summary "Plan and apply deployment operations from Kotoba package data."
   :subcommands [:plan :apply :status :rollback]
   :options [{:id :manifest
              :flags ["--manifest"]
              :type :path
              :default "package-manifest.edn"
              :description "Package or deployment manifest."}
             {:id :operation
              :flags ["--op"]
              :type :enum
              :values [:plan :apply :status :rollback]
              :description "Deployment operation. Mirrors subcommands for simple host adapters."}
             {:id :target
              :flags ["--target"]
              :type :string
              :required? true
              :description "Bounded deployment target identifier."}
             {:id :deploy-root
              :flags ["--deploy-root"]
              :type :path
              :description "Local content-addressed deployment store root."}
             {:id :dry-run
              :flags ["--dry-run"]
              :type :boolean
              :default true
              :description "Plan without applying host-side changes."}
             {:id :revision
              :flags ["--revision"]
              :type :string
              :description "Revision to deploy or roll back to."}
             {:id :expected-deployment-head
              :flags ["--expected-deployment-head"]
              :type :string
              :description "Expected current semantic receipt CID for deployment CAS."}
             {:id :deployment-signing-key
              :flags ["--deployment-signing-key"]
              :type :path
              :description "Deploy-store controller Ed25519 seed file used to sign apply and rollback receipts."}
             {:id :artifact-manifest
              :flags ["--artifact-manifest"]
              :type :path
              :description "Build manifest whose artifact digest and semantic receipt CID must match before apply."}
             {:id :artifact
              :flags ["--artifact"]
              :type :path
              :description "Artifact bytes rehashed during v2 semantic deployment admission."}
             {:id :semantic-receipt
              :flags ["--semantic-receipt"]
              :type :path
              :description "Semantic build receipt to verify before deployment."}
             {:id :expected-semantic-receipt-cid
              :flags ["--expected-semantic-receipt-cid"]
              :type :string
              :description "Externally pinned semantic build receipt CID required for deployment."}
             {:id :allow-legacy-semantic-receipt
              :flags ["--allow-legacy-semantic-receipt"]
              :type :boolean
              :default false
              :description "Explicit migration-only opt-in for unsigned v1 semantic receipts; rejected by default."}
             {:id :trust
              :flags ["--trust"]
              :type :path
              :description "Receipt signer allow/revocation policy required by v2 deployment admission."}
             {:id :json
              :flags ["--json"]
              :type :boolean
              :description "Emit machine-readable deployment status."}]}
  {:id :hinshitsu
   :tier :m1
   :summary "Run software-quality checks (evidence, gates, coverage, visual regression) as data."
   :subcommands [:evidence :gate :coverage :mokushi]
   :options [{:id :input
              :flags ["-f" "--file"]
              :type :path
              :description "EDN evidence document, gate spec, or coverage spec."}
             {:id :operation
              :flags ["--op"]
              :type :enum
              :values [:evidence :gate :coverage :mokushi]
              :description "Quality operation. Mirrors subcommands for simple host adapters."}
             {:id :baseline
              :flags ["--baseline"]
              :type :path
              :description "Baseline artifact path for mokushi visual comparisons."}
             {:id :candidate
              :flags ["--candidate"]
              :type :path
              :description "Candidate artifact path for mokushi visual comparisons."}
             {:id :threshold
              :flags ["--threshold"]
              :type :string
              :default "0.02"
              :description "Maximum allowed RMSE distortion for mokushi visual comparisons."}
             {:id :required-check
              :flags ["--required-check"]
              :type :string
              :repeatable? true
              :description "Check name that must be present and passed for a gate to succeed."}
             {:id :json
              :flags ["--json"]
              :type :boolean
              :description "Emit machine-readable quality-check result."}]}]}
