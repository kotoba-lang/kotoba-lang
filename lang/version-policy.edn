{:kotoba.lang.version-policy/version 1
 :release/current "0.7.0"
 :release/semver-required true
 ;; T10.1: every release binds the active language profile (surface-status profile-version).
 ;;
 ;; Profile 6 is the first release whose public callable contract, grammar,
 ;; surface status, and elaboration identity all name the same profile. The
 ;; implementation remains a separate gate: docs must stay blocked until a
 ;; signed v0.7.0 implementation envelope verifies against release-trust.edn.
 :release/language-profile 6
 :release/package-contract 1
 :supported
 {:language-profile
  {3 {:status :deprecated
      :deprecated-on "2026-07-23"
      :removal-not-before "2027-01-19"}
   ;; Profile 4 treated booleans as i64 arithmetic values: `(+ (zero? x)
   ;; (pos? x))` was admitted. Profile 5 types comparisons and predicates as
   ;; `:bool`, which is both the Clojure reading and a type error for that sum.
   ;; Migration is mechanical: `(if p 1 0)` where a number was wanted.
   4 {:status :deprecated
      :deprecated-on "2026-07-30"
      :removal-not-before "2027-01-26"
      :breaking-change :bool-typed-comparisons
      :migration "wrap a predicate in (if p 1 0) where an i64 was wanted"}
   5 {:status :deprecated
      :deprecated-on "2026-08-11"
      :removal-not-before "2027-02-07"
      :breaking-change :profile-6-callable-contract
      :migration "adopt profile 6 public callable contracts and bool-typed predicates"}
   6 {:status :active}}
  :package-contract
  {1 {:status :active}}}
 :deprecation
 {:minimum-days 180
  :removal-requires-major true
  :notice-required true}
 :release-tags
 {:prefix "v"
  :algorithm :ed25519
  :external-trust-store-required true
  ;; T10.1: language-profile is part of the signed tag content binding.
  :binds #{:version :commit :tree :source-root :issued-at-ms
           :language-profile :package-contract :artifact-digests
           :conformance-result}}
 :compatibility-report
 {:format-version 1
  :unknown-version :deny
  :expired-deprecation :deny
  :stable-order true}
 ;; T10.3: surface-status diffs go in release notes (process, not automation).
 :release-notes
 {:require-surface-status-diff? true
  :surface-status-path "lang/surface-status.edn"
  :surface-matrix-path "docs/lang/surface-matrix.md"}}
