;; lang/operations.edn -- the operations of the Kotoba language, one entry each.
;;
;; root ADR-2610092330 (R0, 2026-10-09). The authority for WHAT operations
;; exist; each layer keeps its own lowering and checks its own tables against
;; this file, in both directions (scripts/check-operation-registry.cljk and
;; kotoba.lang.operation-registry-test). lang/surface-status.edn keeps WHY and
;; HOW IT WAS MEASURED; it points here for the list.
;;
;; Per entry:
;;   :family  a key of :families
;;   :arity   a number, or :any (a container of any length), :even (a map's
;;            key/value pairs), :some (at least one) -- osaho's vocabulary
;;   :params  argument types, kotoba-sema's spelling (checked against the
;;            analyser itself by kotoba.lang.operation-registry-types-test, R1);
;;            a variadic operation has
;;            :item (the type of one item, or of one [key value] pair) instead
;;   :result  the result type
;;   :type-params / :type-arg  a parametric operation (the typed map/set
;;            heads): its type variables, and the literal type passed as its
;;            first argument; :params then lists the other arguments, and the
;;            type probes instantiate the variables with concrete types
;;   :layers  per layer: :implemented, :pending, or {:status :refused :why ...}
;;            (refused BY NAME). A layer is listed only once a check reads its
;;            table; R0 checks :kotoba-sema (admission + arity), :kir (osaho's
;;            KIR admission) and :native (osaho's native admission + arity).
;;            kotoba-verifier's own native table is checked against :native
;;            (R3). JS, Wasm and the native emitter keep no table: that they
;;            RUN each operation is operation-registry-coverage-test (R2).
;;
;; Not yet here: trap names. A first extraction from osaho's evaluator
;; misattributed traps across grouped branches, so they are left for a check
;; that reads them per operation rather than guessed.
{:kotoba.lang.operations/version 1
 :kotoba.lang.operations/authority "kotoba-lang/kotoba-lang"
 :kotoba.lang.operations/adr "adr-2610092330-kotoba-operation-registry-and-one-conformance-runner"
 :checked-layers #{:kotoba-sema :kir :native}
 :families
 {:document {:adr "adr-2610092310-kotoba-document-ipld-bytes-link-and-dag-cbor-key-order"
             :surface-status [:contextual-document-literal]}
  ;; R4 (2026-10-09). guest-grammar :bytes-value is the decision; its trap
  ;; names are there too.
  :bytes {:grammar [:bytes-value]}
  ;; R4 (2026-10-09): the :vector-i64 heads the friendly ones (count, conj,
  ;; nth, pop) lower to. The f64 family is separate and not yet registered.
  :vector {:surface-status [:persistent-collection-semantics]}
  ;; R4 (2026-10-09): the :vector-f64 heads, the f64 half of :vector.
  :vector-f64 {:surface-status [:floating-point]}
  ;; R4 (2026-10-09): [:map K V]. Each operation takes the map's type as its
  ;; first argument (:type-arg); :arity counts it, as osaho does.
  :typed-map {:surface-status [:persistent-collection-semantics]}
  ;; R4 (2026-10-09): [:set T], parametric like :typed-map.
  :typed-set {:surface-status [:persistent-collection-semantics]}
  ;; R4 (2026-10-09): [:list T]. No typed-list-count: count of a list lowers
  ;; to vector-count over its carrier.
  :typed-list {:surface-status [:persistent-collection-semantics]}
  ;; R4 (2026-10-10): string-* and string=?. kotoba-sema's string-operations
  ;; table also holds host-result accessors (task-ready?,
  ;; http-response-status, ...) and keyword/symbol heads; they are not string
  ;; operations and belong to families of their own.
  :string {:grammar [:predicates]}
  ;; R4 (2026-10-10): binary64 arithmetic, bits, comparisons, the bounded
  ;; transcendentals and the i64 <-> f64 conversions (guest-grammar
  ;; :floating-point is the decision).
  :f64 {:grammar [:floating-point]}
  ;; R4 (2026-10-10): binary32 arithmetic, bits, comparisons and the width
  ;; and integer conversions. There is no binary32 literal.
  :f32 {:grammar [:floating-point]}}
 ;; Known disagreements between a layer and this file, each dated and
 ;; checked to STILL disagree -- a parking space nothing checks is not allowed.
 :known-mismatches
 {[:native document-merge :arity]
  {:as-of "2026-10-09"
   :registry 2 :layer :some
   :reason "kotoba-sema admits document-merge with exactly 2 arguments (document-fixed-operations); osaho's native admission table says :some. Admission is decided by kotoba-sema, so no program reaches native with 3; the native table is wider than the language."
   :closes-when "osaho native-document-operation-arities says 2, or kotoba-sema admits document-merge variadically and this entry says :some"}
   ;; kotoba-verifier's table, checked against the :native column as layer
   ;; :verifier (R3, operation-registry-test)
   [:verifier document-merge :arity]
   {:as-of "2026-10-09" :registry 2 :layer :some
    :reason "the same as [:native document-merge :arity]: the verifier copies osaho's native table, :some"
    :closes-when "the verifier's document-operations says 2"}
   [:verifier document-edn-print :registry-implemented-but-layer-lacks]
   {:as-of "2026-10-09"
    :reason "kotoba-verifier's document-operations omits document-edn-print and document-edn-read, which osaho's native table admits and kotoba-native implements; yet lang/conformance/document/traversal.kotoba, which calls both, compiled, signed and ran natively on 2026-10-09 (main = 12), so the verifier admits them by some other path -- not traced"
    :closes-when "the verifier's table names them, or the other path is found and this registry says how the verifier admits them"}
   [:verifier document-edn-read :registry-implemented-but-layer-lacks]
   {:as-of "2026-10-09" :reason "see [:verifier document-edn-print ...]" :closes-when "as for document-edn-print"}}
