;; lang/operations.edn -- the operations of the Kotoba language, one entry each.
;;
;; root ADR-2610092330 (R0, 2026-10-09). The authority for WHAT operations
;; exist; each layer keeps its own lowering and checks its own tables against
;; this file, in both directions (scripts/check-operation-registry.cljk and
;; kotoba.lang.operation-registry-test). lang/surface-status.edn keeps WHY and
;; HOW IT WAS MEASURED; it points here for the list.
;;
;; Per entry:
;;   :family  a key of :families
;;   :arity   a number, or :any (a container of any length), :even (a map's
;;            key/value pairs), :some (at least one) -- osaho's vocabulary
;;   :params  argument types, kotoba-sema's spelling (checked against the
;;            analyser itself by kotoba.lang.operation-registry-types-test, R1);
;;            a variadic operation has
;;            :item (the type of one item, or of one [key value] pair) instead
;;   :result  the result type
;;   :layers  per layer: :implemented, :pending, or {:status :refused :why ...}
;;            (refused BY NAME). A layer is listed only once a check reads its
;;            table; R0 checks :kotoba-sema (admission + arity), :kir (osaho's
;;            KIR admission) and :native (osaho's native admission + arity).
;;            JS, Wasm, the native emitter and the verifier join at R2 / R3.
;;
;; Not yet here: trap names. A first extraction from osaho's evaluator
;; misattributed traps across grouped branches, so they are left for a check
;; that reads them per operation rather than guessed.
{:kotoba.lang.operations/version 1
 :kotoba.lang.operations/authority "kotoba-lang/kotoba-lang"
 :kotoba.lang.operations/adr "adr-2610092330-kotoba-operation-registry-and-one-conformance-runner"
 :checked-layers #{:kotoba-sema :kir :native}
 :families
 {:document {:adr "adr-2610092310-kotoba-document-ipld-bytes-link-and-dag-cbor-key-order"
             :surface-status [:contextual-document-literal]}}
 ;; Known disagreements between a layer and this file, each dated and
 ;; checked to STILL disagree -- a parking space nothing checks is not allowed.
 :known-mismatches
 {[:native document-merge :arity]
  {:as-of "2026-10-09"
   :registry 2 :layer :some
   :reason "kotoba-sema admits document-merge with exactly 2 arguments (document-fixed-operations); osaho's native admission table says :some. Admission is decided by kotoba-sema, so no program reaches native with 3; the native table is wider than the language."
   :closes-when "osaho native-document-operation-arities says 2, or kotoba-sema admits document-merge variadically and this entry says :some"}}
 :operations
 {
  document-null
  {:family :document :arity 0 :params [] :result :document
   :layers {:kotoba-sema :implemented :kir :implemented :native :implemented}}
  document-bool
  {:family :document :arity 1 :params [:bool] :result :document
   :layers {:kotoba-sema :implemented :kir :implemented :native :implemented}}
  document-i64
  {:family :document :arity 1 :params [:i64] :result :document
   :layers {:kotoba-sema :implemented :kir :implemented :native :implemented}}
  document-f64
  {:family :document :arity 1 :params [:f64] :result :document
   :layers {:kotoba-sema :implemented :kir :implemented :native {:status :refused :why "native has no f64 text"}}}
  document-string
  {:family :document :arity 1 :params [:string] :result :document
   :layers {:kotoba-sema :implemented :kir :implemented :native :implemented}}
  document-keyword
  {:family :document :arity 1 :params [:keyword] :result :document
   :layers {:kotoba-sema :implemented :kir :implemented :native :implemented}}
  document-symbol
  {:family :document :arity 1 :params [:symbol] :result :document
   :layers {:kotoba-sema :implemented :kir :implemented :native :implemented}}
  document-vector
  {:family :document :arity :any :item :document :result :document
   :layers {:kotoba-sema :implemented :kir :implemented :native :implemented}}
  document-list
  {:family :document :arity :any :item :document :result :document
   :layers {:kotoba-sema :implemented :kir :implemented :native :implemented}}
  document-set
  {:family :document :arity :any :item :document :result :document
   :layers {:kotoba-sema :implemented :kir :implemented :native :implemented}}
  document-map
  {:family :document :arity :even :item [[:or :keyword :document] :document] :result :document
   :layers {:kotoba-sema :implemented :kir :implemented :native :implemented}}
  document-count
  {:family :document :arity 1 :params [:document] :result :i64
   :layers {:kotoba-sema :implemented :kir :implemented :native :implemented}}
  document-kind
  {:family :document :arity 1 :params [:document] :result :keyword
   :layers {:kotoba-sema :implemented :kir :implemented :native :implemented}}
  document-sha256
  {:family :document :arity 1 :params [:document] :result :string
   :layers {:kotoba-sema :implemented :kir :implemented :native {:status :refused :why "canonical bytes as a digest are not lowered on native yet"}}}
  document-print
  {:family :document :arity 1 :params [:document] :result :string
   :layers {:kotoba-sema :implemented :kir :implemented :native {:status :refused :why "canonical bytes as hex are not lowered on native yet"}}}
  document-read
