 :diagnosis
 {:why-tail-append-is-insufficient
  {:mechanism
   "amu/seed/76-x86_64-static-rt.kotoba:258-268 (kxrt-concat) and the kexe
    loader tail-append fast path only skip copying `a` when `(- -1 oa) + la ==
    string_pool_used` — i.e. when `a` sits at the exact bump top of the global
    string_pool."
   :failure-mode
   "Any realistic text processor (such as docs_page.kotoba:60-73 inline and
    104-132 markdown) allocates temporary strings (trimmed lines, escaped text,
    nested inline fragments, table cells, hrefs) BETWEEN appends to `out`.
    Each temporary allocation moves `string_pool_used` past `out`, permanently
    evicting `out` from the pool top and forcing full O(|out|) copies into dead
    pool bytes on subsequent appends -> O(N^2) copy time and O(N^2) bump memory.
    The 2-tier 4 KiB accumulator in amu/seed/60-proj.kotoba:746-768 only divides
    the quadratic constant by ~4096 and remains O(N^2) asymptotically."}
  :existing-primitive-gaps
  [{:id :string-join-limit
    :where "lang/pure-product-profile.edn:37, docs/lang/string-kit.md:11,30"
    :gap "Compile-time macro sugar capped at <= 8 literal parts; cannot accumulate dynamic loops."}
   {:id :seed-21-check-helper-lowering
    :where "amu/seed/21-check.kotoba:7291,7293; seed/05-checked-source.kotoba:161-179,358; seed/12-kirread.kotoba:1939-1943"
    :gap "string-index-of-from and string-append-range expand to R6F helper defn-s
          calling string-substring (which is a 0-pool-byte view in seed/76,77,macos,
          NOT a byte copy). The actual gaps confirmed by AmuSpec are: (i) 1 pair
          handle consumed per string-index-of-from call and 2 per string-append-range,
          burning the pair arena in hot loops; (ii) naive O(N*M) substring search
          loops in seed/76,77,macos; (iii) missing dsb-op entries in
          seed/05-checked-source.kotoba:161-179,358 causing Definition CID mismatch
          vs kotoba-sema; and (iv) static refusal of ABI slots 272/344 in
          compile-kir (seed/12-kirread.kotoba:1939-1943)."}
   {:id :osaho-reference-budget-bypass
    :where "kotoba/lib/kotoba.osaho/src/kotoba/kir.cljk:4181-4182,4213-4215"
    :gap "KIR reference evaluator omits value/bounded-string! and charge-bytes! on
          string-fold-ascii and string-append-range. Tier 1 :text-builder
          implementations in osaho MUST NOT repeat this bypass on
          text-builder-append-range or other builder operations."}
   {:id :macos-macho-runtime-cliffs
    :where "amu/seed/macos-fs2-runtime-packager.kotoba:365-399,582-614; io_buffer.kotoba:49-59"
    :gap "On macOS Mach-O: vector-conj (L595-614) lacks growth regions/tail-append
          and copies O(N^2); bytes-slice (L582-591) copies into pool instead of
          returning a view; stdout wire 37 (L365-399) uses unbuffered SYS_write
          and interns a decimal byte-count string per call into the 256 MiB pool;
          io_buffer.kotoba:49-59 append-chunk is O(K^2) on Linux and O(K^3) on
          macOS; pool exhaustion emits raw brk #0 (SIGTRAP) instead of structured
          KEXE_TRAP + exit 120."}
   {:id :missing-linear-return-composition
    :where "lang/surface-status.edn:541-551"
    :gap "Existing affine analysis refuses returning a linear handle from a helper or
          passing it into a helper, blocking modular O(N) builder threading across
          markdown -> paragraph -> inline -> esc."}]}

 :tiers
 {:tier-0-portable-interim
  {:profile "Profile 6 (today, zero compiler/ABI change)"
   :asymptotic-bound :o-n-log-n
   :final-solution false
   :techniques
   [{:name :binary-carry-chunk-tree
     :mechanism "Maintain log2(K) balanced-size slots (in a small vector/record of strings) merging equal-order chunks on carry; each byte moves <= log2(N/B) times."
     :complexity "O(N log N) time and pool bytes; compatible with Profile 6 without new primitives."}
    {:name :direct-bounded-chunked-io-write
     :mechanism "Emit completed blocks/sections directly to :io/write in <= 65,536-byte chunks instead of materializing a monolithic HTML string; compatible with FS2 kind-10/11 chunked I/O."
     :complexity "O(N) I/O streaming when individual section blocks stay small and host stdout wire 37 is buffered/non-allocating."}
    {:name :offset-search-replacement
     :mechanism "Replace `(string-index-of (string-substring s i (size s)) p)` with `(string-index-of-from s p i)` (keeping outer out-of-range `i` bounds guard) once AmuSpec/Amu resolves slot 272 lowering and pair-handle/O(N*M) costs."
     :complexity "Avoids explicit substring construction in guest code once lowered directly to slot 272."}]
   :macos-prerequisites
   "On macOS Mach-O, Amu must remove per-call wire-37 stdout string-pool interning (macos-fs2-runtime-packager.kotoba:365-399) and linearize io_buffer.kotoba:49-59 (currently O(K^3)) and vector-conj (L595-614, currently O(N^2)) before Tier 0 chunked :io/write achieves linear scaling there."
   :constraints "Tier 0 is explicitly an interim mitigation; it does NOT satisfy KOTOBA-989's O(N) amortized R2 exit gate."}

  :tier-1-standard-text-builder
  {:profile "Phase 2 / KOTOBA-989 target standard API"
   :asymptotic-bound :o-n-amortized
   :final-solution true
   :value-type :text-builder
   :semantic-model
   {:abstract-state "{:max-bytes :i64, :utf8-bytes :bytes (always canonical UTF-8)}"
    :equational-meaning "100% pure value semantics: every builder operation denotes a pure function from abstract builder state to (next-builder | scalar/string/list) or deterministic named trap; no ambient heap is observable."}
   :ownership
   {:discipline :single-threaded-affine-with-linear-return
    :rationale "Applies the ACL2 stobj / Kotoba affine-vector principle: syntactic single-threaded use preserves pure equational reasoning while permitting O(1) amortized in-place buffer/chunk growth decoupled from string_pool_used."
    :consuming-ops
    #{text-builder-append
      text-builder-append-range
      text-builder-append-i64
      text-builder-append-code-point
      text-builder-finish
      text-builder-finish-chunks
      text-builder-finish-bytes-chunks}
    :read-only-inspect-ops
    #{text-builder-byte-length
      text-builder-remaining}
    :inspect-rule
    "Read-only inspect ops may read a live builder binding BEFORE its single consuming use on the same control-flow path without consuming it (or via a non-escaping pure inspect position). Using an inspect op AFTER the binding was consumed is :kotoba.error/affine-use."
    :linear-return-rule
    "Resolves lang/surface-status.edn:541-551. A module-internal `defn-` taking `b :text-builder` and returning `:text-builder` (or a closed record containing exactly one `:text-builder` return field) whose body threads `b` affinely along every non-trapping path MUST be admitted as `:linear-return`. At call sites, passing a live builder to a `:linear-return` helper consumes the argument handle and binds the returned handle as a fresh live linear value, checked via call-graph fixpoint within the closed compilation unit."
    :branch-rule
    "Along mutually exclusive `if` / `cond` / `case` branches, each branch independently satisfies affine use (either consuming into the same joined result type, passing into an early-refusal return that drops the builder, or returning the derived `:text-builder`)."
    :drop-allowed true
    :drop-note "Dropping an unconsumed :text-builder on an early refusal/error branch is valid. Inside `(arena-scope ...)`, any temporary builder buffer allocated within that scope is reclaimed on scope exit; returning `:text-builder` across an `arena-scope` boundary is forbidden just like returning `:string`."
    :compile-time-refusals
    [{:code :kotoba.error/affine-use
      :when "A :text-builder binding is passed to two consuming operations on the same path, used after consumption, or aliased to two live names via `let` binding."}
     {:code :kotoba.error/affine-escape
      :when "A :text-builder binding is captured by an `fn` literal/closure, stored inside a `:document`, `:list`, `:map`, `:set`, or non-linear record, or returned across an `arena-scope` boundary."}
     {:code :kotoba.error/affine-export
      :when "A :text-builder appears in a public module `:export` parameter/return signature or across an untrusted host export boundary."}]}}}

 :operations
 {:text-builder-new
  {:arity 1 :params [:i64] :result :text-builder
   :signature "(text-builder-new max-bytes)"
   :semantics "Creates a fresh empty :text-builder with hard capacity limit `max-bytes`. Implementations MUST allocate lazily (starting at small initial capacity such as `min(max-bytes, 256)` bytes) and MUST NOT eagerly allocate `max-bytes` bytes."
   :traps [:text-builder/invalid-limit :text-builder/limit-exceeded :budget/cells :budget/bytes]}

  :text-builder-append
  {:arity 2 :params [:text-builder :string] :result :text-builder
   :signature "(text-builder-append b s)"
   :semantics "Consumes `b` and returns a builder holding `(bytes-of b) || (utf8-bytes s)`. Appending the empty string `\"\"` is an O(1) no-op (after handle validation). Does not require `b` to sit at `string_pool_used` top."
   :traps [:trap/invalid-handle :utf8/invalid-byte :text-builder/overflow :budget/bytes]}

  :text-builder-append-range
  {:arity 4 :params [:text-builder :string :i64 :i64] :result :text-builder
   :signature "(text-builder-append-range b s start end)"
   :semantics "Consumes `b` and appends UTF-8 slice `s[start, end)` directly into `b` WITHOUT minting an intermediate `:string` handle or intermediate copy. Validates `0 <= start <= end <= (string-byte-length s)` and UTF-8 code-point boundaries at `start` and `end`, and enforces `:bytes` charging."
   :traps [:trap/invalid-handle :substring/bounds :substring/code-point-boundary :text-builder/overflow :budget/bytes]}

  :text-builder-append-i64
  {:arity 2 :params [:text-builder :i64] :result :text-builder
   :signature "(text-builder-append-i64 b n)"
   :semantics "Consumes `b` and appends the exact signed base-10 ASCII decimal representation of `n` (bit-for-bit identical to `string-from-i64`, including `-9223372036854775808` and `0`) directly into `b` without allocating a temporary `:string`."
   :traps [:trap/invalid-handle :text-builder/overflow :budget/bytes]}

  :text-builder-append-code-point
  {:arity 2 :params [:text-builder :i64] :result :text-builder
   :signature "(text-builder-append-code-point b cp)"
   :semantics "Consumes `b` and appends the canonical 1..4-byte UTF-8 encoding of Unicode scalar value `cp`. Rejects negative values, UTF-16 surrogates (`0xD800..0xDFFF`), and values `> 0x10FFFF` with deterministic named traps before capacity allocation."
   :traps [:trap/invalid-handle :utf8/surrogate :utf8/above-max :text-builder/overflow :budget/bytes]}

  :text-builder-byte-length
  {:arity 1 :params [:text-builder] :result :i64
   :signature "(text-builder-byte-length b)"
   :semantics "Non-consuming O(1) read-only inspect returning the current UTF-8 byte count accumulated in `b`."
   :traps [:trap/invalid-handle]}

  :text-builder-remaining
  {:arity 1 :params [:text-builder] :result :i64
   :signature "(text-builder-remaining b)"
   :semantics "Non-consuming O(1) read-only inspect returning `(- max-bytes (text-builder-byte-length b))`."
   :traps [:trap/invalid-handle]}

  :text-builder-finish
  {:arity 1 :params [:text-builder] :result :string
   :signature "(text-builder-finish b)"
   :semantics "Consumes `b` and materializes a canonical UTF-8 `:string`. If accumulated byte length exceeds the active profile's `:string-value-max` (e.g., 65,536 on portable profiles; see lang/text-tool-budgets.edn Decision D1), fails closed with `:string/too-large`."
   :traps [:trap/invalid-handle :string/too-large :budget/bytes :budget/cells]}

  :text-builder-finish-chunks
  {:arity 2 :params [:text-builder :i64] :result [:list :string]
   :signature "(text-builder-finish-chunks b max-chunk-bytes)"
   :semantics "Consumes `b` and returns an ordered `[:list :string]` whose concatenation equals `(bytes-of b)`. `max-chunk-bytes` MUST be in `[4, active-profile-string-value-max]` (lower bound 4 guarantees any single canonical UTF-8 scalar value 1..4 bytes fits). Every chunk is non-empty canonical UTF-8 of byte length `<= max-chunk-bytes`, split strictly on UTF-8 code-point boundaries (never splitting a multi-byte character). An empty builder returns the empty list `[]`. Allows portable profiles (`:string-value-bytes = 65536`) to emit arbitrary >64 KiB outputs without violating per-string value bounds."
   :traps [:trap/invalid-handle :text-builder/invalid-chunk-size :budget/bytes :budget/cells]}

  :text-builder-finish-bytes-chunks
  {:arity 2 :params [:text-builder :i64] :result [:list :bytes]
   :signature "(text-builder-finish-bytes-chunks b max-chunk-bytes)"
   :semantics "Optional FS2 companion (`byte-chunks-v1`, kind 11). Consumes `b` and returns `[:list :bytes]` with `max-chunk-bytes` in `[1, active-profile-bytes-value-max]`, enabling direct zero-string-redecode streaming to `:fs/app-data` FS2 kind 11."
   :traps [:trap/invalid-handle :text-builder/invalid-chunk-size :budget/bytes :budget/cells]}}

 :trap-precedence
 [{:stage 1 :name :handle-and-abi-validity
   :traps [:trap/invalid-handle]
   :rule "Invalid context version or forged/invalid builder handle traps fail-closed before inspecting arguments."}
  {:stage 2 :name :argument-domain-and-utf8
   :traps [:text-builder/invalid-limit
           :text-builder/limit-exceeded
           :text-builder/invalid-chunk-size
           :substring/bounds
           :substring/code-point-boundary
           :utf8/invalid-byte
           :utf8/surrogate
           :utf8/above-max]
   :rule "Domain checks (`max-bytes < 0` -> `:text-builder/invalid-limit`; `max-bytes > profile-builder-max` -> `:text-builder/limit-exceeded`; `max-chunk-bytes < 4` or `> string-value-max` -> `:text-builder/invalid-chunk-size`), slice bounds, UTF-8 code-point boundary checks, and canonical UTF-8 checks run BEFORE builder capacity or host pool checks."}
  {:stage 3 :name :builder-capacity
   :traps [:text-builder/overflow]
   :rule "If `(+ used add-len) > max-bytes` (overflow-safe), trap `:text-builder/overflow` BEFORE requesting host pool growth so builder limits behave identically across all backends regardless of host memory size."}
  {:stage 4 :name :host-resource-budgets
   :traps [:string/too-large :budget/bytes :budget/cells :budget/fuel]
   :rule "Output `:string` value bound (`finish`) and profile meters (`:bytes`, `:cells`, `:fuel`)."}]

 :complexity-contract
 {:time :o-k-plus-n-amortized
  :note "For `K` operations producing `N` total UTF-8 bytes, total CPU work and total bytes copied MUST be O(K + N), independent of how many temporary strings or vectors are allocated between builder calls."
  :copy-factor-max-geometric 3.0
  :copy-factor-max-chunked-seal 1.0
  :interleaving-invariance true
  :interleaving-invariance-rule
  "Allocating arbitrary temporary strings/vectors between builder operations MUST NOT evict the builder from its fast path or increase copied-bytes growth beyond linear."
  :no-eager-max-allocation true
  :no-eager-max-allocation-rule
  "`(text-builder-new 8388608)` producing 512 bytes MUST NOT reserve or charge 8 MiB in host RSS or `:budget/bytes`."}

 :native-abi-boundary
 {:v11-immutability "Context ABI v11 slots 0..384 MUST NOT be mutated or repurposed."
  :versioned-extension "Native support requires a versioned context ABI extension (e.g. context ABI v13+ negotiated cleanly alongside v12 gas) with dedicated builder descriptor/arena slots."
  :pool-isolation "Builder growth buffers / chunk chains MUST live in a dedicated builder arena or chunk chain decoupled from global `string_pool_used` top, avoiding O(N^2) dead-tail waste on interleaved allocations and respecting `(arena-scope ...)` marks."
  :macos-prerequisites
  ["Linearize `vector-conj` (`amu/seed/macos-fs2-runtime-packager.kotoba:595-614`, currently O(N^2) copy without growth regions) before `text-builder-finish-chunks` / `text-builder-finish-bytes-chunks` can qualify on macOS."
   "Restore `bytes-slice` (`L582-591`) to zero-copy view semantics and remove wire-37 `stdout` (`L365-399`) per-call 256 MiB string-pool interning."
   "Linearize `io_buffer.kotoba:49-59` (`append-chunk`, currently O(K^2) Linux / O(K^3) macOS)."
   "Replace macOS raw `brk #0` (`SIGTRAP`) on pool exhaustion with structured `KEXE_TRAP` + exit `120` matching Linux static-rt."]
  :alignment-target "AmuSpec audits Linux (`76-x86_64-static-rt.kotoba` / `77-aarch64-static-rt.kotoba`) and macOS Mach-O (`fs2-cli-stdio-general` / `macos-fs2-runtime-packager.kotoba`) parity."}

 :cross-backend-equivalence
 {:backends #{:kir-oracle :restricted-esm :wasm32 :native-x86_64 :native-aarch64}
  :rule "All claiming backends MUST produce bit-for-bit identical UTF-8 output bytes and identical stage 2-3 trap classifications for every admitted program. Profiles where `:bytes` or `:cells` are unmetered still enforce stage 2-3 `:text-builder/*` traps identically."
  :kir-oracle-budget-enforcement
  "In `kotoba.osaho` (`kotoba/lib/kotoba.osaho/src/kotoba/kir.cljk`), existing `string-fold-ascii` (L4181-4182) and `string-append-range` (L4213-4215) bypass `value/bounded-string!` and `charge-bytes!`. Every `:text-builder` operation added to `osaho` — especially `text-builder-append-range` — MUST call both `value/bounded-string!` / stage 2-3 guards and `charge-bytes!`."}

