 :dispositions
 {:intentional-security-constraint
  {:meaning "Excluded to preserve a named component safety invariant; widening requires an ADR and fail-closed enforcement."}
  :intentional-semantic-simplification
  {:meaning "Deliberately narrower than Clojure for deterministic, portable, or verifiable execution."}
  :implemented-partial
  {:meaning "Usable in at least one current backend, with the recorded semantic or parity limits."}
  :not-yet-implemented
  {:meaning "Not a safety prohibition; representation, bounded semantics, conformance, or backend parity is unfinished."}}

 :invariants
 {:bool-is-a-type-not-a-number
  {:disposition :intentional-semantic-simplification
   :profile-introduced 5
   :surface #{= < > <= >= not not= zero? pos? neg? empty? some?}
   :reason "Comparisons and predicates are `:bool`. Profile 4 made them i64 so
            `(+ (zero? x) (pos? x))` was admitted; that is a type error in
            Clojure and it prevented `and`/`or`/`not` from composing into a
            readable predicate. Migration is mechanical: `(if p 1 0)`."
   :representation "A plain 0/1 word — identical to `:i64` at runtime on both
                    the KIR interpreter and wasm32, so `:bool` does not promote
                    a module to the typed value profile and composes with pair
                    and collection operations."
   :evidence "docs/adr/ADR-reliability-record-access-and-bool-comparisons.md"}
  :no-implicit-numeric-conversion
  {:disposition :intentional-semantic-simplification
   :surface #{+ - * / < > <= >= =}
   :reason "Mixed numeric operand types (:i64 / :f64 / :f32) are refused naming
            both types and the explicit conversions (i64-to-f64-checked /
            -rounded, f64-to-i64-checked / -truncating, i64-to-f32-checked /
            -rounded, f32-to-i64-checked / -truncating, f32-to-f64-exact,
            f64-to-f32-rounded). A silent promotion would make `(+ a b)` mean
            different things on different backends and hide the rounding the
            author never wrote."
   :resolution {:status :implemented-partial
                :backends #{:compiler}
                :rule "plain operators resolve by operand type: all-i64 unchanged; all-f64 -> f64-*; all-f32 -> f32-*; `/` has no i64 reading (integer division is quot); quot and bit operations are integer-only"
                :grammar "lang/guest-grammar.edn :sugar :type-directed-arithmetic"
                :refusal-code :kotoba.error/numeric-type-mismatch
                :fail-closed "kotoba-sema check-value-types! refuses a plain operator that still carries float operands after resolution (:kotoba.error/numeric-resolution-unresolved)"
                :measured {:as-of "2026-09-02" :kotoba-sema "f9764cb1"
                           :evidence "kotoba-sema test/kotoba/compiler/type_directed_arithmetic_test.clj: 18 tests / 50 assertions; integer-only programs emit byte-identical KIR before and after"}
                :known-gap "loop helpers default their result type to :i64, so an f64 accumulator in loop/recur is refused (`if branches must have the same value type`) with or without resolution -- pre-existing, not introduced here"}
   :decided-by "90-docs/adr/2609021600-kotoba-unison-deepening-five-priorities (superproject)"}
  :no-ambient-authority
  {:disposition :intentional-security-constraint
   :shielding-axis :code-identity
   :surface #{load load-file load-string read-string compile
              require use ns-resolve resolve}
   :reason "Components cannot manufacture code or authority from ambient process state.
            Source strings, reader forms, loaded namespaces, and compiled host
            objects were never effect-inferred and are not part of a definition
            CID. The admitted `(eval request)` operation is therefore separate:
            it selects already checked KIR by CID through :code/eval and is
            re-admitted by the host."
   :adr "docs/adr/ADR-safe-capability-language.md"
   :adr-covers "S1 deny-by-default: host eval / load-string / read-string / require / use / import / in-ns / resolve; typed eval is decided separately by ADR-kotoba-typed-eval."}
  :no-interop
  {:disposition :intentional-security-constraint
   :shielding-axis :dispatch-bypass
   :surface #{import new . ..}
   :reason "Arbitrary JVM/JS object and method access bypasses capability admission.
            Unrelaxable by grant dispatch: interop never reaches
            guard-component-ability-call, so grant intersection, receipts and
            revocation cannot see the call. Vacuous on the wasm32 ABI (no such
            path exists); load-bearing at portable/trusted, where the subset gate
            is the only boundary (no separate VM sandbox is claimed there)."
   :adr "docs/adr/ADR-safe-capability-language.md"
   :adr-covers "S1 deny-by-default: host interop syntax — (.method obj) / (. obj ...) / (Class. args) / (new ...) / .."}
  :no-ambient-mutation
  {:disposition :intentional-security-constraint
   :shielding-axis :authority
   ;; `deref` joined this set on 2026-09-02: it is how a cell is READ, so it
   ;; belongs to the same invariant as the heads that write one.
   :surface #{set! alter-var-root atom swap! reset! deref ref dosync volatile! binding var}
   ;; Admitted VIA ELABORATION since 2026-09-02 (lang/local-state.edn, slice 1)
   ;; and therefore excused from :forbidden-heads -- see
   ;; kotoba.lang.grammar-authority/security-constraint-surfaces, which
   ;; subtracts this set rather than excusing the whole entry the way
   ;; :enforcement :tracked-elaboration does. The REST of :surface is still
   ;; refused by the head, and this entry is still an
   ;; :intentional-security-constraint: what it protects is that state is not
   ;; AMBIENT, and a cell that cannot be named outside one function body,
   ;; cannot be stored, and does not exist at runtime is not ambient state.
   :admitted-via-elaboration #{atom swap! reset! deref}
   :conformance :local-state-slice-1-counter-in-a-let
   :widening-path {:mechanism :state-kit-desugar
                   :covers #{atom swap! reset! volatile! ref dosync}
                   :preconditions [:state-kit-backend-qualification
                                   :capability-handle-storage-rejected-by-schema
                                   :effect-row-shows-state
                                   :conformance-vectors-positive-and-negative]
                   ;; A precondition list nothing measures is a list, not a
                   ;; gate: every reader has to re-derive how far the path is,
                   ;; and one of these four reads as satisfied while being
                   ;; satisfied only by the absence of the thing it constrains.
                   :precondition-status
                   {:as-of "2026-08-31"
                    :state-kit-backend-qualification
                    {:status :partial
                     :met #{:reference :wasm-aot :jit}
                     :pending #{:wasm32-kotoba-v1 :native-aot}
                     :source "amu resources/kotoba/lang/capability-kits/state-v1.edn :qualification"
                     :note "The two pending backends are the ones a shipped guest runs on, so :partial here does not mean nearly."}
                    :capability-handle-storage-rejected-by-schema
                    {:status :vacuous
                     :why "A capability handle is not a value in the source surface at all: cap-acquire and has-capability? are listed in the grammar's :admitted-builtins but the frontend answers `operation has no admitted type signature` and `operation has no admitted lowering` for them (measured 2026-08-31). Nothing can be stored, so nothing rejects storing it."
                     :hazard "This holds because the feature is absent, not because a check enforces it. The day handles become values it stops holding, and no test says so."
                     :pinned-by "test/kotoba/lang/widening_precondition_test.clj -- the four refusals are asserted by their exact message, so giving handles a type turns them red and forces the choice (write the storage rejection, or widen without it) instead of letting it pass unnoticed."}
                    :effect-row-shows-state
                    {:status :met
                     :evidence "(state/transact x) analyses to :named-operations #{:state/transact} (measured 2026-08-31). HIR's :effects row still carries the wire id [:cap/call 8], and that is correct: the id is what KIR, admission, the emitters and the host runtime agree on. What was drift is that the id reached a PERSON. Closed 2026-09-01 in kotoba-lang/amu#729: `kotoba.compiler.capability-names` names grants on the way out of `check` (which also now reports :named-operations) and on the way out of an admission denial, and accepts [:cap/call :state/transact] on the way in through --policy. ex-data keeps the wire form; prose gets names. Measured there: same source, same output path, byte-identical .wasm and .provenance.edn before and after, and again with the policy spelled in names."}
                    :conformance-vectors-positive-and-negative
                    {:status :not-met
                     :evidence "lang/capability-conformance carries 25 fixtures and none concerns :state."
                     :note "These vectors describe the DESUGAR, which does not exist yet, so this precondition cannot be advanced before the lowering is written. That is not circular with the fail-closed rule: what must not move first is :forbidden-heads, not the lowering."}}
                   ;; UNCHANGED by local-state slice 1, and the vacuous one
                   ;; especially. Slice 1 gives capability handles no type and
                   ;; no lowering: a cell is not a value, so it cannot hold a
                   ;; handle either, and the four refusals
                   ;; widening_precondition_test.clj pins are still the exact
                   ;; refusals the frontend gives. Nothing on this path moved.
                   :unchanged-by :local-atom-elaboration
                   :decided-by "adr-2608301500-guest-syntax-restrictions-classified-by-shielding-mechanism"}
   ;; The SECOND widening path on this entry. It is not the state kit and does
   ;; not advance the state kit's preconditions: it removes the need for a host
   ;; from the one shape that never needed one.
   :local-atom-elaboration
   {:mechanism :local-atom-elaboration
    :status :slice-1-implemented
    :covers #{atom swap! reset! deref}
    :contract "lang/local-state.edn"
    :landed "2026-09-02"
    :model "Unison Ref-shaped, compiled away: state passing over ordinary let bindings. No host, no grant, no runtime cell, nothing on the effect row."
    :scope "A cell bound by (atom init) as a let-binding init, used only as the first argument of swap!/reset!/deref, in straight-line code (nested let/do/if/when/cond/case) of the SAME function body."
    :out-of-scope "An atom that escapes, persists, or crosses a function stays on the :state-kit-desugar path above -- host kit, grant at instantiation, effect row. That work is NOT done here."
    :evidence
    {:elaboration "kotoba-sema src/kotoba/compiler/frontend.cljc `elaborate-local-state`, run on SOURCE before desugaring. A body that mentions none of the four heads is returned identical, so no other program's lowering moves."
     :effect-row "Nothing is added. The cell does not exist at runtime, so there is no authority to declare. :named-operations gains :local-state so the elaboration is visible in check output and provenance."
     :type-rule "The cell's type is its init's; every rebinding is tied to it in kotoba.compiler.frontend/local-state-check-cell-type!, which names both types when they disagree."
     :byte-identity "test/kotoba/compiler/local_state_test.clj pins the HIR and KIR sha256 of an atom-free program taken before the pass existed."
     :tests "kotoba-sema test/kotoba/compiler/local_state_test.clj; conformance under lang/conformance/local-state, negatives pinned by exact message."}
    :preconditions [:non-escaping-cell-enforced
                    :branch-join-is-total
                    :conformance-vectors-positive-and-negative]
    :precondition-status
    {:as-of "2026-09-02"
     :non-escaping-cell-enforced
     {:status :met
      :evidence "Every mention of a cell that is not the first argument of swap!/reset!/deref is refused: `atom `a` escapes its let scope (atom slice 1 admits swap!/reset!/deref in straight-line code of the binding function only)`. Pinned by :local-state-slice-1-negative-escapes-as-an-argument, -escapes-into-a-fn and -read-inside-a-loop."
      :why-it-is-the-load-bearing-one "It is what makes the state non-ambient. If a cell could be named anywhere else, the elaboration would be a mutation feature rather than a widening of this invariant."}
     :branch-join-is-total
     {:status :met
      :evidence "A branching form that writes is emitted once per mutated cell plus once for its own value, so every arm contributes a binding for every cell the join rebinds. A cond that writes must end with :else, and an if that writes must have all three parts, so no arm is implicit."
      :bounded-by "The copy count is (mutated cells + 1) per branching form and the existing :max-lowered-nodes budget refuses a program that outgrows it."
      :refused-rather-than-duplicated "A branch that both writes a cell and calls a capability: copying it would duplicate the effect, so it is refused."}
     :conformance-vectors-positive-and-negative
     {:status :met
      :positive ["lang/conformance/local-state/counter_in_a_let.kotoba"
                 "lang/conformance/local-state/atom_through_an_if.kotoba"
                 "lang/conformance/local-state/swap_with_extra_arguments.kotoba"]
      :negative ["lang/conformance/local-state/negative/escapes_as_an_argument.kotoba"
                 "lang/conformance/local-state/negative/escapes_into_a_fn.kotoba"
                 "lang/conformance/local-state/negative/read_inside_a_loop.kotoba"
                 "lang/conformance/local-state/negative/swap_changes_the_type.kotoba"
                 "lang/conformance/local-state/negative/deref_of_a_non_cell.kotoba"]
      :executed-by "test/kotoba/lang/local_state_conformance_test.clj; negatives pinned by exact message"}}
    :decided-by "adr-2608301500-guest-syntax-restrictions-classified-by-shielding-mechanism"}
   :reason "External mutable state is provider-owned and capability/policy mediated; component-local state must use an explicitly bounded model.
            The invariant is AMBIENT, not mutation itself. Since 2026-09-02 that
            reading has two consequences instead of one. A cell that escapes,
            persists, or crosses a function is provider-owned and stays on the
            :state-kit-desugar path (effect row shows :state, a grant is required
            at instantiation, capability handles are rejected as stored values).
            A cell that does neither -- (let [a (atom 0)] (swap! a + 1) @a) --
            needs no host at all: local-state slice 1 elaborates it into ordinary
            let rebindings, so nothing observes it but the straight-line code
            that owns it and no cell exists at runtime. atom / swap! / reset! /
            deref are therefore admitted-via-elaboration, and refused the moment
            the cell would escape. ref / dosync / volatile! / binding / var /
            alter-var-root / set! have no ability model decided and stay
            rejected fail-closed."
   :adr ["docs/adr/ADR-safe-capability-language.md"
         "adr-2608301500-guest-syntax-restrictions-classified-by-shielding-mechanism"]
   :adr-covers "S1 deny-by-default: mutable reference types — atom / swap! / reset! / volatile! / ref / ref-set / alter / dosync / agent / send / add-watch. The ADR named swap! and reset! from the start; guest-grammar carried neither until 2026-08-12. Slice 1 of the local-atom elaboration landed 2026-09-02 (lang/local-state.edn): the three heads it covers are admitted only where the cell provably does not escape one function body, which is the same deny-by-default read of :authority the ADR states — a definition CID and a grant intersection can decide who may hold state, and a cell nobody can hold needs neither."}
  :no-unbounded-concurrency
  {:disposition :intentional-security-constraint
   :shielding-axis :resource-bounds
   :surface #{future pmap agent send send-off locking}
   :reason "Component scheduling and resources must remain tender-controlled and bounded.
            Neither definition CIDs nor delegated grants meter CPU or scheduling;
            fuel is per-instance and ambient threads would escape it. A
            structured-spawn ability with sub-budgeted fuel is designable but
            undecided; no widening path yet."
   :adr "docs/adr/ADR-safe-capability-language.md"
   :adr-covers "S1 deny-by-default: ambient concurrency — future / promise / pmap / locking."}
  :no-guest-macros
  {:disposition :intentional-security-constraint
   :shielding-axis :code-identity
   :surface #{defmacro}
   :reason "The safe component surface must be statically inspectable before execution.
            Unrelaxable: expansion executes code inside the compiler (build time),
            and the definition CID hashes post-desugar typed KIR, so unbounded
            macros both run early and make source identity unreviewable.
            defdesugar (bounded pure desugar) remains the admitted alternative."
   :adr "docs/adr/ADR-safe-capability-language.md"
   :adr-covers "S1 deny-by-default: user defmacro. Built-in macro allowlist (-> / cond / case / threading) still expands."}
