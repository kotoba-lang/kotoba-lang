    :mentioned-outside-a-slice-position :kotoba.error/slice-escape
    :given-to-a-non-slice-parameter :kotoba.error/slice-operand
    :wrong-element-width :kotoba.error/slice-element-mismatch
    :computed-base :kotoba.error/slice-region-provenance
