 :classification-rule
 {:default-for-missing :not-yet-implemented
  :security-constraint-requires [:named-invariant :fail-closed-enforcement :adr]
  ;; How each of those three is checked, so the requirement is not a claim the
  ;; file makes about itself. All three run in `grammar-authority/validate` and
  ;; are pinned by `test/kotoba/lang/grammar_authority_test.clj`.
  :security-constraint-checks
  {:named-invariant "the entry key, plus :forbidden/unclassified-by-surface — every forbidden head must be classified by some invariant"
   :fail-closed-enforcement ":forbidden/security-surface-not-forbidden — every form a security constraint names must be in guest-grammar :forbidden-heads, which the compiler unions into its own set via the vendored catalog"
   :adr ":security/constraint-missing-adr and :security/adr-path-unresolved"}
  ;; Portable claims that name no conformance case at all. Such an entry is
  ;; checked by nothing: `portable-without-evidence` requires a `:conformance`
  ;; before it looks at anything, and `conformance-matrix/validate-claims` only
  ;; validates links that exist — so claiming all three backends and naming no
  ;; case is strictly less checked than naming one badly.
  ;;
  ;; This register makes the debt a ratchet rather than a wall. A claim listed
  ;; here is grandfathered; one that is not fails
  ;; `:portable/claim-without-conformance`. An entry that gains a link must be
  ;; removed, or `:portable/conformance-debt-stale` fails — so the list shrinks
  ;; as work lands and cannot quietly grow.
  ;;
  ;; Measured 2026-08-12: 18 entries qualify as portable claims
  ;; (`portable-backends ⊆ :implementation`), 8 carry a link, these 10 do not.
  ;; Nothing here is a statement that the feature is unsupported — only that no
  ;; conformance case is named for it.
  ;; The tokens `:implementation` sets are allowed to contain. This freezes the
  ;; current ten so a new one cannot appear silently; it does NOT bless them.
  ;;
  ;; Measured 2026-08-12: this is a third, informal backend namespace. Two real
  ;; closed vocabularies exist and neither shares a single token with it —
  ;; `kotoba-kir/src/kotoba/kir/target.cljc` `compatibility-targets`
  ;; (:wasm32-kotoba-v1 :x86_64-kotoba-v1 :aarch64-kotoba-v1 :cljs-kotoba-v1
  ;; :js-kotoba-v1) and `lang/conformance/manifest.edn` `:backends`
  ;; (:kir :wasm32-kotoba-v1 :js-kotoba-v1 :native-x86_64 :native-aarch64
  ;; :host-clj :host-cljs :compiler-admit). Before this entry nothing defined,
  ;; enumerated or constrained these tokens: `surface-matrix/backends-of` joins
  ;; whatever set it finds into a markdown column, so any keyword rendered.
  ;;
  ;; Consequence, and the reason `:backend-parity-evidence` is still unchecked:
  ;; a linked conformance case declares `:required-backends #{:kir
  ;; :wasm32-kotoba-v1}`, and there is no expressible comparison between that
  ;; and an `:implementation` of #{:compiler :kotoba-wasm :kotoba-cljs}. So
  ;; `:kotoba-cljs`, asserted on 19 entries, is entailed by no case anywhere.
  ;; Reconciling the three namespaces is a decision about the authority, not
  ;; something a check can take — it is recorded here rather than guessed at.
  :implementation-vocabulary
  {:as-of "2026-08-12"
   :status :unverified-assertion
   :tokens #{:compiler :kotoba-wasm :kotoba-cljs :kir :wasm32 :kotoba-kir
             :restricted-esm :compiler-host-jvm :compiler-host-cljs
             :compiler-native-host}
   :counts {:compiler 20 :kotoba-wasm 20 :kotoba-cljs 19 :kir 2 :wasm32 2
            :kotoba-kir 1 :restricted-esm 1 :compiler-host-jvm 1
            :compiler-host-cljs 1 :compiler-native-host 1}
   :granularity-note "Mixed. :kotoba-wasm and :wasm32 co-occur on two entries; :kir and :kotoba-kir are two spellings; :compiler-native-host was coined for one entry (:native-homogeneous-vectors) and is defined nowhere."
   :rule "A token outside this set fails :portable/unknown-implementation-token. Adding one means deciding what it means and where its evidence lives."
   :open-decision "Whether :implementation should be replaced by target ids from kir/target.cljc, or keep its own names with a declared mapping to them. Until that is decided, an :implementation set is an assertion, not evidence."}
  :conformance-link-debt
  {:as-of "2026-08-12"
   :measured-claims 18
   :entries #{:contextual-document-literal :filter-function :inline-fn-callbacks
              :map-literal :multi-collection-map :persistent-collection-semantics
              :portable-value-model :reduce-function :string-predicate-typing
              :vector-literal}
   :rule "Remove an entry when it gains :conformance or :orphaned-conformance. Do not add one — a new portable claim must name a case."}
  :security-constraint-adr-forms
  {:repo-relative-path "must resolve on disk, e.g. docs/adr/ADR-safe-capability-language.md"
   :adr-id "a superproject document, accepted without resolution because this repo cannot see that tree, e.g. adr-2608650000-kotoba-cannot-write-has-two-kinds-decision-core-extraction"
   :multiple "a vector when more than one decision is load-bearing; record what each covers in :adr-covers and what none of them decide in :adr-gap"}
  :portable-support-requires [:bounded-semantics :deterministic-lowering
                              :positive-conformance :negative-conformance
                              :backend-parity-evidence]
  :authority-check "src/kotoba/lang/grammar_authority.clj"
  :migration-plan "docs/kotoba-centered-migration-plan.md"
  :workspace-adr "90-docs/adr/2607279200-kotoba-clojure-shaped-safety-elaboration-migration.edn"
  :rule "Every guest-grammar admitted form must be classified here; portable claims need full backend evidence or remain partial."}}
