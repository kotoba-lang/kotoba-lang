    ;; adr-2609242330 S5, 2026-09-25): its owner-only rule needs the owner of
    ;; a directory or entry and this process's uid, which no other form
    ;; carries. Answered by amu's nbb handler (lstat + geteuid) only; the kexe
    ;; loader and the static ELF read the token as part of a path.
    :owner {:token "OWNER_SEP" :request "<path>OWNER_SEP" :status :proposed
            :answer "\"<owner uid> <process euid>\" of the final component ITSELF (not followed), \"\" when absent"
            :answered-by #{}}}
