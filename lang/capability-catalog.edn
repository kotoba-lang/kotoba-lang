            :answered-by #{:kexe-loader :linux-static}}
    :stat {:token "STAT_SEP" :request "<path>STAT_SEP"
           :answer "\"<mode&0777> <size> <blocks> <is-dir>\", \"\" when absent; a final symlink is not followed and reads as absent"
           :answered-by #{:kexe-loader :linux-static}}
    :mtime {:token "MTIME_SEP" :request "<path>MTIME_SEP" :answer "st_mtime seconds, \"\" when absent"
            :answered-by #{:kexe-loader :linux-static}}
    :chmod {:token "CHMOD_SEP" :request "<path>CHMOD_SEP<1..6 octal digits>"
            :answer "\"1\" / \"0\"; permission bits only"
            :answered-by #{:kexe-loader :linux-static}}
    :mkdir {:token "MKDIR_SEP" :request "<path>MKDIR_SEP" :answer "\"1\" / \"0\""
            :answered-by #{:kexe-loader :linux-static}}
    :unlink {:token "UNLINK_SEP" :request "<path>UNLINK_SEP" :answer "\"1\" / \"0\""
             :answered-by #{:kexe-loader :linux-static}}
    :rmdir {:token "RMDIR_SEP" :request "<path>RMDIR_SEP" :answer "\"1\" / \"0\""
            :answered-by #{:kexe-loader :linux-static}}
    :rename {:token "RENAME_SEP" :request "<from>RENAME_SEP<to>" :answer "\"1\" / \"0\""
             :answered-by #{:kexe-loader :linux-static}}
    :fsync {:token "FSYNC_SEP" :request "<path>FSYNC_SEP"
            :answer "\"1\" once fsync(2) returned, \"0\" when the file cannot be opened or the flush fails"
            :answered-by #{:kexe-loader :linux-static}}
    :make-temp-dir {:token "MKTEMP_SEP" :request "<dir>MKTEMP_SEP<prefix>"
                    :answer "the absolute path of a NEW directory <dir>/<prefix><6 of [0-9a-z]>, mode 0700 (mkdtemp); \"\" when <dir> cannot be opened"
                    :answered-by #{:kexe-loader :linux-static}}
    :stat-nofollow {:token "NOFOLLOW_SEP" :request "<path>NOFOLLOW_SEP"
                    :answer "\"<mode&0777> <size> <blocks> <kind>\" of the final component ITSELF, kind 0 file / 1 directory / 2 symlink / 3 other; \"\" when absent"
                    :answered-by #{:kexe-loader :linux-static}}
