;; lang/conformance/i64/operations.kotoba -- the :i64 operations (root
;; ADR-2610092330 R4: the registry's :i64 family): bit-not, the 64-bit shifts
;; (a literal count in [0,63]) and binary min / max.

(ns i64-operations
  {:kotoba/export [main test-bit-not test-shifts test-min-max]})

(defn test-bit-not [] :bool
  (and (= (bit-not 0) -1) (= (bit-not 5) -6)))

(defn test-shifts [] :bool
  (and (= (i64-shift-left 1 40) 1099511627776)
       (= (i64-shift-left 1 63) -9223372036854775808)
       (= (i64-shift-right -16 2) -4)
       (= (u64-shift-right -1 60) 15)))

(defn test-min-max [] :bool
  (and (= (min 3 -4) -4) (= (max 3 -4) 3)))

;; main: the number of test-* that pass (3 when all do).
(defn main [] :i64
  (+ (if (test-bit-not) 1 0) (if (test-shifts) 1 0) (if (test-min-max) 1 0)))
