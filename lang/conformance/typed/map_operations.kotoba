;; lang/conformance/typed/map_operations.kotoba -- the [:map K V] operations
;; (root ADR-2610092330 R4: the registry's :typed-map family). Each takes the
;; map's type as its first argument.

(ns typed-map-operations
  {:kotoba/export [main
                   test-new-and-count test-contains test-get test-assoc test-dissoc
                   test-equal test-entry-at]})

(defn- m [] [:map :keyword :i64]
  (typed-map-new [:map :keyword :i64] :a 1 :b 2))

(defn test-new-and-count [] :bool
  (and (= (typed-map-count [:map :keyword :i64] (m)) 2)
       (= (typed-map-count [:map :keyword :i64] (typed-map-new [:map :keyword :i64])) 0)))

(defn test-contains [] :bool
  (and (typed-map-contains [:map :keyword :i64] (m) :a)
       (not (typed-map-contains [:map :keyword :i64] (m) :z))))

(defn test-get [] :bool
  (and (= (option-value-of [:option :i64] (typed-map-get [:map :keyword :i64] (m) :b) -1) 2)
       (= (option-value-of [:option :i64] (typed-map-get [:map :keyword :i64] (m) :z) -1) -1)))

(defn test-assoc [] :bool
  (let [n (typed-map-assoc [:map :keyword :i64] (m) :c 3)]
    (and (= (typed-map-count [:map :keyword :i64] n) 3)
         (= (option-value-of [:option :i64] (typed-map-get [:map :keyword :i64] n :c) -1) 3))))

(defn test-dissoc [] :bool
  (let [n (typed-map-dissoc [:map :keyword :i64] (m) :a)]
    (and (= (typed-map-count [:map :keyword :i64] n) 1)
         (not (typed-map-contains [:map :keyword :i64] n :a)))))

(defn test-equal [] :bool
  (and (typed-map-equal [:map :keyword :i64] (m) (typed-map-new [:map :keyword :i64] :b 2 :a 1))
       (not (typed-map-equal [:map :keyword :i64] (m) (typed-map-new [:map :keyword :i64] :a 1)))))

(defn test-entry-at [] :bool
  ;; [:option [:vector [K V]]]: present in range, absent past the end
  (and (some? (typed-map-entry-at [:map :keyword :i64] (m) 0))
       (some? (typed-map-entry-at [:map :keyword :i64] (m) 1))
       (not (some? (typed-map-entry-at [:map :keyword :i64] (m) 2)))))

;; main: the number of test-* that pass (7 when all do).
(defn main [] :i64
  (+ (if (test-new-and-count) 1 0) (if (test-contains) 1 0) (if (test-get) 1 0)
     (if (test-assoc) 1 0) (if (test-dissoc) 1 0) (if (test-equal) 1 0)
     (if (test-entry-at) 1 0)))
