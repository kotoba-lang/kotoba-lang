;; lang/conformance/typed/set_nth.kotoba -- typed-set-nth on its own: the
;; restricted-ESM emitter refuses it ("unsupported KIR node"), and JS is an
;; optional backend, so it is kept apart from the cases every backend runs
;; (root ADR-2610092330 R4).

(ns typed-set-nth {:kotoba/export [main test-nth]})

(defn test-nth [] :bool
  ;; canonical order: the smallest first
  (let [s (typed-set-new [:set :i64] 3 1 2)]
    (and (= (typed-set-nth [:set :i64] s 0) 1) (= (typed-set-nth [:set :i64] s 2) 3))))

(defn main [] :i64 (if (test-nth) 1 0))
