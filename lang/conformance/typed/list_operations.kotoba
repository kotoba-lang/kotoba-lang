;; lang/conformance/typed/list_operations.kotoba -- the [:list T] operations
;; (root ADR-2610092330 R4: the registry's :typed-list family). Each takes the
;; list's type as its first argument. There is no typed-list-count: count of a
;; [:list T] lowers to vector-count over its carrier.

(ns typed-list-operations {:kotoba/export [main test-new-and-nth test-conj]})

(defn- l [] [:list :i64] (typed-list-new [:list :i64] 7 8 9))

(defn test-new-and-nth [] :bool
  (and (= (typed-list-nth [:list :i64] (l) 0) 7) (= (typed-list-nth [:list :i64] (l) 2) 9)
       (= (count (l)) 3)))

(defn test-conj [] :bool
  (let [m (typed-list-conj [:list :i64] (l) 10)]
    (and (= (count m) 4) (= (typed-list-nth [:list :i64] m 3) 10))))

;; main: the number of test-* that pass (2 when all do).
(defn main [] :i64 (+ (if (test-new-and-nth) 1 0) (if (test-conj) 1 0)))
