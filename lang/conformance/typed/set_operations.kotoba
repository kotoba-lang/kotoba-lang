;; lang/conformance/typed/set_operations.kotoba -- the [:set T] operations
;; (root ADR-2610092330 R4: the registry's :typed-set family). Each takes the
;; set's type as its first argument.

(ns typed-set-operations
  {:kotoba/export [main
                   test-new-and-count test-contains test-conj test-disj test-equal]})

(defn- s [] [:set :i64] (typed-set-new [:set :i64] 3 1 2))

(defn test-new-and-count [] :bool
  ;; (typed-set-new [:set :i64] 1 1) is refused: a duplicate item
  (and (= (typed-set-count [:set :i64] (s)) 3)
       (= (typed-set-count [:set :i64] (typed-set-new [:set :i64])) 0)))

(defn test-contains [] :bool
  (and (typed-set-contains [:set :i64] (s) 2) (not (typed-set-contains [:set :i64] (s) 9))))

(defn test-conj [] :bool
  (and (= (typed-set-count [:set :i64] (typed-set-conj [:set :i64] (s) 4)) 4)
       (= (typed-set-count [:set :i64] (typed-set-conj [:set :i64] (s) 1)) 3)))

(defn test-disj [] :bool
  (and (= (typed-set-count [:set :i64] (typed-set-disj [:set :i64] (s) 1)) 2)
       (not (typed-set-contains [:set :i64] (typed-set-disj [:set :i64] (s) 1) 1))))

(defn test-equal [] :bool
  (and (typed-set-equal [:set :i64] (s) (typed-set-new [:set :i64] 1 2 3))
       (not (typed-set-equal [:set :i64] (s) (typed-set-new [:set :i64] 1 2)))))

;; main: the number of test-* that pass (5 when all do).
(defn main [] :i64
  (+ (if (test-new-and-count) 1 0) (if (test-contains) 1 0) (if (test-conj) 1 0)
     (if (test-disj) 1 0) (if (test-equal) 1 0)))
