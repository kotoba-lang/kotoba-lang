;; lang/conformance/typed/map_projections.kotoba -- typed-map-keys and
;; typed-map-vals, on their own because the typed Wasm lowering does not carry
;; them yet (root ADR-2610092330 R4; the deferral is in the manifest).

(ns typed-map-projections {:kotoba/export [main test-keys-and-vals]})

(defn test-keys-and-vals [] :bool
  (let [m (typed-map-new [:map :keyword :i64] :a 1 :b 2)]
    (and (= (count (typed-map-keys [:map :keyword :i64] m)) 2)
         (= (count (typed-map-vals [:map :keyword :i64] m)) 2))))

(defn main [] :i64 (if (test-keys-and-vals) 1 0))
