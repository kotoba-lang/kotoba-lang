{:kotoba.lang.stdlib.manifest/version 2
 :kotoba.lang.stdlib.manifest/wbs "T4.1"
 :kotoba.lang.stdlib.manifest/status :frozen
 :kotoba.lang.stdlib.manifest/note
 "Frozen public module list for the bounded stdlib (reliability T4.1).
  Module source SSoT: lang/stdlib/core.kotoba (mirrored byte-for-byte under
  lang/conformance/stdlib/core.kotoba for the portable-source-stdlib case).
  Expanding public names requires a version bump + WBS T4.x task."

 :kotoba.lang.stdlib.manifest/revision
 {:version 2
  :date "2026-09-01"
  :kind :contraction
  :reason
  "Version 1 froze a list that no route could compile. The module declared no
   namespace, so it could not be required at all; and its contents had been
   written before the language grew its own Option/Result surface, so five of
   its twenty-seven names had since become RESERVED and eleven of its functions
   no longer admitted as written. A frozen list is a promise about what a guest
   can call, so this revision removes the names that cannot be called rather
   than leaving the promise standing. Every removal is recorded under
   :withdrawn with the message that refuses it."
  :measured
  {:as-of "2026-09-01"
   :amu "27d82d8"
   :kotoba-lang "df17122"
   :route "amu check <entry> --source-path <root> --jvm-free"}}

 :modules
 [{:id :core
   :path "lang/stdlib/core.kotoba"
   :conformance-path "lang/conformance/stdlib/core.kotoba"
   :package-id :core
   :package-contract "lang/stdlib.edn"
   :namespace stdlib.core
   :sha256 "ea54c18d344e753c378adeb2c51444b07caa9a862b2b7026514cf613b2a3a8b0"
   :records #{}
   :public-names
   #{every? first-match concat reverse-into reverse
     range-step range zipmap merge
     comp2 stdlib-binary-closure-anchor partial1}
   :internal-notes
   "range-step / reverse-into stay public because range/reverse call them and
    a caller may want the unrounded form; the namespace would now permit them
    to be private, which is a separate decision from this one.
    stdlib-binary-closure-anchor is a dispatcher anchor for arity-2 closures.
    Every public name is single-arity. That was forced until 2026-09-01 --
    a project module could not export a multi-arity function at all (see
    :arity-limit) -- and is now a property of this frozen list rather than a
    limit of the linker. Changing it is a version bump."
   :status :frozen}]

 ;; A multi-arity function CAN be exported from a project module, since amu
 ;; c085efe (PR #738, 2026-09-01). It could not before: the linker analyzes
 ;; each module before linking it, so by the time `(:export [twice])` was
 ;; resolved the function was already named `twice$arity$1` / `twice$arity$2`
 ;; and no function was called `twice`. A module's interface now maps an
 ;; export to the VECTOR of clauses that name denotes.
 :arity-limit
 {:status :fixed
  :fixed-in {:repo "kotoba-lang/amu" :pr 738 :merge "c085efe" :date "2026-09-01"
             :owner "kotoba.compiler.project/analyze-module"}
  :was {:measured "2026-09-01, amu 27d82d8"
        :message "export does not name a declared function"
        :error-data "{:module ma.lib, :export twice, :phase :project-link}"}
  :reproduction
  "lib/ma/lib.kotoba: (ns ma.lib (:export [twice])) (defn twice ([x :i64] :i64 (* 2 x)) ([x :i64 y :i64] :i64 (* y x)))
   app/app/main.kotoba: (ns app.main (:export [main]) (:require [ma.lib :as l])) (defn main [] :i64 (l/twice 5))
   amu check app/app/main.kotoba --source-path app --source-path lib --jvm-free"
  :now
  "exit 0. Compiled with --target wasm32 --jvm-free and instantiated, the
   artifact exports main, twice$arity$1 and twice$arity$2 -- the surface a
   single-file compile of the same function gives. twice$arity$1(5) is 10 and
   twice$arity$2(5,3) is 15, so each clause keeps its own body across the
   module boundary."
  :consequence
  "range MAY take one, two or three arguments here now. It still does not:
   the frozen public-name list above is unchanged, and making a stdlib name
   multi-arity is a version bump under :kotoba.lang.stdlib.manifest/revision,
   not a consequence of this fix."}

 ;; Removed in version 2. Each entry names the refusal, not a judgement.
 :withdrawn
 {some
  {:reason :reserved-name
   :message "reserved function name"
   :detail "`some` is a reserved head in the frontend, in the same set as let, if, ns, defn, nil? and match-option."
   :replaced-by first-match}
  option-some
  {:reason :reserved-name
   :message "reserved function name"
   :detail "the language owns Option: option-some is one of typed-safe-value-operations. A guest calls the builtin."
   :replaced-by :language-builtin}
  option-none
  {:reason :reserved-name :message "reserved function name" :replaced-by :language-builtin}
  option-some?
  {:reason :reserved-name :message "reserved function name" :replaced-by :language-builtin}
  option-value
  {:reason :reserved-name :message "reserved function name" :replaced-by :language-builtin}
  option-none?
  {:reason :does-not-admit
   :message "expression type mismatch: expected map, got i64"
   :detail "(get option :kotoba.record/type) over an unannotated parameter, which defaults to :i64. The record-based Option it read is gone in any case; see :records."
   :replaced-by :language-builtin}
  ok    {:reason :superseded-by-language :detail "result-ok" :replaced-by :language-builtin}
  err   {:reason :superseded-by-language :detail "result-err" :replaced-by :language-builtin}
  ok?   {:reason :does-not-admit
         :message "expression type mismatch: expected map, got i64"
         :detail "same record-tag read as option-none?. result-ok? is the builtin."
         :replaced-by :language-builtin}
  err?  {:reason :does-not-admit
         :message "expression type mismatch: expected map, got i64"
         :replaced-by :language-builtin}
  unwrap-ok
  {:reason :does-not-admit
   :message "operation has no admitted lowering"
   :detail "result-value is the builtin."
   :replaced-by :language-builtin}
  unwrap-err
  {:reason :does-not-admit
   :message "operation has no admitted lowering"
   :detail "result-error is the builtin."
   :replaced-by :language-builtin}
  find
  {:reason :backend-refuses
   :message "unsupported typed Wasm expression"
   :detail "admits and runs on the KIR backend once the result is annotated :option-i64 -- without the annotation the recursive arm infers :i64 and the frontend refuses with 'if branches must have the same value type'. wasm32 then refuses the lowering. Isolated: a single file whose only function is (defn f [x] :option-i64 (if (> x 3) (option-some x) (option-none))) exits 70 for wasm32, while (defn f [x] :option-i64 (option-some x)) compiles."
   :returns-when "wasm32 can lower an if over option-some / option-none"
   :replaced-by first-match}
  select-keys
  {:reason :does-not-admit
   :message "operation has no admitted lowering"
   :detail "it called contains-key?, which is not an operation in this language."}
  group-by
  {:reason :does-not-admit
   :message "expression type mismatch: expected keyword, got i64"
   :detail "it wanted a typed map keyed by whatever the classifier returned; a value taken out of a pair chain is :i64, and map keys are :keyword."}
  update
  {:reason :backend-refuses
   :message "internal compiler error"
   :detail "admits with (defn update [source :map key :keyword updater :i64] :map (map-assoc source key (invoke updater (map-get source key 0)))) and runs on the KIR backend, returning 5 for (update (map-new) :k (fn [v] (+ v 5))). wasm32 refuses: a single file whose only function is (defn f [source :map key :keyword] :map (map-assoc source key 7)) exits 70."
   :returns-when "wasm32 can lower map-new / map-assoc"}}

 :records
 {:status :removed-in-version-2
  :was #{:Some :None :Ok :Err}
  :two-independent-reasons
  ["(defrecord None []) is refused: :kotoba.error/record-fields, 'record fields must be a non-empty unique bounded vector'. Isolated: a two-line file containing only (defrecord None []) and a main is refused the same way, and the same file with (defrecord Some [value]) is admitted."
   "even with None spelled to carry a field, a record-based Option is not expressible: Some and None are two distinct nominal types, so a function returning either is refused with 'if branches must have the same value type'. Measured on the file's own `find`."]
  :decision "the refusal of an empty record stays. See the workspace ADR named in lang/stdlib.edn."}

 :language-builtins
 {:note "Not prelude-loaded; admitted by language surface / pure-product profile."
  :string-ops
  #{string-concat string-join string=? string-substring string-byte-length
    string-length string-from-i64 string-contains? string-fold-case
    string-code-point-at}
  :string-join {:max-parts 8 :desugars-to "nested string-concat" :wbs "T4.2"}
  :string-split-count {:status :landed :wbs "T4.2" :note "compiler#427 dual-backend segment count"}
  :string-split {:status :deferred :note "collection return; optional remainder of T4.2"}
  :option-sugar #{if-some when-some match-option}
  ;; These are why the option/result half of version 1 is gone: the names are
  ;; reserved because the language answers to them.
  :option-and-result
  #{option-some option-none option-some? option-value
    result-ok result-err result-ok? result-value result-error}
  :parametric-option-and-result
  #{option-some-of option-none-of option-some?-of option-value-of option-match
    result-ok-of result-err-of result-ok?-of result-value-of result-error-of
    result-match-of}
  :authority ["lang/pure-product-profile.edn" "lang/surface-status.edn"
              "docs/lang/semantics-ssot.md section 9"]}

 :conformance
 {:cases #{:portable-source-stdlib}
  :entry "lang/conformance/stdlib/basic.kotoba"
  :entry-namespace stdlib.basic
  ;; The case is a two-module PROJECT, not a prelude. `:prelude` was version
  ;; 1's key and nothing ever read it.
  :route :project-source-path
  :source-path "lang/conformance"
  :runner "kotoba.lang.stdlib-conformance-test"}}
