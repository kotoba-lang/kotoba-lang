(ns stdlib.extended
  (:export [main])
  (:require [stdlib.core :as core]))

;; One term per version-3 name, each on its own power of ten so a wrong
;; answer says which function produced it. Expected: 678392943530 (measured
;; on wasm32 through amu runtime/browser-host.mjs, 2026-09-02).
(defn- second-item [items]
  (pair-first (pair-second items)))

(defn main []
  (+ (pair-first (core/keep (fn [x] (if (> x 2) (* x 10) 0)) (pair 1 (pair 3 (pair 5 0)))))
     (* 100 (pair-first (core/remove (fn [x] (< x 4)) (pair 1 (pair 5 (pair 2 0))))))
     (* 1000 (second-item (core/mapv (fn [x] (+ x 1)) (pair 1 (pair 2 0)))))
     (* 10000 (second-item (core/take-while (fn [x] (< x 5)) (pair 1 (pair 4 (pair 9 0))))))
     (* 100000 (pair-first (core/drop-while (fn [x] (< x 5)) (pair 1 (pair 4 (pair 9 0))))))
     (* 1000000 (pair-first (core/sort (pair 7 (pair 2 (pair 5 0))))))
     (* 10000000 (pair-first (core/sort-by (fn [x] (- 0 x)) (pair 1 (pair 9 (pair 4 0))))))
     (* 100000000 (pair-first (second-item (core/partition 2 (pair 1 (pair 2 (pair 3 (pair 4 (pair 5 0)))))))))
     (* 1000000000 (second-item (core/distinct (pair 6 (pair 6 (pair 8 0))))))
     (* 10000000000 (second-item (core/interpose 7 (pair 1 (pair 2 0)))))
     (* 100000000000 (second-item (invoke (core/juxt2 (fn [x] (+ x 1)) (fn [x] (* x 2))) 3)))))
