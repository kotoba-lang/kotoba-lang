(ns stdlib.i64set
  (:export [main])
  (:require [stdlib.i64-set :as iset]))

;; The version-6 module, exercised on its own powers of ten so a wrong
;; answer names the operation that produced it.
;;
;; Canonicalization: from-chain over (3 1 2 1) sorts to {1 2 3} and
;; dedups to 3 items. Membership hits and misses on the sorted set, the
;; count of union/intersection/difference over two hand-built sets, the
;; subset and equality relations, and validity of every constructed
;; set. Expected: 4294967845, measured on wasm32 through amu
;; runtime/browser-host.mjs (recorded in the manifest revision).
;;
;; Weights: count=1, contains-hit=10, contains-miss=100,
;; union-count=1000, intersection-count=10000, difference-count=100000,
;; subset=true=1000000, subset=false=10000000, equal=true=100000000,
;; valid=1000000000.
(defn- a [] :i64
  (iset/set-from-chain (pair 3 (pair 1 (pair 2 (pair 1 0))))))

(defn- b [] :i64
  (iset/set-from-chain (pair 2 (pair 3 (pair 4 0)))))

(defn main [] :i64
  (+ (iset/set-count (a))
     (* 10 (if (iset/set-contains? (a) 2) 1 0))
     (* 100 (if (iset/set-contains? (a) 7) 0 1))
     (* 1000 (iset/set-count (iset/set-union (a) (b))))
     (* 10000 (iset/set-count (iset/set-intersection (a) (b))))
     (* 100000 (iset/set-count (iset/set-difference (a) (b))))
     (* 1000000 (if (iset/set-subset? (iset/set-from-chain (pair 2 (pair 3 0))) (b)) 1 0))
     (* 10000000 (if (iset/set-subset? (iset/set-from-chain (pair 2 (pair 9 0))) (b)) 0 1))
     (* 100000000 (if (iset/set-equal? (iset/set-union (iset/set-from-chain (pair 1 0)) (iset/set-from-chain (pair 2 0)))
                                       (iset/set-from-chain (pair 1 (pair 2 0)))) 1 0))
     (* 1000000000 (if (iset/set-valid? (iset/set-union (a) (b))) 1 0))))
