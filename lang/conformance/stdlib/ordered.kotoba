(ns stdlib.ordered
  (:export [main])
  (:require [stdlib.sorted-map :as sm]))

;; One term per public name of stdlib.sorted-map, each on its own power of ten
;; so a wrong answer says which function produced it. The map is built by
;; four assocs and one dissoc, so its keys are 2, 3, 5 and its values are
;; key + 1; the fold is worth 13 and therefore takes two decades.
;; Expected: 61332520143 (measured on wasm32 through amu
;; runtime/browser-host.mjs, 2026-09-02).
(defn- built []
  (sm/sm-dissoc
   (sm/sm-assoc
    (sm/sm-assoc
     (sm/sm-assoc
      (sm/sm-assoc (sm/sm-empty) 5 6)
      2 3)
     8 9)
    3 4)
   8))

(defn main []
  (let [t (built)]
    (+ (sm/sm-count t)
       (* 10 (sm/sm-get t 3 0))
       (* 100 (sm/sm-contains? t 5))
       (* 1000 (sm/sm-contains? t 8))
       (* 10000 (sm/sm-min-key t))
       (* 100000 (sm/sm-max-key t))
       (* 1000000 (pair-first (sm/sm-keys t)))
       (* 10000000 (pair-first (sm/sm-vals t)))
       (* 100000000 (sm/sm-reduce (fn [acc entry] (+ acc (pair-second entry))) 0 t))
       (* 10000000000 (sm/sm-get (sm/sm-empty) 7 6)))))
