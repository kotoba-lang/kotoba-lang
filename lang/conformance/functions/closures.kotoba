(defn make-adder [n]
  (fn [x] (+ x n)))

(defn add [a b]
  (+ a b))

(defn apply-one [f x]
  (f x))

(defn identity-closure [f]
  f)

(defn wrap-closure [f]
  (fn [x] (f x)))

(defn main []
  (+ (invoke (make-adder 5) 7)
     (+ (invoke (fn-ref add) 3 8)
        (+ (apply (fn [a b c] (+ a (+ b c))) 1 (list 2 3))
           (apply-one
            (identity-closure (wrap-closure (make-adder 5)))
            3)))))
