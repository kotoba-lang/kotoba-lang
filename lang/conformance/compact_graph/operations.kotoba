;; lang/conformance/compact_graph/operations.kotoba -- the :compact-graph
;; operations (root ADR-2610092330 R4: the registry's :compact-graph family):
;; the string-index (string keys to i64) and the bounded i64 disjoint set.

(ns compact-graph-operations
  {:kotoba/export [main test-string-index test-string-index-get test-disjoint-set]})

(defn test-string-index [] :bool
  (let [idx (string-index-assoc (string-index-assoc (string-index-new) "a" 1) "b" 2)]
    (and (= (string-index-count (string-index-new)) 0)
         (= (string-index-count idx) 2)
         (string-index-contains idx "a")
         (not (string-index-contains idx "c")))))

(defn test-string-index-get [] :bool
  (let [idx (string-index-assoc (string-index-new) "a" 7)]
    (and (= (option-value (string-index-get idx "a") 0) 7)
         (not (option-some? (string-index-get idx "z"))))))

(defn test-disjoint-set [] :bool
  (let [ds (disjoint-set-i64-new 4)
        joined (disjoint-set-i64-union ds 0 1)]
    (and (= (disjoint-set-i64-count ds) 4)
         (option-some? joined)
         ;; the count is the number of ELEMENTS, which a union keeps
         (= (disjoint-set-i64-count (option-value joined ds)) 4))))

;; main: the number of test-* that pass (3 when all do).
(defn main [] :i64
  (+ (if (test-string-index) 1 0) (if (test-string-index-get) 1 0) (if (test-disjoint-set) 1 0)))
