;; lang/conformance/f64/operations.kotoba -- the :f64 operations (root
;; ADR-2610092330 R4: the registry's :f64 family). Every value is exactly
;; representable in binary64, and the bounded / near transcendentals are asked
;; only at 0 and 1, where their answers are exact.

(ns f64-operations
  {:kotoba/export [main
                   test-arithmetic test-unary test-bits test-compare
                   test-transcendental test-conversions]})

(defn test-arithmetic [] :bool
  (and (f64-eq (f64-add 1.5 2.25) 3.75) (f64-eq (f64-sub 3.75 1.5) 2.25)
       (f64-eq (f64-mul 1.5 2.0) 3.0) (f64-eq (f64-div 3.0 2.0) 1.5)
       (f64-eq (f64-min 1.5 2.25) 1.5) (f64-eq (f64-max 1.5 2.25) 2.25)))

(defn test-unary [] :bool
  (and (f64-eq (f64-neg 1.5) -1.5) (f64-eq (f64-abs -2.25) 2.25) (f64-eq (f64-sqrt 2.25) 1.5)))

(defn test-bits [] :bool
  (and (= (f64-to-bits 1.0) 4607182418800017408)
       (f64-eq (f64-from-bits 4607182418800017408) 1.0)))

(defn test-compare [] :bool
  (and (f64-lt 1.5 2.0) (f64-le 1.5 1.5) (f64-gt 2.0 1.5) (f64-ge 2.0 2.0)
       (not (f64-eq 1.5 2.0)) (not (f64-unordered 1.5 2.0))))

(defn test-transcendental [] :bool
  (and (f64-eq (f64-sin-quarter-turn 0.0) 0.0) (f64-eq (f64-cos-quarter-turn 0.0) 1.0)
       (f64-eq (f64-sin-bounded 0.0) 0.0) (f64-eq (f64-cos-bounded 0.0) 1.0)
       (f64-eq (f64-exp-near-zero 0.0) 1.0) (f64-eq (f64-log-near-one 1.0) 0.0)
       (f64-eq (f64-exp-bounded 0.0) 1.0) (f64-eq (f64-log-bounded 1.0) 0.0)
       (f64-eq (f64-atan2-bounded 0.0 1.0) 0.0)))

(defn test-conversions [] :bool
  (and (f64-eq (i64-to-f64-checked 3) 3.0) (f64-eq (i64-to-f64-rounded 3) 3.0)
       (= (f64-to-i64-checked 3.0) 3) (= (f64-to-i64-truncating 3.75) 3)))

;; main: the number of test-* that pass (6 when all do).
(defn main [] :i64
  (+ (if (test-arithmetic) 1 0) (if (test-unary) 1 0) (if (test-bits) 1 0)
     (if (test-compare) 1 0) (if (test-transcendental) 1 0) (if (test-conversions) 1 0)))
