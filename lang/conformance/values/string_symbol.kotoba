;; String and symbol keys as values: a string-key map literal ([:map :string V])
;; and a quoted symbol-key map ([:map :symbol V]), both read with get. The
;; :strs / :syms destructuring this fixture used until 2026-10-09 is outside
;; the keyword-only destructuring model (lang/guest-grammar.edn
;; :nested-destructuring), and a map literal cannot mix string and symbol keys;
;; values/string_symbol_destructuring_refused.kotoba keeps that refusal.
(defn main []
  (let [strs {"name" 3}
        syms '{age 4}]
    (+ (get strs "name" 0)
       (get syms 'age 0)
       (get syms 'name 0)
       (string-length "猫"))))
