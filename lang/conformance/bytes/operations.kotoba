;; lang/conformance/bytes/operations.kotoba -- the :bytes operations (root
;; ADR-2610092330 R4: the registry's :bytes family, every operation run on
;; every required backend). guest-grammar :bytes-value is the decision.

(ns bytes-operations
  {:kotoba/export [main
                   test-empty test-from-items-and-count test-at test-slice test-concat
                   test-to-items test-utf8]})

(defn- abc [] :bytes (bytes-from-vector-i64 (vector-i64 97 98 99)))

(defn test-empty [] :bool (= (bytes-count (bytes-empty)) 0))

(defn test-from-items-and-count [] :bool
  (and (= (bytes-count (abc)) 3)
       (= (bytes-count (bytes-from-vector-i64 (vector-i64 0 255))) 2)))

(defn test-at [] :bool
  (and (= (bytes-at (abc) 0) 97) (= (bytes-at (abc) 2) 99)
       (= (bytes-at (bytes-from-vector-i64 (vector-i64 255)) 0) 255)))

(defn test-slice [] :bool
  (and (= (bytes-count (bytes-slice (abc) 1 3)) 2)
       (= (bytes-at (bytes-slice (abc) 1 3) 0) 98)
       (= (bytes-count (bytes-slice (abc) 2 2)) 0)))

(defn test-concat [] :bool
  (let [c (bytes-concat (abc) (bytes-from-vector-i64 (vector-i64 100)))]
    (and (= (bytes-count c) 4) (= (bytes-at c 3) 100)
         (= (bytes-count (bytes-concat (bytes-empty) (bytes-empty))) 0))))

(defn test-to-items [] :bool
  (let [v (vector-i64-from-bytes (abc))]
    (and (= (vector-count v) 3) (= (vector-at v 1) 98))))

(defn test-utf8 [] :bool
  (and (string=? (string-from-utf8 (abc)) "abc")
       (string=? (string-from-utf8 (bytes-from-vector-i64 (vector-i64 231 140 171))) "猫")
       (string=? (string-from-utf8 (bytes-empty)) "")))

;; main: the number of test-* that pass (7 when all do).
(defn main [] :i64
  (+ (if (test-empty) 1 0) (if (test-from-items-and-count) 1 0) (if (test-at) 1 0)
     (if (test-slice) 1 0) (if (test-concat) 1 0) (if (test-to-items) 1 0) (if (test-utf8) 1 0)))
