;; lang/conformance/decimal/operations.kotoba -- the :decimal operations (root
;; ADR-2610092330 R4: the registry's :decimal family): the sealed finite
;; decimal subset, one f64 or exactly three separated by ASCII whitespace.

(ns decimal-operations
  {:kotoba/export [main test-f64 test-f64x3]})

(defn test-f64 [] :bool
  (and (f64-eq (option-value (decimal-f64-parse "2.25") 0.0) 2.25)
       (f64-eq (option-value (decimal-f64-parse "-1.5e1") 0.0) -15.0)
       (not (option-some? (decimal-f64-parse "nan")))
       (not (option-some? (decimal-f64-parse "1.5x")))))

(defn test-f64x3 [] :bool
  (and (option-some? (decimal-f64x3-parse "1 2.5 -3"))
       (not (option-some? (decimal-f64x3-parse "1 2")))
       (not (option-some? (decimal-f64x3-parse "1,2,3")))))

;; main: the number of test-* that pass (2 when all do).
(defn main [] :i64
  (+ (if (test-f64) 1 0) (if (test-f64x3) 1 0)))
