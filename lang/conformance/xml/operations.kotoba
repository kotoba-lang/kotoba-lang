;; lang/conformance/xml/operations.kotoba -- the :xml operations (root
;; ADR-2610092330 R4: the registry's :xml family). A path is the element names
;; from the root joined by "/"; an index picks one of the matches.

(ns xml-operations
  {:kotoba/export [main test-counts test-text test-attr]})

(defn test-counts [] :bool
  (let [doc "<a x='1'><b>hi</b><b>yo</b><c/></a>"]
    (and (= (xml-path-count doc "a/b") 2) (= (xml-path-count doc "a/d") 0)
         (= (xml-name-count doc "b") 2) (= (xml-name-count doc "c") 1))))

(defn test-text [] :bool
  (let [doc "<a x='1'><b>hi</b><b>yo</b><c/></a>"]
    (and (string=? (option-value (xml-path-text doc "a/b" 1) "") "yo")
         (string=? (option-value (xml-name-text doc "b" 0) "") "hi")
         (not (option-some? (xml-path-text doc "a/b" 2))))))

(defn test-attr [] :bool
  (let [doc "<a x='1'><b>hi</b><b>yo</b><c/></a>"]
    (and (string=? (option-value (xml-path-attr doc "a" 0 "x") "") "1")
         (not (option-some? (xml-path-attr doc "a" 0 "y"))))))

;; main: the number of test-* that pass (3 when all do).
(defn main [] :i64
  (+ (if (test-counts) 1 0) (if (test-text) 1 0) (if (test-attr) 1 0)))
