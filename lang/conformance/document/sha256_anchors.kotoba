;; lang/conformance/document/sha256_anchors.kotoba -- the canonical bytes and
;; document-sha256 of existing documents, pinned before :document gains any kind
;; (root ADR-2610092310 S0). One document per kind, plus key-order cases.
;;
;; Every expected value was derived by hand from the format osaho documents at
;; kotoba.kir.value/document-canonical-bytes (n b i f s k y v l e m, K/D map
;; keys), then hashed outside Kotoba (Python hashlib); no backend produced them.
;; document-print is the lowercase hex of the same bytes.
;;
;; Native refuses document-sha256 and document-print by name
;; (lang/surface-status.edn :contextual-document-literal :native :refused-by-name);
;; traversal.kotoba carries the cases native can run.

(ns document-sha256-anchors {:kotoba/export [main test-sha256-null test-sha256-bool test-sha256-i64 test-sha256-string test-sha256-keyword test-sha256-f64 test-sha256-symbol test-sha256-vector test-sha256-list test-sha256-set test-sha256-keyword-map test-sha256-string-key-map test-sha256-nested test-print-null test-print-bool test-print-i64 test-print-string test-print-keyword test-print-f64 test-print-symbol test-print-vector test-print-list test-print-set test-print-keyword-map test-print-string-key-map test-print-nested]})

(defn test-sha256-null [] :bool
  (string=? (document-sha256 (document-null))
            "1b16b1df538ba12dc3f97edbb85caa7050d46c148134290feba80f8236c83db9"))

(defn test-sha256-bool [] :bool
  (string=? (document-sha256 (document-bool true))
            "5e73d6d7edd38daeae9f10721987e301e4d4b5421e88eb17063ac5a41b168273"))

(defn test-sha256-i64 [] :bool
  (string=? (document-sha256 (document-i64 -42))
            "f951c64f2893ecd1100d43f37621ff2e5a28e26ef7ef704152f67ab9ef3ab589"))

(defn test-sha256-string [] :bool
  (string=? (document-sha256 (document-string "猫a"))
            "5041f77109ffb98ac18ab12e2f5dd671133632ae096c45787b0079813ffc6342"))

(defn test-sha256-keyword [] :bool
  (string=? (document-sha256 (document-keyword :k/v))
            "e033dbe85bc6f3b302399f194e46d4c087027e4f48ce839a7d9a9816d4d061a3"))

(defn test-sha256-f64 [] :bool
  (string=? (document-sha256 (document-f64 1.5))
            "396f669fac369b93b868c1cf400526a85318463251f04885864bd1613b2f15ee"))

(defn test-sha256-symbol [] :bool
  (string=? (document-sha256 (document-symbol (quote a/b)))
            "549caaa7cc44c8a565a29f9d78c97bdc75a2092220e4863486b87240b53502ab"))

(defn test-sha256-vector [] :bool
  (string=? (document-sha256 (document-vector (document-i64 1) (document-string "x")))
            "4c12833df8d2b8176fe994126a58d605e83f4fb235fccf875f5d7bf72cfdda51"))

(defn test-sha256-list [] :bool
  (string=? (document-sha256 (document-list (document-i64 1)))
            "bb1152eb49739f9d769e950b80a261f578b9abdfa77d6ee5c8b272cf0485889e"))

(defn test-sha256-set [] :bool
  (string=? (document-sha256 (document-set (document-i64 2) (document-i64 1)))
            "8f979f8c381d0ee40504afa155a9875f6b868422558439f18f7a7a74f8da2f24"))

(defn test-sha256-keyword-map [] :bool
  (string=? (document-sha256 (document-map :zeta (document-i64 1) :a (document-vector (document-bool true)) :bb (document-null)))
            "dd0e557677d6f5396976dd73f789b89ded541157a6d9de65360c37c6cd1d082a"))

(defn test-sha256-string-key-map [] :bool
  (string=? (document-sha256 (document-map (document-string "b") (document-i64 1) (document-string "aaaaaaaaaa") (document-i64 2)))
            "74159aad14c30e8d381601e0787fd3ce45c063d831df9ad6402df94a5d4d5796"))

(defn test-sha256-nested [] :bool
  (string=? (document-sha256 (document-map :x (document-vector (document-map :y (document-set (document-i64 1))) (document-string "") (document-list))))
            "aeeac7fcb875564029ca0f0a04ab3da6a9d596ce65c0dc599c960dcf9b1c0c03"))

(defn test-print-null [] :bool
  (string=? (document-print (document-null)) "6e"))

(defn test-print-bool [] :bool
  (string=? (document-print (document-bool true)) "6274"))

(defn test-print-i64 [] :bool
  (string=? (document-print (document-i64 -42)) "692d34323b"))

(defn test-print-string [] :bool
  (string=? (document-print (document-string "猫a")) "73343ae78cab61"))

(defn test-print-keyword [] :bool
  (string=? (document-print (document-keyword :k/v)) "6b343a3a6b2f76"))

(defn test-print-f64 [] :bool
  (string=? (document-print (document-f64 1.5)) "66343630393433343231383631333730323635363b"))

(defn test-print-symbol [] :bool
  (string=? (document-print (document-symbol (quote a/b))) "79333a612f62"))

(defn test-print-vector [] :bool
  (string=? (document-print (document-vector (document-i64 1) (document-string "x"))) "76323a69313b73313a78"))

(defn test-print-list [] :bool
  (string=? (document-print (document-list (document-i64 1))) "6c313a69313b"))

(defn test-print-set [] :bool
  (string=? (document-print (document-set (document-i64 2) (document-i64 1))) "65323a69313b69323b"))

(defn test-print-keyword-map [] :bool
  (string=? (document-print (document-map :zeta (document-i64 1) :a (document-vector (document-bool true)) :bb (document-null))) "6d333a4b323a3a6176313a62744b333a3a62626e4b353a3a7a65746169313b"))

(defn test-print-string-key-map [] :bool
  (string=? (document-print (document-map (document-string "b") (document-i64 1) (document-string "aaaaaaaaaa") (document-i64 2))) "6d323a447331303a6161616161616161616169323b4473313a6269313b"))

(defn test-print-nested [] :bool
  (string=? (document-print (document-map :x (document-vector (document-map :y (document-set (document-i64 1))) (document-string "") (document-list)))) "6d313a4b323a3a7876333a6d313a4b323a3a7965313a69313b73303a6c303a"))

;; main: the number of test-* that pass (26 when all do).
(defn main [] :i64
  (+ (if (test-sha256-null) 1 0) (if (test-print-null) 1 0) (if (test-sha256-bool) 1 0) (if (test-print-bool) 1 0) (if (test-sha256-i64) 1 0) (if (test-print-i64) 1 0) (if (test-sha256-string) 1 0) (if (test-print-string) 1 0) (if (test-sha256-keyword) 1 0) (if (test-print-keyword) 1 0) (if (test-sha256-f64) 1 0) (if (test-print-f64) 1 0) (if (test-sha256-symbol) 1 0) (if (test-print-symbol) 1 0) (if (test-sha256-vector) 1 0) (if (test-print-vector) 1 0) (if (test-sha256-list) 1 0) (if (test-print-list) 1 0) (if (test-sha256-set) 1 0) (if (test-print-set) 1 0) (if (test-sha256-keyword-map) 1 0) (if (test-print-keyword-map) 1 0) (if (test-sha256-string-key-map) 1 0) (if (test-print-string-key-map) 1 0) (if (test-sha256-nested) 1 0) (if (test-print-nested) 1 0)))
