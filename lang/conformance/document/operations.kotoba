;; lang/conformance/document/operations.kotoba -- the document operations no
;; other fixture exercised (root ADR-2610092330 R2, 2026-10-09: 15 of the
;; registry's 43 had no conformance case on any backend).
;;
;; One test per operation (or pair), each a :bool; main counts them.

(ns document-operations
  {:kotoba/export [main
                   test-get-and-contains test-assoc-and-dissoc test-merge
                   test-set-contains test-vector-assoc test-vector-conj
                   test-vector-drop test-vector-remove test-vector-sort
                   test-bool-value test-symbol-value test-f64-value test-read]})

(defn- m [] :document
  (document-map :a (document-i64 1) :b (document-string "x")))

(defn- v [] :document
  (document-vector (document-i64 3) (document-i64 1) (document-i64 2)))

(defn- i64-or [d :document fallback :i64] :i64
  (option-value-of [:option :i64] (document-i64-value d) fallback))

(defn- at [d :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at d i) (document-null)))

(defn test-get-and-contains [] :bool
  (and (= (i64-or (option-value-of [:option :document] (document-get (m) :a) (document-null)) -1) 1)
       (= (document-kind (option-value-of [:option :document] (document-get (m) :zz) (document-null))) :null)
       (document-contains (m) :b)
       (not (document-contains (m) :zz))))

(defn test-assoc-and-dissoc [] :bool
  (and (= (document-count (document-assoc (m) :c (document-bool true))) 3)
       (= (document-count (document-assoc (m) :a (document-i64 9))) 2)
       (= (i64-or (option-value-of [:option :document]
                                   (document-get (document-assoc (m) :a (document-i64 9)) :a)
                                   (document-null)) -1)
          9)
       (= (document-count (document-dissoc (m) :a)) 1)
       (not (document-contains (document-dissoc (m) :a) :a))))

(defn test-merge [] :bool
  (let [merged (document-merge (m) (document-map :a (document-i64 5) :c (document-null)))]
    (and (= (document-count merged) 3)
         (= (i64-or (option-value-of [:option :document] (document-get merged :a) (document-null)) -1) 5))))

(defn test-set-contains [] :bool
  (let [s (document-set (document-i64 1) (document-string "x"))]
    (and (document-set-contains? s (document-string "x"))
         (not (document-set-contains? s (document-i64 2))))))

(defn test-vector-assoc [] :bool
  (= (i64-or (at (document-vector-assoc (v) 1 (document-i64 7)) 1) -1) 7))

(defn test-vector-conj [] :bool
  (let [w (document-vector-conj (v) (document-i64 4))]
    (and (= (document-count w) 4) (= (i64-or (at w 3) -1) 4))))

(defn test-vector-drop [] :bool
  (let [w (document-vector-drop (v) 1)]
    (and (= (document-count w) 2) (= (i64-or (at w 0) -1) 1))))

(defn test-vector-remove [] :bool
  (let [w (document-vector-remove (v) 0)]
    (and (= (document-count w) 2) (= (i64-or (at w 0) -1) 1))))

(defn test-vector-sort [] :bool
  (let [w (document-vector-sort (v))]
    (and (= (i64-or (at w 0) -1) 1) (= (i64-or (at w 1) -1) 2) (= (i64-or (at w 2) -1) 3))))

(defn test-bool-value [] :bool
  (and (option-value-of [:option :bool] (document-bool-value (document-bool true)) false)
       ;; none for a non-bool: the default answers
       (option-value-of [:option :bool] (document-bool-value (document-i64 1)) true)
       (not (option-value-of [:option :bool] (document-bool-value (document-i64 1)) false))))

(defn test-symbol-value [] :bool
  (and (= (document-kind (document-symbol (quote a/b))) :symbol)
       (document-equal? (document-symbol (option-value-of [:option :symbol]
                                                          (document-symbol-value (document-symbol (quote a/b)))
                                                          (quote none)))
                        (document-symbol (quote a/b)))
       (= (document-kind (document-symbol (option-value-of [:option :symbol]
                                                           (document-symbol-value (document-i64 1))
                                                           (quote none))))
          :symbol)))

(defn test-f64-value [] :bool
  (= (option-value-of [:option :f64] (document-f64-value (document-f64 1.5)) 0.0) 1.5))

(defn test-read [] :bool
  ;; document-read is document-print's inverse: lowercase hex of the
  ;; canonical bytes (here i42; = 69 34 32 3b)
  (= (i64-or (document-read "6934323b") -1) 42))

;; main: the number of test-* that pass (13 when all do).
(defn main [] :i64
  (+ (if (test-get-and-contains) 1 0) (if (test-assoc-and-dissoc) 1 0) (if (test-merge) 1 0)
     (if (test-set-contains) 1 0) (if (test-vector-assoc) 1 0) (if (test-vector-conj) 1 0)
     (if (test-vector-drop) 1 0) (if (test-vector-remove) 1 0) (if (test-vector-sort) 1 0)
     (if (test-bool-value) 1 0) (if (test-symbol-value) 1 0) (if (test-f64-value) 1 0)
     (if (test-read) 1 0)))
