;; lang/conformance/document/bytes_link.kotoba -- the :bytes and :link document
;; kinds (root ADR-2610092310 S2).
;;
;; Expected digests were taken outside Kotoba (Python hashlib over the
;; canonical bytes x3:<00 ff 10> and c36:<binary CID>, 2026-10-09), the same
;; values osaho's kir_document_bytes_link_test pins. The CID is
;; bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku (CIDv1 raw
;; sha2-256 of the empty string) in binary.

(ns document-bytes-link
  {:kotoba/export [main
                   test-bytes-round-trip test-bytes-kind-and-digest test-link-from-a-cidv1
                   test-link-digest test-not-a-cid-makes-no-link test-readers-of-the-other-kind
                   test-edn-text]})

(defn- three [] :bytes (bytes-from-vector-i64 (vector-i64 0 255 16)))

(defn- cid [] :bytes
  (bytes-from-vector-i64
   (vector-i64 1 85 18 32 227 176 196 66 152 252 28 20 154 251 244 200 153 111 185 36 39
               174 65 228 100 155 147 76 164 149 153 27 120 82 184 85)))

(defn- link [b :bytes] :document
  (option-value-of [:option :document] (document-link b) (document-null)))

(defn- bytes-or-empty [o [:option :bytes]] :bytes (option-value-of [:option :bytes] o (bytes-empty)))

(defn test-bytes-round-trip [] :bool
  (= (bytes-count (bytes-or-empty (document-bytes-value (document-bytes (three))))) 3))

(defn test-bytes-kind-and-digest [] :bool
  (and (= (document-kind (document-bytes (three))) :bytes)
       (string=? (document-sha256 (document-bytes (three)))
                 "9a20ad21716d8ac7de1ab4e20a18e918538e89e094cb7561fb0abdab0f36a2b8")))

(defn test-link-from-a-cidv1 [] :bool
  (and (= (document-kind (link (cid))) :link)
       (= (bytes-count (bytes-or-empty (document-link-value (link (cid))))) 36)))

(defn test-link-digest [] :bool
  (string=? (document-sha256 (link (cid)))
            "5b4949ac593035225cbf5f6c4137dd7771b8a4a80383633581ba30e81cd69139"))

(defn test-not-a-cid-makes-no-link [] :bool
  (= (document-kind (link (three))) :null))

(defn test-readers-of-the-other-kind [] :bool
  (and (= (bytes-count (bytes-or-empty (document-link-value (document-bytes (three))))) 0)
       (= (bytes-count (bytes-or-empty (document-bytes-value (link (cid))))) 0)))

(defn test-edn-text [] :bool
  (string=? (document-edn-print (document-map :cid (link (cid)) :data (document-bytes (three))))
            "{:cid #kotoba/cid \"bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku\" :data #kotoba/bytes \"00ff10\"}"))

;; main: the number of test-* that pass (7 when all do).
(defn main [] :i64
  (+ (if (test-bytes-round-trip) 1 0) (if (test-bytes-kind-and-digest) 1 0)
     (if (test-link-from-a-cidv1) 1 0) (if (test-link-digest) 1 0)
     (if (test-not-a-cid-makes-no-link) 1 0) (if (test-readers-of-the-other-kind) 1 0)
     (if (test-edn-text) 1 0)))
