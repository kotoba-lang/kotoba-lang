;; lang/conformance/document/traversal.kotoba -- walking a :document with the
;; operations the language already has (root ADR-2610092310 S0).
;;
;; document-count / document-vector-at / document-list-at / document-map-entry-at
;; and the scalar readers are listed in lang/surface-status.edn
;; (:contextual-document-literal :native :operations) and typed in kotoba-sema
;; (document-fixed-operations); surface-status's :traversal entry records them.
;; Nothing here needs document-sha256 / -print / -f64, which native refuses by
;; name, so this file is the one native can run too.
;;
;; The key-order tests record that a document map's order is NOT DAG-CBOR's
;; (length first, then bytes): keyword keys sort by their text, other keys by
;; canonical bytes. A DAG-CBOR codec re-sorts; the language does not.

(ns document-traversal
  {:kotoba/export [main leaves item entry
                   test-walk-counts-leaves test-first-key-is-canonical
                   test-map-entry-out-of-range-is-none test-vector-at-out-of-range-is-none
                   test-list-at-reads-a-list test-count-of-each-container
                   test-keyword-keys-sort-by-text test-string-keys-sort-by-canonical-bytes
                   test-edn-print-keyword-map test-edn-print-nested test-edn-print-string-escapes
                   test-edn-read-round-trips]})

(defn item [d :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at d i) (document-null)))

(defn entry [d :document i :i64] :document
  (option-value-of [:option :document] (document-map-entry-at d i) (document-null)))

(defn leaves [d :document depth :i64] :i64
  ;; leaves of a document: every non-container node, map values only
  (let [k (document-kind d)]
    (cond
      (> depth 8) 0
      (= k :map) (loop [i 0 acc 0]
                   (if (< i (document-count d))
                     (recur (+ i 1) (+ acc (leaves (item (entry d i) 1) (+ depth 1))))
                     acc))
      (= k :vector) (loop [i 0 acc 0]
                      (if (< i (document-count d))
                        (recur (+ i 1) (+ acc (leaves (item d i) (+ depth 1))))
                        acc))
      :else 1)))

(defn- sample [] :document
  (document-map :zeta (document-i64 1)
                :a (document-vector (document-string "x") (document-i64 2)
                                    (document-map :q (document-bool true)))
                :bb (document-null)))

(defn- first-keyword-key [d :document] :keyword
  (option-value-of [:option :keyword] (document-keyword-value (item (entry d 0) 0)) :none))

(defn- first-string-key [d :document] :string
  (option-value-of [:option :string] (document-string-value (item (entry d 0) 0)) "none"))

(defn test-walk-counts-leaves [] :bool (= (leaves (sample) 0) 5))

(defn test-first-key-is-canonical [] :bool (= (first-keyword-key (sample)) :a))

(defn test-map-entry-out-of-range-is-none [] :bool
  (and (= (document-kind (entry (sample) 3)) :null)
       (= (document-kind (entry (sample) -1)) :null)))

(defn test-vector-at-out-of-range-is-none [] :bool
  (= (document-kind (item (document-vector (document-i64 7)) 1)) :null))

(defn test-list-at-reads-a-list [] :bool
  (= (option-value-of [:option :i64]
                      (document-i64-value
                        (option-value-of [:option :document]
                                         (document-list-at (document-list (document-i64 4) (document-i64 9)) 1)
                                         (document-null)))
                      -1)
     9))

(defn test-count-of-each-container [] :bool
  (and (= (document-count (sample)) 3)
       (= (document-count (document-vector)) 0)
       (= (document-count (document-list (document-null))) 1)
       (= (document-count (document-set (document-i64 1) (document-i64 2))) 2)))

(defn test-keyword-keys-sort-by-text [] :bool
  ;; DAG-CBOR would put :b (1 byte) first
  (= (first-keyword-key (document-map :b (document-i64 1) :ab (document-i64 2))) :ab))

(defn test-string-keys-sort-by-canonical-bytes [] :bool
  ;; s10:... sorts before s1:..., so the 10-byte key comes first
  (string=? (first-string-key (document-map (document-string "b") (document-i64 1)
                                            (document-string "aaaaaaaaaa") (document-i64 2)))
            "aaaaaaaaaa"))

(defn test-edn-print-keyword-map [] :bool
  (string=? (document-edn-print (sample)) "{:a [\"x\" 2 {:q true}] :bb nil :zeta 1}"))

(defn test-edn-print-nested [] :bool
  (string=? (document-edn-print
              (document-map :x (document-vector (document-map :y (document-set (document-i64 2) (document-i64 1)))
                                                (document-string "") (document-list (document-i64 -3)))))
            "{:x [{:y #{1 2}} \"\" (-3)]}"))

(defn test-edn-print-string-escapes [] :bool
  (string=? (document-edn-print (document-string "a\"b\\c\n猫")) "\"a\\\"b\\\\c\\n猫\""))

(defn test-edn-read-round-trips [] :bool
  (document-equal? (document-edn-read "{:a [\"x\" 2 {:q true}] :bb nil :zeta 1}") (sample)))

;; main: the number of test-* that pass (12 when all do). Native runs main.
(defn main [] :i64
  (+ (if (test-walk-counts-leaves) 1 0) (if (test-first-key-is-canonical) 1 0)
     (if (test-map-entry-out-of-range-is-none) 1 0) (if (test-vector-at-out-of-range-is-none) 1 0)
     (if (test-list-at-reads-a-list) 1 0) (if (test-count-of-each-container) 1 0)
     (if (test-keyword-keys-sort-by-text) 1 0) (if (test-string-keys-sort-by-canonical-bytes) 1 0)
     (if (test-edn-print-keyword-map) 1 0) (if (test-edn-print-nested) 1 0)
     (if (test-edn-print-string-escapes) 1 0) (if (test-edn-read-round-trips) 1 0)))
