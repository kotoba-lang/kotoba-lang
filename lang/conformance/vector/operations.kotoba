;; lang/conformance/vector/operations.kotoba -- the :vector-i64 operations
;; (root ADR-2610092330 R4: the registry's :vector family, each operation run
;; on every required backend). The friendly heads (count, conj, nth, pop)
;; lower to these; the collections/ fixtures exercise those.

(ns vector-operations
  {:kotoba/export [main
                   test-new-and-count test-alloc test-at-and-get test-drop
                   test-assoc test-assoc-bang test-conj]})

(defn- v [] :vector-i64 (vector-new 10 20 30))

(defn test-new-and-count [] :bool
  (and (= (vector-count (v)) 3) (= (vector-count (vector-new)) 0)))

(defn test-alloc [] :bool
  (and (= (vector-count (vector-alloc 4)) 4) (= (vector-at (vector-alloc 4) 3) 0)))

(defn test-at-and-get [] :bool
  ;; vector-get answers its third argument out of range
  (and (= (vector-at (v) 1) 20) (= (vector-get (v) 2 -1) 30) (= (vector-get (v) 9 -1) -1)))

(defn test-drop [] :bool
  (and (= (vector-count (vector-drop (v) 1)) 2) (= (vector-at (vector-drop (v) 1) 0) 20)))

(defn test-assoc [] :bool
  (and (= (vector-at (vector-assoc (v) 0 7) 0) 7) (= (vector-at (v) 0) 10)))

(defn test-assoc-bang [] :bool
  (= (vector-at (vector-assoc! (v) 2 9) 2) 9))

(defn test-conj [] :bool
  (and (= (vector-count (vector-conj (v) 40)) 4) (= (vector-at (vector-conj (v) 40) 3) 40)))

;; main: the number of test-* that pass (7 when all do).
(defn main [] :i64
  (+ (if (test-new-and-count) 1 0) (if (test-alloc) 1 0) (if (test-at-and-get) 1 0)
     (if (test-drop) 1 0) (if (test-assoc) 1 0)
     (if (test-assoc-bang) 1 0) (if (test-conj) 1 0)))
