;; lang/conformance/vector/take.kotoba -- vector-take, on its own because the
;; typed Wasm lowering does not carry it yet (root ADR-2610092330 R4; the
;; deferral is recorded in the manifest and the runner reports when it closes).

(ns vector-take {:kotoba/export [main test-take]})

(defn test-take [] :bool
  (let [v (vector-new 10 20 30)]
    (and (= (vector-count (vector-take v 2)) 2) (= (vector-at (vector-take v 2) 1) 20)
         (= (vector-count (vector-take v 0)) 0))))

(defn main [] :i64 (if (test-take) 1 0))
