;; lang/conformance/vector/f64_operations.kotoba -- the :vector-f64
;; operations (root ADR-2610092330 R4: the registry's :vector-f64 family).

(ns vector-f64-operations
  {:kotoba/export [main
                   test-new-and-count test-at-and-get test-drop test-assoc test-conj]})

(defn- v [] :vector-f64 (vector-f64-new 1.5 2.5 3.5))

(defn test-new-and-count [] :bool
  (and (= (vector-f64-count (v)) 3) (= (vector-f64-count (vector-f64-new)) 0)))

(defn test-at-and-get [] :bool
  (and (= (vector-f64-at (v) 1) 2.5)
       (= (vector-f64-get (v) 2 -1.0) 3.5)
       (= (vector-f64-get (v) 9 -1.0) -1.0)))

(defn test-drop [] :bool
  (and (= (vector-f64-count (vector-f64-drop (v) 1)) 2) (= (vector-f64-at (vector-f64-drop (v) 1) 0) 2.5)))

(defn test-assoc [] :bool
  (and (= (vector-f64-at (vector-f64-assoc (v) 0 7.25) 0) 7.25) (= (vector-f64-at (v) 0) 1.5)))

(defn test-conj [] :bool
  (and (= (vector-f64-count (vector-f64-conj (v) 4.5)) 4) (= (vector-f64-at (vector-f64-conj (v) 4.5) 3) 4.5)))

;; main: the number of test-* that pass (5 when all do).
(defn main [] :i64
  (+ (if (test-new-and-count) 1 0) (if (test-at-and-get) 1 0) (if (test-drop) 1 0)
     (if (test-assoc) 1 0) (if (test-conj) 1 0)))
