;; lang/conformance/vector/f64_take.kotoba -- vector-f64-take on its own, as
;; vector/take.kotoba is for the i64 family (root ADR-2610092330 R4).

(ns vector-f64-take {:kotoba/export [main test-take]})

(defn test-take [] :bool
  (let [v (vector-f64-new 1.5 2.5 3.5)]
    (and (= (vector-f64-count (vector-f64-take v 2)) 2) (= (vector-f64-at (vector-f64-take v 2) 1) 2.5))))

(defn main [] :i64 (if (test-take) 1 0))
