(ns kotoba.lang.conformance.local-state-counter (:export [main]))

;; Local state, slice 1 (lang/local-state.edn): the whole shape the slice
;; exists for. The atom is born in a let, written twice, read once, and dies
;; there -- so it elaborates into three ordinary let bindings and no cell
;; exists at runtime.
(defn main [] :i64
  (let [a (atom 0)]
    (swap! a + 1)
    (swap! a + 41)
    @a))
