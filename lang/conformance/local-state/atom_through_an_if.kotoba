(ns kotoba.lang.conformance.local-state-if (:export [main]))

;; A write in each arm. The `if` is emitted twice -- once projecting the cell,
;; once projecting its own value -- and the enclosing scope rebinds `a` from
;; the first copy, which is what makes the join the value both arms agree on.
(defn- classify [n :i64] :i64
  (let [a (atom 0)]
    (if (> n 0) (swap! a + 10) (reset! a 5))
    (+ @a n)))

(defn main [] :i64
  (+ (classify 1) (classify -1)))
