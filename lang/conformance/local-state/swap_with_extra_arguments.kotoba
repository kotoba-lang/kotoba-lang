(ns kotoba.lang.conformance.local-state-extra (:export [main]))

;; `(swap! a f x y)` is `(f a x y)` under the ordinary arity limits, and the
;; cell may be read inside a later write's arguments -- the read takes the
;; value the cell had before that write, exactly as Clojure evaluates it.
(defn main [] :i64
  (let [a (atom 1)]
    (swap! a + 2 3)
    (swap! a * 7)
    (+ @a 0)))
