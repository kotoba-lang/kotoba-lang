(ns kotoba.lang.conformance.simple-sugar)

(defn subtract [a b] (- a b))

;; The tests are :bool: a number is never truthy (superproject adr-2609242330
;; gap 1). when-not answers [:option T], absent when its test is true.
(defn main []
  (+ (if-not false 4 (quot 1 0))
     (if-not true (quot 1 0) 0)
     (option-value-of [:option :i64] (when-not false (+ 2 3)) 0)
     (option-value-of [:option :i64] (when-not true (quot 1 0)) 0)
     (cond->> 3 true (subtract 10) false (quot 0))
     (as-> 2 x (+ x 3) (* x 2))))
