(ns kotoba.lang.conformance.some-sugar)

;; Absence is an [:option T], not 0. An absent value takes the else branch of
;; if-some and short-circuits when-some / some-> / some->> (the (quot .. 0)
;; steps are never evaluated); a PRESENT 0 is present -- the old nil=0
;; approximation is gone.
(defn main []
  (+ (if-some [x (option-none-of [:option :i64])] 99 3)
     (if-some [x (option-some-of [:option :i64] 0)] x 99)
     (option-value-of [:option :i64]
                      (when-some [x (option-none-of [:option :i64])] (quot 1 0))
                      0)
     (option-value-of [:option :i64] (some-> (option-none-of [:option :i64]) (quot 0)) 0)
     (option-value-of [:option :i64] (some->> (option-none-of [:option :i64]) (quot 0)) 0)))
