(ns kotoba.lang.conformance.case-threading)

;; if-let / when-let bind a value whose absence is an [:option T]: a number is
;; never truthy (superproject adr-2609242330 gap 1), so the bound test is an
;; option, and when-let answers [:option T] (absent when its binding is).
(defn main []
  (+ (-> 5 (+ 1) (* 2) (- 3))
     (->> 5 (* 2) (- 20))
     (case :b
       :a 1
       (:b :c) 23
       0)
     (if-let [x (option-some-of [:option :i64] 4)] x 0)
     (if-let [x (option-none-of [:option :i64])] (quot 1 0) 0)
     (option-value-of [:option :i64]
                      (when-let [x (option-some-of [:option :i64] 1)] (+ x 1) (+ x 4))
                      0)))
