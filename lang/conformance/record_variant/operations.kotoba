;; lang/conformance/record_variant/operations.kotoba -- records and variants
;; (root ADR-2610092330 R4: the registry's :record and :variant families).
;; Each names its descriptor as the first argument; a record field and a
;; variant tag are keyword literals, and a variant match covers every case in
;; order.

(ns record-variant-operations
  {:kotoba/export [main test-record test-record-assoc test-record-equal test-variant]})

(defn test-record [] :bool
  (let [p (record-new [:record :rv/point [[:x :i64] [:y :bool]]] 3 true)]
    (and (= (record-get [:record :rv/point [[:x :i64] [:y :bool]]] p :x) 3)
         (record-get [:record :rv/point [[:x :i64] [:y :bool]]] p :y))))

(defn test-record-assoc [] :bool
  (let [p (record-new [:record :rv/point [[:x :i64] [:y :bool]]] 3 true)
        q (record-assoc [:record :rv/point [[:x :i64] [:y :bool]]] p :x 4)]
    (and (= (record-get [:record :rv/point [[:x :i64] [:y :bool]]] q :x) 4)
         (= (record-get [:record :rv/point [[:x :i64] [:y :bool]]] p :x) 3))))

(defn test-record-equal [] :bool
  (let [p (record-new [:record :rv/point [[:x :i64] [:y :bool]]] 3 true)]
    (and (record-equal [:record :rv/point [[:x :i64] [:y :bool]]] p
                       (record-new [:record :rv/point [[:x :i64] [:y :bool]]] 3 true))
         (not (record-equal [:record :rv/point [[:x :i64] [:y :bool]]] p
                            (record-new [:record :rv/point [[:x :i64] [:y :bool]]] 4 true))))))

(defn test-variant [] :bool
  (let [c (variant-new [:variant :rv/shape [[:circle :i64] [:square :i64]]] :circle 5)
        s (variant-new [:variant :rv/shape [[:circle :i64] [:square :i64]]] :square 2)]
    (and (= (variant-match [:variant :rv/shape [[:circle :i64] [:square :i64]]] c
                           [[:circle r (* r 10)] [:square w w]]) 50)
         (= (variant-match [:variant :rv/shape [[:circle :i64] [:square :i64]]] s
                           [[:circle r (* r 10)] [:square w w]]) 2))))

;; main: the number of test-* that pass (4 when all do).
(defn main [] :i64
  (+ (if (test-record) 1 0) (if (test-record-assoc) 1 0) (if (test-record-equal) 1 0) (if (test-variant) 1 0)))
