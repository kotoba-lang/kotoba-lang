(defn unpack [a b c]
  (+ a (+ b c)))

(defn main []
  (let [[a [b c] & rest] [1 [2 3] 4 5]
        {:keys [missing x y] :or {missing 7 x 0 y 0}}
        (typed-map-new [:map :keyword :i64] :x 2 :y 3)]
    (+ (+ (+ (+ a b) (+ c (nth rest 1 0)))
          (+ missing (+ x y)))
       (unpack 1 2 3))))
