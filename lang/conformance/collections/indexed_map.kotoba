(ns conformance.collections.indexed-map)
(defn add-index [index value] (+ (* 10 index) value))
(defn main []
  (let [named (map-indexed add-index [3 4 5])
        inline (map-indexed (fn [index value] (+ index value)) [7 8])]
    (+ (nth named 0) (nth named 1) (nth named 2) (nth inline 0) (nth inline 1))))
