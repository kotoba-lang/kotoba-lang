;; A set literal is [:set :keyword] and nothing else. This fixture is the exact
;; shape collections/set.kotoba carried until 2026-09-03 -- one keyword and one
;; i64 in one literal -- and it is here so that "heterogeneous set literals are
;; not admitted" is a checked refusal rather than a sentence.
(defn main []
  (typed-set-count [:set :keyword] #{:a (+ 1 1)}))
