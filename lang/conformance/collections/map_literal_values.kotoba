;; A bounded map literal's VALUE type, read off the literal's own values.
;;
;; Until 2026-09-03 a literal's value type was fixed at `:i64`, so the first
;; line of this file was refused with `expression type mismatch: expected i64,
;; got string` -- a generic type error on a program that reads correct. The
;; typed-map layer under it already carried every value type used here;
;; `typed-map-new` was the only spelling that could reach them (kotoba-sema
;; ADR 0032, the value half of the key defect ADR 0012 named).
;;
;; Three value types, each read from a different place in the source:
;;
;;   :string   a string literal;
;;   :bool     a boolean literal;
;;   a record  from `record-new`'s FIRST ARGUMENT, which declares the type it
;;             builds and is a reserved head, so the literal cannot be made to
;;             read a descriptor off an unrelated call.
;;
;; 5 + 100 + 20 = 125.
(defn main []
  (+ (string-length (get {1 "one" 2 "two" 3 "three"} 3 ""))
     (+ (if (option-value-of [:option :bool]
              (typed-map-get [:map :string :bool] {"on" true "off" false} "on")
              false)
          100
          0)
        (record-get [:record :m/point [[:x :i64]]]
          (option-value-of [:option [:record :m/point [[:x :i64]]]]
            (typed-map-get [:map :i64 [:record :m/point [[:x :i64]]]]
              {7 (record-new [:record :m/point [[:x :i64]]] 20)}
              7)
            (record-new [:record :m/point [[:x :i64]]] 0))
          :x))))
