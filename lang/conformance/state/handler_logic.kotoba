(defhandler clamped
  "put never stores a negative number; every get costs one"
  [:state :i64]
  (get [s] (resume s (- s 1)))
  (put [s v] (if (< v 0) (resume 0 0) (resume v v))))

(defn- step [x :i64] :i64
  (if (> x 5) (perform :state/put x) (perform :state/put (- 0 x))))

(defn main [] :i64
  (handle (let [a (step 7) b (perform :state/get) c (step 2) d (perform :state/get)
                e (perform :state/get)]
            (+ (* 10000 a) (* 1000 b) (* 100 c) (* 10 d) (+ e 5)))
          (with clamped 3)))
