(defhandler acc [:state :i64]
  (get [s] (resume s s))
  (put [s v] (resume v v)))

(defn- add! [x :i64] :i64 (perform :state/put (+ x (perform :state/get))))

(defn- sum-to [n :i64] :i64
  (loop [i 1]
    (if (> i n)
      (perform :state/get)
      (do (add! i) (recur (+ i 1))))))

(defn main [] :i64
  (handle (sum-to 100) (with acc 0)))
