(defhandler count-i64 [:state :i64]
  (get [s] (resume s s))
  (put [s v] (resume v v)))

(defhandler keep-string [:state :string]
  (get [s] (resume s s))
  (put [s v] (resume v v)))

(defn- swap-in [x] (let [old (perform :state/get)] (perform :state/put x) old))

(defn- replace-twice [] (do (perform :state/put (perform :state/get)) (perform :state/get)))

(defn main [] :i64
  (let [n (handle (do (replace-twice) (perform :state/get)) (with count-i64 7))
        s (handle (do (replace-twice) (perform :state/get)) (with keep-string "abc"))]
    (+ n (string-byte-length s))))
