(defhandler counter [:state :i64]
  (get [s] (resume s s))
  (put [s v] (resume v v)))

(defn- bump [n :i64] :i64
  (perform :state/put (+ n (perform :state/get))))

(defn main [] :i64
  (handle
   (let [before (bump 1)
         inner (handle (do (bump 5) (bump 5) (perform :state/get))
                       (with counter 1000))
         after (perform :state/get)]
     (+ inner (* 100 after)))
   (with counter 10)))
