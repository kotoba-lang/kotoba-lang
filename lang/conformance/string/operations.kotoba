;; lang/conformance/string/operations.kotoba -- the portable :string
;; operations (root ADR-2610092330 R4: the registry's :string family). Offsets
;; and lengths are UTF-8 byte offsets throughout. The ABI v7 / v8 / v10 text,
;; line and range heads are in string/text_slots.kotoba.

(ns string-operations
  {:kotoba/export [main
                   test-lengths test-from-i64 test-equal test-concat-and-substring
                   test-search test-replace-and-split test-case test-code-point]})

(defn test-lengths [] :bool
  (and (= (string-byte-length "猫a") 4) (= (string-length "猫a") 4) (= (string-byte-length "") 0)))

(defn test-from-i64 [] :bool
  (and (string=? (string-from-i64 -42) "-42") (string=? (string-from-i64 0) "0")))

(defn test-equal [] :bool
  (and (string=? "ab" "ab") (not (string=? "ab" "ac"))))

(defn test-concat-and-substring [] :bool
  (and (string=? (string-concat "ab" "cd") "abcd")
       (string=? (string-substring "abcdef" 1 3) "bc")))

(defn test-search [] :bool
  (and (string-contains? "hello world" "lo w") (not (string-contains? "hello" "z"))
       (= (string-index-of "abcabc" "ca") 2) (= (string-index-of "abc" "z") -1)))

(defn test-replace-and-split [] :bool
  (and (string=? (string-replace-all "a-b-c" "-" "+") "a+b+c")
       (= (string-split-count "a,b,,c" ",") 4)))

(defn test-case [] :bool
  (and (string=? (string-upper "abc") "ABC") (string=? (string-fold-case "ABC") "abc")))

(defn test-code-point [] :bool
  (and (= (string-code-point-at "a猫" 0) 97) (= (string-code-point-at "a猫" 1) 29483)))

;; main: the number of test-* that pass (8 when all do).
(defn main [] :i64
  (+ (if (test-lengths) 1 0) (if (test-from-i64) 1 0) (if (test-equal) 1 0)
     (if (test-concat-and-substring) 1 0) (if (test-search) 1 0) (if (test-replace-and-split) 1 0)
     (if (test-case) 1 0) (if (test-code-point) 1 0)))
