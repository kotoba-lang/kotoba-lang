;; lang/conformance/string/text_slots.kotoba -- the ABI v7 / v8 / v10 text,
;; line and range heads (root ADR-2610092330 R4): byte order, an ASCII-only
;; fold, the blank scan pair, an absolute search from an offset, byte order of
;; two lines named by their start offsets, a byte search, and a range append.

(ns string-text-slots {:kotoba/export [main test-compare test-fold-ascii test-blanks test-index-of-from test-lines test-bytes-and-ranges]})

(defn test-compare [] :bool
  (and (< (string-compare "ab" "ac") 0) (= (string-compare "ab" "ab") 0) (> (string-compare "b" "ab") 0)))

(defn test-fold-ascii [] :bool (string=? (string-fold-ascii "AbC") "abc"))

(defn test-blanks [] :bool
  (and (= (string-find-blank "ab cd" 0) 2) (= (string-skip-blank "ab  cd" 2) 4)))

(defn test-index-of-from [] :bool (= (string-index-of-from "abcabc" "bc" 2) 4))

(defn test-lines [] :bool
  (and (= (string-compare-lines "a\nb" 0 "a\nb" 0) 0) (< (string-compare-lines "a\nb" 0 "a\nb" 2) 0)))

(defn test-bytes-and-ranges [] :bool
  (and (= (string-find-byte "a,b" 44 0) 1) (string=? (string-append-range "x" "abcdef" 1 3) "xbc")))

;; main: the number of test-* that pass (6 when all do).
(defn main [] :i64
  (+ (if (test-compare) 1 0) (if (test-fold-ascii) 1 0) (if (test-blanks) 1 0)
     (if (test-index-of-from) 1 0) (if (test-lines) 1 0) (if (test-bytes-and-ranges) 1 0)))
