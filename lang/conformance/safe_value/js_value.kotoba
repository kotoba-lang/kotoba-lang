;; lang/conformance/safe_value/js_value.kotoba -- the opaque :js-value heads
;; of the :typed-safe-value family (root ADR-2610092330 R4). A :js-value is a
;; host JavaScript value the program can only test, compare and capture.

(ns safe-value-js-value
  {:kotoba/export [main test-js]})

(defn test-js [] :bool
  (let [t (js-bool-value true)
        u (js-undefined)
        c (js-capture-new t 1)]
    (and (js-nullish? u) (not (js-nullish? t)) (js-truthy? t) (not (js-truthy? u))
         (js-strict-equal? t t) (not (js-array? t))
         (string=? (js-typeof t) "boolean")
         (js-truthy? (js-capture-value c)))))

;; main: 1 when test-js passes.
(defn main [] :i64
  (if (test-js) 1 0))
