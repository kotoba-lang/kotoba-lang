;; lang/conformance/safe_value/extractors.kotoba -- the value readers of the
;; one-word :option-i64 / :result-i64 (root ADR-2610092330 R4: the registry's
;; :typed-safe-value family). Each takes the fallback answered when the value
;; is the other case.

(ns safe-value-extractors
  {:kotoba/export [main test-option-value test-result-value]})

(defn test-option-value [] :bool
  (and (= (option-value (option-some 4) 0) 4) (= (option-value (option-none) 9) 9)))

(defn test-result-value [] :bool
  (and (= (result-value (result-ok 2) 0) 2) (= (result-value (result-err 3) 0) 0)
       (= (result-error (result-err 3) 0) 3) (= (result-error (result-ok 2) 0) 0)))

;; main: the number of test-* that pass (2 when both do).
(defn main [] :i64
  (+ (if (test-option-value) 1 0) (if (test-result-value) 1 0)))
