;; lang/conformance/safe_value/operations.kotoba -- the :typed-safe-value
;; operations (root ADR-2610092330 R4): bool-not, the one-word :option-i64 /
;; :result-i64 constructors and tests. Their value readers are
;; extractors.kotoba, the :js-value heads js_value.kotoba.

(ns safe-value-operations
  {:kotoba/export [main test-bool-not test-option test-result]})

(defn test-bool-not [] :bool
  (and (bool-not false) (not (bool-not true))))

(defn test-option [] :bool
  (and (option-some? (option-some 4)) (not (option-some? (option-none)))))

(defn test-result [] :bool
  (and (result-ok? (result-ok 2)) (not (result-ok? (result-err 3)))))

;; main: the number of test-* that pass (3 when all do).
(defn main [] :i64
  (+ (if (test-bool-not) 1 0) (if (test-option) 1 0) (if (test-result) 1 0)))
