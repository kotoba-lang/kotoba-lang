;; lang/conformance/hetero_vector/operations.kotoba -- the heterogeneous
;; vector (root ADR-2610092330 R4: the registry's :heterogeneous-vector
;; family). Its descriptor fixes each position's type, so an index is a literal
;; and what it reads has that position's type.

(ns hetero-vector-operations
  {:kotoba/export [main test-new-count test-at test-assoc test-equal]})

(defn test-new-count [] :bool
  (= (hetero-vector-count [:vector [:i64 :bool]] (hetero-vector-new [:vector [:i64 :bool]] 7 true)) 2))

(defn test-at [] :bool
  (let [v (hetero-vector-new [:vector [:i64 :bool]] 7 true)]
    (and (= (hetero-vector-at [:vector [:i64 :bool]] v 0) 7)
         (hetero-vector-at [:vector [:i64 :bool]] v 1))))

;; Assoc into the :i64 position. Assoc into the :bool one is refused by
;; kotoba-wasm's own validation today ("emitted Wasm module does not
;; validate", 2026-10-10) while kir and js run it.
(defn test-assoc [] :bool
  (let [v (hetero-vector-new [:vector [:i64 :bool]] 7 true)
        w (hetero-vector-assoc [:vector [:i64 :bool]] v 0 8)]
    (and (= (hetero-vector-at [:vector [:i64 :bool]] w 0) 8)
         (hetero-vector-at [:vector [:i64 :bool]] w 1))))

(defn test-equal [] :bool
  (let [v (hetero-vector-new [:vector [:i64 :bool]] 7 true)]
    (and (hetero-vector-equal [:vector [:i64 :bool]] v (hetero-vector-new [:vector [:i64 :bool]] 7 true))
         (not (hetero-vector-equal [:vector [:i64 :bool]] v (hetero-vector-new [:vector [:i64 :bool]] 8 true))))))

;; main: the number of test-* that pass (4 when all do).
(defn main [] :i64
  (+ (if (test-new-count) 1 0) (if (test-at) 1 0) (if (test-assoc) 1 0) (if (test-equal) 1 0)))
