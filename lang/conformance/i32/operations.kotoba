;; lang/conformance/i32/operations.kotoba -- the :i32 operations (root
;; ADR-2610092330 R4: the registry's :i32 family). There is no :i32 type: each
;; operation takes and answers an i64 word carrying 32-bit wrapping, and a
;; shift count is a literal in [0,31].

(ns i32-operations
  {:kotoba/export [main
                   test-wrap test-arithmetic test-xor test-shifts test-xorshift]})

(defn test-wrap [] :bool
  (and (= (i32-wrap 2147483648) -2147483648) (= (i32-wrap 4294967297) 1)
       (= (u32-wrap -1) 4294967295) (= (u32-wrap 4294967296) 0)))

(defn test-arithmetic [] :bool
  (and (= (i32-wrapping-add 2147483647 1) -2147483648) (= (i32-wrapping-add 2 3) 5)
       (= (i32-wrapping-mul 65536 65536) 0) (= (i32-wrapping-mul 6 7) 42)))

(defn test-xor [] :bool
  (and (= (i32-xor 5 3) 6) (= (i32-xor -1 0) -1)))

(defn test-shifts [] :bool
  (and (= (i32-shift-left 1 4) 16) (= (i32-shift-left 1 31) -2147483648)
       (= (i32-shift-right -8 1) -4) (= (u32-shift-right -8 1) 2147483644)))

(defn test-xorshift [] :bool
  (= (xorshift32 1) 270369))

;; main: the number of test-* that pass (5 when all do).
(defn main [] :i64
  (+ (if (test-wrap) 1 0) (if (test-arithmetic) 1 0) (if (test-xor) 1 0)
     (if (test-shifts) 1 0) (if (test-xorshift) 1 0)))
