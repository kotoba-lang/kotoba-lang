(ns kotoba.lang.conformance.abort-propagate (:export [main]))

;; The abort ability, slice 2 (lang/abort-ability.edn): `read2` writes neither
;; `throw` nor `try`. It is aborting because `parse` is, so its interface is
;; lowered to [:result :i64 :string] and its call site propagates the err arm.
;; Under slice 1 this program did not exist: `read2` had to write a `throw` it
;; did not mean in order to be allowed to call `parse` at all.
(defn- parse [s :string] :i64
  (if (string=? s "") (throw "empty") (string-length s)))

(defn- read2 [s :string] :i64 (+ 1 (parse s)))

(defn main [] :i64
  (try (read2 "") (catch e (string-length e))))
