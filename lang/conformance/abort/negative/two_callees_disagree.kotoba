(ns kotoba.lang.conformance.abort-negative (:export [main]))
;; refused: function g calls aborting functions with two different error types: string (`f`) and i64 (`h`)
;;
;; The same disagreement without `g` throwing anything itself: propagation
;; alone can produce two error types, and one function has exactly one E.
(defn- f [x :i64] :i64 (if (= x 0) (throw "s") x))
(defn- h [x :i64] :i64 (if (= x 0) (throw 9) x))
(defn- g [x :i64] :i64 (+ (f x) (h x)))
(defn main [] :i64 (try (g 1) (catch e 0)))
