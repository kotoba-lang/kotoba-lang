(ns kotoba.lang.conformance.abort-negative (:export [main]))
;; refused: unhandled abort at export boundary; catch it with try: main
;;
;; Slice 1 refused this at the CALL: `main` neither caught nor threw the same
;; type, so the call itself was the error. Slice 2 propagates instead -- `main`
;; becomes aborting because `f` is -- and the refusal that is left is the
;; export boundary, reached THROUGH the propagation. That is what this fixture
;; pins: not that the program is rejected, but that it is rejected HERE.
(defn- f [x :i64] :i64 (if (= x 0) (throw "s") x))
(defn main [] :i64 (f 1))
