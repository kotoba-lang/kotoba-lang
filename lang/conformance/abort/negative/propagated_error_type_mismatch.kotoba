(ns kotoba.lang.conformance.abort-negative (:export [main]))
;; refused: function g throws i64 but calls aborting function `f`, which aborts with string
;;
;; Slice 2 makes E interprocedural, so everything that can abort one function
;; must agree on it. `g` throws an i64 and calls `f`, which aborts with a
;; string. The refusal names both functions and both types.
(defn- f [x :i64] :i64 (if (= x 0) (throw "s") x))
(defn- g [x :i64] :i64 (if (= x 1) (throw 9) (f x)))
(defn main [] :i64 (try (g 1) (catch e 0)))
