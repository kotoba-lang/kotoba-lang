(ns kotoba.lang.conformance.abort-negative (:export [main]))
;; refused: a throw or a call to an aborting function before recur on the same path is not admitted: its result match would take the recur out of tail position; abort only on a path that exits the loop, or move the call out of the loop
;;
;; lang/abort-ability.edn :loop-body :not-before-recur. (f i) aborts and its
;; value feeds the recur, so the recur would sit inside (f i)'s result match.
;; The reference interpreter runs that as a loop; ESM and Wasm ran it as a
;; real call and ran out of frames (measured 2026-09-25), so it is refused
;; before any backend can disagree.
(defn- f [x :i64] :i64 (if (= x 3) (throw x) x))
(defn main [] :i64
  (try (loop [i 1 acc 0] (if (= i 5) acc (recur (+ i 1) (+ acc (f i)))))
       (catch e (+ 1000 e))))
