(ns kotoba.lang.conformance.abort-negative
  (:capabilities #{:dataspace/transact})
  (:export [main]))
;; refused: abort in function f whose effect row has a dataspace facet operation #{:dataspace/transact} is not admitted in abort slice 1: precondition :checked-lexical-facet-unwind is not met
;;
;; The other direction of lang/abort-ability.edn :loop-body. A throw inside a
;; loop body is admitted because the function the abort reaches is checked for
;; a facet operation in its interprocedural row -- here it has one, so the
;; abort that leaves the loop is refused at `f`, by the facet-unwind guard.
(defn- f [] :i64
  (do (facet-leave! 0)
      (loop [i 0] (if (= i 3) (throw "s") (recur (+ i 1))))))
(defn main [] :i64 (try (f) (catch e 0)))
