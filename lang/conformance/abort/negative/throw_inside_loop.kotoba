(ns kotoba.lang.conformance.abort-negative (:export [main]))
;; refused: throw inside a loop/doseq/dotimes body is not admitted in abort slice 1: precondition :checked-lexical-facet-unwind is not met
(defn main [] :i64
  (try (loop [i 0] (if (= i 3) (throw "s") (recur (+ i 1))))
       (catch e 0)))
