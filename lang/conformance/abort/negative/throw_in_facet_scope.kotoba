(ns kotoba.lang.conformance.abort-negative
  (:capabilities #{:dataspace/transact})
  (:export [main]))
;; refused: throw in function f whose effect row has a dataspace facet operation #{:dataspace/transact} is not admitted in abort slice 1: precondition :checked-lexical-facet-unwind is not met
(defn- f [] :i64 (do (facet-leave! 0) (throw "s")))
(defn main [] :i64 (try (f) (catch e 0)))
