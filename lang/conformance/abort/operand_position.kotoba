(ns kotoba.lang.conformance.abort-operand (:export [main]))

;; The abort ability, slice 2 (lang/abort-ability.edn): an aborting call in an
;; operand or a test position. Each of the three below was the slice-1 position
;; refusal; each is now A-normalized into a `let` binding, which is the
;; position slice 1's elaboration already lowered.
;;
;; The third is the one that pins EVALUATION ORDER: `(h 1)` is to the left of
;; `(f 2)`, so hoisting `(f 2)` alone would run it first. It is hoisted too.
(defn- f [x :i64] :i64 (if (= x 0) (throw "s") x))
(defn- h [x :i64] :i64 (+ x 1))
(defn- g [a :i64 b :i64] :i64 (- a b))

(defn main [] :i64
  (try (+ (+ 1 (f 7))                 ; operand:  8
          (if (> (f 5) 3) 100 200)    ; test:   100
          (g (h 1) (f 2)))            ; two operands, left to right: 0
       (catch e 0)))
