(ns kotoba.lang.conformance.abort-one (:export [main]))

;; The abort ability, slice 1 (lang/abort-ability.edn): a throw and the try
;; that catches it in one function. The try's value type is the join of the
;; branches -- the throwing branch contributes nothing -- and try removes
;; :abort from main's row, which is what lets main be exported.
(defn main [] :i64
  (try (if (> 1 0) (throw "boom") 5)
       (catch e 7)))
