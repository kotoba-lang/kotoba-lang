(ns kotoba.lang.conformance.abort-callee (:export [main]))

;; An abort raised in `parse`, re-raised through `twice` (which throws the
;; same error type itself, so the call in its let binding is admitted), and
;; caught twice in main: once with the error type written, once inferred.
;; Both helpers are defn-: an aborting function cannot be exported.
(defn- parse [s :string] :i64
  (if (string=? s "") (throw "empty") (string-length s)))

(defn- twice [s :string] :i64
  (if (string=? s "x")
    (throw "reserved")
    (let [v (parse s)] (* 2 v))))

(defn main [] :i64
  (+ (try (twice "") (catch :string e 100))
     (try (twice "ab") (catch e 0))))
