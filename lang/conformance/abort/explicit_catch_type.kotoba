(ns kotoba.lang.conformance.abort-explicit (:export [main]))

;; `(catch :string e ...)` pins E where the author wants it written. The
;; binder is the thrown value: "division by zero" has 16 bytes.
(defn- safe-div [a :i64 b :i64] :i64
  (if (= b 0) (throw "division by zero") (quot a b)))

(defn main [] :i64
  (try (safe-div 10 0)
       (catch :string e (string-length e))))
