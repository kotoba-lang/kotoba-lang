(ns kotoba.lang.conformance.abort-throw-inside-loop (:export [main]))
;; Admitted since 2026-09-25 (lang/abort-ability.edn :loop-body): a throw
;; inside a loop body. Until then this file was a negative case refused
;; "throw inside a loop/doseq/dotimes body is not admitted in abort slice 1:
;; precondition :checked-lexical-facet-unwind is not met". The loop helper
;; aborts, the try in the same function catches it, and the handler reads the
;; thrown string: (string-length "three") = 5, plus 100 for the iteration the
;; loop had reached. A loop that finished without throwing would answer 0.
(defn main [] :i64
  (try (loop [i 0] (if (= i 3) (throw "three") (recur (+ i 1))))
       (catch e (+ 100 (string-length e)))))
