(ns kotoba.lang.conformance.abort-call-inside-loop (:export [main]))
;; Admitted since 2026-09-25 (lang/abort-ability.edn :loop-body): a call to an
;; aborting function inside a loop body, on the path that EXITS the loop.
;; Until then refused "call to aborting function `f` inside a
;; loop/doseq/dotimes body is not admitted in abort slice 1: precondition
;; :checked-lexical-facet-unwind is not met". The loop reaches i = 3 and exits
;; through (f 3), which throws 3; the try catches it: 1000 + 3. Had f
;; returned, the loop would answer 3.
(defn- f [x :i64] :i64 (if (= x 3) (throw x) x))
(defn main [] :i64
  (try (loop [i 1] (if (= i 3) (f i) (recur (+ i 1))))
       (catch e (+ 1000 e))))
