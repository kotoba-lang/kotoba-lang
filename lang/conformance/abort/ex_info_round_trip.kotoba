(ns kotoba.lang.conformance.abort-ex-info (:export [main]))

;; The abort ability, slice 2 (lang/abort-ability.edn): the error type E is a
;; `:document`, not a string or an i64. `parse`'s inferred interface is
;; [:result :i64 :document], the catch binds the document, and the message is
;; read back out of it.
;;
;; The three helpers are the bodies of `lang/compat/clojure/core.kotoba`,
;; copied here because a conformance fixture is one module and this repository
;; has no project linker to call. The MODULE itself is executed -- joined to a
;; harness, and checked against clojure.core -- by
;; test/kotoba/lang/clojure_core_compat_test.clj. This fixture is about the
;; ability carrying a document, not about the shim.
;;
;; `(ex-info "empty" {:input s})` is what a .cljc author would write and it
;; does NOT compile: a map literal is a constant document and `s` is a local.
;; The data is built with `document-map`.
(defn- ex-info [msg :string data :document] :document
  (document-map (document-keyword :message) (document-string msg)
                (document-keyword :data) data))

(defn- ex-message [e :document] :string
  (option-or (document-string-value
              (option-or (document-get e (document-keyword :message)) (document-null)))
             ""))

(defn- parse [s :string] :i64
  (if (string=? s "")
    (throw (ex-info "empty input" (document-map (document-keyword :input) (document-string s))))
    (string-length s)))

(defn main [] :i64
  (try (parse "") (catch e (string-length (ex-message e)))))
