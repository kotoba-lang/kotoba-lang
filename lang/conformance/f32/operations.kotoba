;; lang/conformance/f32/operations.kotoba -- the :f32 operations (root
;; ADR-2610092330 R4: the registry's :f32 family). There is no binary32
;; literal, so every value enters through f64-to-f32-rounded from a binary64
;; literal that binary32 represents exactly.

(ns f32-operations
  {:kotoba/export [main
                   test-arithmetic test-unary test-bits test-compare
                   test-conversions test-integer-conversions]})

(defn f [x] :f32 (f64-to-f32-rounded x))

(defn test-arithmetic [] :bool
  (and (f32-eq (f32-add (f 1.5) (f 2.25)) (f 3.75)) (f32-eq (f32-sub (f 3.75) (f 1.5)) (f 2.25))
       (f32-eq (f32-mul (f 1.5) (f 2.0)) (f 3.0)) (f32-eq (f32-div (f 3.0) (f 2.0)) (f 1.5))
       (f32-eq (f32-min (f 1.5) (f 2.25)) (f 1.5)) (f32-eq (f32-max (f 1.5) (f 2.25)) (f 2.25))))

(defn test-unary [] :bool
  (and (f32-eq (f32-neg (f 1.5)) (f -1.5)) (f32-eq (f32-abs (f -2.25)) (f 2.25))
       (f32-eq (f32-sqrt (f 2.25)) (f 1.5))))

(defn test-bits [] :bool
  (and (= (f32-to-bits (f 1.0)) 1065353216)
       (f32-eq (f32-from-bits 1069547520) (f 1.5))))

(defn test-compare [] :bool
  (and (f32-lt (f 1.5) (f 2.0)) (f32-le (f 1.5) (f 1.5)) (f32-gt (f 2.0) (f 1.5))
       (f32-ge (f 2.0) (f 2.0)) (not (f32-eq (f 1.5) (f 2.0))) (not (f32-unordered (f 1.5) (f 2.0)))))

(defn test-conversions [] :bool
  (and (f64-eq (f32-to-f64-exact (f 2.25)) 2.25)
       (f32-eq (f64-to-f32-rounded 2.25) (f 2.25))))

(defn test-integer-conversions [] :bool
  (and (f32-eq (i64-to-f32-checked 3) (f 3.0)) (f32-eq (i64-to-f32-rounded 3) (f 3.0))
       (= (f32-to-i64-checked (f 3.0)) 3) (= (f32-to-i64-truncating (f 3.75)) 3)))

;; main: the number of test-* that pass (6 when all do).
(defn main [] :i64
  (+ (if (test-arithmetic) 1 0) (if (test-unary) 1 0) (if (test-bits) 1 0)
     (if (test-compare) 1 0) (if (test-conversions) 1 0) (if (test-integer-conversions) 1 0)))
