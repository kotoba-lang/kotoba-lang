;; lang/conformance/option_result/operations.kotoba -- the type-argument
;; option and result heads (root ADR-2610092330 R4: the registry's
;; :generic-option and :parametric-result families). Each names its full type
;; as its first argument.

(ns option-result-operations
  {:kotoba/export [main test-option test-option-match test-result test-result-match]})

(defn test-option [] :bool
  (let [some (option-some-of [:option :i64] 7)
        none (option-none-of [:option :i64])]
    (and (option-some?-of [:option :i64] some) (not (option-some?-of [:option :i64] none))
         (= (option-value-of [:option :i64] some 0) 7) (= (option-value-of [:option :i64] none 0) 0))))

(defn test-option-match [] :bool
  (and (= (option-match [:option :i64] (option-some-of [:option :i64] 5) 0 x (+ x 1)) 6)
       (= (option-match [:option :i64] (option-none-of [:option :i64]) 0 x (+ x 1)) 0)))

(defn test-result [] :bool
  (let [ok (result-ok-of [:result :i64 :string] 3)
        err (result-err-of [:result :i64 :string] "no")]
    (and (result-ok?-of [:result :i64 :string] ok) (not (result-ok?-of [:result :i64 :string] err))
         (= (result-value-of [:result :i64 :string] ok 0) 3) (= (result-value-of [:result :i64 :string] err 0) 0)
         (string=? (result-error-of [:result :i64 :string] err "") "no")
         (string=? (result-error-of [:result :i64 :string] ok "") ""))))

(defn test-result-match [] :bool
  (and (= (result-match-of [:result :i64 :string] (result-ok-of [:result :i64 :string] 4) v (* v 2) e 0) 8)
       (= (result-match-of [:result :i64 :string] (result-err-of [:result :i64 :string] "e") v (* v 2) e -1) -1)))

;; main: the number of test-* that pass (4 when all do).
(defn main [] :i64
  (+ (if (test-option) 1 0) (if (test-option-match) 1 0) (if (test-result) 1 0) (if (test-result-match) 1 0)))
