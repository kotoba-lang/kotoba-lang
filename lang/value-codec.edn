 :kotoba.lang.value-codec/resolved-gap
 {:exact-i64 {:status :implemented
              :merge "66cb0062a0890206f98b51462efde8d8fbb63c2f"
              :code 9
              :payload :signed-two-complement-8-byte-big-endian
              :wrapper "kotoba.value.codec/int64"
