{:kotoba.lang.typed-eval/version 1
 :kotoba.lang.typed-eval/status :implemented
 :kotoba.lang.typed-eval/authority "kotoba-lang/kotoba-lang"
 :kotoba.lang.typed-eval/adr "docs/adr/ADR-kotoba-typed-eval.md"
 :source-syntax (eval request)
 :semantic-capability :code/eval
 :compiler-wire-id 30
 :request
 {:type :document
  :required #{:definition-cid :arguments}
  :optional #{:fuel :max-depth}
  :definition-cid :checked-kir-definition-cid
  ;; The CID this request names is minted for every checked definition,
  ;; effectful ones included; that is why :receipt below is meaningful.
  :definition-scope "lang/code-identity.edn :definition-cid :scope — checked definitions, effectful included (:closed-deterministic-checked-definition, 2026-09-02)"
  :arguments :canonical-document-vector
  :never #{:source-text :reader-form :namespace-name :host-object :capability-value}}
 :result {:type :infer-from-context
          :evidence :value-cid}
 :identity-layers
 [:definition-cid :admission-cid :value-cid]
 :admission-binds
 [:definition-cid :typed-interface :effect-row :allowed-effects :fuel :max-depth]
 :execution
 {:closure-resolution :cid-only
  :missing-dependency :fail-closed
  :effect-rule :transitive-effects-must-be-subset-of-current-allowance
  :nested-eval :strictly-decreasing-depth
  :provider :host-bound
  :receipt :required-for-effectful-evaluation
  :admission-and-result-blocks :persisted-by-codebase-host}
 :raw-eval
 {:host-eval :forbidden
  :load-string :forbidden
  :reader-eval :forbidden
  :ambient-namespace-resolution :forbidden}
 :cache
 {:pure [:admission-cid :input-value-cids]
  :effectful :never-substitute-a-result-for-performing-the-effect}
 :invariants
 [:content-identity-is-not-authority
  :result-hash-is-after-the-fact-evidence
  :checked-kir-is-reverified-as-hostile-input
  :provider-revalidates-resource-scope
  :no-authority-amplification]}
