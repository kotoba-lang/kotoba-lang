(ns benchmark-io (:export [main]))

;; The same full 1 MiB file is read and summed on every one of 12 calls.
;; Keep the FS2 result as bytes: converting it to a mutable vector performs
;; another complete byte validation and copy. The response length is immutable.
(defn read-sum [] :i64
  (let [prefix (string-from-utf8 (bytes-from-vector-i64 [0 70 83 50 0 65]))
        request (string-concat prefix (string-concat "payload.bin" (string-from-utf8 (bytes-from-vector-i64 [0]))))
        data (typed-cap-call :fs/app-data :string :bytes request)
        n (bytes-count data)]
    (if (and (= n 1048581)
             (= (bytes-at data 0) 0) (= (bytes-at data 1) 70)
             (= (bytes-at data 2) 83) (= (bytes-at data 3) 50)
             (= (bytes-at data 4) 0))
      (loop [i 5 total 0]
        (if (= i n) total
          (recur (+ i 1) (+ total (bytes-at data i)))))
      -1)))

(defn main [] :i64
  (loop [i 0 total 0]
    (if (= i 12) total (recur (+ i 1) (+ total (read-sum))))))
