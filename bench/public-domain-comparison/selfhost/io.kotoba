(ns benchmark-io (:export [main]))

;; Same 1 MiB / unsigned-byte-sum contract as the original public fixture.
;; Wire35 is granted only the private payload directory by the observer.
(defn read-sum [] :i64
  (let [prefix (string-from-utf8 (bytes-from-vector-i64 [0 70 83 50 0 65]))
        request (string-concat prefix (string-concat "payload.bin" (string-from-utf8 (bytes-from-vector-i64 [0]))))
        data (vector-i64-from-bytes (typed-cap-call :fs/app-data :string :bytes request))]
    (if (and (= (vector-count data) 1048581)
             (= (vector-at data 0) 0) (= (vector-at data 1) 70)
             (= (vector-at data 2) 83) (= (vector-at data 3) 50)
             (= (vector-at data 4) 0))
      (loop [i 5 total 0]
        (if (= i (vector-count data)) total
          (recur (+ i 1) (+ total (vector-at data i)))))
      -1)))

(defn main [] :i64
  (loop [i 0 total 0]
    (if (= i 12) total (recur (+ i 1) (+ total (read-sum))))))
