; Kotoba Spec naming v1. Data in Kotoba ADL; not executable source.
(map
  (:kotoba.spec/naming-version 1)
  (:status :accepted)
  (:authority "kotoba-lang/kotoba-lang")
  (:document "docs/lang/naming.md")
  (:validator "kotoba.lang.naming")
  (:profiles
    (map
      (:version 1)
      (:id-segment "[a-z][A-Za-z0-9]*")
      (:project-root "kotoba")
      (:field-segment "[a-z][A-Za-z0-9]*(?:-[a-z0-9]+)*")
      (:field-path :nonempty-vector-of-literal-string-keys-or-safe-indices)
      (:max-index 9007199254740991)
      (:subject-root "kotoba")
      (:single-token "*")
      (:terminal-one-or-more ">")
      (:normalization :none)
      (:layout :explicit-authoring-check)))
  (:contexts
    (map
      (:dotted-id :exact-name-in-an-explicit-catalog-or-contract)
      (:source-name :lisp-symbol-subject-to-guest-grammar)
      (:field-path :relative-data-selection-with-literal-key-and-index-types)
      (:event-subject :declared-event-classification-not-resource-location)
      (:subscription-pattern :bounded-selection-not-authority)
      (:display-name :arbitrary-text-not-an-identifier)))
  (:punctuation
    (map
      (:dot :hierarchy-within-a-declared-context)
      (:hyphen :word-boundary-or-minus-operator)
      (:slash :namespace-name-boundary-or-division-operator)
      (:underscore :ordinary-symbol-character-unused-binding-convention)
      (:plus :ordinary-symbol-character-addition-convention)
      (:equals :ordinary-symbol-character-equality-convention)
      (:question :predicate-suffix-convention)
      (:bang :mutation-or-effect-suffix-convention-not-a-grant)
      (:star :multiplication-or-earmuffs-in-source-wildcard-only-in-selectors)
      (:hash :reader-dispatch-or-generated-name-marker-never-an-id-segment)
      (:at :reader-deref-prefix-not-an-ordinary-name-character)
      (:tilde :reserved-unquote-family-not-general-name-punctuation)
      (:prime :noninitial-symbol-character-reader-quote-at-start)
      (:reader-acceptance :guest-grammar-and-reader-target-not-this-table)))
  (:source-whitespace
    (map
      (:canonical :ascii-space-and-lf-outside-literals-and-comments)
      (:indent-spaces 2)
      (:aligned-continuations true)
      (:comma :compatibility-reader-separator-not-name-punctuation)
      (:tabs-and-crlf :compatibility-reader-input-noncanonical-authoring)
      (:strings-comments-character-literals :preserve-verbatim)
      (:invisible-space-normalization false)
      (:parser-admission-changed false)))
  (:compatibility
    (map
      (:legacy-aliases :explicit-exact-one-hop)
      (:alias-grammar :existing-catalog-nonblank-string)
      (:alias-collision :reject-whole-catalog)
      (:hyphen-to-dot false)
      (:case-folding false)
      (:namespace-rewrite false)
      (:existing-source-symbols :not-rejected-by-authoring-style)
      (:definition-identity :existing-normalized-typed-kir)
      (:new-runtime-syntax false)))
  (:conformance
    (vector
      (map (:kind :project-id) (:value "kotoba.coll") (:valid? true))
      (map (:kind :project-id) (:value "kotoba.docs.documentChange") (:valid? true))
      (map (:kind :project-id) (:value "kotoba.foo-bar") (:valid? false))
      (map (:kind :project-id) (:value "kotoba.foo bar") (:valid? false))
      (map (:kind :project-id) (:value "kotoba..coll") (:valid? false))
      (map (:kind :project-id) (:value "kotoba.coll/map-vals") (:valid? false))
      (map (:kind :lisp-name) (:value "map-vals") (:valid? true))
      (map (:kind :lisp-name) (:value "_") (:valid? true))
      (map (:kind :lisp-name) (:value "_unused") (:valid? true))
      (map (:kind :lisp-name) (:value "+") (:valid? true))
      (map (:kind :lisp-name) (:value "=") (:valid? true))
      (map (:kind :lisp-name) (:value "not=") (:valid? true))
      (map (:kind :lisp-name) (:value "valid?") (:valid? true))
      (map (:kind :lisp-name) (:value "reset!") (:valid? true))
      (map (:kind :lisp-name) (:value "*") (:valid? true))
      (map (:kind :lisp-name) (:value "*context*") (:valid? true))
      (map (:kind :lisp-name) (:value "-") (:valid? true))
      (map (:kind :lisp-name) (:value "->") (:valid? true))
      (map (:kind :lisp-name) (:value "/") (:valid? true))
      (map (:kind :lisp-name) (:value "値を読む") (:valid? true))
      (map (:kind :lisp-name) (:value "@value") (:valid? false))
      (map (:kind :lisp-name) (:value "value#") (:valid? false))
      (map (:kind :lisp-name) (:value "~value") (:valid? false))
      (map (:kind :lisp-name) (:value "foo bar") (:valid? false))
      (map (:kind :qualified-name) (:value "coll/map-vals") (:valid? true))
      (map (:kind :qualified-name) (:value "math/+") (:valid? true))
      (map (:kind :qualified-name) (:value "math//") (:valid? true))
      (map (:kind :qualified-name) (:value "a/b/c") (:valid? false))
      (map (:kind :field-path) (:value "profile.display-name") (:valid? true))
      (map (:kind :field-path) (:value "profile.firstName") (:valid? true))
      (map (:kind :field-path) (:value (vector "profile" "display.name")) (:valid? true))
      (map (:kind :field-path) (:value (vector "items" 0 "name")) (:valid? true))
      (map (:kind :field-path) (:value (vector "" "*")) (:valid? true))
      (map (:kind :field-path) (:value "items.0.name") (:valid? false))
      (map (:kind :field-path) (:value "profile.*") (:valid? false))
      (map (:kind :field-path) (:value "profile..name") (:valid? false))
      (map (:kind :event-subject) (:value "kotoba.docs.document.changed") (:valid? true))
      (map (:kind :event-subject) (:value "kotoba.docs.*") (:valid? false))
      (map (:kind :subscription-pattern) (:value "kotoba.docs.*.changed") (:valid? true))
      (map (:kind :subscription-pattern) (:value "kotoba.docs.>") (:valid? true))
      (map (:kind :subscription-pattern) (:value "kotoba.docs.>.changed") (:valid? false))
      (map (:kind :subscription-pattern) (:value "kotoba.docs.doc*") (:valid? false)))))
