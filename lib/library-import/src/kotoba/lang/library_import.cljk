(ns kotoba.lang.library-import
  "Pure development-source discovery for the bundled Kotoba libraries.

  IDs are Kotoba names, not DNS authorities or ATProto NSIDs. Aliases are
  explicit, one-hop names for the same package. Discovery never constructs a
  release lock, downloads code, or grants authority. Signed package admission
  remains with the existing package contract and its owning repositories."
  (:require [kotoba.lang.text :as str]
            [kotoba.lang.naming :as naming]))

(def catalog-version 1)

(def library-id? naming/project-id?)

(defn- relative-path? [value]
  (and (string? value)
       (seq value)
       (every? #(and (seq %) (not (#{"." ".."} %))) (str/split value #"/" -1))
       (boolean (re-matches #"[A-Za-z0-9_./-]+" value))))

(defn validate
  "Validate the entire catalog before resolving any name. Reject collisions
  instead of allowing map insertion order to select an implementation."
  [catalog]
  (let [packages (:packages catalog)
        entries (if (vector? packages) packages [])
        ids (map :id entries)
        aliases (mapcat #(if (vector? (:aliases %)) (:aliases %) []) entries)
        all-names (concat ids aliases)
        problems
        (vec
          (concat
            (when-not (= catalog-version (:kotoba.library-catalog/version catalog))
              [{:problem :library/catalog-version}])
            (when-not (vector? packages) [{:problem :library/packages-not-vector}])
            (for [package entries
                  :when (not (and (map? package)
                                  (library-id? (:id package))
                                  (= :library (:kind package))
                                  (= (:path package) (str "lib/" (:id package)))
                                  (relative-path? (:path package))
                                  (vector? (:source-paths package))
                                  (seq (:source-paths package))
                                  (every? relative-path? (:source-paths package))
                                  (vector? (:aliases package))
                                  (every? #(and (string? %) (not (str/blank? %)))
                                          (:aliases package))))]
              {:problem :library/package-invalid :id (:id package)})
            (for [[name count] (frequencies all-names) :when (> count 1)]
              {:problem :library/name-collision :name name})))]
    (if (seq problems)
      {:ok? false :problems problems}
      {:ok? true :catalog catalog})))

(defn resolve-library
  "Resolve an exact canonical ID or declared legacy alias. A package owns
  its aliases directly: there is no alias graph, prefix rewrite, case folding,
  or hyphen-to-dot conversion. Unknown names and ambiguous catalogs refuse."
  [catalog requested]
  (let [checked (validate catalog)]
    (if-not (:ok? checked)
      checked
      (if-let [package (first (filter #(or (= requested (:id %))
                                          (some #{requested} (:aliases %)))
                                     (:packages catalog)))]
        {:ok? true :requested requested :id (:id package)
         :alias? (not= requested (:id package)) :package package}
        {:ok? false :problems [{:problem :library/not-found :name requested}]}))))

(defn source-paths
  "Development classpath roots for requested libraries, in request order.
  Failed resolution yields no partial classpath. Paths remain repo-relative."
  [catalog requests]
  (let [checked (validate catalog)
        resolved (mapv #(resolve-library catalog %) requests)]
    (cond
      (not (:ok? checked)) checked
      (every? :ok? resolved)
      {:ok? true
       :ids (vec (distinct (map :id resolved)))
       :paths (vec (distinct
                     (mapcat (fn [{:keys [package]}]
                               (map #(str (:path package) "/" %) (:source-paths package)))
                             resolved)))}
      :else {:ok? false :problems (vec (mapcat :problems (remove :ok? resolved)))})))

(def ^:private source-flags
  {"--runtime" [:runtime false] "--library" [:library true]
   "--source-path" [:source-path true] "-S" [:source-path true]
   "--function" [:function false] "--arg" [:arg true]})

(defn parse-argv
  "Shape source-import argv without mistaking negative EDN arguments for
  options. Boolean --json consumes no following ID or source filename."
  [argv]
  (loop [tokens (seq argv) positionals [] options {}]
    (if-not tokens
      {:positionals positionals :options options}
      (let [[token value & more] tokens
            [id repeatable?] (get source-flags token)]
        (cond
          (= "--json" token)
          (if (contains? options :json)
            {:parse-problem {:problem :library/duplicate-option :option token}}
            (recur (next tokens) positionals (assoc options :json true)))
          id
          (cond
            (nil? value) {:parse-problem {:problem :library/missing-option-value :option token}}
            (and (contains? options id) (not repeatable?))
            {:parse-problem {:problem :library/duplicate-option :option token}}
            :else (recur more positionals
                         (if repeatable? (update options id (fnil conj []) value)
                             (assoc options id value))))
          (str/starts-with? token "-")
          {:parse-problem {:problem :library/unsupported-option :option token}}
          :else (recur (next tokens) (conj positionals token) options))))))

(def sci-options #{:runtime :library :source-path :S :function :arg :json})

(defn- values [x]
  (cond (nil? x) [] (vector? x) x :else [x]))

(defn source-request
  "Validate the public source-import request before a host reads or runs code.
  SCI is an explicitly selected CLJK compatibility host, never a fallback for
  checked Kotoba or a signed release. Policy/admission flags cannot be ignored."
  [{:keys [positionals options parse-problem]}]
  (let [runtime (get options :runtime "kotoba")
        libraries (values (:library options))
        roots (values (or (:source-path options) (:S options)))
        unknown (vec (sort (remove sci-options (keys options))))]
    (cond
      parse-problem (assoc parse-problem :ok? false)
      (not (#{"kotoba" "sci"} runtime))
      {:ok? false :problem :run/runtime-invalid}
      (and (seq libraries) (not= "sci" runtime))
      {:ok? false :problem :library/runtime-required}
      (not= "sci" runtime) {:ok? true :runtime :kotoba}
      (seq unknown) {:ok? false :problem :library/unsupported-option :options unknown}
      (and (:source-path options) (:S options))
      {:ok? false :problem :library/duplicate-source-path-option}
      (or (empty? libraries) (not-every? #(and (string? %) (not (str/blank? %))) libraries))
      {:ok? false :problem :library/import-required}
      (not (and (= 1 (count positionals)) (string? (first positionals))
                (re-find #"\.(cljk|cljc|cljs)$" (first positionals))))
      {:ok? false :problem :library/source-unsupported}
      (not-every? #(and (string? %) (not (str/blank? %))) roots)
      {:ok? false :problem :library/source-path-invalid}
      (not (or (naming/lisp-name? (get options :function "main"))
               ;; Retain the original selector alphabet, including qualified
               ;; selectors. Authoring style must not narrow public inputs.
               (and (string? (get options :function "main"))
                    (re-matches #"[A-Za-z_*+!?<>=][A-Za-z0-9_.*+!?<>=/-]*"
                                (get options :function "main")))))
      {:ok? false :problem :library/function-invalid}
      (not-every? string? (values (:arg options)))
      {:ok? false :problem :library/argument-invalid}
      :else {:ok? true :runtime :sci :libraries libraries :entry (first positionals)
             :source-roots roots :function (get options :function "main")
             :arguments (values (:arg options))})))

(defn import-request
  "library import accepts exact IDs/aliases and --json only."
  [{:keys [positionals options parse-problem]}]
  (let [names (vec (rest positionals))]
    (cond
      parse-problem (assoc parse-problem :ok? false)
      (or (not= "import" (first positionals)) (empty? names)
          (not-every? #(and (string? %) (not (str/blank? %))) names))
      {:ok? false :problem :library/import-required}
      (seq (remove #{:json} (keys options)))
      {:ok? false :problem :library/unsupported-option}
      :else {:ok? true :libraries names})))
