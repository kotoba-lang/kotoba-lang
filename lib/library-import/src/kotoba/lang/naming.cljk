(ns kotoba.lang.naming
  "Kotoba naming v1. Pure syntax checks, never lookup, evaluation or authority.

  Lisp source names, package/contract IDs, data paths and event selectors are
  different contexts. This authoring profile does not replace a source reader
  or widen guest-grammar. The normative document is kotoba/spec/naming.kotoba."
  (:require [kotoba.lang.text :as str]))

(def profiles
  {:version 1
   :id-segment "[a-z][A-Za-z0-9]*"
   :project-root "kotoba"
   :library-roots {:default ["kotoba"]
                   :declared-by :catalog-namespace-authorities
                   :authorities [:kotoba-project :external-reverse-domain]
                   :external-min-segments 3
                   :dns-authority false}
   :field-segment "[a-z][A-Za-z0-9]*(?:-[a-z0-9]+)*"
   :field-path :nonempty-vector-of-literal-string-keys-or-safe-indices
   :max-index 9007199254740991
   :subject-root "kotoba"
   :single-token "*"
   :terminal-one-or-more ">"
   :normalization :none
   :layout :explicit-authoring-check})

(defn- matches? [pattern value]
  (and (string? value) (boolean (re-matches pattern value))))

(defn id-segment? [value]
  (matches? #"[a-z][A-Za-z0-9]*" value))

(defn dotted-id?
  "An exact dotted name, at least two nonempty ASCII segments. Not DNS."
  [value]
  (and (string? value)
       (let [parts (str/split value #"\." -1)]
         (and (< 1 (count parts)) (every? id-segment? parts)))))

(defn project-id? [value]
  (and (dotted-id? value) (str/starts-with? value "kotoba.")))

(def library-authorities
  "Closed set of authorities a catalog may give a library root. Neither is DNS ownership
  that this namespace checks: the validator is syntax only and never looks anything up."
  #{:kotoba-project :external-reverse-domain})

(defn library-id-under?
  "`roots` maps each root a catalog declares to its authority. A `:kotoba-project` root
  names Kotoba's own specifications (`kotoba.coll`: two or more segments). An
  `:external-reverse-domain` root is the first label of the reverse domain of an external
  specification's publisher (`org.nist.sha3`: root, publisher domain, specification, so
  three or more segments)."
  [value roots]
  (and (dotted-id? value)
       (let [parts (str/split value #"\." -1)
             authority (get roots (first parts))]
         (case authority
           :kotoba-project true
           :external-reverse-domain (<= 3 (count parts))
           false))))

(defn- whitespace? [ch]
  ;; Explicit set: Java and JS disagree about \s and Unicode whitespace.
  (matches? #"[\u0009-\u000d\u0020\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]" ch))

(defn lisp-name?
  "Portable authoring name, not a complete language admission predicate.
  Operators, earmuffs, primes, Unicode letters and underscores remain names.
  Reader prefixes and dot/slash boundaries are not ordinary name characters."
  [value]
  (boolean (and (string? value) (seq value)
       (not (contains? #{"nil" "true" "false" "&" "%" "%&"} value))
       (or (= "/" value)
           (and (not (matches? #"[0-9']" (subs value 0 1)))
                (not (re-find #"^[+-][0-9]" value))
                (every? (fn [ch]
                          (and (not (whitespace? ch))
                               (not (contains? #{"(" ")" "[" "]" "{" "}" "\"" ";" "\\"
                                                 "@" "^" "`" "~" "#" ":" "/" "." ","} ch))
                               (not (matches? #"[\u0000-\u001f\u007f-\u009f]" ch))))
                        (map str value)))))))

(defn namespace-name? [value]
  (and (string? value)
       (every? #(and (not= "/" %) (lisp-name? %)) (str/split value #"\." -1))))

(defn qualified-name?
  "One namespace/name boundary. ns// is the qualified division name."
  [value]
  (and (string? value)
       (let [parts (str/split value #"/" -1)]
         (or (and (= 2 (count parts)) (namespace-name? (first parts))
                  (lisp-name? (second parts)))
             (and (= 3 (count parts)) (namespace-name? (first parts))
                  (= ["" ""] (subvec (vec parts) 1)))))))

(defn field-segment? [value]
  (matches? #"[a-z][A-Za-z0-9]*(?:-[a-z0-9]+)*" value))

(defn- index? [value]
  (and (integer? value) (<= 0 value 9007199254740991)))

(defn parse-field-path
  "Dotted shorthand is relative data selection, with no escapes or wildcards.
  A vector carries exact string keys (even empty/dotted keys) or array indices.
  String keys never become keywords, numbers, code names or event subjects."
  [value]
  (let [parts (cond
                (string? value) (let [xs (str/split value #"\." -1)]
                                  (when (every? field-segment? xs) xs))
                (and (vector? value) (seq value)
                     (every? #(or (string? %) (index? %)) value)) value
                :else nil)]
    (if (seq parts)
      {:ok? true :segments (vec parts)}
      {:ok? false :problem :naming/invalid-field-path})))

(defn field-path? [value] (:ok? (parse-field-path value)))

(def event-subject? project-id?)

(defn subscription-pattern? [value]
  (and (string? value) (str/starts-with? value "kotoba.")
       (let [parts (str/split value #"\." -1)]
         (every? true?
                 (map-indexed (fn [i part]
                                (boolean (or (id-segment? part) (= "*" part)
                                             (and (= ">" part) (= i (dec (count parts)))))))
                              parts)))))

(defn subject-matches?
  "Pure selection only. A match grants no access. > consumes ONE or more."
  [pattern subject]
  (boolean
    (and (subscription-pattern? pattern) (event-subject? subject)
         (loop [ps (str/split pattern #"\." -1) ss (str/split subject #"\." -1)]
           (cond
             (empty? ps) (empty? ss)
             (= ">" (first ps)) (boolean (seq ss))
             (empty? ss) false
             (or (= "*" (first ps)) (= (first ps) (first ss)))
             (recur (rest ps) (rest ss))
             :else false)))))

(defn validate-event-names
  "Validate names in a Lexicon declaration. Payload/grant/transport admission
  remains with its owner; optional selectors and paths stay separate fields."
  [event]
  (let [checks [[[:id] project-id?]
                [[:subject] event-subject?]
                [[:payload-schema :id] project-id?]
                [[:publish :operation-id] project-id?]
                [[:subscribe :operation-id] project-id?]]
        optional [[[:subscribe :pattern] subscription-pattern?]
                  [[:field-path] field-path?]]
        required-paths (set (map first checks))
        problems (vec (for [[path predicate] (concat checks optional)
                            :let [parent (get-in event (pop path))]
                            :when (and (or (contains? required-paths path)
                                           (and (map? parent) (contains? parent (peek path))))
                                       (not (predicate (get-in event path))))]
                        {:problem :naming/invalid-event-name :path path}))]
    (if (seq problems) {:ok? false :problems problems} {:ok? true})))

(defn validate-source-whitespace
  "Optional authoring check: ASCII spaces and LF outside strings/comments.
  This is not a reader or formatter. It preserves literal/comment contents,
  including escaped quotes and character literals; malformed source must still
  be checked by the actual reader/compiler. Indentation uses two spaces per
  nesting level by convention, with aligned continuations allowed."
  [source]
  (if-not (string? source)
    {:ok? false :problems [{:problem :naming/source-not-text}]}
    (loop [i 0 state :code escaped? false problems []]
      (if (= i (count source))
        {:ok? (empty? problems) :problems problems}
        (let [ch (subs source i (inc i))
              problem (when (or (and (= state :code) (whitespace? ch)
                                    (not (contains? #{" " "\n"} ch)))
                               (and (= state :comment) (= ch "\r")))
                        {:problem :naming/noncanonical-whitespace :offset i})
              next-state (case state
                           :comment (if (= ch "\n") :code :comment)
                           :string (if (and (= ch "\"") (not escaped?)) :code :string)
                           :character-start (if (matches? #"[A-Za-z0-9]" ch)
                                              :character :code)
                           :character :character
                           (cond (= ch ";") :comment (= ch "\"") :string
                                 (= ch "\\") :character-start :else :code))]
          (if (and (= state :character)
                   (or (whitespace? ch)
                       (contains? #{"(" ")" "[" "]" "{" "}" "\"" ";" ","} ch)))
            (recur i :code false problems)
            (recur (inc i) next-state
                   (and (= state :string) (= ch "\\") (not escaped?))
                   (cond-> problems problem (conj problem)))))))))

(def conformance-predicates
  {:project-id project-id? :lisp-name lisp-name? :qualified-name qualified-name?
   :field-path field-path? :event-subject event-subject?
   :subscription-pattern subscription-pattern?})

(defn validate-spec
  "Check a decoded Kotoba ADL spec against this implementation, including all
  normative examples. The caller must decode through the actual ADL owner."
  [spec]
  (let [cases (:conformance spec)
        shape? (and (= 1 (:kotoba.spec/naming-version spec))
                    (= :accepted (:status spec)) (= profiles (:profiles spec))
                    (vector? cases) (seq cases))
        problems (cond-> [] (not shape?) (conj {:problem :naming/spec-profile}))
        problems (into problems
                       (keep-indexed
                         (fn [i {:keys [kind value valid? roots]}]
                           (let [predicate (if (= :library-id kind)
                                             (when (map? roots)
                                               (let [roots (into {} (map (fn [[k v]] [(name k) v])) roots)]
                                                 #(library-id-under? % roots)))
                                             (get conformance-predicates kind))]
                             (when-not (and predicate (boolean? valid?)
                                            (= valid? (boolean (predicate value))))
                               {:problem :naming/spec-conformance :case i})))
                         (if (vector? cases) cases [])))]
    {:ok? (empty? problems) :problems problems}))
