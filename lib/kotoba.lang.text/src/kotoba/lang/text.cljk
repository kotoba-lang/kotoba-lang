#?(:kotoba
   (ns kotoba.lang.text
     "String / regex / unicode helpers for the kotoba foundational stdlib. The gap
     every other lib re-rolls (json/lint/time hand-roll string ops). Pure string
     ops are portable; regex uses the host's #\"...\". `format` is a pure printf
     impl with flags/width/precision (no String/format — WASM-safe), varargs like
     clojure.core/format, which is JVM-only. Runs on JVM/SCI/CLJS/GraalVM/kotoba-WASM.
   
     Zero third-party runtime deps; .cljc."
     {:kotoba/export [blank-text? blank? capitalize codepoints ends-with? escape format from-codepoints includes? index-of index-of-text join last-index-of last-index-of-text lower pad-center-text pad-left pad-left-text pad-right pad-right-text re-find re-matches re-quote re-seq repeat-text replace replace-first replace-first-text reverse reverse-text segment-count-text segment-text split split-lines starts-with? trim trim-newline trim-newline-text trim-text triml triml-text trimr trimr-text truncate upper]}
     (:refer-clojure :exclude [format split join replace re-find re-matches re-seq
                               reverse]))
   :default
(ns kotoba.lang.text
  "String / regex / unicode helpers for the kotoba foundational stdlib. The gap
  every other lib re-rolls (json/lint/time hand-roll string ops). Pure string
  ops are portable; regex uses the host's #\"...\". `format` is a pure printf
  impl with flags/width/precision (no String/format — WASM-safe), varargs like
  clojure.core/format, which is JVM-only. Runs on JVM/SCI/CLJS/GraalVM/kotoba-WASM.

  Zero third-party runtime deps; .cljc."
  {:kotoba/export [blank-text? blank? capitalize codepoints ends-with? escape format from-codepoints includes? index-of index-of-text join last-index-of last-index-of-text lower pad-center-text pad-left pad-left-text pad-right pad-right-text re-find re-matches re-quote re-seq repeat-text replace replace-first replace-first-text reverse reverse-text segment-count-text segment-text split split-lines starts-with? trim trim-newline trim-newline-text trim-text triml triml-text trimr trimr-text truncate upper]}
  (:refer-clojure :exclude [format split join replace re-find re-matches re-seq
                            reverse])))

;; the text helpers (the tail loops of the model)
#?(:kotoba
   (defn- ends-with-w [s :string suffix :string i :i64 n :i64 m :i64] :bool
     (if (>= i m)
       true
       (if (= (string-code-point-at s (- n m i)) (string-code-point-at suffix i))
         (ends-with-w s suffix (+ i 1) n m)
         false))))
#?(:kotoba
   (defn- opt-i64 [v :i64] :document
     (if (< v 0) (document-null) (document-i64 v))))
#?(:kotoba
   (defn- last-idx-w [s :string value :string i :i64] :i64
     (if (< i 0)
       -1
       (if (at-w s value i 0 (string-length value))
         i
         (last-idx-w s value (- i 1))))))
#?(:kotoba
   (defn- at-w [s :string value :string i :i64 j :i64 m :i64] :bool
     (if (>= j m)
       true
       (if (= (string-code-point-at s (+ i j)) (string-code-point-at value j))
         (at-w s value i (+ j 1) m)
         false))))
#?(:kotoba
   (defn- blank-w [s :string i :i64 n :i64] :bool
     (if (>= i n)
       true
       (let [c (string-code-point-at s i)]
         (if (or (= c 9) (= c 10) (= c 11) (= c 12) (= c 13) (= c 32))
           (blank-w s (+ i 1) n)
           false)))))
#?(:kotoba
   (defn- rev-w [s :string i :i64 n :i64 acc :string] :string
     (if (>= i n)
       acc
       (rev-w s (+ i 1) n (string-concat (string-concat acc (string-substring s (- n i 1) (- n i))) "")))))
#?(:kotoba
   (defn- rep-w [s :string times :i64 acc :string] :string
     (if (<= times 0)
       acc
       (rep-w s (- times 1) (string-concat acc s)))))
#?(:kotoba
   (defn- tn-end [s :string i :i64 n :i64] :i64
     (if (>= i n)
       n
       (let [c (string-code-point-at s i)]
         (if (or (= c 10) (= c 13))
           (tn-end s (+ i 1) n)
           n)))))
#?(:kotoba
   (defn- ws-c? [c :i64] :bool
     (or (= c 32) (and (>= c 9) (<= c 13)) (and (>= c 28) (<= c 31)) (= c 160) (= c 5760) (and (>= c 8192) (<= c 8198)) (= c 8200) (= c 8201) (= c 8202) (= c 8232) (= c 8233) (= c 8287) (= c 12288))))
#?(:kotoba
   (defn- ws-l [s :string i :i64 n :i64] :i64
     (if (>= i n)
       n
       (if (ws-c? (string-code-point-at s i))
         (ws-l s (+ i (cp-w (string-code-point-at s i))) n)
         i))))
#?(:kotoba
   (defn- ws-r [s :string i :i64 n :i64] :i64
     (if (>= i n)
       i
       (if (ws-c? (string-code-point-at s (- n 1)))
         (ws-r s i (- n 1))
         n))))
#?(:kotoba
   (defn- cp-w [c :i64] :i64
     (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4)))
#?(:kotoba
   (defn- sl-w [s :string i :i64 n :i64 from :i64 acc :document] :document
     (if (>= i n)
       (document-vector-conj acc (__r6-as :document (string-substring s from n)))
       (let [c (string-code-point-at s i)]
         (if (= c 10)
           (sl-w s (+ i 1) n (+ i 1) (document-vector-conj acc (__r6-as :document (if (and (> i from) (= (string-code-point-at s (- i 1)) 13)) (string-substring s from (- i 1)) (string-substring s from i)))))
           (sl-w s (+ i 1) n from acc))))))
#?(:kotoba
   (defn- rev-cp-w [s :string i :i64 n :i64 acc :string] :string
     (if (>= i n)
       acc
       (let [c (string-code-point-at s i)
             w (cp-w c)]
         (rev-cp-w s (+ i w) n (string-concat (cp-bytes c) acc))))))
#?(:kotoba
   (defn- cps-w [s :string i :i64 n :i64 acc :document] :document
     (if (>= i n)
       acc
       (let [c (string-code-point-at s i)]
         (cps-w s (+ i (cp-w c)) n (document-vector-conj acc (document-i64 c)))))))
#?(:kotoba
   (defn- fc-w [cps :document i :i64 n :i64 acc :string] :string
     (if (>= i n)
       acc
       (fc-w cps (+ i 1) n (string-concat acc (cp-bytes (option-value-of [:option :i64] (document-i64-value (option-value-of [:option :document] (document-vector-at cps i) (document-null))) 0)))))))
#?(:kotoba
   (defn- pad-w [s :string width :i64 ch :i64 need :i64 acc :string] :string
     (if (>= need width)
       acc
       (pad-w s width ch (+ need 1) (string-concat acc (cp-bytes ch))))))
#?(:kotoba
   (defn- cp-bytes [c :i64] :string
     (cond (< c 128) (string-from-utf8 (bytes-from-vector-i64 (vector-assoc! (vector-alloc 1) 0 c)))
           (< c 2048) (string-from-utf8 (bytes-from-vector-i64 (vector-assoc! (vector-assoc! (vector-alloc 2) 0 (+ 192 (quot c 64))) 1 (+ 128 (rem c 64)))))
           (< c 65536) (string-from-utf8 (bytes-from-vector-i64 (vector-assoc! (vector-assoc! (vector-assoc! (vector-alloc 3) 0 (+ 224 (quot c 4096))) 1 (+ 128 (rem (quot c 64) 64))) 2 (+ 128 (rem c 64)))))
           :else (string-from-utf8 (bytes-from-vector-i64 (vector-assoc! (vector-assoc! (vector-assoc! (vector-assoc! (vector-alloc 4) 0 (+ 240 (quot c 262144))) 1 (+ 128 (rem (quot c 4096) 64))) 2 (+ 128 (rem (quot c 64) 64))) 3 (+ 128 (rem c 64)))))))
)#?(:kotoba
   (defn- slit-w [s :string sep :string i :i64 n :i64 from :i64 acc :document] :document
     (if (>= i n)
       (document-vector-conj acc (__r6-as :document (string-substring s from n)))
       (if (at-w s sep i 0 (string-length sep))
         (slit-w s sep (+ i (string-length sep)) n (+ i (string-length sep)) (document-vector-conj acc (__r6-as :document (string-substring s from i))))
         (slit-w s sep (+ i 1) n from acc)))))
#?(:kotoba
   (defn- seg-n [parts :document n :i64] :document
     (if (or (< n 0) (>= n (document-count parts)))
       (document-null)
       (option-value-of [:option :document] (document-vector-at parts n) (document-null)))))
#?(:kotoba
   (defn- pc-w [s :string width :i64 fill :string len :i64] :string
     (if (>= len width)
       s
       (let [total (- width len)
             left (quot total 2)]
         (string-concat (string-concat (rep-w fill left "") s) (rep-w fill (- total left) ""))))))
#?(:kotoba
   (defn- rf-w [s :string match :string replacement :string at :i64] :string
     (if (< at 0)
       s
       (string-concat (string-concat (string-substring s 0 at) replacement) (string-substring s (+ at (string-length match)) (string-length s))))))
#?(:kotoba
   (defn- uo-w [cps :document i :i64 n :i64 off :i64 acc :document] :document
     (if (>= i n)
       acc
       (let [c (option-value-of [:option :i64] (document-i64-value (option-value-of [:option :document] (document-vector-at cps i) (document-null))) 0)]
         (uo-w cps (+ i 1) n (+ off (cp-w c)) (document-vector-conj acc (document-i64 off)))))))
#?(:kotoba
   (defn- bi-w [cps :document i :i64 n :i64 off :i64 target :i64] :i64
     (if (>= i n)
       i
       (let [c (option-value-of [:option :i64] (document-i64-value (option-value-of [:option :document] (document-vector-at cps i) (document-null))) 0)]
         (if (>= off target)
           i
           (bi-w cps (+ i 1) n (+ off (cp-w c)) target))))))
#?(:kotoba
   (defn- tr-w [s :string i :i64 n :i64 max-len :i64] :string
     (if (or (>= i n) (<= max-len 0))
       (string-substring s 0 i)
       (tr-w s (+ i (cp-w (string-code-point-at s i))) n (- max-len 1)))))
#?(:kotoba
   (defn- tr2-w [s :string max-len :i64 ellipsis :string] :string
     (if (<= (cp-count-w s 0 (string-length s) 0) max-len)
       s
       (string-concat (tr-w s 0 (string-length s) (- max-len (cp-count-w ellipsis 0 (string-length ellipsis) 0))) ellipsis))))
#?(:kotoba
   (defn- cp-count-w [s :string i :i64 n :i64 acc :i64] :i64
     (if (>= i n)
       acc
       (cp-count-w s (+ i (cp-w (string-code-point-at s i))) n (+ acc 1)))))
#?(:kotoba
   (defn- val-str [v :document] :string
     (if (= :string (document-kind v))
       (__r6-as :string v)
       (cp-bytes (option-value-of [:option :i64] (document-i64-value v) 0)))))
#?(:kotoba
   (defn- lidx-start [s :string value :string from-index :i64] :i64
     (let [m (- (string-length s) (string-length value))]
       (if (< m 0) -1 (if (< from-index m) from-index m)))))
#?(:kotoba
   (defn- jn-w [coll :document i :i64 n :i64 acc :string sep :string] :string
     (if (>= i n)
       acc
       (jn-w coll (+ i 1) n
             (string-concat (string-concat acc (if (= i 0) "" sep)) (val-str (option-value-of [:option :document] (document-vector-at coll i) (document-null))))
             sep))))
#?(:kotoba
   (defn- esc-w [s :string cmap :document i :i64 n :i64 acc :string] :string
     (if (>= i n)
       acc
       (let [c (string-code-point-at s i)
             w (cp-w c)
             r (option-value-of [:option :document] (document-get cmap (document-i64 c)) (document-null))]
         (esc-w s cmap (+ i w) n
                (if (document-equal? r (document-null))
                  (string-concat acc (string-substring s i (+ i w)))
                  (string-concat acc (val-str r))))))))
;; ---- the regex engine (W2): the pattern is the R6J string; pc-relative jumps ----
#?(:kotoba
   (defn- rx-op [ins :document] :i64 (option-value-of [:option :i64] (document-i64-value (option-value-of [:option :document] (document-vector-at ins 0) (document-null))) 0)))
#?(:kotoba
   (defn- rx-arg [ins :document k :i64] :i64 (option-value-of [:option :i64] (document-i64-value (option-value-of [:option :document] (document-vector-at ins k) (document-null))) 0)))
#?(:kotoba
   (defn- rx-ins [op :i64 a :i64 b :i64] :document (document-vector-conj (document-vector-conj (document-vector-conj (document-vector) (document-i64 op)) (document-i64 a)) (document-i64 b))))
#?(:kotoba
   (defn- rx-cat [a :document b :document] :document (rx-cat-w a b 0 (document-count b))))
#?(:kotoba
   (defn- rx-cat-w [a :document b :document i :i64 n :i64] :document
     (if (>= i n) a (rx-cat-w (document-vector-conj a (option-value-of [:option :document] (document-vector-at b i) (document-null))) b (+ i 1) n))))
#?(:kotoba
   (defn- rx-one [op :i64 a :i64 b :i64] :document (document-vector-conj (document-vector) (rx-ins op a b))))
;; ---- the run (backtracking, greedy: the SPLIT a branch first) ----
#?(:kotoba
   (defn- rx-run [prog :document s :string pc :i64 i :i64 n :i64 aux :document caps :document] :document
     (if (>= pc (document-count prog))
       (rx-no)
       (let [ins (option-value-of [:option :document] (document-vector-at prog pc) (document-null))
             op (rx-op ins)]
         (cond (= op 0) (rx-fin caps i)
               (= op 1) (if (and (< i n) (= (string-code-point-at s i) (rx-arg ins 1)))
                          (rx-run prog s (+ pc 1) (+ i 1) n aux caps)
                          (rx-no))
               (= op 2) (if (< i n) (rx-run prog s (+ pc 1) (+ i (cp-w (string-code-point-at s i))) n aux caps) (rx-no))
               (= op 3) (if (and (< i n) (rx-ranges? (string-code-point-at s i) aux (rx-arg ins 1) (rx-arg ins 2)))
                          (rx-run prog s (+ pc 1) (+ i (cp-w (string-code-point-at s i))) n aux caps)
                          (rx-no))
               (= op 4) (rx-alt2 (rx-run prog s (+ pc (rx-arg ins 1)) i n aux caps) prog s (+ pc (rx-arg ins 2)) i n aux caps)
               (= op 5) (rx-run prog s (+ pc (rx-arg ins 1)) i n aux caps)
               :else (rx-run prog s (+ pc 1) i n aux (rx-sv caps (rx-arg ins 1) i)))))))
#?(:kotoba
   (defn- rx-alt2 [first :document prog :document s :string pc :i64 i :i64 n :i64 aux :document caps :document] :document
     (if (rx-ok? first) first (rx-run prog s pc i n aux caps))))
#?(:kotoba
   (defn- rx-ranges? [c :i64 aux :document lo :i64 hi :i64] :bool (rx-rw c aux lo hi 0)))
#?(:kotoba
   (defn- rx-rw [c :i64 aux :document lo :i64 hi :i64 k :i64] :bool
     (if (>= k hi)
       false
       (if (and (>= c (rx-n aux (+ lo k))) (<= c (rx-n aux (+ lo k 1))))
         true
         (rx-rw c aux lo hi (+ k 2))))))
#?(:kotoba
   (defn- rx-n [aux :document k :i64] :i64 (option-value-of [:option :i64] (document-i64-value (option-value-of [:option :document] (document-vector-at aux k) (document-null))) 0)))
#?(:kotoba
   (defn- rx-sv [caps :document slot :i64 i :i64] :document (document-vector-conj (document-vector-conj caps (document-i64 slot)) (document-i64 i))))
#?(:kotoba
   (defn- rx-fin [caps :document end :i64] :document (document-vector-conj caps (document-i64 end))))
#?(:kotoba
   (defn- rx-no [] :document (document-vector)))
#?(:kotoba
   (defn- rx-ok? [r :document] :bool (> (document-count r) 0)))
;; ---- the parse: the alternation / sequence / atom with quantifiers ----
#?(:kotoba
   (defn- rx-parse [pat :string] :document
     (rx-p-alt pat 0 (string-length pat) (document-vector) (document-vector) 0)))
;; returns [prog aux slot] packed as the :document vector [prog aux (document-i64 slot)]
#?(:kotoba
   (defn- rx-p-alt [pat :string p :i64 pend :i64 prog :document aux :document slot :i64] :document
     (let [a (rx-p-seq pat p pend prog aux slot)
           prog1 (rx-n3 a 0)
           aux1 (rx-n3 a 1)
           slot1 (rx-n3i a 2)
           bend (rx-bar-end pat (rx-seq-end pat p pend 1) pend)]
       (if (rx-bar? pat (rx-seq-end pat p pend 1) pend)
         (let [b (rx-p-alt pat (+ (rx-seq-end pat p pend 1) 1) pend (document-vector) aux1 slot1)
               prog2 (rx-n3 b 0)
               aux2 (rx-n3 b 1)
               slot2 (rx-n3i b 2)]
           (rx-pack (rx-cat (rx-cat (rx-cat (rx-one 4 1 (+ 2 (document-count prog1))) prog1) (rx-one 5 (+ 1 (document-count prog2)) 0)) prog2) aux2 slot2))
         (rx-pack prog1 aux1 slot1)))))
#?(:kotoba
   (defn- rx-pack [prog :document aux :document slot :i64] :document (document-vector-conj (document-vector-conj (document-vector-conj (document-vector) prog) aux) (document-i64 slot))))
#?(:kotoba
   (defn- rx-n3 [v :document k :i64] :document (option-value-of [:option :document] (document-vector-at v k) (document-null))))
#?(:kotoba
   (defn- rx-n3i [v :document k :i64] :i64 (option-value-of [:option :i64] (document-i64-value (option-value-of [:option :document] (document-vector-at v k) (document-null))) 0)))
#?(:kotoba
   (defn- rx-seq-end [pat :string p :i64 pend :i64 depth :i64] :i64
     (if (>= p pend)
       pend
       (let [c (string-code-point-at pat p)]
         (cond (= c 92) (rx-seq-end pat (+ p 2) pend depth)
               (= c 124) (if (= depth 1) p (rx-seq-end pat (+ p 1) pend depth))
               (= c 40) (rx-seq-end pat (+ p 1) pend (+ depth 1))
               (= c 41) (if (= depth 1) p (rx-seq-end pat (+ p 1) pend (- depth 1)))
               :else (rx-seq-end pat (+ p 1) pend depth))))))
#?(:kotoba
   (defn- rx-bar? [pat :string p :i64 pend :i64] :bool (and (< p pend) (= 124 (string-code-point-at pat p)))))
#?(:kotoba
   (defn- rx-bar-end [pat :string p :i64 pend :i64] :i64 p))
#?(:kotoba
   (defn- rx-p-seq [pat :string p :i64 pend :i64 prog :document aux :document slot :i64] :document
     (if (>= p pend)
       (rx-pack prog aux slot)
       (let [c (string-code-point-at pat p)]
         (if (or (= c 124) (= c 41))
           (rx-pack prog aux slot)
           (let [aend (rx-atom-end pat p pend)
                 q (rx-quant pat aend pend)
                 qend (rx-quant-end pat aend pend)
                 u (rx-p-atom pat p aend prog aux slot)
                 prog1 (rx-n3 u 0)
                 aux1 (rx-n3 u 1)
                 slot1 (rx-n3i u 2)
                 seg (rx-quantize (rx-sub prog prog1) q)]
             (rx-p-seq pat qend pend (rx-cat prog seg) aux1 slot1)))))))
;; the atom's program = the tail of prog1 after prog (the slice)
#?(:kotoba
   (defn- rx-sub [prog :document prog1 :document] :document (rx-sub-w prog1 (document-count prog) (document-count prog1) (document-vector))))
#?(:kotoba
   (defn- rx-sub-w [v :document i :i64 n :i64 acc :document] :document
     (if (>= i n) acc (rx-sub-w v (+ i 1) n (document-vector-conj acc (option-value-of [:option :document] (document-vector-at v i) (document-null)))))))
#?(:kotoba
   (defn- rx-atom-end [pat :string p :i64 pend :i64] :i64
     (let [c (string-code-point-at pat p)]
       (cond (= c 92) (if (< (+ p 1) pend) (+ p 2) pend)
             (= c 40) (rx-gclose pat (+ p 1) pend 1)
             (= c 91) (rx-cclose pat (+ p 1) pend)
             :else (+ p 1)))))
#?(:kotoba
   (defn- rx-gclose [pat :string p :i64 pend :i64 depth :i64] :i64
     (if (>= p pend)
       pend
       (let [c (string-code-point-at pat p)]
         (cond (= c 92) (rx-gclose pat (+ p 2) pend depth)
               (= c 40) (rx-gclose pat (+ p 1) pend (+ depth 1))
               (= c 41) (if (= depth 1) (+ p 1) (rx-gclose pat (+ p 1) pend (- depth 1)))
               :else (rx-gclose pat (+ p 1) pend depth))))))
#?(:kotoba
   (defn- rx-cclose [pat :string p :i64 pend :i64] :i64
     (if (>= p pend)
       pend
       (let [c (string-code-point-at pat p)]
         (cond (= c 92) (rx-cclose pat (+ p 2) pend)
               (= c 93) (+ p 1)
               :else (rx-cclose pat (+ p 1) pend))))))
#?(:kotoba
   (defn- rx-quant [pat :string p :i64 pend :i64] :i64
     (if (>= p pend) 0 (let [c (string-code-point-at pat p)] (cond (= c 42) 1 (= c 43) 2 (= c 63) 3 :else 0)))))
#?(:kotoba
   (defn- rx-quant-end [pat :string p :i64 pend :i64] :i64
     (if (< 0 (rx-quant pat p pend)) (+ p 1) p)))
#?(:kotoba
   (defn- rx-quantize [seg :document q :i64] :document
     (let [L (document-count seg)]
       (cond (= q 0) seg
             (= q 1) (rx-cat (rx-cat (rx-one 4 1 (+ 2 L)) seg) (rx-one 5 (- 0 (+ L 1)) 0))
             (= q 2) (rx-cat (rx-cat seg (rx-one 4 (- 0 L) 1)) (rx-one 5 1 0))
             :else (rx-cat (rx-one 4 1 (+ 2 L)) (rx-cat seg (rx-one 5 1 0)))))))
;; the atom -> program (the group gets SAVE pairs; slot numbering is the open order)
#?(:kotoba
   (defn- rx-p-atom [pat :string p :i64 aend :i64 prog :document aux :document slot :i64] :document
     (let [c (string-code-point-at pat p)]
       (cond (= c 40) (let [inner (rx-p-alt pat (+ p 1) (- aend 1) (document-vector) aux (+ slot 2))
                            ip (rx-n3 inner 0)
                            ia (rx-n3 inner 1)
                            is (rx-n3i inner 2)]
                        (rx-pack (rx-cat (rx-cat (rx-one 6 slot 0) ip) (rx-one 6 (+ slot 1) 0)) ia is))
             (= c 91) (rx-cc-prog pat (+ p 1) (- aend 1) prog aux slot)
             (= c 46) (rx-pack (rx-cat prog (rx-one 2 0 0)) aux slot)
             (= c 92) (rx-esc-atom pat p aend prog aux slot)
             :else (rx-pack (rx-cat prog (rx-one 1 c 0)) aux slot)))))
;; the character class: [^a-z\d..] -> the ranges in aux + CLASS
#?(:kotoba
   (defn- rx-cc-prog [pat :string p :i64 pend :i64 prog :document aux :document slot :i64] :document
     (let [neg (if (and (< p pend) (= 94 (string-code-point-at pat p))) 1 0)
           lo (document-count aux)
           u (rx-cc-items pat (+ p neg) pend aux)
           aux1 (rx-n3 u 0)
           hi (- (document-count aux1) lo)]
       (rx-pack (rx-cat prog (rx-one 3 lo (+ lo hi))) aux1 slot))))
#?(:kotoba
   (defn- rx-cc-items [pat :string p :i64 pend :i64 aux :document] :document
     (if (>= p pend)
       (rx-pack aux (document-vector) 0)
       (let [c (string-code-point-at pat p)]
         (cond (= c 93) (rx-pack aux (document-vector) 0)
               (= c 92) (let [e (rx-esc-class pat p pend aux)]
                          (rx-cc-items pat (rx-n3i e 2) pend (rx-n3 e 0)))
               :else (if (and (< (+ p 2) pend) (= 45 (string-code-point-at pat (+ p 1))) (not (= 93 (string-code-point-at pat (+ p 2)))))
                       (rx-cc-items pat (+ p 3) pend (rx-pair aux c (string-code-point-at pat (+ p 2))))
                       (rx-cc-items pat (+ p 1) pend (rx-pair aux c c))))))))
#?(:kotoba
   (defn- rx-pair [aux :document lo :i64 hi :i64] :document (document-vector-conj (document-vector-conj aux (document-i64 lo)) (document-i64 hi))))
#?(:kotoba
   (defn- rx-esc-class [pat :string p :i64 pend :i64 aux :document] :document
     (let [d (if (< (+ p 1) pend) (string-code-point-at pat (+ p 1)) 0)]
       (cond (= d 100) (rx-pack (rx-pair aux 48 57) (document-vector) (+ p 2))
             (= d 119) (rx-pack (rx-pair (rx-pair (rx-pair (rx-pair aux 48 57) 65 90) 97 122) 95 95) (document-vector) (+ p 2))
             (= d 115) (rx-pack (rx-pair (rx-pair (rx-pair aux 9 13) 32 32) 28 31) (document-vector) (+ p 2))
             :else (rx-pack (rx-pair aux d d) (document-vector) (+ p 2))))))
#?(:kotoba
   (defn- rx-esc-atom [pat :string p :i64 aend :i64 prog :document aux :document slot :i64] :document
     (let [d (if (< (+ p 1) (string-length pat)) (string-code-point-at pat (+ p 1)) 0)]
       (cond (= d 100) (rx-pack (rx-cat prog (rx-one 3 (document-count aux) (+ (document-count aux) 2))) (rx-pair aux 48 57) slot)
             (= d 119) (rx-pack (rx-cat prog (rx-one 3 (document-count aux) (+ (document-count aux) 8))) (rx-pair (rx-pair (rx-pair (rx-pair aux 48 57) 65 90) 97 122) 95 95) slot)
             (= d 115) (rx-pack (rx-cat prog (rx-one 3 (document-count aux) (+ (document-count aux) 6))) (rx-pair (rx-pair (rx-pair aux 9 13) 32 32) 28 31) slot)
             :else (rx-pack (rx-cat prog (rx-one 1 d 0)) aux slot)))))

;; ---- the search and the re-* surface ----
#?(:kotoba
   (defn- rx-prog [p :document] :document (option-value-of [:option :document] (document-vector-at p 0) (document-null))))
#?(:kotoba
   (defn- rx-aux [p :document] :document (option-value-of [:option :document] (document-vector-at p 1) (document-null))))
#?(:kotoba
   (defn- rx-search [p :document s :string from :i64] :document
     (rx-se-w (rx-prog p) (rx-aux p) s from (string-length s))))
#?(:kotoba
   (defn- rx-se-w [prog :document aux :document s :string from :i64 n :i64] :document
     (if (> from n)
       (rx-no)
       (let [r (rx-run prog s 0 from n aux (document-vector))]
         (if (rx-ok? r)
           (rx-pack3 (document-vector-conj (document-vector-conj (document-vector) (document-i64 from)) (option-value-of [:option :document] (document-vector-at r (- (document-count r) 1)) (document-null))) r)
           (rx-se-w prog aux s (+ from 1) n))))))
#?(:kotoba
   (defn- rfnd-w [m :document s :string] :document
     (if (rx-ok? m)
       (__r6-as :document (string-substring s (rx-start m) (rx-end m)))
       (document-null))))
#?(:kotoba
   (defn- rx-start [m :document] :i64 (option-value-of [:option :i64] (document-i64-value (option-value-of [:option :document] (document-vector-at m 0) (document-null))) 0)))
#?(:kotoba
   (defn- rx-end [m :document] :i64 (option-value-of [:option :i64] (document-i64-value (option-value-of [:option :document] (document-vector-at m 1) (document-null))) 0)))
#?(:kotoba
   (defn- rmtc-w [m :document s :string n :i64] :document
     (if (and (rx-ok? m) (= (rx-start m) 0) (= (rx-end m) n))
       (__r6-as :document (string-substring s 0 n))
       (document-null))))
#?(:kotoba
   (defn- rseq-w [re :document s :string from :i64 acc :document] :document
     (let [m (rx-search re s from)]
       (if (rx-ok? m)
         (rseq-w re s (if (= (rx-end m) (rx-start m)) (+ (rx-end m) 1) (rx-end m)) (document-vector-conj acc (__r6-as :document (string-substring s (rx-start m) (rx-end m)))))
         acc))))
#?(:kotoba
   (defn- rsplit-w [re :document s :string from :i64 seg :i64 acc :document] :document
     (let [m (rx-search re s from)]
       (if (rx-ok? m)
         (rsplit-w re s (rx-end m) (+ seg 1) (document-vector-conj acc (__r6-as :document (string-substring s from (rx-start m)))))
         (rsplit-trim (document-vector-conj acc (__r6-as :document (string-substring s from (string-length s)))))))))
#?(:kotoba
   (defn- rsplit-trim [v :document] :document
     (if (= 0 (document-count v))
       v
       (if (= 0 (string-length (val-str (option-value-of [:option :document] (document-vector-at v (- (document-count v) 1)) (document-null)))))
         (rsplit-trim (rsplit-drop-last v))
         v))))
#?(:kotoba
   (defn- rsplit-drop-last [v :document] :document (rsplit-dl v 0 (- (document-count v) 1) (document-vector))))
#?(:kotoba
   (defn- rsplit-dl [v :document i :i64 n :i64 acc :document] :document
     (if (>= i n) acc (rsplit-dl v (+ i 1) n (document-vector-conj acc (option-value-of [:option :document] (document-vector-at v i) (document-null)))))))
#?(:kotoba
   (defn- rrep-w [match :document s :string from :i64 replacement :string acc :string] :string
     (let [m (rx-search match s from)]
       (if (rx-ok? m)
         (rrep-w match s (if (= (rx-end m) (rx-start m)) (+ (rx-end m) 1) (rx-end m)) replacement
                 (string-concat (string-concat acc (string-substring s from (rx-start m))) (exp-tpl replacement s m)))
         (string-concat acc (string-substring s from (string-length s)))))))
#?(:kotoba
   (defn- rrep1-w [match :document s :string from :i64 replacement :string] :string
     (let [m (rx-search match s from)]
       (if (rx-ok? m)
         (string-concat (string-concat (string-substring s 0 (rx-start m)) (exp-tpl replacement s m)) (string-substring s (rx-end m) (string-length s)))
         s))))
;; the $-template expansion: $0 = the whole, $1..$9 = the group (the spans follow the
;; match pair in the capture order the run appended)
#?(:kotoba
   (defn- exp-tpl [tpl :string s :string m :document] :string (et-w tpl 0 (string-length tpl) s m "")))
#?(:kotoba
   (defn- et-w [tpl :string i :i64 n :i64 s :string m :document acc :string] :string
     (if (>= i n)
       acc
       (let [c (string-code-point-at tpl i)]
         (if (and (= c 36) (< (+ i 1) n))
           (et-w tpl (+ i 2) n s m (string-concat acc (grp-str s m (grp-n (string-code-point-at tpl (+ i 1))))))
           (et-w tpl (+ i 1) n s m (string-concat acc (cp-bytes c))))))))
#?(:kotoba
   (defn- grp-n [c :i64] :i64 (if (and (>= c 48) (<= c 57)) (- c 48) 0)))
#?(:kotoba
   (defn- grp-str [s :string m :document k :i64] :string
     (if (= k 0)
       (string-substring s (rx-start m) (rx-end m))
       (let [a (rx-slot m (- (* k 2) 2))
             b (rx-slot m (- (* k 2) 1))]
         (if (or (< a 0) (< b 0)) "" (string-substring s a b))))))
#?(:kotoba
   (defn- rx-slot [m :document slot :i64] :i64 (rx-slot-w m 2 slot)))
#?(:kotoba
   (defn- rx-slot-w [m :document i :i64 slot :i64] :i64
     (if (>= (+ i 1) (document-count m))
       -1
       (if (= (rx-n m i) slot)
         (rx-n m (+ i 1))
         (rx-slot-w m (+ i 2) slot)))))
;; the search result = [start end saves..]: append the run's capture log before the end
#?(:kotoba
   (defn- rx-pack3 [head :document r :document] :document (rx-p3-w head r 0 (- (document-count r) 1))))
#?(:kotoba
   (defn- rx-p3-w [acc :document r :document i :i64 n :i64] :document
     (if (>= i n) acc (rx-p3-w (document-vector-conj acc (option-value-of [:option :document] (document-vector-at r i) (document-null))) r (+ i 1) n))))
#?(:kotoba
   (defn- ms-w [re :document s :string from :i64 acc :document] :document
     (let [m (rx-search re s from)]
       (if (rx-ok? m)
         (ms-w re s (if (= (rx-end m) (rx-start m)) (+ (rx-end m) 1) (rx-end m))
               (document-vector-conj acc (ms-one s m (rx-end m) 0 (rx-end m))))
         acc))))
#?(:kotoba
   (defn- ms-one [s :string m :document unused :i64 gk :i64 e :i64] :document
     (document-assoc (document-assoc (document-assoc (document-map) (document-keyword :start) (document-i64 (rx-start m))) (document-keyword :end) (document-i64 e)) (document-keyword :groups) (ms-groups s m 0 (document-count m) (document-vector)))))
;; the groups vector: [whole g1 g2 ..] from the capture log (slot pairs) in slot order
#?(:kotoba
   (defn- ms-groups [s :string m :document k :i64 n :i64 acc :document] :document
     (if (> (* k 2) n)
       acc
       (ms-groups s m (+ k 1) n (document-vector-conj acc (__r6-as :document (grp-str s m k)))))))
#?(:kotoba
   (defn- et2-w [tpl :string i :i64 n :i64 groups :document gcount :i64 acc :string] :string
     (if (>= i n)
       acc
       (let [c (string-code-point-at tpl i)]
         (if (and (= c 92) (< (+ i 1) n))
           (et2-w tpl (+ i 2) n groups gcount (string-concat acc (cp-bytes (string-code-point-at tpl (+ i 1)))))
           (if (and (= c 36) (< (+ i 1) n))
             (let [g (et2-grp tpl (+ i 1) n gcount 0)]
               (et2-w tpl (rx-n3i g 2) n groups gcount (string-concat acc (if (= (rx-n3i g 1) 1) (grp-at groups (rx-n3i g 0)) (cp-bytes (string-code-point-at tpl (+ i 1)))))))
             (et2-w tpl (+ i 1) n groups gcount (string-concat acc (cp-bytes c)))))))))
;; the greedy $N: the digits while the number stays a valid group; 1 = expanded
#?(:kotoba
   (defn- et2-grp [tpl :string i :i64 n :i64 gcount :i64 num :i64] :document
     (if (and (< i n) (>= (string-code-point-at tpl i) 48) (<= (string-code-point-at tpl i) 57))
       (let [num2 (+ (* num 10) (- (string-code-point-at tpl i) 48))]
         (if (and (<= num2 gcount) (> num2 0))
           (et2-grp tpl (+ i 1) n gcount num2)
           (rx-pack3i (document-vector) num 1 i)))
       (rx-pack3i (document-vector) num 1 i))))
#?(:kotoba
   (defn- rx-pack3i [v :document a :i64 b :i64 c :i64] :document (document-vector-conj (document-vector-conj (document-vector-conj v (document-i64 a)) (document-i64 b)) (document-i64 c))))
#?(:kotoba
   (defn- grp-at [groups :document k :i64] :string
     (if (or (< k 0) (>= k (document-count groups)))
       (throw (ex-info "text: replacement group out of range" {:phase :value :trap :template-group}))
       (val-str (option-value-of [:option :document] (document-vector-at groups k) (document-null))))))
#?(:kotoba
   (defn- rw-w [s :string match :document replacement :string all? :i64 from :i64 spans :document si :i64 acc :string] :string
     (if (>= si (document-count spans))
       (string-concat acc (string-substring s from (string-length s)))
       (let [sp (option-value-of [:option :document] (document-vector-at spans si) (document-null))
             a (rx-n (option-value-of [:option :document] (document-get sp (document-keyword :start)) (document-null)) 0)
             e (rx-n (option-value-of [:option :document] (document-get sp (document-keyword :end)) (document-null)) 0)
             gr (option-value-of [:option :document] (document-get sp (document-keyword :groups)) (document-null))]
         (if (= all? 0)
           (string-concat (string-concat (string-substring s from (string-length s)) (string-substring s 0 a)) "")
           (rw-w s match replacement all? e spans (+ si 1)
