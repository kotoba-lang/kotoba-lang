#?(:kotoba
   (defn- hex-w [n :i64 acc :string] :string
     (if (= n 0)
       (if (= 0 (string-length acc)) "0" acc)
       (hex-w (quot n 16) (string-concat (string-substring "0123456789abcdef" (rem n 16) (+ (rem n 16) 1)) acc)))))
#?(:kotoba
   (defn- oct-w [n :i64 acc :string] :string
     (if (= n 0)
       (if (= 0 (string-length acc)) "0" acc)
       (oct-w (quot n 8) (string-concat (string-substring "01234567" (rem n 8) (+ (rem n 8) 1)) acc)))))
#?(:kotoba
   (defn- i64-str [v :i64] :string (string-from-i64 v)))
#?(:kotoba
   (defn- pow10 [p :i64] :i64 (if (<= p 0) 1 (* 10 (pow10 (- p 1))))))
#?(:kotoba
   (defn- fpow10 [p :i64] :f64 (if (<= p 0) (f64-from-bits 4607182418800017408) (f64-mul (f64-from-bits 4621819117588971520) (fpow10 (- p 1))))))
;; the fixed-point rendering: the i64 path is pure integer arithmetic; the f64 path
;; scales, rounds and truncates (the oracle's scaled-value rule)
#?(:kotoba
   (defn- fixed-w [x :document prec :i64] :string
     (if (= :i64 (document-kind x))
       (fx-int (option-value-of [:option :i64] (document-i64-value x) 0) prec)
       (fx-int (f64-to-i64-truncating (f64-add (f64-mul (f64-from-bits (option-value-of [:option :i64] (document-i64-value x) 0)) (fpow10 prec)) (f64-from-bits 4602678819172646912))) prec))))
#?(:kotoba
   (defn- fx-int [v :i64 prec :i64] :string
     (let [neg (if (< v 0) 1 0)
           a (if (< v 0) (- 0 v) v)]
       (string-concat (if (= neg 1) "-" "")
                      (if (= prec 0)
                        (i64-str a)
                        (string-concat (string-concat (i64-str (quot a (pow10 prec))) ".") (pad-w (i64-str (rem a (pow10 prec))) prec 48 (string-length (i64-str (rem a (pow10 prec)))) "")))))))
;; the fmt-one contract: the spec map {:flags :width :prec :conv}
#?(:kotoba
   (defn- f1-w [spec :document arg :document] :string
     (let [flags (val-str (dget spec :flags))
           width (iopt (dget spec :width))
           prec (iopt (dget spec :prec))
           conv (val-str (dget spec :conv))
           body (f1-body conv arg (if (< prec 0) 6 prec))
           body2 (if (and (str-has? flags "+") (or (= conv "d") (= conv "f")) (not (starts-with? body "-"))) (string-concat "+" body) body)]
       (if (< width 0)
         body2
         (pad body2 width (if (str-has? flags "-") 1 0) (if (and (str-has? flags "0") (not (str-has? flags "-"))) 48 32))))))
#?(:kotoba
   (defn- dget [m :document k :keyword] :document (option-value-of [:option :document] (document-get m (document-keyword k)) (document-null))))
#?(:kotoba
   (defn- iopt [d :document] :i64 (option-value-of [:option :i64] (document-i64-value d) -1)))
#?(:kotoba
   (defn- str-has? [s :string sub :string] :bool (if (= 0 (string-length sub)) true (not (< (string-index-of s sub) 0)))))
#?(:kotoba
   (defn- f1-body [conv :string arg :document prec :i64] :string
     (cond (= conv "s") (if (document-equal? arg (document-null)) "null" (val-str arg))
           (= conv "d") (i64-str (iopt arg))
           (= conv "x") (hex-w (iopt arg) "")
           (= conv "X") (string-upper (hex-w (iopt arg) ""))
           (= conv "o") (oct-w (iopt arg) "")
           (= conv "f") (fixed-w arg prec)
           (= conv "c") (cp-bytes (iopt arg))
           (= conv "b") (if (document-equal? arg (document-bool false)) "false" "true")
           :else (string-concat "%" conv))))
;; the printf walk: %[-+ 0#]*(digits)?(.digits)?(conv) with %% as the literal percent
#?(:kotoba
   (defn- fmt-w [fmt :string i :i64 n :i64 args :document ai :i64 acc :string] :string
     (if (>= i n)
       acc
       (let [c (string-code-point-at fmt i)]
         (if (and (= c 37) (< (+ i 1) n))
           (let [fk (spec-flags fmt (+ i 1) n "")
                 fi (pn-i fk)
                 wn (spec-dec fmt fi n 0 0)
                 wi (pn-i wn)
                 pn2 (if (and (< wi n) (= 46 (string-code-point-at fmt wi))) (spec-dec fmt (+ wi 1) n 0 0) (pn-make -1 wi))
                 pi (pn-i pn2)
                 cv (string-substring fmt pi (+ pi 1))]
             (if (= cv "%")
               (fmt-w fmt (+ pi 1) n args ai (string-concat acc "%"))
               (fmt-w fmt (+ pi 1) n args (+ ai 1)
                      (string-concat acc (f1-w (mk-spec (val-str (option-value-of [:option :document] (document-vector-at fk 0) (document-null))) (pn-v wn) (pn-v pn2) cv) (option-value-of [:option :document] (document-list-at (__r6-as :document args) ai) (document-null)))))))
           (fmt-w fmt (+ i 1) n args ai (string-concat acc (cp-bytes c))))))))
;; the [value next] pair
#?(:kotoba
   (defn- pn-make [v :i64 i :i64] :document (document-vector-conj (document-vector-conj (document-vector) (document-i64 v)) (document-i64 i))))
#?(:kotoba
   (defn- pn-v [p :document] :i64 (option-value-of [:option :i64] (document-i64-value (option-value-of [:option :document] (document-vector-at p 0) (document-null))) 0)))
#?(:kotoba
   (defn- pn-i [p :document] :i64 (option-value-of [:option :i64] (document-i64-value (option-value-of [:option :document] (document-vector-at p 1) (document-null))) 0)))
#?(:kotoba
   (defn- mk-spec [flags :string width :i64 prec :i64 conv :string] :document
     (document-assoc (document-assoc (document-assoc (document-assoc (document-map) (document-keyword :flags) (__r6-as :document flags)) (document-keyword :width) (document-i64 width)) (document-keyword :prec) (document-i64 prec)) (document-keyword :conv) (__r6-as :document conv))))
;; the flags: [-+ 0#]* collected into a codepoint-run number (bitset-style) -- kept as
;; a string instead: collect the chars, return the pair (the string packed as its i64
;; code run would lose order, so the flags travel as the string's hash-free form: the
;; chars are pushed into the acc string at the CALLER; here the length only)
#?(:kotoba
   (defn- spec-flags [fmt :string i :i64 n :i64 acc :string] :document
     (if (>= i n)
       (document-vector-conj (document-vector-conj (document-vector) (__r6-as :document acc)) (document-i64 i))
       (let [c (string-code-point-at fmt i)]
         (if (or (= c 45) (= c 43) (= c 32) (= c 48) (= c 35))
           (spec-flags fmt (+ i 1) n (string-concat acc (cp-bytes c)))
           (document-vector-conj (document-vector-conj (document-vector) (__r6-as :document acc)) (document-i64 i)))))))
#?(:kotoba
   (defn- spec-dec [fmt :string i :i64 n :i64 acc :i64 seen :i64] :document
     (if (>= i n)
       (pn-make (if (= seen 1) acc -1) i)
       (let [c (string-code-point-at fmt i)]
         (if (and (>= c 48) (<= c 57))
           (spec-dec fmt (+ i 1) n (+ (* acc 10) (- c 48)) 1)
           (pn-make (if (= seen 1) acc -1) i))))))
#?(:kotoba
   (defn- ptw [s :string width :i64 fill :string len :i64] :string
     (if (>= len width)
       ""
       (string-concat fill (ptw s width fill (+ len (cp-count-w fill 0 (string-length fill) 0)))))))

#?(:kotoba
   (defn match-spans [re :document s :string] :document
     (ms-w re s 0 (document-vector)))
   :default
(defn- match-spans
  "Every non-overlapping match of `re` in `s`, in order, as
  `{:start i :end j :groups [whole g1 g2 ...]}` with character indices.

  This is the single point where this namespace touches the host's regex
  engine. A zero-length match advances by one character, exactly as
  `java.util.regex.Matcher/find` does, so `#\"\"` against \"ab\" yields three
  empty matches (before a, before b, at the end) on both hosts rather than
  looping forever on one of them."
  [re s]
  #?(:clj
     (let [m (re-matcher re s)]
       (loop [acc []]
         (if (.find m)
           (recur (conj acc {:start  (.start m)
                             :end    (.end m)
                             :groups (mapv #(.group m ^int %)
                                           (range (inc (.groupCount m))))}))
           acc)))
     :cljs
     (let [flags (.-flags re)
           g     (js/RegExp. (.-source re)
                             (if (.includes flags "g") flags (str flags "g")))]
       (loop [acc []]
         (let [m (.exec g s)]
           (if (nil? m)
             acc
             (let [start (.-index m)
                   whole (aget m 0)
                   end   (+ start (.-length whole))]
               (when (= start end)
                 (set! (.-lastIndex g) (inc start)))
               (recur (conj acc {:start  start
                                 :end    end
                                 :groups (mapv #(aget m %) (range (.-length m)))}))))))))))
#?(:kotoba
   (defn join
     ([coll :document] :string (jn-w coll 0 (document-count coll) "" ""))
     ([sep :string coll :document] :string (jn-w coll 0 (document-count coll) "" sep)))
   :default
(defn join
  "Join `coll` with separator `sep`. With one argument, joins with no
  separator. `nil` elements render as the empty string, like `str`."
  ([coll] (apply str coll))
  ([sep coll] (apply str (interpose sep coll)))))
#?(:kotoba
   (defn split [s :string re :document] :document
     (rsplit-w re s 0 0 (document-vector)))
   :default
(defn split
  "Split `s` on regex `re`, returning a vector of substrings.

  `java.util.regex.Pattern/split` semantics, reimplemented rather than
  delegated:

  * `limit` absent or 0 -- trailing empty strings are removed.
  * `limit` positive -- at most `limit` parts; the last one is the whole
    remainder, unsplit.
  * `limit` negative -- all parts, trailing empties kept.
  * a zero-width match at index 0 does not produce a leading empty string.
  * no match anywhere yields `[s]`, never `[]`."
  ([s re] (split s re 0))
  ([s re limit]
   (let [s       (str s)
         limited (pos? limit)
         spans   (match-spans re s)]
     (loop [spans spans, index 0, parts []]
       (if-let [{:keys [start end]} (first spans)]
         (cond
           ;; a zero-width match at the very beginning contributes nothing
           (and (zero? index) (zero? start) (= start end))
           (recur (next spans) index parts)

           (and limited (= (count parts) (dec limit)))
           (recur nil index parts)

           (or (not limited) (< (count parts) (dec limit)))
           (recur (next spans) end (conj parts (subs s index start)))

           :else (recur nil index parts))
         (if (and (zero? index) (empty? parts))
           [s]
           (let [parts (conj parts (subs s index))]
             (if (zero? limit)
               (loop [p parts]
                 (if (and (seq p) (= "" (peek p))) (recur (pop p)) p))
               parts)))))))))
