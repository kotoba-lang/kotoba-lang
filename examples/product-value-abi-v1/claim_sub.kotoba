(ns claim-sub-demo
  (:export [claim-sub claim-exp i64-label]))

;; Product Value ABI v1 golden: option + if-some + string-from-i64
;; Compile: kotoba.compiler.core/compile-source … :wasm32-kotoba-v1
;; Run:     kotoba.kir/execute kir 'claim-sub [[[:option :string] false]]

(defn claim-sub [sub [:option :string]] :string
  (if-some [x sub]
    x
    "anonymous"))

(defn claim-exp [now :i64 ttl [:option :i64]] :i64
  (+ now (if-some [x ttl] x 2592000)))

(defn i64-label [n :i64] :string
  (string-concat "n=" (string-from-i64 n)))
