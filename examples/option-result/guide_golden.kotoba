(ns option-result-guide
  (:export [absent-default present-payload ttl-or-default]))

;; T4.3 guide golden — pure-product option flow only (no prelude).
;; Mirror patterns from docs/lang/option-result-guide.md §2.
;; Host/compiler evidence: product-value-abi-v1 tests exercise the same sugar.

(defn absent-default [x [:option :i64]] :i64
  (option-or x 0))

(defn present-payload [name [:option :string]] :string
  (if-some [n name]
    n
    "none"))

(defn ttl-or-default [ttl [:option :i64]] :i64
  (option-or ttl 3600))
