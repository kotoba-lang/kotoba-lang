;; T2.3 living contract: pure-product examples under examples/.
;; Each entry: :path relative to repo root, :cases of {:export :args :expect}.
;; Args use KIR option encoding [[:option T] present? value?].
{:kotoba.pure-product-examples/version 1
 :examples
 [{:path "examples/hello.kotoba"
   :cases [{:export main :args [] :expect 42}]}
  {:path "examples/policy-demo.kotoba"
   :cases [{:export main :args [] :expect 42}]}
  {:path "examples/option-result/guide_golden.kotoba"
   :cases [{:export absent-default
            :args [[[:option :i64] false]]
            :expect 0}
           {:export present-payload
            :args [[[:option :string] true "hi"]]
            :expect "hi"}
           {:export ttl-or-default
            :args [[[:option :i64] false]]
            :expect 3600}]}
  {:path "examples/product-value-abi-v1/claim_sub.kotoba"
   :cases [{:export claim-sub
            :args [[[:option :string] false]]
            :expect "anonymous"}
           {:export claim-sub
            :args [[[:option :string] true "bob"]]
            :expect "bob"}
           {:export claim-exp
            :args [100 [[:option :i64] false]]
            :expect 2592100}
           {:export claim-exp
            :args [100 [[:option :i64] true 10]]
            :expect 110}
           {:export i64-label
            :args [7]
            :expect "n=7"}]}]}
