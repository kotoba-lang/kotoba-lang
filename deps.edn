{:paths ["src" "."]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        ;; real CIDv1 structural validation/decoding for
        ;; kotoba.lang.package-contract/cid? -- a genuine, Kubo-verified
        ;; multibase/multihash implementation, not reimplemented here.
        io.github.kotoba-lang/io-multiformats
        {:git/url "https://github.com/kotoba-lang/io-multiformats.git"
         :git/sha "eec3ee85c458ea830be94518b9a42f4a8f1aee40"}
        ;; Post-rename coordinate: the repo is kotoba-lang/org-ietf-ed25519
        ;; (no `-clj`-era short name). Keeping the old `ed25519` lib key here
        ;; made every consumer that already depends on the renamed repo
        ;; (cloud-murakumo, kekkai) unresolvable — tools.deps cannot compare a
        ;; :git/sha coord against a :local/root coord for the same lib key, so
        ;; the whole classpath failed to build (ai-gftd-apex `clojure -M:test`,
        ;; 2026-07-25). Same lib key + same coord type everywhere is the fix.
        io.github.kotoba-lang/org-ietf-ed25519
        {:git/url "https://github.com/kotoba-lang/org-ietf-ed25519.git"
         :git/sha "c1ba8322a33b668da1311ca69a8cdde3c7981b52"}
        io.github.kotoba-lang/kotoba-core-contracts
        {:git/url "https://github.com/kotoba-lang/kotoba-core-contracts.git"
         :git/sha "5ce5b174feeca1cb24d8266b20dcd0a685500ebf"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :grammar-authority {:main-opts ["-m" "kotoba.lang.grammar-authority"]}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
