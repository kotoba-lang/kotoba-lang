{:paths ["src" "."]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        ;; real CIDv1 structural validation/decoding for
        ;; kotoba.lang.package-contract/cid? -- a genuine, Kubo-verified
        ;; multibase/multihash implementation, not reimplemented here.
        io.github.kotoba-lang/io-multiformats
        {:git/url "https://github.com/kotoba-lang/io-multiformats.git"
         :git/sha "eec3ee85c458ea830be94518b9a42f4a8f1aee40"}
        ;; Post-rename coordinate: the repo is kotoba-lang/org-ietf-ed25519
        ;; (no `-clj`-era short name). Keeping the old `ed25519` lib key here
        ;; made every consumer that already depends on the renamed repo
        ;; (cloud-murakumo, kekkai) unresolvable — tools.deps cannot compare a
        ;; :git/sha coord against a :local/root coord for the same lib key, so
        ;; the whole classpath failed to build (ai-gftd-apex `clojure -M:test`,
        ;; 2026-07-25). Same lib key + same coord type everywhere is the fix.
        io.github.kotoba-lang/org-ietf-ed25519
        {:git/url "https://github.com/kotoba-lang/org-ietf-ed25519.git"
         :git/sha "c1ba8322a33b668da1311ca69a8cdde3c7981b52"}
        ;; kotoba.lang.release-admission consumes the central security
        ;; controls (abac / approval / capability / crypto-policy / hardware /
        ;; qualification / resilience / transport) rather than reimplementing
        ;; any of them here.
        io.github.kotoba-lang/security
        {:git/url "https://github.com/kotoba-lang/security.git"
         :git/sha "f409dbade106df076cefe640781b12db558f4135"}
        io.github.kotoba-lang/kotoba-core-contracts
        {:git/url "https://github.com/kotoba-lang/kotoba-core-contracts.git"
         :git/sha "85b8659fed887abf36bfa5aaffe38d441d916bcc"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :grammar-authority {:main-opts ["-m" "kotoba.lang.grammar-authority"]}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}

  ;; T2.2: regenerate/check docs/lang/surface-matrix.md
  :surface-matrix {:main-opts ["-m" "kotoba.lang.surface-matrix"]}

  ;; T10.2: policy validate + compatibility report (current release or args)
  :compatibility {:main-opts ["-m" "kotoba.lang.version-policy"]}

  ;; T9.1: validate cli-adapter-matrix against cli.edn
  :cli-adapter-matrix {:main-opts ["-m" "kotoba.lang.cli-adapter-matrix"]}

  ;; T2.3: examples/ pure-product compile + KIR execute (sibling compiler)
  :pure-product-examples
  {:extra-paths ["src"]
   :extra-deps {io.github.kotoba-lang/compiler
                {:local/root "../compiler"}}
   :main-opts ["-m" "kotoba.lang.pure-product-examples"]}}}
