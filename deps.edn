;; `.` is on the classpath because the LANGUAGE AUTHORITY lives in `lang/`, and
;; consumers resolve it by resource path -- `kotoba.launcher` reads
;; `lang/cli.edn` through `io/resource` with no fallback, so without this the
;; CLI cannot dispatch a single command. `146ffde` dropped `.` while separating
;; semantics from the release/IPFS adapters; that commit moved
;; `repository-rules.edn` into `resources/` but left `lang/` where it was, so
;; the authority silently fell off the classpath. Measured 2026-08-05 against
;; kotoba-lang/kotoba: 66 errors, 65 of them `Cannot open <nil> as a Reader`.
;;
;; Removing `.` again requires MOVING `lang/` to `resources/lang/` in the same
;; change -- the resource paths consumers use must not change. Until then this
;; entry is load-bearing.
{:paths ["src" "resources" "."]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        ;; DefCID authority moved to the canonical KIR owner. The legacy
        ;; kotoba.lang.code-identity namespace delegates to this pin so callers
        ;; migrate without changing any payload-v2 bytes or CIDs.
        io.github.kotoba-lang/kotoba-kir
        {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
         :git/sha "9a70bf134494f44d98fd3c345b826ef09659f754"}
        io.github.kotoba-lang/kotoba-core-contracts
        {:git/url "https://github.com/kotoba-lang/kotoba-core-contracts.git"
         :git/sha "85b8659fed887abf36bfa5aaffe38d441d916bcc"}
        ;; Deterministic CBOR for kotoba.lang.code-identity's canonical block.
        ;; The same encoder kotoba-lang/codebase already uses for the C1
        ;; semantic-code CIDs, so the two identity layers agree byte-for-byte
        ;; on the codec rather than each labelling its own format dag-cbor.
        io.github.kotoba-lang/dag-cbor
        {:git/url "https://github.com/kotoba-lang/dag-cbor.git"
         :git/sha "58144e81ccdf7a82367085c66ea21ca84a1a7ddb"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :grammar-authority {:main-opts ["-m" "kotoba.lang.grammar-authority"]}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}

  ;; T2.2: regenerate/check docs/lang/surface-matrix.md
  :surface-matrix {:main-opts ["-m" "kotoba.lang.surface-matrix"]}

  ;; T10.2: policy validate + compatibility report (current release or args)
  :compatibility {:main-opts ["-m" "kotoba.lang.version-policy"]}

  ;; Reproducible engineering-maturity stock/flow calculation. XMILE remains
  ;; tooling evidence and is not part of the language production classpath.
  :maturity
  {:extra-paths ["scripts"]
   :extra-deps {io.github.kotoba-lang/org-oasis-open-xmile
                {:git/url "https://github.com/kotoba-lang/org-oasis-open-xmile.git"
                 :git/sha "19018e9d960bb95d6de2e50ebc918e428e532ddc"}}
   :main-opts ["-m" "kotoba-lang-maturity"]}

  ;; T9.1: validate cli-adapter-matrix against cli.edn
  :cli-adapter-matrix {:main-opts ["-m" "kotoba.lang.cli-adapter-matrix"]}

  ;; T2.3: examples/ pure-product compile + KIR execute (sibling compiler)
  :pure-product-examples
  {:extra-paths ["src"]
   :extra-deps {io.github.kotoba-lang/amu
                {:local/root "../amu"}}
   :main-opts ["-m" "kotoba.lang.pure-product-examples"]}}}
