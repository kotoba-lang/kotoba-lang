;; `.` is on the classpath because the LANGUAGE AUTHORITY lives in `lang/`, and
;; consumers resolve it by resource path -- `kotoba.launcher` reads
;; `lang/cli.edn` through `io/resource` with no fallback, so without this the
;; CLI cannot dispatch a single command. `146ffde` dropped `.` while separating
;; semantics from the release/IPFS adapters; that commit moved
;; `repository-rules.edn` into `resources/` but left `lang/` where it was, so
;; the authority silently fell off the classpath. Measured 2026-08-05 against
;; kotoba-lang/kotoba: 66 errors, 65 of them `Cannot open <nil> as a Reader`.
;;
;; Removing `.` again requires MOVING `lang/` to `resources/lang/` in the same
;; change -- the resource paths consumers use must not change. Until then this
;; entry is load-bearing.
{:paths ["src" "resources" "."]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        ;; DefCID authority moved to the canonical KIR owner. The legacy
        ;; kotoba.lang.code-identity namespace delegates to this pin so callers
        ;; migrate without changing any payload-v2 bytes or CIDs.
        io.github.kotoba-lang/kotoba-kir
        {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
         :git/sha "1e00f830e96bf762a95085f2eb5741d470d26ee6"}
        io.github.kotoba-lang/kotoba-core-contracts
        {:git/url "https://github.com/kotoba-lang/kotoba-core-contracts.git"
         :git/sha "85b8659fed887abf36bfa5aaffe38d441d916bcc"}
        ;; Deterministic CBOR for kotoba.lang.code-identity's canonical block.
        ;; The same encoder kotoba-lang/codebase already uses for the C1
        ;; semantic-code CIDs, so the two identity layers agree byte-for-byte
        ;; on the codec rather than each labelling its own format dag-cbor.
        io.github.kotoba-lang/dag-cbor
        {:git/url "https://github.com/kotoba-lang/dag-cbor.git"
         :git/sha "58144e81ccdf7a82367085c66ea21ca84a1a7ddb"}
        ;; Incidence blocks are first-class CIDv1 dag-cbor values. Declare the
        ;; codec directly instead of relying on kotoba-kir's transitive pin.
        io.github.kotoba-lang/io-multiformats
        {:git/url "https://github.com/kotoba-lang/io-multiformats.git"
         :git/sha "e7ae323d3ccbb9aacc92edfd2f3dda20d9b90eed"}
        ;; Concrete, fail-closed external identity/evidence/authority profiles.
        ;; The language adapter still mints only its existing opaque runtime
        ;; values; these dependencies verify inert wire evidence before that
        ;; admission boundary.
        io.github.kotoba-lang/org-w3-vc-data-integrity
        {:git/url "https://github.com/kotoba-lang/org-w3-vc-data-integrity.git"
         :git/sha "02004c9d3fd42575e7c64ade5ca13778bb630c59"}
        io.github.kotoba-lang/org-w3-vc-bitstring-status-list
        {:git/url "https://github.com/kotoba-lang/org-w3-vc-bitstring-status-list.git"
         :git/sha "9a1e874950674c2ba0ab3cfbb383098130f65fa4"}
        io.github.kotoba-lang/org-w3-did
        {:git/url "https://github.com/kotoba-lang/org-w3-did.git"
         :git/sha "c430e98024675a0873f49889049b4909e85fa860"}
        io.github.kotoba-lang/xyz-ucan
        {:git/url "https://github.com/kotoba-lang/xyz-ucan.git"
         :git/sha "fc203dedef8633d4d2ff4a65333c15f29fd92059"}
        ;; Concrete QC verification for incidence total order. Inga binds the
        ;; ordered CIDs into its canonical block and checks admitted quorum
        ;; signatures before this language layer mints OrderedCommit.
        io.github.kotoba-lang/inga
        {:git/url "https://github.com/kotoba-lang/inga.git"
         :git/sha "64bb3efabca3095f0e98c81e90db55e38e5b9506"}
        ;; Runtime capability receipts may bind the exact causal trust
        ;; decision that admitted them. Models issue claims; this decision
        ;; plane remains the authority and does not expose identity evidence.
        io.github.kotoba-lang/grant
        {:git/url "https://github.com/kotoba-lang/grant.git"
         :git/sha "9d7d11fc3d77b1f6dfcbcd6fa9dd7d83e6b8bf98"}
        ;; Stable logical subjects are separate from replaceable passkey
        ;; controllers and CAIP-10 account links. The public CLI consumes this
        ;; shape so no host adapter can quietly restore a Base-address root.
        io.github.kotoba-lang/identity
        {:git/url "https://github.com/kotoba-lang/identity.git"
         :git/sha "fcf5a56a6379b5359328f9c0ca43630bd07831b3"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; TEST ONLY. The authority owns Kotoba source under `lang/` --
         ;; `lang/stdlib/`, `lang/conformance/`, `lang/compat/` -- and until now
         ;; nothing here could RUN any of it, so those files were checked by
         ;; regex and sha256 and never by asking whether they compute the right
         ;; answer. kotoba-sema does not depend on this repository (it vendors
         ;; the grammar as a resource), so this direction adds no cycle.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/kotoba-sema
                      {:git/url "https://github.com/kotoba-lang/kotoba-sema.git"
                       ;; fd688667: sema main, carrying BOTH slices landed
                       ;; 2026-09-02. Local state slice 1 (60341cc5) is what
                       ;; local_state_conformance_test measures and what
                       ;; widening_precondition_test needs in order to admit a
                       ;; non-escaping atom and refuse an escaping one. The
                       ;; typed abort ability through slice 2 (f7c56ab3) --
                       ;; propagation through calls and A-normalization of an
                       ;; aborting operand -- is what abort_conformance_test
                       ;; and clojure_core_compat_test measure.
                       :git/sha "fd688667829b18ca96cde9498e56464776afe6af"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :grammar-authority {:main-opts ["-m" "kotoba.lang.grammar-authority"]}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}

  :captp-cljs-smoke
  {:extra-paths ["scripts"]
   :main-opts ["-m" "captp-cljs-smoke"]}

  :ocapn-endo
  {:extra-paths ["scripts"]
   :main-opts ["-m" "endo-handoff-interop-runner"]}

  :ocapn-endo-live
  {:extra-paths ["scripts"]
   :main-opts ["-m" "endo-captp-live-runner"]}

  ;; Bounded fleet gate for the distributed-authority slice. The repository's
  ;; full suite also checks sibling vendor copies and can fail on unrelated
  ;; checkout drift; this alias names only the implementation owned here.
  :ocapn-test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"
               "-n" "kotoba.lang.captp-runtime-test"
               "-n" "kotoba.lang.consensus-order-test"
               "-n" "kotoba.lang.ocapn-handoff-test"
               "-n" "kotoba.lang.ocapn-interop-test"]}

  ;; T2.2: regenerate/check docs/lang/surface-matrix.md
  :surface-matrix {:main-opts ["-m" "kotoba.lang.surface-matrix"]}

  ;; T10.2: policy validate + compatibility report (current release or args)
  :compatibility {:main-opts ["-m" "kotoba.lang.version-policy"]}

  ;; Reproducible engineering-maturity stock/flow calculation. XMILE remains
  ;; tooling evidence and is not part of the language production classpath.
  :maturity
  {:extra-paths ["scripts"]
   :extra-deps {io.github.kotoba-lang/org-oasis-open-xmile
                {:git/url "https://github.com/kotoba-lang/org-oasis-open-xmile.git"
                 :git/sha "19018e9d960bb95d6de2e50ebc918e428e532ddc"}}
   :main-opts ["-m" "kotoba-lang-maturity"]}

  ;; T9.1: validate cli-adapter-matrix against cli.edn
  :cli-adapter-matrix {:main-opts ["-m" "kotoba.lang.cli-adapter-matrix"]}

  ;; T2.3: examples/ pure-product compile + KIR execute (sibling compiler)
  :pure-product-examples
  {:extra-paths ["src"]
   :extra-deps {io.github.kotoba-lang/amu
                {:local/root "../amu"}}
   :main-opts ["-m" "kotoba.lang.pure-product-examples"]}}}
