{
  "name": "@kotoba-lang/language-authority",
  "version": "0.0.0-private",
  "private": true,
  "scripts": {
    "benchmark:end-to-end": "node scripts/benchmark-public-end-to-end.mjs",
    "test:captp-cljs": "clojure -M:captp-cljs-smoke",
    "test:ocapn-endo": "clojure -M:ocapn-endo",
    "test:ocapn-endo-live": "clojure -M:ocapn-endo-live",
    "test:nbb": "nbb --classpath \"src:test:$(clojure -Spath -M:test)\" run-tests.cljs",
    "site:build": "nbb site/build.cljs",
    "site:deploy": "npm run site:build && wrangler deploy --config site/wrangler.jsonc"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@endo/ocapn": "^1.1.1",
    "assemblyscript": "^0.28.20",
    "nbb": "1.5.211",
    "wrangler": "4.130.0"
  }
}
