(ns site.native.dds-ext-css (:export [render])
 (:require [site.native.dds-ext-data :as data] [css-sheet :as css]))
(defn render [source :string] [:option :string]
 (let [rules (data/rules source) media (data/media source)]
  (if (and (option-some?-of [:option :document] rules) (option-some?-of [:option :document] media))
   (css/sheet (option-value-of [:option :document] rules (document-null)) (option-value-of [:option :document] media (document-null)))
   (option-none-of [:option :string]))))
