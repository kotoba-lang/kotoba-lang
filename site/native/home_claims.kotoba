(ns site.native.home-claims (:export [render])
 (:require [site.native.source-concat :as source] [site.native.locale-tree :as tree]
           [site.native.locale-rebase :as rebase] [multiformats.sha256 :as sha]
           [html-hiccup :as html] [components :as dds]))
;; Bounded rendering of the eight qualified claims and their residual risks.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- field [d :document k :keyword] :document (val (document-get d k)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- label [d :document] :string
 (let [s (document-edn-print d)]
  (cond (string=? s ":t1-memory") "T1-MEMORY" (string=? s ":t2-effect") "T2-EFFECT"
        (string=? s ":t3-confinement") "T3-CONFINEMENT" (string=? s ":t4-determinism") "T4-DETERMINISM"
        (string=? s ":t5-resource-bounds") "T5-RESOURCE-BOUNDS" (string=? s ":t6-supply-chain") "T6-SUPPLY-CHAIN"
        (string=? s ":t7-backend-parity") "T7-BACKEND-PARITY" (string=? s ":t8-host-resource-scope") "T8-HOST-RESOURCE-SCOPE" :else "")))
(defn- join [xs :document i :i64 out :string] [:option :string]
 (if (>= i (document-count xs)) (option-some-of [:option :string] out)
  (let [v (item xs i)]
   (if (not (= (document-kind v) :string)) (option-none-of [:option :string])
    (join xs (+ i 1) (string-concat out (string-concat (if (= i 0) "" " · ") (text v))))))))
(defn- list-items [xs :document i :i64 out :document] [:option :document]
 (if (>= i (document-count xs)) (option-some-of [:option :document] out)
  (let [v (item xs i)]
   (if (not (= (document-kind v) :string)) (option-none-of [:option :document])
    (list-items xs (+ i 1) (document-vector-conj out (document-vector (document-keyword :li) v)))))))
(defn- card [d :document] [:option :document]
 (let [id (label (field d :id)) claim (field d :claim) tcb (field d :tcb) risk (field d :residual-risk)
       joined (if (= (document-kind tcb) :vector) (join tcb 0 "") (option-none-of [:option :string]))
       risks (if (= (document-kind risk) :vector) (list-items risk 0 (document-vector (document-keyword :ul) (document-map :class (document-string "kot-list")))) (option-none-of [:option :document]))]
  (if (or (string=? id "") (not (= (document-kind claim) :string)) (not (option-some?-of [:option :string] joined)) (not (option-some?-of [:option :document] risks)))
   (option-none-of [:option :document])
   (option-some-of [:option :document]
    (document-vector (document-keyword :div) (document-map :class (document-string "dds-ext-card"))
     (document-vector (document-keyword :span) (document-map :class (document-string "dads-chip-label") :data-style (document-string "text") :data-color (document-string "blue")) (document-string id))
     (document-vector (document-keyword :p) claim) (document-vector (document-keyword :hr) (document-map :class (document-string "dads-divider")))
     (document-vector (document-keyword :p) (document-vector (document-keyword :strong) (document-string "Trusted computing base")))
     (document-vector (document-keyword :p) (document-map :class (document-string "kot-muted kot-caption")) (document-string (option-value-of [:option :string] joined "")))
     (document-vector (document-keyword :p) (document-vector (document-keyword :strong) (document-string "Residual risk"))) (val risks))))))
(defn- cards [xs :document i :i64 out :document] [:option :document]
 (if (>= i (document-count xs)) (option-some-of [:option :document] out)
  (let [v (card (item xs i))]
   (if (option-some?-of [:option :document] v) (cards xs (+ i 1) (document-vector-conj out (val v))) (option-none-of [:option :document])))))
(defn- date-value [authority :string] :document
 (let [key ":kotoba.lang.safety-claims/as-of " pos (string-index-of authority key)]
  (if (< pos 0) (document-null)
   (let [tail (string-substring authority (+ pos (string-byte-length key)) (string-byte-length authority)) end (string-index-of tail "\n")]
    (if (< end 0) (document-null) (document-edn-read (string-substring tail 0 end)))))))
(defn render [state [:ref :site/catalog] tag :string generator :string authority :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "ca2955ee08ec6891787d7636238b1bc7b0ab64b807c4c8ce653ec03657d6c072"))
       a-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 authority))) "ae29c947ee5e161f84e60625b0bcc3541f1c019ea0110b767796de1140fb415c"))
       xs (source/data authority ":claims" 91 93) date (date-value authority)
       qualification (string-index-of authority ":kotoba.lang.safety-claims/qualification :q1")
       grid (if (and (option-some?-of [:option :document] xs) (= (document-kind (val xs)) :vector) (= (document-count (val xs)) 8))
             (cards (val xs) 0 (document-vector (document-keyword :div) (document-map :class (document-string "dds-ext-grid") :style (document-map :--dds-ext-grid-min (document-string "19rem"))))) (option-none-of [:option :document]))]
  (if (or (not g-ok) (not a-ok) (< qualification 0) (not (= (document-kind date) :string)) (not (option-some?-of [:option :document] grid))) (option-none-of [:option :string])
   (let [node (document-vector (document-keyword :section) (document-map :class (document-string "dds-ext-section") :id (document-string "evidence"))
          (dds/heading-node 2 (document-string "Claims with their boundaries attached") "32" "")
          (document-vector (document-keyword :p) (document-map :class (document-string "kot-lead"))
           (document-string "These claims are generated from ") (document-vector (document-keyword :code) (document-map :class (document-string "kot-code")) (document-string "lang/safety-claims.edn"))
           (document-string ". Each keeps its trusted computing base and residual risk visible, because a safety slogan without a boundary is only marketing."))
          (val grid) (document-vector (document-keyword :p) (document-map :class (document-string "kot-muted kot-caption"))
           (document-string "Qualification ") (document-string "Q1") (document-string ", as of ") date (document-string ".")))
         localized (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))
         rebased (if (and (option-some?-of [:option :document] localized) (not (string=? tag "en"))) (rebase/rebase-links (val localized) tag "/") localized)]
    (if (option-some?-of [:option :document] rebased) (html/render (val rebased) 0) (option-none-of [:option :string]))))))
