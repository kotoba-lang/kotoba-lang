(ns site.native.home-highlight (:export [render])
 (:require [multiformats.sha256 :as sha] [html-hiccup :as html]))
;; Bounded specialization of the pinned grammar tokenizer for the single
;; source-pinned demo, not a general Kotoba highlighter. Unknown tokens refuse.
(defn- hash [s :string] :string (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))))
(defn- white? [c :i64] :bool (or (= c 32) (= c 9) (= c 10) (= c 13)))
(defn- delimiter? [c :i64] :bool (or (= c 40) (= c 41) (= c 91) (= c 93) (= c 123) (= c 125)))
(defn- scan [s :string i :i64 mode :i64] :i64
 (if (>= i (string-byte-length s)) i
  (let [c (string-code-point-at s i)
        take? (cond (= mode 0) (white? c) (= mode 1) (and (not (= c 10)) (not (= c 13)))
                    (= mode 2) (delimiter? c) :else (and (not (white? c)) (not (delimiter? c)) (not (= c 59))))]
   (if take? (scan s (+ i 1) mode) i))))
(defn- token-kind [t :string definition? :bool] :string
 (cond definition? (if (or (string=? t "double") (string=? t "main")) "definition" "invalid")
       (or (string=? t "ns") (string=? t "defn")) "form"
       (string=? t "+") "builtin" (string=? t "21") "number"
       (or (string=? t "examples.w1-pure") (string=? t "double") (string=? t "n")) "symbol"
       :else "invalid"))
(defn- emit [kind :string text :string] [:option :string]
 (if (string=? kind "") (option-some-of [:option :string] "")
  (if (string=? kind "plain") (html/render (document-string text) 0)
   (html/render (document-vector (document-keyword :span)
                 (document-map :class (document-string (string-concat "kot-syntax-" kind))) (document-string text)) 0))))
(defn- finish [out :string kind :string text :string] [:option :string]
 (let [part (emit kind text)]
  (if (option-some?-of [:option :string] part)
   (option-some-of [:option :string] (string-concat out (option-value-of [:option :string] part "")))
   (option-none-of [:option :string]))))
(defn- tokens [s :string] [:option :string]
 (loop [i 0 out "<code class=\"kot-source\" aria-label=\"Kotoba source code\">" previous "" current "" after-open false definition false]
  (if (>= i (string-byte-length s))
   (let [last (finish out previous current)]
    (if (option-some?-of [:option :string] last)
     (option-some-of [:option :string] (string-concat (option-value-of [:option :string] last "") "</code>")) (option-none-of [:option :string])))
   (let [c (string-code-point-at s i) mode (cond (white? c) 0 (= c 59) 1 (delimiter? c) 2 :else 3)
         end (scan s i mode) text (string-substring s i end)
         kind (cond (= mode 0) "plain" (= mode 1) "comment" (= mode 2) "delimiter" :else (token-kind text definition))
         next-open (cond (= mode 0) after-open (= mode 1) after-open (= mode 2) (= (string-code-point-at s (- end 1)) 40) :else false)
         next-definition (cond (= mode 0) definition (= mode 1) definition (= mode 2) false :else (and after-open (string=? text "defn")))]
    (if (or (<= end i) (string=? kind "invalid")) (option-none-of [:option :string])
     (if (or (string=? previous "") (string=? previous kind))
      (recur end out kind (string-concat current text) next-open next-definition)
      (let [flushed (finish out previous current)]
       (if (option-some?-of [:option :string] flushed)
        (recur end (option-value-of [:option :string] flushed "") kind text next-open next-definition)
        (option-none-of [:option :string])))))))))
(defn render [source :string grammar :string highlighter :string theme :string] [:option :string]
 (if (and (arena-scope (string=? (hash source) "0471d55d668ed5f9887f9d2520ced9098d03dbbd57086dd3449e98dfb95f2e6b"))
          (arena-scope (string=? (hash grammar) "d07b8816546b8ff2d78e1db2f375c92ee5e654e20d04eb554a5c4f38fe031587"))
          (arena-scope (string=? (hash highlighter) "71a9cc931fa6345f8a2655ba02d4397efdf17f8e24718765cf5b3f9388234455"))
          (arena-scope (string=? (hash theme) "a1164296d14767fa9fb19998197e5484599d7681796055345377da04b09117a7"))
          (>= (string-index-of grammar "#{ns def defn ") 0) (>= (string-index-of grammar ":arithmetic #{+ ") 0))
  (tokens source) (option-none-of [:option :string])))
