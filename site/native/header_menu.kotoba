(ns site.native.header-menu (:export [render-menu])
 (:require [site.native.locale-tree :as tree] [site.native.locale-rebase :as rebase] [html-hiccup :as html]))
;; Navigation data and structure match the source generator; only this fragment.
(defn- value [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- local [home :bool href :string] :string
 (if home href (if (= (string-index-of href "#") 0) (string-concat "/" href)
  (if (= (string-index-of href "./") 0) (string-concat "/" (string-substring href 2 (string-byte-length href))) href))))
(defn- item [home :bool href :string label :string] :document
 (document-vector (document-keyword :li)
  (document-vector (document-keyword :a) (document-map :class (document-string "kot-menu-link") :href (document-string (local home href))) (document-string label))))
(defn- chapter [home :bool href :string n :string title :string] :document
 (document-vector (document-keyword :li)
  (document-vector (document-keyword :a) (document-map :class (document-string "kot-menu-link") :href (document-string (local home href)))
   (document-vector (document-keyword :span) (document-map :class (document-string "kot-menu-n")) (document-string n)) (document-string title))))
(defn- group [label :string items :document] :document
 (document-vector (document-keyword :div) (document-map :class (document-string "kot-menu-group"))
  (document-vector (document-keyword :p) (document-map :class (document-string "kot-menu-group-label")) (document-string label)) items))
(defn- list [items :document] :document
 (loop [i 0 out (document-vector (document-keyword :ul) (document-map :class (document-string "kot-menu-list")))]
  (if (>= i (document-count items)) out
   (recur (+ i 1) (document-vector-conj out (value (document-vector-at items i)))))))
(defn- menu [home :bool] :document
 (let [chapters (document-vector (chapter home "#why" "01" "The problem")
                 (chapter home "#architecture" "02" "How the boundary works")
                 (chapter home "#proof" "03" "The evidence")
                 (chapter home "#start" "04" "Start using it")
                 (chapter home "#roadmap" "05" "Around the language"))
       learn (document-vector (item home "#docs" "Docs") (item home "#play" "Play") (item home "#libraries" "Libraries"))
       project (document-vector (item home "#roadmap" "Roadmap") (item home "#community" "Community")
                (item home "./aiueos/" "AIUEOS") (item home "./sponsor/" "Sponsor"))
       elsewhere (document-vector (item home "./blog/" "Blog") (item home "#cloud" "Cloud")
                  (item home "https://github.com/kotoba-lang/kotoba-lang" "GitHub"))
       summary (document-edn-read "[:summary {:class \"kot-menu-summary\" :aria-label \"Menu\"} [:span {:class \"kot-menu-label\"} \"Menu\"] [:svg {:class \"kot-menu-burger\" :viewBox \"0 0 24 24\" :width 20 :height 20 :aria-hidden \"true\" :focusable \"false\"} [:path {:d \"M4 7h16M4 12h16M4 17h16\" :fill \"none\" :stroke \"currentcolor\" :stroke-width 2 :stroke-linecap \"round\"}]] [:svg {:class \"kot-menu-caret\" :viewBox \"0 0 24 24\" :width 18 :height 18 :aria-hidden \"true\" :focusable \"false\"} [:path {:d \"M4 8.5 12 16l8-7.5\" :fill \"none\" :stroke \"currentcolor\" :stroke-width 2 :stroke-linecap \"round\" :stroke-linejoin \"round\"}]]]")]
  (document-vector (document-keyword :details) (document-map :class (document-string "kot-menu") :id (document-string "kot-menu")) summary
   (document-vector (document-keyword :div) (document-map :class (document-string "kot-menu-panel"))
    (group "On this page" (list chapters)) (group "Learn" (list learn))
    (group "Project" (list project)) (group "Elsewhere" (list elsewhere))))))
(defn render-menu [state [:ref :site/catalog] tag :string base :string home :bool] [:option :string]
 (let [raw (menu home) translated (if (string=? tag "en") (option-some-of [:option :document] raw) (tree/map-indexed state raw))]
  (if (option-some?-of [:option :document] translated)
   (let [mapped (if (string=? tag "en") translated (rebase/rebase-links (value translated) tag base))]
    (if (option-some?-of [:option :document] mapped) (html/render (value mapped) 0) (option-none-of [:option :string])))
   (option-none-of [:option :string]))))
