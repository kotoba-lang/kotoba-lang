(ns site.native.home-code-play (:export [render])
 (:require [site.native.home-highlight :as highlight] [site.native.home-play :as play]
           [site.native.home-section :as section] [site.native.source-concat :as source]
           [site.native.locale-tree :as tree] [site.native.locale-rebase :as rebase]
           [html-hiccup :as html] [button :as button]))
;; Source-derived code/play section; the pinned demo's highlighted code is
;; streamed into a unique placeholder after tree translation and rendering.
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- substitute [s :string needle :string replacement :string] [:option :string]
 (let [pos (string-index-of s needle)]
  (if (< pos 0) (none)
   (let [after (+ pos (string-byte-length needle)) tail (string-substring s after (string-byte-length s))]
    (if (>= (string-index-of tail needle) 0) (none)
     (option-some-of [:option :string] (string-concat (string-substring s 0 pos) (string-concat replacement tail))))))))
(defn render [state [:ref :site/catalog] tag :string generator :string sample :string provenance :string wasm :vector-i64 grammar :string tokenizer :string theme :string] [:option :string]
 (let [highlighted (highlight/render sample grammar tokenizer theme) play-script (play/script generator sample provenance wasm)
       run-button (button/node (record-new [:ref :btn/opts] "" "lg" "" "kot-play-run" "" false false (document-vector))
                    (document-string "Run Kotoba") (document-map))]
  (if (or (not (option-some?-of [:option :string] highlighted)) (not (option-some?-of [:option :string] play-script))
          (not (option-some?-of [:option :document] run-button))) (none)
   (let [first (substitute generator "(highlighted-kotoba play-source)" "\"987654321012\"")]
    (if (not (option-some?-of [:option :string] first)) (none)
     (let [second (substitute (option-value-of [:option :string] first "")
                   "(dds/button \"Run Kotoba\" {:id \"kot-play-run\" :size \"lg\"})" (document-edn-print (val run-button)))]
      (if (not (option-some?-of [:option :string] second)) (none)
       (let [data (source/data (option-value-of [:option :string] second "") "(defn code-play-section []" 40 41)
             node (if (option-some?-of [:option :document] data) (section/evaluate (val data)) (option-none-of [:option :document]))
             localized (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)]
        (if (not (option-some?-of [:option :document] localized)) (none)
         (let [rebased (if (string=? tag "en") localized (rebase/rebase-links (val localized) tag "/"))]
          (if (not (option-some?-of [:option :document] rebased)) (none)
           (let [frame (html/render (val rebased) 0)]
            (if (option-some?-of [:option :string] frame)
             (substitute (option-value-of [:option :string] frame "") "987654321012" (option-value-of [:option :string] highlighted ""))
             (none))))))))))))))
