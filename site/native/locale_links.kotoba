(ns site.native.locale-links (:export [resolve-link]))

;; Source-compatible local-path rebasing for the seven current localized
;; routes. Unqualified URL spellings return none instead of an altered link.
(defn- some [x :string] [:option :string] (option-some-of [:option :string] x))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- starts? [s :string prefix :string] :bool
 (and (>= (string-byte-length s) (string-byte-length prefix))
      (string=? (string-substring s 0 (string-byte-length prefix)) prefix)))
(defn- path? [s :string] :bool
 (or (string=? s "/") (string=? s "/blog/") (string=? s "/libraries/")
     (string=? s "/legal/") (string=? s "/sponsor/")
     (string=? s "/blog/infra-cost-measured-path/") (string=? s "/blog/csf2-attack-graphs/")))
(defn- locale? [s :string] :bool
 (or (string=? s "ar") (string=? s "arz") (string=? s "bn") (string=? s "de")
     (string=? s "es") (string=? s "fr") (string=? s "hi") (string=? s "id")
     (string=? s "ja") (string=? s "ko") (string=? s "mr") (string=? s "pcm")
     (string=? s "pt") (string=? s "ru") (string=? s "ur") (string=? s "zh-Hans")))
(defn- lower-scheme? [s :string] :bool
 (loop [i 0]
  (if (>= i (string-byte-length s)) false
   (let [c (string-code-point-at s i)]
    (cond (= c 58) (> i 0) (and (>= c 97) (<= c 122)) (recur (+ i 1)) :else false)))))
(defn- path-char? [c :i64] :bool
 (or (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122))
     (and (>= c 48) (<= c 57)) (= c 47) (= c 46) (= c 95) (= c 126) (= c 45)))
(defn- path-end [s :string] :i64
 (loop [i 0]
  (if (>= i (string-byte-length s)) i
   (let [c (string-code-point-at s i)] (if (or (= c 63) (= c 35)) i (recur (+ i 1)))))))
(defn- safe? [s :string end :i64] :bool
 (loop [i 0]
  (if (>= i (string-byte-length s)) true
   (let [c (string-code-point-at s i)]
    (if (if (< i end) (path-char? c)
          (and (>= c 33) (<= c 126) (not (= c 37)) (not (= c 34))
               (not (= c 39)) (not (= c 60)) (not (= c 62)) (not (= c 92)) (not (= c 96))))
     (recur (+ i 1)) false)))))
(defn- next-slash [s :string i :i64] :i64
 (if (>= i (string-byte-length s)) i
  (if (= (string-code-point-at s i) 47) i (next-slash s (+ i 1)))))
(defn- previous-slash [s :string i :i64] :i64
 (if (< i 0) -1 (if (= (string-code-point-at s i) 47) i (previous-slash s (- i 1)))))
(defn- pop [s :string] :string
 (let [i (previous-slash s (- (string-byte-length s) 1))]
  (if (< i 0) "" (string-substring s 0 i))))
(defn- normalize [s :string] :string
 (loop [start 1 out ""]
  (let [end (next-slash s start) done (= end (string-byte-length s)) part (string-substring s start end)
        current (cond (string=? part ".") out (string=? part "..") (pop out)
                      :else (string-concat out (string-concat "/" part)))]
   (if done
    (let [last (if (or (string=? part ".") (string=? part "..")) (string-concat current "/") current)]
     (if (string=? last "") "/" last))
    (recur (+ end 1) current)))))
(defn resolve-link [tag :string base :string href :string] [:option :string]
 (if (or (not (locale? tag)) (not (or (path? base) (string=? base "/spec/org-identity/")))) (none)
  (if (or (starts? href "#") (starts? href "//") (lower-scheme? href)) (some href)
   (let [end (path-end href)]
    (if (not (safe? href end)) (none)
     (let [relative (string-substring href 0 end)
           suffix (string-substring href end (string-byte-length href))
           input (if (starts? relative "/") relative (string-concat base relative))
           path (normalize input)
           localized (if (path? path) (string-concat "/" (string-concat tag path)) path)]
      (some (string-concat localized suffix))))))))
