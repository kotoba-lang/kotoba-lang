(ns site.native.article-stage (:export [stage])
 (:capabilities [:fs/app-data-bytes :process/spawn])
 (:require [multiformats.sha256 :as sha]))
;; Existing blog locale roots and spec root, manifest and input directory are
;; trusted private build inputs. Failure leaves an incomplete stage, never publish.
(defn- bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- text [v :vector-i64] :string (string-from-utf8 (bytes-from-vector-i64 v)))
(defn- zero [] :string (string-from-utf8 (bytes-from-vector-i64 [0])))
(defn- field [s :string] :string (string-concat s (zero)))
(defn- cat [a :vector-i64 b :vector-i64] :vector-i64
 (let [n (vector-count a) m (vector-count b)
       out (loop [i 0 v (vector-alloc (+ n m))] (if (= i n) v (recur (+ i 1) (vector-assoc! v i (vector-at a i)))))]
  (loop [i 0 v out] (if (= i m) v (recur (+ i 1) (vector-assoc! v (+ n i) (vector-at b i)))))))
(defn- frame [op :i64 tail :vector-i64] :vector-i64 (cat [0 65 77 85 72 1 op] tail))
(defn- call [op :i64 tail :vector-i64] :vector-i64
 (vector-i64-from-bytes (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-from-vector-i64 (frame op tail)))))
(defn- read [p :string] :vector-i64 (call 1 (bytes (field p))))
(defn- ok? [v :vector-i64] :bool (and (> (vector-count v) 0) (= (vector-at v 0) 0)))
(defn- payload [v :vector-i64] :vector-i64
 (let [n (- (vector-count v) 1)] (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ i 1))))))))
(defn- join [a :string b :string] :string (string-concat a (string-concat "/" b)))
(defn- mkdir [p :string] :bool (ok? (call 3 (bytes (field p)))))
(defn- val [d :document k :keyword] :string
 (option-value-of [:option :string] (document-string-value (option-value-of [:option :document] (document-get d k) (document-null))) ""))
(defn- matches? [path :string expected :string] :bool
 (let [r (read path)] (and (ok? r) (= (string-byte-length expected) 64) (arena-scope (string=? (sha/digest-hex (payload r)) expected)))))
(defn- hex [n :i64] :i64 (cond (and (>= n 48) (<= n 57)) (- n 48) (and (>= n 65) (<= n 70)) (- n 55) :else -1))
(defn- success? [s :string] :bool
 (let [v (bytes s)] (and (= (vector-count v) 5) (= (vector-at v 0) 48)
  (>= (hex (vector-at v 1)) 0) (>= (hex (vector-at v 2)) 0) (>= (hex (vector-at v 3)) 0) (>= (hex (vector-at v 4)) 0)
  (= (+ (* 16 (hex (vector-at v 1))) (hex (vector-at v 2))) 42))))
(defn- spawn [cwd :string capture :string exe :string argc :i64 args :string] :bool
 (let [fields (string-concat (field cwd) (string-concat (field capture) (string-concat (field exe) (string-concat (field "site-article") args))))
       request (frame 9 (cat [1 argc] (bytes fields)))]
  (success? (typed-cap-call :process/spawn :string :string (text request)))))
(defn- tag [i :i64] :string
 (case i 0 "en" 1 "ar" 2 "arz" 3 "bn" 4 "de" 5 "es" 6 "fr" 7 "hi" 8 "id" 9 "ja" 10 "ko" 11 "mr" 12 "pcm" 13 "pt" 14 "ru" 15 "ur" 16 "zh-Hans" ""))
(defn- page [m :document private :string site :string route :string t :string] :bool
 (let [root (if (string=? t "en") site (join site t)) slug (cond (string=? route "infra") "infra-cost-measured-path" (string=? route "security") "csf2-attack-graphs" (string=? route "parity") "embench-c-parity-20261015" (string=? route "progress") "embench-progress-20261012" (string=? route "usage") "kotoba-murakumo-how-to-use-20261015" :else "org-identity")
       parent (if (string=? route "identity") (join site "spec") (join root "blog")) dest (join parent slug)
       id (string-concat route (string-concat "-" t)) capture (join private (string-concat id ".html")) log (join private (string-concat id ".log"))
       args (string-concat (field route) (field t))]
  (if (not (mkdir dest)) false
   (if (not (spawn (val m :article-dir) capture (val m :article) 3 args)) false
    (let [data (read capture)]
     (if (not (ok? data)) false
      (let [digest (sha/digest-hex (payload data))
            copy-args (string-concat (field capture) (string-concat (field digest) (string-concat (field dest) (field "index.html"))))]
       (spawn private log (val m :asset) 5 copy-args))))))))
(defn- pages [m :document private :string site :string i :i64] :bool
 (if (= i 17) true
  (let [t (tag i)] (and (page m private site "infra" t) (page m private site "security" t) (pages m private site (+ i 1))))))
(defn stage [m :document private :string site :string] :bool
 (and (= (document-kind m) :map) (not (string=? private "")) (not (string=? site "")) (not (string=? (val m :article-dir) ""))
      (matches? (val m :article) (val m :article-sha)) (matches? (val m :asset) (val m :asset-sha))
      (pages m private site 0) (page m private site "identity" "en")
      (page m private site "parity" "en") (page m private site "parity" "ja")
      (page m private site "progress" "en") (page m private site "progress" "ja")
      (page m private site "usage" "en") (page m private site "usage" "ja")))
