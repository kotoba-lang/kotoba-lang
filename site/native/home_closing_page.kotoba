(ns site.native.home-closing-page (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.input :as input] [site.native.locale-catalog :as catalog] [site.native.home-closing-chapter :as home]))
(defn- locale? [s :string] :bool
 (or (string=? s "en") (string=? s "ar") (string=? s "arz") (string=? s "bn") (string=? s "de")
     (string=? s "es") (string=? s "fr") (string=? s "hi") (string=? s "id") (string=? s "ja")
     (string=? s "ko") (string=? s "mr") (string=? s "pcm") (string=? s "pt") (string=? s "ru")
     (string=? s "ur") (string=? s "zh-Hans")))
(defn- read [s :string] :string (input/read s))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "1")]
  (if (not (locale? tag)) 7
   (match-option (catalog/open-catalog (read (string-concat "/site/i18n/" (string-concat tag ".json")))) [:option [:ref :site/catalog]]
    (none 7)
    (some state
     (let [out (home/render state tag (read "/generator.cljk") (read "/docs-release.edn")
                (read "/wasm-component-platform.edn") (read "/elaboration-pipeline.edn") (read "/sponsorship.edn"))]
      (if (option-some?-of [:option :string] out)
       (let [ignored (typed-cap-call :io/write :string :string (option-value-of [:option :string] out ""))] 42) 7)))))))
