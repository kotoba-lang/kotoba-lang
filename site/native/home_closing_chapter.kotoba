(ns site.native.home-closing-chapter (:export [render])
 (:require [site.native.home-contents :as contents] [site.native.home-section :as section]))
;; Last homepage chapter; its five sections come from pinned source authorities.
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
  (some (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (none)))
(defn render [state [:ref :site/catalog] tag :string generator :string release :string platform :string pipeline :string sponsorship :string] [:option :string]
 (let [a (append (some "<div class=\"kot-chapter-block\">") (contents/rule-at state tag generator 4))
       b (append a (section/render-section state tag generator "roadmap"))
       c (append b (section/render-section state tag generator "community"))
       d (append c (section/render-sponsor state tag generator sponsorship))
       e (append d (section/render-section state tag generator "cloud"))
       f (append e (section/render-source state tag generator release platform pipeline))]
  (append f (some "</div>"))))
