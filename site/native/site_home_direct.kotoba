(ns site.native.site-home-direct (:export [main run])
 (:capabilities [:fs/app-data-bytes :process/spawn :cli/args])
 (:require [site.native.site-sections-controller :as sections] [site.native.home-stage :as home] [multiformats.sha256 :as sha]))
;; Trusted private inputs and empty private outputs. Any failure may leave an
;; incomplete private stage; the caller must discard it. Success is not release admission.
(defn- bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- zero [] :string (string-from-utf8 (bytes-from-vector-i64 [0])))
(defn- cat [a :vector-i64 b :vector-i64] :vector-i64
 (let [n (vector-count a) m (vector-count b) x (loop [i 0 v (vector-alloc (+ n m))] (if (= i n) v (recur (+ i 1) (vector-assoc! v i (vector-at a i)))))]
  (loop [i 0 v x] (if (= i m) v (recur (+ i 1) (vector-assoc! v (+ n i) (vector-at b i)))))))
(defn- read [p :string] :vector-i64
 (vector-i64-from-bytes (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-from-vector-i64 (cat [0 65 77 85 72 1 1] (bytes (string-concat p (zero))))))))
(defn- matches? [p :string digest :string] :bool
 (let [v (read p)] (if (or (not (= (string-byte-length digest) 64)) (= (vector-count v) 0) (not (= (vector-at v 0) 0))) false
  (let [data (loop [i 1 out (vector-alloc (- (vector-count v) 1))] (if (= i (vector-count v)) out (recur (+ i 1) (vector-assoc! out (- i 1) (vector-at v i)))))]
   (arena-scope (string=? (sha/digest-hex data) digest))))))
(defn- arg [n :string] :string (typed-cap-call :cli/args :string :string n))
(defn run [section-manifest :string section-sha :string home-manifest :string home-sha :string private :string site :string] :i64
 (if (or (string=? private "") (string=? site "") (not (matches? section-manifest section-sha)) (not (matches? home-manifest home-sha))) 7
  (if (= (arena-scope (sections/run section-manifest private site)) 42) (home/run home-manifest site) 7)))
(defn main [] :i64
 (run (arg "0") (arg "1") (arg "2") (arg "3") (arg "4") (arg "5")))
