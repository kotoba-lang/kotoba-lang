(ns site.native.home-command (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.home-hero-page :as hero]))
;; The hero is a separate native executable; site-command handles the other
;; existing fragments and article routes within the FS2 packaging bound.
;; The controller must stage stdout and accept it only after exit status 42.
(defn main [] :i64
 (if (string=? (typed-cap-call :cli/args :string :string "0") "hero") (hero/main) 7))
