(ns site.native.page-metadata (:export [render-metadata])
 (:require [site.native.locale-catalog :as catalog] [site.native.locale-message :as message]
           [site.native.locale-links :as links] [html-hiccup :as html]))
;; The title/description and OG/canonical projection of the existing page
;; source, emitted as bounded pieces. CSS, scripts and complete head are not here.
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
  (some (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (none)))
(defn- render [d :document] [:option :string] (html/render d 0))
(defn- meta [attribute :keyword name :string content :string] [:option :string]
 (render (document-vector (document-keyword :meta) (document-map attribute (document-string name) :content (document-string content)))))
(defn- alternate [tag :string base :string] [:option :string]
 (let [path (if (or (string=? tag "en") (string=? tag "x-default")) base (string-concat "/" (string-concat tag base)))
       url (string-concat "https://kotoba-lang.org" path)]
  (render (document-vector (document-keyword :link) (document-map :rel (document-string "alternate")
   :hreflang (document-string tag) :href (document-string url))))))
(defn- bilingual? [base :string] :bool
 (or (string=? base "/aiueos/") (string=? base "/blog/embench-c-parity-20261015/")
     (string=? base "/blog/embench-progress-20261012/")
     (string=? base "/blog/kotoba-murakumo-how-to-use-20261015/")))
(defn- alternates [base :string] [:option :string]
 (let [tags (document-vector (document-string "en") (document-string "zh-Hans") (document-string "hi") (document-string "es")
  (document-string "ar") (document-string "fr") (document-string "bn") (document-string "pt") (document-string "id")
  (document-string "ur") (document-string "ru") (document-string "de") (document-string "ja") (document-string "ko")
  (document-string "pcm") (document-string "arz") (document-string "mr") (document-string "x-default"))]
  (loop [i 0 out (some "")]
   (if (or (>= i (document-count tags)) (not (option-some?-of [:option :string] out))) out
    (let [tag (option-value-of [:option :string] (document-string-value (option-value-of [:option :document] (document-vector-at tags i) (document-null))) "")]
     (recur (+ i 1) (append out (alternate tag base))))))))
(defn- og-locale [tag :string] :string
 (cond (string=? tag "ja") "ja_JP" (string=? tag "hi") "hi_IN" (string=? tag "zh-Hans") "zh_CN"
       (string=? tag "ar") "ar" (string=? tag "es") "es" (string=? tag "fr") "fr" :else "en_US"))
(defn- text [state [:ref :site/catalog] tag :string input :string] [:option :string]
 (if (string=? tag "en") (some input) (message/translate-indexed state input)))
(defn- custom-link [mime :string url :string title :string] [:option :string]
 (render (document-vector (document-keyword :link) (document-map :rel (document-string "alternate") :type (document-string mime)
  :href (document-string url) :title (document-string title)))))
(defn- jsonld [] :string "{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://kotoba-lang.org/#website\",\"url\":\"https://kotoba-lang.org/\",\"name\":\"Kotoba\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"Kotoba Foundation\"},\"inLanguage\":[\"en\",\"zh-Hans\",\"hi\",\"es\",\"ar\",\"fr\",\"bn\",\"pt\",\"id\",\"ur\",\"ru\",\"de\",\"ja\",\"ko\",\"pcm\",\"arz\",\"mr\",\"ta\",\"uk\"]}")
(defn render-metadata [state [:ref :site/catalog] tag :string base :string title :string description :string] [:option :string]
 (let [valid (links/resolve-link (if (string=? tag "en") "ja" tag) base "#")
       bilingual (bilingual? base)
       t (if bilingual (some title) (text state tag title)) d (if bilingual (some description) (text state tag description))]
  (if (or (and (string=? base "/spec/org-identity/") (not (string=? tag "en"))) (not (option-some?-of [:option :string] valid)) (not (option-some?-of [:option :string] t))
          (not (option-some?-of [:option :string] d))) (none)
   (let [title (option-value-of [:option :string] t "") desc (option-value-of [:option :string] d "")
         path (if (string=? tag "en") base (string-concat "/" (string-concat tag base)))
         url (string-concat "https://kotoba-lang.org" path)
         title-node (render (document-vector (document-keyword :title) (document-string title)))
         description-node (meta :name "description" desc)
         canonical (render (document-vector (document-keyword :link) (document-map :rel (document-string "canonical") :href (document-string url))))
         a (append title-node description-node) b (append a canonical)
         c (cond (or (string=? base "/spec/org-identity/") (string=? base "/aiueos/")) b
                 bilingual (append (append b (alternate "en" base)) (alternate "ja" base))
                 :else (append b (alternates base)))
         d1 (append c (meta :property "og:site_name" "Kotoba"))
         json (render (document-vector (document-keyword :script) (document-map :type (document-string "application/ld+json")) (document-string (jsonld))))
         d2 (append d1 json) d3 (append d2 (meta :property "og:type" "website"))
         d4 (append d3 (meta :property "og:url" url)) d5 (append d4 (meta :property "og:title" title))
         d6 (append d5 (meta :property "og:description" desc))
         d7 (append d6 (meta :property "og:image" "https://kotoba-lang.org/kotoba-og-card.png"))
         d8 (append d7 (meta :property "og:image:width" "1200")) d9 (append d8 (meta :property "og:image:height" "630"))
         d10 (append d9 (meta :property "og:image:alt" "Safe code. Built for machine speed."))
         d11 (append d10 (custom-link "text/markdown" "https://kotoba-lang.org/agent-quickstart.md" "AI agent quickstart"))
         d12 (append d11 (custom-link "text/plain" "https://kotoba-lang.org/llms.txt" "LLM documentation index"))
         d13 (append d12 (meta :name "twitter:title" title)) d14 (append d13 (meta :name "twitter:description" desc))
         d15 (append d14 (meta :property "og:locale" (og-locale tag))) d16 (append d15 (meta :name "twitter:card" "summary_large_image"))]
    (append d16 (meta :name "twitter:image" "https://kotoba-lang.org/kotoba-og-card.png"))))))
