(ns site.native.start-card-body (:export [render])
 (:require [site.native.header :as header] [site.native.footer :as footer] [site.native.start-card :as card]))
;; Standalone en/ta/uk pages intentionally keep the shared navigation in English.
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
  (some (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (none)))
(defn render [state [:ref :site/catalog] tag :string generator :string locales :string] [:option :string]
 (let [a (some "<body><div><a class=\"kot-skip\" href=\"#main\" lang=\"en\">Skip to content</a><div lang=\"en\" dir=\"ltr\">")
       b (append a (header/render-header state "en" "/" false))
       c (append b (some "</div><main id=\"main\"><div class=\"dds-ext-container\">"))
       d (append c (card/render tag generator locales))
       e (append d (some "</div></main><div lang=\"en\" dir=\"ltr\">"))
       f (append e (footer/render-footer state "en" "/" false "../legal/" false "site/native/start_card_body.kotoba"))]
  (append f (some "</div></div></body>"))))
