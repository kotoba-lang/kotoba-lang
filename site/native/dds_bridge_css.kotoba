(ns site.native.dds-bridge-css (:export [bridge])
 (:require [multiformats.sha256 :as sha]))
;; Stream the pinned source map: it has more entries than a native document
;; can hold. The same source map, not a generated CSS copy, supplies values.
(defn- none [] [:option :document] (option-none-of [:option :document]))
(defn- some [d :document] [:option :document] (option-some-of [:option :document] d))
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- next-entry [src :string previous :string] [:option :document]
 (loop [pos 0 best "" value ""]
  (if (>= pos (string-byte-length src))
   (if (string=? best "") (none) (some (document-map :key (document-string best) :value (document-string value))))
   (let [tail (string-substring src pos (string-byte-length src)) nl (string-index-of tail "\n")
         end (if (< nl 0) (string-byte-length src) (+ pos nl)) line (string-substring src pos end)
         mark (string-index-of line "\"--hig-")]
    (if (< mark 0) (recur (if (< nl 0) end (+ end 1)) best value)
     (let [a (+ mark 1) rest (string-substring line a (string-byte-length line)) q (string-index-of rest "\"")
           after (if (< q 0) "" (string-substring rest (+ q 1) (string-byte-length rest)))
           v-start (string-index-of after "\"") v-tail (if (< v-start 0) "" (string-substring after (+ v-start 1) (string-byte-length after)))
           v-end (string-index-of v-tail "\"") key (if (< q 0) "" (string-substring rest 0 q))
           v (if (< v-end 0) "" (string-substring v-tail 0 v-end))
           choose (and (>= q 0) (>= v-end 0) (> (string-compare key previous) 0) (or (string=? best "") (< (string-compare key best) 0)))]
      (recur (if (< nl 0) end (+ end 1)) (if choose key best) (if choose v value))))))))
(defn- safe? [s :string] :bool
 (not (or (string-contains? s "{") (string-contains? s "}") (string-contains? s ";") (string-contains? s "/*"))))
(defn bridge [source :string] [:option :string]
 (if (not (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 source))) "c129e5bc95f2ea20411b4541763d8305ad22efe8d09ec2628fbe7fd2ce31a4eb"))
  (option-none-of [:option :string])
  (let [start (string-index-of source "(def hig->dads") end (string-index-of source "(def motion")]
   (if (or (< start 0) (<= end start)) (option-none-of [:option :string])
    (let [src (string-substring source start end)]
     (loop [previous "" count 0 out ":root { "]
      (let [item (next-entry src previous)]
       (if (not (option-some?-of [:option :document] item))
        (if (= count 128) (option-some-of [:option :string] (string-concat out " }")) (option-none-of [:option :string]))
        (let [d (val item) key (text (val (document-get d :key))) value (text (val (document-get d :value)))]
         (if (or (not (safe? key)) (not (safe? value))) (option-none-of [:option :string])
          (recur key (+ count 1) (string-concat out (string-concat (if (= count 0) "" " ")
           (string-concat key (string-concat ": " (string-concat value ";"))))))))))))))))
