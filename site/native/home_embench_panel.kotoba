(ns site.native.home-embench-panel (:export [render])
 (:require [json.core :as json] [multiformats.sha256 :as sha] [html-hiccup :as html]
           [components :as dds] [button :as button]))
;; Bounded to the pinned Embench report and chart source; this is not an
;; independent benchmark, a released toolchain result or a generic chart.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- field [d :document k :string] :document (val (document-get d (document-string k))))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- number [d :document] :f64 (if (= (document-kind d) :i64) (i64-to-f64-rounded (option-value-of [:option :i64] (document-i64-value d) 0)) (option-value-of [:option :f64] (document-f64-value d) -1.0)))
(defn- fixed [x :f64 scale :i64 digits :i64] :string
 (let [v (f64-to-i64-truncating (f64-add (f64-mul x (i64-to-f64-rounded scale)) 0.5)) whole (quot v scale) frac (rem v scale)]
  (string-concat (string-from-i64 whole) (string-concat "." (string-concat (if (and (= digits 3) (< frac 100)) "0" "") (string-concat (if (< frac 10) "0" "") (string-from-i64 frac)))))))
(defn- hash? [s :string h :string] :bool (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) h)))
(defn- member? [xs :document name :string i :i64] :bool
 (if (>= i (document-count xs)) false (if (string=? (text (item xs i)) name) true (member? xs name (+ i 1)))))
(defn- max-ratio [rows :document i :i64 best :f64] :f64
 (if (>= i (document-count rows)) best
  (let [x (number (field (item rows i) "normalizedTimeRatio"))] (max-ratio rows (+ i 1) (if (f64-gt x best) x best)))))
(defn- next-row [rows :document i :i64 previous :f64 best :document best-n :f64] :document
 (if (>= i (document-count rows)) best
  (let [d (item rows i) x (number (field d "normalizedTimeRatio"))]
   (if (and (f64-gt x previous) (f64-lt x best-n)) (next-row rows (+ i 1) previous d x) (next-row rows (+ i 1) previous best best-n)))))
(defn- bar [row :document top :f64 substitutions :document] [:option :document]
 (let [name (field row "workload") n (text name) x (number (field row "normalizedTimeRatio"))
       label (string-concat n (if (member? substitutions n 0) " *" (if (string=? n "nettle-sha256") " †" "")))
       attrs (if (f64-lt x 1.0) (document-map :class (document-string "kot-bar") :data-lead (document-string "1")) (document-map :class (document-string "kot-bar")))]
  (if (or (not (= (document-kind name) :string)) (string=? n "") (f64-le x 0.0) (f64-le top 0.0)) (option-none-of [:option :document])
   (option-some-of [:option :document]
    (document-vector (document-keyword :li) attrs
     (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-label")) (document-string label))
     (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-track"))
      (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-fill") :style (document-string (string-concat "--w:" (string-concat (fixed (f64-mul 100.0 (f64-div x top)) 1000 3) "%"))))))
     (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-value")) (document-string (string-concat (fixed x 100 2) "×"))))))))
(defn- bars [rows :document substitutions :document top :f64 i :i64 previous :f64 out :document] [:option :document]
 (if (= i 19) (option-some-of [:option :document] out)
  (let [row (next-row rows 0 previous (document-null) 1.0e+100) x (number (field row "normalizedTimeRatio")) b (bar row top substitutions)]
   (if (not (option-some?-of [:option :document] b)) (option-none-of [:option :document])
    (bars rows substitutions top (+ i 1) x (document-vector-conj out (val b)))))))
(defn- faster [rows :document i :i64 count :i64] :i64
 (if (>= i (document-count rows)) count (faster rows (+ i 1) (if (f64-lt (number (field (item rows i) "normalizedTimeRatio")) 1.0) (+ count 1) count))))
(defn render [generator :string report :string chart :string] [:option :string]
 (if (not (and (hash? generator "ca2955ee08ec6891787d7636238b1bc7b0ab64b807c4c8ce653ec03657d6c072") (hash? report "6352f6e90e7b456b77cbddc1edc2a91bfc3bd9f9a5f98dcc22fa788d51923411") (hash? chart "651e9bc2bfc31b15493f00c05d2aeaaddd70e9dbec3be55846a389dccb6e9a20"))) (option-none-of [:option :string])
  (let [parsed (json/decode report) d (result-value-of [:result :document :document] parsed (document-null)) rows (field d "perWorkload")
        substitutions (field (field d "kernelAudit") "substitutionWorkloads") date (field d "measuredAt") ratio (number (field d "geometricMeanTimeRatio"))
        top (max-ratio rows 0 0.0) count (faster rows 0 0)
        bs (if (and (= (document-kind rows) :vector) (= (document-count rows) 19) (= (document-kind substitutions) :vector)) (bars rows substitutions top 0 0.0 (document-vector (document-keyword :ol) (document-map :class (document-string "kot-bars")))) (option-none-of [:option :document]))
        action (button/node (record-new [:ref :btn/opts] "" "" "#benchmark" "" "" false false (document-vector)) (document-string "See the five benchmarks") (document-map))]
   (if (or (not (result-ok?-of [:result :document :document] parsed)) (not (= (document-kind date) :string)) (f64-le ratio 0.0) (not (option-some?-of [:option :document] bs)) (not (option-some?-of [:option :document] action))) (option-none-of [:option :string])
    (let [r (fixed ratio 100 2)
          node (document-vector (document-keyword :div) (document-map :class (document-string "kot-speed") :lang (document-string "en") :translate (document-string "no"))
           (document-vector (document-keyword :span) (document-map :class (document-string "dads-chip-label") :data-style (document-string "text") :data-color (document-string "gray")) (document-string "EMBENCH IoT · 19 WORKLOADS · NOT A CERTIFIED SCORE"))
           (dds/heading-node 2 (document-string (string-concat "Translated Kotoba ports ran in " (string-concat r "× the time of C across 19 Embench workloads."))) "32" "")
           (document-vector (document-keyword :div) (document-map :class (document-string "kot-speed-figure"))
            (document-vector (document-keyword :p) (document-map :class (document-string "kot-speed-value")) (document-string r) (document-vector (document-keyword :span) (document-map :class (document-string "kot-speed-unit")) (document-string "×")))
            (document-vector (document-keyword :p) (document-map :class (document-string "kot-speed-sub")) (document-string (string-concat "Geometric mean of normalized elapsed time, Kotoba / C; below 1.0 is faster. All 19 Kotoba results exact. Measured " (string-concat (text date) " on Apple M4; baseline is the original Embench C built with Apple clang 17 -O2.")))))
           (document-vector (document-keyword :div) (document-map :class (document-string "kot-chart")) (val bs)
            (document-vector (document-keyword :p) (document-map :class (document-string "kot-chart-axis")) (document-string "Normalized elapsed time, Kotoba / C (1.0× = the C baseline); shorter is faster. Highlighted rows are faster than C.")))
           (document-vector (document-keyword :p) (document-map :class (document-string "kot-caption kot-muted"))
            (document-string (string-concat "Faster than C on " (string-concat (string-from-i64 count) (string-concat " of 19 workloads and slower on " (string-concat (string-from-i64 (- 19 count)) ". * audited substitution kernel; † ARMv8 SHA-256 instructions the C baseline does not use. One accepted sample per workload, first qualified attempt, never the fastest. This is not an official Embench score, not a released-toolchain result and not a universal speed claim. ")))))
            (document-vector (document-keyword :a) (document-map :class (document-string "kot-link") :href (document-string "/blog/embench-c-parity-20261015/")) (document-string "Read the measurements and kernel audit")) (document-string " · ")
            (document-vector (document-keyword :a) (document-map :class (document-string "kot-link") :href (document-string "./benchmarks/embench-c-parity-20261015.json")) (document-string "Inspect the raw records")))
           (document-vector (document-keyword :div) (document-map :class (document-string "kot-actions")) (val action)))]
     (html/render node 0))))))
