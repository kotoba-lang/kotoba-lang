(ns site.native.home-benchmark-scaling-template (:export [template])
 (:schemas {:site/scaling-template [:record :site/scaling-template [[:top :i64] [:date :string] [:host :string] [:hostname :string] [:first-lines :i64] [:last-lines :i64] [:qualified :bool] [:load :string] [:limit :string] [:fast :bool]]]})
 (:require [json.core :as json] [site.native.source-concat :as source] [site.native.home-section :as home]
           [site.native.locale-tree :as tree] [site.native.locale-rebase :as rebase] [multiformats.sha256 :as sha] [html-hiccup :as html] [button :as button]))
;; Source-derived text around five separately rendered scaling chart/table slots.
;; This is a template, not a complete page or a general Clojure evaluator.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- field [d :document k :string] :document (if (= (document-kind d) :map) (val (document-get d (document-string k))) (document-null)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- arg [d :document i :i64] :document (val (document-list-at d i)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- integer [d :document] :i64 (option-value-of [:option :i64] (document-i64-value d) -1))
(defn- num [d :document] :string
 (let [k (document-kind d) s (document-edn-print d) n (string-byte-length s)]
  (if (or (= k :i64) (= k :f64)) (if (and (= k :f64) (>= n 2) (string=? (string-substring s (- n 2) n) ".0")) (string-substring s 0 (- n 2)) s) "")))
(defn- none [] [:option :document] (option-none-of [:option :document]))
(defn- some [d :document] [:option :document] (option-some-of [:option :document] d))
(defn- no-text [] [:option :string] (option-none-of [:option :string]))
(defn- yes-text [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b)) (yes-text (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (no-text)))
(defn- all-qualified? [m :document i :i64] :bool
 (if (>= i (document-count m)) true
  (let [entry (val (document-map-entry-at m i)) value (item entry 1) b (field value "qualifiedFaster")]
   (if (and (= (document-kind b) :bool) (option-value-of [:option :bool] (document-bool-value b) false)) (all-qualified? m (+ i 1)) false))))
(defn- top [scales :document] :i64
 (loop [i 0 found -1]
  (if (>= i (document-count scales)) found
   (let [d (item scales i) r (field (field d "lanes") "kotoba-wasm-cli") k (integer (field d "k"))]
    (recur (+ i 1) (if (string=? (text (field r "status")) "measured") k found))))))
(defn- context [report :string] [:option [:ref :site/scaling-template]]
 (let [r (json/decode report) d (result-value-of [:result :document :document] r (document-null)) scales (field d "scales") env (field d "environment") absolute (field d "absoluteTimes")
       n (document-count scales) first (item scales 0) last (item scales (- n 1)) date (text (field d "generatedAt")) hostname (field env "hostname") host (field env "cpu")
       lines1 (integer (field (field first "sourceLines") "kotoba")) lines2 (integer (field (field last "sourceLines") "kotoba")) loads (field absolute "observedLoad1")
       lo1 (num (item loads 0)) lo2 (num (item loads 1)) limit (num (field absolute "quietLoad1Limit")) q (field absolute "qualified")
       orderings (field (field first "ordering") "kotoba-wasm-cli") cli-top (top scales)]
  (if (or (not (result-ok?-of [:result :document :document] r)) (not (= (document-kind scales) :vector)) (<= n 0) (< (string-byte-length date) 10)
          (not (= (document-kind host) :string)) (not (= (document-kind hostname) :string)) (< lines1 0) (< lines2 0) (< cli-top 0)
          (not (= (document-kind loads) :vector)) (< (document-count loads) 2) (string=? lo1 "") (string=? lo2 "") (string=? limit "")
          (not (= (document-kind q) :bool)) (not (= (document-kind orderings) :map))) (option-none-of [:option [:ref :site/scaling-template]])
   (option-some-of [:option [:ref :site/scaling-template]] (record-new [:ref :site/scaling-template] cli-top (string-substring date 0 10) (text host) (text hostname) lines1 lines2
      (option-value-of [:option :bool] (document-bool-value q) false) (string-concat lo1 (string-concat "–" lo2)) limit
      (and (> (document-count orderings) 0) (all-qualified? orderings 0)))))))
(defn- symbols [s :string ctx [:ref :site/scaling-template]] :document
 (cond (string=? s "measured-date") (document-string (get ctx :date)) (string=? s "hostname") (document-string (get ctx :hostname))
       (string=? s "host") (document-string (get ctx :host)) (string=? s "cli-top") (document-i64 (get ctx :top)) :else (document-edn-read s)))
(defn- list-build [d :document i :i64 ctx [:ref :site/scaling-template] out :string] [:option :document]
 (if (>= i (document-count d)) (some (document-edn-read (string-concat out ")")))
  (let [v (transform (arg d i) ctx)]
   (if (option-some?-of [:option :document] v) (list-build d (+ i 1) ctx (string-concat out (string-concat (if (= i 0) "" " ") (document-edn-print (val v))))) (none)))))
(defn- vector-build [d :document i :i64 ctx [:ref :site/scaling-template] out :document] [:option :document]
 (if (>= i (document-count d)) (some out)
  (let [v (transform (item d i) ctx)]
   (if (option-some?-of [:option :document] v) (vector-build d (+ i 1) ctx (document-vector-conj out (val v))) (none)))))
(defn- string-build [d :document i :i64 ctx [:ref :site/scaling-template] out :string] [:option :document]
 (if (>= i (document-count d)) (some (document-string out))
  (let [v (transform (arg d i) ctx) x (val v) k (document-kind x)]
   (if (and (option-some?-of [:option :document] v) (or (= k :string) (= k :i64) (= k :f64)))
    (string-build d (+ i 1) ctx (string-concat out (if (= k :string) (text x) (num x)))) (none)))))
(defn- transform [d :document ctx [:ref :site/scaling-template]] [:option :document]
 (let [k (document-kind d)]
  (cond (= k :symbol) (some (symbols (document-edn-print d) ctx))
        (= k :vector) (vector-build d 0 ctx (document-vector))
        (= k :list)
         (let [head (document-edn-print (arg d 0)) whole (document-edn-print d)]
          (cond (string=? head "str") (string-build d 1 ctx "")
                (string=? head "if")
                 (let [condition (document-edn-print (arg d 1)) valid (or (string=? condition "(:qualified absolute)") (string=? condition "cli-fastest-when-small"))
                       yes (if (string=? condition "(:qualified absolute)") (get ctx :qualified) (get ctx :fast))]
                  (if valid (transform (arg d (if yes 2 3)) ctx) (none)))
                (string=? whole "(get-in (first scales) [:sourceLines :kotoba])") (some (document-i64 (get ctx :first-lines)))
                (string=? whole "(get-in (last scales) [:sourceLines :kotoba])") (some (document-i64 (get ctx :last-lines)))
                (string=? whole "(:quietLoad1Limit absolute)") (some (document-string (get ctx :limit)))
                (string=? whole "(str/join \"–\" (map str (take 2 (:observedLoad1 absolute))))") (some (document-string (get ctx :load)))
                (string=? head "dds/button")
                 (let [label (arg d 1) opts (arg d 2) href (val (document-get opts :href))]
                  (if (and (= (document-kind label) :string) (= (document-kind href) :string))
                   (button/node (record-new [:ref :btn/opts] "" "" (text href) "" "" false false (document-vector)) label (document-map)) (none)))
                :else (list-build d 0 ctx "(")))
        (or (= k :string) (= k :i64) (= k :f64) (= k :keyword) (= k :map)) (some d)
        :else (none))))
(defn- fragment [state [:ref :site/catalog] tag :string generator :string ctx [:ref :site/scaling-template] marker :string opening :i64 closing :i64] [:option :string]
 (let [pos (string-index-of generator marker) tail (if (< pos 0) "" (string-substring generator pos (string-byte-length generator)))
       form (source/data (string-concat "~FORM~" tail) "~FORM~" opening closing)
       prepared (if (option-some?-of [:option :document] form) (transform (val form) ctx) (none))
       node (if (option-some?-of [:option :document] prepared) (home/evaluate (val prepared)) (none))
       localized (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)]
  (let [rebased (if (and (option-some?-of [:option :document] localized) (not (string=? tag "en"))) (rebase/rebase-links (val localized) tag "/") localized)]
   (if (option-some?-of [:option :document] rebased) (html/render (val rebased) 0) (no-text)))))
(defn template [state [:ref :site/catalog] tag :string generator :string report :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "ca2955ee08ec6891787d7636238b1bc7b0ab64b807c4c8ce653ec03657d6c072"))
       r-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 report))) "9bb56646bb55a8746b36c66c42ebefb48bebd17ab60c4df79a2ab1702537e229"))]
  (if (or (not g-ok) (not r-ok)) (no-text)
   (let [ctx (context report) start (string-index-of generator "(defn build-scaling-section []") stop (string-index-of generator "(def benchmark-provenance")]
    (if (or (not (option-some?-of [:option [:ref :site/scaling-template]] ctx)) (< start 0) (<= stop start)) (no-text)
     (let [c (option-value-of [:option [:ref :site/scaling-template]] ctx (record-new [:ref :site/scaling-template] 0 "" "" "" 0 0 false "" "" false))
           src (string-substring generator start stop) empty (yes-text "")
           a (append empty (fragment state tag src c "(dds/heading 3 \"Build time as the source gets larger\"" 40 41))
           b (append a (fragment state tag src c "[:p\n      \"The benchmarks above build a program" 91 93))
           c1 (append b (fragment state tag src c "[:p\n      \"It then runs what each toolchain produced" 91 93))
           d (append c1 (yes-text "987650000001"))
           e (append d (fragment state tag src c "(caption\n      (str \"Both axes are logarithmic" 40 41))
           f (append e (yes-text "987650000002"))
           g (append f (fragment state tag src c "(caption\n      (str \"Measured \"" 40 41))
           h (append g (fragment state tag src c "(dds/heading 3 \"Which orderings survive the noise test\"" 40 41))
           j (append h (fragment state tag src c "[:p\n      \"A ratio is not a ranking." 91 93))
           k (append j (yes-text "987650000003"))
           l (append k (fragment state tag src c "(caption\n      (str \"improvement-below-threshold" 40 41))
           m (append l (fragment state tag src c "(dds/heading 3 \"Two failures that are not the same failure\"" 40 41))
           n (append m (fragment state tag src c "[:p\n      \"Three Kotoba lanes stopped working" 91 93))
           o (append n (yes-text "987650000004"))
           p (append o (fragment state tag src c "(dds/heading 3 \"What this establishes\"" 40 41))
           q (append p (yes-text "987650000005"))
           u (append q (fragment state tag src c "[:p\n      [:strong \"Bottom line: \"" 91 93))]
      (append u (fragment state tag src c "[:div {:class \"kot-actions\"}\n      (dds/button \"Inspect build-scaling samples\"" 91 93))))))))
