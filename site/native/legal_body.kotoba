(ns site.native.legal-body (:export [render])
 (:require [site.native.header :as header] [site.native.footer :as footer] [site.native.legal-main :as legal]
           [site.native.locale-tree :as tree] [html-hiccup :as html]))
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
  (some (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (none)))
(defn- skip [state [:ref :site/catalog] tag :string] [:option :string]
 (let [raw (document-vector (document-keyword :a) (document-map :class (document-string "kot-skip") :href (document-string "#main")) (document-string "Skip to content"))
       translated (if (string=? tag "en") (option-some-of [:option :document] raw) (tree/map-indexed state raw))]
  (if (option-some?-of [:option :document] translated) (html/render (val translated) 0) (none))))
(defn render [state [:ref :site/catalog] tag :string generator :string] [:option :string]
 (let [a (append (some "<body><div>") (skip state tag))
       b (append a (header/render-header state tag "/legal/" false))
       c (append b (legal/render state tag generator))
       d (append c (footer/render-footer state tag "/legal/" false "./" false "site/native/legal_body.kotoba"))]
  (append d (some "</div></body>"))))
