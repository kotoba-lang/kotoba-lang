(ns site.native.locale-mark (:export [mark-language]))

;; Postwalk for bounded Hiccup fragments with keyword-keyed maps. Sets are
;; passed through unchanged; this is not an arbitrary postwalk or full-page builder.
(defn- val [o [:option :document]] :document
  (option-value-of [:option :document] o (document-null)))
(defn- truthy? [d :document] :bool
  (if (= (document-kind d) :null) false
    (if (= (document-kind d) :bool)
      (option-value-of [:option :bool] (document-bool-value d) false) true)))
(defn- str-val [d :document] :string
  (option-value-of [:option :string] (document-string-value d) ""))
(defn- label [tag :string] :string
  (cond (string=? tag "en") "English" (string=? tag "zh-Hans") "简体中文"
        (string=? tag "hi") "हिन्दी" (string=? tag "es") "Español"
        (string=? tag "ar") "العربية الفصحى" (string=? tag "fr") "Français"
        (string=? tag "bn") "বাংলা" (string=? tag "pt") "Português"
        (string=? tag "id") "Bahasa Indonesia" (string=? tag "ur") "اردو"
        (string=? tag "ru") "Русский" (string=? tag "de") "Deutsch"
        (string=? tag "ja") "日本語" (string=? tag "ko") "한국어"
        (string=? tag "pcm") "Naijá" (string=? tag "arz") "العربية المصرية"
        (string=? tag "mr") "मराठी" :else tag))

(defn- map-children [node :document tag :string] :document
  (loop [i 0 out node]
    (if (>= i (document-count node)) out
      (let [pair (val (document-map-entry-at node i))
            k (val (document-vector-at pair 0)) v (val (document-vector-at pair 1))]
        (recur (+ i 1) (document-assoc out k (mark-language v tag)))))))
(defn- vector-children [node :document tag :string] :document
  (loop [i 0 out node]
    (if (>= i (document-count node)) out
      (recur (+ i 1) (document-vector-assoc out i (mark-language (val (document-vector-at node i)) tag))))))
(defn- list-children [node :document tag :string] :document
  (loop [i 0 out "("]
    (if (>= i (document-count node)) (document-edn-read (string-concat out ")"))
      (recur (+ i 1) (string-concat out (string-concat (if (= i 0) "" " ")
        (document-edn-print (mark-language (val (document-list-at node i)) tag))))))))
(defn- mark-map [node :document tag :string] :document
  (let [opener (val (document-get node :data-language-selector-opener))
        href (val (document-get node :hreflang))]
    (cond (truthy? opener) (document-assoc node :aria-label (document-string (string-concat "Language: " (label tag))))
          (truthy? href) (let [clean (document-dissoc (document-dissoc node :aria-current) :data-current)]
            (if (and (= (document-kind href) :string) (string=? tag (str-val href)))
              (document-assoc (document-assoc clean :aria-current (document-string "page")) :data-current (document-bool true))
              clean))
          :else node)))
(defn mark-language [node :document tag :string] :document
  (let [kind (document-kind node)]
    (cond (= kind :map) (mark-map (map-children node tag) tag)
          (= kind :list) (list-children node tag)
          (= kind :vector)
          (let [walked (vector-children node tag) attrs (val (document-vector-at walked 1))]
            (if (and (= (document-kind attrs) :map)
                     (truthy? (val (document-get attrs :data-language-selector-current))))
              (document-vector (val (document-vector-at walked 0)) attrs (document-string (label tag)))
              walked))
          :else node)))
