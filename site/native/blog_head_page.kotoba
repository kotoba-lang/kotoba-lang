(ns site.native.blog-head-page (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.page-head :as head]))
(defn main [] :i64
 (head/render (typed-cap-call :cli/args :string :string "0") "/blog/" "Kotoba Blog — engineering notes and evidence"
  "Kotoba engineering notes about language design, benchmarks, evidence, and remaining qualification gates."
  "Engineering notes on language design, benchmarks, evidence, and qualification gates."))
