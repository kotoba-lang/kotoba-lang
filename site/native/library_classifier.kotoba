(ns site.native.library-classifier (:export [pattern-valid? matches? classify taxonomy-valid?]))
;; Native interpreter for the limited, pinned taxonomy regex syntax: ASCII
;; literals, \\b, \\d, optional literal (?) and trailing digit repetition (+).
;; Anything outside that syntax is refused rather than approximated.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- getv [d :document k :keyword] :document (if (= (document-kind d) :map) (val (document-get d k)) (document-null)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- ch [s :string i :i64] :i64 (if (and (>= i 0) (< i (string-byte-length s))) (string-code-point-at s i) -1))
(defn- lit? [c :i64] :bool
 (or (and (>= c 97) (<= c 122)) (and (>= c 48) (<= c 57)) (= c 32) (= c 45) (= c 95)))
(defn pattern-valid? [p :string i :i64] :bool
 (let [n (string-byte-length p)]
  (if (>= i n) (> n 0)
   (let [c (ch p i) next (ch p (+ i 1))]
    (cond (= c 92) (cond (= next 98) (pattern-valid? p (+ i 2))
                          (= next 100) (if (= (ch p (+ i 2)) 43) (= (+ i 3) n) (pattern-valid? p (+ i 2)))
                          :else false)
          (lit? c) (pattern-valid? p (+ i (if (= next 63) 2 1)))
          :else false)))))
(defn- word? [c :i64] :bool
 (or (and (>= c 97) (<= c 122)) (and (>= c 65) (<= c 90)) (and (>= c 48) (<= c 57)) (= c 95)))
(defn- digit? [c :i64] :bool (and (>= c 48) (<= c 57)))
(defn- digit-end [hay :vector-i64 pos :i64 n :i64] :i64
 (if (and (< pos n) (digit? (vector-at hay pos))) (digit-end hay (+ pos 1) n) pos))
(defn- match-at [p :string i :i64 hay :vector-i64 pos :i64] :bool
 (let [n (string-byte-length p) hn (vector-count hay)]
  (if (>= i n) true
   (let [c (ch p i) next (ch p (+ i 1)) cur (if (< pos hn) (vector-at hay pos) -1)]
    (cond (and (= c 92) (= next 98))
           (let [prev (if (> pos 0) (vector-at hay (- pos 1)) -1)]
            (and (not (= (word? prev) (word? cur))) (match-at p (+ i 2) hay pos)))
          (and (= c 92) (= next 100))
           (if (digit? cur) (if (= (ch p (+ i 2)) 43) (match-at p (+ i 3) hay (digit-end hay pos hn)) (match-at p (+ i 2) hay (+ pos 1))) false)
          (= next 63) (or (and (= c cur) (match-at p (+ i 2) hay (+ pos 1))) (match-at p (+ i 2) hay pos))
          :else (and (= c cur) (match-at p (+ i 1) hay (+ pos 1))))))))
(defn- anchor-end [p :string i :i64] :i64
 (let [c (ch p i) next (ch p (+ i 1))]
  (if (or (< c 0) (= c 92) (= next 63)) i (anchor-end p (+ i 1)))))
(defn- find-match [pattern :string anchor :string haytext :string hay :vector-i64 from :i64] :bool
 (if (> from (string-byte-length haytext)) false
  (let [part (string-substring haytext from (string-byte-length haytext)) found (string-index-of part anchor)]
   (if (< found 0) false
    (let [at (+ from found)]
     (if (match-at pattern 0 hay at) true (find-match pattern anchor haytext hay (+ at 1))))))))
(defn matches? [pattern :string haytext :string hay :vector-i64] :bool
 (let [start (if (and (= (ch pattern 0) 92) (= (ch pattern 1) 98)) 2 0) end (anchor-end pattern start)]
  (and (pattern-valid? pattern 0) (> end start) (find-match pattern (string-substring pattern start end) haytext hay 0))))
(defn- contains-string? [xs :document needle :string i :i64] :bool
 (if (>= i (document-count xs)) false
  (if (and (= (document-kind (item xs i)) :string) (string=? (text (item xs i)) needle)) true (contains-string? xs needle (+ i 1)))))
(defn- plane-index [planes :document prefix :string i :i64] :i64
 (if (>= i (document-count planes)) -1
  (let [p (item planes i) prefixes (getv p :prefixes)]
   (if (and (not (string=? prefix "")) (= (document-kind prefixes) :vector) (contains-string? prefixes prefix 0)) i (plane-index planes prefix (+ i 1))))))
(defn- any-pattern? [ps :document haytext :string hay :vector-i64 i :i64] :bool
 (if (>= i (document-count ps)) false
  (if (matches? (text (item ps i)) haytext hay) true (any-pattern? ps haytext hay (+ i 1)))))
(defn- domain-mask [domains :document haytext :string hay :vector-i64 offset :i64 i :i64 mask :i64] :i64
 (if (>= i (document-count domains)) mask
  (let [patterns (getv (item domains i) :patterns)]
   (domain-mask domains haytext hay offset (+ i 1) (if (any-pattern? patterns haytext hay 0) (bit-or mask (i64-shift-left 1 (+ offset i))) mask)))))
(defn classify [taxonomy :document repo :document] :i64
 (let [planes (getv taxonomy :planes) domains (getv taxonomy :domains) name (text (getv repo :name)) desc (text (getv repo :description))
       dash (string-index-of name "-") prefix (if (< dash 0) "" (string-substring name 0 dash))
       plane (plane-index planes prefix 0) haytext (string-fold-ascii (string-concat name (string-concat " " desc)))
       hay (vector-i64-from-bytes (string-to-utf8 haytext))]
  (domain-mask domains haytext hay (document-count planes) 0 (if (< plane 0) 0 (i64-shift-left 1 plane)))))
(defn- patterns-valid? [xs :document i :i64] :bool
 (if (>= i (document-count xs)) true
  (let [p (item xs i)] (and (= (document-kind p) :string) (pattern-valid? (text p) 0) (patterns-valid? xs (+ i 1))))))
(defn- entries-valid? [xs :document domains :bool i :i64] :bool
 (if (>= i (document-count xs)) true
  (let [d (item xs i) id (getv d :id) topic (getv d :topic) label (getv d :label) data (getv d (if domains :patterns :prefixes))]
   (and (= (document-kind id) :keyword) (= (document-kind topic) :string) (= (document-kind label) :string)
        (= (document-kind data) :vector) (if domains (patterns-valid? data 0) true) (entries-valid? xs domains (+ i 1))))))
(defn taxonomy-valid? [taxonomy :document] :bool
 (let [p (getv taxonomy :planes) d (getv taxonomy :domains)]
  (and (= (document-kind p) :vector) (= (document-kind d) :vector) (<= (+ (document-count p) (document-count d)) 62)
       (entries-valid? p false 0) (entries-valid? d true 0))))
