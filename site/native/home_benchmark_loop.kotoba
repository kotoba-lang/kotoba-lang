(ns site.native.home-benchmark-loop (:export [render])
 (:require [json.core :as json] [site.native.locale-tree :as tree]
           [multiformats.sha256 :as sha] [html-hiccup :as html] [table :as table]))
;; Developer-loop table within the larger, not-yet-ported benchmark section.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- field [d :document k :string] :document (val (document-get d (document-string k))))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- num [d :document] :string
 (let [k (document-kind d) s (document-edn-print d) n (string-byte-length s)]
  (if (or (= k :i64) (= k :f64))
   (if (and (= k :f64) (>= n 2) (string=? (string-substring s (- n 2) n) ".0")) (string-substring s 0 (- n 2)) s) "")))
(defn- stage [d :document] [:option :document]
 (let [status (field d "status") s (text status) n (num (field d "medianMilliseconds"))]
  (cond (not (= (document-kind status) :string)) (option-none-of [:option :document])
        (string=? s "measured") (if (string=? n "") (option-none-of [:option :document]) (option-some-of [:option :document] (document-string (string-concat n " ms"))))
        :else (option-some-of [:option :document] (document-string "N/A")))))
(defn- cell [i :i64 v :document] :document
 (val (table/body-cell-node (record-new [:ref :tbl/cell] true i) v)))
(defn- row [d :document] [:option :document]
 (let [label (field d "label") target (field d "target") stages (field d "stages") loops (field d "loops")
       a (stage (field stages "dependencyResolution")) b (stage (field stages "checkOrAdmission")) c (stage (field stages "cleanBuild"))
       e (stage (field stages "noChangeBuild")) f (stage (field stages "processColdStartupAndExecution")) g (stage (field loops "cleanBuildAndFirstRun"))]
  (if (or (not (= (document-kind label) :string)) (not (= (document-kind target) :string))
          (not (option-some?-of [:option :document] a)) (not (option-some?-of [:option :document] b)) (not (option-some?-of [:option :document] c))
          (not (option-some?-of [:option :document] e)) (not (option-some?-of [:option :document] f)) (not (option-some?-of [:option :document] g)))
   (option-none-of [:option :document])
   (option-some-of [:option :document] (document-vector (document-keyword :tr)
     (cell 0 (document-string (string-concat (text label) (string-concat " · " (text target)))))
     (cell 1 (val a)) (cell 2 (val b)) (cell 3 (val c)) (cell 4 (val e)) (cell 5 (val f)) (cell 6 (val g)))))))
(defn- rows [order :document results :document i :i64 out :document] [:option :document]
 (if (>= i (document-count order)) (option-some-of [:option :document] out)
  (let [key (item order i) r (row (field results (text key)))]
   (if (or (not (= (document-kind key) :string)) (not (option-some?-of [:option :document] r)))
    (option-none-of [:option :document]) (rows order results (+ i 1) (document-vector-conj out (val r)))))))
(defn render [state [:ref :site/catalog] tag :string generator :string report :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "5bb0ff5d9e2f80ca7a76545ead6d0138ab7516f2bb712dd4f059d8b0bb4f5ab2"))
       r-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 report))) "9a61c3b270585b2ef70e30dcd5df7ffff3f4ce5f73bf0860e492f8262fb73ff0"))]
  (if (or (not g-ok) (not r-ok)) (option-none-of [:option :string])
   (let [decoded (json/decode report) d (result-value-of [:result :document :document] decoded (document-null))
         order (field (field d "coverage") "measuredToolchains") results (field d "results")
         body (if (and (= (document-kind order) :vector) (= (document-kind results) :map)) (rows order results 0 (document-vector (document-keyword :tbody))) (option-none-of [:option :document]))]
    (if (or (not (result-ok?-of [:result :document :document] decoded)) (not (option-some?-of [:option :document] body))) (option-none-of [:option :string])
     (let [node (document-vector (document-keyword :div) (document-map :class (document-string "kot-table-scroll"))
            (document-vector (document-keyword :div) (document-map :class (document-string "dads-table"))
             (document-vector (document-keyword :table) (document-map :class (document-string "dads-table__table"))
              (document-vector (document-keyword :caption) (document-string "Dependency-free tiny-project developer-loop medians; N/A means no separate phase was measured"))
              (document-vector (document-keyword :thead) (document-vector (document-keyword :tr)
               (table/header-cell-node (document-string "Toolchain / target") false) (table/header-cell-node (document-string "Resolve") false)
               (table/header-cell-node (document-string "Check") false) (table/header-cell-node (document-string "Clean build") false)
               (table/header-cell-node (document-string "No-change build") false) (table/header-cell-node (document-string "Start + execute") false)
               (table/header-cell-node (document-string "Clean build + first result") false))) (val body))))
           localized (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))]
      (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (option-none-of [:option :string]))))))))
