(ns site.native.source-concat (:export [extract literal data]))
;; Strictly evaluate a pinned (def NAME (str ...)) with string literals and,
;; for app CSS only, the two explicitly supplied dependency values. This is
;; not a general CLJK evaluator and rejects all other forms.
(defn- width [c :i64] :i64 (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4))
(defn- space? [c :i64] :bool (or (= c 32) (= c 9) (= c 10) (= c 13)))
(defn- comment-end [s :string i :i64 n :i64] :i64
 (loop [p i] (if (>= p n) p (let [c (string-code-point-at s p)] (if (= c 10) (+ p 1) (recur (+ p (width c))))))))
(defn- skip [s :string i :i64 n :i64] :i64
 (loop [p i] (if (>= p n) p (let [c (string-code-point-at s p)]
  (cond (space? c) (recur (+ p 1)) (= c 59) (recur (comment-end s (+ p 1) n)) :else p)))))
(defn- quote-end [s :string i :i64 n :i64] :i64
 (loop [p i escaped false]
  (if (>= p n) -1 (let [c (string-code-point-at s p) next (+ p (width c))]
   (cond escaped (recur next false) (= c 92) (recur next true) (= c 34) next :else (recur next false))))))
(defn- starts [s :string i :i64 n :i64 expected :string] :bool
 (let [k (string-byte-length expected)] (if (> (+ i k) n) false (string=? (string-substring s i (+ i k)) expected))))
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn extract [s :string anchor :string theme :string syntax :string deps :bool] [:option :string]
 (let [found (string-index-of s anchor) n (string-byte-length s)]
  (if (< found 0) (none)
   (loop [i (+ found (string-byte-length anchor)) out "" theme-count 0 syntax-count 0]
    (let [p (skip s i n)]
     (if (>= p n) (none)
      (let [c (string-code-point-at s p)]
       (cond (= c 34)
         (let [end (quote-end s (+ p 1) n)]
          (if (< end 0) (none)
           (let [d (document-edn-read (string-substring s p end))]
            (if (= (document-kind d) :string)
             (recur end (string-concat out (option-value-of [:option :string] (document-string-value d) "")) theme-count syntax-count) (none)))))
        (and deps (starts s p n "theme/css"))
         (recur (+ p 9) (string-concat out theme) (+ theme-count 1) syntax-count)
        (and deps (starts s p n "syntax-theme-css"))
         (recur (+ p 16) (string-concat out syntax) theme-count (+ syntax-count 1))
        (= c 41)
         (let [end (skip s (+ p 1) n)]
          (if (and (< end n) (= (string-code-point-at s end) 41)
                   (if deps (and (= theme-count 1) (= syntax-count 1)) (and (= theme-count 0) (= syntax-count 0))))
           (some out) (none)))
        :else (none)))))))))

(defn literal [s :string anchor :string] [:option :string]
 (let [found (string-index-of s anchor) n (string-byte-length s)]
  (if (< found 0) (none)
   (let [i (skip s (+ found (string-byte-length anchor)) n)]
    (if (or (>= i n) (not (= (string-code-point-at s i) 34))) (none)
     (let [end (quote-end s (+ i 1) n)]
      (if (< end 0) (none)
       (let [d (document-edn-read (string-substring s i end)) after (skip s end n)]
        (if (and (= (document-kind d) :string) (< after n) (= (string-code-point-at s after) 41))
         (some (option-value-of [:option :string] (document-string-value d) "")) (none))))))))))

;; Read the single EDN value after an optional def docstring. Comments are
;; discarded outside string literals; no forms are executed.
(defn- collect-data [s :string i :i64 n :i64 opening :i64 closing :i64] [:option :string]
 (loop [p i depth 0 out ""]
  (if (>= p n) (none)
   (let [c (string-code-point-at s p) next (+ p (width c))]
    (cond (= c 59) (recur (comment-end s next n) depth (string-concat out " "))
          (= c 34) (let [end (quote-end s next n)]
            (if (< end 0) (none) (recur end depth (string-concat out (string-substring s p end)))))
          (= c opening) (recur next (+ depth 1) (string-concat out (string-substring s p next)))
          (= c closing) (let [text (string-concat out (string-substring s p next))]
            (if (= depth 1) (some text) (if (< depth 1) (none) (recur next (- depth 1) text))))
          :else (recur next depth (string-concat out (string-substring s p next))))))))
(defn data [s :string anchor :string opening :i64 closing :i64] [:option :document]
 (let [found (string-index-of s anchor) n (string-byte-length s)]
  (if (< found 0) (option-none-of [:option :document])
   (let [first (skip s (+ found (string-byte-length anchor)) n)
         desc-end (if (and (< first n) (= (string-code-point-at s first) 34)) (quote-end s (+ first 1) n) first)
         start (if (< desc-end 0) n (skip s desc-end n))]
    (if (or (>= start n) (not (= (string-code-point-at s start) opening))) (option-none-of [:option :document])
     (let [raw (collect-data s start n opening closing)]
      (if (option-some?-of [:option :string] raw)
       (option-some-of [:option :document] (document-edn-read (option-value-of [:option :string] raw "")))
       (option-none-of [:option :document]))))))))
