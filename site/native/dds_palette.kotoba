(ns site.native.dds-palette (:export [snapshot])
 (:require [multiformats.sha256 :as sha]))
;; Derive the light snapshot directly from pinned DDS CSS, without relying on
;; the separately recorded palette artifact whose source hash is stale.
(defn- some [d :document] [:option :document] (option-some-of [:option :document] d))
(defn- none [] [:option :document] (option-none-of [:option :document]))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- trim [s :string] :string
 (let [n (string-byte-length s)
       start (loop [i 0] (if (and (< i n) (or (= (string-code-point-at s i) 32) (= (string-code-point-at s i) 9))) (recur (+ i 1)) i))
       end (loop [i n] (if (and (> i start) (or (= (string-code-point-at s (- i 1)) 32) (= (string-code-point-at s (- i 1)) 9) (= (string-code-point-at s (- i 1)) 13))) (recur (- i 1)) i))]
  (string-substring s start end)))
(defn- root [s :string] [:option :string]
 (let [i (string-index-of s ":root {")]
  (if (< i 0) (option-none-of [:option :string])
   (let [tail (string-substring s i (string-byte-length s)) e (string-index-of tail "\n}")]
    (if (< e 0) (option-none-of [:option :string]) (option-some-of [:option :string] (string-substring tail 0 e)))))))
(defn- next-literal [source :string previous :string] [:option :document]
 (loop [start 0 best "" best-value ""]
  (if (>= start (string-byte-length source))
   (if (string=? best "") (none) (some (document-map :key (document-string best) :value (document-string best-value))))
   (let [tail (string-substring source start (string-byte-length source)) nl (string-index-of tail "\n")
         end (if (< nl 0) (string-byte-length source) (+ start nl)) line (trim (string-substring source start end))
         colon (string-index-of line ":") semi (string-index-of line ";")]
    (if (and (= (string-index-of line "--color-") 0) (> colon 8) (> semi colon))
     (let [key (string-substring line 0 colon) v (trim (string-substring line (+ colon 1) semi))
           literal (not (= (string-index-of v "var(") 0))
           choose (and literal (> (string-compare key previous) 0) (or (string=? best "") (< (string-compare key best) 0)))]
      (recur (if (< nl 0) end (+ end 1)) (if choose key best) (if choose v best-value)))
     (recur (if (< nl 0) end (+ end 1)) best best-value))))))
(defn- safe? [s :string] :bool
 (not (or (string-contains? s "{") (string-contains? s "}") (string-contains? s ";") (string-contains? s "/*"))))
(defn snapshot [css :string] [:option :string]
 (if (not (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 css))) "86ed3735a051817b93e8bdf281354a112675b3b45b96b61dacb6310cea818ce9"))
  (option-none-of [:option :string])
  (let [r (root css)]
   (if (not (option-some?-of [:option :string] r)) (option-none-of [:option :string])
    (loop [previous "" count 0 out ":root { "]
     (let [item (next-literal (option-value-of [:option :string] r "") previous)]
      (if (not (option-some?-of [:option :document] item))
       (if (= count 156) (option-some-of [:option :string] (string-concat out " }")) (option-none-of [:option :string]))
       (let [d (val item) key (text (val (document-get d :key))) value (text (val (document-get d :value)))]
        (if (or (< (string-byte-length key) 8) (not (safe? key)) (not (safe? value))) (option-none-of [:option :string])
         (recur key (+ count 1) (string-concat out (string-concat (if (= count 0) "" " ")
          (string-concat "--dds-light-" (string-concat (string-substring key 8 (string-byte-length key)) (string-concat ": " (string-concat value ";")))))))))))))))
)
