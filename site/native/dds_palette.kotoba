(ns site.native.dds-palette (:export [snapshot theme-css literal-color])
 (:require [multiformats.sha256 :as sha]))
;; Derive the light snapshot directly from pinned DDS CSS, without relying on
;; the separately recorded palette artifact whose source hash is stale.
(defn- some [d :document] [:option :document] (option-some-of [:option :document] d))
(defn- none [] [:option :document] (option-none-of [:option :document]))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- trim [s :string] :string
 (let [n (string-byte-length s)
       start (loop [i 0] (if (and (< i n) (or (= (string-code-point-at s i) 32) (= (string-code-point-at s i) 9))) (recur (+ i 1)) i))
       end (loop [i n] (if (and (> i start) (or (= (string-code-point-at s (- i 1)) 32) (= (string-code-point-at s (- i 1)) 9) (= (string-code-point-at s (- i 1)) 13))) (recur (- i 1)) i))]
  (string-substring s start end)))
(defn- root [s :string] [:option :string]
 (let [i (string-index-of s ":root {")]
  (if (< i 0) (option-none-of [:option :string])
   (let [tail (string-substring s i (string-byte-length s)) e (string-index-of tail "\n}")]
    (if (< e 0) (option-none-of [:option :string]) (option-some-of [:option :string] (string-substring tail 0 e)))))))
(defn- next-literal [source :string previous :string] [:option :document]
 (loop [start 0 best "" best-value ""]
  (if (>= start (string-byte-length source))
   (if (string=? best "") (none) (some (document-map :key (document-string best) :value (document-string best-value))))
   (let [tail (string-substring source start (string-byte-length source)) nl (string-index-of tail "\n")
         end (if (< nl 0) (string-byte-length source) (+ start nl)) line (trim (string-substring source start end))
         colon (string-index-of line ":") semi (string-index-of line ";")]
    (if (and (= (string-index-of line "--color-") 0) (> colon 8) (> semi colon))
     (let [key (string-substring line 0 colon) v (trim (string-substring line (+ colon 1) semi))
           literal (not (= (string-index-of v "var(") 0))
           choose (and literal (> (string-compare key previous) 0) (or (string=? best "") (< (string-compare key best) 0)))]
      (recur (if (< nl 0) end (+ end 1)) (if choose key best) (if choose v best-value)))
     (recur (if (< nl 0) end (+ end 1)) best best-value))))))
(defn- safe? [s :string] :bool
 (not (or (string-contains? s "{") (string-contains? s "}") (string-contains? s ";") (string-contains? s "/*"))))
(defn snapshot [css :string] [:option :string]
 (if (not (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 css))) "86ed3735a051817b93e8bdf281354a112675b3b45b96b61dacb6310cea818ce9"))
  (option-none-of [:option :string])
  (let [r (root css)]
   (if (not (option-some?-of [:option :string] r)) (option-none-of [:option :string])
    (loop [previous "" count 0 out ":root { "]
     (let [item (next-literal (option-value-of [:option :string] r "") previous)]
      (if (not (option-some?-of [:option :document] item))
       (if (= count 156) (option-some-of [:option :string] (string-concat out " }")) (option-none-of [:option :string]))
       (let [d (val item) key (text (val (document-get d :key))) value (text (val (document-get d :value)))]
        (if (or (< (string-byte-length key) 8) (not (safe? key)) (not (safe? value))) (option-none-of [:option :string])
         (recur key (+ count 1) (string-concat out (string-concat (if (= count 0) "" " ")
          (string-concat "--dds-light-" (string-concat (string-substring key 8 (string-byte-length key)) (string-concat ": " (string-concat value ";")))))))))))))))

)
(defn- last-dash [s :string] :i64
 (loop [i 0 found -1] (if (>= i (string-byte-length s)) found
  (recur (+ i 1) (if (= (string-code-point-at s i) 45) i found)))))
(defn- digits [s :string start :i64] :i64
 (loop [i start n 0]
  (if (>= i (string-byte-length s)) (if (= i start) -1 n)
   (let [c (string-code-point-at s i)]
    (if (or (< c 48) (> c 57)) -1 (recur (+ i 1) (+ (* n 10) (- c 48))))))))
(defn- steps [source :string base :string] :vector-i64
 (loop [start 0 result (vector-alloc 0)]
  (if (>= start (string-byte-length source)) result
   (let [tail (string-substring source start (string-byte-length source)) nl (string-index-of tail "\n")
         end (if (< nl 0) (string-byte-length source) (+ start nl)) line (trim (string-substring source start end))
         colon (string-index-of line ":") semi (string-index-of line ";")
         key (if (> colon 0) (string-substring line 0 colon) "") dash (last-dash key)
         step (if (> dash 0) (digits key (+ dash 1)) -1)
         v (if (and (> colon 0) (> semi colon)) (trim (string-substring line (+ colon 1) semi)) "")
         match (and (> dash 0) (>= step 0) (string=? (string-substring key 0 dash) base) (not (= (string-index-of v "var(") 0)))]
    (recur (if (< nl 0) end (+ end 1)) (if match (vector-conj result step) result))))))
(defn- mirror [source :string key :string] :string
 (let [dash (last-dash key) step (if (> dash 0) (digits key (+ dash 1)) -1)]
  (if (< step 0) key
   (let [base (string-substring key 0 dash) xs (steps source base) n (vector-count xs)
         rank (loop [i 0 c 0] (if (>= i n) c (recur (+ i 1) (if (< (vector-at xs i) step) (+ c 1) c))))
         target (- (- n 1) rank)
         result (loop [i 0 answer step]
          (if (>= i n) answer
           (let [x (vector-at xs i) r (loop [j 0 c 0] (if (>= j n) c (recur (+ j 1) (if (< (vector-at xs j) x) (+ c 1) c))))]
            (recur (+ i 1) (if (= r target) x answer)))))]
    (string-concat base (string-concat "-" (string-from-i64 result)))))))
(defn- light-ref [key :string] :string
 (string-concat "var(--dds-light-" (string-concat (string-substring key 8 (string-byte-length key)) ")")))
(defn- dark-value [source :string key :string value :string] :string
 (cond (string=? key "--color-neutral-white") "var(--dds-light-neutral-solid-gray-900)"
       (string=? key "--color-neutral-black") "var(--dds-light-neutral-white)"
       (= (string-index-of value "rgba(") 0) (string-replace-all value "rgba(0, 0, 0," "rgba(255, 255, 255,")
       :else (light-ref (mirror source key))))
(defn- declarations [source :string dark :bool] [:option :string]
 (loop [previous "" count 0 out ""]
  (let [item (next-literal source previous)]
   (if (not (option-some?-of [:option :document] item))
    (if (= count 156) (option-some-of [:option :string] (string-concat out (if dark " color-scheme: dark;" " color-scheme: light;"))) (option-none-of [:option :string]))
    (let [d (val item) key (text (val (document-get d :key))) value (text (val (document-get d :value)))
          value2 (if dark (dark-value source key value) (light-ref key))]
     (if (or (not (safe? key)) (not (safe? value2))) (option-none-of [:option :string])
      (recur key (+ count 1) (string-concat out (string-concat (if (= count 0) "" " ") (string-concat key (string-concat ": " (string-concat value2 ";"))))))))))))
(defn theme-css [css :string] [:option :string]
 (let [snap (snapshot css) r (root css)]
  (if (or (not (option-some?-of [:option :string] snap)) (not (option-some?-of [:option :string] r))) (option-none-of [:option :string])
   (let [source (option-value-of [:option :string] r "") dark (declarations source true) light (declarations source false)]
    (if (or (not (option-some?-of [:option :string] dark)) (not (option-some?-of [:option :string] light))) (option-none-of [:option :string])
     (let [d (option-value-of [:option :string] dark "") l (option-value-of [:option :string] light "")]
      (option-some-of [:option :string] (string-concat (option-value-of [:option :string] snap "")
       (string-concat "\n:root:root[data-theme=\"dark\"] { " (string-concat d
        (string-concat " }\n:root:root[data-theme=\"light\"] { " (string-concat l
         (string-concat " }\n@media (prefers-color-scheme: dark) { :root:root { " (string-concat d " } }"))))))))))))))

;; Read a literal from the same pinned first-root scan as the palette.
(defn literal-color [css :string wanted :string] [:option :string]
 (if (not (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 css))) "86ed3735a051817b93e8bdf281354a112675b3b45b96b61dacb6310cea818ce9"))
  (option-none-of [:option :string])
  (let [r (root css)]
   (if (not (option-some?-of [:option :string] r)) (option-none-of [:option :string])
    (loop [previous ""]
     (let [item (next-literal (option-value-of [:option :string] r "") previous)]
      (if (not (option-some?-of [:option :document] item)) (option-none-of [:option :string])
       (let [d (val item) key (text (val (document-get d :key))) value (text (val (document-get d :value)))]
        (cond (and (string=? key wanted) (safe? value)) (option-some-of [:option :string] value)
              (> (string-compare key wanted) 0) (option-none-of [:option :string])
              :else (recur key))))))))))
