(ns site.native.locale-rebase (:export [rebase-links]) (:require [site.native.locale-links :as links]))
;; Rebase href/src in bounded Hiccup document fragments. Protected elements and
;; translate=no subtrees retain their original links, matching locales.cljk.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- some [d :document] [:option :document] (option-some-of [:option :document] d))
(defn- none [] [:option :document] (option-none-of [:option :document]))
(defn- kw [d :document] :keyword (option-value-of [:option :keyword] (document-keyword-value d) :missing))
(defn- strval [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- protected? [k :keyword] :bool
 (or (= k :script) (= k :style) (= k :pre) (= k :code) (= k :kbd) (= k :samp) (= k :hiccup/raw)))
(defn- attributes [a :document tag :string base :string] [:option :document]
 (loop [i 0 out a]
  (if (>= i (document-count a)) (some out)
   (let [pair (val (document-map-entry-at a i)) k (val (document-vector-at pair 0)) v (val (document-vector-at pair 1))
         name (kw k)]
    (if (and (or (= name :href) (= name :src)) (= (document-kind v) :string))
     (let [href (links/resolve-link tag base (strval v))]
      (if (option-some?-of [:option :string] href)
       (recur (+ i 1) (document-assoc out k (document-string (option-value-of [:option :string] href "")))) (none)))
     (recur (+ i 1) out))))))
(defn- children [node :document tag :string base :string start :i64 out :document] [:option :document]
 (loop [i start acc out]
  (if (>= i (document-count node)) (some acc)
   (let [v (rebase-links (val (document-vector-at node i)) tag base)]
    (if (option-some?-of [:option :document] v) (recur (+ i 1) (document-vector-conj acc (val v))) (none))))))
(defn- sequence [node :document tag :string base :string] [:option :document]
 (loop [i 0 out "("]
  (if (>= i (document-count node)) (some (document-edn-read (string-concat out ")")))
   (let [v (rebase-links (val (document-list-at node i)) tag base)]
    (if (option-some?-of [:option :document] v)
     (recur (+ i 1) (string-concat out (string-concat (if (= i 0) "" " ") (document-edn-print (val v))))) (none))))))
(defn rebase-links [node :document tag :string base :string] [:option :document]
 (let [kind (document-kind node)]
  (cond (= kind :list) (sequence node tag base)
        (= kind :vector)
        (let [name (val (document-vector-at node 0)) second (val (document-vector-at node 1)) attrs? (= (document-kind second) :map)]
         (if (or (protected? (kw name)) (and attrs? (string=? (strval (val (document-get second :translate))) "no")))
          (some node)
          (if attrs?
           (let [a (attributes second tag base)]
            (if (option-some?-of [:option :document] a) (children node tag base 2 (document-vector name (val a))) (none)))
           (children node tag base 1 (document-vector name)))))
        :else (some node))))
