(ns site.native.home-contents (:export [contents rules])
 (:require [site.native.source-concat :as source] [site.native.locale-tree :as tree]
           [multiformats.sha256 :as sha] [html-hiccup :as html]))
;; Read the authoritative chapter data; do not ship a copied homepage output.
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- span [class :string value :string] :document
 (document-vector (document-keyword :span) (document-map :class (document-string class)) (document-string value)))
(defn- field [d :document key :keyword] :string (text (val (document-get d key))))
(defn- chapters [generator :string] [:option :document]
 (if (not (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "5bb0ff5d9e2f80ca7a76545ead6d0138ab7516f2bb712dd4f059d8b0bb4f5ab2"))) (option-none-of [:option :document])
  (let [d (source/data generator "(def chapters" 91 93)]
   (if (and (option-some?-of [:option :document] d) (= (document-kind (val d)) :vector) (= (document-count (val d)) 5)) d (option-none-of [:option :document])))))
(defn- render [state [:ref :site/catalog] tag :string node :document] [:option :string]
 (let [localized (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))]
  (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (none))))
(defn- item [d :document] :document
 (document-vector (document-keyword :li)
  (document-vector (document-keyword :a) (document-map :class (document-string "kot-contents-link") :href (document-string (field d :href)))
   (span "kot-contents-n" (field d :n)) (span "kot-contents-t" (field d :title)) (span "kot-contents-b" (field d :blurb)))))
(defn- rule [d :document] :document
 (document-vector (document-keyword :div) (document-map :class (document-string "kot-chapter"))
  (span "kot-chapter-n" (field d :n)) (span "kot-chapter-t" (field d :title))))
(defn- render-items [state [:ref :site/catalog] tag :string xs :document rule? :bool] [:option :string]
 (loop [i 0 out ""]
  (if (>= i (document-count xs)) (option-some-of [:option :string] out)
   (let [d (val (document-vector-at xs i)) r (render state tag (if rule? (rule d) (item d)))]
    (if (option-some?-of [:option :string] r) (recur (+ i 1) (string-concat out (option-value-of [:option :string] r ""))) (none))))))
(defn contents [state [:ref :site/catalog] tag :string generator :string] [:option :string]
 (let [xs (chapters generator)
       shell (document-vector (document-keyword :nav) (document-map :class (document-string "kot-contents") :aria-label (document-string "Contents"))
        (document-vector (document-keyword :p) (document-map :class (document-string "kot-contents-label")) (document-string "What follows"))
        (document-vector (document-keyword :ol) (document-map :class (document-string "kot-contents-list")) (document-string "987654321012")))
       frame (render state tag shell)]
  (if (or (not (option-some?-of [:option :document] xs)) (not (option-some?-of [:option :string] frame))) (none)
   (let [items (render-items state tag (val xs) false) f (option-value-of [:option :string] frame "") marker (string-index-of f "987654321012")]
    (if (or (< marker 0) (not (option-some?-of [:option :string] items))) (none)
     (option-some-of [:option :string] (string-concat (string-substring f 0 marker)
      (string-concat (option-value-of [:option :string] items "") (string-substring f (+ marker 12) (string-byte-length f))))))))))
(defn rules [state [:ref :site/catalog] tag :string generator :string] [:option :string]
 (let [xs (chapters generator)] (if (option-some?-of [:option :document] xs) (render-items state tag (val xs) true) (none))))
