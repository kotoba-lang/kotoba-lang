(ns site.native.home-benchmark-compile (:export [render])
 (:require [json.core :as json] [site.native.locale-tree :as tree]
           [multiformats.sha256 :as sha] [html-hiccup :as html] [table :as table]))
;; One benchmark table. The five complete benchmark sections remain separate work.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- get-key [d :document key :string] :document (val (document-get d (document-string key))))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- num [d :document] :string
 (let [k (document-kind d) s (document-edn-print d) n (string-byte-length s)]
  (if (or (= k :i64) (= k :f64))
   (if (and (= k :f64) (>= n 2) (string=? (string-substring s (- n 2) n) ".0")) (string-substring s 0 (- n 2)) s) "")))
(defn- cell [i :i64 value :string] [:option :document]
 (table/body-cell-node (record-new [:ref :tbl/cell] true i) (document-string value)))
(defn- row [results :document key :string label :string target :string] [:option :document]
 (let [d (get-key results key) a (num (get-key d "medianMilliseconds")) b (num (get-key d "p95Milliseconds")) c (num (get-key d "medianRatioToKotoba"))]
  (if (or (not (= (document-kind d) :map)) (string=? a "") (string=? b "") (string=? c ""))
   (option-none-of [:option :document])
   (let [x (cell 0 label) y (cell 1 target) z (cell 2 (string-concat a " ms")) w (cell 3 (string-concat b " ms")) q (cell 4 (string-concat c "× Kotoba"))]
    (if (and (option-some?-of [:option :document] x) (option-some?-of [:option :document] y) (option-some?-of [:option :document] z) (option-some?-of [:option :document] w) (option-some?-of [:option :document] q))
     (option-some-of [:option :document] (document-vector (document-keyword :tr) (val x) (val y) (val z) (val w) (val q)))
     (option-none-of [:option :document]))))))
(defn render [state [:ref :site/catalog] tag :string generator :string report :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "5bb0ff5d9e2f80ca7a76545ead6d0138ab7516f2bb712dd4f059d8b0bb4f5ab2"))
       r-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 report))) "e86a8b09b9c76ab3183e68fa9aff1c227b639157ef0901d29824b324412f205f"))]
  (if (or (not g-ok) (not r-ok)) (option-none-of [:option :string])
   (let [decoded (json/decode report) d (result-value-of [:result :document :document] decoded (document-null)) results (get-key d "results")
       a (row results "kotoba" "Kotoba" "WebAssembly") b (row results "rust" "Rust / rustc" "WebAssembly")
       c (row results "c" "C / Clang" "WebAssembly") e (row results "jvm" "JVM / javac" "JVM class")]
  (if (or (not (result-ok?-of [:result :document :document] decoded)) (not (= (document-kind results) :map))
          (not (option-some?-of [:option :document] a)) (not (option-some?-of [:option :document] b)) (not (option-some?-of [:option :document] c)) (not (option-some?-of [:option :document] e))) (option-none-of [:option :string])
   (let [node (document-vector (document-keyword :div) (document-map :class (document-string "kot-table-scroll"))
         (document-vector (document-keyword :div) (document-map :class (document-string "dads-table"))
          (document-vector (document-keyword :table) (document-map :class (document-string "dads-table__table"))
           (document-vector (document-keyword :caption) (document-string "Tiny source-to-artifact process-cold build measurement"))
           (document-vector (document-keyword :thead) (document-vector (document-keyword :tr)
            (table/header-cell-node (document-string "Toolchain") false) (table/header-cell-node (document-string "Output") false)
            (table/header-cell-node (document-string "Median") false) (table/header-cell-node (document-string "p95") false)
            (table/header-cell-node (document-string "Relative elapsed time") false)))
           (document-vector (document-keyword :tbody) (val a) (val b) (val c) (val e)))))
         localized (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))]
    (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (option-none-of [:option :string]))))))))
