(ns site.native.home-benchmark-runtime-pairs (:export [render])
 (:require [json.core :as json] [site.native.locale-tree :as tree] [multiformats.sha256 :as sha]
           [html-hiccup :as html] [table :as table]))
;; The pinned report's six-by-five runtime comparison table, not a general chart implementation.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- field [d :document k :string] :document (val (document-get d (document-string k))))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- integer [d :document] :i64 (option-value-of [:option :i64] (document-i64-value d) 0))
(defn- number [d :document] :f64
 (if (= (document-kind d) :i64) (i64-to-f64-rounded (integer d)) (option-value-of [:option :f64] (document-f64-value d) 0.0)))
(defn- fixed [x :f64 scale :i64 digits :i64] :string
 (let [v (f64-to-i64-truncating (f64-add (f64-mul x (i64-to-f64-rounded scale)) 0.5)) whole (quot v scale) frac (rem v scale)]
  (string-concat (string-from-i64 whole) (string-concat "." (string-concat (if (and (= digits 3) (< frac 100)) "0" "")
   (string-concat (if (and (>= digits 2) (< frac 10)) "0" "") (string-from-i64 frac)))))))
(defn- find-pair [pairs :document domain :string comparator :string i :i64] :document
 (if (>= i (document-count pairs)) (document-null)
  (let [d (item pairs i)]
   (if (and (string=? (text (field d "domain")) domain) (string=? (text (field d "comparator")) comparator)) d
    (find-pair pairs domain comparator (+ i 1))))))
(defn- max-arm [pairs :document negative :bool] :f64
 (loop [i 0 top 1.0]
  (if (>= i (document-count pairs)) top
   (let [v (f64-mul 100.0 (number (field (item pairs i) "improvement"))) x (if negative (f64-neg v) v)]
    (recur (+ i 1) (if (f64-gt x top) x top))))))
(defn- reasons [xs :document i :i64 out :string] :string
 (if (>= i (document-count xs)) out
  (reasons xs (+ i 1) (string-concat out (string-concat (if (= i 0) "" ", ") (text (item xs i)))))))
(defn- comparison [p :document gain :f64 loss :f64] :document
 (let [v (f64-mul 100.0 (number (field p "improvement"))) neg (f64-lt v 0.0) abs (if neg (f64-neg v) v)
       span (if neg loss gain) raw (f64-mul 100.0 (f64-div abs span)) w (if (f64-gt raw 100.0) 100.0 raw)
       qualified (option-value-of [:option :bool] (document-bool-value (field p "qualified")) false)
       title (if qualified (string-concat "Passes perfgate; qualified in " (string-concat (string-from-i64 (integer (field p "qualifiedRuns")))
               (string-concat " of " (string-concat (string-from-i64 (integer (field p "runs"))) " runs"))))
              (string-concat "Not qualified: " (reasons (field p "reasons") 0 "")))
       attrs (if qualified (document-map :class (document-string "kot-dv") :data-sign (document-string (if neg "neg" "pos")) :data-qualified (document-string "1") :title (document-string title))
              (document-map :class (document-string "kot-dv") :data-sign (document-string (if neg "neg" "pos")) :title (document-string title)))
       display (string-concat (if neg "-" (if (f64-gt v 0.0) "+" "")) (string-concat (fixed abs 10 1) "%"))
       value (if qualified (document-vector (document-keyword :span) (document-map :class (document-string "kot-dv-value")) (document-string display)
               (document-vector (document-keyword :span) (document-map :class (document-string "kot-dv-tick") :aria-hidden (document-string "true")) (document-string "✓")))
              (document-vector (document-keyword :span) (document-map :class (document-string "kot-dv-value")) (document-string display)))]
  (document-vector (document-keyword :span) attrs
   (document-vector (document-keyword :span) (document-map :class (document-string "kot-dv-track"))
    (document-vector (document-keyword :span) (document-map :class (document-string "kot-dv-fill") :style (document-string (string-concat "--w:" (string-concat (fixed w 1000 3) "%")))))) value)))
(defn- cells [pairs :document cs :document domain :string gain :f64 loss :f64 i :i64 out :document] [:option :document]
 (if (>= i (document-count cs)) (option-some-of [:option :document] out)
  (let [c (item cs i) id (field c "id") p (find-pair pairs domain (text id) 0)]
   (if (or (not (= (document-kind id) :string)) (not (= (document-kind p) :map))
           (not (or (= (document-kind (field p "improvement")) :i64) (= (document-kind (field p "improvement")) :f64)))) (option-none-of [:option :document])
    (cells pairs cs domain gain loss (+ i 1) (document-vector-conj out (document-vector (document-keyword :td) (comparison p gain loss))))))))
(defn- rows-html [state [:ref :site/catalog] tag :string domains :document pairs :document cs :document gain :f64 loss :f64 i :i64 out :string] [:option :string]
 (if (>= i (document-count domains)) (option-some-of [:option :string] out)
  (let [d (item domains i) id (field d "id") label (field d "label")
        r (cells pairs cs (text id) gain loss 0 (document-vector (document-keyword :tr) (document-vector (document-keyword :th)
             (document-map :class (document-string "dads-table__row-header") :scope (document-string "row")) label)))
        localized (if (and (option-some?-of [:option :document] r) (not (string=? tag "en"))) (tree/map-indexed state (val r)) r)
        rendered (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (option-none-of [:option :string]))]
   (if (or (not (= (document-kind id) :string)) (not (= (document-kind label) :string)) (not (option-some?-of [:option :string] rendered))) (option-none-of [:option :string])
    (rows-html state tag domains pairs cs gain loss (+ i 1) (string-concat out (option-value-of [:option :string] rendered "")))))))
(defn- headers [cs :document i :i64 out :document] [:option :document]
 (if (>= i (document-count cs)) (option-some-of [:option :document] out)
  (let [label (field (item cs i) "label")]
   (if (not (= (document-kind label) :string)) (option-none-of [:option :document])
    (headers cs (+ i 1) (document-vector-conj out (table/header-cell-node label false)))))))
(defn render [state [:ref :site/catalog] tag :string generator :string report :string chart :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67"))
       r-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 report))) "33f6e504389f03f0d3f5f91a68d157f83a86a5366acf21311e6b7494783effe9"))
       c-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 chart))) "651e9bc2bfc31b15493f00c05d2aeaaddd70e9dbec3be55846a389dccb6e9a20"))]
  (if (or (not g-ok) (not r-ok) (not c-ok)) (option-none-of [:option :string])
   (let [decoded (json/decode report) d (result-value-of [:result :document :document] decoded (document-null)) domains (field d "domains") pairs (field d "pairs") cs (field d "comparators") date (text (field d "generatedAt"))
         head (headers cs 0 (document-vector (document-keyword :tr) (table/header-cell-node (document-string "Workload") false)))
         body (rows-html state tag domains pairs cs (max-arm pairs false) (max-arm pairs true) 0 "")]
    (if (or (not (result-ok?-of [:result :document :document] decoded)) (< (string-byte-length date) 10)
            (not (= (document-kind domains) :vector)) (not (= (document-kind pairs) :vector)) (not (= (document-kind cs) :vector))
            (not (option-some?-of [:option :document] head)) (not (option-some?-of [:option :string] body))) (option-none-of [:option :string])
     (let [caption (string-concat "Amu native vs each comparator, " (string-concat (string-substring date 0 10) ", host-qualified; ✓ = passes perfgate"))
           node (document-vector (document-keyword :div) (document-map :class (document-string "kot-table-scroll kot-chart"))
            (document-vector (document-keyword :div) (document-map :class (document-string "dads-table"))
             (document-vector (document-keyword :table) (document-map :class (document-string "dads-table__table"))
              (document-vector (document-keyword :caption) (document-string caption))
              (document-vector (document-keyword :thead) (val head)) (document-vector (document-keyword :tbody) (document-string "987654321013")))))
           localized (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))]
      (let [frame (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (option-none-of [:option :string]))
            raw (option-value-of [:option :string] frame "") marker (string-index-of raw "987654321013")]
       (if (or (not (option-some?-of [:option :string] frame)) (< marker 0)) (option-none-of [:option :string])
        (option-some-of [:option :string] (string-concat (string-substring raw 0 marker) (string-concat (option-value-of [:option :string] body "")
          (string-substring raw (+ marker 12) (string-byte-length raw)))))))))))))
