(ns site.native.home-benchmark-runtime-section (:export [render])
 (:schemas {:site/runtime-context [:record :site/runtime-context [[:runs :i64] [:pairs :i64] [:qualified :i64] [:stable :i64] [:verdict :string] [:commit :string] [:host :string] [:gain :string] [:loss :string]]]})
 (:require [json.core :as json] [site.native.source-concat :as source] [site.native.home-section :as home]
           [site.native.locale-tree :as tree] [site.native.locale-rebase :as rebase] [multiformats.sha256 :as sha] [html-hiccup :as html]
           [site.native.home-benchmark-runtime-charts :as charts] [site.native.home-benchmark-runtime-pairs :as pairs]
           [site.native.home-benchmark-optimization :as optimization]))
;; The dated runtime subsection, assembled from its pinned source and report.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- field [d :document k :string] :document (val (document-get d (document-string k))))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- arg [d :document i :i64] :document (val (document-list-at d i)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- integer [d :document] :i64 (option-value-of [:option :i64] (document-i64-value d) -1))
(defn- number [d :document] :f64 (if (= (document-kind d) :i64) (i64-to-f64-rounded (integer d)) (option-value-of [:option :f64] (document-f64-value d) 0.0)))
(defn- max-arm [ps :document neg :bool] :f64
 (loop [i 0 m 1.0] (if (>= i (document-count ps)) m (let [p (field (item ps i) "improvement") v (f64-mul 100.0 (number p)) x (if neg (f64-neg v) v)] (recur (+ i 1) (if (f64-gt x m) x m))))))
(defn- round0 [v :f64] :string (string-from-i64 (f64-to-i64-truncating (f64-add v 0.5))))
(defn- context [s :string] [:option [:ref :site/runtime-context]]
 (let [r (json/decode s) d (result-value-of [:result :document :document] r (document-null)) score (field d "score") speed (field d "speedQualification") ps (field d "pairs")
       runs (integer (field score "runs")) count (integer (field score "totalPairs")) qualified (integer (field score "qualifiedPairs")) stable (integer (field score "stableQualifiedPairs"))
       verdict (field speed "verdict") commit (field d "compilerCommit") host (field d "host")]
  (if (or (not (result-ok?-of [:result :document :document] r)) (not (= (document-kind ps) :vector)) (not (= (document-count ps) 30))
          (< runs 1) (< count 1) (< qualified 0) (< stable 0) (not (= (document-kind verdict) :string))
          (not (= (document-kind commit) :string)) (< (string-byte-length (text commit)) 12) (not (= (document-kind host) :string)))
   (option-none-of [:option [:ref :site/runtime-context]])
   (option-some-of [:option [:ref :site/runtime-context]] (record-new [:ref :site/runtime-context] runs count qualified stable (text verdict) (string-substring (text commit) 0 12) (text host) (round0 (max-arm ps false)) (round0 (max-arm ps true)))))))
(defn- none [] [:option :document] (option-none-of [:option :document]))
(defn- some [d :document] [:option :document] (option-some-of [:option :document] d))
(defn- no-text [] [:option :string] (option-none-of [:option :string]))
(defn- yes-text [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- out [o [:option :string]] :string (option-value-of [:option :string] o ""))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b)) (yes-text (string-concat (out a) (out b))) (no-text)))
(defn- symbol-value [s :string c [:ref :site/runtime-context]] :document
 (cond (string=? s "runtime-score") (document-null) :else (document-edn-read s)))
(defn- list-build [d :document i :i64 c [:ref :site/runtime-context] out :string] [:option :document]
 (if (>= i (document-count d)) (some (document-edn-read (string-concat out ")")))
  (let [v (transform (arg d i) c)] (if (option-some?-of [:option :document] v) (list-build d (+ i 1) c (string-concat out (string-concat (if (= i 0) "" " ") (document-edn-print (val v))))) (none)))))
(defn- vector-build [d :document i :i64 c [:ref :site/runtime-context] out :document] [:option :document]
 (if (>= i (document-count d)) (some out) (let [v (transform (item d i) c)] (if (option-some?-of [:option :document] v) (vector-build d (+ i 1) c (document-vector-conj out (val v))) (none)))))
(defn- string-build [d :document i :i64 c [:ref :site/runtime-context] out :string] [:option :document]
 (if (>= i (document-count d)) (some (document-string out))
  (let [v (transform (arg d i) c) x (val v) k (document-kind x)]
   (if (and (option-some?-of [:option :document] v) (or (= k :string) (= k :i64)))
    (string-build d (+ i 1) c (string-concat out (if (= k :string) (text x) (string-from-i64 (integer x))))) (none)))))
(defn- transform [d :document c [:ref :site/runtime-context]] [:option :document]
 (let [k (document-kind d)]
  (cond (= k :symbol) (some (symbol-value (document-edn-print d) c))
        (= k :vector) (vector-build d 0 c (document-vector))
        (= k :list)
         (let [head (document-edn-print (arg d 0)) whole (document-edn-print d)]
          (cond (string=? whole "(:runs runtime-score)") (some (document-i64 (get c :runs)))
                (string=? whole "(:totalPairs runtime-score)") (some (document-i64 (get c :pairs)))
                (string=? whole "(:qualifiedPairs runtime-score)") (some (document-i64 (get c :qualified)))
                (string=? whole "(:host runtime-benchmark)") (some (document-string (get c :host)))
                (string=? whole "(name (:verdict speed))") (some (document-string (get c :verdict)))
                (string=? whole "(subs (:compilerCommit runtime-benchmark) 0 12)") (some (document-string (get c :commit)))
                (string=? whole "(.toFixed improvement-gain 0)") (some (document-string (get c :gain)))
                (string=? whole "(.toFixed improvement-loss 0)") (some (document-string (get c :loss)))
                (string=? head "if-let") (if (> (get c :runs) 1) (some (document-string (string-concat " (median of " (string-concat (string-from-i64 (get c :runs)) (string-concat "; " (string-concat (string-from-i64 (get c :stable)) " in every run)")))))) (some (document-string " (one run)")))
                (string=? head "str") (string-build d 1 c "")
                :else (list-build d 0 c "(")))
        (or (= k :string) (= k :i64) (= k :keyword) (= k :map)) (some d)
        :else (none))))
(defn- fragment [state [:ref :site/catalog] tag :string src :string c [:ref :site/runtime-context] marker :string opening :i64 closing :i64] [:option :string]
 (let [pos (string-index-of src marker) tail (if (< pos 0) "" (string-substring src pos (string-byte-length src)))
       form (source/data (string-concat "~FORM~" tail) "~FORM~" opening closing)
       prepared (if (option-some?-of [:option :document] form) (transform (val form) c) (none))
       node (if (option-some?-of [:option :document] prepared) (home/evaluate (val prepared)) (none))
       local (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)
       rebased (if (and (option-some?-of [:option :document] local) (not (string=? tag "en"))) (rebase/rebase-links (val local) tag "/") local)]
  (if (option-some?-of [:option :document] rebased) (html/render (val rebased) 0) (no-text))))
(defn render [state [:ref :site/catalog] tag :string generator :string report :string chart :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "5bb0ff5d9e2f80ca7a76545ead6d0138ab7516f2bb712dd4f059d8b0bb4f5ab2"))
       r-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 report))) "33f6e504389f03f0d3f5f91a68d157f83a86a5366acf21311e6b7494783effe9"))
       ctx (if r-ok (context report) (option-none-of [:option [:ref :site/runtime-context]])) start (string-index-of generator "(dds/heading 3 \"How long each native workload actually takes\"")
       stop (string-index-of generator "(dds/heading 3 \"Compiler startup, four toolchains\"")]
  (if (or (not g-ok) (not r-ok) (not (option-some?-of [:option [:ref :site/runtime-context]] ctx)) (< start 0) (<= stop start)) (no-text)
   (let [c (option-value-of [:option [:ref :site/runtime-context]] ctx (record-new [:ref :site/runtime-context] 0 0 0 0 "" "" "" "" "")) src (string-substring generator start stop)
         a (fragment state tag src c "(dds/heading 3 \"How long each native workload actually takes\"" 40 41)
         b (append a (fragment state tag src c "[:p\n      \"The grid below reports" 91 93))
         d (append b (charts/render state tag generator report chart))
         e (append d (fragment state tag src c "(caption\n      (str \"Median milliseconds over" 40 41))
         f (append e (fragment state tag src c "(dds/heading 3 \"Every runtime pair, win or loss\"" 40 41))
         g (append f (fragment state tag src c "[:p\n      \"The bounded claim is all-or-nothing" 91 93))
         h (append g (pairs/render state tag generator report chart))
         i (append h (fragment state tag src c "(caption\n      (str \"Each cell is a bar" 40 41))
         j (append i (fragment state tag src c "(caption (str (:qualifiedPairs runtime-score)" 40 41))]
    (append j (optimization/render state tag generator))))))
