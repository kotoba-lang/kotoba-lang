(ns site.native.home-benchmark-cards (:export [compose])
 (:require [multiformats.sha256 :as sha]))
;; Inputs and manifest must come from a trusted, immutable build; this composes one grid, not the full benchmark.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- field [d :document k :keyword] :string (option-value-of [:option :string] (document-string-value (val (document-get d k))) ""))
(defn- locale? [s :string] :bool
 (or (string=? s "en") (string=? s "ar") (string=? s "arz") (string=? s "bn") (string=? s "de") (string=? s "es") (string=? s "fr") (string=? s "hi") (string=? s "id") (string=? s "ja") (string=? s "ko") (string=? s "mr") (string=? s "pcm") (string=? s "pt") (string=? s "ru") (string=? s "ur") (string=? s "zh-Hans")))
(defn- valid-card? [s :string digest :string] :bool
 (let [n (string-byte-length s) prefix "<div class=\"dds-ext-card\">" end "</div>"]
  (and (>= n (+ (string-byte-length prefix) (string-byte-length end))) (= (string-byte-length digest) 64)
       (string=? (string-substring s 0 (string-byte-length prefix)) prefix)
       (string=? (string-substring s (- n (string-byte-length end)) n) end)
       (< (string-index-of s "KOTOBA_") 0) (< (string-index-of s "TEST BENCHMARK") 0)
       (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) digest)))))
(defn compose [tag :string manifest :string a :string b :string c :string d :string e :string f :string] [:option :string]
 (let [m (document-edn-read manifest)]
  (if (or (not (locale? tag)) (not (= (document-kind m) :map)) (not (string=? (field m :tag) tag))
          (not (valid-card? a (field m :startup))) (not (valid-card? b (field m :coverage)))
          (not (valid-card? c (field m :speed))) (not (valid-card? d (field m :loop)))
          (not (valid-card? e (field m :scaling))) (not (valid-card? f (field m :domain)))) (option-none-of [:option :string])
   (option-some-of [:option :string] (string-concat "<div class=\"dds-ext-grid\" style=\"--dds-ext-grid-min:16rem;\">"
    (string-concat a (string-concat b (string-concat c (string-concat d (string-concat e (string-concat f "</div>")))))))))))
