(ns site.native.header-inline (:export [render-inline])
 (:require [site.native.locale-tree :as tree] [site.native.locale-rebase :as rebase]
           [html-hiccup :as html] [button :as button]))
;; Two shared header navigation controls; the remaining header is not emitted.
(defn- value [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- link [label :string href :string] [:option :document]
 (button/node (record-new [:ref :btn/opts] "text" "sm" href "" "" false false (document-vector))
              (document-string label) (document-map)))
(defn render-inline [state [:ref :site/catalog] tag :string base :string home :bool] [:option :string]
 (let [root (if home "" "/") a (link "Docs" (string-concat root "#docs"))
       b (link "Play" (string-concat root "#play"))]
  (if (and (option-some?-of [:option :document] a) (option-some?-of [:option :document] b))
   (let [raw (document-vector (document-keyword :span) (document-map :class (document-string "kot-nav-inline")) (value a) (value b))
         translated (if (string=? tag "en") (option-some-of [:option :document] raw) (tree/map-indexed state raw))]
    (if (option-some?-of [:option :document] translated)
     (let [mapped (if (string=? tag "en") translated (rebase/rebase-links (value translated) tag base))]
      (if (option-some?-of [:option :document] mapped) (html/render (value mapped) 0) (option-none-of [:option :string])))
     (option-none-of [:option :string]))) (option-none-of [:option :string]))))
