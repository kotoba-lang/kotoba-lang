(ns site.native.start-card-metadata (:export [render])
 (:require [site.native.source-concat :as source] [multiformats.sha256 :as sha] [html-hiccup :as html]))
;; The standalone start/ta/uk pages use source copy, not locale catalogs.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- field [d :document k :keyword] :string (if (= (document-kind d) :map) (text (val (document-get d k))) ""))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
  (some (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (none)))
(defn- pick [items :document tag :string i :i64] :document
 (if (>= i (document-count items)) (document-null)
  (let [d (val (document-vector-at items i))] (if (string=? (field d :lang) tag) d (pick items tag (+ i 1))))))
(defn- node [d :document] [:option :string] (html/render d 0))
(defn- meta [key :keyword name :string value :string] [:option :string]
 (node (document-vector (document-keyword :meta) (document-map key (document-string name) :content (document-string value)))))
(defn- alternate [mime :string url :string title :string] [:option :string]
 (node (document-vector (document-keyword :link) (document-map :rel (document-string "alternate") :type (document-string mime)
  :href (document-string url) :title (document-string title)))))
(defn- jsonld [] :string "{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://kotoba-lang.org/#website\",\"url\":\"https://kotoba-lang.org/\",\"name\":\"Kotoba\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"Kotoba Foundation\"},\"inLanguage\":[\"en\",\"zh-Hans\",\"hi\",\"es\",\"ar\",\"fr\",\"bn\",\"pt\",\"id\",\"ur\",\"ru\",\"de\",\"ja\",\"ko\",\"pcm\",\"arz\",\"mr\",\"ta\",\"uk\"]}")
(defn render [tag :string generator :string] [:option :string]
 (let [valid (or (string=? tag "en") (string=? tag "ta") (string=? tag "uk"))
       pinned (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "5bb0ff5d9e2f80ca7a76545ead6d0138ab7516f2bb712dd4f059d8b0bb4f5ab2"))
       english (source/data generator "(def start-card-en" 123 125) translated (source/data generator "(def start-card-locales" 91 93)
       copy (if (string=? tag "en") (val english) (pick (val translated) tag 0))
       title (string-concat "Kotoba — " (field copy :title)) description (field copy :program-sentence)
       path (cond (string=? tag "en") "/start/" (string=? tag "ta") "/ta/" :else "/uk/")
       url (string-concat "https://kotoba-lang.org" path) locale (cond (string=? tag "en") "en_US" (string=? tag "ta") "ta_IN" :else "uk_UA")]
  (if (or (not valid) (not pinned) (not (= (document-kind copy) :map)) (string=? description "") (string=? (field copy :title) "")) (none)
   (let [title-node (node (document-vector (document-keyword :title) (document-string title)))
         a (append title-node (meta :name "description" description))
         b (append a (node (document-vector (document-keyword :link) (document-map :rel (document-string "canonical") :href (document-string url)))))
         c (append b (meta :property "og:site_name" "Kotoba"))
         d (append c (node (document-vector (document-keyword :script) (document-map :type (document-string "application/ld+json")) (document-string (jsonld)))))
         e (append d (meta :property "og:type" "website")) f (append e (meta :property "og:url" url))
         g (append f (meta :property "og:title" title)) h (append g (meta :property "og:description" description))
         i (append h (meta :property "og:image" "https://kotoba-lang.org/kotoba-og-card.png"))
         j (append i (meta :property "og:image:width" "1200")) k (append j (meta :property "og:image:height" "630"))
         l (append k (meta :property "og:image:alt" "Safe code. Built for machine speed."))
         m (append l (alternate "text/markdown" "https://kotoba-lang.org/agent-quickstart.md" "AI agent quickstart"))
         n (append m (alternate "text/plain" "https://kotoba-lang.org/llms.txt" "LLM documentation index"))
         o (append n (meta :name "twitter:title" title)) p (append o (meta :name "twitter:description" description))
         q (append p (meta :property "og:locale" locale)) r (append q (meta :name "twitter:card" "summary_large_image"))]
    (append r (meta :name "twitter:image" "https://kotoba-lang.org/kotoba-og-card.png"))))))
