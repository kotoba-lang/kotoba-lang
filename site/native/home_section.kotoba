(ns site.native.home-section (:export [render render-section render-typed render-architecture render-proof render-defaults render-release render-sponsor render-source render-why-fast check-ratios evaluate])
 (:require [site.native.source-concat :as source] [site.native.locale-tree :as tree] [site.native.locale-rebase :as rebase]
           [multiformats.sha256 :as sha] [html-hiccup :as html] [components :as dds]))
;; Bounded interpreter for data-only homepage forms. Unknown calls fail closed.
(defn- none [] [:option :document] (option-none-of [:option :document]))
(defn- some [d :document] [:option :document] (option-some-of [:option :document] d))
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- at [d :document i :i64] :document (val (document-list-at d i)))
(defn- vget [d :document i :i64] :document (val (document-vector-at d i)))
(defn- field [d :document k :keyword] :document (val (document-get d k)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- integer [d :document] :i64 (option-value-of [:option :i64] (document-i64-value d) 0))
(defn- children [d :document i :i64 out :document list? :bool] [:option :document]
 (if (>= i (document-count d)) (some out)
  (let [child (evaluate (if list? (at d i) (vget d i)))]
   (if (option-some?-of [:option :document] child) (children d (+ i 1) (document-vector-conj out (val child)) list?) (none)))))
(defn- call [d :document] [:option :document]
 (let [head (at d 0) name (document-edn-print head) n (document-count d)]
  (if (not (= (document-kind head) :symbol)) (none)
   (cond
    (string=? name "code")
     (if (= n 2) (children d 1 (document-vector (document-keyword :code) (document-map :class (document-string "kot-code"))) true) (none))
    (string=? name "apply")
     (let [target (document-edn-print (at d 1)) opts (at d 2) title (field opts :title) id (field opts :id)
           first (evaluate (at d 3)) second (evaluate (at d 4)) rest (at d 5)]
      (if (or (not (= n 6)) (not (string=? target "dds/section")) (not (= (document-kind opts) :map))
              (not (= (document-kind title) :string)) (not (= (document-kind id) :string))
              (not (option-some?-of [:option :document] first)) (not (option-some?-of [:option :document] second))
              (not (= (document-kind rest) :vector))) (none)
       (children rest 0 (document-vector (document-keyword :section) (document-map :class (document-string "dds-ext-section") :id id)
                          (dds/heading-node 2 title "32" "") (val first) (val second)) false)))
    (string=? name "caption") (children d 1 (document-vector (document-keyword :p) (document-map :class (document-string "kot-muted kot-caption"))) true)
    (string=? name "external-link")
     (let [href (at d 1) label (evaluate (at d 2))]
      (if (or (not (= n 3)) (not (= (document-kind href) :string)) (not (option-some?-of [:option :document] label))) (none)
       (some (document-vector (document-keyword :a) (document-map :class (document-string "kot-link") :href href :rel (document-string "noreferrer")) (val label)))))
    (string=? name "card") (children d 1 (document-vector (document-keyword :div) (document-map :class (document-string "dds-ext-card"))) true)
    (string=? name "dds/grid")
     (let [opts (at d 1) min (field opts :min)]
      (if (or (not (= (document-kind opts) :map)) (not (= (document-kind min) :string))) (none)
       (children d 2 (document-vector (document-keyword :div) (document-map :class (document-string "dds-ext-grid") :style (document-map :--dds-ext-grid-min min))) true)))
    (string=? name "dds/chip-label")
     (let [label (evaluate (at d 1)) opts (if (= n 2) (document-map) (at d 2))
           color (if (= n 2) "blue" (text (field opts :color)))]
      (if (or (not (or (= n 2) (= n 3))) (not (= (document-kind opts) :map))
              (and (= n 3) (not (= (document-count opts) 1))) (not (or (string=? color "blue") (string=? color "gray")))
              (not (option-some?-of [:option :document] label))) (none)
       (some (document-vector (document-keyword :span) (document-map :class (document-string "dads-chip-label") :data-style (document-string "text") :data-color (document-string color)) (val label)))))
    (string=? name "dds/heading")
     (let [level (integer (at d 1)) label (evaluate (at d 2)) opts (at d 3) size (text (field opts :size))]
      (if (or (not (= n 4)) (< level 1) (> level 6) (not (option-some?-of [:option :document] label)) (not (= (document-kind opts) :map))) (none)
       (some (dds/heading-node level (val label) size ""))))
    (string=? name "dds/section")
     (let [opts (at d 1) title (field opts :title) id (field opts :id)]
      (if (or (not (= (document-kind opts) :map)) (not (= (document-kind title) :string))
              (not (or (= (document-kind id) :string) (= (document-kind id) :null)))) (none)
       (let [attrs (if (= (document-kind id) :string) (document-map :class (document-string "dds-ext-section") :id id) (document-map :class (document-string "dds-ext-section")))]
        (children d 2 (document-vector (document-keyword :section) attrs (dds/heading-node 2 title "32" "")) true))))
    :else (none)))))
(defn evaluate [d :document] [:option :document]
 (let [kind (document-kind d)]
  (cond (= kind :vector) (children d 0 (document-vector) false)
        (= kind :list) (call d)
        (or (= kind :map) (= kind :keyword) (= kind :string) (= kind :i64)) (some d)
        :else (none))))
(defn render-section [state [:ref :site/catalog] tag :string generator :string which :string] [:option :string]
 (if (or (not (or (string=? which "why") (string=? which "what") (string=? which "docs") (string=? which "roadmap") (string=? which "community") (string=? which "cloud")))
         (not (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67")))) (option-none-of [:option :string])
  (let [anchor (cond (string=? which "why") "(defn why-section []" (string=? which "what") "(defn what-section []" (string=? which "docs") "(defn developer-section []" (string=? which "roadmap") "(defn roadmap-section []" (string=? which "community") "(defn community-section []" :else "(defn blog-cloud-section []")
        data (source/data generator anchor 40 41)
        node (if (option-some?-of [:option :document] data) (evaluate (val data)) (none))
        localized (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)]
   (if (option-some?-of [:option :document] localized)
    (let [rebased (if (string=? tag "en") localized (rebase/rebase-links (val localized) tag "/"))]
     (if (option-some?-of [:option :document] rebased) (html/render (val rebased) 0) (option-none-of [:option :string]))) (option-none-of [:option :string])))))
(defn render [state [:ref :site/catalog] tag :string generator :string] [:option :string]
 (render-section state tag generator "why"))

;; This section uses one numeric field from its separately pinned authority.
;; Substitute only the exact source expression, then evaluate the bounded tree.
(defn- digits-end [s :string i :i64] :i64
 (if (>= i (string-byte-length s)) i
  (let [c (string-code-point-at s i)]
   (if (and (>= c 48) (<= c 57)) (digits-end s (+ i 1)) i))))
(defn render-typed [state [:ref :site/catalog] tag :string generator :string authority :string] [:option :string]
 (let [generator-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67"))
       authority-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 authority))) "694be2a33375a6e63dee64a31b3f59dad6c1595d7d860393eb30153002d7eba6"))
       field-marker ":compiler-wire-id " field-pos (string-index-of authority field-marker)
       expr "(str (:compiler-wire-id typed-eval))" expr-pos (string-index-of generator expr)]
  (if (or (not generator-ok) (not authority-ok) (< field-pos 0) (< expr-pos 0)) (option-none-of [:option :string])
   (let [start (+ field-pos (string-byte-length field-marker)) end (digits-end authority start)]
    (if (or (= start end) (> (- end start) 6)) (option-none-of [:option :string])
     (let [number (string-substring authority start end) tail-start (+ expr-pos (string-byte-length expr))
           tail (string-substring generator tail-start (string-byte-length generator))]
      (if (>= (string-index-of tail expr) 0) (option-none-of [:option :string])
       (let [updated (string-concat (string-substring generator 0 expr-pos) (string-concat "\"" (string-concat number (string-concat "\"" tail))))
             data (source/data updated "(defn typed-eval-section []" 40 41)
             node (if (option-some?-of [:option :document] data) (evaluate (val data)) (none))
             localized (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)]
        (if (option-some?-of [:option :document] localized)
         (let [rebased (if (string=? tag "en") localized (rebase/rebase-links (val localized) tag "/"))]
          (if (option-some?-of [:option :document] rebased) (html/render (val rebased) 0) (option-none-of [:option :string])))
         (option-none-of [:option :string]))))))))))

;; Expand the single pinned stack presentation comprehension from its owner data.
(defn- stack-card [presentation :document key :keyword] [:option :string]
 (let [item (field presentation key) subject (field item :subject) label (field item :label) spelling (document-edn-print subject)]
  (if (or (not (= (document-kind item) :map)) (not (= (document-kind subject) :keyword)) (not (= (document-kind label) :string)) (< (string-byte-length spelling) 2))
   (option-none-of [:option :string])
   (option-some-of [:option :string]
    (string-concat "(card (dds/chip-label \"" (string-concat (string-substring spelling 1 (string-byte-length spelling))
     (string-concat "\") [:p " (string-concat (document-edn-print label) "])"))))))))
(defn render-architecture [state [:ref :site/catalog] tag :string generator :string authority :string] [:option :string]
 (let [generator-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67"))
       authority-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 authority))) "17feb4c184cfe1f0225a4b8960efa11c0af4c3d91132470de3715432402e7d68"))
       presentation (source/data authority ":presentation" 123 125)
       start-marker "(for [k [:primary :secondary :compiler]" end-marker "[:p label]))"
       start (string-index-of generator start-marker) stop (string-index-of generator end-marker)]
  (if (or (not generator-ok) (not authority-ok) (not (option-some?-of [:option :document] presentation)) (< start 0) (< stop start)) (option-none-of [:option :string])
   (let [p (val presentation) first (stack-card p :primary) second (stack-card p :secondary) third (stack-card p :compiler)]
    (if (or (not (option-some?-of [:option :string] first)) (not (option-some?-of [:option :string] second)) (not (option-some?-of [:option :string] third))) (option-none-of [:option :string])
     (let [after (+ stop (string-byte-length end-marker))
           expanded (string-concat (string-substring generator 0 start) (string-concat (option-value-of [:option :string] first "")
            (string-concat " " (string-concat (option-value-of [:option :string] second "") (string-concat " "
             (string-concat (option-value-of [:option :string] third "") (string-substring generator after (string-byte-length generator))))))))
           stack (source/data expanded "(defn lisp-machine-stack []" 91 93)
           marker "(lisp-machine-stack)" pos (string-index-of expanded marker)]
      (if (or (< pos 0) (not (option-some?-of [:option :document] stack))) (option-none-of [:option :string])
       (let [tail (+ pos (string-byte-length marker))
             updated (string-concat (string-substring expanded 0 pos) (string-concat (document-edn-print (val stack)) (string-substring expanded tail (string-byte-length expanded))))
             data (source/data updated "(defn architecture-section []" 40 41)
             node (if (option-some?-of [:option :document] data) (evaluate (val data)) (none))
             localized (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)]
        (if (option-some?-of [:option :document] localized)
         (let [rebased (if (string=? tag "en") localized (rebase/rebase-links (val localized) tag "/"))]
          (if (option-some?-of [:option :document] rebased) (html/render (val rebased) 0) (option-none-of [:option :string])))
         (option-none-of [:option :string]))))))))))

;; Expand the proof card comprehension from the pinned generator's data vector.
(defn- proof-cards [records :document i :i64 out :string] [:option :string]
 (if (>= i (document-count records)) (option-some-of [:option :string] out)
  (let [item (vget records i) metric (field item :metric) title (field item :title) body (field item :body)]
   (if (or (not (= (document-kind item) :map)) (not (= (document-kind metric) :string))
           (not (= (document-kind title) :string)) (not (= (document-kind body) :string))) (option-none-of [:option :string])
    (proof-cards records (+ i 1)
     (string-concat out (string-concat " (card [:p {:class \"kot-metric\"} "
      (string-concat (document-edn-print metric) (string-concat "] (dds/heading 3 "
       (string-concat (document-edn-print title) (string-concat " {:size \"24\"}) [:p "
        (string-concat (document-edn-print body) "])"))))))))))))
(defn render-proof [state [:ref :site/catalog] tag :string generator :string] [:option :string]
 (let [generator-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67"))
       records (source/data generator "(def proof-signals" 91 93)
       start-marker "(for [{:keys [metric title body]} proof-signals]" end-marker "[:p body]))"
       start (string-index-of generator start-marker) tail-source (if (< start 0) "" (string-substring generator start (string-byte-length generator)))
       stop (string-index-of tail-source end-marker)]
  (if (or (not generator-ok) (not (option-some?-of [:option :document] records)) (< start 0) (< stop 0)) (option-none-of [:option :string])
   (let [cards (proof-cards (val records) 0 "")]
    (if (or (not (= (document-kind (val records)) :vector)) (not (= (document-count (val records)) 3)) (not (option-some?-of [:option :string] cards))) (option-none-of [:option :string])
     (let [after (+ start (+ stop (string-byte-length end-marker)))
           updated (string-concat (string-substring generator 0 start) (string-concat (option-value-of [:option :string] cards "") (string-substring generator after (string-byte-length generator))))
           data (source/data updated "(defn proof-section []" 40 41)
           node (if (option-some?-of [:option :document] data) (evaluate (val data)) (none))
           localized (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)]
      (if (option-some?-of [:option :document] localized)
       (let [rebased (if (string=? tag "en") localized (rebase/rebase-links (val localized) tag "/"))]
        (if (option-some?-of [:option :document] rebased) (html/render (val rebased) 0) (option-none-of [:option :string])))
       (option-none-of [:option :string]))))))))

;; Expand the default-claim cards from the pinned product authority.
(defn- status-label [s :document] :string
 (let [k (option-value-of [:option :keyword] (document-keyword-value s) :missing)]
  (cond (= k :default) "DEFAULT" (= k :ready-bounded) "READY BOUNDED"
        (= k :direction-measured) "DIRECTION MEASURED" (= k :implemented-partial) "IMPLEMENTED PARTIAL"
        (= k :direction) "DIRECTION" :else "")))
(defn- default-cards [records :document i :i64 out :string] [:option :string]
 (if (>= i (document-count records)) (option-some-of [:option :string] out)
  (let [item (vget records i) status (field item :status) headline (field item :headline) body (field item :body) label (status-label status)
        k (option-value-of [:option :keyword] (document-keyword-value status) :missing) color (if (or (= k :default) (= k :ready-bounded)) "blue" "gray")]
   (if (or (not (= (document-kind item) :map)) (string=? label "") (not (= (document-kind headline) :string)) (not (= (document-kind body) :string))) (option-none-of [:option :string])
    (default-cards records (+ i 1)
     (string-concat out (string-concat " (card (dds/chip-label " (string-concat (document-edn-print (document-string label))
      (string-concat " {:color " (string-concat (document-edn-print (document-string color)) (string-concat "}) (dds/heading 3 "
       (string-concat (document-edn-print headline) (string-concat " {:size \"24\"}) [:p " (string-concat (document-edn-print body) "])"))))))))))))))
(defn render-defaults [state [:ref :site/catalog] tag :string generator :string authority :string] [:option :string]
 (let [generator-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67"))
       authority-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 authority))) "733533d8956a65c62055ff87f8f080d457b29de9404db5d0dd2558b10cf792db"))
       records (source/data authority ":claims" 91 93)
       marker "(for [{:keys [status headline body]} (:claims product-defaults)]" end-marker "[:p body]))"
       start (string-index-of generator marker) tail (if (< start 0) "" (string-substring generator start (string-byte-length generator))) stop (string-index-of tail end-marker)]
  (if (or (not generator-ok) (not authority-ok) (not (option-some?-of [:option :document] records)) (< start 0) (< stop 0)) (option-none-of [:option :string])
   (let [cards (default-cards (val records) 0 "")]
    (if (or (not (= (document-kind (val records)) :vector)) (not (= (document-count (val records)) 10)) (not (option-some?-of [:option :string] cards))) (option-none-of [:option :string])
     (let [after (+ start (+ stop (string-byte-length end-marker)))
           updated (string-concat (string-substring generator 0 start) (string-concat (option-value-of [:option :string] cards "") (string-substring generator after (string-byte-length generator))))
           data (source/data updated "(defn defaults-section []" 40 41)
           node (if (option-some?-of [:option :document] data) (evaluate (val data)) (none))
           localized (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)]
      (if (option-some?-of [:option :document] localized)
       (let [rebased (if (string=? tag "en") localized (rebase/rebase-links (val localized) tag "/"))]
        (if (option-some?-of [:option :document] rebased) (html/render (val rebased) 0) (option-none-of [:option :string])))
       (option-none-of [:option :string]))))))))

;; Only the pinned release section and its pinned authority are supported.
(defn- replace-exact [s :string needle :string value :string] [:option :string]
 (let [p (string-index-of s needle)]
  (if (< p 0) (option-none-of [:option :string])
   (let [tail (string-substring s (+ p (string-byte-length needle)) (string-byte-length s))]
    (if (>= (string-index-of tail needle) 0) (option-none-of [:option :string])
     (option-some-of [:option :string] (string-concat (string-substring s 0 p) (string-concat value tail))))))))
(defn- line-value [s :string marker :string] :document
 (let [p (string-index-of s marker)]
  (if (< p 0) (document-null)
   (let [start (+ p (string-byte-length marker)) tail (string-substring s start (string-byte-length s)) end (string-index-of tail "\n")]
    (if (< end 0) (document-null) (document-edn-read (string-substring tail 0 end)))))))
(defn render-release [state [:ref :site/catalog] tag :string generator :string authority :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67"))
       a-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 authority))) "db5581afe2799519a604f8e16fab40691dfb877246d26690c4bf85ed80d756f9"))
       contract-o (source/data authority ":contract" 123 125) public-o (source/data authority ":public-default" 123 125)
       contract (val contract-o) public (val public-o) profile (field contract :language-profile) package (field contract :package-contract)
       version (line-value authority "  :tag ") binding (line-value authority "  :language-profile-binding ")
       status (field public :status) code (field public :code) reason (field public :reason)]
  (if (or (not g-ok) (not a-ok) (not (option-some?-of [:option :document] contract-o)) (not (option-some?-of [:option :document] public-o))
          (not (= (document-kind profile) :i64)) (not (= (document-kind package) :i64)) (not (= (document-kind version) :string))
          (not (string=? (document-edn-print binding) ":verified")) (not (string=? (document-edn-print status) ":released"))
          (not (= (document-kind code) :keyword)) (not (= (document-kind reason) :string))) (option-none-of [:option :string])
   (let [a (replace-exact generator "(str \"Profile \" (:language-profile contract))" (document-edn-print (document-string (string-concat "Profile " (document-edn-print profile)))))
         b (replace-exact (option-value-of [:option :string] a "") "(:package-contract contract)" (document-edn-print (document-string (document-edn-print package))))
         c (replace-exact (option-value-of [:option :string] b "") "(:tag implementation)" (document-edn-print version))
         d (replace-exact (option-value-of [:option :string] c "") "(name (:language-profile-binding implementation))" "\"verified\"")
         e (replace-exact (option-value-of [:option :string] d "") "(str/upper (name (:status public)))" "\"RELEASED\"")
         f (replace-exact (option-value-of [:option :string] e "") "(str (:code public))" (document-edn-print (document-string (document-edn-print code))))
         g (replace-exact (option-value-of [:option :string] f "") "(:reason public)" (document-edn-print reason))
         section (source/data (option-value-of [:option :string] g "") "(defn release-section []\n  (let [contract (:contract docs-release)\n        implementation (:implementation-release docs-release)\n        public (:public-default docs-release)]" 40 41)
         node (if (option-some?-of [:option :document] section) (evaluate (val section)) (none))
         localized (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)]
    (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b) (option-some?-of [:option :string] c)
             (option-some?-of [:option :string] d) (option-some?-of [:option :string] e) (option-some?-of [:option :string] f)
             (option-some?-of [:option :string] g) (option-some?-of [:option :document] localized))
     (let [rebased (if (string=? tag "en") localized (rebase/rebase-links (val localized) tag "/"))]
      (if (option-some?-of [:option :document] rebased) (html/render (val rebased) 0) (option-none-of [:option :string])))
     (option-none-of [:option :string]))))))

;; Reject authority drift: a new sponsorship state requires a new review.
(defn render-sponsor [state [:ref :site/catalog] tag :string generator :string authority :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67"))
       a-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 authority))) "f7eed846369300609667cbfa3e0fa79150acd1f88f63bc742bde54ea46f6b380"))
       status (line-value authority " :status ") checked (line-value authority " :checked-at ")
       start (string-index-of generator "(defn sponsor-section []") stop (string-index-of generator "(defn blog-cloud-section []")]
  (if (or (not g-ok) (not a-ok) (not (string=? (document-edn-print status) ":preparing")) (not (= (document-kind checked) :string))
          (< start 0) (<= stop start)) (option-none-of [:option :string])
   (let [section (string-substring generator start stop)
         a (replace-exact section "(if sponsorship-live?\n      \"GitHub Sponsors is open for people and organizations that want to sustain Kotoba's public language, tooling, qualification, and evidence.\"\n      \"The Kotoba GitHub Sponsors profile is being prepared. The project page is ready now and will expose a payment action only after GitHub approves the organization profile.\")" "\"The Kotoba GitHub Sponsors profile is being prepared. The project page is ready now and will expose a payment action only after GitHub approves the organization profile.\"")
         b (replace-exact (option-value-of [:option :string] a "") "(if sponsorship-live? \"OPEN\" \"PREPARING\")" "\"PREPARING\"")
         c (replace-exact (option-value-of [:option :string] b "") "(if sponsorship-live?\n                \"Choose a one-time or monthly tier on GitHub. GitHub handles the payment and sponsorship management.\"\n                \"No sponsorship payment can be made through kotoba-lang.org while the GitHub profile is not live.\")" "\"No sponsorship payment can be made through kotoba-lang.org while the GitHub profile is not live.\"")
         d (replace-exact (option-value-of [:option :string] c "") "(str/upper (name (:status sponsorship)))" "\"PREPARING\"")
         e (replace-exact (option-value-of [:option :string] d "") "(:checked-at sponsorship)" (document-edn-print checked))
         form (source/data (option-value-of [:option :string] e "") "(defn sponsor-section []" 40 41)
         node (if (option-some?-of [:option :document] form) (evaluate (val form)) (none))
         localized (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)]
    (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b) (option-some?-of [:option :string] c) (option-some?-of [:option :string] d)
             (option-some?-of [:option :string] e) (option-some?-of [:option :document] localized))
     (let [rebased (if (string=? tag "en") localized (rebase/rebase-links (val localized) tag "/") )]
      (if (option-some?-of [:option :document] rebased) (html/render (val rebased) 0) (option-none-of [:option :string])))
     (option-none-of [:option :string]))))))

;; Source section derives its four displayed facts from pinned authorities.
(defn render-source [state [:ref :site/catalog] tag :string generator :string release :string platform :string pipeline :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67"))
       r-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 release))) "db5581afe2799519a604f8e16fab40691dfb877246d26690c4bf85ed80d756f9"))
       w-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 platform))) "1ff6116f44f14ff054f672e793648e81f7963cb171051363868a14aee84006e3"))
       p-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 pipeline))) "723e35e594ca51985eea7f814c61e9a9fe8da1ee8407125fe58aa6cc46225624"))
       contract (source/data release ":contract" 123 125) public (source/data release ":public-default" 123 125)
       wasi (source/data platform ":wasi" 123 125) stages (source/data pipeline ":pipeline" 91 93)
       profile (field (val contract) :language-profile) status (field (val public) :status) version (field (val wasi) :version)]
  (if (or (not g-ok) (not r-ok) (not w-ok) (not p-ok) (not (option-some?-of [:option :document] contract))
          (not (option-some?-of [:option :document] public)) (not (option-some?-of [:option :document] wasi))
          (not (option-some?-of [:option :document] stages)) (not (= (document-kind profile) :i64))
          (not (string=? (document-edn-print status) ":released")) (not (= (document-kind version) :string))
          (not (= (document-kind (val stages)) :vector))) (option-none-of [:option :string])
   (let [a (replace-exact generator "(get-in docs-release [:contract :language-profile])" (document-edn-print (document-string (document-edn-print profile))))
         b (replace-exact (option-value-of [:option :string] a "") "(str/upper (name (get-in docs-release [:public-default :status])))" "\"RELEASED\"")
         c (replace-exact (option-value-of [:option :string] b "") "(get-in platform [:upstream :wasi :version])" (document-edn-print version))
         d (replace-exact (option-value-of [:option :string] c "") "(count (:pipeline elaboration))" (document-edn-print (document-string (document-edn-print (document-i64 (document-count (val stages)))))))
         form (source/data (option-value-of [:option :string] d "") "(defn source-section []" 40 41)
         node (if (option-some?-of [:option :document] form) (evaluate (val form)) (none))
         localized (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)]
    (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b) (option-some?-of [:option :string] c)
             (option-some?-of [:option :string] d) (option-some?-of [:option :document] localized))
     (let [rebased (if (string=? tag "en") localized (rebase/rebase-links (val localized) tag "/"))]
      (if (option-some?-of [:option :document] rebased) (html/render (val rebased) 0) (option-none-of [:option :string])))
     (option-none-of [:option :string]))))))

;; The pinned benchmark is a JSON record with exactly 19 workload rows. Check
;; the original slower-than-C assertion before emitting the unchanged prose.
(defn- slow-bit [name :string] :i64
 (cond (string=? name "xgboost") 1 (string=? name "slre") 2 (string=? name "sglib-combined") 4
       (string=? name "picojpeg") 8 (string=? name "statemate") 16 (string=? name "md5sum") 32 :else 0))
(defn check-ratios [s :string n :i64 slower :i64 mask :i64] :bool
 (let [needle "\"workload\": \"" p (string-index-of s needle)]
  (if (< p 0) (and (= n 19) (= slower 6) (= mask 63))
   (let [tail (string-substring s (+ p (string-byte-length needle)) (string-byte-length s)) end (string-index-of tail "\"")
         ratio-marker "\"normalizedTimeRatio\": " r (string-index-of tail ratio-marker)]
    (if (or (< end 1) (< r end) (>= n 19)) false
     (let [name (string-substring tail 0 end) raw (string-substring tail (+ r (string-byte-length ratio-marker)) (string-byte-length tail))
           end-number (string-index-of raw "\n")]
      (if (< end-number 1) false
       (let [d (document-edn-read (string-substring raw 0 end-number)) v (document-f64-value d) x (option-value-of [:option :f64] v -1.0)
             bit (if (f64-gt x 1.0) (slow-bit name) 0)]
        (if (or (not (option-some?-of [:option :f64] v)) (f64-le x 0.0)
                (and (f64-gt x 1.0) (or (= bit 0) (not (= (bit-and mask bit) 0))))) false
         (check-ratios (string-substring raw end-number (string-byte-length raw)) (+ n 1)
          (if (f64-gt x 1.0) (+ slower 1) slower) (bit-or mask bit)))))))))))
(defn render-why-fast [state [:ref :site/catalog] tag :string generator :string report :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67"))
       r-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 report))) "6352f6e90e7b456b77cbddc1edc2a91bfc3bd9f9a5f98dcc22fa788d51923411"))
       ratios-ok (check-ratios report 0 0 0)
       form (source/data generator "(pr-str expected) \" but the record has \" (pr-str slower)))))" 40 41)
       node (if (option-some?-of [:option :document] form) (evaluate (val form)) (none))
       localized (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)]
  (if (and g-ok r-ok ratios-ok (option-some?-of [:option :document] localized))
   (let [rebased (if (string=? tag "en") localized (rebase/rebase-links (val localized) tag "/"))]
    (if (option-some?-of [:option :document] rebased) (html/render (val rebased) 0) (option-none-of [:option :string])))
   (option-none-of [:option :string]))))
