(ns site.native.home-section (:export [render])
 (:require [site.native.source-concat :as source] [site.native.locale-tree :as tree]
           [multiformats.sha256 :as sha] [html-hiccup :as html] [components :as dds]))
;; Bounded interpreter for data-only homepage forms. Unknown calls fail closed.
(defn- none [] [:option :document] (option-none-of [:option :document]))
(defn- some [d :document] [:option :document] (option-some-of [:option :document] d))
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- at [d :document i :i64] :document (val (document-list-at d i)))
(defn- vget [d :document i :i64] :document (val (document-vector-at d i)))
(defn- field [d :document k :keyword] :document (val (document-get d k)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- integer [d :document] :i64 (option-value-of [:option :i64] (document-i64-value d) 0))
(defn- children [d :document i :i64 out :document list? :bool] [:option :document]
 (if (>= i (document-count d)) (some out)
  (let [child (evaluate (if list? (at d i) (vget d i)))]
   (if (option-some?-of [:option :document] child) (children d (+ i 1) (document-vector-conj out (val child)) list?) (none)))))
(defn- call [d :document] [:option :document]
 (let [head (at d 0) name (document-edn-print head) n (document-count d)]
  (if (not (= (document-kind head) :symbol)) (none)
   (cond
    (string=? name "card") (children d 1 (document-vector (document-keyword :div) (document-map :class (document-string "dds-ext-card"))) true)
    (string=? name "dds/grid")
     (let [opts (at d 1) min (field opts :min)]
      (if (or (not (= (document-kind opts) :map)) (not (= (document-kind min) :string))) (none)
       (children d 2 (document-vector (document-keyword :div) (document-map :class (document-string "dds-ext-grid") :style (document-map :--dds-ext-grid-min min))) true)))
    (string=? name "dds/chip-label")
     (if (not (= n 2)) (none)
      (let [label (evaluate (at d 1))]
       (if (option-some?-of [:option :document] label)
        (some (document-vector (document-keyword :span) (document-map :class (document-string "dads-chip-label") :data-style (document-string "text") :data-color (document-string "blue")) (val label))) (none))))
    (string=? name "dds/heading")
     (let [level (integer (at d 1)) label (evaluate (at d 2)) opts (at d 3) size (text (field opts :size))]
      (if (or (not (= n 4)) (< level 1) (> level 6) (not (option-some?-of [:option :document] label)) (not (= (document-kind opts) :map))) (none)
       (some (dds/heading-node level (val label) size ""))))
    (string=? name "dds/section")
     (let [opts (at d 1) title (field opts :title) id (field opts :id)]
      (if (or (not (= (document-kind opts) :map)) (not (= (document-kind title) :string)) (not (= (document-kind id) :string))) (none)
       (children d 2 (document-vector (document-keyword :section) (document-map :class (document-string "dds-ext-section") :id id) (dds/heading-node 2 title "32" "")) true)))
    :else (none)))))
(defn- evaluate [d :document] [:option :document]
 (let [kind (document-kind d)]
  (cond (= kind :vector) (children d 0 (document-vector) false)
        (= kind :list) (call d)
        (or (= kind :map) (= kind :keyword) (= kind :string) (= kind :i64)) (some d)
        :else (none))))
(defn render [state [:ref :site/catalog] tag :string generator :string] [:option :string]
 (if (not (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "b129ac603b9ec3ee679874193c2513c985e26def60daaae5303fabadf90367a7"))) (option-none-of [:option :string])
  (let [data (source/data generator "(defn why-section []" 40 41)
        node (if (option-some?-of [:option :document] data) (evaluate (val data)) (none))
        localized (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)]
   (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (option-none-of [:option :string])))))
