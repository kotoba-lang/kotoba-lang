(ns site.native.site-sections-controller (:export [main])
 (:capabilities [:fs/app-data-bytes :process/spawn :cli/args])
 (:require [multiformats.sha256 :as sha]))
;; Trusted immutable manifest and input directories; both output roots must be private.
;; Any failure leaves an incomplete stage that the caller must discard, not publish.
(defn- bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- text [v :vector-i64] :string (string-from-utf8 (bytes-from-vector-i64 v)))
(defn- zero [] :string (string-from-utf8 (bytes-from-vector-i64 [0])))
(defn- field [s :string] :string (string-concat s (zero)))
(defn- cat [a :vector-i64 b :vector-i64] :vector-i64
 (let [n (vector-count a) m (vector-count b)
       out (loop [i 0 v (vector-alloc (+ n m))] (if (= i n) v (recur (+ i 1) (vector-assoc! v i (vector-at a i)))))]
  (loop [i 0 v out] (if (= i m) v (recur (+ i 1) (vector-assoc! v (+ n i) (vector-at b i)))))))
(defn- frame [op :i64 tail :vector-i64] :vector-i64 (cat [0 65 77 85 72 1 op] tail))
(defn- call [op :i64 tail :vector-i64] :vector-i64
 (vector-i64-from-bytes (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-from-vector-i64 (frame op tail)))))
(defn- read [p :string] :vector-i64 (call 1 (bytes (field p))))
(defn- ok? [v :vector-i64] :bool (and (> (vector-count v) 0) (= (vector-at v 0) 0)))
(defn- payload [v :vector-i64] :vector-i64
 (let [n (- (vector-count v) 1)] (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ i 1))))))))
(defn- mkdir [p :string] :bool (ok? (call 3 (bytes (field p)))))
(defn- join [a :string b :string] :string (string-concat a (string-concat "/" b)))
(defn- val [d :document k :keyword] :string
 (option-value-of [:option :string] (document-string-value (option-value-of [:option :document] (document-get d k) (document-null))) ""))
(defn- matches? [path :string expected :string] :bool
 (let [r (read path)] (and (ok? r) (= (string-byte-length expected) 64) (arena-scope (string=? (sha/digest-hex (payload r)) expected)))))
(defn- hex [n :i64] :i64 (cond (and (>= n 48) (<= n 57)) (- n 48) (and (>= n 65) (<= n 70)) (- n 55) :else -1))
(defn- proc-reply [s :string] :vector-i64
 (let [v (bytes s)]
  (if (and (= (vector-count v) 5) (or (= (vector-at v 0) 48) (= (vector-at v 0) 49))
           (>= (hex (vector-at v 1)) 0) (>= (hex (vector-at v 2)) 0) (>= (hex (vector-at v 3)) 0) (>= (hex (vector-at v 4)) 0))
   [(- (vector-at v 0) 48) (+ (* 16 (hex (vector-at v 1))) (hex (vector-at v 2))) (+ (* 16 (hex (vector-at v 3))) (hex (vector-at v 4)))] [1 22 0])))
(defn- spawn [cwd :string capture :string exe :string argc :i64 args :string] :bool
 (let [fields (string-concat (field cwd) (string-concat (field capture) (string-concat (field exe) (string-concat (field "site-part") args))))
       request (frame 9 (cat [1 argc] (bytes fields)))
       r (proc-reply (typed-cap-call :process/spawn :string :string (text request)))]
  (and (= (vector-count r) 3) (= (vector-at r 0) 0) (= (vector-at r 1) 42))))
(defn- asset [m :document cwd :string capture :string source :string digest :string dest :string name :string] :bool
 (spawn cwd capture (val m :asset) 5 (string-concat (field source) (string-concat (field digest) (string-concat (field dest) (field name))))))
(defn- tag [i :i64] :string
 (case i 0 "en" 1 "ar" 2 "arz" 3 "bn" 4 "de" 5 "es" 6 "fr" 7 "hi" 8 "id" 9 "ja" 10 "ko" 11 "mr" 12 "pcm" 13 "pt" 14 "ru" 15 "ur" 16 "zh-Hans" ""))
(defn- page [m :document private :string site :string t :string] :bool
 (let [scratch (join private t) locale-root (if (string=? t "en") site (join site t)) dest (join locale-root "blog")
       args (string-concat (field t) (string-concat (field (val m :head-dir)) (string-concat (field (val m :head))
             (string-concat (field (val m :head-sha)) (string-concat (field (val m :body-dir))
             (string-concat (field (val m :body)) (string-concat (field (val m :body-sha)) (field scratch))))))))]
  (if (not (mkdir scratch)) false
   (if (and (not (string=? t "en")) (not (mkdir locale-root))) false
    (if (not (mkdir dest)) false
     (if (not (spawn private (join scratch "page.log") (val m :page) 9 args)) false
      (let [p (join scratch "index.html") data (read p)]
       (if (not (ok? data)) false
        (let [digest (sha/digest-hex (payload data))]
         (asset m private (join scratch "copy.log") p digest dest "index.html"))))))))))
(defn- pages [m :document private :string site :string i :i64] :bool
 (if (= i 17) true (and (page m private site (tag i)) (pages m private site (+ i 1)))))
(defn- legal-page [m :document private :string site :string t :string] :bool
 (let [parent (join private t) scratch (join parent "legal") locale-root (if (string=? t "en") site (join site t)) dest (join locale-root "legal")
       args (string-concat (field t) (string-concat (field (val m :legal-head-dir)) (string-concat (field (val m :legal-head))
             (string-concat (field (val m :legal-head-sha)) (string-concat (field (val m :legal-body-dir))
             (string-concat (field (val m :legal-body)) (string-concat (field (val m :legal-body-sha)) (field scratch))))))))]
  (if (or (not (mkdir scratch)) (not (mkdir dest))) false
   (if (not (spawn private (join scratch "page.log") (val m :page) 9 args)) false
    (let [p (join scratch "index.html") data (read p)]
     (if (not (ok? data)) false
      (let [digest (sha/digest-hex (payload data))]
       (asset m private (join scratch "copy.log") p digest dest "index.html"))))))))
(defn- legal-pages [m :document private :string site :string i :i64] :bool
 (if (= i 17) true (and (legal-page m private site (tag i)) (legal-pages m private site (+ i 1)))))
(defn- valid? [m :document] :bool
 (and (= (document-kind m) :map)
      (matches? (val m :page) (val m :page-sha)) (matches? (val m :asset) (val m :asset-sha))
      (matches? (val m :head) (val m :head-sha)) (matches? (val m :body) (val m :body-sha))
      (matches? (val m :legal-head) (val m :legal-head-sha)) (matches? (val m :legal-body) (val m :legal-body-sha))
      (matches? (val m :static-controller) (val m :static-controller-sha))
      (matches? (val m :static-manifest) (val m :static-manifest-sha))))
(defn main [] :i64
 (let [manifest (typed-cap-call :cli/args :string :string "0") private (typed-cap-call :cli/args :string :string "1")
       site (typed-cap-call :cli/args :string :string "2") r (read manifest)]
  (if (or (string=? private "") (string=? site "") (not (ok? r))) 7
   (let [m (document-edn-read (text (payload r)))]
    (if (not (valid? m)) 7
     (if (not (pages m private site 0)) 7
      (let [scratch (join private "static")
            args (string-concat (field (val m :static-manifest)) (string-concat (field scratch) (field site)))]
       (if (and (mkdir scratch) (spawn private (join private "static.log") (val m :static-controller) 4 args)
                (legal-pages m private site 0)) 42 7))))))))
