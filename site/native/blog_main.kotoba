(ns site.native.blog-main (:export [render])
 (:require [site.native.source-concat :as source] [site.native.home-section :as section]
           [site.native.locale-tree :as tree] [site.native.locale-rebase :as rebase]
           [multiformats.sha256 :as sha] [html-hiccup :as html]))
;; Bounded source-derived blog index main. Historical source text is retained
;; for comparison; this alone does not qualify its claims for publication.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- vget [d :document i :i64] :document (val (document-vector-at d i)))
(defn- lget [d :document i :i64] :document (val (document-list-at d i)))
(defn- get-field [d :document k :keyword] :document (val (document-get d k)))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
  (option-some-of [:option :string] (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (none)))
(defn- digest? [s :string expected :string] :bool
 (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) expected))
(defn- substitute [generator :string name :string doc :document] :string
 (let [title (get-field doc :title) description (get-field doc :description)]
  (if (and (= (document-kind title) :string) (= (document-kind description) :string))
   (string-replace-all
    (string-replace-all generator (string-concat "(:title " (string-concat name ")")) (document-edn-print title))
    (string-concat "(:description " (string-concat name ")")) (document-edn-print description)) "")))
(defn- render-section [state [:ref :site/catalog] tag :string node :document] [:option :string]
 (let [raw (section/evaluate node)
       translated (if (or (not (option-some?-of [:option :document] raw)) (string=? tag "en")) raw (tree/map-indexed state (val raw)))
       linked (if (or (not (option-some?-of [:option :document] translated)) (string=? tag "en")) translated (rebase/rebase-links (val translated) tag "/blog/"))]
  (if (option-some?-of [:option :document] linked) (html/render (val linked) 0) (none))))
(defn- render-sections [state [:ref :site/catalog] tag :string container :document i :i64 acc [:option :string]] [:option :string]
 (if (>= i (document-count container)) acc
  (render-sections state tag container (+ i 1) (append acc (render-section state tag (lget container i))))))
(defn render [state [:ref :site/catalog] tag :string generator :string parity :string usage :string progress :string infra :string security :string identity :string] [:option :string]
 (if (not (and (arena-scope (digest? generator "5bb0ff5d9e2f80ca7a76545ead6d0138ab7516f2bb712dd4f059d8b0bb4f5ab2"))
               (arena-scope (digest? parity "abdaa6e1e9afcf44f551eee4f86fe1812e0dfeea13f420f08625efcae134094d"))
               (arena-scope (digest? usage "2de6d6dfade493f8ad82b52e2b01f6685b97220ca026940126f8d09f35b8bdc9"))
               (arena-scope (digest? progress "4d646f5e00ebc9cbac2f13e8ff1cfdb77ce61e5fa83a68f3c5fbdc1bf856a269"))
               (arena-scope (digest? infra "af4fa5805435c75f54ddb28b9a668c1ec550374df961786f7845d6cca2d16736"))
               (arena-scope (digest? security "98428f09c884237588e76a2187817d4eebd85b1b30c7b499680d6d7702f16e86"))
               (arena-scope (digest? identity "58c584bd1c59ba1a64568670d0f118743bf8c7d1d147fbd32f2d9f446c9f6d70")))) (none)
  (let [a (substitute generator "(:en embench-c-parity-copy)" (get-field (document-edn-read parity) :en))
        b (substitute a "(:en usage-copy)" (get-field (document-edn-read usage) :en))
        c (substitute b "(:en embench-progress-copy)" (get-field (document-edn-read progress) :en))
        d (substitute c "infra-cost-copy" (document-edn-read infra))
        e (substitute d "security-copy" (document-edn-read security))
        f (substitute e "org-identity-copy" (document-edn-read identity))
        raw (source/data f "(defn blog-view []" 91 93) main (vget (val raw) 3) container (vget main 2)]
   (if (or (not (option-some?-of [:option :document] raw)) (not (= (document-kind main) :vector))
           (not (= (document-kind container) :list)) (not (string=? (document-edn-print (lget container 0)) "dds/container"))) (none)
    (append (option-some-of [:option :string] "<main id=\"main\"><div class=\"dds-ext-container\">")
     (append (render-sections state tag container 1 (option-some-of [:option :string] "")) (option-some-of [:option :string] "</div></main>")))))))
