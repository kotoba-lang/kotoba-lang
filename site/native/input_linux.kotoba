(ns site.native.input (:export [request-path read]) (:capabilities [:fs/app-data]))

;; Linux resolves relative paths from the private input cwd and enforces the
;; explicit filesystem root. Strip only the site's logical leading slash.
(defn request-path [path :string] :string
  (let [n (string-length path)]
    (if (and (> n 0) (string=? (string-substring path 0 1) "/"))
      (string-substring path 1 n) path)))
(defn read [path :string] :string
  (typed-cap-call :fs/app-data :string :string (request-path path)))
