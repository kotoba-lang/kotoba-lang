(ns site.native.syntax-theme (:export [render])
 (:require [multiformats.sha256 :as sha] [json-scalar :as json]))
;; The only accepted input is the immutable grammar theme identified below.
;; This bounded reader extracts its ordered tokens, rather than trusting output
;; from a previously generated site. It does not implement general JSON decode.
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- val [x [:option :string]] :string (option-value-of [:option :string] x ""))
(defn- ascii-bytes [s :string] [:option :vector-i64]
 (loop [i 0 out (vector-alloc 0)]
  (if (>= i (string-byte-length s)) (option-some-of [:option :vector-i64] out)
   (let [c (string-code-point-at s i)]
    (if (>= c 128) (option-none-of [:option :vector-i64]) (recur (+ i 1) (vector-conj out c)))))))
(defn- pinned? [s :string] :bool
 (let [b (ascii-bytes s)]
  (if (option-some?-of [:option :vector-i64] b)
   (string=? (sha/digest-hex (option-value-of [:option :vector-i64] b (vector-alloc 0))) "a1164296d14767fa9fb19998197e5484599d7681796055345377da04b09117a7") false)))
(defn- tail-after [s :string anchor :string] [:option :string]
 (let [i (string-index-of s anchor)]
  (if (< i 0) (none) (some (string-substring s (+ i (string-byte-length anchor)) (string-byte-length s))))))
(defn- bounded [s :string anchor :string closer :string] [:option :string]
 (let [tail (tail-after s anchor)]
  (if (option-some?-of [:option :string] tail)
   (let [t (val tail) end (string-index-of t closer)]
    (if (< end 0) (none) (some (string-substring t 0 end)))) (none))))
(defn- token-object [s :string token :string] [:option :string]
 (let [tail (tail-after s "\"tokens\": {")]
  (if (option-some?-of [:option :string] tail)
   (let [anchor (string-concat "\"" (string-concat token "\": {")) inner (bounded (val tail) anchor "}")]
    (if (option-some?-of [:option :string] inner) (some (string-concat "{" (string-concat (val inner) "}"))) (none))) (none))))
(defn- valid-name? [s :string] :bool
 (let [n (string-byte-length s)]
  (if (= n 0) false
   (loop [i 0] (if (>= i n) true
    (let [c (string-code-point-at s i)]
     (if (or (and (>= c 97) (<= c 122)) (and (>= c 48) (<= c 57)) (= c 45)) (recur (+ i 1)) false)))))))
(defn- color? [s :string] :bool
 (if (or (not (= (string-byte-length s) 7)) (not (= (string-code-point-at s 0) 35))) false
  (loop [i 1] (if (>= i 7) true (let [c (string-code-point-at s i)]
   (if (or (and (>= c 48) (<= c 57)) (and (>= c 65) (<= c 70)) (and (>= c 97) (<= c 102))) (recur (+ i 1)) false))))))
(defn- token-name [order :document i :i64] :string
 (option-value-of [:option :string] (document-string-value (option-value-of [:option :document] (document-vector-at order i) (document-null))) ""))
(defn- vars [source :string order :document mode :string] [:option :string]
 (loop [i 0 out ""]
  (if (>= i (document-count order)) (some out)
   (let [name (token-name order i) obj (token-object source name)]
    (if (or (not (valid-name? name)) (not (option-some?-of [:option :string] obj))) (none)
     (let [raw (val obj) kind (json/json-string-field raw "siteKind") value (json/json-string-field raw mode)
           chosen (if (option-some?-of [:option :string] kind) (val kind) name)]
      (if (or (not (valid-name? chosen)) (not (option-some?-of [:option :string] value)) (not (color? (val value)))) (none)
       (recur (+ i 1) (string-concat out (string-concat "--kot-syntax-" (string-concat chosen (string-concat ":" (string-concat (val value) ";")))))))))))))
(defn- rules [source :string order :document] [:option :string]
 (loop [i 0 out ""]
  (if (>= i (document-count order)) (some out)
   (let [name (token-name order i) obj (token-object source name)]
    (if (or (not (valid-name? name)) (not (option-some?-of [:option :string] obj))) (none)
     (let [raw (val obj) kind (json/json-string-field raw "siteKind") font (json/json-string-field raw "fontStyle")
           chosen (if (option-some?-of [:option :string] kind) (val kind) name) style (val font)]
      (if (not (valid-name? chosen)) (none)
       (recur (+ i 1) (string-concat out
        (string-concat ".kot-syntax-" (string-concat chosen (string-concat "{color:var(--kot-syntax-" (string-concat chosen
         (string-concat ");" (string-concat (if (string-contains? style "bold") "font-weight:700;" "")
          (string-concat (if (string-contains? style "italic") "font-style:italic;" "")
           (string-concat (if (string-contains? style "underline") "text-decoration:underline;text-underline-offset:.18em;" "")
            (string-concat (if (string=? chosen "forbidden") "text-decoration-style:wavy;" "") "}"))))))))))))))))
))
(defn render [source :string] [:option :string]
 (if (not (pinned? source)) (none)
  (let [raw (bounded source "\"tokenOrder\": [" "]")]
   (if (not (option-some?-of [:option :string] raw)) (none)
    (let [order (document-edn-read (string-concat "[" (string-concat (val raw) "]")))]
     (if (or (not (= (document-kind order) :vector)) (not (= (document-count order) 13))) (none)
      (let [light (vars source order "light") dark (vars source order "dark") rs (rules source order)]
       (if (and (option-some?-of [:option :string] light) (option-some?-of [:option :string] dark) (option-some?-of [:option :string] rs))
        (some (string-concat ":root{" (string-concat (val light) (string-concat "}:root[data-theme=\"dark\"]{" (string-concat (val dark)
         (string-concat "}@media(prefers-color-scheme:dark){:root:not([data-theme=\"light\"]){" (string-concat (val dark) (string-concat "}}" (val rs))))))))) (none)))))))))
