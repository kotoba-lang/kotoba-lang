(ns site.native.article-head (:export [before-style after-style])
 (:require [site.native.page-metadata :as meta] [site.native.dds-palette :as palette]
           [site.native.header-scripts :as scripts]))
(defn- val [x [:option :string]] :string (option-value-of [:option :string] x ""))
(defn- none [] [:option :string] (option-none-of [:option :string]))
;; A metadata projection contains the title and description followed by a
;; canonical link and the remaining SEO elements. Split around the link so the
;; page's style and control scripts retain their source order.
(defn before-style [state [:ref :site/catalog] tag :string base :string title :string description :string dds :string] [:option :string]
 (let [m (meta/render-metadata state tag base title description) color (palette/literal-color dds "--color-neutral-solid-gray-900")]
  (if (or (not (string=? tag "en")) (not (option-some?-of [:option :string] m)) (not (option-some?-of [:option :string] color))) (none)
   (let [text (val m) pos (string-index-of text "<link ")]
    (if (< pos 0) (none)
     (option-some-of [:option :string]
      (string-concat "<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"><meta name=\"color-scheme\" content=\"light dark\"><meta name=\"theme-color\" content=\"#ffffff\" media=\"(prefers-color-scheme: light)\"><meta name=\"theme-color\" content=\""
       (string-concat (val color) (string-concat "\" media=\"(prefers-color-scheme: dark)\">" (string-concat (string-substring text 0 pos) "<style>")))))))))
)
(defn after-style [state [:ref :site/catalog] tag :string base :string title :string description :string generator :string behavior :string theme :string] [:option :string]
 (let [m (meta/render-metadata state tag base title description) ts (scripts/theme-script generator theme) ms (scripts/menu-script generator behavior)]
  (if (not (and (string=? tag "en") (option-some?-of [:option :string] m) (option-some?-of [:option :string] ts) (option-some?-of [:option :string] ms))) (none)
   (let [text (val m) pos (string-index-of text "<link ")]
    (if (< pos 0) (none)
     (option-some-of [:option :string]
      (string-concat "</style><link rel=\"icon\" type=\"image/png\" href=\"/kotoba-favicon.png\"><link rel=\"apple-touch-icon\" href=\"/kotoba-favicon.png\"><script>"
       (string-concat (val ts) (string-concat "</script><script>" (string-concat (val ms)
        (string-concat "</script>" (string-concat (string-substring text pos (string-byte-length text)) "</head>"))))))))))))
