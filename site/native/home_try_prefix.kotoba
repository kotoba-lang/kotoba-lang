(ns site.native.home-try-prefix (:export [render])
 (:require [site.native.home-contents :as contents] [site.native.home-start :as start]
           [site.native.home-section :as section] [site.native.home-code-play :as play]))
;; The first three sections of chapter four. The caller appends the library and
;; search sections only after their complete source and policy are qualified.
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
  (some (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (none)))
(defn render [state [:ref :site/catalog] tag :string generator :string locales :string sample :string provenance :string wasm :vector-i64 grammar :string tokenizer :string theme :string] [:option :string]
 (let [a (append (some "<div class=\"kot-chapter-block\">") (contents/rule-at state tag generator 3))
       b (append a (start/render state tag generator locales))
       c (append b (section/render-section state tag generator "docs"))
       d (append c (play/render state tag generator sample provenance wasm grammar tokenizer theme))]
  (append d (some "</div>"))))
