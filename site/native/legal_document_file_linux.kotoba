(ns site.native.legal-document-file-linux (:export [main]) (:capabilities [:fs/app-data :cli/args])
 (:require [site.native.home-document :as document]))
(defn- read [p :string] :string
 (typed-cap-call :fs/app-data :string :string (string-concat (typed-cap-call :cli/args :string :string "2") p)))
(defn- fs2 [op :string path :string data :string] :string
 (typed-cap-call :fs/app-data :string :string
  (string-concat "\u0000FS2\u0000" (string-concat op (string-concat path (string-concat "\u0000" data))))))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0") target (typed-cap-call :cli/args :string :string "1")
       result (document/compose tag (read "/document-manifest.edn") (read "/head.html") (read "/body.html"))]
  (if (and (not (string=? target "")) (option-some?-of [:option :string] result) (string=? (fs2 "D" target "") "\u0000FS2\u00000"))
   (let [page (option-value-of [:option :string] result "")]
    (if (string=? (fs2 "B" target page) (string-concat "\u0000FS2\u0000" page)) 42 7)) 7)))
