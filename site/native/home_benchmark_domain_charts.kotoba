(ns site.native.home-benchmark-domain-charts (:export [render])
 (:require [json.core :as json] [site.native.locale-tree :as tree] [multiformats.sha256 :as sha]
           [html-hiccup :as html] [components :as dds]))
;; Six ranked-bar workload charts for the pinned report, not generic chart qualification.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- field [d :document k :string] :document (val (document-get d (document-string k))))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- num [d :document] :string
 (let [k (document-kind d) s (document-edn-print d) n (string-byte-length s)]
  (if (or (= k :i64) (= k :f64))
   (if (and (= k :f64) (>= n 2) (string=? (string-substring s (- n 2) n) ".0")) (string-substring s 0 (- n 2)) s) "")))
(defn- number [d :document] :f64
 (if (= (document-kind d) :i64) (i64-to-f64-rounded (option-value-of [:option :i64] (document-i64-value d) 0))
  (option-value-of [:option :f64] (document-f64-value d) 0.0)))
(defn- fixed [x :f64 scale :i64 digits :i64] :string
 (let [v (f64-to-i64-truncating (f64-add (f64-mul x (i64-to-f64-rounded scale)) 0.5)) whole (quot v scale) frac (rem v scale)]
  (string-concat (string-from-i64 whole) (string-concat "." (string-concat (if (and (= digits 3) (< frac 100)) "0" "")
   (string-concat (if (and (= digits 3) (< frac 10)) "0" "") (string-from-i64 frac)))))))
(defn- result [tools :document i :i64 work :string] :document (field (field (item tools i) "results") work))
(defn- measured? [d :document] :bool (string=? (text (field d "status")) "measured"))
(defn- value [d :document] :f64 (number (field d "medianMilliseconds")))
(defn- next-index [tools :document work :string prev :f64 prev-i :i64] :i64
 (loop [i 0 best -1 bestval 0.0]
  (if (>= i (document-count tools)) best
   (let [d (result tools i work) v (value d)
         after (or (f64-gt v prev) (and (f64-eq v prev) (> i prev-i)))
         choose (and (measured? d) after (or (< best 0) (f64-lt v bestval)))]
    (recur (+ i 1) (if choose i best) (if choose v bestval))))))
(defn- max-value [tools :document work :string] :f64
 (loop [i 0 top 0.0]
  (if (>= i (document-count tools)) top
   (let [d (result tools i work) n (value d)]
    (recur (+ i 1) (if (and (measured? d) (f64-gt n top)) n top))))))
(defn- lane [tool :document d :document top :f64 best :f64] :document
 (let [label (text (field tool "label")) v (value d) display (num (field d "medianMilliseconds"))
       lead (= (string-index-of label "Kotoba") 0)
       attrs (if lead (document-map :class (document-string "kot-bar") :data-lead (document-string "1")) (document-map :class (document-string "kot-bar")))
       style (string-concat "--w:" (string-concat (fixed (f64-mul 100.0 (f64-div v top)) 1000 3) "%"))
       note (if (f64-eq v best) "fastest here" (string-concat (fixed (f64-div v best) 10 1) "× the fastest here"))
       value-node (if lead (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-value")) (document-string (string-concat display " ms"))
                     (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-note")) (document-string note)))
                    (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-value")) (document-string (string-concat display " ms"))))]
  (document-vector (document-keyword :li) attrs
   (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-label")) (document-string label))
   (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-track"))
    (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-fill") :style (document-string style)))) value-node)))
(defn- absent [tool :document] :document
 (document-vector (document-keyword :li) (document-map :class (document-string "kot-bar"))
  (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-label")) (field tool "label"))
  (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-track kot-bar-track--absent"))
   (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-absent")) (document-string "N/A — not in this target's contract")))
  (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-value")) (document-string "—"))))
(defn- missing-lanes [tools :document work :string i :i64 out :document] :document
 (if (>= i (document-count tools)) out
  (missing-lanes tools work (+ i 1) (if (measured? (result tools i work)) out (document-vector-conj out (absent (item tools i)))))))
(defn- measured-lanes [tools :document work :string top :f64 best :f64 prev :f64 prev-i :i64 out :document] :document
 (let [i (next-index tools work prev prev-i)]
  (if (< i 0) (missing-lanes tools work 0 out)
   (let [d (result tools i work)] (measured-lanes tools work top best (value d) i (document-vector-conj out (lane (item tools i) d top best)))))))
(defn- card [tools :document workloads :document work :string] [:option :document]
 (let [title (field (field workloads work) "label") top (max-value tools work) first (next-index tools work -1.0 -1)
       best (if (>= first 0) (value (result tools first work)) 0.0)]
  (if (or (not (= (document-kind title) :string)) (< first 0) (not (f64-gt best 0.0)) (not (f64-gt top 0.0))) (option-none-of [:option :document])
   (let [lanes (measured-lanes tools work top best -1.0 -1 (document-vector (document-keyword :ol) (document-map :class (document-string "kot-bars"))))]
    (option-some-of [:option :document] (document-vector (document-keyword :div) (document-map :class (document-string "dds-ext-card"))
     (dds/heading-node 4 title "20" "") (document-vector (document-keyword :div) (document-map :class (document-string "kot-chart")) lanes)))))))
(defn render [state [:ref :site/catalog] tag :string generator :string report :string chart :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "5bb0ff5d9e2f80ca7a76545ead6d0138ab7516f2bb712dd4f059d8b0bb4f5ab2"))
       r-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 report))) "4f396299dc966a750cd82e24ef6a930209649b7b4655043a3e64fc91951c9208"))
       c-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 chart))) "651e9bc2bfc31b15493f00c05d2aeaaddd70e9dbec3be55846a389dccb6e9a20"))]
  (if (or (not g-ok) (not r-ok) (not c-ok)) (option-none-of [:option :string])
   (let [decoded (json/decode report) d (result-value-of [:result :document :document] decoded (document-null)) tools (field d "tools") works (field d "workloads")
         a (card tools works "string") b (card tools works "collection") c (card tools works "allocation") e (card tools works "io") f (card tools works "concurrency") g (card tools works "realApp")]
    (if (or (not (result-ok?-of [:result :document :document] decoded)) (not (= (document-kind tools) :vector)) (not (= (document-kind works) :map))
            (not (option-some?-of [:option :document] a)) (not (option-some?-of [:option :document] b)) (not (option-some?-of [:option :document] c))
            (not (option-some?-of [:option :document] e)) (not (option-some?-of [:option :document] f)) (not (option-some?-of [:option :document] g))) (option-none-of [:option :string])
     (let [node (document-vector (document-keyword :div) (document-map :class (document-string "dds-ext-grid") :style (document-map :--dds-ext-grid-min (document-string "19rem")))
             (val a) (val b) (val c) (val e) (val f) (val g))
           localized (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))]
      (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (option-none-of [:option :string]))))))))
