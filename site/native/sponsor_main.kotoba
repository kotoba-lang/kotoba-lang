(ns site.native.sponsor-main (:export [render])
 (:require [site.native.source-concat :as source] [site.native.home-section :as section]
           [site.native.locale-tree :as tree] [site.native.locale-rebase :as rebase]
           [multiformats.sha256 :as sha] [html-hiccup :as html] [button :as button]))
;; Interpret only the pinned sponsor view and its pinned preparing-state data.
;; The result is a private build candidate, not evidence of sponsor activation.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- arg [d :document i :i64] :document (val (document-list-at d i)))
(defn- getv [d :document k :keyword] :document (val (document-get d k)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- none [] [:option :document] (option-none-of [:option :document]))
(defn- some [d :document] [:option :document] (option-some-of [:option :document] d))
(defn- missing [] [:option :string] (option-none-of [:option :string]))
(defn- present [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- digest? [s :string expected :string] :bool (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) expected)))
(defn- build-list [d :document i :i64 ja :bool auth :document out :string] [:option :document]
 (if (>= i (document-count d)) (some (document-edn-read (string-concat out ")")))
  (let [x (transform (arg d i) ja auth)]
   (if (option-some?-of [:option :document] x) (build-list d (+ i 1) ja auth (string-concat out (string-concat (if (= i 0) "" " ") (document-edn-print (val x))))) (none)))))
(defn- build-vector [d :document i :i64 ja :bool auth :document out :document] [:option :document]
 (if (>= i (document-count d)) (some out)
  (let [x (transform (item d i) ja auth)]
   (if (option-some?-of [:option :document] x) (build-vector d (+ i 1) ja auth (document-vector-conj out (val x))) (none)))))
(defn- build-map [d :document i :i64 ja :bool auth :document out :document] [:option :document]
 (if (>= i (document-count d)) (some out)
  (let [pair (val (document-map-entry-at d i)) key (item pair 0) x (transform (item pair 1) ja auth)]
   (if (and (= (document-kind key) :keyword) (option-some?-of [:option :document] x)) (build-map d (+ i 1) ja auth (document-assoc out key (val x))) (none)))))
(defn- build-string [d :document i :i64 ja :bool auth :document out :string] [:option :document]
 (if (>= i (document-count d)) (some (document-string out))
  (let [x (transform (arg d i) ja auth)]
   (if (and (option-some?-of [:option :document] x) (= (document-kind (val x)) :string)) (build-string d (+ i 1) ja auth (string-concat out (text (val x)))) (none)))))
(defn- bullets [items :document i :i64 out :document] [:option :document]
 (if (>= i (document-count items)) (some out)
  (let [x (item items i)]
   (if (= (document-kind x) :string) (bullets items (+ i 1) (document-vector-conj out (document-vector (document-keyword :li) x))) (none)))))
(defn- keyword-text [d :document] :string
 (let [s (document-edn-print d)] (if (and (= (document-kind d) :keyword) (> (string-byte-length s) 1)) (string-substring s 1 (string-byte-length s)) "")))
(defn- transform [d :document ja :bool auth :document] [:option :document]
 (let [k (document-kind d) repr (document-edn-print d)]
  (cond (= k :symbol)
         (cond (string=? repr "root") (some (document-string (if ja "../../" "../")))
               (string=? repr "uses") (some (getv auth :use-of-funds))
               (string=? repr "non-exchange") (some (getv auth :non-exchange))
               (string=? repr "sponsor-profile-url") (some (getv (getv auth :platform) :profile-url))
               :else (some d))
        (= k :vector) (build-vector d 0 ja auth (document-vector))
        (= k :map) (build-map d 0 ja auth (document-map))
        (= k :list)
         (let [head (document-edn-print (arg d 0)) n (document-count d)]
          (cond (string=? repr "(:checked-at sponsorship)") (some (getv auth :checked-at))
                (string=? repr "(str/upper (name (:status sponsorship)))") (some (document-string "PREPARING"))
                (string=? head "if")
                 (let [condition (document-edn-print (arg d 1)) known (or (string=? condition "ja?") (string=? condition "sponsorship-live?"))
                       yes (if (string=? condition "ja?") ja false)]
                  (if (and known (= n 4)) (transform (arg d (if yes 2 3)) ja auth) (none)))
                (string=? head "str") (build-string d 1 ja auth "")
                (string=? head "bullets")
                 (let [xs (transform (arg d 1) ja auth)]
                  (if (and (= n 2) (option-some?-of [:option :document] xs) (= (document-kind (val xs)) :vector))
                   (bullets (val xs) 0 (document-vector (document-keyword :ul) (document-map :class (document-string "kot-list")))) (none)))
                (string=? head "dds/button")
                 (let [label (transform (arg d 1) ja auth) opts (transform (arg d 2) ja auth)
                       o (val opts) kind (keyword-text (getv o :type)) size (text (getv o :size)) href (text (getv o :href))]
                  (if (and (= n 3) (option-some?-of [:option :document] label) (option-some?-of [:option :document] opts)
                           (= (document-kind (val label)) :string) (not (string=? href "")))
                   (button/node (record-new [:ref :btn/opts] kind size href "" "" false false (document-vector)) (val label) (document-map)) (none)))
                :else (build-list d 0 ja auth "(")))
        (or (= k :string) (= k :i64) (= k :f64) (= k :keyword) (= k :bool) (= k :null)) (some d)
        :else (none))))
(defn- piece [state [:ref :site/catalog] tag :string node :document ja :bool auth :document] [:option :string]
 (let [expanded (transform node ja auth) raw (if (option-some?-of [:option :document] expanded) (section/evaluate (val expanded)) (none))
       localized (if (or (string=? tag "en") (not (option-some?-of [:option :document] raw))) raw (tree/map-indexed state (val raw)))
       linked (if (or (string=? tag "en") (not (option-some?-of [:option :document] localized))) localized (rebase/rebase-links (val localized) tag "/sponsor/"))]
  (if (option-some?-of [:option :document] linked) (html/render (val linked) 0) (missing))))
(defn- pieces [state [:ref :site/catalog] tag :string container :document i :i64 ja :bool auth :document out :string] [:option :string]
 (if (>= i (document-count container)) (present (string-concat out "</div></main>"))
  (let [part (piece state tag (arg container i) ja auth)]
   (if (option-some?-of [:option :string] part) (pieces state tag container (+ i 1) ja auth (string-concat out (option-value-of [:option :string] part ""))) (missing)))))
(defn render [state [:ref :site/catalog] tag :string generator :string authority :string] [:option :string]
 (let [a (document-edn-read authority) status (getv a :status) root (source/data generator "(defn sponsor-view [locale]" 40 41)
       view (arg (val root) 2) main (item view 3) container (item main 2)]
  (if (or (not (digest? generator "5bb0ff5d9e2f80ca7a76545ead6d0138ab7516f2bb712dd4f059d8b0bb4f5ab2"))
          (not (digest? authority "f7eed846369300609667cbfa3e0fa79150acd1f88f63bc742bde54ea46f6b380"))
          (not (string=? (document-edn-print status) ":preparing")) (not (option-some?-of [:option :document] root))
          (not (= (document-kind view) :vector)) (not (= (document-kind main) :vector))
          (not (= (document-kind container) :list)) (not (string=? (document-edn-print (arg container 0)) "dds/container"))) (missing)
   (pieces state tag container 1 false a "<main id=\"main\"><div class=\"dds-ext-container\">"))))
