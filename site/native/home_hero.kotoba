(ns site.native.home-hero (:export [render])
 (:require [site.native.home-hero-svg :as svg] [site.native.home-hero-code :as code] [site.native.home-embench-panel :as panel]
           [site.native.home-section :as section] [site.native.source-concat :as source]
           [site.native.locale-tree :as tree] [site.native.locale-rebase :as rebase] [html-hiccup :as html] [button :as button]))
;; Assemble the source-locked hero; independent fragments are inserted only
;; after the enclosing tree has been translated and rebased.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- replace [s :string needle :string value :string] [:option :string]
 (let [p (string-index-of s needle)]
  (if (< p 0) (none)
   (let [tail (string-substring s (+ p (string-byte-length needle)) (string-byte-length s))]
    (if (>= (string-index-of tail needle) 0) (none) (some (string-concat (string-substring s 0 p) (string-concat value tail))))))))
(defn- edit [s [:option :string] needle :string value :string] [:option :string]
 (if (option-some?-of [:option :string] s) (replace (option-value-of [:option :string] s "") needle value) (none)))
(defn- action [label :string href :string kind :string] [:option :document]
 (button/node (record-new [:ref :btn/opts] kind "lg" href "" "" false false (document-vector)) (document-string label) (document-map)))
(defn render [state [:ref :site/catalog] tag :string generator :string hero :string sample :string provenance :string wasm :vector-i64 grammar :string tokenizer :string theme :string report :string chart :string] [:option :string]
 (let [geometry (svg/render generator hero) code-html (code/render state tag generator sample provenance wasm grammar tokenizer theme) panel-html (panel/render generator report chart)
       first (string-index-of generator "(defn hero []") last (string-index-of generator "(defn lisp-machine-stack []")
       a (action "Install and run" "#start" "") b (action "See how it works" "#architecture" "outline") c (action "AI agent setup" "./agent-quickstart.md" "text")]
  (if (or (not (option-some?-of [:option :string] geometry)) (not (option-some?-of [:option :string] code-html)) (not (option-some?-of [:option :string] panel-html))
          (< first 0) (<= last first) (not (option-some?-of [:option :document] a)) (not (option-some?-of [:option :document] b)) (not (option-some?-of [:option :document] c))) (none)
   (let [raw (some (string-substring generator first last))
         s1 (edit raw "(hero-canvas)" "\"987654321001\"") s2 (edit s1 "(hero-code)" "\"987654321002\"") s3 (edit s2 "(embench-panel)" "\"987654321003\"")
         s4 (edit s3 "(dds/container" "(card")
         s5 (edit s4 "(dds/button \"Install and run\" {:href \"#start\" :size \"lg\"})" (document-edn-print (val a)))
         s6 (edit s5 "(dds/button \"See how it works\" {:href \"#architecture\" :type :outline :size \"lg\"})" (document-edn-print (val b)))
         s7 (edit s6 "(dds/button \"AI agent setup\" {:href \"./agent-quickstart.md\" :type :text :size \"lg\"})" (document-edn-print (val c)))
         form (if (option-some?-of [:option :string] s7) (source/data (option-value-of [:option :string] s7 "") "(defn hero []" 91 93) (option-none-of [:option :document]))
         node (if (option-some?-of [:option :document] form) (section/evaluate (val form)) (option-none-of [:option :document]))
         localized (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)
         rebased (if (and (option-some?-of [:option :document] localized) (not (string=? tag "en"))) (rebase/rebase-links (val localized) tag "/") localized)]
    (if (not (option-some?-of [:option :document] rebased)) (none)
     (let [frame (html/render (val rebased) 0)
           fixed (edit frame "<div class=\"dds-ext-card\"><p class=\"kot-eyebrow\">" "<div class=\"dds-ext-container\"><p class=\"kot-eyebrow\">")
           with-svg (edit fixed "987654321001" (string-concat "<div class=\"kot-hero-canvas\" id=\"kot-hero-canvas\" aria-hidden=\"true\">" (string-concat (option-value-of [:option :string] geometry "") "</div>")))
           with-code (edit with-svg "987654321002" (option-value-of [:option :string] code-html ""))]
      (edit with-code "987654321003" (option-value-of [:option :string] panel-html ""))))))))
