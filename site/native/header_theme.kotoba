(ns site.native.header-theme (:export [render-theme])
 (:require [site.native.locale-tree :as tree] [html-hiccup :as html] [theme-toggle :as theme]))
(defn render-theme [state [:ref :site/catalog] tag :string] [:option :string]
 (let [raw (theme/control)]
  (if (option-some?-of [:option :document] raw)
   (let [translated (if (string=? tag "en") raw (tree/map-indexed state (option-value-of [:option :document] raw (document-null))))]
    (if (option-some?-of [:option :document] translated)
     (html/render (option-value-of [:option :document] translated (document-null)) 0)
     (option-none-of [:option :string])))
   (option-none-of [:option :string]))))
