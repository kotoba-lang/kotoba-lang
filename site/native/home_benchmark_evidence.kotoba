(ns site.native.home-benchmark-evidence (:export [run]) (:capabilities [:io/write])
 (:require [json.core :as json] [site.native.source-concat :as source]
           [site.native.locale-tree :as tree] [site.native.locale-rebase :as rebase]
           [site.native.home-section :as home] [html-hiccup :as html]
           [table :as table] [button :as button] [multiformats.sha256 :as sha]))
;; Complete the benchmark's provenance and interpretation from pinned source
;; and dated reports. These observations never mint a new performance claim.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- field [d :document k :keyword] :document (val (document-get d k)))
(defn- jfield [d :document k :string] :document (val (document-get d (document-string k))))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- arg [d :document i :i64] :document (val (document-list-at d i)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- some [d :document] [:option :document] (option-some-of [:option :document] d))
(defn- none [] [:option :document] (option-none-of [:option :document]))
(defn- absent [] [:option :string] (option-none-of [:option :string]))
(defn- present [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- out [o [:option :string]] :string (option-value-of [:option :string] o ""))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b)) (present (string-concat (out a) (out b))) (absent)))
(defn- digest? [s :string h :string] :bool
 (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) h)))
(defn- labels [xs :document i :i64 s :string] :string
 (if (>= i (document-count xs)) s
  (labels xs (+ i 1) (string-concat s (string-concat (if (= i 0) "" ", ") (text (jfield (item xs i) "label")))))))
(defn- value [d :document runtime :document scaling :document] :document
 (let [s (document-edn-print d)]
  (cond (string=? s "comparator-labels") (document-string (labels (jfield runtime "comparators") 0 ""))
        (string=? s "(:qualifiedPairs runtime-score)") (jfield (jfield runtime "score") "qualifiedPairs")
        (string=? s "(:totalPairs runtime-score)") (jfield (jfield runtime "score") "totalPairs")
        (string=? s "(get-in runtime-benchmark [:sources :method])") (jfield (jfield runtime "sources") "method")
        (string=? s "(get-in runtime-benchmark [:sources :harness])") (jfield (jfield runtime "sources") "harness")
        (string=? s "(get-in runtime-benchmark [:sources :manifest])") (jfield (jfield runtime "sources") "manifest")
        (string=? s "(get-in build-scaling [:method :harness])") (jfield (jfield scaling "method") "harness")
        :else d)))
(defn- link [url :string label :string external :bool] :document
 (document-vector (document-keyword :a)
  (if external (document-map :class (document-string "kot-link") :href (document-string url) :rel (document-string "noreferrer"))
   (document-map :class (document-string "kot-link") :href (document-string url))) (document-string label)))
(defn- blob [repo :string path :string] :string
 (string-concat "https://github.com/" (string-concat repo (string-concat "/blob/main/" path))))
(defn- basename [url :string] :string
 (let [h (string-index-of url "#") s (if (< h 0) url (string-substring url 0 h)) n (string-byte-length s)]
  (loop [i (- n 1)] (if (< i 0) s (if (= (string-code-point-at s i) 47) (string-substring s (+ i 1) n) (recur (- i 1)))))))
(defn- extras [xs :document i :i64 span :document repo :string urls :bool runtime :document scaling :document] :document
 (if (or (not (= (document-kind xs) :vector)) (>= i (document-count xs))) span
  (let [v (value (item xs i) runtime scaling) s (text v)]
   (extras xs (+ i 1) (if (= (document-kind v) :null) span
    (document-vector-conj (document-vector-conj span (document-string " · ")) (link (if urls s (blob repo s)) (if urls (basename s) s) true))) repo urls runtime scaling))))
(defn- provenance-row [d :document runtime :document scaling :document] :document
 (let [repo (text (field d :repo)) local (text (field d :harness)) remote (text (value (field d :harness-url) runtime scaling))
       first (document-vector (document-keyword :span) (link (if (string=? remote "") (blob repo local) remote) (if (string=? remote "") local (basename remote)) true))
       second (extras (field d :extra) 0 first repo false runtime scaling)
       third (extras (field d :extra-urls) 0 second repo true runtime scaling)
       projector (text (field d :projector)) report (text (field d :report))
       harness (if (string=? projector "") third (document-vector-conj (document-vector-conj third (document-string " · ")) (link (blob "kotoba-lang/kotoba-lang" projector) projector true)))]
  (document-vector (field d :question) (link (string-concat "https://github.com/" repo) repo true) harness
   (document-vector (document-keyword :span) (link (text (field d :published)) "published JSON" false) (document-string " · ") (link (blob "kotoba-lang/kotoba-lang" report) report true)))))
(defn- provenance [xs :document i :i64 runtime :document scaling :document rows :document] :document
 (if (>= i (document-count xs)) rows (provenance xs (+ i 1) runtime scaling (document-vector-conj rows (provenance-row (item xs i) runtime scaling)))))
(defn- domains [xs :document i :i64 rows :document] :document
 (if (>= i (document-count xs)) rows
  (let [x (item xs i)] (domains xs (+ i 1) (document-vector-conj rows
   (document-vector (jfield x "label") (document-string (text (jfield x "stress")))
    (document-string (if (option-value-of [:option :bool] (document-bool-value (jfield x "exactResultVerified")) false) "Exact result verified; timing unqualified" "Incomplete"))))))))
(defn- table-head [xs :document i :i64 row :document] :document
 (if (>= i (document-count xs)) row (table-head xs (+ i 1) (document-vector-conj row (table/header-cell-node (item xs i) false)))))
(defn- cells [xs :document i :i64 row :document] :document
 (if (>= i (document-count xs)) row (cells xs (+ i 1) (document-vector-conj row (val (table/body-cell-node (record-new [:ref :tbl/cell] true i) (item xs i)))))))
(defn- table-rows [xs :document i :i64 body :document] :document
 (if (>= i (document-count xs)) body (table-rows xs (+ i 1) (document-vector-conj body (cells (item xs i) 0 (document-vector (document-keyword :tr)))))))
(defn- table-node [caption :document headers :document rows :document] :document
 (document-vector (document-keyword :div) (document-map :class (document-string "dads-table"))
  (document-vector (document-keyword :table) (document-map :class (document-string "dads-table__table"))
   (document-vector (document-keyword :caption) caption)
   (document-vector (document-keyword :thead) (table-head headers 0 (document-vector (document-keyword :tr))))
   (table-rows rows 0 (document-vector (document-keyword :tbody))))))
(defn- vectors [d :document i :i64 runtime :document scaling :document prov :document result :document] [:option :document]
 (if (>= i (document-count d)) (some result)
  (let [v (transform (item d i) runtime scaling prov)]
   (if (option-some?-of [:option :document] v) (vectors d (+ i 1) runtime scaling prov (document-vector-conj result (val v))) (none)))))
(defn- lists [d :document i :i64 runtime :document scaling :document prov :document s :string] [:option :document]
 (if (>= i (document-count d)) (some (document-edn-read (string-concat s ")")))
  (let [v (transform (arg d i) runtime scaling prov)]
   (if (option-some?-of [:option :document] v) (lists d (+ i 1) runtime scaling prov (string-concat s (string-concat (if (= i 0) "" " ") (document-edn-print (val v))))) (none)))))
(defn- strings [d :document i :i64 runtime :document scaling :document s :string] [:option :document]
 (if (>= i (document-count d)) (some (document-string s))
  (let [v (value (arg d i) runtime scaling) k (document-kind v)]
   (if (or (= k :string) (= k :i64)) (strings d (+ i 1) runtime scaling (string-concat s (if (= k :string) (text v) (document-edn-print v)))) (none)))))
(defn- caption-parts [d :document i :i64 runtime :document scaling :document prov :document node :document] [:option :document]
 (if (>= i (document-count d)) (some node)
  (let [v (transform (arg d i) runtime scaling prov) evaluated (if (option-some?-of [:option :document] v) (home/evaluate (val v)) (none))]
   (if (option-some?-of [:option :document] evaluated) (caption-parts d (+ i 1) runtime scaling prov (document-vector-conj node (val evaluated))) (none)))))
(defn- transform [d :document runtime :document scaling :document prov :document] [:option :document]
 (let [k (document-kind d) resolved (value d runtime scaling)]
  (cond (not (string=? (document-edn-print d) (document-edn-print resolved))) (some resolved)
        (= k :vector) (vectors d 0 runtime scaling prov (document-vector))
        (= k :list)
         (let [name (document-edn-print (arg d 0))]
          (cond (string=? name "str") (strings d 1 runtime scaling "")
                (string=? name "dds/table")
                 (let [opts (arg d 1) raw (field opts :rows) rows
                       (cond (string=? (document-edn-print raw) "(benchmark-provenance-rows)") (some (provenance prov 0 runtime scaling (document-vector)))
                             (= (document-kind raw) :list) (if (string=? (document-edn-print (arg raw 0)) "for") (some (domains (jfield runtime "domains") 0 (document-vector))) (none))
                             :else (transform raw runtime scaling prov))]
                  (if (option-some?-of [:option :document] rows) (some (table-node (field opts :caption) (field opts :headers) (val rows))) (none)))
                (string=? name "dds/button")
                 (let [opts (arg d 2) href (value (field opts :href) runtime scaling) type (document-edn-print (field opts :type))]
                  (if (= (document-kind href) :string)
                   (button/node (record-new [:ref :btn/opts] (if (string=? type ":outline") "outline" "") "" (text href) "" "" false false (document-vector)) (arg d 1) (document-map)) (none)))
                (and (string=? name "caption") (= (document-kind (arg d 1)) :list) (string=? (document-edn-print (arg (arg d 1) 0)) "list"))
                 (caption-parts (arg d 1) 1 runtime scaling prov (document-vector (document-keyword :p) (document-map :class (document-string "kot-muted kot-caption"))))
                :else (lists d 0 runtime scaling prov "(")))
        (or (= k :string) (= k :keyword) (= k :map) (= k :i64) (= k :bool) (= k :null) (= k :symbol)) (some d)
        :else (none))))
(defn- fragment [state [:ref :site/catalog] tag :string generator :string marker :string open :i64 close :i64 runtime :document scaling :document prov :document] [:option :string]
 (let [p (string-index-of generator marker) src (if (< p 0) "" (string-substring generator p (string-byte-length generator)))
       raw (if (< p 0) (none) (source/data (string-concat "~FORM~" src) "~FORM~" open close))
       prepared (if (option-some?-of [:option :document] raw) (transform (val raw) runtime scaling prov) (none))
       node (if (option-some?-of [:option :document] prepared) (home/evaluate (val prepared)) (none))
       local (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)
       bounded (if (and (option-some?-of [:option :document] local) (not (string=? tag "en"))) (rebase/rebase-links (val local) tag "/") local)]
  (if (option-some?-of [:option :document] bounded) (html/render (val bounded) 0) (absent))))

(defn- emit [value [:option :string]] :bool
 (if (not (option-some?-of [:option :string] value)) false
  (let [ignored (typed-cap-call :io/write :string :string (out value))] true)))
(defn run [state [:ref :site/catalog] tag :string generator :string runtime-json :string scaling-json :string] :i64
 (let [r (json/decode runtime-json) s (json/decode scaling-json)
       runtime (result-value-of [:result :document :document] r (document-null)) scaling (result-value-of [:result :document :document] s (document-null))
       raw (source/data generator "(def benchmark-provenance" 91 93) prov (val raw)
       start (string-index-of generator "[:div {:class \"kot-table-scroll\"}\n      (dds/table\n       {:caption \"What each public benchmark")
       content (if (< start 0) "" (string-substring generator start (string-byte-length generator)))]
  (if (or (not (digest? generator "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67"))
          (not (digest? runtime-json "33f6e504389f03f0d3f5f91a68d157f83a86a5366acf21311e6b7494783effe9"))
          (not (digest? scaling-json "9bb56646bb55a8746b36c66c42ebefb48bebd17ab60c4df79a2ab1702537e229"))
          (not (result-ok?-of [:result :document :document] r)) (not (result-ok?-of [:result :document :document] s))
          (not (option-some?-of [:option :document] raw)) (not (= (document-count prov) 5))) 7
   (if (and
    (arena-scope (emit (fragment state tag content "[:div {:class \"kot-table-scroll\"}\n      (dds/table\n       {:caption \"What each public benchmark" 91 93 runtime scaling prov)))
    (arena-scope (emit (fragment state tag content "(dds/heading 3 \"What the native suite covers\"" 40 41 runtime scaling prov)))
    (arena-scope (emit (fragment state tag content "[:p\n      \"Each implementation returns an independently" 91 93 runtime scaling prov)))
    (arena-scope (emit (fragment state tag content "[:div {:class \"kot-table-scroll\"}\n      (dds/table\n       {:caption \"Six required native runtime" 91 93 runtime scaling prov)))
    (arena-scope (emit (fragment state tag content "(dds/heading 3 \"Where each benchmark lives\"" 40 41 runtime scaling prov)))
    (arena-scope (emit (fragment state tag content "[:p\n      \"Every number above comes from a public harness" 91 93 runtime scaling prov)))
    (emit-provenance state tag prov runtime scaling)
    (arena-scope (emit (fragment state tag content "(caption\n      (list \"The gate every ordering" 40 41 runtime scaling prov)))
    (arena-scope (emit (fragment state tag content "[:p\n      [:strong \"Bottom line: \"]" 91 93 runtime scaling prov)))
    (arena-scope (emit (fragment state tag content "[:div {:class \"kot-actions\"}\n      (dds/button \"Inspect compile samples\"" 91 93 runtime scaling prov)))
   ) 42 7))))


(defn- localized [state [:ref :site/catalog] tag :string node :document] [:option :string]
 (let [local (if (string=? tag "en") (some node) (tree/map-indexed state node))
       bounded (if (and (option-some?-of [:option :document] local) (not (string=? tag "en"))) (rebase/rebase-links (val local) tag "/") local)]
  (if (option-some?-of [:option :document] bounded) (html/render (val bounded) 0) (absent))))
(defn- emit-provenance-rows [state [:ref :site/catalog] tag :string prov :document runtime :document scaling :document i :i64] :bool
 (if (>= i (document-count prov)) true
  (and (arena-scope (emit (localized state tag (cells (provenance-row (item prov i) runtime scaling) 0 (document-vector (document-keyword :tr))))))
       (emit-provenance-rows state tag prov runtime scaling (+ i 1)))))
(defn- emit-provenance [state [:ref :site/catalog] tag :string prov :document runtime :document scaling :document] :bool
 (let [frame (localized state tag (document-vector (document-keyword :div) (document-map :class (document-string "kot-table-scroll"))
              (table-node (document-string "Harness, method and report for each published benchmark")
               (document-vector (document-string "Benchmark") (document-string "Repository") (document-string "Harness and method") (document-string "Report")) (document-vector))))
       text (out frame) marker (string-index-of text "<tbody>")]
  (if (or (not (option-some?-of [:option :string] frame)) (< marker 0)) false
   (let [ignored (typed-cap-call :io/write :string :string (string-substring text 0 (+ marker 7)))]
    (if (not (emit-provenance-rows state tag prov runtime scaling 0)) false
     (let [after (typed-cap-call :io/write :string :string (string-substring text (+ marker 7) (string-byte-length text)))] true))))))
