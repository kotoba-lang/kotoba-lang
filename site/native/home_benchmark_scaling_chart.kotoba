(ns site.native.home-benchmark-scaling-chart (:export [render])
 (:require [site.native.scaling-series :as geometry] [site.native.scaling-axis :as axis]
           [site.native.locale-tree :as tree] [multiformats.sha256 :as sha] [html-hiccup :as html]))
;; SVG for the pinned build-scaling chart. Elements are localized and rendered
;; separately to avoid requiring a deep whole-chart document allocation.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- getv [d :document k :keyword] :document (val (document-get d k)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- number [d :document] :f64
 (if (= (document-kind d) :i64) (i64-to-f64-rounded (option-value-of [:option :i64] (document-i64-value d) 0))
  (option-value-of [:option :f64] (document-f64-value d) 0.0)))
(defn- fixed1 [x :f64] :string
 (let [v (f64-to-i64-truncating (f64-add (f64-mul x 10.0) 0.5))]
  (string-concat (string-from-i64 (quot v 10)) (string-concat "." (string-from-i64 (rem v 10))))))
(defn- emit [state [:ref :site/catalog] tag :string node :document] [:option :string]
 (let [localized (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))]
  (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (option-none-of [:option :string]))))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
  (option-some-of [:option :string] (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (option-none-of [:option :string])))
(defn- coord [g :document v :document which :keyword] :f64
 (let [lo (if (= which :x) (getv g :xmin) (getv g :ymin)) hi (if (= which :x) (getv g :xmax) (getv g :ymax))]
  (number (val (axis/coordinate v lo hi which)))))
(defn- axes-y [state [:ref :site/catalog] tag :string g :document ticks :document i :i64 mode :i64 out [:option :string]] [:option :string]
 (if (>= i (document-count ticks)) out
  (let [tick (item ticks i) v (item tick 0) label (item tick 1) y (coord g v :y)
        node (if (= mode 0) (document-vector (document-keyword :line) (document-map :class (document-string "kot-grid") :x1 (document-i64 72) :x2 (document-i64 608) :y1 (document-string (fixed1 y)) :y2 (document-string (fixed1 y))))
              (document-vector (document-keyword :text) (document-map :class (document-string "kot-tick kot-tick-y") :x (document-i64 64) :y (document-string (fixed1 (f64-add y 4.0)))) label))]
   (axes-y state tag g ticks (+ i 1) mode (append out (emit state tag node))))))
(defn- axes-x [state [:ref :site/catalog] tag :string g :document ticks :document i :i64 out [:option :string]] [:option :string]
 (if (>= i (document-count ticks)) out
  (let [tick (item ticks i) x (coord g (item tick 0) :x)
        node (document-vector (document-keyword :text) (document-map :class (document-string "kot-tick kot-tick-x") :x (document-string (fixed1 x)) :y (document-i64 332)) (item tick 1))]
   (axes-x state tag g ticks (+ i 1) (append out (emit state tag node))))))
(defn- next-index [series :document prev :f64 previous :i64] :i64
 (loop [i 0 best -1 bestval 0.0]
  (if (>= i (document-count series)) best
   (let [v (number (getv (item series i) :ey)) after (or (f64-gt v prev) (and (f64-eq v prev) (> i previous))) choose (and after (or (< best 0) (f64-lt v bestval)))]
    (recur (+ i 1) (if choose i best) (if choose v bestval))))))
;; Order and preliminary label anchors use one entry per series, not rounded.
(defn- anchors [series :document indices :vector-i64 ys :vector-i64] :vector-i64
 (loop [i 0 prev -1.0 previous -1 label-y 9.0]
  (if (>= i (document-count series)) ys
   (let [idx (next-index series prev previous) ey (number (getv (item series idx) :ey)) next-y (f64-max ey (f64-add label-y 15.0))
         a (vector-assoc! indices i idx) b (vector-assoc! ys i (f64-to-bits next-y))]
    (recur (+ i 1) ey idx next-y)))))
(defn- line-node [d :document] :document
 (let [accent (option-value-of [:option :bool] (document-bool-value (getv d :accent)) false)
       attrs (document-map :class (document-string "kot-line") :d (getv d :path) :pathLength (document-i64 1000) :data-series (getv d :id))
       a (if accent (document-assoc attrs :data-accent (document-string "1")) attrs)]
  (document-vector (document-keyword :path) a)))
(defn- series-lines [state [:ref :site/catalog] tag :string series :document i :i64 out [:option :string]] [:option :string]
 (if (>= i (document-count series)) out (series-lines state tag series (+ i 1) (append out (emit state tag (line-node (item series i)))))))
(defn- mark-node [d :document] :document
 (let [x (number (getv d :ex)) y (number (getv d :ey)) kind (text (getv d :end)) accent (option-value-of [:option :bool] (document-bool-value (getv d :accent)) false)
       base (document-map :class (document-string (if (string=? kind "cross") "kot-end kot-end-broke" "kot-end kot-end-refused")))
       attrs (if accent (document-assoc base :data-accent (document-string "1")) base)]
  (if (string=? kind "circle")
   (let [circle (document-map :class (document-string "kot-end") :cx (document-string (fixed1 x)) :cy (document-string (fixed1 y)) :r (document-i64 4))]
    (document-vector (document-keyword :circle) (if accent (document-assoc circle :data-accent (document-string "1")) circle)))
   (let [path (if (string=? kind "cross")
                (string-concat "M" (string-concat (fixed1 (f64-sub x 4.5)) (string-concat " " (string-concat (fixed1 (f64-sub y 4.5))
                 (string-concat "l9 9M" (string-concat (fixed1 (f64-add x 4.5)) (string-concat " " (string-concat (fixed1 (f64-sub y 4.5)) "l-9 9"))))))))
                (string-concat "M" (string-concat (fixed1 x) (string-concat " " (string-concat (fixed1 (f64-sub y 5.5)) "v11")))))]
    (document-vector (document-keyword :g) attrs (document-vector (document-keyword :path) (document-map :d (document-string path))))))))
(defn- ordered-nodes [state [:ref :site/catalog] tag :string series :document indices :vector-i64 ys :vector-i64 i :i64 mode :i64 out [:option :string]] [:option :string]
 (if (>= i (document-count series)) out
  (let [d (item series (vector-at indices i)) x (number (getv d :ex)) y (number (getv d :ey))
        overflow (f64-max 0.0 (f64-sub (f64-from-bits (vector-at ys (- (document-count series) 1))) 312.0))
        ly (f64-max 24.0 (f64-sub (f64-from-bits (vector-at ys i)) overflow)) accent (option-value-of [:option :bool] (document-bool-value (getv d :accent)) false)
        base (document-map :class (document-string "kot-line-label") :x (document-i64 626) :y (document-string (fixed1 (f64-add ly 4.0))))
        node (cond (= mode 0) (document-vector (document-keyword :path) (document-map :class (document-string "kot-leader")
              :d (document-string (string-concat "M" (string-concat (fixed1 (f64-add x 6.0)) (string-concat " " (string-concat (fixed1 y) (string-concat "L622.0 " (fixed1 ly)))))))))
                   (= mode 1) (mark-node d)
                   :else (document-vector (document-keyword :text) (if accent (document-assoc base :data-accent (document-string "1")) base) (getv d :label)))]
   (ordered-nodes state tag series indices ys (+ i 1) mode (append out (emit state tag node))))))
(defn render [state [:ref :site/catalog] tag :string generator :string report :string chart :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67"))
       c-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 chart))) "651e9bc2bfc31b15493f00c05d2aeaaddd70e9dbec3be55846a389dccb6e9a20"))]
  (if (or (not g-ok) (not c-ok)) (option-none-of [:option :string])
   (let [g (geometry/geometry report)]
    (if (not (option-some?-of [:option :document] g)) (option-none-of [:option :string])
     (let [geo (val g) series (getv geo :series) n (document-count series)]
      (if (or (not (= (document-kind series) :vector)) (<= n 0)) (option-none-of [:option :string])
     (let [indices (vector-alloc n) labels (anchors series indices (vector-alloc n))
           yt (document-vector (document-vector (document-i64 20) (document-string "20 ms")) (document-vector (document-i64 100) (document-string "100 ms"))
                               (document-vector (document-i64 1000) (document-string "1 s")) (document-vector (document-i64 10000) (document-string "10 s")))
           xt (document-vector (document-vector (document-i64 1) (document-string "K=1")) (document-vector (document-i64 32) (document-string "32"))
                               (document-vector (document-i64 128) (document-string "128")) (document-vector (document-i64 512) (document-string "512")) (document-vector (document-i64 2048) (document-string "2048")))
           empty (option-some-of [:option :string] "") ylines (axes-y state tag geo yt 0 0 empty) ytext (axes-y state tag geo yt 0 1 ylines)
           xtext (axes-x state tag geo xt 0 ytext)
           ax1 (document-vector (document-keyword :text) (document-map :class (document-string "kot-axis-title") :x (document-i64 340) :y (document-i64 352)) (document-string "Generated functions (log scale)"))
           ax2 (document-vector (document-keyword :text) (document-map :class (document-string "kot-axis-title kot-axis-title-y") :transform (document-string "rotate(-90 13 165)") :x (document-i64 13) :y (document-i64 165)) (document-string "Build wall time (log scale)"))
           titles (append (append xtext (emit state tag ax1)) (emit state tag ax2)) lines (series-lines state tag series 0 titles)
           leaders (ordered-nodes state tag series indices labels 0 0 lines) marks (ordered-nodes state tag series indices labels 0 1 leaders)
           children (ordered-nodes state tag series indices labels 0 2 marks)
           aria (string-concat "Build wall time (log scale) against Generated functions (log scale) for " (string-concat (string-from-i64 n) " toolchain lanes"))
           shell (document-vector (document-keyword :div) (document-map :class (document-string "kot-chart kot-chart-scroll"))
                   (document-vector (document-keyword :svg) (document-map :class (document-string "kot-lines") :viewBox (document-string "0 0 760 360") :width (document-i64 760) :height (document-i64 360) :role (document-string "img") :aria-label (document-string aria)) (document-string "987654321014")))
           frame (emit state tag shell) raw (option-value-of [:option :string] frame "") marker (string-index-of raw "987654321014")]
      (if (or (not (option-some?-of [:option :string] children)) (not (option-some?-of [:option :string] frame)) (< marker 0)) (option-none-of [:option :string])
       (option-some-of [:option :string] (string-concat (string-substring raw 0 marker) (string-concat (option-value-of [:option :string] children "") (string-substring raw (+ marker 12) (string-byte-length raw))))))))))))))
