(ns site.native.home-play (:export [script])
 (:require [site.native.source-concat :as concat] [multiformats.sha256 :as sha]))
;; The demo script is source-derived, and its embedded digest is taken from the
;; provenance after verifying that the bundled source and Wasm match it.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- txt [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- hash-string [s :string] :string (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn script [generator :string source :string provenance :string wasm :vector-i64] [:option :string]
 (if (not (and (arena-scope (string=? (hash-string generator) "5bb0ff5d9e2f80ca7a76545ead6d0138ab7516f2bb712dd4f059d8b0bb4f5ab2"))
               (arena-scope (string=? (hash-string provenance) "ec1b696881da677ea86cad3bc47297f65781d3af3c3e776a26e7c2752edccd2b"))
               (arena-scope (string=? (hash-string source) "0471d55d668ed5f9887f9d2520ced9098d03dbbd57086dd3449e98dfb95f2e6b")))) (none)
  (let [record (document-edn-read provenance) output (val (document-get (val (document-get record :outputs)) :primary))
        expected (txt (val (document-get output :sha256))) source-hash (txt (val (document-get record :source-sha256)))
        size (option-value-of [:option :i64] (document-i64-value (val (document-get output :size))) -1)
        found (string-index-of generator "(def play-js\n")]
   (if (or (< found 0) (not (= size (vector-count wasm))) (not (string=? source-hash (hash-string source)))
           (not (arena-scope (string=? expected (sha/digest-hex wasm))))) (none)
    (let [tail (string-substring generator found (string-byte-length generator)) symbol "play-sha256" i (string-index-of tail symbol)]
     (if (< i 0) (none)
      (let [after (string-substring tail (+ i (string-byte-length symbol)) (string-byte-length tail))]
       (if (>= (string-index-of after symbol) 0) (none)
        (let [bound (string-concat (string-substring tail 0 i) (string-concat "\"" (string-concat expected (string-concat "\"" after))))]
         (concat/extract bound "  (str " "" "" false))))))))))
