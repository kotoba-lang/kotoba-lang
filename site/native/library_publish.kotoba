(ns site.native.library-publish (:export [render])
 (:require [site.native.source-concat :as source] [site.native.home-section :as home]
           [site.native.locale-tree :as tree] [site.native.locale-rebase :as rebase]
           [multiformats.sha256 :as sha] [multiformats.cid :as cid] [html-hiccup :as html]))
;; Historical source-pinned publish section. This does not qualify hosted publication.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- arg [d :document i :i64] :document (val (document-list-at d i)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- none [] [:option :document] (option-none-of [:option :document]))
(defn- some [d :document] [:option :document] (option-some-of [:option :document] d))
(defn- list-build [d :document i :i64 out :string] [:option :document]
 (if (>= i (document-count d)) (some (document-edn-read (string-concat out ")")))
  (let [v (transform (arg d i))] (if (option-some?-of [:option :document] v) (list-build d (+ i 1) (string-concat out (string-concat (if (= i 0) "" " ") (document-edn-print (val v))))) (none)))))
(defn- vector-build [d :document i :i64 out :document] [:option :document]
 (if (>= i (document-count d)) (some out) (let [v (transform (item d i))] (if (option-some?-of [:option :document] v) (vector-build d (+ i 1) (document-vector-conj out (val v))) (none)))))
(defn- bullet-rows [d :document i :i64 out :document] [:option :document]
 (if (>= i (document-count d)) (some out) (let [v (item d i)]
  (if (= (document-kind v) :string) (bullet-rows d (+ i 1) (document-vector-conj out (document-vector (document-keyword :li) v))) (none)))))
(defn- concat-strings [d :document i :i64 out :string] [:option :document]
 (if (>= i (document-count d)) (some (document-string out))
  (let [x (arg d i)] (if (= (document-kind x) :string) (concat-strings d (+ i 1) (string-concat out (option-value-of [:option :string] (document-string-value x) ""))) (none)))))
(defn- transform [d :document] [:option :document]
 (let [k (document-kind d)]
  (cond (= k :vector) (vector-build d 0 (document-vector))
        (= k :list) (let [head (document-edn-print (arg d 0))]
         (if (string=? head "str") (concat-strings d 1 "")
          (if (string=? head "bullets")
          (let [xs (arg d 1)] (if (and (= (document-count d) 2) (= (document-kind xs) :vector)) (bullet-rows xs 0 (document-vector (document-keyword :ul) (document-map :class (document-string "kot-list")))) (none)))
          (list-build d 0 "("))))
        (or (= k :string) (= k :i64) (= k :keyword) (= k :map) (= k :symbol)) (some d)
        :else (none))))
(defn- locale? [s :string] :bool
 (or (string=? s "en") (string=? s "ar") (string=? s "arz") (string=? s "bn") (string=? s "de") (string=? s "es") (string=? s "fr") (string=? s "hi") (string=? s "id") (string=? s "ja") (string=? s "ko") (string=? s "mr") (string=? s "pcm") (string=? s "pt") (string=? s "ru") (string=? s "ur") (string=? s "zh-Hans")))
(defn render [state [:ref :site/catalog] tag :string generator :string registry :string which :string] [:option :string]
 (let [ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "ca2955ee08ec6891787d7636238b1bc7b0ab64b807c4c8ce653ec03657d6c072"))
       registry-digest (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 registry)))
       registry-ok (string=? registry-digest "62c7653855b82bd941f9d9cf619dca8f1ee3ba655f32d8d9d2bbf132b402f29b")
       start (string-index-of generator "(defn libraries-view []") stop (string-index-of generator "(defn libraries-ja-view []")]
  (if (or (not ok) (not registry-ok) (< start 0) (<= stop start) (not (string=? which "publish")) (not (locale? tag))) (option-none-of [:option :string])
   (let [source (string-substring generator start stop) marker " package-registry-cid " cid-value (cid/cidv1 85 registry-digest) src (string-replace-all source marker (string-concat " " (string-concat (document-edn-print (document-string cid-value)) " "))) anchor "(dds/section\n        {:id \"publish\""
         at (string-index-of src anchor) tail (if (< at 0) "" (string-substring src at (string-byte-length src)))
         form (source/data (string-concat "~FORM~" tail) "~FORM~" 40 41)
         transformed (if (option-some?-of [:option :document] form) (transform (val form)) (none))
         node (if (option-some?-of [:option :document] transformed) (home/evaluate (val transformed)) (none))
         local (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)
         bound (if (and (option-some?-of [:option :document] local) (not (string=? tag "en"))) (rebase/rebase-links (val local) tag "/") local)]
    (if (option-some?-of [:option :document] bound) (html/render (val bound) 0) (option-none-of [:option :string]))))))
