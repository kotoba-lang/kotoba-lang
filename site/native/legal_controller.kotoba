(ns site.native.legal-controller (:export [main])
 (:capabilities [:fs/app-data-bytes :process/spawn :cli/args :io/write])
 (:require [site.native.home-document :as document] [multiformats.sha256 :as sha]))
;; Mac amu-cli-host entry. The caller supplies trusted, private immutable input
;; directories, expected image digests, and an empty private scratch directory.
;; Only a successful complete page is emitted on stdout; captures stay in scratch.
(defn- bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- text [v :vector-i64] :string (string-from-utf8 (bytes-from-vector-i64 v)))
(defn- zero [] :string (string-from-utf8 (bytes-from-vector-i64 [0])))
(defn- field [s :string] :string (string-concat s (zero)))
(defn- cat [a :vector-i64 b :vector-i64] :vector-i64
 (let [n (vector-count a) m (vector-count b)
       x (loop [i 0 v (vector-alloc (+ n m))]
           (if (= i n) v (recur (+ i 1) (vector-assoc! v i (vector-at a i)))))]
  (loop [i 0 v x] (if (= i m) v (recur (+ i 1) (vector-assoc! v (+ n i) (vector-at b i)))))))
(defn- slice [v :vector-i64 start :i64 n :i64] :vector-i64
 (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ start i)))))))
(defn- frame [op :i64 tail :vector-i64] :vector-i64 (cat [0 65 77 85 72 1 op] tail))
(defn- read [p :string] :vector-i64
 (vector-i64-from-bytes (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-from-vector-i64 (frame 1 (bytes (field p)))))))
(defn- ok? [v :vector-i64] :bool (and (> (vector-count v) 0) (= (vector-at v 0) 0)))
(defn- missing? [v :vector-i64] :bool (and (>= (vector-count v) 2) (= (vector-at v 0) 1) (= (vector-at v 1) 2)))
(defn- payload [v :vector-i64] :vector-i64 (if (ok? v) (slice v 1 (- (vector-count v) 1)) []))
(defn- hex [n :i64] :i64 (cond (and (>= n 48) (<= n 57)) (- n 48) (and (>= n 65) (<= n 70)) (- n 55) :else -1))
(defn- proc-reply [s :string] :vector-i64
 (let [v (bytes s)]
  (if (and (= (vector-count v) 5) (or (= (vector-at v 0) 48) (= (vector-at v 0) 49))
           (>= (hex (vector-at v 1)) 0) (>= (hex (vector-at v 2)) 0) (>= (hex (vector-at v 3)) 0) (>= (hex (vector-at v 4)) 0))
   [(- (vector-at v 0) 48) (+ (* 16 (hex (vector-at v 1))) (hex (vector-at v 2))) (+ (* 16 (hex (vector-at v 3))) (hex (vector-at v 4)))]
   [1 22 0])))
(defn- spawn [dir :string capture :string exe :string tag :string] :vector-i64
 (let [args (string-concat (field dir) (string-concat (field capture) (string-concat (field exe) (string-concat (field "site-part") (field tag)))))
       request (frame 9 (cat [1 2] (bytes args)))]
  (proc-reply (typed-cap-call :process/spawn :string :string (text request)))))
(defn- success? [r :vector-i64] :bool (and (= (vector-count r) 3) (= (vector-at r 0) 0) (= (vector-at r 1) 42)))
(defn- matches? [path :string expected :string] :bool
 (let [r (read path)] (and (ok? r) (= (string-byte-length expected) 64) (arena-scope (string=? (sha/digest-hex (payload r)) expected)))))
(defn- locale? [s :string] :bool
 (or (string=? s "en") (string=? s "ar") (string=? s "arz") (string=? s "bn") (string=? s "de")
     (string=? s "es") (string=? s "fr") (string=? s "hi") (string=? s "id") (string=? s "ja")
     (string=? s "ko") (string=? s "mr") (string=? s "pcm") (string=? s "pt") (string=? s "ru")
     (string=? s "ur") (string=? s "zh-Hans")))
(defn- arg [n :string] :string (typed-cap-call :cli/args :string :string n))
(defn main [] :i64
 (let [tag (arg "0") head-dir (arg "1") head-exe (arg "2") head-sha (arg "3")
       body-dir (arg "4") body-exe (arg "5") body-sha (arg "6") scratch (arg "7")
       head-out (string-concat scratch "/head.out") body-out (string-concat scratch "/body.out")]
  (if (or (not (locale? tag)) (not (missing? (read head-out))) (not (missing? (read body-out)))
          (not (matches? head-exe head-sha)) (not (matches? body-exe body-sha))) 7
   (let [h (spawn head-dir head-out head-exe tag)]
    (if (not (success? h)) 7
     (let [b (spawn body-dir body-out body-exe tag)]
      (if (not (success? b)) 7
       (let [hr (read head-out) br (read body-out)]
        (if (or (not (ok? hr)) (not (ok? br))) 7
         (let [hv (payload hr) bv (payload br) head (text hv) body (text bv)
               manifest (string-concat "{:tag \"" (string-concat tag (string-concat "\" :head \"" (string-concat (sha/digest-hex hv) (string-concat "\" :body \"" (string-concat (sha/digest-hex bv) "\"}"))))))
               result (document/compose tag manifest head body)]
          (if (option-some?-of [:option :string] result)
           (let [ignored (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))))))))))
