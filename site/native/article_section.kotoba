(ns site.native.article-section (:export [render-section])
 (:require [site.native.locale-tree :as tree] [site.native.locale-catalog :as catalog]
           [site.native.locale-rebase :as rebase]
           [html-hiccup :as html] [components :as dds] [table :as table])
 (:schemas {:site/article-context [:record :site/article-context
           [[:catalog [:ref :site/catalog]] [:tag :string] [:base :string]]]}))

;; Source-driven article sections, rendered as bounded native Hiccup pieces.
;; Wrappers are streamed in source order; no complete page claim is implied.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- at [x :document i :i64] :document (val (document-vector-at x i)))
(defn- getv [x :document k :keyword] :document (val (document-get x k)))
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
  (some (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (none)))
(defn- text [x :document] :string (option-value-of [:option :string] (document-string-value x) ""))
(defn- no? [x :document] :bool (= (document-kind x) :null))
(defn- truth? [x :document] :bool
 (if (no? x) false (if (= (document-kind x) :bool) (option-value-of [:option :bool] (document-bool-value x) false) true)))
(defn- node [state [:ref :site/article-context] d :document] [:option :string]
 (let [mapped (tree/map-indexed (get state :catalog) d)]
  (if (not (option-some?-of [:option :document] mapped)) (none)
   (let [rebased (if (string=? (get state :tag) "en") mapped
                   (rebase/rebase-links (val mapped) (get state :tag) (get state :base)))]
    (if (option-some?-of [:option :document] rebased) (html/render (val rebased) 0) (none))))))
(defn- node-seq [state [:ref :site/article-context] d :document tag :keyword] [:option :string]
 (if (no? d) (some "")
  (if (not (= (document-kind d) :vector)) (none)
   (loop [i 0 out (some "")]
    (if (or (>= i (document-count d)) (not (option-some?-of [:option :string] out))) out
     (let [v (at d i)]
      (if (not (= (document-kind v) :string)) (none)
       (recur (+ i 1) (append out (node state (document-vector (document-keyword tag) v)))))))))))
(defn- wrapped-seq [state [:ref :site/article-context] d :document tag :keyword start :string end :string] [:option :string]
 (if (no? d) (some "") (append (append (some start) (node-seq state d tag)) (some end))))
(defn- codes [state [:ref :site/article-context] d :document] [:option :string]
 (if (no? d) (some "")
  (if (not (= (document-kind d) :vector)) (none)
   (loop [i 0 out (some "")]
    (if (or (>= i (document-count d)) (not (option-some?-of [:option :string] out))) out
     (let [x (at d i)]
      (if (not (= (document-kind x) :string)) (none)
       (recur (+ i 1) (append out (node state (document-vector (document-keyword :pre)
        (document-map :class (document-string "kot-pre") :tabindex (document-string "0"))
        (document-vector (document-keyword :code) x))))))))))))
(defn- pairs [state [:ref :site/article-context] d :document] [:option :string]
 (if (no? d) (some "")
  (if (not (= (document-kind d) :vector)) (none)
   (loop [i 0 out (some "<dl>")]
    (if (not (option-some?-of [:option :string] out)) out
     (if (>= i (document-count d)) (append out (some "</dl>"))
      (let [pair (at d i)]
       (if (or (not (= (document-kind pair) :vector)) (not (= (document-count pair) 2))) (none)
        (recur (+ i 1) (append out (node state
         (document-vector (document-keyword :div)
          (document-vector (document-keyword :dt) (document-vector (document-keyword :strong) (at pair 0)))
          (document-vector (document-keyword :dd) (at pair 1))))))))))))))
(defn- table-cells [state [:ref :site/article-context] row :document headers :bool row-header :bool sortable :bool] [:option :string]
 (if (not (= (document-kind row) :vector)) (none)
  (loop [i 0 out (some "")]
   (if (or (>= i (document-count row)) (not (option-some?-of [:option :string] out))) out
    (let [cell (at row i)
          d (if headers (option-some-of [:option :document] (table/header-cell-node cell sortable))
             (table/body-cell-node (record-new [:ref :tbl/cell] row-header i) cell))]
     (if (not (option-some?-of [:option :document] d)) (none)
      (recur (+ i 1) (append out (node state (val d))))))))))
(defn- table-rows [state [:ref :site/article-context] rows :document row-header :bool] [:option :string]
 (if (not (= (document-kind rows) :vector)) (none)
  (loop [i 0 out (some "")]
   (if (or (>= i (document-count rows)) (not (option-some?-of [:option :string] out))) out
    (recur (+ i 1) (append out (append (append (some "<tr>") (table-cells state (at rows i) false row-header false)) (some "</tr>"))))))))
(defn- table-keys-known? [spec :document] :bool
 (loop [i 0]
  (if (>= i (document-count spec)) true
   (let [key (at (val (document-map-entry-at spec i)) 0)
         k (option-value-of [:option :keyword] (document-keyword-value key) :missing)]
    (if (and (= (document-kind key) :keyword)
             (or (= k :caption) (= k :headers) (= k :rows) (= k :row-header?) (= k :sortable?) (= k :filter) (= k :id)))
     (recur (+ i 1)) false)))))
(defn- table-html [state [:ref :site/article-context] spec :document] [:option :string]
 (if (no? spec) (some "")
  (if (not (= (document-kind spec) :map)) (none)
   (let [caption (getv spec :caption) headers (getv spec :headers) rows (getv spec :rows)
         row-header (truth? (getv spec :row-header?)) sortable (truth? (getv spec :sortable?))
         filter (getv spec :filter) id (getv spec :id)]
    ;; Dynamic filter and table id are not silently omitted.
    (if (or (not (table-keys-known? spec)) (truth? filter) (truth? id) (and (not (no? headers)) (not (= (document-kind headers) :vector)))) (none)
     (let [start (if sortable "<div class=\"kot-table-scroll\"><div class=\"dads-table\" data-behavior=\"table\"><table class=\"dads-table__table\">"
                               "<div class=\"kot-table-scroll\"><div class=\"dads-table\"><table class=\"dads-table__table\">")
           a (if (no? caption) (some "") (node state (document-vector (document-keyword :caption) caption)))
           b (if (or (no? headers) (= (document-count headers) 0)) (some "")
               (append (append (some "<thead><tr>") (table-cells state headers true false sortable)) (some "</tr></thead>")))
           c (append (append (some "<tbody>") (table-rows state rows row-header)) (some "</tbody></table></div></div>"))]
      (append (append (append (some start) a) b) c)))))))
(defn- stories [state [:ref :site/article-context] d :document] [:option :string]
 (if (no? d) (some "") (if (not (= (document-kind d) :vector)) (none)
  (loop [i 0 out (some "")]
   (if (or (>= i (document-count d)) (not (option-some?-of [:option :string] out))) out
    (let [x (at d i)]
     (if (not (= (document-kind x) :map)) (none)
      (recur (+ i 1) (append out (node state (document-vector (document-keyword :section)
       (dds/heading-node 3 (getv x :title) "24" "") (document-vector (document-keyword :p) (getv x :text)))))))))))))
(defn- graph-list [state [:ref :site/article-context] graph :document start :i64 stop :i64 strong :bool] [:option :string]
 (loop [i start out (some "")]
  (if (or (>= i stop) (not (option-some?-of [:option :string] out))) out
   (let [x (at graph i) v (if strong (document-vector (document-keyword :strong) x) x)]
    (recur (+ i 1) (append out (node state (document-vector (document-keyword :li) v))))))))
(defn- graph-html [state [:ref :site/article-context] graph :document after :document] [:option :string]
 (if (no? graph) (some "") (if (not (= (document-kind graph) :vector)) (none)
  (let [n (document-count graph) first (if (< n 4) n 4)]
   (append (append (append (append (append (append (some "<figure class=\"kot-attack-graph\"><ol>")
    (graph-list state graph 0 first true)) (some "</ol><ul>")) (graph-list state graph first n false)) (some "</ul>"))
    (node state (document-vector (document-keyword :figcaption) after))) (some "</figure>"))))))
(defn- link-node [link :document] :document
 (document-vector (document-keyword :a) (document-map :class (document-string "kot-link") :href (getv link :href)) (getv link :label)))
(defn- links [state [:ref :site/article-context] a :document b :document] [:option :string]
 (if (no? a) (if (no? b) (some "") (none))
  (if (or (not (= (document-kind a) :map)) (and (not (no? b)) (not (= (document-kind b) :map)))) (none)
   (node state (if (no? b) (document-vector (document-keyword :p) (link-node a))
    (document-vector (document-keyword :p) (link-node a)
     (document-vector (document-keyword :span) (document-string " · ") (link-node b))))))))
(defn- known? [k :keyword] :bool
 (or (= k :title) (= k :paragraphs) (= k :rows) (= k :table) (= k :table-2) (= k :steps)
     (= k :after) (= k :paragraphs-after) (= k :stories) (= k :graph) (= k :code) (= k :link) (= k :link-2)))
(defn- keys-known? [d :document] :bool
 (loop [i 0]
  (if (>= i (document-count d)) true
   (let [key (at (val (document-map-entry-at d i)) 0)]
    (if (and (= (document-kind key) :keyword) (known? (option-value-of [:option :keyword] (document-keyword-value key) :missing))) (recur (+ i 1)) false)))))
(defn render-section [state [:ref :site/article-context] s :document] [:option :string]
 (if (not (= (document-kind s) :map)) (none)
  (let [title (getv s :title) graph (getv s :graph) after (getv s :after)]
   (if (or (not (keys-known? s)) (not (= (document-kind title) :string))) (none)
    (let [a (node state (dds/heading-node 2 title "32" ""))
          b (node-seq state (getv s :paragraphs) :p)
          c (links state (getv s :link) (getv s :link-2))
          d (codes state (getv s :code))
          e (table-html state (getv s :table))
          f (pairs state (getv s :rows))
          g (if (or (no? after) (not (no? graph))) (some "") (node state (document-vector (document-keyword :p) after)))
          h (table-html state (getv s :table-2))
          j (wrapped-seq state (getv s :steps) :li "<ol class=\"kot-list\">" "</ol>")
          k (node-seq state (getv s :paragraphs-after) :p)
          l (graph-html state graph after) m (stories state (getv s :stories))]
     (let [x1 (append (some "<section>") a) x2 (append x1 b) x3 (append x2 c)
           x4 (append x3 d) x5 (append x4 e) x6 (append x5 f) x7 (append x6 g)
           x8 (append x7 h) x9 (append x8 j) x10 (append x9 k) x11 (append x10 l)
           x12 (append x11 m)]
       (append x12 (some "</section>"))))))))
