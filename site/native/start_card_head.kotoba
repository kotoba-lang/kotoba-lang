(ns site.native.start-card-head (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.input :as input] [site.native.dds-base-css :as base] [site.native.dds-ext-css :as ext] [site.native.dds-palette :as palette]
           [site.native.dds-skin-css :as skin] [site.native.source-concat :as concat] [site.native.syntax-theme :as syntax]
           [site.native.start-card-metadata :as metadata] [site.native.header-scripts :as scripts] [multiformats.sha256 :as sha]))
;; Streams a pinned head; caller must keep partial output private unless exit 42.
(defn- val [x [:option :string]] :string (option-value-of [:option :string] x ""))
(defn- read [p :string] :string (input/read p))
(defn- digest? [s :string h :string] :bool (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) h))
(defn- emit [prefix :string x [:option :string]] :bool
 (if (not (option-some?-of [:option :string] x)) false
  (let [ignored (typed-cap-call :io/write :string :string (string-concat prefix (val x)))] true)))
(defn- app [generator :string theme-source :string theme-json :string] [:option :string]
 (let [theme (concat/extract theme-source "(def css\n (str" "" "" false) syntax-css (syntax/render theme-json)]
  (if (and (option-some?-of [:option :string] theme) (option-some?-of [:option :string] syntax-css))
   (concat/extract generator "(def app-css\n  (str" (val theme) (val syntax-css) true) (option-none-of [:option :string]))))
(defn- before [meta [:option :string] dds :string] [:option :string]
 (let [color (palette/literal-color dds "--color-neutral-solid-gray-900") m (val meta) pos (string-index-of m "<link ")]
  (if (or (not (option-some?-of [:option :string] meta)) (not (option-some?-of [:option :string] color)) (< pos 0)) (option-none-of [:option :string])
   (option-some-of [:option :string]
    (string-concat "<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"><meta name=\"color-scheme\" content=\"light dark\"><meta name=\"theme-color\" content=\"#ffffff\" media=\"(prefers-color-scheme: light)\"><meta name=\"theme-color\" content=\""
     (string-concat (val color) (string-concat "\" media=\"(prefers-color-scheme: dark)\">" (string-concat (string-substring m 0 pos) "<style>"))))))))
(defn- after [meta [:option :string] generator :string behavior :string theme :string] [:option :string]
 (let [m (val meta) pos (string-index-of m "<link ") ts (scripts/theme-script generator theme) ms (scripts/menu-script generator behavior)]
  (if (or (not (option-some?-of [:option :string] meta)) (< pos 0) (not (option-some?-of [:option :string] ts)) (not (option-some?-of [:option :string] ms))) (option-none-of [:option :string])
   (option-some-of [:option :string]
    (string-concat "</style><link rel=\"icon\" type=\"image/png\" href=\"/kotoba-favicon.png\"><link rel=\"apple-touch-icon\" href=\"/kotoba-favicon.png\"><script>"
     (string-concat (val ts) (string-concat "</script><script>" (string-concat (val ms)
      (string-concat "</script>" (string-concat (string-substring m pos (string-byte-length m)) "</head>"))))))))))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0") dds (read "/dds.css") lang (read "/language.css") box (read "/box.css") menu (read "/menu.css")
       behavior (read "/behavior.cljk") core (read "/core.cljk") tokens (read "/tokens.cljk") generator (read "/generator.cljk")
       theme-source (read "/theme-source.cljk") theme-json (read "/theme.json") meta (metadata/render tag generator)]
  (if (and (arena-scope (digest? theme-source "4f6a44a9b90ba83719530677c324ea638fbe25da267d0e37213e23e594a7e917"))
           (arena-scope (emit "" (before meta dds))) (arena-scope (emit "" (base/render dds lang box menu behavior)))
           (arena-scope (emit "\n" (ext/render core))) (arena-scope (emit "\n" (palette/theme-css dds)))
           (arena-scope (emit "\n" (skin/skin tokens))) (arena-scope (emit "\n" (app generator theme-source theme-json)))
           (arena-scope (emit "" (after meta generator behavior theme-source)))) 42 7)))
