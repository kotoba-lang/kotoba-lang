(ns site.native.locale-message
  (:export [message-id translate translate-indexed])
  (:require [multiformats.sha256 :as sha]
            [site.native.locale-catalog :as catalog]))

;; Key trimming follows kotoba.lang.text/trim (Java whitespace). Source
;; boundary preservation follows ECMAScript regexp \s. Both use byte offsets.
(defn- width [cp :i64] :i64
  (cond (< cp 128) 1 (< cp 2048) 2 (< cp 65536) 3 :else 4))

(defn- ws? [c :i64] :bool
  (or (and (>= c 9) (<= c 13)) (= c 32) (= c 160) (= c 5760)
      (and (>= c 8192) (<= c 8202)) (= c 8232) (= c 8233)
      (= c 8239) (= c 8287) (= c 12288) (= c 65279)))

(defn- java-ws? [c :i64] :bool
  (or (and (>= c 9) (<= c 13)) (and (>= c 28) (<= c 31))
      (= c 32) (= c 5760) (and (>= c 8192) (<= c 8198))
      (and (>= c 8200) (<= c 8202)) (= c 8232) (= c 8233)
      (= c 8287) (= c 12288)))

(defn- first-nonspace [s :string i :i64 java? :bool] :i64
  (if (>= i (string-byte-length s)) i
    (let [c (string-code-point-at s i)]
      (if (if java? (java-ws? c) (ws? c)) (first-nonspace s (+ i (width c)) java?) i))))

(defn- last-nonspace [s :string i :i64 last :i64 java? :bool] :i64
  (if (>= i (string-byte-length s)) last
    (let [c (string-code-point-at s i) n (+ i (width c))]
      (last-nonspace s n (if (if java? (java-ws? c) (ws? c)) last n) java?))))

(defn- append-cp [out :vector-i64 cp :i64] :vector-i64
  (cond (< cp 128) (vector-conj out cp)
        (< cp 2048) (vector-conj (vector-conj out (bit-or 192 (u64-shift-right cp 6)))
                                 (bit-or 128 (bit-and cp 63)))
        (< cp 65536) (vector-conj (vector-conj (vector-conj out (bit-or 224 (u64-shift-right cp 12)))
                                              (bit-or 128 (bit-and (u64-shift-right cp 6) 63)))
                                 (bit-or 128 (bit-and cp 63)))
        :else (vector-conj (vector-conj (vector-conj (vector-conj out (bit-or 240 (u64-shift-right cp 18)))
                                                       (bit-or 128 (bit-and (u64-shift-right cp 12) 63)))
                                          (bit-or 128 (bit-and (u64-shift-right cp 6) 63)))
                           (bit-or 128 (bit-and cp 63)))))

(defn- bytes [s :string start :i64 end :i64] :vector-i64
  (loop [i start out (vector-alloc 0)]
    (if (>= i end) out
      (let [c (string-code-point-at s i)]
        (recur (+ i (width c)) (append-cp out c))))))

(defn message-id [s :string] :string
  (let [start (first-nonspace s 0 true) end (last-nonspace s start start true)]
    (sha/digest-hex (bytes s start end))))

;; Preserve the source text's leading and trailing ECMAScript regex whitespace
;; around a message looked up in an already parsed catalog.
(defn translate-indexed [state [:ref :site/catalog] source :string] [:option :string]
  (let [start (first-nonspace source 0 false) end (last-nonspace source 0 0 false)
        found (catalog/indexed-value state (message-id source))]
    (if (option-some?-of [:option :string] found)
      (option-some-of [:option :string]
        (string-concat (string-substring source 0 start)
          (string-concat (option-value-of [:option :string] found "")
                         (string-substring source end (string-byte-length source)))))
      (option-none-of [:option :string]))))

(defn translate [catalog-json :string source :string] [:option :string]
  (match-option (catalog/open-catalog catalog-json) [:option [:ref :site/catalog]]
    (none (option-none-of [:option :string]))
    (some state (translate-indexed state source))))
