(ns site.native.home-script-bundle (:export [render])
 (:require [site.native.home-scripts :as scripts] [site.native.home-play :as play] [site.native.home-hero-script :as hero]))
;; The five source-locked homepage scripts, in view order. The page controller
;; may insert this only after checking the native command exit status.
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
  (option-some-of [:option :string] (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (none)))
(defn- wrap [s [:option :string]] [:option :string]
 (if (not (option-some?-of [:option :string] s)) (none)
  (let [text (option-value-of [:option :string] s "")]
   (if (>= (string-index-of text "</script") 0) (none)
    (option-some-of [:option :string] (string-concat "<script>" (string-concat text "</script>")))))))
(defn render [generator :string hero-source :string source :string provenance :string wasm :vector-i64] [:option :string]
 (let [a (wrap (scripts/extract generator "search"))
       b (wrap (play/script generator source provenance wasm))
       c (wrap (hero/script generator hero-source))
       d (wrap (scripts/extract generator "chart"))
       e (wrap (scripts/extract generator "morph"))]
  (append (append (append (append a b) c) d) e)))
