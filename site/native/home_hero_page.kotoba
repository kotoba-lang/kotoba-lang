(ns site.native.home-hero-page (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.input :as input] [site.native.home-hero :as home] [site.native.locale-catalog :as catalog]))
(defn- binary [path :string] :vector-i64
 (let [zero (string-from-utf8 (bytes-from-vector-i64 [0])) prefix (string-from-utf8 (bytes-from-vector-i64 [0 70 83 50 0]))
       request (string-concat prefix (string-concat "A" (string-concat (input/request-path path) zero)))
       raw (vector-i64-from-bytes (typed-cap-call :fs/app-data :string :bytes request)) n (vector-count raw)]
  (if (and (>= n 5) (= (vector-at raw 0) 0) (= (vector-at raw 1) 70) (= (vector-at raw 2) 83) (= (vector-at raw 3) 50) (= (vector-at raw 4) 0))
   (loop [i 5 out (vector-alloc (- n 5))] (if (>= i n) out (recur (+ i 1) (vector-assoc! out (- i 5) (vector-at raw i))))) (vector-alloc 0))))
(defn- locale? [s :string] :bool
 (or (string=? s "en") (string=? s "ar") (string=? s "arz") (string=? s "bn") (string=? s "de")
     (string=? s "es") (string=? s "fr") (string=? s "hi") (string=? s "id") (string=? s "ja")
     (string=? s "ko") (string=? s "mr") (string=? s "pcm") (string=? s "pt") (string=? s "ru")
     (string=? s "ur") (string=? s "zh-Hans")))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "1")]
  (if (not (locale? tag)) 7
   (let [json (input/read (string-concat "/site/i18n/" (string-concat tag ".json")))]
    (match-option (catalog/open-catalog json) [:option [:ref :site/catalog]]
     (none 7)
     (some state
      (let [generator (input/read "/generator.cljk") sample (input/read "/play.kotoba")
            provenance (input/read "/provenance.edn") wasm (binary "/play.wasm")
            grammar (input/read "/grammar.edn") tokenizer (input/read "/highlight.cljk")
            theme (input/read "/theme.json") result (home/render state tag generator (input/read "/hero.cljk") sample provenance wasm grammar tokenizer theme (input/read "/embench.json") (input/read "/chart.cljk"))]
       (if (option-some?-of [:option :string] result)
        (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7))))))))
