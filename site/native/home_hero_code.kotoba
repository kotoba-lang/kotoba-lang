(ns site.native.home-hero-code (:export [render])
 (:require [site.native.home-morph-highlight :as highlight] [site.native.home-play :as play]
           [site.native.locale-tree :as tree] [multiformats.sha256 :as sha] [multiformats.cid :as cid] [html-hiccup :as html]))
;; Source and Wasm are checked against provenance before any identity is shown.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- text [x :document] :string (option-value-of [:option :string] (document-string-value x) ""))
(defn- field [x :document k :keyword] :string (text (val (document-get x k))))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- layer [label :string hash :string note :string href :string] :document
 (let [value (document-vector (document-keyword :code) (document-map :class (document-string "kot-code kot-morph-id-sha") :title (document-string hash))
               (document-string (string-substring hash 0 16)) (document-string "…"))
       link (if (string=? href "") value (document-vector (document-keyword :a) (document-map :href (document-string href) :aria-label (document-string (string-concat label (string-concat " " hash)))) value))]
  (document-vector (document-keyword :li)
   (document-vector (document-keyword :span) (document-map :class (document-string "kot-morph-id-label")) (document-string label)) link
   (document-vector (document-keyword :span) (document-map :class (document-string "kot-morph-id-note")) (document-string note)))))
(defn- replace-marker [s :string value :string] [:option :string]
 (let [marker "987654321012" p (string-index-of s marker)]
  (if (< p 0) (none)
   (let [tail (string-substring s (+ p 12) (string-byte-length s))]
    (if (>= (string-index-of tail marker) 0) (none) (option-some-of [:option :string] (string-concat (string-substring s 0 p) (string-concat value tail))))))))
(defn render [state [:ref :site/catalog] tag :string generator :string source :string provenance :string wasm :vector-i64 grammar :string tokenizer :string theme :string] [:option :string]
 (let [verified (play/script generator source provenance wasm) code (highlight/render source grammar tokenizer theme) record (document-edn-read provenance)
       source-hash (field record :source-sha256) kir (field record :kir-sha256) artifact (field record :sha256)
       computed (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 source))) source-cid (cid/cidv1 85 computed)
       href (string-concat "/ipfs/" source-cid) ipfs (string-concat "ipfs://" source-cid)
       data (string-concat "source CID " (string-concat source-cid (string-concat "|source SHA-256 " (string-concat source-hash (string-concat "|checked KIR SHA-256 " (string-concat kir (string-concat "|artifact identity SHA-256 " artifact)))))))]
  (if (or (not (option-some?-of [:option :string] verified)) (not (option-some?-of [:option :string] code))
          (not (string=? computed source-hash)) (not (= (string-byte-length source-cid) 59))
          (not (= (string-byte-length source-hash) 64)) (not (= (string-byte-length kir) 64)) (not (= (string-byte-length artifact) 64))) (none)
   (let [node (document-vector (document-keyword :div) (document-map :class (document-string "kot-morph") :id (document-string "kot-morph") :data-layers (document-string data))
         (document-vector (document-keyword :p) (document-map :class (document-string "kot-caption kot-muted") :id (document-string "kot-hero-filename"))
          (document-vector (document-keyword :a) (document-map :href (document-string href) :title (document-string "View the exact source by CID")) (document-vector (document-keyword :code) (document-map :class (document-string "kot-code")) (document-string "hello.kotoba")))
          (document-string " / ") (document-vector (document-keyword :a) (document-map :href (document-string ipfs) :title (document-string "Open in an IPFS client")) (document-string "IPFS")))
         (document-vector (document-keyword :div) (document-map :class (document-string "kot-morph-stage"))
          (document-vector (document-keyword :pre) (document-map :class (document-string "kot-pre kot-morph-code") :aria-labelledby (document-string "kot-hero-filename")) (document-string "987654321012"))
          (document-vector (document-keyword :div) (document-map :class (document-string "kot-morph-out") :aria-hidden (document-string "true"))
           (document-vector (document-keyword :span) (document-map :class (document-string "kot-morph-label"))) (document-vector (document-keyword :span) (document-map :class (document-string "kot-morph-hex")))))
         (document-vector (document-keyword :ul) (document-map :class (document-string "kot-morph-ids"))
          (layer "source CID" source-cid "IPFS CIDv1 · raw · sha2-256 of hello.kotoba" href)
          (layer "source SHA-256" source-hash "sha-256 of the exact file shown here" "")
          (layer "checked KIR SHA-256" kir "the typed, effect-checked representation the compiler admitted" "")
          (layer "artifact identity SHA-256" artifact "binds source, policy, compiler contract and target ABI" ""))
         (document-vector (document-keyword :p) (document-map :class (document-string "kot-caption kot-muted")) (document-string "The source CID opens hello.kotoba. The SHA-256 digests identify source bytes, checked KIR, and artifact identity; they are not IPFS addresses.")))
         localized (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))]
    (if (not (option-some?-of [:option :document] localized)) (none)
     (let [frame (html/render (val localized) 0)]
      (if (option-some?-of [:option :string] frame) (replace-marker (option-value-of [:option :string] frame "") (option-value-of [:option :string] code "")) (none))))))))
