(ns site.native.footer (:export [render-footer])
 (:require [site.native.locale-tree :as tree] [site.native.locale-catalog :as catalog]
           [site.native.locale-rebase :as rebase] [html-hiccup :as html] [components :as dds]))
;; This source-compatible footer is a bounded fragment. The generator path is
;; a caller argument so a native generator can identify itself truthfully.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- some [d :document] [:option :document] (option-some-of [:option :document] d))
(defn- none [] [:option :document] (option-none-of [:option :document]))
(defn- code [s :string] :document
 (document-vector (document-keyword :code) (document-map :class (document-string "kot-code")) (document-string s)))
(defn- mail [] :document
 (document-vector (document-keyword :a) (document-map :class (document-string "kot-link") :href (document-string "mailto:support@kotoba-lang.org")) (document-string "support@kotoba-lang.org")))
(defn- authority [] :string
 "lang/safety-claims.edn, lang/surface-status.edn, lang/elaboration-pipeline.edn, lang/typed-eval.edn, lang/stack-architecture.edn, lang/wasm-component-platform.edn, lang/library-publication.edn, lang/docs-release.edn, lang/product-defaults.edn, site/sponsorship.edn, security/cryptographic-boundaries.edn, docs/search-index.edn")
(defn- footer-tree [japanese :bool href :string paid :bool generator :string] [:option :document]
 (let [operator (if japanese "公開運営者: Kotoba Foundation" "Public operator: Kotoba Foundation")
       contact (if japanese "公開連絡先: " "Public contact: ")
       sales (if japanese "営業連絡先: Ryo Awai." "Sales contact: Ryo Awai.")
       legal (if japanese "運営情報" "Operator")
       kids (document-vector
        (document-vector (document-keyword :p) (document-vector (document-keyword :strong) (document-string "Kotoba")) (document-string " — Safe code. Built for machine speed."))
        (document-vector (document-keyword :p) (document-map :class (document-string "kot-caption kot-muted"))
         (document-string operator) (document-string " ") (document-string contact) (mail) (document-string ". ") (document-string sales))
        (document-vector (document-keyword :p) (document-map :class (document-string "kot-caption kot-muted"))
         (document-string "Generated by ") (code generator) (document-string " from ") (code (authority)) (document-string ". ")
         (document-string "No telemetry. No third-party runtime dependency."))
        (document-vector (document-keyword :p)
         (document-vector (document-keyword :a) (document-map :class (document-string "kot-link") :href (document-string href)) (document-string legal))
         (document-string " · ")
         (document-vector (document-keyword :a) (document-map :class (document-string "kot-link") :href (document-string "https://github.com/kotoba-lang/kotoba-lang") :rel (document-string "noreferrer")) (document-string "Source and license"))))
       container (dds/container-node kids)]
  (if (option-some?-of [:option :document] container)
   (some (document-vector (document-keyword :footer) (document-map :class (document-string "kot-footer")) (val container))) (none))))
(defn render-footer [state [:ref :site/catalog] tag :string base :string japanese-source :bool href :string paid :bool generator :string] [:option :string]
 (if (and japanese-source (not (string=? tag "ja"))) (option-none-of [:option :string])
  (let [raw (footer-tree japanese-source href paid generator)]
   (if (not (option-some?-of [:option :document] raw)) (option-none-of [:option :string])
    (let [translated (if (or japanese-source (string=? tag "en")) raw (tree/map-indexed state (val raw)))]
     (if (not (option-some?-of [:option :document] translated)) (option-none-of [:option :string])
      (let [rebased (if (or japanese-source (string=? tag "en")) translated (rebase/rebase-links (val translated) tag base))]
       (if (option-some?-of [:option :document] rebased) (html/render (val rebased) 0) (option-none-of [:option :string])))))))))
