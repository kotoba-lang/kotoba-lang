(ns site.native.home-benchmark-scaling-order (:export [render])
 (:require [json.core :as json] [site.native.locale-tree :as tree] [multiformats.sha256 :as sha]
           [html-hiccup :as html] [table :as table]))
;; Qualified orderings of the released CLI from the pinned scaling report.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- field [d :document k :string] :document (if (= (document-kind d) :map) (val (document-get d (document-string k))) (document-null)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- number [d :document] :f64
 (if (= (document-kind d) :i64) (i64-to-f64-rounded (option-value-of [:option :i64] (document-i64-value d) 0))
  (option-value-of [:option :f64] (document-f64-value d) 0.0)))
(defn- numeric? [d :document] :bool (or (= (document-kind d) :i64) (= (document-kind d) :f64)))
(defn- fixed1 [x :f64] :string
 (let [v (f64-to-i64-truncating (f64-add (f64-mul x 10.0) 0.5))]
  (string-concat (string-from-i64 (quot v 10)) (string-concat "." (string-from-i64 (rem v 10))))))
(defn- contains-string? [xs :document value :string i :i64] :bool
 (if (>= i (document-count xs)) false (if (string=? (text (item xs i)) value) true (contains-string? xs value (+ i 1)))))
(defn- reasons [xs :document i :i64 seen :document out :string] [:option :string]
 (if (>= i (document-count xs)) (option-some-of [:option :string] out)
  (let [r (field (item xs i) "reason") s (text r)]
   (if (not (= (document-kind r) :string)) (option-none-of [:option :string])
    (if (contains-string? seen s 0) (reasons xs (+ i 1) seen out)
     (reasons xs (+ i 1) (document-vector-conj seen r) (string-concat out (string-concat (if (= (document-count seen) 0) "" ", ") s))))))))
(defn- row [scale :document lanes :document key :document result :document] [:option :document]
 (let [lane (field lanes (text key)) label (field lane "label") target (field lane "target") qualified (field result "qualifiedFaster")
       yes (option-value-of [:option :bool] (document-bool-value qualified) false) separation (field result "separation") gap (field separation "gap") spread (field separation "summed-stdev")
       why (if yes (option-some-of [:option :string] "—") (reasons (field result "reasons") 0 (document-vector) "")) k (field scale "k")]
  (if (or (not (= (document-kind key) :string)) (not (= (document-kind label) :string)) (not (= (document-kind target) :string)) (not (= (document-kind qualified) :bool))
          (not (numeric? gap)) (not (numeric? spread)) (not (= (document-kind k) :i64)) (not (option-some?-of [:option :string] why))) (option-none-of [:option :document])
   (option-some-of [:option :document]
    (document-vector (document-keyword :tr)
     (document-vector (document-keyword :th) (document-map :class (document-string "dads-table__row-header") :scope (document-string "row"))
      (document-string (string-concat "K=" (document-edn-print k))))
     (document-vector (document-keyword :td) (document-string (string-concat (text label) (string-concat " · " (text target)))))
     (document-vector (document-keyword :td) (document-string (if yes "yes, qualified" "no")))
     (document-vector (document-keyword :td) (document-string (string-concat (fixed1 (number gap)) (string-concat " ms vs " (string-concat (fixed1 (number spread)) " ms")))))
     (document-vector (document-keyword :td) (document-string (option-value-of [:option :string] why ""))))))))
(defn- next-entry [entries :document previous :string] :i64
 (loop [i 0 best -1 best-key ""]
  (if (>= i (document-count entries)) best
   (let [entry (val (document-map-entry-at entries i)) key (text (item entry 0))
         choose (and (> (string-compare key previous) 0) (or (< best 0) (< (string-compare key best-key) 0)))]
    (recur (+ i 1) (if choose i best) (if choose key best-key))))))
(defn- scale-rows [state [:ref :site/catalog] tag :string scale :document lanes :document orderings :document i :i64 previous :string out :string] [:option :string]
 (if (>= i (document-count orderings)) (option-some-of [:option :string] out)
  (let [index (next-entry orderings previous)]
   (if (< index 0) (option-none-of [:option :string])
    (let [entry (val (document-map-entry-at orderings index)) key (item entry 0) value (item entry 1) r (row scale lanes key value)
          localized (if (and (option-some?-of [:option :document] r) (not (string=? tag "en"))) (tree/map-indexed state (val r)) r)
          rendered (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (option-none-of [:option :string]))]
     (if (not (option-some?-of [:option :string] rendered)) (option-none-of [:option :string])
      (scale-rows state tag scale lanes orderings (+ i 1) (text key) (string-concat out (option-value-of [:option :string] rendered "")))))))))
(defn- rows [state [:ref :site/catalog] tag :string scales :document lanes :document i :i64 out :string] [:option :string]
 (if (>= i (document-count scales)) (option-some-of [:option :string] out)
  (let [scale (item scales i) status (text (field (field (field scale "lanes") "kotoba-wasm-cli") "status"))]
   (if (not (string=? status "measured")) (rows state tag scales lanes (+ i 1) out)
    (let [entries (field (field scale "ordering") "kotoba-wasm-cli") r (if (= (document-kind entries) :map) (scale-rows state tag scale lanes entries 0 "" "") (option-none-of [:option :string]))]
     (if (not (option-some?-of [:option :string] r)) (option-none-of [:option :string])
      (rows state tag scales lanes (+ i 1) (string-concat out (option-value-of [:option :string] r "")))))))))
(defn render [state [:ref :site/catalog] tag :string generator :string report :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "5bb0ff5d9e2f80ca7a76545ead6d0138ab7516f2bb712dd4f059d8b0bb4f5ab2"))
       r-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 report))) "9bb56646bb55a8746b36c66c42ebefb48bebd17ab60c4df79a2ab1702537e229"))]
  (if (or (not g-ok) (not r-ok)) (option-none-of [:option :string])
   (let [decoded (json/decode report) d (result-value-of [:result :document :document] decoded (document-null)) scales (field d "scales") lanes (field d "lanes")
         body (if (and (= (document-kind scales) :vector) (= (document-kind lanes) :map)) (rows state tag scales lanes 0 "") (option-none-of [:option :string]))]
    (if (or (not (result-ok?-of [:result :document :document] decoded)) (not (option-some?-of [:option :string] body))) (option-none-of [:option :string])
     (let [node (document-vector (document-keyword :div) (document-map :class (document-string "kot-table-scroll"))
            (document-vector (document-keyword :div) (document-map :class (document-string "dads-table"))
             (document-vector (document-keyword :table) (document-map :class (document-string "dads-table__table"))
              (document-vector (document-keyword :caption) (document-string "Released Kotoba CLI against each comparator, at every size where it still emits a valid module"))
              (document-vector (document-keyword :thead) (document-vector (document-keyword :tr)
               (table/header-cell-node (document-string "Size") false) (table/header-cell-node (document-string "Compared against") false)
               (table/header-cell-node (document-string "Kotoba faster?") false) (table/header-cell-node (document-string "Gap vs combined spread") false)
               (table/header-cell-node (document-string "Why not, if not") false)))
              (document-vector (document-keyword :tbody) (document-string "987654321013")))))
           localized (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))
           frame (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (option-none-of [:option :string]))
           raw (option-value-of [:option :string] frame "") marker (string-index-of raw "987654321013")]
      (if (or (not (option-some?-of [:option :string] frame)) (< marker 0)) (option-none-of [:option :string])
       (option-some-of [:option :string] (string-concat (string-substring raw 0 marker) (string-concat (option-value-of [:option :string] body "")
         (string-substring raw (+ marker 12) (string-byte-length raw)))))))))))
)
