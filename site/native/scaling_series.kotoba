(ns site.native.scaling-series (:export [geometry])
 (:require [json.core :as json] [site.native.scaling-axis :as axis] [multiformats.sha256 :as sha]))
;; Bounded geometry derived from the complete build-scaling report. This is
;; data for the SVG renderer, not the SVG or a general line-chart library.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- field [d :document k :string] :document (if (= (document-kind d) :map) (val (document-get d (document-string k))) (document-null)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- number [d :document] :f64
 (if (= (document-kind d) :i64) (i64-to-f64-rounded (option-value-of [:option :i64] (document-i64-value d) 0))
  (option-value-of [:option :f64] (document-f64-value d) 0.0)))
(defn- result [scale :document lane :string] :document (field (field scale "lanes") lane))
(defn- measured? [d :document] :bool (string=? (text (field d "status")) "measured"))
(defn- median [d :document] :document (field (field d "summary") "median"))
(defn- min2 [a :f64 b :f64] :f64 (if (f64-lt a b) a b))
(defn- max2 [a :f64 b :f64] :f64 (if (f64-gt a b) a b))
(defn- bounds-lanes [scale :document order :document j :i64 bounds :vector-i64] :vector-i64
 (if (>= j (document-count order)) bounds
  (let [d (result scale (text (item order j))) k (number (field scale "k")) y (number (median d))
        next (if (and (measured? d) (f64-gt k 0.0) (f64-gt y 0.0))
              (-> bounds (vector-assoc! 0 (f64-to-bits (min2 (f64-from-bits (vector-at bounds 0)) k)))
                         (vector-assoc! 1 (f64-to-bits (max2 (f64-from-bits (vector-at bounds 1)) k)))
                         (vector-assoc! 2 (f64-to-bits (min2 (f64-from-bits (vector-at bounds 2)) y)))
                         (vector-assoc! 3 (f64-to-bits (max2 (f64-from-bits (vector-at bounds 3)) y)))) bounds)]
   (bounds-lanes scale order (+ j 1) next))))
(defn- bounds [scales :document order :document i :i64 out :vector-i64] :vector-i64
 (if (>= i (document-count scales)) out (bounds scales order (+ i 1) (bounds-lanes (item scales i) order 0 out))))
(defn- fixed1 [x :f64] :string
 (let [v (f64-to-i64-truncating (f64-add (f64-mul x 10.0) 0.5))]
  (string-concat (string-from-i64 (quot v 10)) (string-concat "." (string-from-i64 (rem v 10))))))
(defn- pos [x :document low :f64 high :f64 kind :keyword] :f64
 (let [r (axis/coordinate x (document-f64 low) (document-f64 high) kind)]
  (option-value-of [:option :f64] (document-f64-value (val r)) -1.0)))
(defn- label [id :string fallback :string] :string
 (cond (string=? id "kotoba-wasm-cli") "Kotoba · released CLI" (string=? id "amu-wasm") "Kotoba / Amu → Wasm"
       (string=? id "amu-native") "Kotoba / Amu → native" (string=? id "rustc-wasm") "rustc → Wasm"
       (string=? id "rustc-native") "rustc → native" (string=? id "clang-native") "clang → native"
       (string=? id "javac") "javac" :else fallback))
(defn- points [scales :document id :string b :vector-i64 i :i64 path :string last-i :i64 ex :f64 ey :f64] [:option :document]
 (if (>= i (document-count scales))
  (if (< last-i 0) (option-none-of [:option :document])
   (let [after (if (< (+ last-i 1) (document-count scales)) (text (field (result (item scales (+ last-i 1)) id) "status")) "")
         end (cond (string=? after "invalid") "cross" (or (string=? after "failed") (string=? after "unavailable") (string=? after "not-run")) "bar" :else "circle")]
    (option-some-of [:option :document] (document-map :path (document-string path) :end (document-string end) :ex (document-f64 ex) :ey (document-f64 ey)))))
  (let [sc (item scales i) d (result sc id)]
   (if (not (measured? d)) (points scales id b (+ i 1) path last-i ex ey)
    (let [x (pos (field sc "k") (f64-from-bits (vector-at b 0)) (f64-from-bits (vector-at b 1)) :x)
          y (pos (median d) (f64-from-bits (vector-at b 2)) (f64-from-bits (vector-at b 3)) :y)]
     (if (or (f64-lt x 0.0) (f64-lt y 0.0)) (option-none-of [:option :document])
      (points scales id b (+ i 1) (string-concat path (string-concat (if (< last-i 0) "M" " L") (string-concat (fixed1 x) (string-concat " " (fixed1 y))))) i x y)))))))
(defn- any-measured? [scales :document id :string i :i64] :bool
 (if (>= i (document-count scales)) false
  (if (measured? (result (item scales i) id)) true (any-measured? scales id (+ i 1)))))
(defn- series [scales :document lanes :document order :document b :vector-i64 i :i64 out :document] [:option :document]
 (if (>= i (document-count order)) (option-some-of [:option :document] out)
  (let [id (text (item order i)) lane (field lanes id) pts (points scales id b 0 "" -1 0.0 0.0)]
   (if (not (any-measured? scales id 0)) (series scales lanes order b (+ i 1) out)
    (if (not (option-some?-of [:option :document] pts)) (option-none-of [:option :document])
     (let [p (val pts) d (document-assoc (document-assoc (document-assoc p :id (document-string id)) :label (document-string (label id (text (field lane "label"))))) :accent (document-bool (string=? id "kotoba-wasm-cli")))]
      (series scales lanes order b (+ i 1) (document-vector-conj out d))))))))
(defn geometry [report :string] [:option :document]
 (if (not (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 report))) "9bb56646bb55a8746b36c66c42ebefb48bebd17ab60c4df79a2ab1702537e229"))) (option-none-of [:option :document])
  (let [r (json/decode report) d (result-value-of [:result :document :document] r (document-null)) scales (field d "scales") lanes (field d "lanes")
        order (document-vector (document-string "kotoba-wasm-cli") (document-string "amu-wasm") (document-string "amu-native") (document-string "rustc-wasm")
               (document-string "rustc-native") (document-string "clang-wasm") (document-string "clang-native") (document-string "javac"))
        start (vector-i64 (f64-to-bits 1000000000000.0) (f64-to-bits 0.0) (f64-to-bits 1000000000000.0) (f64-to-bits 0.0))
        b (bounds scales order 0 start) xs (series scales lanes order b 0 (document-vector))]
   (if (or (not (result-ok?-of [:result :document :document] r)) (not (= (document-kind scales) :vector)) (not (= (document-kind lanes) :map))
           (not (option-some?-of [:option :document] xs))) (option-none-of [:option :document])
    (option-some-of [:option :document] (document-map :series (val xs) :xmin (document-f64 (f64-from-bits (vector-at b 0))) :xmax (document-f64 (f64-from-bits (vector-at b 1)))
                                         :ymin (document-f64 (f64-from-bits (vector-at b 2))) :ymax (document-f64 (f64-from-bits (vector-at b 3)))))))))
