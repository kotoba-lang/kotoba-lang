(ns site.native.library-catalog-stream (:export [start begin end]))
;; Scanner for the pinned catalog's :repos vector. It only identifies complete
;; EDN map boundaries; each map is subsequently parsed by the document reader.
(defn- width [c :i64] :i64 (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4))
(defn- space? [c :i64] :bool (or (= c 32) (= c 9) (= c 10) (= c 13) (= c 44)))
(defn- comment-end [s :string i :i64 n :i64] :i64
 (loop [p i] (if (>= p n) p (let [c (string-code-point-at s p)] (if (= c 10) (+ p 1) (recur (+ p (width c))))))))
(defn- skip [s :string i :i64 n :i64] :i64
 (loop [p i]
  (if (>= p n) p
   (let [c (string-code-point-at s p)]
    (cond (space? c) (recur (+ p 1)) (= c 59) (recur (comment-end s (+ p 1) n)) :else p)))))
(defn start [s :string] :i64
 (let [marker ":repos" at (string-index-of s marker) n (string-byte-length s)
       p (if (< at 0) n (skip s (+ at (string-byte-length marker)) n))]
  (if (and (< p n) (= (string-code-point-at s p) 91)) (+ p 1) -1)))
;; >0 = next map start, 0 = properly closed vector/map, -1 = malformed.
(defn begin [s :string pos :i64] :i64
 (let [n (string-byte-length s) p (if (< pos 0) n (skip s pos n))]
  (if (>= p n) -1
   (let [c (string-code-point-at s p)]
    (cond (= c 123) p
          (= c 93) (let [q (skip s (+ p 1) n) r (if (< q n) (skip s (+ q 1) n) n)]
                     (if (and (< q n) (= (string-code-point-at s q) 125) (= r n)) 0 -1))
          :else -1)))))
;; The first map must end with balanced braces outside strings and comments.
(defn end [s :string start :i64] :i64
 (let [n (string-byte-length s)]
  (if (or (< start 0) (>= start n) (not (= (string-code-point-at s start) 123))) -1
   (loop [p start depth 0 quoted false escaped false]
    (if (>= p n) -1
     (let [c (string-code-point-at s p) next (+ p (width c))]
      (cond quoted (cond escaped (recur next depth true false) (= c 92) (recur next depth true true)
                         (= c 34) (recur next depth false false) :else (recur next depth true false))
            (= c 34) (recur next depth true false)
            (= c 59) (recur (comment-end s next n) depth false false)
            (= c 123) (recur next (+ depth 1) false false)
            (= c 125) (if (= depth 1) next (if (< depth 1) -1 (recur next (- depth 1) false false)))
            :else (recur next depth false false))))))))
