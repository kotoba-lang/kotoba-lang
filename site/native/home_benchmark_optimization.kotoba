(ns site.native.home-benchmark-optimization (:export [render])
 (:require [site.native.source-concat :as source] [site.native.home-section :as home]
           [site.native.locale-tree :as tree] [site.native.locale-rebase :as rebase]
           [multiformats.sha256 :as sha] [html-hiccup :as html] [table :as table]))
;; Render the source-owned optimization delivery subsection, streaming rows to
;; keep the document tree bounded. Unknown or changed source fails closed.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- field [d :document k :keyword] :document (if (= (document-kind d) :map) (val (document-get d k)) (document-null)))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- txt [o [:option :string]] :string (option-value-of [:option :string] o ""))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b)) (some (string-concat (txt a) (txt b))) (none)))
(defn- render-node [state [:ref :site/catalog] tag :string node :document] [:option :string]
 (let [localized (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))
       rebased (if (and (option-some?-of [:option :document] localized) (not (string=? tag "en"))) (rebase/rebase-links (val localized) tag "/") localized)]
  (if (option-some?-of [:option :document] rebased) (html/render (val rebased) 0) (none))))
(defn- form [state [:ref :site/catalog] tag :string src :string marker :string opening :i64 closing :i64] [:option :string]
 (let [pos (string-index-of src marker) tail (if (< pos 0) "" (string-substring src pos (string-byte-length src)))
       data (source/data (string-concat "~FORM~" tail) "~FORM~" opening closing)
       node (if (option-some?-of [:option :document] data) (home/evaluate (val data)) (option-none-of [:option :document]))]
  (if (option-some?-of [:option :document] node) (render-node state tag (val node)) (none))))
(defn- row [d :document] [:option :document]
 (if (or (not (= (document-kind d) :vector)) (not (= (document-count d) 3))
         (not (= (document-kind (item d 0)) :string)) (not (= (document-kind (item d 1)) :string)) (not (= (document-kind (item d 2)) :string))) (option-none-of [:option :document])
  (let [a (table/body-cell-node (record-new [:ref :tbl/cell] true 0) (item d 0))
        b (table/body-cell-node (record-new [:ref :tbl/cell] true 1) (item d 1))
        c (table/body-cell-node (record-new [:ref :tbl/cell] true 2) (item d 2))]
   (if (and (option-some?-of [:option :document] a) (option-some?-of [:option :document] b) (option-some?-of [:option :document] c))
    (option-some-of [:option :document] (document-vector (document-keyword :tr) (val a) (val b) (val c))) (option-none-of [:option :document])))))
(defn- rows [state [:ref :site/catalog] tag :string data :document i :i64 out [:option :string]] [:option :string]
 (if (or (not (option-some?-of [:option :string] out)) (>= i (document-count data))) out
  (let [r (row (item data i))] (if (option-some?-of [:option :document] r) (rows state tag data (+ i 1) (append out (render-node state tag (val r)))) (none)))))
(defn render [state [:ref :site/catalog] tag :string generator :string] [:option :string]
 (let [ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "5bb0ff5d9e2f80ca7a76545ead6d0138ab7516f2bb712dd4f059d8b0bb4f5ab2"))
       start (string-index-of generator "(dds/heading 3 \"Optimization delivery after the published run\"")
       src (if (< start 0) "" (string-substring generator start (string-byte-length generator)))
       heading (form state tag src "(dds/heading 3 \"Optimization delivery after the published run\"" 40 41)
       paragraph (form state tag src "[:p\n      \"The dated benchmark above remains immutable." 91 93)
       options (source/data src "(dds/table" 123 125) opts (val options) caption (field opts :caption) headers (field opts :headers) data (field opts :rows)
       body (if (and (= (document-kind data) :vector) (= (document-count data) 5)) (rows state tag data 0 (some "")) (none))]
  (if (or (not ok) (< start 0) (not (option-some?-of [:option :document] options)) (not (= (document-kind caption) :string))
          (not (= (document-kind headers) :vector)) (not (= (document-count headers) 3)) (not (option-some?-of [:option :string] body))) (none)
   (let [node (document-vector (document-keyword :div) (document-map :class (document-string "kot-table-scroll"))
                (document-vector (document-keyword :div) (document-map :class (document-string "dads-table"))
                 (document-vector (document-keyword :table) (document-map :class (document-string "dads-table__table"))
                  (document-vector (document-keyword :caption) caption)
                  (document-vector (document-keyword :thead) (document-vector (document-keyword :tr)
                   (table/header-cell-node (item headers 0) false) (table/header-cell-node (item headers 1) false) (table/header-cell-node (item headers 2) false)))
                  (document-vector (document-keyword :tbody) (document-string "987654321013")))))
         frame (render-node state tag node) raw (txt frame) pos (string-index-of raw "987654321013")]
    (if (or (not (option-some?-of [:option :string] frame)) (< pos 0)) (none)
     (let [tail (string-substring raw (+ pos 12) (string-byte-length raw))]
      (if (>= (string-index-of tail "987654321013") 0) (none)
       (append (append heading paragraph) (some (string-concat (string-substring raw 0 pos) (string-concat (txt body) tail)))))))))))
