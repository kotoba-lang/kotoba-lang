(ns site.native.home-benchmark-domain-section (:export [render])
 (:require [site.native.source-concat :as source] [site.native.home-section :as home]
           [site.native.locale-tree :as tree] [site.native.locale-rebase :as rebase] [multiformats.sha256 :as sha] [html-hiccup :as html]
           [site.native.home-benchmark-domain-charts :as charts] [site.native.home-benchmark-domains :as tables]))
;; Source-pinned workload domain charts, measurements and captions.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- field [d :document k :string] :document (val (document-get d (document-string k))))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- no [] [:option :string] (option-none-of [:option :string]))
(defn- yes [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- out [o [:option :string]] :string (option-value-of [:option :string] o ""))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b)) (yes (string-concat (out a) (out b))) (no)))
(defn- fragment [state [:ref :site/catalog] tag :string src :string marker :string opening :i64 closing :i64] [:option :string]
 (let [pos (string-index-of src marker) tail (if (< pos 0) "" (string-substring src pos (string-byte-length src)))
       form (source/data (string-concat "~FORM~" tail) "~FORM~" opening closing)
       node (if (option-some?-of [:option :document] form) (home/evaluate (val form)) (option-none-of [:option :document]))
       local (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)
       rebased (if (and (option-some?-of [:option :document] local) (not (string=? tag "en"))) (rebase/rebase-links (val local) tag "/") local)]
  (if (option-some?-of [:option :document] rebased) (html/render (val rebased) 0) (no))))
(defn render [state [:ref :site/catalog] tag :string generator :string report :string chart :string] [:option :string]
 (let [g (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "5bb0ff5d9e2f80ca7a76545ead6d0138ab7516f2bb712dd4f059d8b0bb4f5ab2"))
       r (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 report))) "4f396299dc966a750cd82e24ef6a930209649b7b4655043a3e64fc91951c9208"))
       start (string-index-of generator "(dds/heading 3 \"Six domains, side by side\"") stop (string-index-of generator "What each public benchmark does—and does not—establish")]
  (if (or (not g) (not r) (< start 0) (<= stop start)) (no)
   (let [src (string-substring generator start stop)
         a (fragment state tag src "(dds/heading 3 \"Six domains, side by side\"" 40 41)
         b (append a (fragment state tag src "[:p\n      \"Each panel is scaled to its own slowest lane" 91 93))
         c (append b (charts/render state tag generator report chart))
         d (append c (fragment state tag src "(caption\n      \"Process-cold medians in milliseconds" 40 41))
         e (append d (tables/render state tag generator report "cold"))
         f (append e (fragment state tag src "(caption\n      \"Every sample returned the exact reference checksum" 40 41))
         h (append f (tables/render state tag generator report "amortized"))]
    (append h (fragment state tag src "(caption\n      \"Each larger in-process batch" 40 41))))))
