(ns site.native.scaling-axis (:export [coordinate]))
;; Natural-log reduction used to place build-scaling chart points. The output
;; is a coordinate, not an SVG or a general-purpose math-library promise.
(defn- numeric? [d :document] :bool (or (= (document-kind d) :i64) (= (document-kind d) :f64)))
(defn- number [d :document] :f64
 (if (= (document-kind d) :i64) (i64-to-f64-rounded (option-value-of [:option :i64] (document-i64-value d) 0))
  (option-value-of [:option :f64] (document-f64-value d) 0.0)))
(defn- natural-log [x :f64] :f64
 (loop [v x exponent 0]
  (if (f64-ge v 2.0) (recur (f64-div v 2.0) (+ exponent 1))
   (if (f64-lt v 1.0) (recur (f64-mul v 2.0) (- exponent 1))
    (let [z (f64-div (f64-sub v 1.0) (f64-add v 1.0)) zz (f64-mul z z)]
     (loop [i 0 term z sum 0.0]
      (if (>= i 24) (f64-add (f64-mul 2.0 sum) (f64-mul (i64-to-f64-rounded exponent) 0.6931471805599453))
       (recur (+ i 1) (f64-mul term zz) (f64-add sum (f64-div term (i64-to-f64-rounded (+ (* 2 i) 1))))))))))))
(defn coordinate [x :document lower :document upper :document axis :keyword] [:option :document]
 (let [v (number x) lo (number lower) hi (number upper)
       valid (and (numeric? x) (numeric? lower) (numeric? upper)
                  (or (= axis :x) (= axis :y)) (f64-ge lo 0.000000001) (f64-le hi 1000000000000.0)
                  (f64-gt hi lo) (f64-ge v lo) (f64-le v hi))]
  (if (not valid) (option-none-of [:option :document])
   (let [fraction (f64-div (f64-sub (natural-log v) (natural-log lo)) (f64-sub (natural-log hi) (natural-log lo)))
         position (if (= axis :x) (f64-add 72.0 (f64-mul 536.0 fraction)) (f64-sub 312.0 (f64-mul 294.0 fraction)))]
    (option-some-of [:option :document] (document-f64 position))))))
