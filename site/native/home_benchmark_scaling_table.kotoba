(ns site.native.home-benchmark-scaling-table (:export [render])
 (:require [json.core :as json] [site.native.locale-tree :as tree] [multiformats.sha256 :as sha]
           [html-hiccup :as html] [table :as table]))
;; Full build-scaling measurement table from the pinned report; not the section's chart or ordering tables.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- field [d :document k :string] :document (val (document-get d (document-string k))))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- num [d :document] :string
 (let [k (document-kind d) s (document-edn-print d) n (string-byte-length s)]
  (if (or (= k :i64) (= k :f64))
   (if (and (= k :f64) (>= n 2) (string=? (string-substring s (- n 2) n) ".0")) (string-substring s 0 (- n 2)) s) "")))
(defn- cell-value [d :document] [:option :document]
 (let [status (field d "status") s (text status)]
  (if (not (= (document-kind status) :string)) (option-none-of [:option :document])
   (if (string=? s "measured")
    (let [summary (field d "summary") median (if (= (document-kind summary) :map) (num (field summary "median")) "")]
     (if (string=? median "") (option-none-of [:option :document]) (option-some-of [:option :document] (document-string (string-concat median " ms")))))
    (option-some-of [:option :document] (document-string (cond (string=? s "invalid") "invalid artifact" (string=? s "failed") "build failed"
     (string=? s "unavailable") "no toolchain" (string=? s "not-run") "budget spent" :else s)))))))
(defn- cells [scales :document lane :string i :i64 out :document] [:option :document]
 (if (>= i (document-count scales)) (option-some-of [:option :document] out)
  (let [d (field (field (item scales i) "lanes") lane) c (cell-value d)]
   (if (not (option-some?-of [:option :document] c)) (option-none-of [:option :document])
    (cells scales lane (+ i 1) (document-vector-conj out (document-vector (document-keyword :td) (val c))))))))
(defn- row [scales :document lane :string d :document] [:option :document]
 (let [label (field d "label") target (field d "target")
       shown-label (cond (string=? lane "kotoba-wasm-cli") "Kotoba" (or (string=? lane "amu-wasm") (string=? lane "amu-native")) "Kotoba / Amu" :else (text label))
       shown-target (if (string=? lane "kotoba-wasm-cli") "Released CLI · WebAssembly" (text target))]
  (if (or (not (= (document-kind label) :string)) (not (= (document-kind target) :string))) (option-none-of [:option :document])
   (cells scales lane 0 (document-vector (document-keyword :tr) (document-vector (document-keyword :th)
    (document-map :class (document-string "dads-table__row-header") :scope (document-string "row"))
    (document-string (string-concat shown-label (string-concat " · " shown-target)))))))))
(defn- rows [state [:ref :site/catalog] tag :string scales :document lanes :document order :document i :i64 out :string] [:option :string]
 (if (>= i (document-count order)) (option-some-of [:option :string] out)
  (let [key (text (item order i)) d (field lanes key)]
   (if (= (document-kind d) :null) (rows state tag scales lanes order (+ i 1) out)
    (let [r (row scales key d) localized (if (and (option-some?-of [:option :document] r) (not (string=? tag "en"))) (tree/map-indexed state (val r)) r)
          rendered (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (option-none-of [:option :string]))]
     (if (not (option-some?-of [:option :string] rendered)) (option-none-of [:option :string])
      (rows state tag scales lanes order (+ i 1) (string-concat out (option-value-of [:option :string] rendered "")))))))))
(defn- headers [scales :document i :i64 out :document] [:option :document]
 (if (>= i (document-count scales)) (option-some-of [:option :document] out)
  (let [k (num (field (item scales i) "k"))]
   (if (string=? k "") (option-none-of [:option :document])
    (headers scales (+ i 1) (document-vector-conj out (table/header-cell-node (document-string (string-concat "K=" k)) false)))))))
(defn render [state [:ref :site/catalog] tag :string generator :string report :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67"))
       r-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 report))) "9bb56646bb55a8746b36c66c42ebefb48bebd17ab60c4df79a2ab1702537e229"))]
  (if (or (not g-ok) (not r-ok)) (option-none-of [:option :string])
   (let [decoded (json/decode report) d (result-value-of [:result :document :document] decoded (document-null)) scales (field d "scales") lanes (field d "lanes")
         order (document-vector (document-string "kotoba-wasm-cli") (document-string "amu-wasm") (document-string "amu-native")
                 (document-string "rustc-wasm") (document-string "rustc-native") (document-string "clang-wasm") (document-string "clang-native") (document-string "javac"))
         head (headers scales 0 (document-vector (document-keyword :tr) (table/header-cell-node (document-string "Toolchain / target") false)))
         body (rows state tag scales lanes order 0 "")]
    (if (or (not (result-ok?-of [:result :document :document] decoded)) (not (= (document-kind scales) :vector)) (not (= (document-kind lanes) :map))
            (not (option-some?-of [:option :document] head)) (not (option-some?-of [:option :string] body))) (option-none-of [:option :string])
     (let [node (document-vector (document-keyword :div) (document-map :class (document-string "kot-table-scroll"))
            (document-vector (document-keyword :div) (document-map :class (document-string "dads-table"))
             (document-vector (document-keyword :table) (document-map :class (document-string "dads-table__table"))
              (document-vector (document-keyword :caption) (document-string "Process-cold build wall time by source size; medians, one host, lanes interleaved"))
              (document-vector (document-keyword :thead) (val head)) (document-vector (document-keyword :tbody) (document-string "987654321013")))))
           localized (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))
           frame (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (option-none-of [:option :string]))
           raw (option-value-of [:option :string] frame "") marker (string-index-of raw "987654321013")]
      (if (or (not (option-some?-of [:option :string] frame)) (< marker 0)) (option-none-of [:option :string])
       (option-some-of [:option :string] (string-concat (string-substring raw 0 marker) (string-concat (option-value-of [:option :string] body "")
         (string-substring raw (+ marker 12) (string-byte-length raw)))))))))))
)
