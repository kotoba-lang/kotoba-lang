(ns site.native.docs-page (:export [render slug source-name valid-locale? integrate])
 (:require [multiformats.sha256 :as sha]))
;; A bounded renderer for the authored course's Markdown subset. No host eval,
;; raw HTML, remote fetch, or client-side Markdown dependency is used.
(defn- cat [a :string b :string c :string] :string (string-concat a (string-concat b c)))
(defn- size [s :string] :i64 (string-byte-length s))
;; Prefix checks must not slice through a UTF-8 character boundary.
(defn- starts [s :string p :string] :bool (= (string-index-of s p) 0))
(defn- width [c :i64] :i64 (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4))
(defn- ws [c :i64] :bool (or (= c 32) (= c 9) (= c 10) (= c 13)))
(defn- trim [s :string] :string
 (loop [i 0 first -1 last 0]
  (if (>= i (size s)) (if (< first 0) "" (string-substring s first last))
   (let [c (string-code-point-at s i) next (+ i (width c))]
    (recur next (if (and (< first 0) (not (ws c))) i first) (if (ws c) last next))))))
(defn- find [s :string p :string i :i64] :i64
 (if (or (< i 0) (> i (size s))) -1
  (let [n (string-index-of (string-substring s i (size s)) p)] (if (< n 0) -1 (+ i n)))))
(defn- esc [s :string] :string
 (string-replace-all (string-replace-all (string-replace-all (string-replace-all s "&" "&amp;") "<" "&lt;") ">" "&gt;") "\"" "&quot;"))
(defn valid-locale? [tag :string] :bool (or (string=? tag "en") (string=? tag "ja")))
(defn slug [i :i64] :string
 (case i 0 "" 1 "01-first-program" 2 "02-forms" 3 "03-reader-and-names" 4 "04-checking-and-ir" 5 "05-ipld"
  6 "06-definition-identity" 7 "07-effects-and-authority" 8 "08-code-generation" 9 "09-kototama"
  10 "10-runtime-performance" 11 "11-build-performance" 12 "12-reading-and-experiments" 13 "examples" ":invalid"))
(defn source-name [tag :string i :i64] :string
 (let [stem (cond (= i 0) "README" (= i 13) "examples/README" :else (slug i))]
  (cat stem (if (string=? tag "ja") ".ja" "") ".md")))
(defn- root [tag :string] :string (if (string=? tag "ja") "/ja/docs/amu/" "/docs/amu/"))
(defn- route [tag :string i :i64] :string (if (= i 0) (root tag) (cat (root tag) (slug i) "/")))
(defn- which [s :string] :i64
 (loop [i 0] (if (>= i 14) -1 (if (string=? s (slug i)) i (recur (+ i 1))))))
(defn- item [xs :document i :i64] :string
 (option-value-of [:option :string] (document-string-value (option-value-of [:option :document] (document-vector-at xs i) (document-null))) ""))
(defn- title [s :string] :string
 (let [n (find s "\n" 0)] (if (and (starts s "# ") (> n 2)) (string-substring s 2 n) "DOCS_INVALID")))
(defn- download? [s :string] :bool
 (or (string=? s "00-literal.kotoba") (string=? s "01-arithmetic.kotoba") (string=? s "02-bindings.kotoba")
     (string=? s "03-branch.kotoba") (string=? s "04-loop.kotoba") (string=? s "05-functions.kotoba")
     (string=? s "negative-name.kotoba") (string=? s "negative-operation.kotoba") (string=? s "negative-type.kotoba")
     (string=? s "observe.py") (string=? s "observations-macos-arm64-20261106.json")))
(defn- href [s :string tag :string page :i64] :string
 (cond (starts s "https://") (if (or (>= (find s "\"" 0) 0) (>= (find s "\n" 0) 0)) "DOCS_INVALID" s)
  (starts s "../../../lang/") (string-concat "https://github.com/kotoba-lang/kotoba-lang/blob/main/lang/" (string-substring s 14 (size s)))
  (starts s "../../lang/") (string-concat "https://github.com/kotoba-lang/kotoba-lang/blob/main/docs/lang/" (string-substring s 11 (size s)))
  (starts s "../../adr/") (string-concat "https://github.com/kotoba-lang/kotoba-lang/blob/main/docs/adr/" (string-substring s 10 (size s)))
  (string=? s "../../README.md") "https://github.com/kotoba-lang/kotoba-lang/tree/main/docs"
  :else
  (let [ja (>= (find s ".ja.md" 0) 0) language (if ja "ja" tag)
        path (string-replace-all s ".ja.md" ".md")
        simple (cond (starts path "examples/") (string-substring path 9 (size path))
                     (starts path "../") (string-substring path 3 (size path)) :else path)]
   (cond (string=? path "examples/README.md") (route language 13)
         (or (string=? path "README.md") (string=? path "../README.md")) (route language (if (and (= page 0) (string=? path "README.md")) 0 0))
         (download? simple) (cat "/docs/amu/examples/" simple "")
         :else (let [n (size simple) idx (if (and (> n 3) (string=? (string-substring simple (- n 3) n) ".md")) (which (string-substring simple 0 (- n 3))) -1)]
                 (if (> idx 0) (route language idx) "DOCS_INVALID"))))))
(defn- inline [s :string tag :string page :i64 depth :i64] :string
 (if (> depth 6) "DOCS_INVALID"
  (loop [i 0 plain "" out ""]
   (if (>= i (size s)) (string-concat out (esc plain))
    (let [c (string-code-point-at s i) next (+ i (width c))]
     (cond
      (= c 96) (let [end (find s "`" next)]
       (if (< end 0) "DOCS_INVALID" (recur (+ end 1) "" (cat out (esc plain) (cat "<code>" (esc (string-substring s next end)) "</code>")))))
      (and (= c 42) (< next (size s)) (= (string-code-point-at s next) 42))
       (let [end (find s "**" (+ i 2))]
        (if (< end 0) "DOCS_INVALID" (recur (+ end 2) "" (cat out (esc plain) (cat "<strong>" (inline (string-substring s (+ i 2) end) tag page (+ depth 1)) "</strong>")))))
      (= c 91) (let [mid (find s "](" next) end (if (< mid 0) -1 (find s ")" (+ mid 2)))]
       (if (< end 0) (recur next (string-concat plain "[") out)
        (let [url (href (string-substring s (+ mid 2) end) tag page) label (inline (string-substring s next mid) tag page (+ depth 1))]
         (recur (+ end 1) "" (cat out (esc plain) (cat "<a href=\"" (esc url) (cat "\">" label "</a>")))))))
      :else (recur next (string-concat plain (string-substring s i next)) out)))))))
(defn- graph-label [source :string id :string] :string
 (let [at (find source (string-concat id "[") 0) start (+ at (+ (size id) 1)) end (if (< at 0) -1 (find source "]" start))]
  (if (< end 0) "DOCS_INVALID"
   (let [label (string-substring source start end) n (size label)]
    (if (and (> n 1) (= (string-code-point-at label 0) 34) (= (string-code-point-at label (- n 1)) 34)) (string-substring label 1 (- n 1)) label)))))
(defn- diagram [s :string tag :string] :string
 (if (not (starts s "flowchart LR\n")) "DOCS_INVALID"
  (loop [i 13 out "" count 0]
   (if (>= i (size s))
    (if (or (< count 1) (> count 20)) "DOCS_INVALID"
     (cat "<figure class=\"diagram\"><figcaption>" (if (string=? tag "ja") "関係図" "Relationships") (cat "</figcaption>" out "</figure>")))
    (let [end0 (find s "\n" i) end (if (< end0 0) (size s) end0) line (trim (string-substring s i end))
          arrow (find line "-->" 0) dotted (find line "-.->" 0) at (if (>= arrow 0) arrow dotted) jump (if (>= arrow 0) 3 4)]
     (if (string=? line "") (recur (+ end 1) out count)
      (if (< at 0) "DOCS_INVALID"
       (let [left (trim (string-substring line 0 at)) right (trim (string-substring line (+ at jump) (size line)))
             lbr (find left "[" 0) rbr (find right "[" 0)
             a (if (>= lbr 0) (string-substring left 0 lbr) left) b (if (>= rbr 0) (string-substring right 0 rbr) right)]
        (recur (+ end 1) (cat out "<div class=\"edge\"><span class=\"node\">" (cat (esc (graph-label s a)) (if (>= arrow 0) "</span><span class=\"arrow\" aria-label=\"arrow\">→</span><span class=\"node\">" "</span><span class=\"arrow dotted\" aria-label=\"dashed arrow\">⇢</span><span class=\"node\">") (cat (esc (graph-label s b)) "</span></div>" ""))) (+ count 1))))))))))
(defn- paragraph [s :string tag :string page :i64] :string (if (string=? s "") "" (cat "<p>" (inline s tag page 0) "</p>")))
(defn- close-list [kind :i64] :string (case kind 1 "</ul>" 2 "</ol>" ""))
(defn- close-table [yes :bool] :string (if yes "</table></div>" ""))
(defn- cells [s :string tag :string page :i64 head :bool] :string
 (let [end (- (size s) 1) cell (if head "th" "td")]
  (loop [i 1 out ""]
   (if (>= i end) (cat "<tr>" out "</tr>")
    (let [at (find s "|" i)]
     (if (< at 0) "DOCS_INVALID"
      (recur (+ at 1) (cat out (cat "<" cell ">") (cat (inline (trim (string-substring s i at)) tag page 0) (cat "</" cell ">") "")))))))))
(defn- markdown [s :string tag :string page :i64] :string
 (loop [i 0 out "" para "" list-kind 0 table false fence "" code ""]
  (if (>= i (size s))
   (if (not (string=? fence "")) "DOCS_INVALID" (cat out (paragraph para tag page) (string-concat (close-list list-kind) (close-table table))))
   (let [end0 (find s "\n" i) end (if (< end0 0) (size s) end0) raw (string-substring s i end) line (trim raw) next (+ end 1)]
    (cond
     (not (string=? fence ""))
      (if (string=? line "```")
       (let [block (if (string=? fence "mermaid") (diagram code tag) (cat "<pre><code class=\"language-" fence (cat "\">" (esc code) "</code></pre>")))]
        (recur next (string-concat out block) "" 0 false "" ""))
       (recur next out para list-kind table fence (cat code raw "\n")))
     (starts line "```")
      (let [lang (string-substring line 3 (size line)) before (cat out (paragraph para tag page) (string-concat (close-list list-kind) (close-table table)))]
       (if (or (string=? lang "sh") (string=? lang "clojure") (string=? lang "text") (string=? lang "mermaid"))
        (recur next before "" 0 false lang "") "DOCS_INVALID"))
     (or (starts line "**English** |") (starts line "[English](")) (recur next out para list-kind table "" "")
     (string=? line "") (recur next (cat out (paragraph para tag page) (string-concat (close-list list-kind) (close-table table))) "" 0 false "" "")
     (starts line "# ") (recur next (cat out (paragraph para tag page) (cat "<h1>" (inline (string-substring line 2 (size line)) tag page 0) "</h1>")) "" 0 false "" "")
     (starts line "## ") (recur next (cat out (paragraph para tag page) (cat (string-concat (close-list list-kind) (close-table table)) "<h2>" (cat (inline (string-substring line 3 (size line)) tag page 0) "</h2>" ""))) "" 0 false "" "")
     (starts line "|")
      (if (starts line "|---") (recur next out "" 0 true "" "")
       (recur next (cat out (string-concat (paragraph para tag page) (close-list list-kind)) (cat (if table "" "<div class=\"table-scroll\" tabindex=\"0\"><table>") (cells line tag page (not table)) "")) "" 0 true "" ""))
     :else
      (let [ordered (and (> (size line) 3) (>= (string-code-point-at line 0) 49) (<= (string-code-point-at line 0) 57) (= (find line ". " 0) 1))
            bullet (starts line "- ") kind (if ordered 2 (if bullet 1 0))]
       (if (> kind 0)
        (recur next (cat out (string-concat (paragraph para tag page) (close-table table))
         (cat (if (= list-kind kind) "" (string-concat (close-list list-kind) (if ordered "<ol>" "<ul>")))
          "<li>" (cat (inline (string-substring line (if ordered 3 2) (size line)) tag page 0) "</li>" ""))) "" kind false "" "")
        (recur next (cat out (close-list list-kind) (close-table table)) (if (string=? para "") line (cat para " " line)) 0 false "" ""))))))))
(defn- toc [tag :string current :i64 texts :document] :string
 (loop [i 0 out ""]
  (if (>= i 14) out
   (recur (+ i 1) (cat out "<li>" (cat "<a href=\"" (route tag i)
    (cat (if (= i current) "\" aria-current=\"page\">" "\">") (esc (title (item texts i))) "</a></li>")))))))
(defn- pager [tag :string current :i64 texts :document] :string
 (let [before (if (> current 0) (cat "<a rel=\"prev\" href=\"" (route tag (- current 1)) (cat "\">← " (esc (title (item texts (- current 1)))) "</a>")) "")
       after (if (< current 13) (cat "<a rel=\"next\" href=\"" (route tag (+ current 1)) (cat "\">" (esc (title (item texts (+ current 1)))) " →</a>")) "")]
  (cat "<nav class=\"pager\" aria-label=\"Chapter navigation\">" (string-concat before after) "</nav>")))
(defn- make-head [tag :string heading :string en :string ja :string current :string] :string
 (let [a (cat "<!DOCTYPE html>\n<html lang=\"" tag "\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">")
       b (cat "<title>" (esc heading) " · Kotoba Docs</title>")
       c (cat "<meta name=\"description\" content=\"" (esc heading) " — Amu compiler course\">")
       d (cat "<link rel=\"canonical\" href=\"https://kotoba-lang.org" current "\">")
       e (cat "<link rel=\"alternate\" hreflang=\"en\" href=\"https://kotoba-lang.org" en "\">")
       f (cat "<link rel=\"alternate\" hreflang=\"ja\" href=\"https://kotoba-lang.org" ja "\">")
       g (cat "<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://kotoba-lang.org" en "\"><link rel=\"stylesheet\" href=\"/docs/amu/course.css\"></head><body>")]
  (cat a b (cat c d (cat e f g)))))
(defn- make-header [tag :string en :string ja :string] :string
 (let [a "<a class=\"skip\" href=\"#main\">Skip to content</a><header><a class=\"brand\" href=\"/\">Kotoba</a>"
       b (cat "<a href=\"" (root tag) "\">Docs</a><nav aria-label=\"Language\">")
       c (cat "<a lang=\"en\" hreflang=\"en\" href=\"" en (if (string=? tag "en") "\" aria-current=\"page\">English</a>" "\">English</a>"))
       d (cat "<a lang=\"ja\" hreflang=\"ja\" href=\"" ja (if (string=? tag "ja") "\" aria-current=\"page\">日本語</a></nav></header>" "\">日本語</a></nav></header>"))]
  (cat a b (string-concat c d))))
(defn render [tag :string name :string texts :document] [:option :string]
 (let [i (which name)]
  (if (or (not (valid-locale? tag)) (< i 0) (not (= (document-kind texts) :vector)) (not (= (document-count texts) 14))) (option-none-of [:option :string])
   (let [source (item texts i) heading (title source) content (if (> (size source) 65536) "DOCS_INVALID" (markdown source tag i))
         en (route "en" i) ja (route "ja" i) current (route tag i)
         head (make-head tag heading en ja current) header (make-header tag en ja)
         sidebar (cat "<div class=\"layout\"><aside><nav aria-label=\"Course chapters\"><ol>" (toc tag i texts) "</ol></nav></aside><main id=\"main\">")
         foot "</main></div><footer><a href=\"/\">Kotoba</a> · <a href=\"/legal/\">Operator</a> · <a href=\"https://github.com/kotoba-lang/kotoba-lang/tree/main/docs/learn/amu\">Source</a></footer></body></html>"
         doc (cat head header (cat sidebar content (string-concat (pager tag i texts) foot)))]
    (if (or (>= (find doc "DOCS_INVALID" 0) 0) (not (starts source "# "))) (option-none-of [:option :string]) (option-some-of [:option :string] doc))))))
;; Integrate the new Docs routes into already generated native site HTML.
;; Only exact href attributes are rewritten; prose/scripts and other links stay intact.
(defn integrate [html :string tag :string] :string
 (let [dest (cat "href=\"" (root tag) "\"")
       a (string-replace-all html "href=\"#docs\"" dest)
       b (string-replace-all a "href=\"/#docs\"" dest)
       c (string-replace-all b "href=\"https://github.com/kotoba-lang/kotoba-lang/tree/main/docs\"" dest)
       tags (document-vector (document-string "ar") (document-string "arz") (document-string "bn") (document-string "de") (document-string "es") (document-string "fr") (document-string "hi") (document-string "id") (document-string "ja") (document-string "ko") (document-string "mr") (document-string "pcm") (document-string "pt") (document-string "ru") (document-string "ur") (document-string "zh-Hans"))]
  (loop [i 0 out c]
   (if (>= i (document-count tags)) out
    (recur (+ i 1) (string-replace-all out (cat "href=\"/" (item tags i) "/#docs\"") dest))))))
