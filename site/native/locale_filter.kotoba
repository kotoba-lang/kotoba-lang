(ns site.native.locale-filter (:export [translatable?]))

;; Native equivalent of site/src/kotoba/site/locales.cljk/translatable?.
;; Java whitespace applies to brand and numeric checks; JS regex whitespace
;; applies to URL, email and filename checks.
(defn- width [c :i64] :i64
  (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4))

(defn- java-space? [c :i64] :bool
  (or (and (>= c 9) (<= c 13)) (and (>= c 28) (<= c 31)) (= c 32)
      (= c 5760) (and (>= c 8192) (<= c 8198)) (and (>= c 8200) (<= c 8202))
      (= c 8232) (= c 8233) (= c 8287) (= c 12288)))

(defn- regex-space? [c :i64] :bool
  (or (and (>= c 9) (<= c 13)) (= c 32) (= c 160) (= c 5760)
      (and (>= c 8192) (<= c 8202)) (= c 8232) (= c 8233) (= c 8239)
      (= c 8287) (= c 12288) (= c 65279)))

(defn- trim-start [s :string i :i64 java? :bool] :i64
  (if (>= i (string-byte-length s)) i
    (let [c (string-code-point-at s i)]
      (if (if java? (java-space? c) (regex-space? c))
        (trim-start s (+ i (width c)) java?) i))))

(defn- trim-end [s :string i :i64 last :i64 java? :bool] :i64
  (if (>= i (string-byte-length s)) last
    (let [c (string-code-point-at s i) n (+ i (width c))]
      (trim-end s n (if (if java? (java-space? c) (regex-space? c)) last n) java?))))

(defn- trim [s :string java? :bool] :string
  (let [a (trim-start s 0 java?) b (trim-end s a a java?)]
    (string-substring s a b)))

(defn- ascii-letter? [s :string] :bool
  (loop [i 0]
    (if (>= i (string-byte-length s)) false
      (let [c (string-code-point-at s i)]
        (if (or (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122)))
          true (recur (+ i (width c))))))))

(defn- brand? [s :string] :bool
  (or (string=? s "Kotoba") (string=? s "Kotobase") (string=? s "Kotoba Cloud")
      (string=? s "Murakumo") (string=? s "Itonami") (string=? s "GitHub")
      (string=? s "Kotoba Foundation") (string=? s "Ryo Awai") (string=? s "WebAssembly")
      (string=? s "CID") (string=? s "SHA-256") (string=? s "JSON") (string=? s "EDN")
      (string=? s "DID") (string=? s "GPU") (string=? s "CPU")))

(defn- numeric-char? [c :i64] :bool
  (or (and (>= c 48) (<= c 57)) (= c 44) (= c 46)))

(defn- numeric-end [s :string i :i64] :i64
  (if (>= i (string-byte-length s)) i
    (if (numeric-char? (string-code-point-at s i)) (numeric-end s (+ i 1)) i)))

(defn- unit? [s :string] :bool
  (or (string=? s "ms") (string=? s "ns") (string=? s "s") (string=? s "B")
      (string=? s "KiB") (string=? s "MiB") (string=? s "GiB") (string=? s "%")))

(defn- numeric? [s :string] :bool
  (let [end (numeric-end s 0)]
    (if (= end 0) false
      (let [u (trim-start s end false)]
        (unit? (string-substring s u (string-byte-length s)))))))

(defn- no-space? [s :string i :i64] :bool
  (if (>= i (string-byte-length s)) true
    (let [c (string-code-point-at s i)]
      (if (regex-space? c) false (no-space? s (+ i (width c)))))))

(defn- path-char? [c :i64] :bool
  (or (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122))
      (and (>= c 48) (<= c 57)) (= c 95) (= c 46) (= c 47) (= c 58) (= c 45)))

(defn- path-chars? [s :string i :i64] :bool
  (if (>= i (string-byte-length s)) true
    (let [c (string-code-point-at s i)]
      (if (path-char? c) (path-chars? s (+ i (width c))) false))))

(defn- ending? [s :string suffix :string] :bool
  (let [n (string-byte-length s) m (string-byte-length suffix)]
    (if (<= n m) false
      (loop [i 0]
        (cond (>= i n) false
              (= (- n i) m) (string=? (string-substring s i n) suffix)
              (< (- n i) m) false
              :else (recur (+ i (width (string-code-point-at s i)))))))))

(defn- filename? [s :string] :bool
  (and (path-chars? s 0)
       (or (ending? s ".edn") (ending? s ".json") (ending? s ".cljs")
           (ending? s ".cljc") (ending? s ".cljk") (ending? s ".clj")
           (ending? s ".md") (ending? s ".kotoba") (ending? s ".wasm"))))

(defn- link? [s :string] :bool
  (let [n (string-byte-length s) at (string-index-of s "@")
        http (string-index-of s "http://") https (string-index-of s "https://")]
    (and (no-space? s 0)
         (or (and (= http 0) (> n 7)) (and (= https 0) (> n 8))
             (and (> at 0) (< at (- n 1))) (filename? s)))))

(defn translatable? [s :string] :bool
  (and (ascii-letter? s) (not (brand? (trim s true)))
       (not (numeric? (trim s true))) (not (link? (trim s false)))))
