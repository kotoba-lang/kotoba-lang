(ns site.native.locale-pages
  (:export [page-valid?]))

(defn- contains? [text :string part :string] :bool
  (>= (string-index-of text part) 0))

(defn- locale-prefix [tag :string] :string
  (if (string=? tag "en") "" (string-concat "/" tag)))

(defn- link? [html :string tag :string path :string] :bool
  (contains? html
    (string-concat "hreflang=\"" (string-concat tag
      (string-concat "\" href=\"https://kotoba-lang.org"
        (string-concat (locale-prefix tag) (string-concat path "\"")))))))

(defn- alternatives? [html :string path :string] :bool
  (and (link? html "en" path) (link? html "ar" path) (link? html "arz" path)
       (link? html "bn" path) (link? html "de" path) (link? html "es" path)
       (link? html "fr" path) (link? html "hi" path) (link? html "id" path)
       (link? html "ja" path) (link? html "ko" path) (link? html "mr" path)
       (link? html "pcm" path) (link? html "pt" path) (link? html "ru" path)
       (link? html "ur" path) (link? html "zh-Hans" path)))

(defn- find-from [text :string part :string start :i64] :i64
  (let [found (string-index-of (string-substring text start (string-byte-length text)) part)]
    (if (< found 0) -1 (+ start found))))

;; Compare the same <pre ...> bodies the existing site locale test compares.
;; A truncated block is refused instead of silently treating it as absent.
(defn- same-code? [english :string html :string] :bool
  (loop [e 0 h 0]
    (let [ep (find-from english "<pre" e) hp (find-from html "<pre" h)]
      (cond (and (< ep 0) (< hp 0)) true
            (or (< ep 0) (< hp 0)) false
            :else
            (let [es (find-from english ">" ep) hs (find-from html ">" hp)]
              (if (or (< es 0) (< hs 0)) false
                (let [ee (find-from english "</pre>" (+ es 1)) he (find-from html "</pre>" (+ hs 1))]
                  (if (or (< ee 0) (< he 0)) false
                    (if (string=? (string-substring english (+ es 1) ee)
                                  (string-substring html (+ hs 1) he))
                      (recur (+ ee 6) (+ he 6)) false)))))))))

(defn- landing? [html :string] :bool
  (and (contains? html "id=\"architecture\"") (contains? html "id=\"typed-eval\"")
       (contains? html "id=\"benchmark\"") (contains? html "id=\"start\"")
       (contains? html "id=\"libraries\"") (contains? html "id=\"roadmap\"")
       (contains? html "id=\"community\"") (contains? html "id=\"kot-doc-search\"")
       (not (contains? html "freebuff"))))

(defn page-valid? [english :string html :string tag :string path :string] :bool
  (let [rtl (or (string=? tag "ar") (string=? tag "arz") (string=? tag "ur"))
        lang (string-concat "<html lang=\"" (string-concat tag (if rtl "\" dir=\"rtl\"" "\"")))
        canonical (string-concat "rel=\"canonical\" href=\"https://kotoba-lang.org"
                    (string-concat (locale-prefix tag) (string-concat path "\"")))]
    (and (not (contains? html "freebuff")) (contains? html lang) (contains? html canonical) (alternatives? html path)
         (same-code? english html) (or (not (string=? path "/")) (landing? html)))))
