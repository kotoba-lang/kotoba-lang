(ns site.native.home-morph-highlight (:export [render])
 (:require [site.native.home-highlight :as highlight]))
;; The upstream highlighter refuses all but the pinned ASCII demo. Add the
;; addressable character spans used by its morph animation; this is not a
;; general HTML parser or an arbitrary-source highlighter.
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- space? [c :i64] :bool (or (= c 32) (= c 9) (= c 10) (= c 13)))
(defn- convert [s :string i :i64 index :i64 out :string] [:option :string]
 (if (>= i (string-byte-length s)) (option-some-of [:option :string] out)
  (let [c (string-code-point-at s i)]
   (cond (= c 60)
          (let [tail (string-substring s i (string-byte-length s)) end (string-index-of tail ">")]
           (if (< end 0) (none) (convert s (+ i end 1) index (string-concat out (string-substring tail 0 (+ end 1))))))
         (or (= c 38) (> c 127)) (none)
         (space? c) (convert s (+ i 1) index (string-concat out (string-substring s i (+ i 1))))
         :else (convert s (+ i 1) (+ index 1) (string-concat out (string-concat "<span class=\"kot-ch\" style=\"--i:" (string-concat (string-from-i64 index) (string-concat "\">" (string-concat (string-substring s i (+ i 1)) "</span>"))))))))))
(defn render [source :string grammar :string tokenizer :string theme :string] [:option :string]
 (let [raw (highlight/render source grammar tokenizer theme)
       prefix "<code class=\"kot-source\" aria-label=\"Kotoba source code\">"
       new-prefix "<code class=\"kot-source kot-morph-src\" aria-label=\"Kotoba source code\">"
       s (option-value-of [:option :string] raw "") p (string-index-of s prefix)]
  (if (or (not (option-some?-of [:option :string] raw)) (not (= p 0))) (none)
   (convert s (string-byte-length prefix) 0 new-prefix))))
