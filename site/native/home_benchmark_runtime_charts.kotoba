(ns site.native.home-benchmark-runtime-charts (:export [render])
 (:require [json.core :as json] [site.native.locale-tree :as tree] [multiformats.sha256 :as sha]
           [html-hiccup :as html] [components :as dds]))
;; Six bounded runtime comparison charts, using the complete pinned report.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- field [d :document k :string] :document (val (document-get d (document-string k))))
(defn- attr [d :document k :keyword] :document (val (document-get d k)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- number [d :document] :f64
 (if (= (document-kind d) :i64) (i64-to-f64-rounded (option-value-of [:option :i64] (document-i64-value d) 0))
  (option-value-of [:option :f64] (document-f64-value d) 0.0)))
(defn- fixed [x :f64 scale :i64 digits :i64] :string
 (let [v (f64-to-i64-truncating (f64-add (f64-mul x (i64-to-f64-rounded scale)) 0.5)) whole (quot v scale) frac (rem v scale)]
  (string-concat (string-from-i64 whole) (string-concat "." (string-concat (if (and (= digits 3) (< frac 100)) "0" "")
   (string-concat (if (and (>= digits 2) (< frac 10)) "0" "") (string-from-i64 frac)))))))
(defn- pair [pairs :document domain :string comparator :string i :i64] :document
 (if (>= i (document-count pairs)) (document-null)
  (let [d (item pairs i)]
   (if (and (string=? (text (field d "domain")) domain) (or (string=? comparator "") (string=? (text (field d "comparator")) comparator))) d
    (pair pairs domain comparator (+ i 1))))))
(defn- make-row [label :document value :document lead :bool] :document
 (document-map :label label :value value :lead (document-bool lead)))
(defn- comparators [pairs :document cs :document domain :string i :i64 out :document] [:option :document]
 (if (>= i (document-count cs)) (option-some-of [:option :document] out)
  (let [c (item cs i) label (field c "label") id (field c "id") p (pair pairs domain (text id) 0) n (field p "baselineMedian")]
   (if (or (not (= (document-kind label) :string)) (not (= (document-kind id) :string)) (not (f64-gt (number n) 0.0))) (option-none-of [:option :document])
    (comparators pairs cs domain (+ i 1) (document-vector-conj out (make-row label n false)))))))
(defn- next-index [rows :document prev :f64 prev-i :i64] :i64
 (loop [i 0 best -1 bestval 0.0]
  (if (>= i (document-count rows)) best
   (let [v (number (attr (item rows i) :value)) after (or (f64-gt v prev) (and (f64-eq v prev) (> i prev-i)))
         choose (and after (or (< best 0) (f64-lt v bestval)))]
    (recur (+ i 1) (if choose i best) (if choose v bestval))))))
(defn- max-value [rows :document] :f64
 (loop [i 0 top 0.0]
  (if (>= i (document-count rows)) top
   (let [n (number (attr (item rows i) :value))] (recur (+ i 1) (if (f64-gt n top) n top))))))
(defn- lane [row :document top :f64 best :f64] :document
 (let [label (attr row :label) v (number (attr row :value)) lead (option-value-of [:option :bool] (document-bool-value (attr row :lead)) false)
       attrs (if lead (document-map :class (document-string "kot-bar") :data-lead (document-string "1")) (document-map :class (document-string "kot-bar")))
       style (string-concat "--w:" (string-concat (fixed (f64-mul 100.0 (f64-div v top)) 1000 3) "%"))
       note (if (f64-eq v best) "fastest here" (string-concat (fixed (f64-div v best) 100 2) "× the fastest here"))
       display (string-concat (fixed v 100 2) " ms")
       value-node (if lead (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-value")) (document-string display)
                     (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-note")) (document-string note)))
                    (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-value")) (document-string display)))]
  (document-vector (document-keyword :li) attrs
   (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-label")) label)
   (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-track"))
    (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-fill") :style (document-string style)))) value-node)))
(defn- lanes [rows :document top :f64 best :f64 prev :f64 prev-i :i64 out :document] :document
 (let [i (next-index rows prev prev-i)]
  (if (< i 0) out
   (let [r (item rows i)] (lanes rows top best (number (attr r :value)) i (document-vector-conj out (lane r top best)))))))
(defn- card [d :document pairs :document cs :document candidate :document] [:option :document]
 (let [domain (field d "id") label (field d "label") first-pair (pair pairs (text domain) "" 0) n (field first-pair "candidateMedian")
       rows (if (and (= (document-kind domain) :string) (= (document-kind label) :string) (= (document-kind candidate) :string) (f64-gt (number n) 0.0))
             (comparators pairs cs (text domain) 0 (document-vector (make-row candidate n true))) (option-none-of [:option :document]))]
  (if (not (option-some?-of [:option :document] rows)) (option-none-of [:option :document])
   (let [xs (val rows) top (max-value xs) first (next-index xs -1.0 -1) best (if (>= first 0) (number (attr (item xs first) :value)) 0.0)]
    (if (or (not (f64-gt top 0.0)) (not (f64-gt best 0.0))) (option-none-of [:option :document])
     (let [bars (lanes xs top best -1.0 -1 (document-vector (document-keyword :ol) (document-map :class (document-string "kot-bars"))))]
      (option-some-of [:option :document] (document-vector (document-keyword :div) (document-map :class (document-string "dds-ext-card"))
       (dds/heading-node 4 label "20" "") (document-vector (document-keyword :div) (document-map :class (document-string "kot-chart")) bars))))))))
)
(defn- cards [domains :document pairs :document cs :document candidate :document i :i64 out :document] [:option :document]
 (if (>= i (document-count domains)) (option-some-of [:option :document] out)
  (let [r (card (item domains i) pairs cs candidate)]
   (if (option-some?-of [:option :document] r) (cards domains pairs cs candidate (+ i 1) (document-vector-conj out (val r))) (option-none-of [:option :document])))))
(defn render [state [:ref :site/catalog] tag :string generator :string report :string chart :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "5bb0ff5d9e2f80ca7a76545ead6d0138ab7516f2bb712dd4f059d8b0bb4f5ab2"))
       r-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 report))) "33f6e504389f03f0d3f5f91a68d157f83a86a5366acf21311e6b7494783effe9"))
       c-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 chart))) "651e9bc2bfc31b15493f00c05d2aeaaddd70e9dbec3be55846a389dccb6e9a20"))]
  (if (or (not g-ok) (not r-ok) (not c-ok)) (option-none-of [:option :string])
   (let [decoded (json/decode report) d (result-value-of [:result :document :document] decoded (document-null)) domains (field d "domains") pairs (field d "pairs") cs (field d "comparators") candidate (field d "candidate")
         grid (if (and (= (document-kind domains) :vector) (= (document-kind pairs) :vector) (= (document-kind cs) :vector))
               (cards domains pairs cs candidate 0 (document-vector (document-keyword :div) (document-map :class (document-string "dds-ext-grid") :style (document-map :--dds-ext-grid-min (document-string "19rem"))))) (option-none-of [:option :document]))]
    (if (or (not (result-ok?-of [:result :document :document] decoded)) (not (option-some?-of [:option :document] grid))) (option-none-of [:option :string])
     (let [localized (if (string=? tag "en") grid (tree/map-indexed state (val grid)))]
      (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (option-none-of [:option :string]))))))))
