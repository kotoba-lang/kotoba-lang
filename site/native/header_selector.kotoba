(ns site.native.header-selector (:export [render-selector])
 (:require [site.native.locale-mark :as mark] [html-hiccup :as html] [language-selector :as selector]))
;; The complete selector exceeds the document depth limit. Render full,
;; bounded DDS fragments separately and stream their fixed outer wrappers.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- strval [x :document] :string (option-value-of [:option :string] (document-string-value x) ""))
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
  (some (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (none)))
(defn- render [node :document tag :string] [:option :string]
 (html/render (if (string=? tag "en") node (mark/mark-language node tag)) 0))
(defn- rows [langs :document tag :string base :string] [:option :string]
 (loop [i 0 out (some "")]
  (if (or (>= i (document-count langs)) (not (option-some?-of [:option :string] out))) out
   (let [d (val (document-vector-at langs i)) code (strval (val (document-get d :code)))
         href (if (string=? code "en") base (string-concat "/" (string-concat code base)))
         item (selector/item (document-assoc d :href (document-string href)) "en")]
    (if (option-some?-of [:option :document] item)
     (recur (+ i 1) (append out (render (val item) tag))) (none))))))
(defn render-selector [tag :string base :string] [:option :string]
 (let [langs (document-edn-read "[{:code \"en\" :aliases \"English\" :label \"English\"} {:code \"zh-Hans\" :aliases \"Simplified Chinese\" :label \"简体中文\"} {:code \"hi\" :aliases \"Hindi\" :label \"हिन्दी\"} {:code \"es\" :aliases \"Spanish\" :label \"Español\"} {:code \"ar\" :aliases \"Modern Standard Arabic\" :label \"العربية الفصحى\"} {:code \"fr\" :aliases \"French\" :label \"Français\"} {:code \"bn\" :aliases \"Bengali\" :label \"বাংলা\"} {:code \"pt\" :aliases \"Portuguese (region-neutral)\" :label \"Português\"} {:code \"id\" :aliases \"Indonesian\" :label \"Bahasa Indonesia\"} {:code \"ur\" :aliases \"Urdu\" :label \"اردو\"} {:code \"ru\" :aliases \"Russian\" :label \"Русский\"} {:code \"de\" :aliases \"German\" :label \"Deutsch\"} {:code \"ja\" :aliases \"Japanese\" :label \"日本語\"} {:code \"ko\" :aliases \"Korean\" :label \"한국어\"} {:code \"pcm\" :aliases \"Nigerian Pidgin (not English)\" :label \"Naijá\"} {:code \"arz\" :aliases \"Egyptian Arabic (not Modern Standard Arabic)\" :label \"العربية المصرية\"} {:code \"mr\" :aliases \"Marathi\" :label \"मराठी\"}]")
       start (some "<div class=\"dads-language-selector\" data-language-selector translate=\"no\" lang=\"en\" dir=\"ltr\"><div class=\"dads-menu-list-box\">")
       opener (render (selector/opener "kot-header-language" "English") tag)
       popup (some "<div id=\"kot-header-language-popup\" class=\"dads-menu-list-box__popup\" data-language-selector-popup hidden>")
       a (append start opener) b (append a popup) c (append b (render (selector/search) tag))
       d (append c (render (selector/empty) tag)) e (append d (some "<ul class=\"dads-menu-list\" data-language-selector-menu>"))
       bilingual (or (string=? base "/blog/embench-c-parity-20261015/")
                     (string=? base "/blog/embench-progress-20261012/")
                     (string=? base "/blog/kotoba-murakumo-how-to-use-20261015/"))
       selected (cond (string=? base "/spec/org-identity/") (document-edn-read "[{:code \"en\" :aliases \"English\" :label \"English\"}]")
                      bilingual (document-edn-read "[{:code \"en\" :aliases \"English\" :label \"English\"} {:code \"ja\" :aliases \"Japanese\" :label \"日本語\"}]")
                      :else langs)
       f (append e (rows selected tag base))]
  (append f (some "</ul></div></div></div>"))))
