(ns site.native.home-benchmark-scaling-section (:export [render])
 (:require [site.native.home-benchmark-scaling-template :as template]
           [site.native.home-benchmark-scaling-chart :as chart]
           [site.native.home-benchmark-scaling-table :as measurement]
           [site.native.home-benchmark-scaling-order :as ordering]
           [site.native.home-benchmark-scaling-failures :as failures]
           [site.native.home-benchmark-scaling-answers :as answers]))
;; Assemble the pinned scaling subsection; any missing or duplicate slot fails closed.
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- value [v [:option :string]] :string (option-value-of [:option :string] v ""))
(defn- insert [source [:option :string] marker :string fragment [:option :string]] [:option :string]
 (if (or (not (option-some?-of [:option :string] source)) (not (option-some?-of [:option :string] fragment))) (none)
  (let [s (value source) pos (string-index-of s marker)]
   (if (< pos 0) (none)
    (let [tail (string-substring s (+ pos (string-byte-length marker)) (string-byte-length s))]
     (if (>= (string-index-of tail marker) 0) (none)
      (option-some-of [:option :string] (string-concat (string-substring s 0 pos) (string-concat (value fragment) tail)))))))))
(defn render [state [:ref :site/catalog] tag :string generator :string report :string chart-source :string] [:option :string]
 (let [a (template/template state tag generator report)
       b (insert a "987650000001" (chart/render state tag generator report chart-source))
       c (insert b "987650000002" (measurement/render state tag generator report))
       d (insert c "987650000003" (ordering/render state tag generator report))
       e (insert d "987650000004" (failures/render state tag generator report))]
  (insert e "987650000005" (answers/render state tag generator report))))
