(ns site.native.home-evidence-template (:export [render])
 (:require [site.native.home-contents :as contents] [site.native.home-section :as section] [site.native.home-claims :as claims]))
;; The benchmark slot remains unfilled until its full source and copy decisions
;; are qualified. This template is not a completed chapter.
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
  (some (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (none)))
(defn render [state [:ref :site/catalog] tag :string generator :string benchmark :string safety :string release :string] [:option :string]
 (let [a (append (some "<div class=\"kot-chapter-block\">") (contents/rule-at state tag generator 2))
       b (append a (section/render-proof state tag generator))
       c (append b (section/render-why-fast state tag generator benchmark))
       d (append c (some "KOTOBA_BENCHMARK_SLOT"))
       e (append d (claims/render state tag generator safety))
       f (append e (section/render-release state tag generator release))]
  (append f (some "</div>"))))
