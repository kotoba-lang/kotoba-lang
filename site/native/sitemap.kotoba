(ns site.native.sitemap (:export [canonical render]))
;; Bounded projection of the legacy canonical-link sitemap rule. Inputs are
;; generated HTML, not a predeclared list of routes. Invalid canonical URLs are
;; rejected instead of being inserted into XML.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- valid-chars? [s :string i :i64] :bool
 (if (>= i (string-byte-length s)) true
  (let [c (string-code-point-at s i)]
   (if (or (< c 33) (> c 126) (= c 34) (= c 38) (= c 39) (= c 60) (= c 62)) false (valid-chars? s (+ i 1))))))
(defn- valid? [s :string] :bool
 (let [origin "https://kotoba-lang.org" n (string-byte-length s) base (string-byte-length origin)]
  (and (>= n base) (string=? (string-substring s 0 base) origin)
       (or (= n base) (= (string-code-point-at s base) 47)) (valid-chars? s 0))))
;; Empty string means no canonical tag; :invalid is reserved for malformed or
;; duplicate tags and is rejected by render. The scan matches the legacy tag
;; attribute order, rather than claiming to be a general HTML parser.
(defn canonical [html :string] :string
 (let [marker "rel=\"canonical\" href=\"" at (string-index-of html marker)]
  (if (< at 0) ""
   (let [start (+ at (string-byte-length marker)) tail (string-substring html start (string-byte-length html)) end (string-index-of tail "\"")]
    (if (< end 0) ":invalid"
     (let [url (string-substring tail 0 end) rest (string-substring tail (+ end 1) (string-byte-length tail))]
      (if (or (>= (string-index-of rest marker) 0) (not (valid? url))) ":invalid" url)))))))
;; Entries use fixed 1025-word slots: length followed by at most 1024 ASCII bytes.
;; No document tree is accumulated while scanning pages or sorting links.
(defn- length [entries :vector-i64 i :i64] :i64 (vector-at entries (* i 1025)))
(defn- byte [entries :vector-i64 i :i64 j :i64] :i64 (vector-at entries (+ (+ (* i 1025) 1) j)))
(defn- compare-entries [entries :vector-i64 a :i64 b :i64 j :i64] :i64
 (let [x (length entries a) y (length entries b)]
  (cond (and (>= j x) (>= j y)) 0 (>= j x) -1 (>= j y) 1
        (< (byte entries a j) (byte entries b j)) -1 (> (byte entries a j) (byte entries b j)) 1
        :else (compare-entries entries a b (+ j 1)))))
(defn- as-string [entries :vector-i64 i :i64] :string
 (let [n (length entries i) v (loop [j 0 out (vector-alloc 0)]
                                (if (>= j n) out (recur (+ j 1) (vector-conj out (byte entries i j)))))]
  (string-from-utf8 (bytes-from-vector-i64 v))))
(defn- check-inputs [entries :vector-i64 count :i64 i :i64 found :i64] :bool
 (if (>= i count) (> found 0)
  (let [n (length entries i) okay (if (> n 0) (arena-scope (valid? (as-string entries i))) true)]
   (if (or (< n 0) (> n 1024) (not okay)) false (check-inputs entries count (+ i 1) (if (> n 0) (+ found 1) found))))))
(defn- next-index [entries :vector-i64 count :i64 previous :i64 i :i64 best :i64] :i64
 (if (>= i count) best
  (let [n (length entries i) eligible (and (> n 0) (or (< previous 0) (> (compare-entries entries i previous 0) 0)))
        choose (and eligible (or (< best 0) (< (compare-entries entries i best 0) 0)))]
   (next-index entries count previous (+ i 1) (if choose i best)))))
(defn- emit [entries :vector-i64 count :i64 previous :i64 out :string] :string
 (let [next (next-index entries count previous 0 -1)]
  (if (< next 0) (string-concat out "</urlset>\n")
   (emit entries count next (string-concat out (string-concat "<url><loc>" (string-concat (as-string entries next) "</loc></url>\n")))))))
(defn render [entries :vector-i64 count :i64] [:option :string]
 (if (or (< count 1) (> count 4096) (not (= (vector-count entries) (* count 1025))) (not (check-inputs entries count 0 0))) (option-none-of [:option :string])
  (option-some-of [:option :string] (emit entries count -1 "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n"))))
