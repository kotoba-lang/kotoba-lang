(ns site.native.library-catalog-section (:export [render])
 (:require [site.native.library-aggregate-stream :as aggregate] [site.native.library-catalog-stream :as scan]
           [site.native.locale-tree :as tree] [multiformats.sha256 :as sha] [html-hiccup :as html] [components :as dds]))
;; Pinned historical snapshot only; the caller authenticates catalogue row provenance.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- field [d :document k :keyword] :document (if (= (document-kind d) :map) (val (document-get d k)) (document-null)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- no [] [:option :string] (option-none-of [:option :string]))
(defn- yes [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- out [x [:option :string]] :string (option-value-of [:option :string] x ""))
(defn- append [a [:option :string] b [:option :string]] [:option :string] (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b)) (yes (string-concat (out a) (out b))) (no)))
(defn- hash? [s :string expected :string] :bool (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) expected)))
(defn- node [state [:ref :site/catalog] tag :string d :document] [:option :string]
 (let [local (if (string=? tag "en") (option-some-of [:option :document] d) (tree/map-indexed state d))]
  (if (option-some?-of [:option :document] local) (html/render (val local) 0) (no))))
(defn- number [summary :string key :string] :i64
 (let [needle (string-concat key "\t") p (string-index-of summary needle) start (+ p (string-byte-length needle)) rest (if (< p 0) "" (string-substring summary start (string-byte-length summary))) end (string-index-of rest "\n")]
  (if (or (< p 0) (< end 1)) -1 (option-value-of [:option :i64] (parse-long (string-substring rest 0 end)) -1))))
(defn- thousands [n :i64] :string
 (if (< n 1000) (string-from-i64 n) (let [r (rem n 1000)] (string-concat (thousands (quot n 1000)) (string-concat "," (string-concat (if (< r 100) "0" "") (string-concat (if (< r 10) "0" "") (string-from-i64 r))))))))
(defn- occurrences [s :string needle :string count :i64] :i64
 (let [p (string-index-of s needle)] (if (< p 0) count (occurrences (string-substring s (+ p (string-byte-length needle)) (string-byte-length s)) needle (+ count 1)))))
(defn- described [catalog :string pos :i64 count :i64] :i64
 (let [begin (scan/begin catalog pos)]
  (cond (= begin 0) count (< begin 0) -1 :else
   (let [end (scan/end catalog begin)] (if (<= end begin) -1
    (let [kind (arena-scope (let [k (document-kind (field (document-edn-read (string-substring catalog begin end)) :description))] (cond (= k :string) 1 (= k :null) 0 :else -1)))]
     (if (>= kind 0) (described catalog end (+ count kind)) -1)))))))
(defn- chip [state [:ref :site/catalog] tag :string entry :document counts :string] [:option :string]
 (let [label (text (field entry :label)) topic (text (field entry :topic)) n (number counts topic)]
  (if (or (string=? label "") (string=? topic "") (< n 0)) (no)
   (node state tag (document-vector (document-keyword :button) (document-map :class (document-string "dads-button") :data-type (document-string "outline") :data-size (document-string "sm") :type (document-string "button") :data-cat-tag (document-string topic) :aria-pressed (document-string "false")) (document-string (string-concat label (string-concat " · " (thousands n)))))))))
(defn- chips [state [:ref :site/catalog] tag :string xs :document counts :string i :i64 result [:option :string]] [:option :string]
 (if (or (not (option-some?-of [:option :string] result)) (>= i (document-count xs))) result
  (let [e (item xs i) n (number counts (text (field e :topic)))]
   (if (= n 0) (chips state tag xs counts (+ i 1) result) (chips state tag xs counts (+ i 1) (append result (chip state tag e counts)))))))
(defn- locale? [s :string] :bool
 (or (string=? s "en") (string=? s "ar") (string=? s "arz") (string=? s "bn") (string=? s "de") (string=? s "es") (string=? s "fr") (string=? s "hi") (string=? s "id") (string=? s "ja") (string=? s "ko") (string=? s "mr") (string=? s "pcm") (string=? s "pt") (string=? s "ru") (string=? s "ur") (string=? s "zh-Hans")))
(defn render [state [:ref :site/catalog] tag :string generator :string taxonomy-text :string catalog :string registry :string rows :string] [:option :string]
 (let [g (hash? generator "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67")
       rows-ok (hash? rows "03c091d0792d4399f84bbca16007b434ab6ec625294c3454c42a11499fdf9445") registry-ok (hash? registry "62c7653855b82bd941f9d9cf619dca8f1ee3ba655f32d8d9d2bbf132b402f29b")
       summary (aggregate/compute catalog taxonomy-text) counts (out summary) tax (document-edn-read taxonomy-text) planes (field tax :planes) domains (field tax :domains)
       total (number counts "total") untagged (number counts "untagged") with-description (described catalog (scan/start catalog) 0)]
  (if (or (not (locale? tag)) (not g) (not rows-ok) (not registry-ok) (not (= (occurrences registry "#:registry{" 0) 1)) (not (option-some?-of [:option :string] summary))
          (not (= (document-kind planes) :vector)) (not (= (document-kind domains) :vector)) (< total 1) (< untagged 0) (< with-description 0)) (no)
   (let [heading (dds/heading-node 2 (document-string "Every public repository, filterable") "32" "")
         lead (if (string=? tag "ja")
          (document-vector (document-keyword :p) (document-map :class (document-string "kot-lead"))
           (document-vector (document-keyword :code) (document-map :class (document-string "kot-code")) (document-string "kotoba-lang"))
           (document-string (string-concat " の公開リポジトリ " (string-concat (thousands total) " 件を掲載しています。GitHub のトピックと共通のタグを使い、名前・説明・タグの組み合わせで絞り込めます。"))))
          (document-vector (document-keyword :p) (document-map :class (document-string "kot-lead")) (document-string "The ") (document-string (thousands total)) (document-string " public repositories in the ")
           (document-vector (document-keyword :code) (document-map :class (document-string "kot-code")) (document-string "kotoba-lang"))
           (document-string " organisation, with the tag vocabulary the ") (document-string "organisation's GitHub topics use. Filter by name, by description, or by ") (document-string "any combination of tags.")))
         form (document-vector (document-keyword :div) (document-map :class (document-string "dads-form-control-label") :data-size (document-string "md"))
           (document-vector (document-keyword :label) (document-map :class (document-string "dads-form-control-label__label") :for (document-string "kot-cat-q")) (document-string "Filter repositories"))
           (document-vector (document-keyword :p) (document-map :class (document-string "dads-form-control-label__support-text") :id (document-string "kot-cat-q-support")) (document-string "Try: os, driver, sim, wasm, ipld. Text narrows; tags widen — a repository matching any selected tag is shown."))
           (document-vector (document-keyword :div) (document-vector (document-keyword :span) (document-map :class (document-string "dads-input-text"))
            (document-vector (document-keyword :input) (document-map :class (document-string "dads-input-text__input") :data-size (document-string "md") :type (document-string "search") :id (document-string "kot-cat-q") :aria-label (document-string "Filter Kotoba repositories") :aria-describedby (document-string "kot-cat-q-support"))))))
         clear (document-vector (document-keyword :button) (document-map :class (document-string "dads-button") :data-type (document-string "text") :data-size (document-string "sm") :type (document-string "button") :id (document-string "kot-cat-clear")) (document-string "Clear"))
         counter (document-vector (document-keyword :p) (document-map :id (document-string "kot-cat-count") :class (document-string "kot-caption kot-muted") :aria-live (document-string "polite") :data-count-template (document-string "Showing {shown} of {total} repositories"))
           (document-string (string-concat "Showing " (string-concat (thousands total) (string-concat " of " (string-concat (thousands total) " repositories"))))))
         description (string-concat "Repository names and descriptions are upstream source records in English. Filtering runs in the browser and no query leaves it; with JavaScript off the complete list is still rendered above. "
           (string-concat (thousands with-description) (string-concat " of these repositories carry a GitHub description, so a domain tag has that much evidence to work from — "
            (string-concat (thousands untagged) " match no domain rule and are shown untagged rather than assigned the nearest label. A repository list is discovery. It is not the package registry: exactly one library is published through the content-addressed registry described above, and a repository here is neither a released package nor an API-stability claim."))))
         cap (document-vector (document-keyword :p) (document-map :class (document-string "kot-muted kot-caption")) (document-string description))
         location (document-vector (document-keyword :p) (document-map :class (document-string "kot-muted kot-caption") :lang (document-string "en") :translate (document-string "no"))
           (document-string "Links follow where a repository lives today: libraries that were integrated point at their directory in kotoba-lang/kotoba (lib/), transferred repositories at their new owner, and repositories that no longer exist on GitHub have no link. The list itself is the 2026-09-07 snapshot; locations were checked on 2026-10-27 (site/library-locations.edn)."))
         vocabulary (document-vector (document-keyword :p) (document-map :class (document-string "kot-muted kot-caption")) (document-string "Tag vocabulary: ")
           (document-vector (document-keyword :code) (document-map :class (document-string "kot-code")) (document-string "site/library-taxonomy.edn")) (document-string ". Repository snapshot: ")
           (document-vector (document-keyword :code) (document-map :class (document-string "kot-code")) (document-string "site/library-catalog.edn")) (document-string ", fetched ") (document-string "2026-09-07") (document-string "."))
         first (append (yes "<section class=\"dds-ext-section\" id=\"catalog\">") (node state tag heading))
         second (append first (if (string=? tag "ja") (html/render lead 0) (node state tag lead))) third (append second (yes "<div class=\"kot-cat-controls\" id=\"kot-cat-controls\" hidden>"))
         fourth (append third (node state tag form)) fifth (append fourth (yes "<div class=\"kot-cat-tags\">"))
         sixth (chips state tag planes counts 0 fifth) seventh (chips state tag domains counts 0 sixth) eighth (append seventh (node state tag clear))
         ninth (append eighth (yes "</div></div>")) tenth (append ninth (node state tag counter))
         eleventh (append tenth (yes "<ol class=\"kot-cat-list\" id=\"kot-cat-list\" lang=\"en\" translate=\"no\">"))
         twelfth (append eleventh (yes rows)) thirteenth (append twelfth (yes "</ol>")) fourteenth (append thirteenth (node state tag cap))
         fifteenth (append fourteenth (node state tag location)) sixteenth (append fifteenth (node state tag vocabulary))]
    (append sixteenth (yes "</section>"))))))
