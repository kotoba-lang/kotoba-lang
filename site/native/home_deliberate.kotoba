(ns site.native.home-deliberate (:export [render])
 (:require [site.native.locale-tree :as tree] [multiformats.sha256 :as sha]
           [html-hiccup :as html] [components :as dds] [table :as table]))
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- block [s :string start :string end :string] :string
 (let [a (string-index-of s start) b (string-index-of s end)]
  (if (or (< a 0) (<= b a)) "" (string-substring s a b))))
(defn- read-set [s :string marker :string] :document
 (let [p (string-index-of s marker)]
  (if (< p 0) (document-vector)
   (let [tail (string-substring s (+ p (string-byte-length marker)) (string-byte-length s)) end (string-index-of tail "}")]
    (if (< end 0) (document-null) (document-edn-read (string-concat "[" (string-concat (string-substring tail 0 end) "]"))))))))
(defn- reason [s :string] :document
 (let [marker "\n   :reason \"" p (string-index-of s marker)]
  (if (< p 0) (document-null)
   (let [start (- (+ p (string-byte-length marker)) 1) n (string-byte-length s)]
    (loop [i (+ start 1) esc false]
     (if (>= i n) (document-null)
      (let [c (string-code-point-at s i) width (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4)]
       (cond esc (recur (+ i width) false) (= c 92) (recur (+ i 1) true)
             (= c 34) (document-edn-read (string-substring s start (+ i 1))) :else (recur (+ i width) false)))))))))
(defn- member? [xs :document v :document i :i64] :bool
 (if (>= i (document-count xs)) false
  (if (document-equal? (val (document-vector-at xs i)) v) true (member? xs v (+ i 1)))))
(defn- values [surface :document a :document b :document i :i64 out :document] [:option :document]
 (if (>= i (document-count surface)) (option-some-of [:option :document] out)
  (let [v (val (document-vector-at surface i)) k (document-kind v)]
   (if (not (= k :symbol)) (option-none-of [:option :document])
    (values surface a b (+ i 1) (if (or (member? a v 0) (member? b v 0)) out
     (document-vector-conj out (document-string (document-edn-print v)))))))))
(defn- next-name [xs :document i :i64 previous :string best :string] :string
 (if (>= i (document-count xs)) best
  (let [name (text (val (document-vector-at xs i))) better (and (> (string-compare name previous) 0) (or (string=? best "") (< (string-compare name best) 0)))]
   (next-name xs (+ i 1) previous (if better name best)))))
(defn- join [xs :document i :i64 previous :string out :string] :string
 (if (>= i (document-count xs)) out
  (let [name (next-name xs 0 previous "")]
   (if (string=? name "") "" (join xs (+ i 1) name (string-concat out (string-concat (if (= i 0) "" ", ") name)))))))
(defn- row [s :string] [:option :document]
 (let [surface (read-set s ":surface #{") a (read-set s ":admitted-via-elaboration #{") b (read-set s ":admitted-via-pure-core-elaboration #{") why (reason s)
       xs (if (and (= (document-kind surface) :vector) (= (document-kind a) :vector) (= (document-kind b) :vector)) (values surface a b 0 (document-vector)) (option-none-of [:option :document]))]
  (if (or (not (option-some?-of [:option :document] xs)) (not (= (document-kind why) :string))) (option-none-of [:option :document])
   (let [code (document-vector (document-keyword :code) (document-string (join (val xs) 0 "" "")))
         first (table/body-cell-node (record-new [:ref :tbl/cell] true 0) code)
         second (table/body-cell-node (record-new [:ref :tbl/cell] true 1) why)]
    (if (and (option-some?-of [:option :document] first) (option-some?-of [:option :document] second))
     (option-some-of [:option :document] (document-vector (document-keyword :tr) (val first) (val second))) (option-none-of [:option :document]))))))
(defn render [state [:ref :site/catalog] tag :string generator :string authority :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67"))
       a-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 authority))) "dfc15d4a3cbc9075697dd27b6c0d8953ee04019ac2972285526d5d512aa1bb4e"))
       a (row (block authority "\n  :no-ambient-authority\n" "\n  :no-interop\n"))
       b (row (block authority "\n  :no-interop\n" "\n  :no-ambient-mutation\n"))
       c (row (block authority "\n  :no-ambient-mutation\n" "\n  :no-unbounded-concurrency\n"))
       d (row (block authority "\n  :no-unbounded-concurrency\n" "\n  :no-guest-macros\n"))
       e (row (block authority "\n  :no-guest-macros\n" "\n  :explicit-errors\n"))
       tracked (string-index-of (block authority "\n  :explicit-errors\n" "\n  :bounded-admission\n") ":enforcement :tracked-elaboration")]
  (if (or (not g-ok) (not a-ok) (< tracked 0) (not (option-some?-of [:option :document] a)) (not (option-some?-of [:option :document] b))
          (not (option-some?-of [:option :document] c)) (not (option-some?-of [:option :document] d)) (not (option-some?-of [:option :document] e))) (option-none-of [:option :string])
   (let [node (document-vector (document-keyword :section) (document-map :class (document-string "dds-ext-section"))
         (dds/heading-node 2 (document-string "What AI-written Kotoba cannot ask for") "32" "")
         (document-vector (document-keyword :div) (document-map :class (document-string "kot-table-scroll"))
          (document-vector (document-keyword :div) (document-map :class (document-string "dads-table"))
           (document-vector (document-keyword :table) (document-map :class (document-string "dads-table__table"))
            (document-vector (document-keyword :caption) (document-string "Deliberately absent language surface"))
            (document-vector (document-keyword :thead) (document-vector (document-keyword :tr)
             (table/header-cell-node (document-string "Boundary") false) (table/header-cell-node (document-string "Why it is absent") false)))
            (document-vector (document-keyword :tbody) (val a) (val b) (val c) (val d) (val e)))))
         (document-vector (document-keyword :p) (document-map :class (document-string "kot-muted kot-caption"))
          (document-string "These are named security constraints in lang/surface-status.edn, not features missing from a roadmap.")))
         localized (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))]
    (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (option-none-of [:option :string]))))))
