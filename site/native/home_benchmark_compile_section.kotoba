(ns site.native.home-benchmark-compile-section (:export [render])
 (:require [json.core :as json] [site.native.source-concat :as source] [site.native.home-section :as home]
           [site.native.locale-tree :as tree] [site.native.locale-rebase :as rebase] [multiformats.sha256 :as sha] [html-hiccup :as html]
           [site.native.home-benchmark-compile-chart :as chart] [site.native.home-benchmark-compile :as measurement] [site.native.home-benchmark-loop :as loop]))
;; Startup and developer-loop subsection, sourced from the two dated reports.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- field [d :document k :string] :document (val (document-get d (document-string k))))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- no [] [:option :string] (option-none-of [:option :string]))
(defn- yes [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- out [o [:option :string]] :string (option-value-of [:option :string] o ""))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b)) (yes (string-concat (out a) (out b))) (no)))
(defn- upper [s :string] :string
 (let [v (vector-i64-from-bytes (string-to-utf8 s)) n (vector-count v)
       r (loop [i 0 a (vector-alloc n)] (if (= i n) a (let [x (vector-at v i)] (recur (+ i 1) (vector-assoc! a i (if (and (>= x 97) (<= x 122)) (- x 32) x))))))]
  (string-from-utf8 (bytes-from-vector-i64 r))))
(defn- rust-short [s :string] :string
 (let [p (string-index-of s " ") tail (if (< p 0) "" (string-substring s (+ p 1) (string-byte-length s))) q (string-index-of tail " ")]
  (if (or (< p 0) (< q 0)) "" (string-substring s 0 (+ p 1 q)))))
(defn- fragment [state [:ref :site/catalog] tag :string src :string marker :string opening :i64 closing :i64] [:option :string]
 (let [pos (string-index-of src marker) tail (if (< pos 0) "" (string-substring src pos (string-byte-length src)))
       form (source/data (string-concat "~FORM~" tail) "~FORM~" opening closing)
       node (if (option-some?-of [:option :document] form) (home/evaluate (val form)) (option-none-of [:option :document]))
       local (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)
       rebased (if (and (option-some?-of [:option :document] local) (not (string=? tag "en"))) (rebase/rebase-links (val local) tag "/") local)]
  (if (option-some?-of [:option :document] rebased) (html/render (val rebased) 0) (no))))
(defn- caption [state [:ref :site/catalog] tag :string report :string] [:option :string]
 (let [r (json/decode report) d (result-value-of [:result :document :document] r (document-null)) env (field d "environment")
       kotoba (field env "kotoba") rust (field env "rustc") clang (field env "clang") javac (field env "javac") short (rust-short (text rust))]
  (if (or (not (result-ok?-of [:result :document :document] r)) (not (= (document-kind kotoba) :string)) (not (= (document-kind rust) :string))
          (not (= (document-kind clang) :string)) (not (= (document-kind javac) :string)) (string=? short "")) (no)
   (let [value (string-concat (upper (text kotoba)) (string-concat " · " (string-concat (upper short) (string-concat " · " (string-concat (text clang) (string-concat " · " (string-concat (text javac)
         ". Kotoba, Rust, and C emit Wasm; javac emits a class file. Different targets and compiler work make this a startup observation, not a universal ranking. The recorded host-load gate failed, so the table is not a qualified speed rank.")))))))
         node (document-vector (document-keyword :p) (document-map :class (document-string "kot-muted kot-caption")) (document-string value))
         local (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))]
    (if (option-some?-of [:option :document] local) (html/render (val local) 0) (no))))))
(defn render [state [:ref :site/catalog] tag :string generator :string compile-report :string loop-report :string chart-source :string] [:option :string]
 (let [g (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67"))
       c (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 compile-report))) "e86a8b09b9c76ab3183e68fa9aff1c227b639157ef0901d29824b324412f205f"))
       l (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 loop-report))) "9a61c3b270585b2ef70e30dcd5df7ffff3f4ce5f73bf0860e492f8262fb73ff0"))
       start (string-index-of generator "(dds/heading 3 \"Compiler startup, four toolchains\"") stop (string-index-of generator "(dds/heading 3 \"Six domains, side by side\"")]
  (if (or (not g) (not c) (not l) (< start 0) (<= stop start)) (no)
   (let [src (string-substring generator start stop)
         a (fragment state tag src "(dds/heading 3 \"Compiler startup, four toolchains\"" 40 41)
         b (append a (chart/render state tag generator compile-report chart-source))
         c1 (append b (measurement/render state tag generator compile-report))
         d (append c1 (caption state tag compile-report))
         e (append d (loop/render state tag generator loop-report))]
    (append e (fragment state tag src "(caption\n      \"Every emitted artifact produced 42" 40 41))))))
