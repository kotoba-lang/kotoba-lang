(ns site.native.library-aggregate-stream (:export [compute])
 (:require [site.native.library-classifier :as classifier] [multiformats.sha256 :as sha] [site.native.library-catalog-stream :as scan]))
;; Compute the taxonomy counts once per build; callers may reuse the resulting
;; source-bound summary for each locale. A digest change requires requalification.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- field [d :document k :keyword] :document (if (= (document-kind d) :map) (val (document-get d k)) (document-null)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- hash? [s :string digest :string] :bool
 (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) digest)))
(defn- tag-count [taxonomy :document] :i64 (+ (document-count (field taxonomy :planes)) (document-count (field taxonomy :domains))))
(defn- tag [taxonomy :document i :i64] :document
 (let [planes (field taxonomy :planes) n (document-count planes)]
  (if (< i n) (item planes i) (item (field taxonomy :domains) (- i n)))))
(defn- add-counts [stats :vector-i64 mask :i64 n :i64 i :i64] :vector-i64
 (if (>= i n) stats
  (let [where (+ i 2) old (vector-at stats where)
        ignored (if (= (bit-and mask (i64-shift-left 1 i)) 0) stats (vector-assoc! stats where (+ old 1)))]
   (add-counts stats mask n (+ i 1)))))
(defn- classify-one [taxonomy :document repo :document] :i64
 (let [name (field repo :name) desc (field repo :description)]
  (if (or (not (= (document-kind repo) :map)) (not (= (document-kind name) :string))
          (not (or (= (document-kind desc) :string) (= (document-kind desc) :null)))) -1
   (classifier/classify taxonomy repo))))
(defn- rows [taxonomy :document catalog :string stats :vector-i64 n :i64 pos :i64 count :i64] :bool
 (let [begin (scan/begin catalog pos)]
  (cond (= begin 0) (= count 2215)
        (< begin 0) false
        :else (let [end (scan/end catalog begin)]
         (if (<= end begin) false
          (let [mask (arena-scope (classify-one taxonomy (document-edn-read (string-substring catalog begin end))))]
           (if (< mask 0) false
            (let [a (vector-assoc! stats 0 (+ (vector-at stats 0) 1))
                  b (if (= mask 0) (vector-assoc! a 1 (+ (vector-at a 1) 1)) a)
                  c (add-counts b mask n 0)]
             (rows taxonomy catalog c n end (+ count 1))))))))))
(defn- lines [taxonomy :document stats :vector-i64 i :i64 n :i64 out :string] :string
 (if (>= i n) out
  (let [topic (text (field (tag taxonomy i) :topic)) count (vector-at stats (+ i 2))]
   (lines taxonomy stats (+ i 1) n (string-concat out (string-concat topic (string-concat "\t" (string-concat (string-from-i64 count) "\n"))))))))
(defn compute [catalog-text :string taxonomy-text :string] [:option :string]
 (if (not (and (hash? catalog-text "154244b0400f3b87431ae24495c738675f2ba73bd4ba81af202f9e9b4c6e84fa")
               (hash? taxonomy-text "827d2160f70a25e4af638423da4d9e022a42669d174a15d2e4121d00774183d0"))) (none)
  (let [taxonomy (document-edn-read taxonomy-text) valid (classifier/taxonomy-valid? taxonomy)
        total (if valid (tag-count taxonomy) 0)]
   (if (or (not valid) (< total 1) (> total 62)) (none)
    (let [stats (vector-alloc (+ total 2)) ok (rows taxonomy catalog-text stats total (scan/start catalog-text) 0)]
     (if (not ok) (none)
      (option-some-of [:option :string]
       (lines taxonomy stats 0 total (string-concat "total\t" (string-concat (string-from-i64 (vector-at stats 0))
        (string-concat "\nuntagged\t" (string-concat (string-from-i64 (vector-at stats 1)) "\n"))))))))))))
