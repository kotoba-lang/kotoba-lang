(ns site.native.home-stage (:export [main])
 (:capabilities [:fs/app-data-bytes :cli/args])
 (:require [multiformats.sha256 :as sha]))
;; Trusted immutable manifest and private input/stage roots. This stages checked
;; documents; it does not authenticate their provenance or establish release readiness.
(defn- bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- text [v :vector-i64] :string (string-from-utf8 (bytes-from-vector-i64 v)))
(defn- zero [] :string (string-from-utf8 (bytes-from-vector-i64 [0])))
(defn- field0 [s :string] :string (string-concat s (zero)))
(defn- cat [a :vector-i64 b :vector-i64] :vector-i64
 (let [n (vector-count a) m (vector-count b) x (loop [i 0 v (vector-alloc (+ n m))] (if (= i n) v (recur (+ i 1) (vector-assoc! v i (vector-at a i)))))]
  (loop [i 0 v x] (if (= i m) v (recur (+ i 1) (vector-assoc! v (+ n i) (vector-at b i)))))))
(defn- frame [op :i64 tail :vector-i64] :vector-i64 (cat [0 65 77 85 72 1 op] tail))
(defn- call [op :i64 tail :vector-i64] :vector-i64 (vector-i64-from-bytes (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-from-vector-i64 (frame op tail)))))
(defn- read [p :string] :vector-i64 (call 1 (bytes (field0 p))))
(defn- write [p :string data :vector-i64] :vector-i64 (call 2 (cat (bytes (field0 p)) data)))
(defn- rename [a :string b :string] :vector-i64 (call 7 (bytes (string-concat (field0 a) (field0 b)))))
(defn- ok? [v :vector-i64] :bool (and (> (vector-count v) 0) (= (vector-at v 0) 0)))
(defn- missing? [v :vector-i64] :bool (and (>= (vector-count v) 2) (= (vector-at v 0) 1) (= (vector-at v 1) 2)))
(defn- payload [v :vector-i64] :vector-i64
 (let [n (- (vector-count v) 1)] (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ i 1))))))))
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- entry [d :document i :i64] :document (val (document-vector-at d i)))
(defn- field [d :document k :keyword] :string (option-value-of [:option :string] (document-string-value (val (document-get d k))) ""))
(defn- tag [i :i64] :string
 (case i 0 "en" 1 "ar" 2 "arz" 3 "bn" 4 "de" 5 "es" 6 "fr" 7 "hi" 8 "id" 9 "ja" 10 "ko" 11 "mr" 12 "pcm" 13 "pt" 14 "ru" 15 "ur" 16 "zh-Hans" ""))
(defn- join [a :string b :string] :string (string-concat a (string-concat "/" b)))
(defn- target [root :string t :string] :string (if (string=? t "en") (join root "index.html") (join (join root t) "index.html")))
(defn- ascii-lower [v :vector-i64] :vector-i64
 (loop [i 0 out (vector-alloc (vector-count v))]
  (if (= i (vector-count v)) out (let [c (vector-at v i)] (recur (+ i 1) (vector-assoc! out i (if (and (>= c 65) (<= c 90)) (+ c 32) c)))))))
(defn- begins? [s :string p :string] :bool (and (>= (string-byte-length s) (string-byte-length p)) (string=? (string-substring s 0 (string-byte-length p)) p)))
(defn- ends? [s :string p :string] :bool (let [n (string-byte-length s) m (string-byte-length p)] (and (>= n m) (string=? (string-substring s (- n m) n) p))))
(defn- valid-page? [t :string data :vector-i64 digest :string] :bool
 (let [s (text data) lower (text (ascii-lower data)) rtl (or (string=? t "ar") (string=? t "arz") (string=? t "ur"))
       prefix (string-concat "<!DOCTYPE html>\n<html lang=\"" (string-concat t (if rtl "\" dir=\"rtl\">" "\">")))]
  (and (= (string-byte-length digest) 64) (arena-scope (string=? (sha/digest-hex data) digest))
       (begins? s prefix) (ends? s "</html>") (>= (string-index-of s "<head>") 0) (>= (string-index-of s "<body>") 0)
       (< (string-index-of lower "freebuff") 0) (< (string-index-of s "KOTOBA_") 0)
       (< (string-index-of s "TEST BENCHMARK") 0) (< (string-index-of s "UNQUALIFIED EVIDENCE FOR TEST") 0))))
(defn- valid-entry? [entries :document root :string i :i64] :bool
 (let [e (entry entries i) t (tag i) path (field e :path) digest (field e :sha256) output (target root t) data (read path)]
  (and (= (document-kind e) :map) (string=? (field e :tag) t) (not (string=? path ""))
       (missing? (read output)) (missing? (read (string-concat output ".part"))) (ok? data) (valid-page? t (payload data) digest))))
(defn- preflight [entries :document root :string i :i64] :bool
 (if (= i 17) true (and (valid-entry? entries root i) (preflight entries root (+ i 1)))))
(defn- stage [entries :document root :string i :i64] :bool
 (if (= i 17) true
  (let [e (entry entries i) t (tag i) output (target root t) temporary (string-concat output ".part") data (read (field e :path))]
   (if (or (not (ok? data)) (not (missing? (read output))) (not (missing? (read temporary)))) false
    (let [value (payload data)]
     (if (not (valid-page? t value (field e :sha256))) false
      (if (not (ok? (write temporary value))) false
       (and (ok? (rename temporary output)) (stage entries root (+ i 1))))))))))
(defn main [] :i64
 (let [manifest (typed-cap-call :cli/args :string :string "0") root (typed-cap-call :cli/args :string :string "1") data (read manifest)]
  (if (or (string=? manifest "") (string=? root "") (not (ok? data))) 7
   (let [m (document-edn-read (text (payload data))) entries (val (document-get m :entries))]
    (if (or (not (= (document-kind m) :map)) (not (= (document-kind entries) :vector)) (not (= (document-count entries) 17))) 7
     (if (and (preflight entries root 0) (stage entries root 0)) 42 7))))))
