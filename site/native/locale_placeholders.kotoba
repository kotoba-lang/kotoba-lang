(ns site.native.locale-placeholders
  (:export [placeholders-match?]))

;; Match the existing locale contract: {name}, where name has one or more
;; ASCII letters or underscores. Compare multiplicities, not just membership.
(defn- width [cp :i64] :i64
  (cond (< cp 128) 1 (< cp 2048) 2 (< cp 65536) 3 :else 4))

(defn- name-char? [cp :i64] :bool
  (or (= cp 95) (and (>= cp 65) (<= cp 90)) (and (>= cp 97) (<= cp 122))))

;; Return the exclusive byte offset of a placeholder beginning at start, or 0.
(defn- placeholder-end [text :string start :i64] :i64
  (let [length (string-byte-length text)]
    (if (or (>= start length) (not (= (string-code-point-at text start) 123))) 0
      (loop [i (+ start 1)]
        (if (>= i length) 0
          (let [cp (string-code-point-at text i)]
            (cond (and (= cp 125) (> i (+ start 1))) (+ i 1)
                  (name-char? cp) (recur (+ i 1))
                  :else 0)))))))

(defn- count-token [text :string token :string] :i64
  (let [length (string-byte-length text)]
    (loop [i 0 count 0]
      (if (>= i length) count
        (let [end (placeholder-end text i)
              cp (string-code-point-at text i)]
          (if (> end 0)
            (recur end (if (string=? (string-substring text i end) token) (+ count 1) count))
            (recur (+ i (width cp)) count)))))))

(defn- contained-counts? [source :string target :string] :bool
  (let [length (string-byte-length source)]
    (loop [i 0]
      (if (>= i length) true
        (let [end (placeholder-end source i)
              cp (string-code-point-at source i)]
          (if (> end 0)
            (let [token (string-substring source i end)]
              (if (= (count-token source token) (count-token target token))
                (recur end) false))
            (recur (+ i (width cp)))))))))

(defn placeholders-match? [source :string target :string] :bool
  (and (contained-counts? source target) (contained-counts? target source)))
