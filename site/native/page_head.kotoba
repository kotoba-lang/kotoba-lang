(ns site.native.page-head (:export [render]) (:capabilities [:fs/app-data :io/write])
 (:require [site.native.dds-base-css :as base] [site.native.dds-ext-css :as ext] [site.native.dds-palette :as palette]
           [site.native.dds-skin-css :as skin] [site.native.source-concat :as concat] [site.native.syntax-theme :as syntax]
           [site.native.article-head :as head] [site.native.header-scripts :as scripts] [site.native.locale-catalog :as catalog]
           [multiformats.sha256 :as sha]))
;; Streams a shared pinned head; callers must stage output until exit 42.
(defn- val [x [:option :string]] :string (option-value-of [:option :string] x ""))
(defn- read [p :string] :string (typed-cap-call :fs/app-data :string :string p))
(defn- digest? [s :string h :string] :bool (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) h))
(defn- emit [prefix :string x [:option :string]] :bool
 (if (not (option-some?-of [:option :string] x)) false
  (let [ignored (typed-cap-call :io/write :string :string (string-concat prefix (val x)))] true)))
(defn- app [generator :string theme-source :string theme-json :string] [:option :string]
 (let [theme (concat/extract theme-source "(def css\n (str" "" "" false) syntax-css (syntax/render theme-json)]
  (if (and (option-some?-of [:option :string] theme) (option-some?-of [:option :string] syntax-css))
   (concat/extract generator "(def app-css\n  (str" (val theme) (val syntax-css) true) (option-none-of [:option :string]))))
(defn render [tag :string path :string title :string description :string english-og-description :string] :i64
 (let [dds (read "/dds.css") lang (read "/language.css") box (read "/box.css") menu (read "/menu.css")
       behavior (read "/behavior.cljk") core (read "/core.cljk") tokens (read "/tokens.cljk") generator (read "/generator.cljk")
       theme-source (read "/theme-source.cljk") theme-json (read "/theme.json")
       known (or (string=? tag "en") (string=? tag "ar") (string=? tag "arz") (string=? tag "bn") (string=? tag "de")
                 (string=? tag "es") (string=? tag "fr") (string=? tag "hi") (string=? tag "id") (string=? tag "ja")
                 (string=? tag "ko") (string=? tag "mr") (string=? tag "pcm") (string=? tag "pt") (string=? tag "ru") (string=? tag "ur") (string=? tag "zh-Hans"))
       json (if known (read (string-concat "/site/i18n/" (string-concat tag ".json"))) "")]
  (if (not known) 7
   (match-option (catalog/open-catalog json) [:option [:ref :site/catalog]]
    (none 7)
    (some state
     (if (and (arena-scope (digest? generator "5bb0ff5d9e2f80ca7a76545ead6d0138ab7516f2bb712dd4f059d8b0bb4f5ab2"))
              (arena-scope (digest? theme-source "4f6a44a9b90ba83719530677c324ea638fbe25da267d0e37213e23e594a7e917"))
              (arena-scope (emit "" (head/before-style state tag path title description dds)))
              (arena-scope (emit "" (base/render dds lang box menu behavior)))
              (arena-scope (emit "\n" (ext/render core)))
              (arena-scope (emit "\n" (palette/theme-css dds)))
              (arena-scope (emit "\n" (skin/skin tokens)))
              (arena-scope (emit "\n" (app generator theme-source theme-json)))
              (if (string=? tag "en") true (arena-scope (emit "" (option-some-of [:option :string] "\n\npre,code,kbd,samp{direction:ltr;unicode-bidi:isolate}pre{text-align:left}"))))
              (arena-scope (let [tail (head/after-style state tag path title description generator behavior theme-source)]
               (if (and (string=? tag "en") (option-some?-of [:option :string] tail))
                (emit "" (option-some-of [:option :string] (string-replace-all (val tail) description english-og-description)))
                (emit "" tail))))) 42 7))))))
