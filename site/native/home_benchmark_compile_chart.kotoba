(ns site.native.home-benchmark-compile-chart (:export [render])
 (:require [json.core :as json] [site.native.locale-tree :as tree]
           [multiformats.sha256 :as sha] [html-hiccup :as html]))
;; Bounded port of the four-lane compiler startup ranked bars, not a general chart library.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- field [d :document k :string] :document (val (document-get d (document-string k))))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- num [d :document] :string
 (let [k (document-kind d) s (document-edn-print d) n (string-byte-length s)]
  (if (or (= k :i64) (= k :f64))
   (if (and (= k :f64) (>= n 2) (string=? (string-substring s (- n 2) n) ".0")) (string-substring s 0 (- n 2)) s) "")))
(defn- number [d :document] :f64
 (if (= (document-kind d) :i64) (i64-to-f64-rounded (option-value-of [:option :i64] (document-i64-value d) 0))
  (option-value-of [:option :f64] (document-f64-value d) 0.0)))
(defn- max2 [a :f64 b :f64] :f64 (if (f64-gt a b) a b))
;; Three fixed fractional digits. This is qualified only for the pinned report.
(defn- fixed3 [x :f64] :string
 (let [v (f64-to-i64-truncating (f64-add (f64-mul x 1000.0) 0.5)) whole (quot v 1000) frac (rem v 1000)]
  (string-concat (string-from-i64 whole) (string-concat "." (string-concat (if (< frac 100) "0" "") (string-concat (if (< frac 10) "0" "") (string-from-i64 frac)))))))
(defn- row [d :document label :string target :string top :f64 lead :bool] [:option :document]
 (let [median (field d "medianMilliseconds") ratio (field d "medianRatioToKotoba") m (num median) q (num ratio) x (number median)]
  (if (or (string=? m "") (string=? q "") (not (f64-gt top 0.0)) (f64-lt x 0.0)) (option-none-of [:option :document])
   (let [attrs (if lead (document-map :class (document-string "kot-bar") :data-lead (document-string "1")) (document-map :class (document-string "kot-bar")))
         width (string-concat "--w:" (string-concat (fixed3 (f64-mul 100.0 (f64-div x top))) "%"))
         note (if (string=? q "1") "the baseline" (string-concat q "× Kotoba"))]
    (option-some-of [:option :document]
     (document-vector (document-keyword :li) attrs
      (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-label")) (document-string label)
       (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-sub")) (document-string target)))
      (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-track"))
       (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-fill") :style (document-string width))))
      (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-value")) (document-string (string-concat m " ms"))
       (document-vector (document-keyword :span) (document-map :class (document-string "kot-bar-note")) (document-string note)))))))))
(defn render [state [:ref :site/catalog] tag :string generator :string report :string chart :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67"))
       r-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 report))) "e86a8b09b9c76ab3183e68fa9aff1c227b639157ef0901d29824b324412f205f"))
       c-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 chart))) "651e9bc2bfc31b15493f00c05d2aeaaddd70e9dbec3be55846a389dccb6e9a20"))]
  (if (or (not g-ok) (not r-ok) (not c-ok)) (option-none-of [:option :string])
   (let [decoded (json/decode report) d (result-value-of [:result :document :document] decoded (document-null)) results (field d "results")
         a (field results "kotoba") b (field results "rust") c (field results "c") e (field results "jvm")
         top (max2 (max2 (number (field a "medianMilliseconds")) (number (field b "medianMilliseconds"))) (max2 (number (field c "medianMilliseconds")) (number (field e "medianMilliseconds"))))
         ra (row a "Kotoba" "WebAssembly" top true) rb (row b "Rust / rustc" "WebAssembly" top false)
         rc (row c "C / Clang" "WebAssembly" top false) re (row e "JVM / javac" "JVM class" top false)
         runs (num (field (field d "method") "runs")) chip (field (field d "environment") "chip")]
    (if (or (not (result-ok?-of [:result :document :document] decoded)) (string=? runs "") (not (= (document-kind chip) :string))
            (not (option-some?-of [:option :document] ra)) (not (option-some?-of [:option :document] rb)) (not (option-some?-of [:option :document] rc)) (not (option-some?-of [:option :document] re))) (option-none-of [:option :string])
     (let [axis (string-concat "Process-cold wall time for one tiny source, in milliseconds; shorter is faster. "
                  (string-concat runs (string-concat " rotating samples per toolchain on " (string-concat (text chip)
                   ". The host-load gate FAILED on this run, so these are observations of one machine, not a ranking."))))
           node (document-vector (document-keyword :div) (document-map :class (document-string "kot-chart"))
             (document-vector (document-keyword :ol) (document-map :class (document-string "kot-bars")) (val ra) (val rb) (val rc) (val re))
             (document-vector (document-keyword :p) (document-map :class (document-string "kot-chart-axis")) (document-string axis)))
           localized (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))]
      (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (option-none-of [:option :string]))))))))
