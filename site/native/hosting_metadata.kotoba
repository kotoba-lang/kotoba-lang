(ns site.native.hosting-metadata (:export [render])
 (:require [multiformats.sha256 :as sha]))
;; Render only the pinned source configuration and exact pinned Play source.
;; These files are candidates for private staging, not proof of deployment.
(defn- hash? [s :string expected :string] :bool
 (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) expected)))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn render [kind :string headers :string generator :string source :string] [:option :string]
 (if (or (not (hash? headers "65bc7f8815bff04432c564f94468fc6aed56ee911e910f594f35dbb71628d611"))
         (not (hash? generator "5bb0ff5d9e2f80ca7a76545ead6d0138ab7516f2bb712dd4f059d8b0bb4f5ab2"))
         (not (hash? source "0471d55d668ed5f9887f9d2520ced9098d03dbbd57086dd3449e98dfb95f2e6b"))) (none)
  (cond (string=? kind "headers")
         (some (string-concat headers "\n/ipfs/bafkreiaeohkv2zuo2x4yq745euqm5wijrub5xpkxbbw5gre6tdp3sxzonm\n  Content-Type: text/plain; charset=utf-8\n  Content-Disposition: inline; filename=hello.kotoba\n"))
        (string=? kind "redirects") (some "/zh /zh-Hans/ 301\n/zh/* /zh-Hans/:splat 301\n")
        (string=? kind "robots") (some "User-agent: *\nAllow: /\n\nSitemap: https://kotoba-lang.org/sitemap.xml\n")
        :else (none))))
