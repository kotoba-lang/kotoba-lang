(ns site.native.library-body-compose (:export [compose])
 (:require [multiformats.sha256 :as sha]))
;; The caller supplies a trusted build manifest. Digests detect input drift;
;; they do not independently establish that its author or fragments are trusted.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- field [d :document k :keyword] :string (option-value-of [:option :string] (document-string-value (val (document-get d k))) ""))
(defn- hash? [s :string h :string] :bool
 (and (= (string-byte-length h) 64) (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) h))))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- replace [s :string needle :string value :string] [:option :string]
 (let [p (string-index-of s needle)]
  (if (< p 0) (none)
   (let [tail (string-substring s (+ p (string-byte-length needle)) (string-byte-length s))]
    (if (>= (string-index-of tail needle) 0) (none) (option-some-of [:option :string] (string-concat (string-substring s 0 p) (string-concat value tail))))))))
(defn- count-of [s :string needle :string count :i64] :i64
 (let [p (string-index-of s needle)]
  (if (< p 0) count (count-of (string-substring s (+ p (string-byte-length needle)) (string-byte-length s)) needle (+ count 1)))))
(defn- clean? [s :string] :bool (< (string-index-of s "KOTOBA_") 0))
(defn- locale? [tag :string] :bool
 (or (string=? tag "en") (string=? tag "ar") (string=? tag "arz") (string=? tag "bn") (string=? tag "de")
     (string=? tag "es") (string=? tag "fr") (string=? tag "hi") (string=? tag "id") (string=? tag "ja")
     (string=? tag "ko") (string=? tag "mr") (string=? tag "pcm") (string=? tag "pt") (string=? tag "ru")
     (string=? tag "ur") (string=? tag "zh-Hans")))
(defn compose [tag :string manifest :string shell :string hero :string identity :string publish :string catalog :string status :string compare :string] [:option :string]
 (let [d (document-edn-read manifest)]
  (if (or (not (locale? tag)) (not (= (document-kind d) :map)) (not (string=? (field d :tag) tag))
          (not (hash? shell (field d :shell))) (not (hash? hero (field d :hero))) (not (hash? identity (field d :identity)))
          (not (hash? publish (field d :publish))) (not (hash? catalog (field d :catalog))) (not (hash? status (field d :status))) (not (hash? compare (field d :compare)))
          (not (clean? hero)) (not (clean? identity)) (not (clean? publish)) (not (clean? catalog)) (not (clean? status)) (not (clean? compare))
          (not (= (count-of hero "id=\"top\"" 0) 1)) (not (= (count-of identity "id=\"identity\"" 0) 1))
          (not (= (count-of publish "id=\"publish\"" 0) 1)) (not (= (count-of catalog "id=\"catalog\"" 0) 1))
          (not (= (count-of status "id=\"status\"" 0) 1)) (not (= (count-of compare "id=\"compare\"" 0) 1))) (none)
   (let [all (string-concat hero (string-concat identity (string-concat publish (string-concat catalog (string-concat status compare)))))
         result (replace shell "KOTOBA_LIBRARY_SECTIONS_SLOT" all)]
    (if (and (option-some?-of [:option :string] result) (clean? (option-value-of [:option :string] result ""))) result (none))))))
