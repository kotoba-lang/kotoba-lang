(ns site.native.home-benchmark-compose (:export [compose])
 (:require [multiformats.sha256 :as sha]))
;; The caller authenticates the immutable manifest and verifies each fragment's provenance.
;; A successful composition alone does not qualify the benchmark or the site for release.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- field [d :document k :keyword] :string (option-value-of [:option :string] (document-string-value (val (document-get d k))) ""))
(defn- hash? [s :string h :string] :bool
 (and (= (string-byte-length h) 64) (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) h))))
(defn- locale? [s :string] :bool
 (or (string=? s "en") (string=? s "ar") (string=? s "arz") (string=? s "bn") (string=? s "de") (string=? s "es") (string=? s "fr") (string=? s "hi") (string=? s "id") (string=? s "ja") (string=? s "ko") (string=? s "mr") (string=? s "pcm") (string=? s "pt") (string=? s "ru") (string=? s "ur") (string=? s "zh-Hans")))
(defn- starts? [s :string prefix :string] :bool
 (and (>= (string-byte-length s) (string-byte-length prefix)) (string=? (string-substring s 0 (string-byte-length prefix)) prefix)))
(defn- ends? [s :string suffix :string] :bool
 (let [n (string-byte-length s) m (string-byte-length suffix)] (and (>= n m) (string=? (string-substring s (- n m) n) suffix))))
(defn- clean? [s :string] :bool
 (and (< (string-index-of s "KOTOBA_") 0) (< (string-index-of s "TEST BENCHMARK") 0) (< (string-index-of s "98765000000") 0)))
(defn compose [tag :string manifest :string intro :string cards :string scaling :string remainder :string] [:option :string]
 (let [m (document-edn-read manifest) end "</section>" n (string-byte-length intro)]
  (if (or (not (locale? tag)) (not (= (document-kind m) :map)) (not (string=? (field m :tag) tag))
          (not (hash? intro (field m :intro))) (not (hash? cards (field m :cards))) (not (hash? scaling (field m :scaling))) (not (hash? remainder (field m :remainder)))
          (not (starts? intro "<section")) (not (ends? intro end)) (< (string-index-of intro "id=\"benchmark\"") 0)
          (not (starts? cards "<div class=\"dds-ext-grid\"")) (not (ends? cards "</div>"))
          (not (starts? scaling "<h3")) (not (starts? remainder "<h3"))
          (not (clean? intro)) (not (clean? cards)) (not (clean? scaling)) (not (clean? remainder))) (option-none-of [:option :string])
   (option-some-of [:option :string] (string-concat (string-substring intro 0 (- n (string-byte-length end))) (string-concat cards (string-concat scaling (string-concat remainder end))))))))
