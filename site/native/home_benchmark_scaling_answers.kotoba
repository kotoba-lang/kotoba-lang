(ns site.native.home-benchmark-scaling-answers (:export [render])
 (:require [json.core :as json] [site.native.source-concat :as source] [site.native.locale-tree :as tree]
           [multiformats.sha256 :as sha] [html-hiccup :as html] [table :as table]))
;; Interpret only the pinned conclusion-table string expressions and report fields.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- field [d :document k :string] :document (if (= (document-kind d) :map) (val (document-get d (document-string k))) (document-null)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- arg [d :document i :i64] :document (val (document-list-at d i)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- integer [d :document] :i64 (option-value-of [:option :i64] (document-i64-value d) -1))
(defn- absent [] [:option :string] (option-none-of [:option :string]))
(defn- present [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- thousands [n :i64] :string
 (if (< n 1000) (string-from-i64 n)
  (let [r (rem n 1000)] (string-concat (thousands (quot n 1000)) (string-concat "," (string-concat (if (< r 100) "0" "") (string-concat (if (< r 10) "0" "") (string-from-i64 r))))))))
(defn- concat-exprs [d :document i :i64 top :i64 broken :i64 fuel :i64 out :string] [:option :string]
 (if (>= i (document-count d)) (present out)
  (let [part (expression (arg d i) top broken fuel)]
   (if (option-some?-of [:option :string] part) (concat-exprs d (+ i 1) top broken fuel (string-concat out (option-value-of [:option :string] part ""))) (absent)))))
(defn- expression [d :document top :i64 broken :i64 fuel :i64] [:option :string]
 (let [kind (document-kind d) n (if (= kind :list) (document-count d) 0) name (document-edn-print d)]
  (cond (= kind :string) (present (text d))
        (or (= kind :i64) (= kind :f64)) (present name)
        (= kind :symbol) (cond (string=? name "cli-top") (present (string-from-i64 top)) (string=? name "cli-broken") (if (> broken 0) (present (string-from-i64 broken)) (absent)) :else (absent))
        (= kind :list)
         (let [head (document-edn-print (arg d 0))]
          (cond (string=? head "str") (concat-exprs d 1 top broken fuel "")
                (and (string=? head "inc") (= n 2) (string=? (document-edn-print (arg d 1)) "cli-top")) (present (string-from-i64 (+ top 1)))
                (and (string=? head "if") (= n 4) (string=? (document-edn-print (arg d 1)) "cli-broken")) (expression (arg d (if (> broken 0) 2 3)) top broken fuel)
                (and (string=? head "thousands") (= n 2) (string=? (document-edn-print (arg d 1)) "(get-in build-scaling [:method :declaredKotobaFuel])")) (present (thousands fuel))
                :else (absent)))
        :else (absent))))
(defn- select [scales :document lane :string status :string last? :bool] :i64
 (loop [i 0 found -1]
  (if (>= i (document-count scales)) found
   (let [s (item scales i) result (field (field s "lanes") lane) hit (string=? (text (field result "status")) status) k (integer (field s "k"))]
    (if (and hit (not last?)) k (recur (+ i 1) (if hit k found)))))))
(defn- scale-at [scales :document wanted :i64 i :i64] :document
 (if (>= i (document-count scales)) (document-null)
  (let [d (item scales i)] (if (= (integer (field d "k")) wanted) d (scale-at scales wanted (+ i 1))))))
(defn- replace-once [s :string marker :string replacement :string] [:option :string]
 (let [at (string-index-of s marker)]
  (if (< at 0) (absent)
   (let [end (+ at (string-byte-length marker)) tail (string-substring s end (string-byte-length s))]
    (if (>= (string-index-of tail marker) 0) (absent) (present (string-concat (string-substring s 0 at) (string-concat replacement tail))))))))
(defn- row [d :document top :i64 broken :i64 fuel :i64] [:option :document]
 (let [a (expression (item d 0) top broken fuel) b (expression (item d 1) top broken fuel)]
  (if (or (not (= (document-kind d) :vector)) (not (= (document-count d) 2)) (not (option-some?-of [:option :string] a)) (not (option-some?-of [:option :string] b))) (option-none-of [:option :document])
   (option-some-of [:option :document] (document-vector (document-keyword :tr)
    (document-vector (document-keyword :th) (document-map :class (document-string "dads-table__row-header") :scope (document-string "row")) (document-string (option-value-of [:option :string] a "")))
    (document-vector (document-keyword :td) (document-string (option-value-of [:option :string] b ""))))))))
(defn- rows [state [:ref :site/catalog] tag :string xs :document top :i64 broken :i64 fuel :i64 i :i64 out :string] [:option :string]
 (if (>= i (document-count xs)) (present out)
  (let [r (row (item xs i) top broken fuel) localized (if (and (option-some?-of [:option :document] r) (not (string=? tag "en"))) (tree/map-indexed state (val r)) r)
        rendered (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (absent))]
   (if (option-some?-of [:option :string] rendered) (rows state tag xs top broken fuel (+ i 1) (string-concat out (option-value-of [:option :string] rendered ""))) (absent)))))
(defn render [state [:ref :site/catalog] tag :string generator :string report :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67"))
       r-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 report))) "9bb56646bb55a8746b36c66c42ebefb48bebd17ab60c4df79a2ab1702537e229"))]
  (if (or (not g-ok) (not r-ok)) (absent)
   (let [decoded (json/decode report) data (result-value-of [:result :document :document] decoded (document-null)) scales (field data "scales")
         top (select scales "kotoba-wasm-cli" "measured" true) amu (select scales "amu-wasm" "measured" true)
         scale-one (scale-at scales 1 0) scale-amu (scale-at scales amu 0)
         median (field (field (field (field scale-one "lanes") "kotoba-wasm-cli") "summary") "median") lines (integer (field (field scale-amu "sourceLines") "kotoba"))
         anchor (string-index-of generator ":caption \"The fifth benchmark's answers, including the ones that are unfavourable\"")
         tail (if (< anchor 0) "" (string-substring generator anchor (string-byte-length generator)))
         first (replace-once tail "(median 1 :kotoba-wasm-cli)" (document-edn-print median))
         second (if (option-some?-of [:option :string] first) (replace-once (option-value-of [:option :string] first "") "(or amu-top biggest)" (string-from-i64 amu)) (absent))
         third (if (option-some?-of [:option :string] second) (replace-once (option-value-of [:option :string] second "") "(get-in (first (filter #(= amu-top (:k %)) scales)) [:sourceLines :kotoba])" (string-from-i64 lines)) (absent))
         forms (if (option-some?-of [:option :string] third) (source/data (option-value-of [:option :string] third "") ":rows " 91 93) (option-none-of [:option :document]))
         body (if (and (option-some?-of [:option :document] forms) (= (document-kind (val forms)) :vector) (= (document-count (val forms)) 5) (> top 0) (> amu 0) (> lines 0)
                       (or (= (document-kind median) :i64) (= (document-kind median) :f64)))
               (rows state tag (val forms) top 0 1 0 "") (absent))]
    (if (or (not (result-ok?-of [:result :document :document] decoded)) (not (option-some?-of [:option :string] body))) (absent)
     (let [node (document-vector (document-keyword :div) (document-map :class (document-string "kot-table-scroll"))
            (document-vector (document-keyword :div) (document-map :class (document-string "dads-table"))
             (document-vector (document-keyword :table) (document-map :class (document-string "dads-table__table"))
              (document-vector (document-keyword :caption) (document-string "The fifth benchmark's answers, including the ones that are unfavourable"))
              (document-vector (document-keyword :thead) (document-vector (document-keyword :tr) (table/header-cell-node (document-string "Question") false) (table/header-cell-node (document-string "Answer from this run") false)))
              (document-vector (document-keyword :tbody) (document-string "987654321013")))))
           localized (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))
           frame (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (absent)) raw (option-value-of [:option :string] frame "") marker (string-index-of raw "987654321013")]
      (if (or (not (option-some?-of [:option :string] frame)) (< marker 0)) (absent)
       (present (string-concat (string-substring raw 0 marker) (string-concat (option-value-of [:option :string] body "") (string-substring raw (+ marker 12) (string-byte-length raw))))))))))))
