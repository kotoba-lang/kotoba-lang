(ns site.native.dds-base-css (:export [render])
 (:require [site.native.source-concat :as concat] [multiformats.sha256 :as sha]))
;; Source-bound concatenation exactly follows site/generate.cljk's dds-css.
;; DDS extension, dark, skin and page CSS are separately generated layers.
(defn- digest? [s :string expected :string] :bool
 (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) expected))
(defn render [base :string language :string box :string menu :string behavior :string] [:option :string]
 (if (not (and (digest? base "86ed3735a051817b93e8bdf281354a112675b3b45b96b61dacb6310cea818ce9")
               (digest? language "0d12b52bfce539d5ddfb34bbe37400df26607e6e0aca4d6884b64f8c61c8d626")
               (digest? box "9420576fc5cb4015f03fb1693b181aca4abcd92f7f633d6ca5189e37a5caaed6")
               (digest? menu "d1c42757f2464f026f10a0717adaae5360080d3b673c766b3f831420f42857cc")
               (digest? behavior "750156834e1af6c89f4b80eeb144fc4746638cf2e2822324a2e556d15e7b12bb")))
  (option-none-of [:option :string])
  (let [extra (concat/literal behavior "(def language-selector-css\n  ")]
   (if (option-some?-of [:option :string] extra)
    (option-some-of [:option :string] (string-concat base
     (string-concat language (string-concat "\n" (string-concat box (string-concat "\n" (string-concat menu (option-value-of [:option :string] extra ""))))))))
    (option-none-of [:option :string])))))
