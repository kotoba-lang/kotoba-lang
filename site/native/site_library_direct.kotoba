(ns site.native.site-library-direct (:export [main])
 (:capabilities [:fs/app-data-bytes :process/spawn :cli/args])
 (:require [site.native.site-home-direct :as home] [site.native.library-stage :as library] [multiformats.sha256 :as sha]))
;; Trusted manifest and private roots. An error leaves an incomplete stage, not a release.
(defn- bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- zero [] :string (string-from-utf8 (bytes-from-vector-i64 [0])))
(defn- cat [a :vector-i64 b :vector-i64] :vector-i64
 (let [n (vector-count a) m (vector-count b) x (loop [i 0 v (vector-alloc (+ n m))] (if (= i n) v (recur (+ i 1) (vector-assoc! v i (vector-at a i)))))]
  (loop [i 0 v x] (if (= i m) v (recur (+ i 1) (vector-assoc! v (+ n i) (vector-at b i)))))))
(defn- call [op :i64 p :string] :vector-i64
 (vector-i64-from-bytes (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-from-vector-i64 (cat [0 65 77 85 72 1 op] (bytes (string-concat p (zero))))))))
(defn- ok? [v :vector-i64] :bool (and (> (vector-count v) 0) (= (vector-at v 0) 0)))
(defn- matches? [p :string digest :string] :bool
 (let [v (call 1 p)] (if (or (not (= (string-byte-length digest) 64)) (not (ok? v))) false
  (let [data (loop [i 1 out (vector-alloc (- (vector-count v) 1))] (if (= i (vector-count v)) out (recur (+ i 1) (vector-assoc! out (- i 1) (vector-at v i)))))]
   (arena-scope (string=? (sha/digest-hex data) digest))))))
(defn- tag [i :i64] :string
 (case i 0 "en" 1 "ar" 2 "arz" 3 "bn" 4 "de" 5 "es" 6 "fr" 7 "hi" 8 "id" 9 "ja" 10 "ko" 11 "mr" 12 "pcm" 13 "pt" 14 "ru" 15 "ur" 16 "zh-Hans" ""))
(defn- dirs [site :string i :i64] :bool
 (if (= i 17) true
  (let [t (tag i) parent (if (string=? t "en") site (string-concat site (string-concat "/" t))) p (string-concat parent "/libraries")]
   (and (ok? (call 3 p)) (dirs site (+ i 1))))))
(defn- arg [n :string] :string (typed-cap-call :cli/args :string :string n))
(defn main [] :i64
 (let [section-manifest (arg "0") section-sha (arg "1") home-manifest (arg "2") home-sha (arg "3")
       library-manifest (arg "4") library-sha (arg "5") private (arg "6") site (arg "7")]
  (if (or (not (matches? library-manifest library-sha)) (string=? private "") (string=? site "")) 7
   (if (and (= (arena-scope (home/run section-manifest section-sha home-manifest home-sha private site)) 42) (dirs site 0))
    (library/run library-manifest site) 7))))
