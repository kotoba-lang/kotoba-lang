(ns site.native.home-library (:export [render])
 (:require [site.native.source-concat :as source] [site.native.home-section :as section]
           [site.native.locale-tree :as tree] [site.native.locale-rebase :as rebase]
           [site.native.library-aggregate-stream :as aggregate] [multiformats.sha256 :as sha] [html-hiccup :as html]))
;; Historical, digest-bound catalog observation; not current GitHub or publication qualification.
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- field [d :document k :keyword] :document (val (document-get d k)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- valid-hash? [s :string expected :string] :bool
 (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) expected)))
(defn- replace-one [s :string old :string new :string] [:option :string]
 (let [p (string-index-of s old) tail (if (< p 0) "" (string-substring s (+ p (string-byte-length old)) (string-byte-length s)))]
  (if (or (< p 0) (>= (string-index-of tail old) 0)) (none)
   (some (string-concat (string-substring s 0 p) (string-concat new tail))))))
(defn- replace-range [s :string first :string last :string new :string] [:option :string]
 (let [p (string-index-of s first) tail (if (< p 0) "" (string-substring s p (string-byte-length s))) q (string-index-of tail last)]
  (if (or (< p 0) (< q 0)) (none)
   (some (string-concat (string-substring s 0 p) (string-concat new (string-substring tail (+ q (string-byte-length last)) (string-byte-length tail))))))))
(defn- occurrences [s :string needle :string n :i64] :i64
 (let [p (string-index-of s needle)]
  (if (< p 0) n (occurrences (string-substring s (+ p (string-byte-length needle)) (string-byte-length s)) needle (+ n 1)))))
(defn- number [summary :string key :string] :i64
 (let [needle (string-concat key "\t") p (string-index-of summary needle) start (+ p (string-byte-length needle))
       rest (if (< p 0) "" (string-substring summary start (string-byte-length summary))) end (string-index-of rest "\n")]
  (if (or (< p 0) (< end 1)) -1 (option-value-of [:option :i64] (parse-long (string-substring rest 0 end)) -1))))
(defn- thousands [n :i64] :string
 (if (< n 1000) (string-from-i64 n)
  (let [r (rem n 1000)] (string-concat (thousands (quot n 1000)) (string-concat "," (string-concat (if (< r 100) "0" "") (string-concat (if (< r 10) "0" "") (string-from-i64 r))))))))
(defn- chip [state [:ref :site/catalog] tag :string item :document summary :string] [:option :string]
 (let [label (text (field item :label)) topic (text (field item :topic)) n (number summary topic)
       href (string-concat "./libraries/#tag=" topic)
       node (document-vector (document-keyword :a) (document-map :class (document-string "dads-button") :data-type (document-string "outline") :data-size (document-string "sm") :href (document-string href))
              (document-string (string-concat label (string-concat " · " (thousands n)))))
       local (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))
       bound (if (and (option-some?-of [:option :document] local) (not (string=? tag "en"))) (rebase/rebase-links (val local) tag "/") local)]
  (if (or (string=? label "") (string=? topic "") (< n 0) (not (option-some?-of [:option :document] bound))) (none) (html/render (val bound) 0))))
(defn- chips [state [:ref :site/catalog] tag :string xs :document summary :string i :i64 out :string] [:option :string]
 (if (>= i (document-count xs)) (some out)
  (let [item (val (document-vector-at xs i)) n (number summary (text (field item :topic)))]
   (if (= n 0) (chips state tag xs summary (+ i 1) out)
    (let [part (chip state tag item summary)]
     (if (option-some?-of [:option :string] part) (chips state tag xs summary (+ i 1) (string-concat out (option-value-of [:option :string] part ""))) (none)))))))
(defn render [state [:ref :site/catalog] tag :string generator :string taxonomy :string catalog :string registry :string] [:option :string]
 (let [sum (aggregate/compute catalog taxonomy) tax (document-edn-read taxonomy)
       planes (field tax :planes) domains (field tax :domains) counts (option-value-of [:option :string] sum "")
       total (number counts "total") untagged (number counts "untagged") records (occurrences registry "#:registry{" 0)]
  (if (or (not (valid-hash? generator "5bb0ff5d9e2f80ca7a76545ead6d0138ab7516f2bb712dd4f059d8b0bb4f5ab2"))
          (not (valid-hash? registry "62c7653855b82bd941f9d9cf619dca8f1ee3ba655f32d8d9d2bbf132b402f29b"))
          (not (option-some?-of [:option :string] sum))
          (not (= (document-kind planes) :vector)) (not (= (document-kind domains) :vector)) (< total 1) (< untagged 0) (not (= records 1))) (none)
   (let [a (replace-range generator "(for [tag catalog-tag-order" "(catalog-chip tag n {:href \"./libraries/\"}))" "\"98765432109876543210\"")
         browse (string-concat "Browse and filter all " (string-concat (thousands total) " repositories"))
         b (replace-range (option-value-of [:option :string] a "") "(str \"Browse and filter all \"" "\" repositories\")" (document-edn-print (document-string browse)))
         c (replace-one (option-value-of [:option :string] b "") "(thousands (:total tagged-catalog))" (document-edn-print (document-string (thousands total))))
         caption (string-concat "A repository is not a published package. Exactly " (string-concat (string-from-i64 records)
          (string-concat " library is published through the content-addressed registry; the rest of "
           (string-concat "this list is discovery. Repository maturity labels do not imply 1.0 API "
            (string-concat "stability, broad adoption, or production SLOs, and "
             (string-concat (thousands untagged) (string-concat " repositories match no domain rule and are shown untagged rather than " "given the nearest label.")))))))
         d (replace-range (option-value-of [:option :string] c "") "(str \"A repository is not a published package. Exactly \"" "\"given the nearest label.\")" (document-edn-print (document-string caption)))
         parsed (source/data (option-value-of [:option :string] d "") "(defn libraries-section []" 40 41)
         node (if (option-some?-of [:option :document] parsed) (section/evaluate (val parsed)) (option-none-of [:option :document]))
         local (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)
         bound (if (and (option-some?-of [:option :document] local) (not (string=? tag "en"))) (rebase/rebase-links (val local) tag "/") local)
         frame (if (option-some?-of [:option :document] bound) (html/render (val bound) 0) (none))
         p (chips state tag planes counts 0 "") q (chips state tag domains counts 0 "")]
    (if (or (not (option-some?-of [:option :string] a)) (not (option-some?-of [:option :string] b)) (not (option-some?-of [:option :string] c)) (not (option-some?-of [:option :string] d))
            (not (option-some?-of [:option :string] frame)) (not (option-some?-of [:option :string] p)) (not (option-some?-of [:option :string] q))) (none)
     (replace-one (option-value-of [:option :string] frame "") "98765432109876543210" (string-concat (option-value-of [:option :string] p "") (option-value-of [:option :string] q ""))))))))
