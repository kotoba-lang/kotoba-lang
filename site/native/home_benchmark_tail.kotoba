(ns site.native.home-benchmark-tail (:export [compose])
 (:require [multiformats.sha256 :as sha]))
;; The caller authenticates the immutable manifest and fragment provenance.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- field [d :document k :keyword] :string (option-value-of [:option :string] (document-string-value (val (document-get d k))) ""))
(defn- hash? [s :string h :string] :bool
 (and (= (string-byte-length h) 64) (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) h))))
(defn- locale? [s :string] :bool
 (or (string=? s "en") (string=? s "ar") (string=? s "arz") (string=? s "bn") (string=? s "de") (string=? s "es") (string=? s "fr") (string=? s "hi") (string=? s "id") (string=? s "ja") (string=? s "ko") (string=? s "mr") (string=? s "pcm") (string=? s "pt") (string=? s "ru") (string=? s "ur") (string=? s "zh-Hans")))
(defn- valid? [s :string] :bool
 (let [n (string-byte-length s)]
  (and (>= n 3) (string=? (string-substring s 0 3) "<h3") (< (string-index-of s "KOTOBA_") 0) (< (string-index-of s "TEST BENCHMARK") 0) (< (string-index-of s "98765000000") 0))))
(defn compose [tag :string manifest :string domain :string evidence :string] [:option :string]
 (let [m (document-edn-read manifest)]
  (if (or (not (locale? tag)) (not (= (document-kind m) :map)) (not (string=? (field m :tag) tag))
          (not (hash? domain (field m :domain))) (not (hash? evidence (field m :evidence))) (not (valid? domain)) (not (valid? evidence)))
   (option-none-of [:option :string]) (option-some-of [:option :string] (string-concat domain evidence)))))
