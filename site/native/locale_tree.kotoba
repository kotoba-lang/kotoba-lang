(ns site.native.locale-tree
  (:export [map-text map-indexed])
  (:require [site.native.locale-filter :as filter]
            [site.native.locale-message :as message]
            [site.native.locale-catalog :as catalog]))

;; This maps bounded document-encoded fragments, not arbitrary whole pages.
;; A missing required translation returns none and never emits partial output.
(defn- present [d :document] [:option :document]
  (option-some-of [:option :document] d))
(defn- missing [] [:option :document]
  (option-none-of [:option :document]))
(defn- value [o [:option :document]] :document
  (option-value-of [:option :document] o (document-null)))
(defn- string-value [d :document] :string
  (option-value-of [:option :string] (document-string-value d) ""))
(defn- keyword-value [d :document] :keyword
  (option-value-of [:option :keyword] (document-keyword-value d) :missing))

(defn- protected? [k :keyword] :bool
  (or (= k :script) (= k :style) (= k :pre) (= k :code) (= k :kbd)
      (= k :samp) (= k :hiccup/raw)))
(defn- text-attribute? [k :keyword] :bool
  (or (= k :title) (= k :alt) (= k :aria-label) (= k :placeholder)
      (= k :data-count-template) (= k :data-verifying) (= k :data-success) (= k :data-error)))

(defn- text-node [state [:ref :site/catalog] d :document] [:option :document]
  (let [s (string-value d)]
    (if (filter/translatable? s)
      (let [v (message/translate-indexed state s)]
        (if (option-some?-of [:option :string] v)
          (present (document-string (option-value-of [:option :string] v "")))
          (missing)))
      (present d))))

(defn- attributes [state [:ref :site/catalog] d :document] [:option :document]
  (loop [i 0 out d]
    (if (>= i (document-count d)) (present out)
      (let [pair (value (document-map-entry-at d i))
            key (value (document-vector-at pair 0)) v (value (document-vector-at pair 1))]
        (if (and (text-attribute? (keyword-value key)) (= (document-kind v) :string))
          (let [translated (text-node state v)]
            (if (option-some?-of [:option :document] translated)
              (recur (+ i 1) (document-assoc out key (value translated)))
              (missing)))
          (recur (+ i 1) out))))))

(defn- children [state [:ref :site/catalog] node :document start :i64 out :document] [:option :document]
  (loop [i start acc out]
    (if (>= i (document-count node)) (present acc)
      (let [v (map-indexed state (value (document-vector-at node i)))]
        (if (option-some?-of [:option :document] v)
          (recur (+ i 1) (document-vector-conj acc (value v)))
          (missing))))))

(defn- sequence [state [:ref :site/catalog] node :document] [:option :document]
  ;; Rebuild an ordered list from canonical document text; elements are never
  ;; interpreted as raw HTML and are rendered by the shared HTML owner later.
  (loop [i 0 out "("]
    (if (>= i (document-count node)) (present (document-edn-read (string-concat out ")")))
      (let [v (map-indexed state (value (document-list-at node i)))]
        (if (option-some?-of [:option :document] v)
          (recur (+ i 1)
                 (string-concat out (string-concat (if (= i 0) "" " ")
                                                   (document-edn-print (value v)))))
          (missing))))))

(defn map-indexed [state [:ref :site/catalog] node :document] [:option :document]
  (let [kind (document-kind node)]
    (cond (= kind :string) (text-node state node)
          (= kind :list) (sequence state node)
          (= kind :vector)
          (let [tag (value (document-vector-at node 0))
                second (value (document-vector-at node 1))
                has-attrs (= (document-kind second) :map)]
            (if (or (protected? (keyword-value tag))
                    (and has-attrs (string=? (string-value (value (document-get second :translate))) "no")))
              (present node)
              (if has-attrs
                (let [a (attributes state second)]
                  (if (option-some?-of [:option :document] a)
                    (children state node 2 (document-vector tag (value a)))
                    (missing)))
                (children state node 1 (document-vector tag)))))
          :else (present node))))

;; Parse once for a standalone fragment. Multi-fragment builders should open a
;; catalog once and pass the unchanged record to map-indexed for each chunk.
(defn map-text [catalog-json :string node :document] [:option :document]
  (match-option (catalog/open-catalog catalog-json) [:option [:ref :site/catalog]]
    (none (missing))
    (some state (map-indexed state node))))
