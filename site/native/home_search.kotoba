(ns site.native.home-search (:export [render])
 (:require [site.native.source-concat :as source] [site.native.home-section :as home]
           [site.native.locale-tree :as tree] [multiformats.sha256 :as sha]
           [html-hiccup :as html] [components :as dds]))
;; Source-locked, streamed search section. ASCII folding is qualified only for
;; the pinned all-ASCII index; this is not a general Unicode search indexer.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- getv [d :document k :keyword] :document (if (= (document-kind d) :map) (val (document-get d k)) (document-null)))
(defn- strval [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
  (some (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (none)))
(defn- node [state [:ref :site/catalog] tag :string d :document] [:option :string]
 (let [localized (if (string=? tag "en") (option-some-of [:option :document] d) (tree/map-indexed state d))]
  (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (none))))
(defn- data [s :string marker :string opening :i64 closing :i64] [:option :document]
 (let [at (string-index-of s marker) tail (if (< at 0) "" (string-substring s at (string-byte-length s)))]
  (source/data (string-concat "~FORM~" tail) "~FORM~" opening closing)))
(defn- ascii? [s :string i :i64] :bool
 (if (>= i (string-byte-length s)) true (if (< (string-code-point-at s i) 128) (ascii? s (+ i 1)) false)))
(defn- keywords [xs :document i :i64 out :string] [:option :string]
 (if (>= i (document-count xs)) (some out)
  (let [v (item xs i)]
   (if (= (document-kind v) :string) (keywords xs (+ i 1) (string-concat out (string-concat (if (= i 0) "" " ") (strval v)))) (none)))))
(defn- row [state [:ref :site/catalog] tag :string d :document] [:option :string]
 (let [kind (getv d :kind) title (getv d :title) body (getv d :body) url (getv d :url) keys (getv d :keywords)
       printed (document-edn-print kind) label (if (> (string-byte-length printed) 1) (string-substring printed 1 (string-byte-length printed)) "")
       terms (if (= (document-kind keys) :vector) (keywords keys 0 "") (none))
       raw (string-concat (strval title) (string-concat " " (string-concat (strval body) (string-concat " " (option-value-of [:option :string] terms "")))))]
  (if (or (not (= (document-kind kind) :keyword)) (string=? label "") (not (= (document-kind title) :string))
          (not (= (document-kind body) :string)) (not (= (document-kind url) :string)) (not (option-some?-of [:option :string] terms)) (not (ascii? raw 0))) (none)
   (node state tag
    (document-vector (document-keyword :div) (document-map :class (document-string "kot-search-item") :data-search (document-string (string-fold-ascii raw)))
     (document-vector (document-keyword :div) (document-map :class (document-string "dds-ext-card"))
      (document-vector (document-keyword :span) (document-map :class (document-string "dads-chip-label") :data-style (document-string "text") :data-color (document-string "blue")) (document-string label))
      (dds/heading-node 3 (if (string=? label "cli") (document-vector (document-keyword :code) title) title) "20" "")
      (document-vector (document-keyword :p) body)
      (document-vector (document-keyword :a) (document-map :class (document-string "kot-link") :href (document-string (string-concat "https://github.com/kotoba-lang/kotoba-lang/blob/main/" (strval url))) :rel (document-string "noreferrer")) (document-string "Open reference"))))))))
(defn- rows [state [:ref :site/catalog] tag :string xs :document i :i64 out [:option :string]] [:option :string]
 (if (or (>= i (document-count xs)) (not (option-some?-of [:option :string] out))) out
  (rows state tag xs (+ i 1) (append out (row state tag (item xs i))))))
(defn render [state [:ref :site/catalog] tag :string generator :string index :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67"))
       i-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 index))) "d886adfaa12e99dafce455ce600bbae0d1298c56448580091e30915d59ed8f4c"))
       at (if g-ok (string-index-of generator "(defn search-section []") -1) src (if (< at 0) "" (string-substring generator at (string-byte-length generator)))
       opts (source/data src "(dds/section" 123 125) section-title (getv (val opts) :title)
       intro (data src "[:p {:class \"kot-lead\"}" 91 93)
       field (source/data src "(dds/form-field" 123 125) input (source/data src "(dds/input-text" 123 125)
       label (getv (val field) :label) target (getv (val field) :for) support (getv (val field) :support) support-id (getv (val field) :support-id)
       input-id (getv (val input) :id) input-label (getv (val input) :aria-label) described (getv (val input) :aria-describedby)
       counter (data src "[:p {:id \"kot-doc-search-count\"" 91 93)
       records (if i-ok (document-edn-read index) (document-null))]
  (if (or (not g-ok) (not i-ok) (< at 0) (not (= (document-kind section-title) :string)) (not (option-some?-of [:option :document] intro))
          (not (option-some?-of [:option :document] field)) (not (option-some?-of [:option :document] input))
          (not (= (document-kind label) :string)) (not (= (document-kind target) :string)) (not (= (document-kind support) :string))
          (not (= (document-kind support-id) :string)) (not (= (document-kind input-id) :string)) (not (= (document-kind input-label) :string))
          (not (= (document-kind described) :string)) (not (option-some?-of [:option :document] counter)) (not (= (document-kind records) :vector))) (none)
   (let [form (document-vector (document-keyword :div) (document-map :class (document-string "dads-form-control-label") :data-size (document-string "md"))
                 (document-vector (document-keyword :label) (document-map :class (document-string "dads-form-control-label__label") :for target) label)
                 (document-vector (document-keyword :p) (document-map :class (document-string "dads-form-control-label__support-text") :id support-id) support)
                 (document-vector (document-keyword :div)
                  (document-vector (document-keyword :span) (document-map :class (document-string "dads-input-text"))
                   (document-vector (document-keyword :input) (document-map :class (document-string "dads-input-text__input") :data-size (document-string "md")
                    :type (document-string "search") :id input-id :aria-label input-label :aria-describedby described)))))
         a (append (some "<section class=\"dds-ext-section\">") (node state tag (dds/heading-node 2 section-title "32" "")))
         b (append a (node state tag (val intro))) c (append b (node state tag form)) d (append c (node state tag (val counter)))
         e (append d (some "<div id=\"kot-doc-search-results\">")) f (rows state tag records 0 e)
         caption (data src "(caption \"No query leaves the browser.\"" 40 41)
         cap-node (if (option-some?-of [:option :document] caption) (home/evaluate (val caption)) (option-none-of [:option :document]))
         g (append f (some "</div>")) h (if (option-some?-of [:option :document] cap-node) (append g (node state tag (val cap-node))) (none))]
    (append h (some "</section>"))))))
