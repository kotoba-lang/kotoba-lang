(ns site.native.legal-body-file-linux (:export [main]) (:capabilities [:fs/app-data :cli/args])
 (:require [site.native.locale-catalog :as catalog] [site.native.legal-body :as legal]))
(defn- locale? [s :string] :bool
 (or (string=? s "en") (string=? s "ar") (string=? s "arz") (string=? s "bn") (string=? s "de")
     (string=? s "es") (string=? s "fr") (string=? s "hi") (string=? s "id") (string=? s "ja")
     (string=? s "ko") (string=? s "mr") (string=? s "pcm") (string=? s "pt") (string=? s "ru")
     (string=? s "ur") (string=? s "zh-Hans")))
(defn- read [p :string] :string
 (typed-cap-call :fs/app-data :string :string (string-concat (typed-cap-call :cli/args :string :string "2") p)))
(defn- fs2 [op :string path :string data :string] :string
 (typed-cap-call :fs/app-data :string :string
  (string-concat "\u0000FS2\u0000" (string-concat op (string-concat path (string-concat "\u0000" data))))))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0") target (typed-cap-call :cli/args :string :string "1")]
  (if (or (not (locale? tag)) (string=? target "")) 7
   (match-option (catalog/open-catalog (read (string-concat "/site/i18n/" (string-concat tag ".json")))) [:option [:ref :site/catalog]]
    (none 7)
    (some state (let [result (legal/render state tag (read "/generator.cljk"))]
      (if (and (option-some?-of [:option :string] result) (string=? (fs2 "D" target "") "\u0000FS2\u00000"))
       (let [body (option-value-of [:option :string] result "")]
        (if (string=? (fs2 "B" target body) (string-concat "\u0000FS2\u0000" body)) 42 7)) 7)))))))
