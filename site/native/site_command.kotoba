(ns site.native.site-command (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.article-page :as article] [site.native.sitemap-page :as sitemap] [site.native.home-opening-page :as opening] [site.native.home-closing-page :as closing] [site.native.home-try-prefix-page :as try-prefix]))
;; Partial native entry: three article routes, opening, closing and try-prefix homepage fragments and sitemap. The caller must stage
;; stdout until the exit status is 42; this is not yet a whole-site generator.
(defn main [] :i64
 (let [command (typed-cap-call :cli/args :string :string "0")]
  (cond (string=? command "try-prefix") (try-prefix/main)
        (string=? command "closing") (closing/main)
        (string=? command "opening") (opening/main)
        (string=? command "sitemap") (sitemap/main)
        (or (string=? command "infra") (string=? command "security") (string=? command "identity")) (article/main)
        :else 7)))
