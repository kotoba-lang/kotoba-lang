(ns site.native.site-command (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.article-page :as article] [site.native.sitemap-page :as sitemap] [site.native.home-opening-page :as opening]))
;; Partial native entry: three article routes, opening homepage chapters and sitemap. The caller must stage
;; stdout until the exit status is 42; this is not yet a whole-site generator.
(defn main [] :i64
 (let [command (typed-cap-call :cli/args :string :string "0")]
  (cond (string=? command "opening") (opening/main)
        (string=? command "sitemap") (sitemap/main)
        (or (string=? command "infra") (string=? command "security") (string=? command "identity")) (article/main)
        :else 7)))
