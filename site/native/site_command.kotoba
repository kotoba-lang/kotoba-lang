(ns site.native.site-command (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.article-page :as article] [site.native.sitemap-page :as sitemap]))
;; Partial native entry: two article routes and sitemap. The caller must stage
;; stdout until the exit status is 42; this is not yet a whole-site generator.
(defn main [] :i64
 (let [command (typed-cap-call :cli/args :string :string "0")]
  (cond (string=? command "sitemap") (sitemap/main)
        (or (string=? command "infra") (string=? command "security")) (article/main)
        :else 7)))
