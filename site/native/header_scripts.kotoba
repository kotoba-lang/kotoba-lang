(ns site.native.header-scripts (:export [theme-script menu-script chart-script])
 (:require [site.native.source-concat :as concat] [multiformats.sha256 :as sha]))
;; Extract only the pinned source forms for the static header controls.
;; The scanner rejects arbitrary expressions; this is not a CLJK runtime.
(defn- pin? [s :string expected :string] :bool
 (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) expected))
(defn- tail [s :string anchor :string] [:option :string]
 (let [i (string-index-of s anchor)]
  (if (< i 0) (option-none-of [:option :string])
   (option-some-of [:option :string] (string-substring s (+ i (string-byte-length anchor)) (string-byte-length s))))))
(defn- strip-once [s :string target :string] [:option :string]
 (let [i (string-index-of s target)]
  (if (< i 0) (option-none-of [:option :string])
   (let [after (+ i (string-byte-length target)) right (string-substring s after (string-byte-length s))]
    (if (>= (string-index-of right target) 0) (option-none-of [:option :string])
     (option-some-of [:option :string] (string-concat (string-substring s 0 i) right)))))))
(defn theme-script [generator :string theme-source :string] [:option :string]
 (if (not (and (pin? generator "dddecd7afa03bc7ab4a8ac74d9162ce4265e058074143efa478f6a0cf76c9b94") (pin? theme-source "4f6a44a9b90ba83719530677c324ea638fbe25da267d0e37213e23e594a7e917"))) (option-none-of [:option :string])
  (let [rest (tail theme-source "(def script\n")]
   (if (not (option-some?-of [:option :string] rest)) (option-none-of [:option :string])
    (let [raw (concat/extract (option-value-of [:option :string] rest "") "  (str " "" "" false)]
     (if (not (option-some?-of [:option :string] raw)) (option-none-of [:option :string])
      (strip-once (option-value-of [:option :string] raw "") "b.setAttribute('aria-label',ja?(d?'ダークモード、オン':'ダークモード、オフ'):(d?'Dark mode, on':'Dark mode, off'));")))))))
(defn menu-script [generator :string behavior :string] [:option :string]
 (if (not (and (pin? generator "dddecd7afa03bc7ab4a8ac74d9162ce4265e058074143efa478f6a0cf76c9b94")
               (pin? behavior "750156834e1af6c89f4b80eeb144fc4746638cf2e2822324a2e556d15e7b12bb"))) (option-none-of [:option :string])
  (let [prefix (concat/literal behavior "(def language-selector-script\n  ")
        rest (tail generator "(def menu-js\n")]
   (if (and (option-some?-of [:option :string] prefix) (option-some?-of [:option :string] rest))
    (let [suffix (concat/extract (option-value-of [:option :string] rest "") "(str behavior/language-selector-script" "" "" false)]
     (if (option-some?-of [:option :string] suffix)
      (option-some-of [:option :string] (string-concat (option-value-of [:option :string] prefix "") (option-value-of [:option :string] suffix "")))
      (option-none-of [:option :string]))) (option-none-of [:option :string])))))

(defn chart-script [generator :string] [:option :string]
 (if (not (pin? generator "dddecd7afa03bc7ab4a8ac74d9162ce4265e058074143efa478f6a0cf76c9b94")) (option-none-of [:option :string])
  (let [rest (tail generator "(def chart-anim-head-js\n")]
   (if (option-some?-of [:option :string] rest)
    (concat/extract (option-value-of [:option :string] rest "") "  (str " "" "" false)
    (option-none-of [:option :string])))))
