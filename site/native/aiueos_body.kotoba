(ns site.native.aiueos-body (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.input :as input] [site.native.source-concat :as source] [site.native.header :as header] [site.native.footer :as footer]
 [site.native.locale-catalog :as catalog] [html-hiccup :as html] [components :as dds] [button :as button] [multiformats.sha256 :as sha]))
;; Bounded source interpreter for the two authored AIUEOS pages. Unknown forms
;; fail closed. Release sizes, URLs and digests come from the pinned authority.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- at [d :document i :i64] :document (val (document-list-at d i)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- field [d :document k :keyword] :document (if (= (document-kind d) :map) (val (document-get d k)) (document-null)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- number [d :document] :i64 (option-value-of [:option :i64] (document-i64-value d) 0))
(defn- bool [d :document] :bool (option-value-of [:option :bool] (document-bool-value d) false))
(defn- read [p :string] :string (input/read p))
(defn- null [] :document (document-null))
(defn- present? [d :document] :bool (not (= (document-kind d) :null)))
(defn- hash? [s :string h :string] :bool (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) h)))
(defn- children [d :document i :i64 out :document env :document list? :bool] :document
 (if (>= i (document-count d)) out
  (let [v (evaluate (if list? (at d i) (item d i)) env)]
   (if (present? v) (children d (+ i 1) (document-vector-conj out v) env list?) (null)))))
(defn- mappings [d :document i :i64 out :document env :document] :document
 (if (>= i (document-count d)) out
  (let [entry (val (document-map-entry-at d i)) key (item entry 0) v (evaluate (item entry 1) env)]
   (if (and (= (document-kind key) :keyword) (present? v))
    (mappings d (+ i 1) (document-assoc out (option-value-of [:option :keyword] (document-keyword-value key) :invalid) v) env) (null)))))
(defn- join [d :document i :i64 out :string env :document] :document
 (if (>= i (document-count d)) (document-string out)
  (let [v (evaluate (at d i) env) k (document-kind v)]
   (if (or (= k :string) (= k :i64)) (join d (+ i 1) (string-concat out (if (= k :i64) (string-from-i64 (number v)) (text v))) env) (null)))))
(defn- cards [xs :document i :i64 env :document out :document] :document
 (if (>= i (document-count xs)) out
  (let [node (evaluate (field env :card) (document-assoc env :d (item xs i)))]
   (if (present? node) (cards xs (+ i 1) env (document-vector-conj out node)) (null)))))
(defn- call [d :document env :document] :document
 (let [head (at d 0) name (document-edn-print head) n (document-count d)]
  (cond
   (= (document-kind head) :keyword)
    (if (= n 2) (field (evaluate (at d 1) env) (option-value-of [:option :keyword] (document-keyword-value head) :invalid)) (null))
   (string=? name "if") (if (bool (evaluate (at d 1) env)) (evaluate (at d 2) env) (evaluate (at d 3) env))
   (string=? name "=") (document-bool (string=? (text (evaluate (at d 1) env)) (text (evaluate (at d 2) env))))
   (string=? name "str") (join d 1 "" env)
   (string=? name "subs") (let [s (text (evaluate (at d 1) env)) a (number (evaluate (at d 2) env)) b (number (evaluate (at d 3) env))]
    (if (and (>= a 0) (>= b a) (<= b (string-byte-length s))) (document-string (string-substring s a b)) (null)))
   (string=? name "url") (document-string (string-concat (text (field (field env :release) :base-url)) (text (evaluate (at d 1) env))))
   (string=? name "mib") (let [v (number (evaluate (at d 1) env)) rounded (quot (+ (* v 10) 524288) 1048576) whole (quot rounded 10) decimal (rem rounded 10)]
    (document-string (string-concat (string-from-i64 whole) (string-concat (if (= decimal 0) "" (string-concat "." (string-from-i64 decimal))) " MiB"))))
   (string=? name "for") (cards (field (field env :release) :distributions) 0 env (document-vector))
   (string=? name "aiueos-dist-card") (evaluate (field env :card) (document-assoc env :d (evaluate (at d 2) env)))
   (string=? name "dds/button")
    (let [label (evaluate (at d 1) env) opts (evaluate (at d 2) env)]
     (if (and (present? label) (present? opts))
      (val (button/node (record-new [:ref :btn/opts] (if (= (document-kind (field opts :type)) :keyword) "outline" "solid-fill") (text (field opts :size)) (text (field opts :href)) "" "" false false (document-vector)) label (document-map))) (null)))
   (string=? name "dds/heading") (let [label (evaluate (at d 2) env) opts (evaluate (at d 3) env)]
    (if (and (present? label) (present? opts)) (dds/heading-node (number (at d 1)) label (text (field opts :size)) "") (null)))
   (string=? name "dds/section") (let [opts (evaluate (at d 1) env)]
    (if (present? opts) (children d 2 (document-vector (document-keyword :section) (document-map :class (document-string "dds-ext-section") :id (field opts :id)) (dds/heading-node 2 (field opts :title) "32" "")) env true) (null)))
   (string=? name "dds/grid") (let [opts (evaluate (at d 1) env)]
    (if (present? opts) (children d 2 (document-vector (document-keyword :div) (document-map :class (document-string "dds-ext-grid") :style (document-map :--dds-ext-grid-min (field opts :min)))) env true) (null)))
   (string=? name "card") (children d 1 (document-vector (document-keyword :div) (document-map :class (document-string "dds-ext-card"))) env true)
   (string=? name "caption") (children d 1 (document-vector (document-keyword :p) (document-map :class (document-string "kot-muted kot-caption"))) env true)
   (string=? name "code") (children d 1 (document-vector (document-keyword :code) (document-map :class (document-string "kot-code"))) env true)
   (string=? name "external-link") (let [href (evaluate (at d 1) env) label (evaluate (at d 2) env)]
    (if (and (present? href) (present? label)) (document-vector (document-keyword :a) (document-map :class (document-string "kot-link") :href href :rel (document-string "noreferrer")) label) (null)))
   (string=? name "dds/chip-label") (let [label (evaluate (at d 1) env)]
    (if (present? label) (document-vector (document-keyword :span) (document-map :class (document-string "dads-chip-label") :data-style (document-string "text") :data-color (document-string "blue")) label) (null)))
   (string=? name "bullets") (let [xs (evaluate (at d 1) env)]
    (if (not (= (document-kind xs) :vector)) (null)
     (loop [i 0 out (document-vector (document-keyword :ul) (document-map :class (document-string "kot-list")))]
      (if (>= i (document-count xs)) out (recur (+ i 1) (document-vector-conj out (document-vector (document-keyword :li) (item xs i))))))))
   :else (null))))
(defn evaluate [d :document env :document] :document
 (let [kind (document-kind d) s (if (= kind :symbol) (document-edn-print d) "")]
  (cond (= kind :vector) (children d 0 (document-vector) env false)
        (= kind :map) (mappings d 0 (document-map) env)
        (= kind :list) (call d env)
        (= kind :symbol) (cond (string=? s "ja?") (field env :ja) (string=? s "root") (field env :root)
          (string=? s "tag") (field (field env :release) :tag) (string=? s "aiueos-release") (field env :release)
          (string=? s "d") (field env :d)
          :else (field (field env :d) (cond (string=? s "id") :id (string=? s "name") :name (string=? s "base") :base (string=? s "iso") :iso (string=? s "disk") :disk (string=? s "receipt") :receipt :else :invalid)))
        (or (= kind :string) (= kind :keyword) (= kind :bool) (= kind :i64)) d :else (null))))
(defn- emit [s :string] :bool (let [ignored (typed-cap-call :io/write :string :string s)] true))
(defn- render [d :document env :document] :bool
 (let [node (evaluate d env) r (if (present? node) (html/render node 0) (option-none-of [:option :string]))]
  (if (option-some?-of [:option :string] r) (emit (option-value-of [:option :string] r "")) false)))
(defn- sections [d :document i :i64 env :document] :bool
 (if (>= i (document-count d)) true (if (arena-scope (render (at d i) env)) (sections d (+ i 1) env) false)))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0") ja (string=? tag "ja") generator (read "/generator.cljk") authority (read "/aiueos-release.edn")
       valid (and (or ja (string=? tag "en")) (hash? generator "ca2955ee08ec6891787d7636238b1bc7b0ab64b807c4c8ce653ec03657d6c072") (hash? authority "da84793dabbbf4748227f6585f64f7f92cf6f846dbe969ab2176730b47274127"))
       view (if valid (val (source/data generator "tag (:tag aiueos-release)]" 91 93)) (null))
       card (if valid (val (source/data generator "(let [url (fn [file] (str (:base-url aiueos-release) file))]" 40 41)) (null))
       env (document-map :ja (document-bool ja) :root (document-string (if ja "../../" "../")) :release (if valid (document-edn-read authority) (null)) :card card)
       content (if (= (document-kind view) :vector) (item (item view 3) 2) (null))]
  (if (not (and valid (= (document-kind content) :list) (present? card))) 7
   (match-option (catalog/open-catalog (read (string-concat "/site/i18n/" (string-concat tag ".json")))) [:option [:ref :site/catalog]]
    (none 7)
    (some state
     (let [h (header/render-header state "en" "/aiueos/" false) f (footer/render-footer state tag "/aiueos/" ja (if ja "../../legal/" "../legal/") true "site/native/aiueos_body.kotoba")]
      (if (and (option-some?-of [:option :string] h) (option-some?-of [:option :string] f)
        (emit "<body><div>") (arena-scope (render (item view 1) env)) (emit (option-value-of [:option :string] h ""))
        (emit "<main id=\"main\"><div class=\"dds-ext-container\">") (sections content 1 env)
        (emit "</div></main>") (emit (option-value-of [:option :string] f "")) (emit "</div></body>")) 42 7))))))
)
