(ns site.native.home-benchmark-domains (:export [render])
 (:require [json.core :as json] [site.native.locale-tree :as tree]
           [multiformats.sha256 :as sha] [html-hiccup :as html] [table :as table]))
;; Two workload-domain measurement tables; the other benchmark output is separate.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- field [d :document k :string] :document (val (document-get d (document-string k))))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- num [d :document] :string
 (let [k (document-kind d) s (document-edn-print d) n (string-byte-length s)]
  (if (or (= k :i64) (= k :f64))
   (if (and (= k :f64) (>= n 2) (string=? (string-substring s (- n 2) n) ".0")) (string-substring s 0 (- n 2)) s) "")))
(defn- stage [d :document] [:option :document]
 (let [status (field d "status") s (text status) n (num (field d "medianMilliseconds"))]
  (cond (not (= (document-kind status) :string)) (option-none-of [:option :document])
        (string=? s "measured") (if (string=? n "") (option-none-of [:option :document]) (option-some-of [:option :document] (document-string (string-concat n " ms"))))
        :else (option-some-of [:option :document] (document-string "N/A")))))
(defn- cell [i :i64 v :document] :document (val (table/body-cell-node (record-new [:ref :tbl/cell] true i) v)))
(defn- row [d :document kind :string] [:option :document]
 (let [label (field d "label") data (field d kind)
       a (stage (field data "string")) b (stage (field data "collection")) c (stage (field data "allocation"))
       e (stage (field data "io")) f (stage (field data "concurrency")) g (stage (field data "realApp"))]
  (if (or (not (= (document-kind label) :string))
          (not (option-some?-of [:option :document] a)) (not (option-some?-of [:option :document] b)) (not (option-some?-of [:option :document] c))
          (not (option-some?-of [:option :document] e)) (not (option-some?-of [:option :document] f)) (not (option-some?-of [:option :document] g)))
   (option-none-of [:option :document])
   (option-some-of [:option :document] (document-vector (document-keyword :tr) (cell 0 label)
     (cell 1 (val a)) (cell 2 (val b)) (cell 3 (val c)) (cell 4 (val e)) (cell 5 (val f)) (cell 6 (val g)))))))
(defn- rows [tools :document kind :string i :i64 out :document] [:option :document]
 (if (>= i (document-count tools)) (option-some-of [:option :document] out)
  (let [r (row (item tools i) kind)]
   (if (not (option-some?-of [:option :document] r)) (option-none-of [:option :document])
    (rows tools kind (+ i 1) (document-vector-conj out (val r)))))))
(defn render [state [:ref :site/catalog] tag :string generator :string report :string mode :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "ca2955ee08ec6891787d7636238b1bc7b0ab64b807c4c8ce653ec03657d6c072"))
       r-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 report))) "4f396299dc966a750cd82e24ef6a930209649b7b4655043a3e64fc91951c9208"))
       cold? (string=? mode "cold") amortized? (string=? mode "amortized")]
  (if (or (not g-ok) (not r-ok) (not (or cold? amortized?))) (option-none-of [:option :string])
   (let [decoded (json/decode report) d (result-value-of [:result :document :document] decoded (document-null))
         tools (field d "tools") body (if (= (document-kind tools) :vector) (rows tools (if cold? "results" "amortizedResults") 0 (document-vector (document-keyword :tbody))) (option-none-of [:option :document]))]
    (if (or (not (result-ok?-of [:result :document :document] decoded)) (not (option-some?-of [:option :document] body))) (option-none-of [:option :string])
     (let [caption (if cold? "Process-cold workload-domain medians; N/A means the target contract does not provide that capability" "Amortized in-process batch medians per base workload; N/A keeps the same capability boundary")
           node (document-vector (document-keyword :div) (document-map :class (document-string "kot-table-scroll"))
            (document-vector (document-keyword :div) (document-map :class (document-string "dads-table"))
             (document-vector (document-keyword :table) (document-map :class (document-string "dads-table__table"))
              (document-vector (document-keyword :caption) (document-string caption))
              (document-vector (document-keyword :thead) (document-vector (document-keyword :tr)
               (table/header-cell-node (document-string "Runtime path") false) (table/header-cell-node (document-string "String") false)
               (table/header-cell-node (document-string "Collection") false) (table/header-cell-node (document-string "Allocation") false)
               (table/header-cell-node (document-string "File I/O") false) (table/header-cell-node (document-string "Concurrency") false)
               (table/header-cell-node (document-string "Real app") false))) (val body))))
           localized (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))]
      (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (option-none-of [:option :string]))))))))
