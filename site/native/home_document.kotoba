(ns site.native.home-document (:export [compose])
 (:require [multiformats.sha256 :as sha]))
;; Integrity relative to the supplied trusted build manifest, not authentication.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- field [d :document k :keyword] :string (option-value-of [:option :string] (document-string-value (val (document-get d k))) ""))
(defn- hash? [s :string h :string] :bool (and (= (string-byte-length h) 64) (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) h))))
(defn- locale? [tag :string] :bool
 (or (string=? tag "en") (string=? tag "ar") (string=? tag "arz") (string=? tag "bn") (string=? tag "de") (string=? tag "es")
     (string=? tag "fr") (string=? tag "hi") (string=? tag "id") (string=? tag "ja") (string=? tag "ko") (string=? tag "mr")
     (string=? tag "pcm") (string=? tag "pt") (string=? tag "ru") (string=? tag "ur") (string=? tag "zh-Hans")))
(defn- begins? [s :string prefix :string] :bool
 (and (>= (string-byte-length s) (string-byte-length prefix)) (string=? (string-substring s 0 (string-byte-length prefix)) prefix)))
(defn- ends? [s :string suffix :string] :bool
 (let [n (string-byte-length s) m (string-byte-length suffix)] (and (>= n m) (string=? (string-substring s (- n m) n) suffix))))
(defn compose [tag :string manifest :string head :string body :string] [:option :string]
 (let [m (document-edn-read manifest)]
  (if (or (not (locale? tag)) (not (= (document-kind m) :map)) (not (string=? (field m :tag) tag))
          (not (hash? head (field m :head))) (not (hash? body (field m :body)))
          (not (begins? head "<head>")) (not (ends? head "</head>"))
          (not (begins? body "<body>")) (not (ends? body "</body>"))
          (>= (string-index-of body "KOTOBA_") 0)) (option-none-of [:option :string])
   (let [rtl (or (string=? tag "ar") (string=? tag "arz") (string=? tag "ur"))
         prefix (string-concat "<!DOCTYPE html>\n<html lang=\"" (string-concat tag (if rtl "\" dir=\"rtl\">" "\">")))]
    (option-some-of [:option :string] (string-concat prefix (string-concat head (string-concat body "</html>"))))))))
