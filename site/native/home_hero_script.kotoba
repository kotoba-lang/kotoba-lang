(ns site.native.home-hero-script (:export [script])
 (:require [site.native.home-hero-svg :as hero] [site.native.source-concat :as source]))
(defn- i [source :string name :string] :i64
 (let [anchor (string-concat "(def " (string-concat name " ")) start (string-index-of source anchor)]
  (if (< start 0) -1
   (let [from (+ start (string-byte-length anchor)) tail (string-substring source from (string-byte-length source)) end (string-index-of tail ")")]
    (if (< end 0) -1 (option-value-of [:option :i64] (document-i64-value (document-edn-read (string-substring tail 0 end))) -1))))))

;; Preserve source numeric literals as the host formatter would print them.
(defn- numeric-text [s :string name :string] :string
 (let [anchor (string-concat "(def " (string-concat name " ")) start (string-index-of s anchor)]
  (if (< start 0) ""
   (let [from (+ start (string-byte-length anchor)) tail (string-substring s from (string-byte-length s)) end (string-index-of tail ")")]
    (if (< end 0) ""
     (let [raw (string-substring tail 0 end) dot (string-index-of raw ".") n (string-byte-length raw)]
      (if (< dot 0) raw
       (loop [k n]
        (if (and (> k (+ dot 1)) (= (string-code-point-at raw (- k 1)) 48)) (recur (- k 1)) (string-substring raw 0 (if (= k (+ dot 1)) dot k)))))))))))
(defn script [generator :string hero :string] [:option :string]
 (let [p (hero/points generator hero) fx (numeric-text hero "drift-freq-x") fy (numeric-text hero "drift-freq-y") alpha (numeric-text hero "alpha-max")
       tail (source/hero-tail generator fx fy alpha) count (+ (i hero "stroke-count") (+ (* (i hero "claw-count") (i hero "claw-samples")) (i hero "core-count")))]
  (if (or (not (option-some?-of [:option :string] p)) (not (option-some?-of [:option :string] tail)) (= count 0)
          (string=? fx "") (string=? fy "") (string=? alpha "")) (option-none-of [:option :string])
   (option-some-of [:option :string]
    (string-concat "var P=new Uint8Array([" (string-concat (option-value-of [:option :string] p "")
     (string-concat "]),N=" (string-concat (string-from-i64 count)
      (string-concat ",FP=" (string-concat (numeric-text hero "hero-fps")
       (string-concat ",DUR=" (string-concat (numeric-text hero "hero-duration-seconds")
        (string-concat ",AX=" (string-concat (numeric-text hero "drift-amplitude-x")
         (string-concat ",AY=" (string-concat (numeric-text hero "drift-amplitude-y")
          (string-concat ",FX=" (string-concat fx (string-concat ",FY=" (string-concat fy
           (string-concat ",AMAX=" (string-concat alpha (string-concat ";" (option-value-of [:option :string] tail ""))))))))))))))))))))))))
