(ns site.native.input (:export [request-path read]) (:capabilities [:fs/app-data]))

;; macOS FD3 requires the original logical absolute spelling. The Linux
;; build explicitly selects input_linux.kotoba for this same module contract.
;; This is a build profile choice, never a retry/fallback after a refusal.
(defn request-path [path :string] :string path)
(defn read [path :string] :string
  (typed-cap-call :fs/app-data :string :string (request-path path)))
