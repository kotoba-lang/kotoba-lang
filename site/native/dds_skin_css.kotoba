(ns site.native.dds-skin-css (:export [skin])
 (:require [site.native.dds-bridge-css :as bridge] [site.native.source-concat :as src] [css-sheet :as css]))
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- selector [d :document] [:option :string]
 (if (= (document-kind d) :string) (document-string-value d)
  (if (not (= (document-kind d) :list)) (none)
   (let [head (val (document-list-at d 0))]
    (if (or (not (= (document-kind head) :symbol)) (not (string=? (document-edn-print head) "str"))) (none)
     (loop [i 1 out ""]
      (if (>= i (document-count d)) (option-some-of [:option :string] out)
       (let [x (val (document-list-at d i))]
        (if (not (= (document-kind x) :string)) (none)
         (recur (+ i 1) (string-concat out (option-value-of [:option :string] (document-string-value x) ""))))))))))))
(defn- rules [xs :document] [:option :string]
 (if (not (and (= (document-kind xs) :vector) (= (document-count xs) 3))) (none)
  (loop [i 0 out ""]
   (if (>= i 3) (option-some-of [:option :string] out)
    (let [r (val (document-vector-at xs i)) select (selector (val (document-vector-at r 0))) declarations (val (document-vector-at r 1))
          rendered (if (option-some?-of [:option :string] select)
                    (css/rule (document-vector (document-string (option-value-of [:option :string] select "")) declarations)) (none))]
     (if (not (option-some?-of [:option :string] rendered)) (none)
      (recur (+ i 1) (string-concat out (string-concat (if (= i 0) "" "\n") (option-value-of [:option :string] rendered ""))))))))))
(defn skin [source :string] [:option :string]
 (let [b (bridge/bridge source) a (string-index-of source "(def a11y-css") z (string-index-of source "(def skin-css")]
  (if (or (not (option-some?-of [:option :string] b)) (< a 0) (<= z a)) (none)
   (let [d (src/data (string-substring source a z) ":rules" 91 93)]
    (if (not (option-some?-of [:option :document] d)) (none)
     (let [r (rules (option-value-of [:option :document] d (document-null)))]
      (if (option-some?-of [:option :string] r)
       (option-some-of [:option :string] (string-concat (option-value-of [:option :string] b "") (option-value-of [:option :string] r ""))) (none))))))))
