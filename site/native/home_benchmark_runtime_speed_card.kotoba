(ns site.native.home-benchmark-runtime-speed-card (:export [render])
 (:require [json.core :as json] [site.native.source-concat :as source] [site.native.home-section :as section]
           [site.native.locale-tree :as tree] [multiformats.sha256 :as sha] [html-hiccup :as html]))
;; Preserve the bounded per-pair results and unqualified fastest claim.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- field [d :document k :string] :document (if (= (document-kind d) :map) (val (document-get d (document-string k))) (document-null)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- arg [d :document i :i64] :document (val (document-list-at d i)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- none [] [:option :document] (option-none-of [:option :document]))
(defn- some [d :document] [:option :document] (option-some-of [:option :document] d))
(defn- num [d :document] :string
 (let [k (document-kind d) s (document-edn-print d) n (string-byte-length s)]
  (if (or (= k :i64) (= k :f64)) (if (and (= k :f64) (>= n 2) (string=? (string-substring s (- n 2) n) ".0")) (string-substring s 0 (- n 2)) s) "")))
(defn- get-value [s :string report :document] :document
 (let [score (field report "score") range (field score "observedRange") date (text (field report "generatedAt")) unwinnable (field (field report "provenUnwinnablePairs") "pairs")]
  (cond (string=? s "(:qualifiedPairs runtime-score)") (field score "qualifiedPairs")
        (string=? s "(:totalPairs runtime-score)") (field score "totalPairs")
        (string=? s "(:stableQualifiedPairs runtime-score)") (field score "stableQualifiedPairs")
        (string=? s "(first (:observedRange runtime-score))") (item range 0)
        (string=? s "(last (:observedRange runtime-score))") (item range (- (document-count range) 1))
        (string=? s "(count unwinnable)") (document-i64 (document-count unwinnable))
        (string=? s "runs") (field score "runs")
        (string=? s "runtime-date") (if (>= (string-byte-length date) 10) (document-string (string-substring date 0 10)) (document-null))
        :else (document-null))))
(defn- fixed3 [d :document] :string
 (let [x (option-value-of [:option :f64] (document-f64-value d) -1.0)
       n (f64-to-i64-truncating (f64-add (f64-mul x 1000.0) 0.5)) whole (quot n 1000) frac (rem n 1000)]
  (if (or (f64-lt x 0.0) (f64-gt x 1.0)) ""
   (string-concat (string-from-i64 whole) (string-concat "." (string-concat (if (< frac 100) "0" "") (string-concat (if (< frac 10) "0" "") (string-from-i64 frac))))))))
(defn- busy-values [samples :document i :i64 out :string] :string
 (if (>= i (document-count samples)) out
  (let [value (fixed3 (field (item samples i) "busyCpuFraction"))]
   (if (string=? value "") "" (busy-values samples (+ i 1) (string-concat out (string-concat (if (= i 0) "" " → ") value)))))))
(defn- replace-range [s :string first :string last :string new :string] [:option :string]
 (let [p (string-index-of s first) tail (if (< p 0) "" (string-substring s p (string-byte-length s))) q (string-index-of tail last)]
  (if (or (< p 0) (< q 0)) (option-none-of [:option :string])
   (option-some-of [:option :string] (string-concat (string-substring s 0 p) (string-concat new (string-substring tail (+ q (string-byte-length last)) (string-byte-length tail))))))))
(defn- list-build [d :document report :document i :i64 out :string] [:option :document]
 (if (>= i (document-count d)) (some (document-edn-read (string-concat out ")")))
  (let [v (transform (arg d i) report)]
   (if (option-some?-of [:option :document] v) (list-build d report (+ i 1) (string-concat out (string-concat (if (= i 0) "" " ") (document-edn-print (val v))))) (none)))))
(defn- vector-build [d :document report :document i :i64 out :document] [:option :document]
 (if (>= i (document-count d)) (some out)
  (let [v (transform (item d i) report)]
   (if (option-some?-of [:option :document] v) (vector-build d report (+ i 1) (document-vector-conj out (val v))) (none)))))
(defn- str-build [d :document report :document i :i64 out :string] [:option :document]
 (if (>= i (document-count d)) (some (document-string out))
  (let [v (transform (arg d i) report) x (val v) k (document-kind x)]
   (if (and (option-some?-of [:option :document] v) (or (= k :string) (= k :i64) (= k :f64)))
    (str-build d report (+ i 1) (string-concat out (if (= k :string) (text x) (num x)))) (none)))))
(defn- transform [d :document report :document] [:option :document]
 (let [k (document-kind d) spelling (document-edn-print d) value (get-value spelling report)]
  (cond (not (= (document-kind value) :null)) (some value)
        (= k :symbol) (some d)
        (= k :vector) (vector-build d report 0 (document-vector))
        (= k :list)
         (let [head (document-edn-print (arg d 0)) binder (if (string=? head "when-let") (document-edn-print (item (arg d 1) 0)) "")]
          (cond (string=? head "str") (str-build d report 1 "")
                (string=? head "when-not") (if (string=? (document-edn-print (arg d 1)) "(:fastestClaimQualified speed)") (some (arg d 2)) (none))
                (string=? head "when-let") (if (or (string=? binder "unwinnable") (string=? binder "runs")) (transform (arg d 2) report) (none))
                (string=? head "when") (if (string=? (document-edn-print (arg d 1)) "(> runs 1)") (transform (arg d 2) report) (none))
                :else (list-build d report 0 "(")))
        (or (= k :string) (= k :i64) (= k :f64) (= k :keyword) (= k :map)) (some d)
        :else (none))))
(defn render [state [:ref :site/catalog] tag :string generator :string report :string] [:option :string]
 (let [g-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "5bb0ff5d9e2f80ca7a76545ead6d0138ab7516f2bb712dd4f059d8b0bb4f5ab2"))
       r-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 report))) "33f6e504389f03f0d3f5f91a68d157f83a86a5366acf21311e6b7494783effe9"))]
  (if (or (not g-ok) (not r-ok)) (option-none-of [:option :string])
   (let [decoded (json/decode report) data (result-value-of [:result :document :document] decoded (document-null)) speed (field data "speedQualification") score (field data "score")
         qualified (field speed "fastestClaimQualified") runs (field score "runs") samples (field speed "quietGateSamples") unwinnable (field (field data "provenUnwinnablePairs") "pairs")
         busy (busy-values samples 0 "")
         pos (string-index-of generator "(card (dds/chip-label (str \"RUNTIME SPEED · \"")
         tail (if (< pos 0) "" (string-substring generator pos (string-byte-length generator)))
         clean (replace-range tail "(str/join \" → \" (map #(.toFixed" "(:quietGateSamples speed)))" (document-edn-print (document-string busy)))
         parsed (if (option-some?-of [:option :string] clean) (source/data (string-concat "~FORM~" (option-value-of [:option :string] clean "")) "~FORM~" 40 41) (option-none-of [:option :document]))
         prepared (if (option-some?-of [:option :document] parsed) (transform (val parsed) data) (none))
         node (if (option-some?-of [:option :document] prepared) (section/evaluate (val prepared)) (none))
         local (if (and (option-some?-of [:option :document] node) (not (string=? tag "en"))) (tree/map-indexed state (val node)) node)]
    (if (or (not (result-ok?-of [:result :document :document] decoded)) (not (= (document-kind qualified) :bool))
            (option-value-of [:option :bool] (document-bool-value qualified) true)
            (<= (option-value-of [:option :i64] (document-i64-value runs) -1) 1) (not (= (document-count samples) 3)) (not (= (document-count unwinnable) 2)) (string=? busy "") (not (option-some?-of [:option :string] clean)) (< pos 0)
            (not (option-some?-of [:option :document] local))) (option-none-of [:option :string])
     (html/render (val local) 0))))))
