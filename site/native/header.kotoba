(ns site.native.header (:export [render-header])
 (:require [site.native.header-inline :as inline] [site.native.header-menu :as menu]
           [site.native.header-theme :as theme] [site.native.header-selector :as selector]
           [site.native.locale-tree :as tree] [site.native.locale-rebase :as rebase]
           [html-hiccup :as html] [button :as button]))
;; Complete source-driven header, streamed because its nested selector exceeds
;; the native document depth bound. User-facing dynamic values stay in nodes.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
  (some (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (none)))
(defn- localized [state [:ref :site/catalog] tag :string base :string node :document] [:option :string]
 (let [mapped (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))]
  (if (option-some?-of [:option :document] mapped)
   (let [rebased (if (string=? tag "en") mapped (rebase/rebase-links (val mapped) tag base))]
    (if (option-some?-of [:option :document] rebased) (html/render (val rebased) 0) (none))) (none))))
(defn- wordmark [home :bool] :document
 (let [root (if home "" "/")]
  (document-vector (document-keyword :a) (document-map :class (document-string "kot-wordmark") :href (document-string (string-concat root "#top")) :aria-label (document-string "Kotoba home"))
   (document-vector (document-keyword :span) (document-map :class (document-string "kot-paren") :aria-hidden (document-string "true")) (document-string "("))
   (document-vector (document-keyword :img) (document-map :class (document-string "kot-logo") :src (document-string (string-concat root "kotoba-wordmark.png")) :width (document-i64 480) :height (document-i64 68) :alt (document-string "Kotoba")))
   (document-vector (document-keyword :span) (document-map :class (document-string "kot-paren") :aria-hidden (document-string "true")) (document-string ")")))))
(defn- github [] [:option :document]
 (button/node (record-new [:ref :btn/opts] "outline" "sm" "https://github.com/kotoba-lang/kotoba-lang" "" "" false false (document-vector))
  (document-string "GitHub") (document-map :id (document-string "kot-gh"))))
(defn- nav-open [state [:ref :site/catalog] tag :string base :string] [:option :string]
 (let [full (localized state tag base (document-vector (document-keyword :nav) (document-map :class (document-string "kot-nav") :aria-label (document-string "Primary"))))]
  (if (option-some?-of [:option :string] full)
   (let [v (option-value-of [:option :string] full "") n (string-byte-length v)]
    (if (>= n 6) (some (string-substring v 0 (- n 6))) (none))) (none))))
(defn render-header [state [:ref :site/catalog] tag :string base :string home :bool] [:option :string]
 (let [edge "<svg class=\"kot-lisp-nest\" viewBox=\"0 0 84 76\" aria-hidden=\"true\" focusable=\"false\" preserveAspectRatio=\"xMaxYMid meet\"><path d=\"M22 9 C7 27 7 49 22 67\" opacity=\"0.95\"></path><path d=\"M38 9 C23 27 23 49 38 67\" opacity=\"0.77\"></path><path d=\"M54 9 C39 27 39 49 54 67\" opacity=\"0.59\"></path><path d=\"M70 9 C55 27 55 49 70 67\" opacity=\"0.41\"></path></svg>"
       start (some (string-concat "<header class=\"kot-header\"><div class=\"kot-lisp-edge\" data-side=\"start\">" (string-concat edge (string-concat "</div><div class=\"kot-lisp-edge\" data-side=\"end\">" (string-concat edge "</div><div class=\"dds-ext-container\"><div class=\"kot-header__inner\">")))))
       mark (localized state tag base (wordmark home))
       a (append start mark) b (append a (nav-open state tag base))
       c (append b (inline/render-inline state tag base home)) gh (github)
       d (if (option-some?-of [:option :document] gh) (append c (localized state tag base (val gh))) (none))
       e (append d (menu/render-menu state tag base home)) f (append e (selector/render-selector tag base))
       g (append f (theme/render-theme state tag))]
  (append g (some "</nav></div></div></header>"))))
