(ns site.native.home-start (:export [render])
 (:require [site.native.source-concat :as source] [site.native.locale-tree :as tree]
           [site.native.locale-rebase :as rebase] [site.native.locale-mark :as mark]
           [multiformats.sha256 :as sha] [html-hiccup :as html]
           [components :as dds] [button :as button] [language-selector :as selector]))
;; Bounded native homepage start card. All copy, examples, links and language
;; options come from the pinned source files; the selector is streamed because
;; its complete tree exceeds the document depth limit.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- txt [x :document] :string (option-value-of [:option :string] (document-string-value x) ""))
(defn- field [x :document k :keyword] :string (txt (val (document-get x k))))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
  (some (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (none)))
(defn- fragment [node :document tag :string] [:option :string]
 (html/render (if (string=? tag "en") node (mark/mark-language node tag)) 0))
(defn- rows [langs :document tag :string extra :bool] [:option :string]
 (loop [i 0 out (some "")]
  (if (or (>= i (document-count langs)) (not (option-some?-of [:option :string] out))) out
   (let [d (val (document-vector-at langs i)) code (field d (if extra :lang :tag)) label (field d :label)
         aliases (if extra "" (field d :name)) href (if (string=? code "en") "/#start" (string-concat "/" (string-concat code "/#start")))
         input (document-map :code (document-string code) :label (document-string label) :aliases (document-string aliases) :href (document-string href))
         item (selector/item input "en")]
    (if (and (not (string=? code "")) (not (string=? label "")) (option-some?-of [:option :document] item))
     (recur (+ i 1) (append out (fragment (val item) tag))) (none))))))
(defn- language-nav [tag :string generator :string locales :string] [:option :string]
 (let [required (source/data locales "(def required" 91 93)
       extras (source/data generator "locales/required)\n          " 91 93)]
  (if (or (not (option-some?-of [:option :document] required)) (not (option-some?-of [:option :document] extras))
          (not (= (document-kind (val required)) :vector)) (not (= (document-count (val required)) 17))
          (not (= (document-kind (val extras)) :vector)) (not (= (document-count (val extras)) 2))) (none)
   (let [start (some "<div class=\"dads-language-selector\" data-language-selector translate=\"no\" lang=\"en\" dir=\"ltr\"><div class=\"dads-menu-list-box\">")
         opener (fragment (selector/opener "kot-start-language" "English") tag)
         popup (some "<div id=\"kot-start-language-popup\" class=\"dads-menu-list-box__popup\" data-language-selector-popup hidden>")
         a (append start opener) b (append a popup) c (append b (fragment (selector/search) tag))
         d (append c (fragment (selector/empty) tag)) e (append d (some "<ul class=\"dads-menu-list\" data-language-selector-menu>"))
         f (append e (rows (val required) tag false)) g (append f (rows (val extras) tag true))]
    (append g (some "</ul></div></div></div>"))))))
(defn- link [label :string href :string kind :string] [:option :document]
 (button/node (record-new [:ref :btn/opts] kind "" href "" "" false false (document-vector)) (document-string label) (document-map)))
(defn- code-block [code :string] :document
 (document-vector (document-keyword :pre) (document-map :class (document-string "kot-pre") :dir (document-string "ltr") :style (document-string "text-align: left"))
  (document-vector (document-keyword :code) (document-string code))))
(defn render [state [:ref :site/catalog] tag :string generator :string locales :string] [:option :string]
 (let [generator-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "c69982760682f834d96fd0f20c9dffd1c92681a9ddb1a3687b488117360d5c67"))
       locales-ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 locales))) "ef97ede6b5a4f2bf0d0efc467780b305e1cf54afa5c2800b659f613180bc0aaf"))
       copy (source/data generator "(def start-card-en" 123 125)
       install (source/literal generator "(def start-install-code") program (source/literal generator "(def start-program-code")
       guide (source/literal generator "(def start-getting-started-href") cli (source/literal generator "(def start-cli-reference-href")
       nav (language-nav tag generator locales)]
  (if (or (not generator-ok) (not locales-ok) (not (option-some?-of [:option :document] copy))
          (not (option-some?-of [:option :string] install)) (not (option-some?-of [:option :string] program))
          (not (option-some?-of [:option :string] guide)) (not (option-some?-of [:option :string] cli))
          (not (option-some?-of [:option :string] nav))) (none)
   (let [c (val copy) agent (link (field c :agent) (field c :agent-href) "")
         g (link (field c :guide) (option-value-of [:option :string] guide "") "outline")
         r (link (field c :cli) (option-value-of [:option :string] cli "") "outline")]
    (if (or (not (option-some?-of [:option :document] agent)) (not (option-some?-of [:option :document] g)) (not (option-some?-of [:option :document] r))) (none)
     (let [card1 (document-vector (document-keyword :div) (document-map :class (document-string "dds-ext-card"))
                   (dds/heading-node 3 (document-string (field c :install)) "24" "") (code-block (option-value-of [:option :string] install ""))
                   (document-vector (document-keyword :p) (document-map :class (document-string "kot-muted kot-caption")) (document-string (field c :check-caption))))
           card2 (document-vector (document-keyword :div) (document-map :class (document-string "dds-ext-card"))
                   (dds/heading-node 3 (document-string (field c :program)) "24" "") (code-block (option-value-of [:option :string] program ""))
                   (document-vector (document-keyword :p) (document-string (field c :program-sentence))))
           grid (document-vector (document-keyword :div) (document-map :class (document-string "dds-ext-grid") :style (document-map :--dds-ext-grid-min (document-string "20rem"))) card1 card2)
           actions (document-vector (document-keyword :div) (document-map :class (document-string "kot-actions")) (val agent) (val g) (val r))
           node (document-vector (document-keyword :section) (document-map :class (document-string "dds-ext-section") :id (document-string "start"))
                 (dds/heading-node 2 (document-string (field c :title)) "32" "") (document-string "987654321012") grid actions)
           localized (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))]
      (if (not (option-some?-of [:option :document] localized)) (none)
       (let [rebased (if (string=? tag "en") localized (rebase/rebase-links (val localized) tag "/"))]
        (if (not (option-some?-of [:option :document] rebased)) (none)
         (let [frame (html/render (val rebased) 0) f (option-value-of [:option :string] frame "") marker (string-index-of f "987654321012")]
          (if (or (not (option-some?-of [:option :string] frame)) (< marker 0)) (none)
           (let [tail (string-substring f (+ marker 12) (string-byte-length f))]
            (if (>= (string-index-of tail "987654321012") 0) (none)
             (some (string-concat (string-substring f 0 marker) (string-concat (option-value-of [:option :string] nav "") tail))))))))))))))))
