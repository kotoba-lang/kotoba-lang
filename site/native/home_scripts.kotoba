(ns site.native.home-scripts (:export [extract])
 (:require [site.native.source-concat :as source] [multiformats.sha256 :as sha]))
;; These three complete scripts are pure literal concatenations in the pinned
;; site source. Play and hero have additional source dependencies and are not
;; covered by this extractor.
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- from-def [s :string definition :string] [:option :string]
 (let [start (string-index-of s definition)]
  (if (< start 0) (none)
   (let [tail (string-substring s start (string-byte-length s))]
    (source/extract tail "  (str " "" "" false)))))
(defn extract [generator :string mode :string] [:option :string]
 (if (not (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "dddecd7afa03bc7ab4a8ac74d9162ce4265e058074143efa478f6a0cf76c9b94"))) (none)
  (cond (string=? mode "search") (from-def generator "(def search-js\n")
        (string=? mode "chart") (from-def generator "(def chart-anim-js\n")
        (string=? mode "morph") (from-def generator "(def morph-js\n")
        :else (none))))
