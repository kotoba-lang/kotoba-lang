(ns site.native.home-hero-svg (:export [render points])
 (:require [multiformats.sha256 :as sha]))
;; Compute the fallback geometry from the pinned hero source rather than using
;; generated HTML. Bounded Taylor reduction is checked against the old SVG.
(defn- hash [s :string] :string (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))))
(defn- number [source :string name :string] :document
 (let [anchor (string-concat "(def " (string-concat name " ")) start (string-index-of source anchor)]
  (if (< start 0) (document-null)
   (let [from (+ start (string-byte-length anchor)) tail (string-substring source from (string-byte-length source)) end (string-index-of tail ")")]
    (if (< end 0) (document-null) (document-edn-read (string-substring tail 0 end)))))))
(defn- f [source :string name :string] :f64
 (option-value-of [:option :f64] (document-f64-value (number source name)) -100.0))
(defn- i [source :string name :string] :i64
 (option-value-of [:option :i64] (document-i64-value (number source name)) -1))
(defn- sine [x :f64 pi :f64] :f64
 (let [two-pi (f64-mul 2.0 pi) x1 (if (f64-gt x pi) (f64-sub x two-pi) x)
       x2 (if (f64-lt x1 (f64-neg pi)) (f64-add x1 two-pi) x1)
       xx (f64-neg (f64-mul x2 x2))]
  (loop [n 1 term x2 sum x2]
   (if (> n 11) sum
    (let [denom (i64-to-f64-rounded (* (* 2 n) (+ (* 2 n) 1)))
          next (f64-div (f64-mul term xx) denom)]
     (recur (+ n 1) next (f64-add sum next)))))))
(defn- fixed2 [x :f64] :string
 (let [v (f64-to-i64-truncating (f64-add (f64-mul x 100.0) 0.5)) whole (quot v 100) frac (rem v 100)]
  (string-concat (string-from-i64 whole) (string-concat "." (string-concat (if (< frac 10) "0" "") (string-from-i64 frac))))))
(defn- circle [index :i64 count :i64 pi :f64 gap :f64 ring :f64 lo :f64 hi :f64] :string
 (let [t (f64-div (i64-to-f64-rounded index) (i64-to-f64-rounded (- count 1)))
       angle (f64-add (f64-add (f64-mul 0.5 pi) (f64-div gap 2.0)) (f64-mul t (f64-sub (f64-mul 2.0 pi) gap)))
       env (sine (f64-mul pi t) pi)
       radius (f64-add lo (f64-mul (f64-sub hi lo) env))
       d (f64-add 0.35 (f64-mul 0.65 env)) density (f64-mul d d)
       x (f64-mul (f64-add 0.5 (f64-mul ring (sine (f64-add angle (f64-mul 0.5 pi)) pi))) 200.0)
       y (f64-mul (f64-add 0.5 (f64-mul ring (sine angle pi))) 200.0)
       r (f64-mul 14.0 radius) opacity (f64-add 0.35 (f64-mul 0.65 density))]
  (string-concat "<circle cx=\"" (string-concat (fixed2 x) (string-concat "\" cy=\"" (string-concat (fixed2 y)
   (string-concat "\" r=\"" (string-concat (fixed2 r) (string-concat "\" opacity=\"" (string-concat (fixed2 opacity) "\"></circle>")))))))))
)
(defn render [generator :string hero :string] [:option :string]
 (if (not (and (arena-scope (string=? (hash generator) "81871b1dd41ee5cdb859ff0f5903c1dcc0cc312cefc018f7030468eb1d12108d"))
               (arena-scope (string=? (hash hero) "f324125c00d1135da1432bab4eaec186c56ece61f222329ea7de8cee897693fa")))) (option-none-of [:option :string])
  (let [count (i hero "stroke-count") pi (f hero "pi") gap (f hero "arc-gap-radians") ring (f hero "ring-radius")
        lo (f hero "stroke-radius-min") hi (f hero "stroke-radius-max") step (quot count 36)]
   (if (or (<= count 0) (<= step 0) (f64-le pi 0.0) (f64-le gap 0.0) (f64-le ring 0.0) (f64-le lo 0.0) (f64-le hi 0.0)) (option-none-of [:option :string])
    (loop [index 0 out "<svg viewBox=\"0 0 200 200\" preserveAspectRatio=\"xMidYMid slice\" aria-hidden=\"true\" focusable=\"false\" id=\"kot-hero-fallback\">"]
     (if (>= index count) (option-some-of [:option :string] (string-concat out "</svg>"))
      (recur (+ index step) (string-concat out (circle index count pi gap ring lo hi)))))))))

;; The dynamic point table has stroke, claw and core samples in source order.
(defn- q8 [v :f64] :i64
 (f64-to-i64-truncating (f64-add (f64-mul 255.0 (f64-max 0.0 (f64-min 1.0 v))) 0.5)))
(defn- put4 [v :vector-i64 index :i64 x :f64 y :f64 radius :f64 density :f64] :vector-i64
 (let [v1 (vector-assoc! v index (q8 x)) v2 (vector-assoc! v1 (+ index 1) (q8 y))
       v3 (vector-assoc! v2 (+ index 2) (q8 radius))]
  (vector-assoc! v3 (+ index 3) (q8 density))))
(defn- add-strokes [v :vector-i64 count :i64 pi :f64 gap :f64 ring :f64 lo :f64 hi :f64] :vector-i64
 (loop [index 0 out v]
  (if (>= index count) out
   (let [t (f64-div (i64-to-f64-rounded index) (i64-to-f64-rounded (- count 1)))
         a (f64-add (f64-add (f64-mul 0.5 pi) (f64-div gap 2.0)) (f64-mul t (f64-sub (f64-mul 2.0 pi) gap)))
         env (sine (f64-mul pi t) pi) r (f64-add lo (f64-mul (f64-sub hi lo) env))
         d (f64-add 0.35 (f64-mul 0.65 env)) density (f64-mul d d)
         x (f64-add 0.5 (f64-mul ring (sine (f64-add a (f64-mul 0.5 pi)) pi)))
         y (f64-add 0.5 (f64-mul ring (sine a pi)))]
    (recur (+ index 1) (put4 out (* index 4) x y r density))))))
(defn- add-claws [v :vector-i64 start :i64 claws :i64 samples :i64 pi :f64 gap :f64 base :f64 tip :f64 radius :f64 density :f64] :vector-i64
 (loop [index 0 out v]
  (if (>= index (* claws samples)) out
   (let [j (quot index samples) k (rem index samples)
         u (f64-div (i64-to-f64-rounded j) (i64-to-f64-rounded (- claws 1)))
         a (f64-sub (f64-add (f64-mul 0.5 pi) (f64-div gap 2.0)) (f64-mul u gap))
         step (f64-div (i64-to-f64-rounded k) (i64-to-f64-rounded (- samples 1)))
         dist (f64-add base (f64-mul (f64-sub tip base) step))
         x (f64-add 0.5 (f64-mul dist (sine (f64-add a (f64-mul 0.5 pi)) pi)))
         y (f64-add 0.5 (f64-mul dist (sine a pi)))
         d (f64-mul density (f64-sub 1.0 (f64-mul 0.35 step)))]
    (recur (+ index 1) (put4 out (* (+ start index) 4) x y radius d))))))
(defn- add-core [v :vector-i64 start :i64 count :i64 pi :f64 maximum :f64 radius :f64] :vector-i64
 (loop [index 0 out v]
  (if (>= index count) out
   (let [t (f64-div (f64-add (i64-to-f64-rounded index) 0.5) (i64-to-f64-rounded count))
         a (f64-mul (f64-mul 2.0 pi) t) dist (f64-mul maximum (f64-sqrt t))
         x (f64-add 0.5 (f64-mul dist (sine (f64-add a (f64-mul 0.5 pi)) pi)))
         y (f64-add 0.5 (f64-mul dist (sine a pi)))]
    (recur (+ index 1) (put4 out (* (+ start index) 4) x y radius 1.0))))))
(defn- csv [v :vector-i64] :string
 (loop [index 0 out ""]
  (if (>= index (vector-count v)) out
   (recur (+ index 1) (string-concat out (string-concat (if (= index 0) "" ",") (string-from-i64 (vector-at v index))))))))
(defn points [generator :string hero :string] [:option :string]
 (if (not (and (arena-scope (string=? (hash generator) "81871b1dd41ee5cdb859ff0f5903c1dcc0cc312cefc018f7030468eb1d12108d"))
               (arena-scope (string=? (hash hero) "f324125c00d1135da1432bab4eaec186c56ece61f222329ea7de8cee897693fa")))) (option-none-of [:option :string])
  (let [strokes (i hero "stroke-count") claws (i hero "claw-count") samples (i hero "claw-samples") cores (i hero "core-count")
        pi (f hero "pi") gap (f hero "arc-gap-radians") ring (f hero "ring-radius") lo (f hero "stroke-radius-min") hi (f hero "stroke-radius-max")
        base (f hero "claw-base-radius") tip (f hero "claw-tip-radius") radius (f hero "claw-radius") density (f hero "claw-density")
        cmax (f hero "core-radius-max") cradius (f hero "core-point-radius") total (+ strokes (+ (* claws samples) cores))]
   (if (or (< strokes 2) (< claws 2) (< samples 2) (< cores 1) (> total 1000) (f64-le pi 0.0) (f64-le cmax 0.0)) (option-none-of [:option :string])
    (let [v (vector-alloc (* total 4)) a (add-strokes v strokes pi gap ring lo hi)
          b (add-claws a strokes claws samples pi gap base tip radius density)
          c (add-core b (+ strokes (* claws samples)) cores pi cmax cradius)]
     (option-some-of [:option :string] (csv c)))))))
