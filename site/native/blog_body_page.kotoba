(ns site.native.blog-body-page (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.input :as input] [site.native.locale-catalog :as catalog] [site.native.blog-body :as blog]))
(defn- locale? [s :string] :bool
 (or (string=? s "en") (string=? s "ar") (string=? s "arz") (string=? s "bn") (string=? s "de")
     (string=? s "es") (string=? s "fr") (string=? s "hi") (string=? s "id") (string=? s "ja")
     (string=? s "ko") (string=? s "mr") (string=? s "pcm") (string=? s "pt") (string=? s "ru")
     (string=? s "ur") (string=? s "zh-Hans")))
(defn- read [p :string] :string (input/read p))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0")]
  (if (not (locale? tag)) 7
   (match-option (catalog/open-catalog (read (string-concat "/site/i18n/" (string-concat tag ".json")))) [:option [:ref :site/catalog]]
    (none 7)
    (some state (let [result (blog/render state tag (read "/generator.cljk") (read "/embench-c-parity-article.edn") (read "/usage-article.edn") (read "/embench-progress-article.edn") (read "/infra-cost-article.edn") (read "/security-article.edn") (read "/org-identity-article.edn"))]
      (if (option-some?-of [:option :string] result)
       (let [ignored (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))))))
