(ns site.native.static-asset-controller (:export [main])
 (:capabilities [:fs/app-data-bytes :process/spawn :cli/args])
 (:require [multiformats.sha256 :as sha]))
;; Trusted, immutable manifest and source files; private, initially empty stage.
;; A failed run leaves an incomplete stage which must not be published.
(defn- bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- text [v :vector-i64] :string (string-from-utf8 (bytes-from-vector-i64 v)))
(defn- zero [] :string (string-from-utf8 (bytes-from-vector-i64 [0])))
(defn- field [s :string] :string (string-concat s (zero)))
(defn- cat [a :vector-i64 b :vector-i64] :vector-i64
 (let [n (vector-count a) m (vector-count b)
       out (loop [i 0 v (vector-alloc (+ n m))] (if (= i n) v (recur (+ i 1) (vector-assoc! v i (vector-at a i)))))]
  (loop [i 0 v out] (if (= i m) v (recur (+ i 1) (vector-assoc! v (+ n i) (vector-at b i)))))))
(defn- frame [op :i64 tail :vector-i64] :vector-i64 (cat [0 65 77 85 72 1 op] tail))
(defn- call [op :i64 tail :vector-i64] :vector-i64
 (vector-i64-from-bytes (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-from-vector-i64 (frame op tail)))))
(defn- read [p :string] :vector-i64 (call 1 (bytes (field p))))
(defn- ok? [v :vector-i64] :bool (and (> (vector-count v) 0) (= (vector-at v 0) 0)))
(defn- payload [v :vector-i64] :vector-i64
 (let [n (- (vector-count v) 1)] (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ i 1))))))))
(defn- join [a :string b :string] :string (string-concat a (string-concat "/" b)))
(defn- mkdir [p :string] :bool (ok? (call 3 (bytes (field p)))))
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- get-text [d :document k :keyword] :string (option-value-of [:option :string] (document-string-value (val (document-get d k))) ""))
(defn- item [v :document i :i64] :document (val (document-vector-at v i)))
(defn- matches? [path :string expected :string] :bool
 (let [r (read path)] (and (ok? r) (= (string-byte-length expected) 64) (arena-scope (string=? (sha/digest-hex (payload r)) expected)))))
(defn- group? [s :string] :bool
 (or (string=? s "") (string=? s "ipfs") (string=? s "play") (string=? s "anatomy") (string=? s ".well-known")
     (string=? s "anatomy/kotoba-murakumo") (string=? s "benchmarks") (string=? s "security") (string=? s "spec") (string=? s "schemas/trust-profile")
     (string=? s "policies/trust/eas") (string=? s "policies/trust/erc8004") (string=? s "policies/trust/human-passport")))
(defn- name? [s :string] :bool
 (let [v (bytes s) n (vector-count v)]
  (and (> n 0) (<= n 128) (not (= (vector-at v 0) 46)) (< (string-index-of s "..") 0)
   (loop [i 0] (if (= i n) true
    (let [c (vector-at v i)] (and (or (and (>= c 97) (<= c 122)) (and (>= c 65) (<= c 90)) (and (>= c 48) (<= c 57)) (= c 45) (= c 95) (= c 46)) (recur (+ i 1)))))))))
(defn- unique? [rows :document i :i64 j :i64] :bool
 (if (>= j i) true
  (let [a (item rows i) b (item rows j)]
   (and (not (and (string=? (get-text a :group) (get-text b :group)) (string=? (get-text a :name) (get-text b :name)))) (unique? rows i (+ j 1))))))
(defn- valid-rows? [rows :document i :i64 n :i64] :bool
 (if (= i n) true
  (let [r (item rows i)]
   (and (= (document-kind r) :map) (group? (get-text r :group)) (name? (get-text r :name)) (unique? rows i 0)
        (matches? (get-text r :source) (get-text r :sha256)) (valid-rows? rows (+ i 1) n)))))
(defn- hex [n :i64] :i64 (cond (and (>= n 48) (<= n 57)) (- n 48) (and (>= n 65) (<= n 70)) (- n 55) :else -1))
(defn- spawned? [s :string] :bool
 (let [v (bytes s)] (and (= (vector-count v) 5) (= (vector-at v 0) 48)
  (>= (hex (vector-at v 1)) 0) (>= (hex (vector-at v 2)) 0) (>= (hex (vector-at v 3)) 0) (>= (hex (vector-at v 4)) 0)
  (= (+ (* 16 (hex (vector-at v 1))) (hex (vector-at v 2))) 42))))
(defn- stage-one [stager :string private :string site :string row :document i :i64] :bool
 (let [group (get-text row :group) dir (if (string=? group "") site (join site group))
       fields (string-concat (field private) (string-concat (field (join private (string-concat "asset-" (string-concat (string-from-i64 i) ".log"))))
        (string-concat (field stager) (string-concat (field "site-asset") (string-concat (field (get-text row :source))
         (string-concat (field (get-text row :sha256)) (string-concat (field dir) (field (get-text row :name)))))))))
       request (frame 9 (cat [1 5] (bytes fields)))]
  (spawned? (typed-cap-call :process/spawn :string :string (text request)))))
(defn- stage-all [stager :string private :string site :string rows :document i :i64 n :i64] :bool
 (if (= i n) true (and (stage-one stager private site (item rows i) i) (stage-all stager private site rows (+ i 1) n))))
(defn main [] :i64
 (let [manifest (typed-cap-call :cli/args :string :string "0") private (typed-cap-call :cli/args :string :string "1")
       site (typed-cap-call :cli/args :string :string "2") r (read manifest)]
  (if (or (string=? private "") (string=? site "") (not (ok? r))) 7
   (let [m (document-edn-read (text (payload r))) rows (val (document-get m :assets)) n (document-count rows) stager (get-text m :stager)]
    (if (or (not (= (document-kind m) :map)) (not (= (document-kind rows) :vector)) (< n 1) (> n 128)
            (not (matches? stager (get-text m :stager-sha256))) (not (valid-rows? rows 0 n))) 7
     (if (and (mkdir (join site "ipfs")) (mkdir (join site "play")) (mkdir (join site "anatomy")) (mkdir (join site ".well-known"))
              (mkdir (join site "anatomy/kotoba-murakumo")) (mkdir (join site "benchmarks")) (mkdir (join site "security")) (mkdir (join site "spec"))
              (mkdir (join site "schemas")) (mkdir (join site "schemas/trust-profile"))
              (mkdir (join site "policies")) (mkdir (join site "policies/trust"))
              (mkdir (join site "policies/trust/eas")) (mkdir (join site "policies/trust/erc8004")) (mkdir (join site "policies/trust/human-passport"))
              (stage-all stager private site rows 0 n)) 42 7))))))
