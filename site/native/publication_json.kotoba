(ns site.native.publication-json (:export [main]) (:capabilities [:fs/app-data :io/write])
 (:require [multiformats.sha256 :as sha] [json.core :as json]))
(defn main [] :i64
 (let [text (typed-cap-call :fs/app-data :string :string "/library-publication.edn")
       ok (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 text))) "c6e3c6606ba31e3f1ff3cd25e995f02537307bd0dae5789703b6a8a261fbcb19"))
       data (if ok (document-edn-read text) (document-null))]
  (if (not (and ok (= (document-kind data) :map))) 7
   (let [output (json/json data) ignored (typed-cap-call :io/write :string :string output)] 42))))
