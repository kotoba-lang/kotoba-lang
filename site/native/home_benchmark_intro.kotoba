(ns site.native.home-benchmark-intro (:export [render])
 (:require [site.native.source-concat :as source] [site.native.home-section :as section]
           [site.native.locale-tree :as tree] [site.native.locale-rebase :as rebase]
           [multiformats.sha256 :as sha] [html-hiccup :as html] [components :as dds]))
;; Only the source-pinned introduction; remaining benchmark content is not rendered here.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- field [d :document k :keyword] :document (val (document-get d k)))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn render [state [:ref :site/catalog] tag :string generator :string report :string] [:option :string]
 (let [valid (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) "ca2955ee08ec6891787d7636238b1bc7b0ab64b807c4c8ce653ec03657d6c072"))
       report-valid (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 report))) "6352f6e90e7b456b77cbddc1edc2a91bfc3bd9f9a5f98dcc22fa788d51923411"))
       ratios-valid (if report-valid (section/check-ratios report 0 0 0) false)
       mean-valid (>= (string-index-of report "\"geometricMeanTimeRatio\": 0.7998826447941967") 0)
       pos (string-index-of generator "(defn benchmark-section []")
       tail (if (< pos 0) "" (string-substring generator pos (string-byte-length generator)))
       opts (source/data tail "(dds/section" 123 125)
       one (source/data tail "{:id \"benchmark\" :title \"Five benchmarks. Five different questions.\"}" 91 93)
       two (source/data tail "\"Read the measurements, kernel audit, and cross-language context\"]]" 91 93)
       three (source/data tail "compiler on a quiet host.\"]" 91 93)]
  (if (or (not valid) (not report-valid) (not ratios-valid) (not mean-valid) (< pos 0)
          (not (option-some?-of [:option :document] opts)) (not (option-some?-of [:option :document] one))
          (not (option-some?-of [:option :document] two)) (not (option-some?-of [:option :document] three))) (none)
   (let [o (val opts) title (field o :title) id (field o :id)
         a (section/evaluate (val one)) b (section/evaluate (val two)) c (section/evaluate (val three))]
    (if (or (not (= (document-kind title) :string)) (not (= (document-kind id) :string))
            (not (option-some?-of [:option :document] a)) (not (option-some?-of [:option :document] b)) (not (option-some?-of [:option :document] c))) (none)
     (let [node (document-vector (document-keyword :section) (document-map :class (document-string "dds-ext-section") :id id)
                  (dds/heading-node 2 title "32" "") (val a) (val b) (val c))
           local (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))
           bound (if (and (option-some?-of [:option :document] local) (not (string=? tag "en"))) (rebase/rebase-links (val local) tag "/") local)]
      (if (option-some?-of [:option :document] bound) (html/render (val bound) 0) (none))))))))
