(ns site.native.home-developer-template (:export [render])
 (:require [site.native.home-try-prefix :as prefix] [site.native.home-search :as search]))
;; The library slot is deliberately unfilled pending the catalog decision.
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn render [state [:ref :site/catalog] tag :string generator :string locales :string sample :string provenance :string wasm :vector-i64 grammar :string tokenizer :string theme :string index :string] [:option :string]
 (let [before (prefix/render state tag generator locales sample provenance wasm grammar tokenizer theme)
       after (search/render state tag generator index) s (option-value-of [:option :string] before "") n (string-byte-length s)]
  (if (or (not (option-some?-of [:option :string] before)) (not (option-some?-of [:option :string] after)) (< n 6)
          (not (string=? (string-substring s (- n 6) n) "</div>")) (>= (string-index-of s "KOTOBA_LIBRARY_SLOT") 0)) (none)
   (option-some-of [:option :string] (string-concat (string-substring s 0 (- n 6))
    (string-concat "KOTOBA_LIBRARY_SLOT" (string-concat (option-value-of [:option :string] after "") "</div>")))))))
