(ns site.native.library-row (:export [render])
 (:require [site.native.library-classifier :as classifier] [site.native.source-concat :as source] [html-hiccup :as html]))
;; One historical catalogue row. The caller must verify the immutable inputs.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- field [d :document k :keyword] :document (if (= (document-kind d) :map) (val (document-get d k)) (document-null)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- topic [taxonomy :document i :i64] :document
 (let [planes (field taxonomy :planes) domains (field taxonomy :domains) n (document-count planes)]
  (field (if (< i n) (item planes i) (item domains (- i n))) :topic)))
(defn- contains? [v :document value :string i :i64] :bool
 (if (>= i (document-count v)) false (if (string=? (text (item v i)) value) true (contains? v value (+ i 1)))))
(defn- tag-list [taxonomy :document mask :i64 n :i64 i :i64 out :document] :document
 (if (>= i n) out (tag-list taxonomy mask n (+ i 1) (if (= (bit-and mask (i64-shift-left 1 i)) 0) out (document-vector-conj out (topic taxonomy i))))))
(defn- add-topics [generated :document topics :document i :i64 out :document] :document
 (if (>= i (document-count topics)) out
  (let [v (item topics i) s (text v)]
   (if (or (not (= (document-kind v) :string)) (contains? out s 0)) (add-topics generated topics (+ i 1) out)
    (add-topics generated topics (+ i 1) (document-vector-conj out v))))))
(defn- join-tags [tags :document i :i64 out :string] :string
 (if (>= i (document-count tags)) out (join-tags tags (+ i 1) (string-concat out (string-concat (if (= i 0) "" " ") (text (item tags i)))))))
(defn- tag-spans [tags :document i :i64 out :document] :document
 (if (>= i (document-count tags)) out (tag-spans tags (+ i 1) (document-vector-conj out (document-vector (document-keyword :span) (document-map :class (document-string "kot-lib-tag")) (item tags i))))))
(defn- safe-name? [s :string i :i64] :bool
 (if (>= i (string-byte-length s)) (> i 0) (let [c (string-code-point-at s i)]
  (and (or (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122)) (and (>= c 48) (<= c 57)) (= c 45) (= c 95) (= c 46)) (safe-name? s (+ i 1))))))
(defn- name-node [name :string archived :bool location :document] [:option :document]
 (let [kind (if (= (document-kind location) :vector) (document-edn-print (item location 0)) ":github") arg (if (= (document-kind location) :vector) (item location 1) (document-null))
       valid (or (string=? kind ":github") (string=? kind ":retired") (and (or (string=? kind ":monorepo") (string=? kind ":relocated")) (= (document-kind arg) :string)))
       path (text arg) url (cond (string=? kind ":monorepo") (string-concat "https://github.com/kotoba-lang/kotoba/tree/main/" path)
                            (string=? kind ":relocated") (string-concat "https://github.com/" path)
                            :else (string-concat "https://github.com/kotoba-lang/" name))
       name-part (if (string=? kind ":retired") (document-vector (document-keyword :span) (document-map :class (document-string "kot-lib-name")) (document-string name))
                  (document-vector (document-keyword :a) (document-map :class (document-string "kot-lib-name") :href (document-string url) :rel (document-string "noreferrer")) (document-string name)))
       flag (cond (string=? kind ":monorepo") (string-concat "in kotoba " path) (string=? kind ":relocated") (string-concat "moved to " path) (string=? kind ":retired") "not on GitHub" archived "archived" :else "")
       node (document-vector (document-keyword :span) (document-map :class (document-string "kot-lib-where")) name-part)]
  (if (not valid) (option-none-of [:option :document])
   (option-some-of [:option :document] (if (string=? flag "") node (document-vector-conj node (document-vector (document-keyword :span) (document-map :class (document-string "kot-lib-flag")) (document-string flag))))))))
(defn render [taxonomy :document locations :string repo :document] [:option :string]
 (let [name (text (field repo :name)) desc (field repo :description) topics0 (field repo :topics) topics (if (= (document-kind topics0) :null) (document-vector) topics0)
       archived0 (field repo :archived?) archived (option-value-of [:option :bool] (document-bool-value archived0) false)
       mask (classifier/classify taxonomy repo) n (+ (document-count (field taxonomy :planes)) (document-count (field taxonomy :domains)))
       generated (tag-list taxonomy mask n 0 (document-vector)) all (add-topics generated topics 0 generated)
       location (source/data locations (document-edn-print (document-string name)) 91 93)
       name-view (name-node name archived (if (option-some?-of [:option :document] location) (val location) (document-null)))]
  (if (or (not (= (document-kind repo) :map)) (not (safe-name? name 0)) (not (or (= (document-kind desc) :null) (= (document-kind desc) :string)))
          (not (= (document-kind topics) :vector)) (not (or (= (document-kind archived0) :null) (= (document-kind archived0) :bool)))
          (< mask 0) (< n 1) (> n 62) (not (option-some?-of [:option :document] name-view))) (option-none-of [:option :string])
   (let [node (document-vector (document-keyword :li) (document-map :class (document-string "kot-lib") :data-t (document-string (join-tags generated 0 ""))) (val name-view))
         with-desc (if (= (document-kind desc) :string) (document-vector-conj node (document-vector (document-keyword :span) (document-map :class (document-string "kot-lib-desc")) desc)) node)
         final (if (> (document-count all) 0) (document-vector-conj with-desc (tag-spans all 0 (document-vector (document-keyword :span) (document-map :class (document-string "kot-lib-tags"))))) with-desc)]
    (html/render final 0)))))
