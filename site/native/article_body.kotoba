(ns site.native.article-body (:export [render-body])
 (:require [site.native.header :as header] [site.native.footer :as footer]
           [site.native.article-section :as article] [site.native.locale-tree :as tree]
           [html-hiccup :as html]))
;; Source-driven article body; page head, assets and publication are separate.
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
  (some (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (none)))
(defn- skip [state [:ref :site/catalog] tag :string] [:option :string]
 (let [raw (document-vector (document-keyword :a) (document-map :class (document-string "kot-skip") :href (document-string "#main")) (document-string "Skip to content"))
       translated (if (string=? tag "en") (option-some-of [:option :document] raw) (tree/map-indexed state raw))]
  (if (option-some?-of [:option :document] translated) (html/render (val translated) 0) (none))))
(defn- sections [ctx [:ref :site/article-context] xs :document] [:option :string]
 (if (not (= (document-kind xs) :vector)) (none)
  (loop [i 0 out (some "")]
   (if (or (>= i (document-count xs)) (not (option-some?-of [:option :string] out))) out
    (recur (+ i 1) (append out (article/render-section ctx (val (document-vector-at xs i)))))))))
(defn render-body [state [:ref :site/catalog] tag :string base :string doc :document eyebrow :string generator :string] [:option :string]
 (if (not (= (document-kind doc) :map)) (none)
  (let [ctx (record-new [:ref :site/article-context] state tag base)
        a (append (some "<body><div>") (skip state tag))
        b (append a (header/render-header state tag base false))
        c (append b (some "<main id=\"main\"><div class=\"dds-ext-container\">"))
        d (append c (article/render-intro ctx doc eyebrow))
        e (append d (sections ctx (val (document-get doc :sections))))
        f (append e (article/render-outro ctx doc))
        g (append f (some "</div></main>"))
        h (append g (footer/render-footer state tag base false "/legal/" false generator))]
   (append h (some "</div></body>")))))
