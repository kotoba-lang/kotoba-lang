(ns site.native.dds-ext-data (:export [rules media])
 (:require [site.native.source-concat :as concat] [multiformats.sha256 :as sha]))
(defn- source-ok? [s :string] :bool
 (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) "32490d1650120aba474455b33f557b0fc97d2ee86f8b784b9a5b5b708422d760"))
(defn rules [source :string] [:option :document]
 (if (source-ok? source) (concat/data source "(def ext-rules" 91 93) (option-none-of [:option :document])))
(defn media [source :string] [:option :document]
 (if (source-ok? source) (concat/data source "(def ext-media" 123 125) (option-none-of [:option :document])))
