(ns site.native.home-body-shell (:export [render])
 (:require [site.native.header :as header] [site.native.footer :as footer] [site.native.home-contents :as contents]
           [site.native.locale-tree :as tree] [html-hiccup :as html]))
;; A template only, never a complete page. A controller must verify and fill
;; every slot with successful native output before publication.
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
  (some (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (none)))
(defn- skip [state [:ref :site/catalog] tag :string] [:option :string]
 (let [node (document-vector (document-keyword :a) (document-map :class (document-string "kot-skip") :href (document-string "#main")) (document-string "Skip to content"))
       localized (if (string=? tag "en") (option-some-of [:option :document] node) (tree/map-indexed state node))]
  (if (option-some?-of [:option :document] localized) (html/render (val localized) 0) (none))))
(defn render [state [:ref :site/catalog] tag :string generator :string] [:option :string]
 (let [a (append (some "<body><div>") (skip state tag))
       b (append a (header/render-header state tag "/" true))
       c (append b (some "<main id=\"main\">KOTOBA_HERO_SLOT<div class=\"dds-ext-container\">"))
       d (append c (contents/contents state tag generator))
       e (append d (some "KOTOBA_CHAPTERS_SLOT</div></main>"))
       f (append e (footer/render-footer state tag "/" false "legal/" false "site/native/home_body_shell.kotoba"))]
  (append f (some "<script>KOTOBA_SEARCH_SCRIPT_SLOT</script><script>KOTOBA_PLAY_SCRIPT_SLOT</script><script>KOTOBA_HERO_SCRIPT_SLOT</script><script>KOTOBA_CHART_SCRIPT_SLOT</script><script>KOTOBA_MORPH_SCRIPT_SLOT</script></div></body>"))))
