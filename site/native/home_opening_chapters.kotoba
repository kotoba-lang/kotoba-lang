(ns site.native.home-opening-chapters (:export [render])
 (:require [site.native.home-contents :as contents] [site.native.home-section :as section]
           [site.native.home-deliberate :as deliberate]))
;; The first two homepage chapters, assembled from source-derived components.
;; This excludes the remaining chapters, head, assets, and publication.
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- append [a [:option :string] b [:option :string]] [:option :string]
 (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
  (some (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b ""))) (none)))
(defn render [state [:ref :site/catalog] tag :string generator :string architecture :string typed :string defaults :string surface :string] [:option :string]
 (let [a (append (some "<div class=\"kot-chapter-block\">") (contents/rule-at state tag generator 0))
       b (append a (section/render-section state tag generator "why"))
       c (append b (section/render-section state tag generator "what"))
       d (append c (some "</div><div class=\"kot-chapter-block\">"))
       e (append d (contents/rule-at state tag generator 1))
       f (append e (section/render-architecture state tag generator architecture))
       g (append f (section/render-typed state tag generator typed))
       h (append g (section/render-defaults state tag generator defaults))
       j (append h (deliberate/render state tag generator surface))]
  (append j (some "</div>"))))
