#!/usr/bin/env sh
set -eu

# Cloudflare Workers Builds starts from npm dependencies only.  Provide the
# site build's deliberately narrow kbb SCI door with the pinned .cljk-aware
# engine installed as the nbb package; do not fall back to a host binary.
if [ "${1:-}" != "--backend" ] || [ "${2:-}" != "sci" ]; then
  printf '%s\n' 'site/kbb: only --backend sci is supported' >&2
  exit 64
fi
shift 2

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
ENGINE="$ROOT/node_modules/nbb/cli.js"
if [ ! -f "$ENGINE" ]; then
  printf '%s\n' 'site/kbb: pinned kbb SCI engine is missing; run npm ci' >&2
  exit 3
fi

# The site build reads its own empty nbb.edn, never the repository root's: the
# root one carries :deps for the test runner, and nbb resolves :deps by
# shelling out to `bb`, which the Cloudflare build image does not have.
exec node "$ENGINE" --config "$ROOT/site/nbb.edn" "$@"
