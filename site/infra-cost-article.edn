    :row-header? true
    :rows
    [["Released Kotoba CLI Wasm" "11.75"]
     ["Clang native" "29.08"]
     ["rustc Wasm" "38.99"]
     ["rustc native" "56.02"]
     ["javac" "171.53"]]}
   :rows
   [["Released CLI"
     "Valid through K=128; invalid artifact at K=129+."]
