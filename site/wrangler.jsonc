{
  // kotoba-lang.org — static assets only, no Worker script.
  //
  // Deploy from this directory after regenerating dist/ (see README.md):
  //   npx wrangler deploy
  //
  // The zone kotoba-lang.org lives in the ai-gftd-cloud Cloudflare account.
  // Deploys have no fast-forward check of their own — the last writer wins —
  // so sync the checkout to origin/main before shipping (enforced by the
  // superproject's wrangler-deploy-main-sync-guard hook).
  "name": "kotoba-lang-org",
  "compatibility_date": "2026-08-03",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "kotoba-lang.org", "custom_domain": true },
    { "pattern": "www.kotoba-lang.org", "custom_domain": true }
  ]
}
