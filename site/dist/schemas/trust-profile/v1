{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kotoba-lang.org/schemas/trust-profile/v1",
  "title": "Kotoba external trust profile v1",
  "description": "Discovery of accepted external evidence and service-specific enforcement state. It is not a trust score or an authorization token.",
  "type": "object",
  "required": ["schema", "version", "service", "semantics", "sources", "policy", "claims"],
  "properties": {
    "schema": {"const": "https://kotoba-lang.org/schemas/trust-profile/v1"},
    "version": {"const": 1},
    "service": {
      "type": "object",
      "required": ["origin", "authorityDid", "role", "identityEndpoint"],
      "properties": {
        "origin": {"type": "string", "format": "uri", "pattern": "^https://"},
        "authorityDid": {"type": "string", "pattern": "^did:"},
        "role": {"enum": ["human-organization-operator", "evidence-authority", "agent-execution"]},
        "identityEndpoint": {"type": "string", "format": "uri", "pattern": "^https://"}
      },
      "additionalProperties": false
    },
    "semantics": {
      "type": "object",
      "required": ["decisionModel", "universalTrustScore", "nonAdjudicating", "failClosed"],
      "properties": {
        "decisionModel": {"const": "scoped-evidence"},
        "universalTrustScore": {"const": false},
        "nonAdjudicating": {"const": true},
        "failClosed": {"const": true}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "required": ["humanPassport", "ethereumAttestationService", "erc8004"],
      "properties": {
        "humanPassport": {"$ref": "#/$defs/humanPassport"},
        "ethereumAttestationService": {"$ref": "#/$defs/eas"},
        "erc8004": {"$ref": "#/$defs/erc8004"}
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["humanPassport", "ethereumAttestationService", "erc8004"],
      "properties": {
        "humanPassport": {"type": "object", "required": ["status"]},
        "ethereumAttestationService": {"type": "object", "required": ["status"]},
        "erc8004": {"type": "object", "required": ["status"]}
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "object",
      "required": ["humanPassportKyc", "humanPassportUniversalReputation", "erc8004LiveRegistry"],
      "properties": {
        "humanPassportKyc": {"const": false},
        "humanPassportUniversalReputation": {"const": false},
        "erc8004LiveRegistry": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "humanPassport": {
      "type": "object",
      "required": ["specification", "purpose", "coordinate", "schemaUid", "allowedAttesters", "maximumAgeSeconds", "minimumScore", "status"],
      "properties": {
        "specification": {"type": "string", "format": "uri"},
        "purpose": {"const": "identity/sybil-resistance"},
        "coordinate": {"$ref": "#/$defs/easCoordinate"},
        "schemaUid": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
        "allowedAttesters": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"}},
        "maximumAgeSeconds": {"type": "integer", "minimum": 1},
        "minimumScore": {"oneOf": [{"type": "integer", "minimum": 0}, {"const": "deployment-policy"}]},
        "status": {"const": "supported"}
      },
      "additionalProperties": false
    },
    "easCoordinate": {
      "type": "object",
      "required": ["namespace", "chainId", "network", "easAddress", "schemaRegistryAddress"],
      "properties": {
        "namespace": {"const": "eip155"},
        "chainId": {"type": "integer", "minimum": 1},
        "network": {"type": "string", "minLength": 1},
        "easAddress": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
        "schemaRegistryAddress": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"}
      },
      "additionalProperties": false
    },
    "eas": {
      "type": "object",
      "required": ["specification", "purpose", "requirements", "status"],
      "properties": {
        "specification": {"type": "string", "format": "uri"},
        "purpose": {"const": "provenance-and-lifecycle-verification"},
        "requirements": {"type": "array", "minItems": 5, "items": {"type": "string"}},
        "status": {"const": "supported"}
      },
      "additionalProperties": false
    },
    "erc8004": {
      "type": "object",
      "required": ["specification", "purpose", "implementation", "registryBinding", "status", "refusalReason"],
      "properties": {
        "specification": {"type": "string", "format": "uri"},
        "purpose": {"type": "array", "minItems": 3, "items": {"type": "string"}},
        "implementation": {"const": "three-registry-draft-adapter"},
        "registryBinding": {"type": ["object", "null"]},
        "status": {"enum": ["supported-unbound", "active"]},
        "refusalReason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
