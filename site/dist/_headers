# kotoba-lang.org — Cloudflare Workers static assets _headers.
#
# Deployed as site/dist/_headers (generate.cljs copies it there; wrangler.jsonc
# serves ./dist with no Worker script). Rules are declared specific-first and
# the catch-all /* is LAST because when several rules match, the last
# declaration of the same header wins. Measured 2026-09-01: same-named headers
# from two matching rules are CONCATENATED ("public, no-cache, public,
# max-age=604800"), which neutralizes asset TTLs — so the catch-all must not
# declare Cache-Control at all.
#
# HTML and document surfaces declare no-cache explicitly: always revalidate.
# Cloudflare emits ETag for non-HTML assets, so unchanged documents revalidate
# with 304 instead of re-downloading. The wordmark, OG card, and digest-bound
# Play artifact get bounded lifetimes; machine-readable reports refresh quickly.

/index.html
  Cache-Control: public, no-cache

/
  Cache-Control: public, no-cache

/blog/index.html
  Cache-Control: public, no-cache

/libraries/index.html
  Cache-Control: public, no-cache

/ja/libraries/index.html
  Cache-Control: public, no-cache

/legal/index.html
  Cache-Control: public, no-cache

/ja/legal/index.html
  Cache-Control: public, no-cache

/kotoba-wordmark.png
  Cache-Control: public, max-age=604800, must-revalidate

/kotoba-og-card.png
  Cache-Control: public, max-age=604800, must-revalidate

/kotoba-favicon.png
  Cache-Control: public, max-age=604800, must-revalidate

/play/double-21.wasm
