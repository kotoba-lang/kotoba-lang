# kotoba-lang.org — Cloudflare Workers static assets _headers.
#
# Deployed as site/dist/_headers (generate.cljs copies it there; wrangler.jsonc
# serves ./dist with no Worker script). Rules are declared specific-first and
# the catch-all /* is LAST because when several rules match, the last
# declaration of the same header wins.
#
# HTML and document surfaces are no-cache: always revalidate. Cloudflare emits
# ETag/Last-Modified for static assets, so an unchanged page revalidates with
# 304 instead of re-downloading ~200 KB. The wordmark and the digest-bound Play
# artifact get bounded lifetimes; machine-readable reports refresh quickly.

/kotoba-wordmark.png
  Cache-Control: public, max-age=604800, must-revalidate

/play/double-21.wasm
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/wasm

/benchmarks/compile-wasm-latest.json
  Cache-Control: public, max-age=300, must-revalidate

/benchmarks/runtime-native-latest.json
  Cache-Control: public, max-age=300, must-revalidate

/benchmarks/end-to-end-latest.json
  Cache-Control: public, max-age=300, must-revalidate

/benchmarks/domains-latest.json
  Cache-Control: public, max-age=300, must-revalidate

/llms.txt
  Cache-Control: public, max-age=300, must-revalidate

/llms-full.txt
  Cache-Control: public, max-age=300, must-revalidate

/agent-quickstart.md
  Cache-Control: public, max-age=300, must-revalidate

/*
  Cache-Control: public, no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
