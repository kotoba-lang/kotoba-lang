{
  "worker": "kotoba-lang-org",
  "repository": "kotoba-lang/kotoba-lang",
  "trigger_name": "kotoba-lang.org production",
  "root_directory": "/",
  "build_command": "npm ci && npm run site:build",
  "deploy_command": "npx --no-install wrangler deploy --config site/wrangler.jsonc",
  "branch_includes": ["main"],
  "branch_excludes": [],
  "path_includes": ["*"],
  "path_excludes": [],
  "build_caching_enabled": true,
  "environment_variables": {"NODE_VERSION": "22"}
}
