              "authentic" "\\bucan\\b" "\\bcacao\\b" "\\bsaml\\b" "\\boidc\\b"
              "credential" "\\bsiwe\\b"]}
  {:id :network :label "Networking & protocols" :topic "networking"
   :patterns ["\\btcp\\b" "\\budp\\b" "\\bhttp\\b" "\\bdns\\b" "\\btls\\b" "socket"
