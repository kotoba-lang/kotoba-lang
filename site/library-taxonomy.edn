;; The tag vocabulary for the public library catalogue.
;;
;; Two kinds of tag, and they are not the same kind of fact.
;;
;;   :planes  — read off the repository NAME, using the workspace's own
;;              naming rule (ADR-2608040100: a repo name carries exactly one
;;              of origin / role / family / subject). A plane tag is derived
;;              structurally and is as certain as the name is.
;;
;;   :domains — matched against the name and the GitHub description with
;;              word-boundary patterns. This is EVIDENCE, not authority: a
;;              repo with no description can only be matched on its name, and
;;              a repo that matches nothing is reported as UNTAGGED rather
;;              than being assigned a nearest guess. The page publishes that
;;              coverage number, because a catalogue that silently tags
;;              everything is indistinguishable from one that tags correctly.
;;
;; `:topic` is the GitHub repository topic this tag corresponds to, so the
;; site's filter and the org's topics are the same vocabulary rather than two
;; that drift. Patterns are strings compiled with `re-pattern`, not `#""`
;; literals, so this file stays plain data.
{:kotoba.site/taxonomy-version 1
 :planes
 [{:id :origin :label "External origin" :topic "external-origin"
   :note "Name is a reverse-DNS label of the source domain: a clean-room mirror of somebody else's specification or product."
   :prefixes ["com" "org" "io" "tech" "dev" "gov" "int" "jp" "net" "edu" "ai" "co"]}
  {:id :capability :label "Capability" :topic "kotoba-capability"
   :note "A single typed host capability the compiler can admit."
   :prefixes ["capability"]}
  {:id :app :label "Application" :topic "kotoba-app"
   :note "A deployable application rather than a library."
   :prefixes ["app"]}
  {:id :actor :label "Actor" :topic "kotoba-actor"
   :note "A governed actor: an LLM or advisor node behind an independent governor."
   :prefixes ["actor"]}
  {:id :loop :label "Loop" :topic "kotoba-loop"
   :note "A continuous orchestrator: observe, evaluate, decide, act, record."
   :prefixes ["loop"]}
  {:id :kami :label "kami — engine family" :topic "kami-engine"
   :note "The 3D engine, render and scene family."
   :prefixes ["kami"]}
  {:id :kotoba :label "kotoba — language family" :topic "kotoba-lang"
   :note "The language, compiler and IR family."
   :prefixes ["kotoba" "kototama" "kotodama"]}
  {:id :kotobase :label "kotobase — storage family" :topic "kotobase"
   :note "The content-addressed storage and query family."
   :prefixes ["kotobase" "kura"]}]
 :domains
 [{:id :os :label "OS & kernel" :topic "operating-system"
   :patterns ["\\bos\\b" "\\bkernel" "aiueos" "syscall" "bootloader" "\\bmmu\\b"
              "interrupt" "\\bscheduler\\b" "process isolation" "\\bipc\\b"]}
  {:id :driver :label "Drivers & hardware" :topic "device-driver"
   :patterns ["\\bdriver" "\\bmmio\\b" "\\bpci\\b" "\\bgpio\\b" "\\bi2c\\b" "\\bspi\\b"
              "\\buart\\b" "\\bdma\\b" "firmware" "\\bhal\\b" "\\bble\\b" "bluetooth"
              "\\busb\\b" "\\bcan\\b" "canopen" "modbus" "ethercat"]}
  {:id :sim :label "Simulation & modelling" :topic "simulation"
   :patterns ["simulat" "\\bcfd\\b" "\\bfem\\b" "finite element" "physics" "\\bsolver\\b"
              "monte carlo" "\\bsph\\b" "biomech" "kinematic" "rigid body" "system dynamics"]}
  {:id :compiler :label "Compilers & IR" :topic "compiler"
   :patterns ["compiler" "\\bkir\\b" "\\bir\\b" "parser" "lexer" "grammar" "codegen"
              "\\bast\\b" "transpil" "\\bllvm\\b" "emitter" "type check"]}
  {:id :runtime :label "Runtime & WebAssembly" :topic "webassembly"
   :patterns ["\\bwasm\\b" "webassembly" "\\bwasi\\b" "component model" "interpreter"
              "\\bvm\\b" "\\bjit\\b" "\\babi\\b" "runtime"]}
  {:id :crypto :label "Cryptography" :topic "cryptography"
   :patterns ["crypt" "\\bhash\\b" "signature" "ml-kem" "ml-dsa" "post-quantum"
              "\\bsha-?\\d" "\\baes\\b" "\\bhmac\\b" "zero-knowledge" "ed25519"
              "\\bx509\\b" "\\bjws\\b" "\\bhpke\\b" "argon2" "\\bblake" "chacha"]}
  {:id :identity :label "Identity & authority" :topic "identity"
