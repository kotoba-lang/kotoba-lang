;; Reproducible, JVM-free site build for CI and operators.
(require '["node:fs" :as fs]
         '["node:path" :as path]
         '["node:child_process" :as cp])

(defn run! [command args options]
  (let [result (cp/spawnSync command (clj->js args)
                            (clj->js (merge {:stdio "inherit"
                                            :timeout 600000} options)))]
    (when-not (= 0 (.-status result))
      (throw (js/Error. (str command " failed (exit " (.-status result) ")"))))))

(def root (.cwd js/process))
(def deps-root (path/join root ".site-deps"))
(def lock (js->clj (js/JSON.parse (fs/readFileSync "site/build-dependencies.json" "utf8"))
                  :keywordize-keys true))
(fs/mkdirSync deps-root #js {:recursive true})

(defn sha! [what sha]
  (when-not (and (string? sha) (re-matches #"[0-9a-f]{40}" sha))
    (throw (js/Error. (str "Invalid dependency revision: " what)))))

(defn checkout! [dir url sha]
  (if (fs/existsSync dir)
    (run! "git" ["fetch" "origin"] {:cwd dir})
    (run! "git" ["clone" "--filter=blob:none" "--no-checkout" url dir] {}))
  ;; Only this build's ignored dependency checkout is changed.
  (run! "git" ["checkout" "--detach" sha] {:cwd dir}))

;; Standalone repositories: name -> {:url :sha}.
(def dep-dirs
  (into {}
        (for [[name entry] (:repositories lock)
              :let [name (cljs.core/name name)
                    dir (path/join deps-root name)]]
          (do (sha! name (:sha entry))
              (checkout! dir (:url entry) (:sha entry))
              [name dir]))))

;; Consolidated libraries: one sparse checkout of the pinned kotoba-lang/kotoba
;; commit, each library read from its lib/ directory.
(def monorepo (:monorepo lock))
(def monorepo-dirs
  (let [dir (path/join deps-root "_kotoba")
        libs (:libs monorepo)]
    (sha! "kotoba" (:sha monorepo))
    (when-not (fs/existsSync dir)
      (run! "git" ["clone" "--filter=blob:none" "--no-checkout" (:url monorepo) dir] {})
      (run! "git" ["sparse-checkout" "init" "--cone"] {:cwd dir}))
    (run! "git" (into ["sparse-checkout" "set"] (map second libs)) {:cwd dir})
    (when (fs/existsSync (path/join dir ".git"))
      (run! "git" ["fetch" "origin"] {:cwd dir}))
    (run! "git" ["checkout" "--detach" (:sha monorepo)] {:cwd dir})
    (into {} (for [[name sub] libs] [(cljs.core/name name) (path/join dir sub)]))))

(def dep-root (merge dep-dirs monorepo-dirs))

(def classpath
  (.join (clj->js (cons "site/src"
                        (for [name ["grammar" "text" "jp-go-digital-design-system" "css" "html" "coll"]]
                          (path/join (dep-root name) "src")))) ":"))
(def env (js/Object.assign #js {} js/process.env
                #js {"JP_GO_DDS_ROOT" (dep-root "jp-go-digital-design-system")
                     "KOTOBA_GRAMMAR_ROOT" (dep-root "grammar")
                     "KOTOBA_IDENTITY_ROOT" (path/join root "site" "vendor" "identity")}))
(def kbb (path/join root "site" "kbb"))
;; A failed generation must never leave old pages looking like new output.
(fs/rmSync "site/dist" #js {:recursive true :force true})
(doseq [script ["site/generate.cljk" "site/test/locales_test.cljk"
                "site/test/public_locales_test.cljk"]]
  (run! kbb ["--backend" "sci" "--classpath" classpath script] {:env env}))
(doseq [file ["site/dist/index.html" "site/dist/ja/index.html"]]
  (let [html (fs/readFileSync file "utf8")
        head-end (.indexOf html "</head>")
        theme-script (.indexOf html "localStorage.getItem(K)")]
    (when-not (and (.includes html "id=\"kot-theme\"")
                   (.includes html "setAttribute('data-theme',s)")
                   (not= -1 head-end)
                   (not= -1 theme-script)
                   (< theme-script head-end))
      (throw (js/Error. (str "Shared theme control or pre-paint script missing from " file))))))
(println "Site generation, locale and shared-theme checks passed.")
