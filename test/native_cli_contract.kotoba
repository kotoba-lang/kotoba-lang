(ns contract-reader (:export [main])
  (:require [kotoba.compiler.kotoba-reader :as reader] [kotoba.form :as f]))
(defn- field [value [:ref :form/r] key :keyword] [:ref :form/r]
  (f/form-get value (f/keyword-form key)))
(defn- out [text :string] :i64 (let [r (typed-cap-call :io/write :string :string text)] 0))
(defn- word [value [:ref :form/r]] :string
  (if (f/is-keyword? value)
    (let [s (document-edn-print (document-keyword (f/keyword-value value)))] (string-substring s 1 (string-length s)))
    (f/string-value value)))
(defn- flags [options [:ref :form/r]] :i64
  (loop [i 0]
    (if (= i (f/count-of options)) 0
      (let [option (f/nth-of options i) names (field option :flags)
            n (loop [j 0]
                (if (= j (f/count-of names)) 0
                  (let [p (out (string-concat " " (word (f/nth-of names j))))] (recur (+ j 1)))))]
        (recur (+ i 1))))))
(defn- expected-flags [id :keyword] :string
 (case id
  :id "--principal --rp-id --account --address --chain-id --json"
  :run "--runtime --library -e --expr -S --source-path --target --function --arg --json"
  :compile "--target --prelude -o --output --json"
  :check "--kind -S --source-path --target --safe --json"
  :graph "--graph --db --op -f --file --param --json"
  :git "--repo --op -m --message --ref --json"
  :rad "--project --op --template --profile -o --output --json"
  :build "--project --profile -o --output --json"
  :test "--project --profile --json"
  :deploy "--manifest --op --target --dry-run --revision --json"
  :library "--store --namespace --github --endpoint --write-token-file --router --hosted --dry-run --json"
  :hinshitsu "-f --file --op --baseline --candidate --threshold --required-check --json" ""))
(defn- flag-text [options [:ref :form/r]] :string
 (loop [i 0 text ""]
  (if (= i (f/count-of options)) text
   (let [names (field (f/nth-of options i) :flags)
         next (loop [j 0 s text]
                (if (= j (f/count-of names)) s
                 (let [name (word (f/nth-of names j))]
                  (recur (+ j 1) (string-concat s (string-concat (if (= (string-length s) 0) "" " ") name))))))]
    (recur (+ i 1) next)))))
(defn- option-values [command [:ref :form/r] id :keyword] [:ref :form/r]
 (let [options (field command :options)]
  (loop [i 0]
   (cond (= i (f/count-of options)) (f/nil-form)
         (f/eq (field (f/nth-of options i) :id) (f/keyword-form id)) (field (f/nth-of options i) :values)
         :else (recur (+ i 1))))))
(defn- options-ok? [command [:ref :form/r]] :bool
 (let [id (f/keyword-value (field command :id)) canonical (f/form-vec (f/one-form (f/keyword-form :kotoba)))]
  (cond (= id :run) (and (f/eq (option-values command :runtime) canonical) (f/eq (option-values command :target) canonical))
        (= id :check) (f/eq (option-values command :target) canonical)
        (= id :compile) (f/eq (option-values command :target) (f/vec2 (f/keyword-form :web) (f/keyword-form :wasm)))
        :else true)))
(defn- commands [value [:ref :form/r]] :i64
  (let [all (field value :kotoba.cli.contract/commands)
        base-required (f/form-set (f/append-form (f/append-form (f/append-form
                   (f/kids-of (f/vec6 (f/keyword-form :id) (f/keyword-form :run) (f/keyword-form :compile)
                     (f/keyword-form :check) (f/keyword-form :graph) (f/keyword-form :git)))
                   (f/keyword-form :rad)) (f/keyword-form :build)) (f/keyword-form :test)))
        required (f/form-set (f/append-form (f/append-form (f/append-form (f/kids-of base-required)
                   (f/keyword-form :deploy)) (f/keyword-form :library)) (f/keyword-form :hinshitsu)))
        actual (f/form-set (loop [i 0 keys (f/no-forms)] (if (= i (f/count-of all)) keys
                  (recur (+ i 1) (f/append-form keys (field (f/nth-of all i) :id))))))
        scope (field value :kotoba.cli.contract/scope)]
    (if (or (not (f/is-vec? all)) (not= (f/count-of all) 12)
            (not (and (f/eq actual required) (f/eq required actual)))
            (not (f/eq (field scope :authority) (f/keyword-form :canonical-kotoba)))
            (not (f/eq (field scope :host-adapter-targets) (f/form-vec (f/one-form (f/keyword-form :amu-selfhost-native)))))) 10
      (loop [i 0]
        (if (= i (f/count-of all)) (out (string-concat "command-count " (string-concat (string-from-i64 i) "\n")))
          (let [command (f/nth-of all i) name (field command :id)
                valid (string=? (flag-text (field command :options)) (expected-flags (f/keyword-value name)))]
            (if (not (options-ok? command)) 16
            (if valid
             (let [p (out (word name)) q (flags (field command :options)) n (out "\n")] (recur (+ i 1)))
             15))))))))
(defn main [] :i64
  (let [path (typed-cap-call :cli/args :string :string "0")
        mode (typed-cap-call :cli/args :string :string "1")
        response (typed-cap-call :fs/app-data :string :string (string-concat "\u0000FS2\u0000A" (string-concat path "\u0000")))
        text (if (and (>= (string-length response) 5) (string=? (string-substring response 0 5) "\u0000FS2\u0000"))
               (string-substring response 5 (string-length response)) "")
        parsed (reader/read-forms-bounded text 512 8192)
        error (record-get [:ref :kotoba.reader/out] parsed :err)
        forms (record-get [:ref :kotoba.reader/out] parsed :forms)]
    (cond (not (string=? error "")) (let [p (out error)] 11)
          (not= (vector-count forms) 1) 12
          :else (let [value (typed-list-nth [:list [:ref :form/r]] forms 0)]
            (cond (not (f/is-map? value)) 13
                  (string=? mode "cli") (commands value)
                  :else (let [version (field value :kotoba.lang.surface-status/version)
                              profile (field value :kotoba.lang.surface-status/profile-version)
                              p (out (string-concat "surface-version " (string-concat (string-from-i64 (f/int-value version))
                                  (string-concat " profile " (string-concat (string-from-i64 (f/int-value profile)) "\n")))))]
                          (if (and (f/is-int? version) (f/is-int? profile)) 0 14)))))))
