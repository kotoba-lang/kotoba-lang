(ns site.native.home-scripts-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.home-scripts :as home]))
(defn main [] :i64
 (let [mode (typed-cap-call :cli/args :string :string "0") generator (typed-cap-call :fs/app-data :string :string "/generator.cljk")
       result (home/extract generator mode)]
  (if (option-some?-of [:option :string] result)
   (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))
