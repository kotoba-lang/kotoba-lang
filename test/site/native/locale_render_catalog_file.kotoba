;; Frozen expected translations from existing catalog files, 2026-11-02.
;; This checks bounded fragments, not generated pages or translation quality.
(ns site.native.locale-render-catalog-file
 (:export [main]) (:capabilities [:cli/args :fs/app-data])
 (:require [site.native.locale-tree :as tree] [site.native.locale-catalog :as catalog] [site.native.locale-mark :as mark] [html-hiccup :as html]))

(defn- expected-0 [tag :string] :string
 (cond
  (string=? tag "ar") "تخطي إلى المحتوى"
  (string=? tag "arz") "اذهب للمحتوى"
  (string=? tag "bn") "বিষয়ে সরাসরি যান"
  (string=? tag "de") "Zum Inhalt springen"
  (string=? tag "es") "Saltar al contenido"
  (string=? tag "fr") "Passer au contenu"
  (string=? tag "hi") "सामग्री पर जाएं"
  (string=? tag "id") "Lewati ke konten"
  (string=? tag "ja") "コンテンツへスキップ"
  (string=? tag "ko") "내용으로 건너뛰기"
  (string=? tag "mr") "सामग्रीकडे जा"
  (string=? tag "pcm") "Skip go content"
  (string=? tag "pt") "Ir para o conteúdo"
  (string=? tag "ru") "Перейти к содержимому"
  (string=? tag "ur") "مواد پر جائیں"
  (string=? tag "zh-Hans") "跳转到内容"
  :else ""))

(defn- expected-1 [tag :string] :string
 (cond
  (string=? tag "ar") "المشغل العام"
  (string=? tag "arz") "المشغل العام"
  (string=? tag "bn") "পাবলিক অপারেটর"
  (string=? tag "de") "Öffentlicher Betreiber"
  (string=? tag "es") "Operador público"
  (string=? tag "fr") "Opérateur public"
  (string=? tag "hi") "सार्वजनिक ऑपरेटर"
  (string=? tag "id") "Operator publik"
  (string=? tag "ja") "公開オペレーター"
  (string=? tag "ko") "공개 운영자"
  (string=? tag "mr") "सार्वजनिक ऑपरेटर"
  (string=? tag "pcm") "Public operator"
  (string=? tag "pt") "Operador público"
  (string=? tag "ru") "Публичный оператор"
  (string=? tag "ur") "عوامی آپریٹر"
  (string=? tag "zh-Hans") "公共操作符"
  :else ""))

(defn- expected-2 [tag :string] :string
 (cond
  (string=? tag "ar") "جهة اتصال عامة"
  (string=? tag "arz") "التواصل العام"
  (string=? tag "bn") "পাবলিক যোগাযোগ"
  (string=? tag "de") "Öffentlicher Kontakt"
  (string=? tag "es") "Contacto público"
  (string=? tag "fr") "Contact public"
  (string=? tag "hi") "सार्वजनिक संपर्क"
  (string=? tag "id") "Kontak publik"
  (string=? tag "ja") "公開連絡先"
  (string=? tag "ko") "공개 연락처"
  (string=? tag "mr") "सार्वजनिक संपर्क"
  (string=? tag "pcm") "Public contact"
  (string=? tag "pt") "Contato público"
  (string=? tag "ru") "Публичный контакт"
  (string=? tag "ur") "عوامی رابطہ"
  (string=? tag "zh-Hans") "公开联系方式"
  :else ""))

(defn- expected-label [tag :string] :string
 (cond
  (string=? tag "ar") "العربية الفصحى"
  (string=? tag "arz") "العربية المصرية"
  (string=? tag "bn") "বাংলা"
  (string=? tag "de") "Deutsch"
  (string=? tag "es") "Español"
  (string=? tag "fr") "Français"
  (string=? tag "hi") "हिन्दी"
  (string=? tag "id") "Bahasa Indonesia"
  (string=? tag "ja") "日本語"
  (string=? tag "ko") "한국어"
  (string=? tag "mr") "मराठी"
  (string=? tag "pcm") "Naijá"
  (string=? tag "pt") "Português"
  (string=? tag "ru") "Русский"
  (string=? tag "ur") "اردو"
  (string=? tag "zh-Hans") "简体中文"
  :else ""))

(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0")
       first (expected-0 tag)]
  (if (string=? first "") 7
   (let [text (typed-cap-call :fs/app-data :string :string
                (string-concat "/site/i18n/" (string-concat tag ".json")))
         input (document-vector (document-keyword :section)
                 (document-map :aria-label (document-string "Public operator"))
                 (document-string "Skip to content")
                 (document-vector (document-keyword :code) (document-string "Public contact"))
                 (document-vector (document-keyword :p) (document-string "Public contact"))
                 (document-vector (document-keyword :span) (document-map :data-language-selector-current (document-bool true)) (document-string "Kotoba")))
         expected (document-vector (document-keyword :section)
                 (document-map :aria-label (document-string (expected-1 tag)))
                 (document-string first)
                 (document-vector (document-keyword :code) (document-string "Public contact"))
                 (document-vector (document-keyword :p) (document-string (expected-2 tag)))
                 (document-vector (document-keyword :span) (document-map :data-language-selector-current (document-bool true)) (document-string "Kotoba")))
         html-expected (string-concat "<section aria-label=\"" (string-concat (expected-1 tag) (string-concat "\">" (string-concat first (string-concat "<code>Public contact</code><p>" (string-concat (expected-2 tag) (string-concat "</p><span data-language-selector-current>" (string-concat (expected-label tag) "</span></section>"))))))))]
    (if (match-option (catalog/open-catalog text) [:option [:ref :site/catalog]]
          (none false)
          (some state
            (let [mapped (tree/map-indexed state input) value (option-value-of [:option :document] mapped (document-null))
                  rendered (html/render (mark/mark-language value tag) 0)]
             (and (option-some?-of [:option :document] mapped) (document-equal? value expected)
                  (option-some?-of [:option :string] rendered)
                  (string=? (option-value-of [:option :string] rendered "") html-expected)))))
       42 7)))))
