(ns site.native.library-summary-file (:export [main]) (:capabilities [:fs/app-data :io/write])
 (:require [site.native.input :as input] [site.native.library-aggregate-stream :as aggregate]))
(defn main [] :i64
 (match-option (aggregate/compute (input/read "/library-catalog.edn") (input/read "/library-taxonomy.edn")) [:option :string]
  (none 7)
  (some summary (let [ignored (typed-cap-call :io/write :string :string summary)] 42))))
