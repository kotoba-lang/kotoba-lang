(ns site.native.library-classifier-test (:export [main]) (:require [site.native.library-classifier :as classifier]))
(defn- matches [p :string h :string] :bool (classifier/matches? p h (vector-i64-from-bytes (string-to-utf8 h))))
(defn main [] :i64
 (if (and (matches "\\bos\\b" "os module") (not (matches "\\bos\\b" "kotobase")) (not (matches "\\bos\\b" "_os_"))
          (matches "\\bsha-?\\d" "sha256") (matches "\\bsha-?\\d" "sha-256") (not (matches "\\bsha-?\\d" "shark"))
          (matches "\\berc-?\\d+" "erc-721") (matches "\\biso ?20022\\b" "iso20022") (matches "\\biso ?20022\\b" "iso 20022")
          (matches "\\bdocs?\\b" "doc") (matches "\\bdocs?\\b" "docs") (not (matches "\\bdocs?\\b" "docstring"))
          (not (classifier/pattern-valid? "a.*" 0))) 42 7))
