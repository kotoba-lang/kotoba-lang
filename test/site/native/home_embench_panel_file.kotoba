(ns site.native.home-embench-panel-file (:export [main]) (:capabilities [:fs/app-data :io/write])
 (:require [site.native.home-embench-panel :as panel]))
(defn main [] :i64
 (let [r (panel/render (typed-cap-call :fs/app-data :string :string "/generator.cljk") (typed-cap-call :fs/app-data :string :string "/embench.json") (typed-cap-call :fs/app-data :string :string "/chart.cljk"))]
  (if (option-some?-of [:option :string] r) (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] r ""))] 42) 7)))
