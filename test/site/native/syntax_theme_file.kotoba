(ns site.native.syntax-theme-file (:export [main]) (:capabilities [:fs/app-data :io/write])
 (:require [site.native.syntax-theme :as theme]))
(defn main [] :i64
 (let [source (typed-cap-call :fs/app-data :string :string "/theme.json") result (theme/render source)]
  (if (option-some?-of [:option :string] result)
   (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))
