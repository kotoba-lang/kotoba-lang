(ns site.native.home-benchmark-domain-section-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.input :as input] [site.native.locale-catalog :as catalog] [site.native.home-benchmark-domain-section :as benchmark]))
(defn- locale? [s :string] :bool
 (or (string=? s "en") (string=? s "ar") (string=? s "arz") (string=? s "bn") (string=? s "de")
     (string=? s "es") (string=? s "fr") (string=? s "hi") (string=? s "id") (string=? s "ja")
     (string=? s "ko") (string=? s "mr") (string=? s "pcm") (string=? s "pt") (string=? s "ru")
     (string=? s "ur") (string=? s "zh-Hans")))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0")]
  (if (not (locale? tag)) 7
   (let [source (input/read (string-concat "/site/i18n/" (string-concat tag ".json")))]
    (match-option (catalog/open-catalog source) [:option [:ref :site/catalog]]
     (none 7)
     (some state
      (let [r (benchmark/render state tag (input/read "/generator.cljk")
                (input/read "/domain-benchmark.json") (input/read "/chart.cljk"))]
       (if (option-some?-of [:option :string] r)
        (let [ignored (typed-cap-call :io/write :string :string (option-value-of [:option :string] r ""))] 42) 7))))))))
