(ns site.native.app-css-file (:export [main]) (:capabilities [:fs/app-data :io/write])
 (:require [site.native.source-concat :as concat] [site.native.syntax-theme :as syntax]))
(defn main [] :i64
 (let [source (typed-cap-call :fs/app-data :string :string "/source.txt")
       theme-source (typed-cap-call :fs/app-data :string :string "/theme-source.txt")
       theme-json (typed-cap-call :fs/app-data :string :string "/theme.json")
       theme (concat/extract theme-source "(def css\n (str" "" "" false)
       syntax-css (syntax/render theme-json)]
  (if (and (option-some?-of [:option :string] theme) (option-some?-of [:option :string] syntax-css))
   (let [result (concat/extract source "(def app-css\n  (str" (option-value-of [:option :string] theme "") (option-value-of [:option :string] syntax-css "") true)]
    (if (option-some?-of [:option :string] result)
     (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)) 7)))
