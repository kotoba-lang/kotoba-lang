(ns site.native.home-benchmark-tail-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.home-benchmark-tail :as tail]))
(defn- read [path :string] :string (typed-cap-call :fs/app-data :string :string path))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0") result (tail/compose tag (read "/manifest.edn") (read "/domain.html") (read "/evidence.html"))]
  (if (option-some?-of [:option :string] result)
   (let [ignored (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))
