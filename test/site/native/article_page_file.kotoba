(ns site.native.article-page-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.dds-base-css :as base] [site.native.dds-ext-css :as ext]
           [site.native.dds-palette :as palette] [site.native.dds-skin-css :as skin]
           [site.native.source-concat :as concat] [site.native.syntax-theme :as syntax]
           [multiformats.sha256 :as sha] [site.native.locale-catalog :as catalog]
           [site.native.article-head :as head] [site.native.article-body :as body]))
(defn- val [x [:option :string]] :string (option-value-of [:option :string] x ""))
(defn- read [path :string] :string (typed-cap-call :fs/app-data :string :string path))
(defn- digest? [s :string expected :string] :bool (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) expected))
(defn- emit [prefix :string x [:option :string]] :bool
 (if (not (option-some?-of [:option :string] x)) false
  (let [ignored (typed-cap-call :io/write :string :string (string-concat prefix (val x)))] true)))
(defn- app [generator :string theme-source :string theme-json :string] [:option :string]
 (let [theme (concat/extract theme-source "(def css\n (str" "" "" false) syntax-css (syntax/render theme-json)]
  (if (and (option-some?-of [:option :string] theme) (option-some?-of [:option :string] syntax-css))
   (concat/extract generator "(def app-css\n  (str" (val theme) (val syntax-css) true) (option-none-of [:option :string]))))
;; The pinned graph literal contains one CLJK Unicode escape; decode that
;; bounded literal before passing it to the native EDN reader.
(defn- graph [source :string] [:option :string]
 (let [start (string-index-of source "(def security-graph-css ")]
  (if (< start 0) (option-none-of [:option :string])
   (let [tail (string-substring source start (string-byte-length source)) nl (string-index-of tail "\n")]
    (if (< nl 0) (option-none-of [:option :string])
     (concat/literal (string-replace-all (string-substring tail 0 nl) "\\u2193" "↓") "(def security-graph-css "))))))
(defn- docval [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- docstr [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn main [] :i64
 (let [dds (read "/dds.css") lang (read "/language.css") box (read "/box.css") menu (read "/menu.css")
       behavior (read "/behavior.cljk") core (read "/core.cljk") tokens (read "/tokens.cljk")
       generator (read "/generator.cljk") theme-source (read "/theme-source.cljk") theme-json (read "/theme.json") route (typed-cap-call :cli/args :string :string "0")
       valid-route (or (string=? route "infra") (string=? route "security"))
       security (string=? route "security")
       article (document-edn-read (read (if security "/site/security-article.edn" "/site/infra-cost-article.edn")))
       title (docval (document-get article :title)) desc (docval (document-get article :description))
       catalog-json (read "/site/i18n/en.json")
       basepath (if security "/blog/csf2-attack-graphs/" "/blog/infra-cost-measured-path/")]
  (if (not (and valid-route (= (document-kind title) :string) (= (document-kind desc) :string))) 7
   (match-option (catalog/open-catalog catalog-json) [:option [:ref :site/catalog]]
    (none 7)
    (some state
     (if (and (or (string=? route "infra") (string=? route "security"))
           (arena-scope (digest? generator "b129ac603b9ec3ee679874193c2513c985e26def60daaae5303fabadf90367a7"))
           (arena-scope (digest? theme-source "4f6a44a9b90ba83719530677c324ea638fbe25da267d0e37213e23e594a7e917"))
           (arena-scope (emit "<!DOCTYPE html>\n<html lang=\"en\">" (head/before-style state "en" basepath (docstr title) (docstr desc) dds)))
           (arena-scope (emit "" (base/render dds lang box menu behavior)))
           (arena-scope (emit "\n" (ext/render core)))
           (arena-scope (emit "\n" (palette/theme-css dds)))
           (arena-scope (emit "\n" (skin/skin tokens)))
           (arena-scope (emit "\n" (app generator theme-source theme-json)))
           (if security (arena-scope (emit "\n" (graph generator))) true)
           (arena-scope (emit "" (head/after-style state "en" basepath (docstr title) (docstr desc) generator behavior theme-source)))
           (arena-scope (emit "" (body/render-body state "en" basepath article (if security "Security engineering" "Draft · 10 September 2026 · Infrastructure") "site/native/article_body.kotoba")))
           (arena-scope (emit "" (option-some-of [:option :string] "</html>")))) 42 7))))))
