(ns site.native.locale-placeholders-test
  (:export [main])
  (:require [site.native.locale-placeholders :as locale]))

(defn main [] :i64
  (if (and (locale/placeholders-match? "Hello {name}, {count}!" "{count}件、{name}さん")
           (locale/placeholders-match? "{x} {x} {Y_}" "{Y_} {x} {x}")
           (locale/placeholders-match? "日本語 {a1} {} {a-b}" "עברית")
           (locale/placeholders-match? "" "")
           (not (locale/placeholders-match? "{x} {x}" "{x}"))
           (not (locale/placeholders-match? "{x}" "{y}"))
           (not (locale/placeholders-match? "" "{extra}"))
           (not (locale/placeholders-match? "{Name}" "{name}")))
    42
    7))
