(ns site.native.compile-caption-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.locale-catalog :as catalog] [site.native.locale-message :as message] [multiformats.sha256 :as sha]))
(defn- locale? [s :string] :bool
 (or (string=? s "en") (string=? s "ar") (string=? s "arz") (string=? s "bn") (string=? s "de")
     (string=? s "es") (string=? s "fr") (string=? s "hi") (string=? s "id") (string=? s "ja")
     (string=? s "ko") (string=? s "mr") (string=? s "pcm") (string=? s "pt") (string=? s "ru")
     (string=? s "ur") (string=? s "zh-Hans")))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0") generator (typed-cap-call :fs/app-data :string :string "/generator.cljk")
       expected "ca2955ee08ec6891787d7636238b1bc7b0ab64b807c4c8ce653ec03657d6c072"]
  (if (or (not (locale? tag)) (not (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 generator))) expected)))) 7
   (let [json (typed-cap-call :fs/app-data :string :string (string-concat "/site/i18n/" (string-concat tag ".json")))]
    (match-option (catalog/open-catalog json) [:option [:ref :site/catalog]]
     (none 7)
     (some state
      (let [a (message/translate-indexed state "Compile locally: kotoba compile double-21.kotoba --target wasm -o double-21.wasm")
            b (message/translate-indexed state "The locally built file is separate from the precompiled browser demo.")]
       (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
        (let [output (string-concat (option-value-of [:option :string] a "") (string-concat "\n" (option-value-of [:option :string] b "")))
              ignore (typed-cap-call :io/write :string :string output)] 42) 7))))))))
