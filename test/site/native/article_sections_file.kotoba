(ns site.native.article-test (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.locale-catalog :as catalog] [site.native.article-section :as article]))
(defn- sections [state [:ref :site/article-context] xs :document] :i64
 (loop [i 0]
  (if (>= i (document-count xs)) 42
   (let [section (option-value-of [:option :document] (document-vector-at xs i) (document-null))
         out (article/render-section state section)]
    (if (not (option-some?-of [:option :string] out)) (+ 10 i)
     (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] out ""))]
      (recur (+ i 1))))))))
(defn main [] :i64
 (let [arg (typed-cap-call :cli/args :string :string "0")
       path (if (string=? arg "security") "/site/security-article.edn" "/site/infra-cost-article.edn")
       tag (typed-cap-call :cli/args :string :string "1")
       allowed (or (string=? tag "en") (string=? tag "ar") (string=? tag "arz") (string=? tag "bn") (string=? tag "de") (string=? tag "es") (string=? tag "fr") (string=? tag "hi") (string=? tag "id") (string=? tag "ja") (string=? tag "ko") (string=? tag "mr") (string=? tag "pcm") (string=? tag "pt") (string=? tag "ru") (string=? tag "ur") (string=? tag "zh-Hans"))]
  (if (not (and allowed (or (string=? arg "security") (string=? arg "infra")))) 7
   (let [doc (document-edn-read (typed-cap-call :fs/app-data :string :string path))
         xs (option-value-of [:option :document] (document-get doc :sections) (document-null))
         cat (typed-cap-call :fs/app-data :string :string (string-concat "/site/i18n/" (string-concat tag ".json")))]
    (if (not (= (document-kind xs) :vector)) 7
     (match-option (catalog/open-catalog cat) [:option [:ref :site/catalog]]
      (none 7) (some state
       (let [base (if (string=? arg "security") "/blog/csf2-attack-graphs/" "/blog/infra-cost-measured-path/")
             ctx (record-new [:ref :site/article-context] state tag base)
             link (document-map :title (document-string "Kotoba") :link
                    (document-map :href (document-string "../../libraries/#catalog") :label (document-string "GitHub")))
             invalid (document-map :title (document-string "Kotoba") :link
                    (document-map :href (document-string "%2e%2e/libraries/") :label (document-string "GitHub")))
             html (article/render-section ctx link)
             expected (if (string=? tag "en") "href=\"../../libraries/#catalog\"" (string-concat "href=\"/" (string-concat tag "/libraries/#catalog\"")))]
        (if (and (option-some?-of [:option :string] html)
                 (string-contains? (option-value-of [:option :string] html "") expected)
                 (or (string=? tag "en") (not (option-some?-of [:option :string] (article/render-section ctx invalid)))))
          (sections ctx xs) 8)))))))))
