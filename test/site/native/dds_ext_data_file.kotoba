(ns site.native.dds-ext-data-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.dds-ext-data :as data]))
(defn main [] :i64
 (let [source (typed-cap-call :fs/app-data :string :string "/core.cljk") mode (typed-cap-call :cli/args :string :string "0")
       result (cond (string=? mode "rules") (data/rules source) (string=? mode "media") (data/media source)
                    :else (option-none-of [:option :document]))]
  (if (option-some?-of [:option :document] result)
   (let [ignore (typed-cap-call :io/write :string :string (document-edn-print (option-value-of [:option :document] result (document-null))))] 42) 7)))
