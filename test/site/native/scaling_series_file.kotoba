(ns site.native.scaling-series-file (:export [main]) (:capabilities [:fs/app-data :io/write])
 (:require [site.native.scaling-series :as series] [json.core :as json]))
(defn main [] :i64
 (let [report (typed-cap-call :fs/app-data :string :string "/scaling-benchmark.json") r (series/geometry report)]
  (if (option-some?-of [:option :document] r)
   (let [out (json/encode (option-value-of [:option :document] r (document-null))) ignored (typed-cap-call :io/write :string :string out)] 42) 7)))
