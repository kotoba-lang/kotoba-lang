(ns site.native.hosting-metadata-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.hosting-metadata :as hosting]))
(defn- read [path :string] :string (typed-cap-call :fs/app-data :string :string path))
(defn main [] :i64
 (let [kind (typed-cap-call :cli/args :string :string "0") result (hosting/render kind (read "/headers") (read "/generator") (read "/play-source"))]
  (if (option-some?-of [:option :string] result)
   (let [ignored (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))
