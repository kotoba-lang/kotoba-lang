(ns site.native.locale-catalog-file
  (:export [main])
  (:capabilities [:cli/args :fs/app-data])
  (:require [site.native.locale-catalog :as catalog]))

(defn- locale? [tag :string] :bool
  (or (= tag "ar") (= tag "arz") (= tag "bn") (= tag "de") (= tag "es")
      (= tag "fr") (= tag "hi") (= tag "id") (= tag "ja") (= tag "ko")
      (= tag "mr") (= tag "pcm") (= tag "pt") (= tag "ru") (= tag "ur") (= tag "zh-Hans")))

(defn main [] :i64
  (let [tag (typed-cap-call :cli/args :string :string "0")]
    (if (not (locale? tag)) 7
      (let [source (typed-cap-call :fs/app-data :string :string "/site/i18n/en.json")
            target (typed-cap-call :fs/app-data :string :string
                     (string-concat "/site/i18n/" (string-concat tag ".json")))]
        (if (catalog/catalogs-meet-minimum? source target 901) 42 7)))))
