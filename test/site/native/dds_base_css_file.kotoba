(ns site.native.dds-base-css-file (:export [main]) (:capabilities [:fs/app-data :io/write])
 (:require [site.native.dds-base-css :as css]))
(defn main [] :i64
 (let [base (typed-cap-call :fs/app-data :string :string "/dds.css")
       language (typed-cap-call :fs/app-data :string :string "/language.css")
       box (typed-cap-call :fs/app-data :string :string "/box.css")
       menu (typed-cap-call :fs/app-data :string :string "/menu.css")
       behavior (typed-cap-call :fs/app-data :string :string "/behavior.cljk")
       result (css/render base language box menu behavior)]
  (if (option-some?-of [:option :string] result)
   (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))
