(ns site.native.article-head-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.locale-catalog :as catalog] [site.native.article-head :as head]))
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- txt [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn main [] :i64
 (let [arg (typed-cap-call :cli/args :string :string "0")
       known (or (string=? arg "infra") (string=? arg "security"))]
  (if (not known) 7
   (let [security (string=? arg "security") file (if security "/site/security-article.edn" "/site/infra-cost-article.edn")
         base (if security "/blog/csf2-attack-graphs/" "/blog/infra-cost-measured-path/")
         article (document-edn-read (typed-cap-call :fs/app-data :string :string file))
         title (val (document-get article :title)) desc (val (document-get article :description))
         json (typed-cap-call :fs/app-data :string :string "/site/i18n/en.json")
         dds (typed-cap-call :fs/app-data :string :string "/dds.css") generator (typed-cap-call :fs/app-data :string :string "/generator.cljk")
         behavior (typed-cap-call :fs/app-data :string :string "/behavior.cljk") theme (typed-cap-call :fs/app-data :string :string "/theme.cljk")]
    (if (or (not (= (document-kind title) :string)) (not (= (document-kind desc) :string))) 7
     (match-option (catalog/open-catalog json) [:option [:ref :site/catalog]]
      (none 7)
      (some state
       (let [a (head/before-style state "en" base (txt title) (txt desc) dds)
             b (head/after-style state "en" base (txt title) (txt desc) generator behavior theme)]
        (if (not (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))) 7
         (let [ignore (typed-cap-call :io/write :string :string (string-concat (option-value-of [:option :string] a "") (option-value-of [:option :string] b "")))] 42))))))))))
