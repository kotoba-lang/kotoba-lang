(ns site.native.scaling-axis-test (:export [main]) (:require [site.native.scaling-axis :as axis]))
(defn- near? [x :f64 lo :f64 hi :f64 which :keyword expected :f64] :bool
 (let [r (axis/coordinate (document-f64 x) (document-f64 lo) (document-f64 hi) which)
       d (option-value-of [:option :document] r (document-null))
       got (option-value-of [:option :f64] (document-f64-value d) 0.0)]
  (and (option-some?-of [:option :document] r) (f64-lt (f64-abs (f64-sub got expected)) 0.00000001))))
(defn- refused? [x :document lo :document hi :document which :keyword] :bool
 (not (option-some?-of [:option :document] (axis/coordinate x lo hi which))))
(defn main [] :i64
 (if (and (near? 1.0 1.0 2048.0 :x 72.0) (near? 32.0 1.0 2048.0 :x 315.6363636363636)
          (near? 128.0 1.0 2048.0 :x 413.09090909090907) (near? 2048.0 1.0 2048.0 :x 608.0)
          (near? 11.753 11.753 23725.327 :y 312.0) (near? 20.0 11.753 23725.327 :y 291.4620917579816)
          (near? 1000.0 11.753 23725.327 :y 140.33120253468297) (near? 23725.327 11.753 23725.327 :y 18.0)
          (refused? (document-i64 0) (document-i64 0) (document-i64 1) :x)
          (refused? (document-i64 5) (document-i64 5) (document-i64 5) :x)
          (refused? (document-i64 11) (document-i64 1) (document-i64 10) :y)
          (refused? (document-i64 5) (document-i64 1) (document-i64 10) :unknown)
          (refused? (document-string "5") (document-i64 1) (document-i64 10) :x)) 42 7))
