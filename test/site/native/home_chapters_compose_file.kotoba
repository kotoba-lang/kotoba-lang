(ns site.native.home-chapters-compose-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.home-chapters-compose :as chapters]))
(defn- read [path :string] :string (typed-cap-call :fs/app-data :string :string path))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0")
       result (chapters/compose tag (read "/manifest.edn") (read "/opening.html") (read "/evidence.html") (read "/benchmark.html") (read "/developer.html") (read "/library.html") (read "/closing.html"))]
  (if (option-some?-of [:option :string] result)
   (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))
