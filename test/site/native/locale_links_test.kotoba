(ns site.native.locale-links-test (:export [main]) (:require [site.native.locale-links :as l]))
(defn- ok [base :string href :string expected :string] :bool
 (let [o (l/resolve-link "ja" base href)]
  (and (option-some?-of [:option :string] o) (string=? (option-value-of [:option :string] o "") expected))))
(defn main [] :i64
 (if (and (ok "/blog/" "../#top" "/ja/#top")
          (ok "/blog/" "../libraries/?a=1#x" "/ja/libraries/?a=1#x")
          (ok "/blog/" "../assets/x.png" "/assets/x.png")
          (ok "/blog/" "?x=1#f" "/ja/blog/?x=1#f")
          (ok "/blog/" "#same" "#same")
          (ok "/blog/" "https://example.test/a" "https://example.test/a")
          (ok "/blog/" "//cdn.test/a" "//cdn.test/a")
          (ok "/blog/" ".././legal/../" "/ja/")
          (ok "/blog/" "/a//../" "/a/")
          (not (option-some?-of [:option :string] (l/resolve-link "ja" "/blog/" "%2e%2e/a")))
          (not (option-some?-of [:option :string] (l/resolve-link "../ja" "/blog/" "./")))
          (not (option-some?-of [:option :string] (l/resolve-link "ja" "/unknown/" "./")))) 42 7))
