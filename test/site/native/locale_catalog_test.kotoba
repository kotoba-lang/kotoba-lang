(ns site.native.locale-catalog-test
  (:export [main])
  (:require [site.native.locale-catalog :as catalog]))

(defn- a [] :string "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
(defn- b [] :string "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
(defn- field [key :string value :string] :string
  (string-concat "\"" (string-concat key (string-concat "\":\"" (string-concat value "\"")))))
(defn- object [field1 :string field2 :string] :string
  (string-concat "{" (string-concat field1 (string-concat "," (string-concat field2 "}")))))

(defn main [] :i64
  (let [source (object (field (a) "Hi {name} {name}") (field (b) "Other {count}"))
        valid (object (field (b) "日本語 {count}") (field (a) "{name}と{name}"))
        missing (string-concat "{" (string-concat (field (a) "{name} {name}") "}"))
        wrong (object (field (a) "{name}") (field (b) "{count}"))
        blank (object (field (a) "  ") (field (b) "{count}"))
        escaped-blank (object (field (a) "\\n\\t") (field (b) "{count}"))
        duplicate (object (field (a) "{name} {name}") (field (a) "{name} {name}"))
        comma (string-concat "{" (string-concat (field (a) "{name} {name}") ",}"))
        extra (string-concat "{" (string-concat (field (a) "{name} {name}")
                (string-concat "," (string-concat (field (b) "{count}")
                  (string-concat "," (string-concat (field "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" "extra") "}"))))))
        unicode (object (field (a) "\\u007bname\\u007d \\u007bname}")
                        (field (b) "\\ud83d\\ude80 {count}"))
        unicode-blank (object (field (a) "\\u0020\\u000a") (field (b) "{count}"))
        unicode-space (object (field (a) "\\u00A0") (field (b) "{count}"))
        bad-high (object (field (a) "\\ud83d{name} {name}") (field (b) "{count}"))
        bad-pair (object (field (a) "\\ud83d\\u0041{name} {name}") (field (b) "{count}"))
        bad-low (object (field (a) "\\ude80{name} {name}") (field (b) "{count}"))
        bad-hex (object (field (a) "\\uZZZZ{name} {name}") (field (b) "{count}"))
        escaped-key (object (field (string-concat "\\u0061" (string-substring (a) 1 64)) "{name} {name}")
                            (field (b) "{count}"))]
    (if (and (catalog/catalogs-match? source valid)
             (catalog/catalogs-meet-minimum? source valid 2)
             (not (catalog/catalogs-meet-minimum? source valid 3))
             (catalog/catalogs-match? source extra)
             (catalog/catalogs-match? source unicode)
             (not (catalog/catalogs-match? source missing))
             (not (catalog/catalogs-match? source wrong))
             (not (catalog/catalogs-match? source blank))
             (not (catalog/catalogs-match? source escaped-blank))
             (not (catalog/catalogs-match? source unicode-blank))
             (not (catalog/catalogs-match? source unicode-space))
             (not (catalog/catalogs-match? source duplicate))
             (not (catalog/catalogs-match? source comma))
             (not (catalog/catalogs-match? "{}" "{}"))
             (not (catalog/catalogs-match? source bad-high))
             (not (catalog/catalogs-match? source bad-pair))
             (not (catalog/catalogs-match? source bad-low))
             (not (catalog/catalogs-match? source bad-hex))
             (catalog/catalogs-match? (object (field (a) "x") (field (b) "y"))
                                      (object (field (a) "\\u00A0") (field (b) "y")))
             (catalog/catalogs-match? (object (field (a) "x") (field (b) "y"))
                                      (object (field (a) "\\uFEFF") (field (b) "y")))
             (not (catalog/catalogs-match? (object (field (a) "x") (field (b) "y"))
                                           (object (field (a) "\\u001C") (field (b) "y"))))
             (not (catalog/catalogs-match? source escaped-key))
             (string=? (option-value-of [:option :string] (catalog/catalog-value valid (b)) "missing") "日本語 {count}")
             (string=? (option-value-of [:option :string] (catalog/catalog-value unicode (b)) "missing") "🚀 {count}")
             (string=? (option-value-of [:option :string] (catalog/catalog-value (object (field (a) "a\\nb\\\"c\\\\d") (field (b) "other")) (a)) "missing") "a\nb\"c\\d")
             (not (option-some?-of [:option :string] (catalog/catalog-value missing (b))))
             (not (option-some?-of [:option :string] (catalog/catalog-value blank (a))))
             (not (option-some?-of [:option :string] (catalog/catalog-value duplicate (a))))
             (not (option-some?-of [:option :string] (catalog/catalog-value bad-high (a))))
             (not (option-some?-of [:option :string] (catalog/catalog-value valid "short")))) 42 7)))
