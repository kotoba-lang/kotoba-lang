(ns site.native.article-body-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.locale-catalog :as catalog] [site.native.article-body :as body]))
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- txt [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn main [] :i64
 (let [arg (typed-cap-call :cli/args :string :string "0") tag (typed-cap-call :cli/args :string :string "1")
       known (or (string=? tag "en") (string=? tag "ar") (string=? tag "arz") (string=? tag "bn") (string=? tag "de")
                 (string=? tag "es") (string=? tag "fr") (string=? tag "hi") (string=? tag "id") (string=? tag "ja")
                 (string=? tag "ko") (string=? tag "mr") (string=? tag "pcm") (string=? tag "pt") (string=? tag "ru")
                 (string=? tag "ur") (string=? tag "zh-Hans"))]
  (if (not (and known (or (string=? arg "infra") (string=? arg "security") (string=? arg "parity") (string=? arg "progress") (string=? arg "usage")))) 7
   (let [security (string=? arg "security") parity (string=? arg "parity") progress (string=? arg "progress") usage (string=? arg "usage")
         bilingual (or parity progress usage)
         file (cond security "/site/security-article.edn" parity "/site/embench-c-parity-article.edn" progress "/site/embench-progress-article.edn" usage "/site/usage-article.edn" :else "/site/infra-cost-article.edn")
         base (cond security "/blog/csf2-attack-graphs/" parity "/blog/embench-c-parity-20261015/" progress "/blog/embench-progress-20261012/" usage "/blog/kotoba-murakumo-how-to-use-20261015/" :else "/blog/infra-cost-measured-path/")
         source (document-edn-read (typed-cap-call :fs/app-data :string :string file))
         article (if bilingual (val (document-get source (if (string=? tag "ja") :ja :en))) source)
         title (val (document-get article :title)) desc (val (document-get article :description))
         json (typed-cap-call :fs/app-data :string :string (string-concat "/site/i18n/" (string-concat tag ".json")))]
    (if (or (not (= (document-kind title) :string)) (not (= (document-kind desc) :string))) 7
     (match-option (catalog/open-catalog json) [:option [:ref :site/catalog]]
      (none 7)
      (some state
       (let [eyebrow (cond parity (if (string=? tag "ja") "2026年10月15日 · Embench IoT · 探索的測定" "15 October 2026 · Embench IoT · Exploratory")
                           progress (if (string=? tag "ja") "2026年10月13日 · ネイティブ性能 · 停止中" "13 October 2026 · Native performance · Paused")
                           usage (if (string=? tag "ja") "2026年10月15日 · 使い方" "15 October 2026 · How to use")
                           security "Security engineering" :else "Draft · 10 September 2026 · Infrastructure")
             result (if bilingual (body/render-prelocalized-body state tag base article eyebrow "site/native/article_body.kotoba")
                      (body/render-body state tag base article eyebrow "site/native/article_body.kotoba"))]
        (if (not (option-some?-of [:option :string] result)) 7
         (let [ignore (typed-cap-call :io/write :string :string
                       (option-value-of [:option :string] result ""))] 42))))))))))
