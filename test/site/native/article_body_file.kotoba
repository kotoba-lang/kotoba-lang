(ns site.native.article-body-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.locale-catalog :as catalog] [site.native.article-body :as body]))
(defn- val [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- txt [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn main [] :i64
 (let [arg (typed-cap-call :cli/args :string :string "0") tag (typed-cap-call :cli/args :string :string "1")
       known (or (string=? tag "en") (string=? tag "ar") (string=? tag "arz") (string=? tag "bn") (string=? tag "de")
                 (string=? tag "es") (string=? tag "fr") (string=? tag "hi") (string=? tag "id") (string=? tag "ja")
                 (string=? tag "ko") (string=? tag "mr") (string=? tag "pcm") (string=? tag "pt") (string=? tag "ru")
                 (string=? tag "ur") (string=? tag "zh-Hans"))]
  (if (not (and known (or (string=? arg "infra") (string=? arg "security")))) 7
   (let [security (string=? arg "security")
         file (if security "/site/security-article.edn" "/site/infra-cost-article.edn")
         base (if security "/blog/csf2-attack-graphs/" "/blog/infra-cost-measured-path/")
         article (document-edn-read (typed-cap-call :fs/app-data :string :string file))
         title (val (document-get article :title)) desc (val (document-get article :description))
         json (typed-cap-call :fs/app-data :string :string (string-concat "/site/i18n/" (string-concat tag ".json")))]
    (if (or (not (= (document-kind title) :string)) (not (= (document-kind desc) :string))) 7
     (match-option (catalog/open-catalog json) [:option [:ref :site/catalog]]
      (none 7)
      (some state
       (let [result (body/render-body state tag base article (if security "Security engineering" "Draft · 10 September 2026 · Infrastructure") "site/native/article_body.kotoba")]
        (if (not (option-some?-of [:option :string] result)) 7
         (let [ignore (typed-cap-call :io/write :string :string
                       (option-value-of [:option :string] result ""))] 42))))))))))
