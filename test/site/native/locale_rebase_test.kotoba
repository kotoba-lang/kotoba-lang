(ns site.native.locale-rebase-test (:export [main]) (:require [site.native.locale-rebase :as r]))
(defn main [] :i64
 (let [input (document-vector (document-keyword :div)
               (document-vector (document-keyword :a) (document-map :href (document-string "../libraries/#catalog")) (document-string "Library"))
               (document-vector (document-keyword :img) (document-map :src (document-string "../logo.png")))
               (document-vector (document-keyword :pre) (document-vector (document-keyword :a) (document-map :href (document-string "../libraries/"))))
               (document-vector (document-keyword :span) (document-map :translate (document-string "no"))
                (document-vector (document-keyword :a) (document-map :href (document-string "../libraries/")))))
       expected (document-vector (document-keyword :div)
               (document-vector (document-keyword :a) (document-map :href (document-string "/ja/libraries/#catalog")) (document-string "Library"))
               (document-vector (document-keyword :img) (document-map :src (document-string "/logo.png")))
               (document-vector (document-keyword :pre) (document-vector (document-keyword :a) (document-map :href (document-string "../libraries/"))))
               (document-vector (document-keyword :span) (document-map :translate (document-string "no"))
                (document-vector (document-keyword :a) (document-map :href (document-string "../libraries/")))))
       result (r/rebase-links input "ja" "/blog/")
       bad (r/rebase-links (document-vector (document-keyword :a) (document-map :href (document-string "%2e%2e/a"))) "ja" "/blog/")]
  (if (and (option-some?-of [:option :document] result)
           (document-equal? (option-value-of [:option :document] result (document-null)) expected)
           (not (option-some?-of [:option :document] bad))) 42 7)))
