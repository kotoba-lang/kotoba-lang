(ns site.native.library-rows-file (:export [main]) (:capabilities [:fs/app-data :io/write])
 (:require [site.native.library-row :as row] [site.native.library-classifier :as classifier] [site.native.library-catalog-stream :as scan] [multiformats.sha256 :as sha]))
;; The caller stages stdout and must discard it on any non-42 exit.
(defn- emit [taxonomy :document locations :string repo :document] :i64
 (let [r (row/render taxonomy locations repo)]
  (if (not (option-some?-of [:option :string] r)) 7
   (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] r ""))] 0))))
(defn- rows [taxonomy :document locations :string catalog :string pos :i64 count :i64] :i64
 (let [begin (scan/begin catalog pos)]
  (cond (= begin 0) (if (= count 2215) 42 7)
        (< begin 0) 7
        :else (let [end (scan/end catalog begin)]
                (if (<= end begin) 7
                 (let [status (arena-scope (emit taxonomy locations (document-edn-read (string-substring catalog begin end))))]
                  (if (= status 0) (rows taxonomy locations catalog end (+ count 1)) 7)))))))
(defn- digest? [s :string expected :string] :bool
 (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) expected)))
(defn main [] :i64
 (let [catalog (typed-cap-call :fs/app-data :string :string "/library-catalog.edn") taxonomy-text (typed-cap-call :fs/app-data :string :string "/library-taxonomy.edn")
       locations (typed-cap-call :fs/app-data :string :string "/library-locations.edn") generator (typed-cap-call :fs/app-data :string :string "/generator.cljk")
       ok (and (digest? catalog "154244b0400f3b87431ae24495c738675f2ba73bd4ba81af202f9e9b4c6e84fa")
               (digest? taxonomy-text "827d2160f70a25e4af638423da4d9e022a42669d174a15d2e4121d00774183d0")
               (digest? locations "dacc36cf3f4e45a097ea85bf1c1c5227a507eaba8aa86efc15496303b48b8010")
               (digest? generator "ca2955ee08ec6891787d7636238b1bc7b0ab64b807c4c8ce653ec03657d6c072"))
       taxonomy (if ok (document-edn-read taxonomy-text) (document-null))]
  (if (or (not ok) (not (classifier/taxonomy-valid? taxonomy))) 7 (rows taxonomy locations catalog (scan/start catalog) 0))))
