(ns site.native.sitemap-test (:export [main]) (:require [site.native.sitemap :as sitemap]))
(defn- put [v :vector-i64 slot :i64 s :string] :vector-i64
 (let [offset (* slot 1025) n (string-byte-length s) ignored (vector-assoc! v offset n)]
  (loop [i 0]
   (if (>= i n) v (let [ignored (vector-assoc! v (+ (+ offset 1) i) (string-code-point-at s i))] (recur (+ i 1)))))))
(defn main [] :i64
 (let [a (sitemap/canonical "<link rel=\"canonical\" href=\"https://kotoba-lang.org/z/\">")
       b (sitemap/canonical "<link rel=\"canonical\" href=\"https://kotoba-lang.org/a/\">")
       invalid (sitemap/canonical "<link rel=\"canonical\" href=\"https://kotoba-lang.org.evil/x\">")
       badxml (sitemap/canonical "<link rel=\"canonical\" href=\"https://kotoba-lang.org/a&b\">")
       duplicate (sitemap/canonical "<link rel=\"canonical\" href=\"https://kotoba-lang.org/a\"><link rel=\"canonical\" href=\"https://kotoba-lang.org/b\">")
       absent (sitemap/canonical "<p>no canonical</p>")
       entries (put (put (put (vector-alloc 3075) 0 a) 1 b) 2 a)
       result (sitemap/render entries 3) actual (option-value-of [:option :string] result "")
       expected "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n<url><loc>https://kotoba-lang.org/a/</loc></url>\n<url><loc>https://kotoba-lang.org/z/</loc></url>\n</urlset>\n"]
  (if (and (option-some?-of [:option :string] result) (string=? actual expected)
           (string=? invalid ":invalid") (string=? badxml ":invalid") (string=? duplicate ":invalid") (string=? absent "")) 42 7)))
