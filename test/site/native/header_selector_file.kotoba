(ns site.native.header-selector-file (:export [main]) (:capabilities [:cli/args :io/write])
 (:require [site.native.header-selector :as selector]))
(defn- locale? [s :string] :bool
 (or (string=? s "en") (string=? s "ar") (string=? s "arz") (string=? s "bn") (string=? s "de")
     (string=? s "es") (string=? s "fr") (string=? s "hi") (string=? s "id") (string=? s "ja")
     (string=? s "ko") (string=? s "mr") (string=? s "pcm") (string=? s "pt") (string=? s "ru")
     (string=? s "ur") (string=? s "zh-Hans")))
(defn main [] :i64
 (let [which (typed-cap-call :cli/args :string :string "0") tag (typed-cap-call :cli/args :string :string "1")
       home (string=? which "home") infra (string=? which "infra") security (string=? which "security")]
  (if (not (and (locale? tag) (or home infra security))) 7
   (let [base (if home "/" (if infra "/blog/infra-cost-measured-path/" "/blog/csf2-attack-graphs/"))
         result (selector/render-selector tag base)]
    (if (not (option-some?-of [:option :string] result)) 7
     (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42))))))
