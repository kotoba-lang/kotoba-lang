(ns site.native.legal-document-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.home-document :as document]))
(defn- read [p :string] :string (typed-cap-call :fs/app-data :string :string p))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0")
       result (document/compose tag (read "/document-manifest.edn") (read "/head.html") (read "/body.html"))]
  (if (option-some?-of [:option :string] result)
   (let [ignored (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))
