(ns site.native.header-scripts-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.header-scripts :as scripts]))
(defn main [] :i64
 (let [mode (typed-cap-call :cli/args :string :string "0")
       generator (typed-cap-call :fs/app-data :string :string "/generator.cljk")
       behavior (typed-cap-call :fs/app-data :string :string "/behavior.cljk")
       theme (typed-cap-call :fs/app-data :string :string "/theme.cljk")
       output (cond (string=? mode "theme") (scripts/theme-script generator theme)
                    (string=? mode "menu") (scripts/menu-script generator behavior)
                    :else (option-none-of [:option :string]))]
  (if (option-some?-of [:option :string] output)
   (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] output ""))] 42) 7)))
