(ns site.native.library-catalog-stream-test (:export [main]) (:require [site.native.library-catalog-stream :as scan]))
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- name [d :document] :string (option-value-of [:option :string] (document-string-value (val (document-get d :name))) ""))
(defn main [] :i64
 (let [s "{:repos [{:name \"a}\\\"x\" :nested {:a 1}} ; comment }\n {:name \"二\"}]}"
       a (scan/begin s (scan/start s)) ae (scan/end s a) b (scan/begin s ae) be (scan/end s b)
       first (if (and (> a 0) (> ae a)) (document-edn-read (string-substring s a ae)) (document-null))
       second (if (and (> b 0) (> be b)) (document-edn-read (string-substring s b be)) (document-null))
       broken "{:repos [{:name \"unterminated}]}"]
  (if (and (string=? (name first) "a}\"x") (string=? (name second) "二") (= (scan/begin s be) 0)
           (= (scan/end broken (scan/begin broken (scan/start broken))) -1) (= (scan/start "{:other []}") -1)) 42 7)))
