(ns site.native.home-benchmark-cards-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.home-benchmark-cards :as cards]))
(defn- read [s :string] :string (typed-cap-call :fs/app-data :string :string s))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0")
       out (cards/compose tag (read "/manifest.edn") (read "/startup.html") (read "/coverage.html") (read "/speed.html") (read "/loop.html") (read "/scaling.html") (read "/domain.html"))]
  (if (option-some?-of [:option :string] out)
   (let [ignored (typed-cap-call :io/write :string :string (option-value-of [:option :string] out ""))] 42) 7)))
