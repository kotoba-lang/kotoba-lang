(ns site.native.source-concat-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.source-concat :as concat]))
(defn main [] :i64
 (let [mode (typed-cap-call :cli/args :string :string "0")
       source (typed-cap-call :fs/app-data :string :string "/source.txt")
       theme (typed-cap-call :fs/app-data :string :string "/theme.txt")
       syntax (typed-cap-call :fs/app-data :string :string "/syntax.txt")
       app (string=? mode "app") simple (string=? mode "theme")
       anchor (if app "(def app-css\n  (str" "(def css\n (str")]
  (if (not (or app simple)) 7
   (let [result (concat/extract source anchor theme syntax app)]
    (if (not (option-some?-of [:option :string] result)) 7
     (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42))))))
