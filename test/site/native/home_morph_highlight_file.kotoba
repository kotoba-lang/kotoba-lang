(ns site.native.home-morph-highlight-file (:export [main]) (:capabilities [:fs/app-data :io/write])
 (:require [site.native.home-morph-highlight :as highlight]))
(defn main [] :i64
 (let [source (typed-cap-call :fs/app-data :string :string "/play.kotoba")
       grammar (typed-cap-call :fs/app-data :string :string "/grammar.edn")
       tokenizer (typed-cap-call :fs/app-data :string :string "/highlight.cljk")
       theme (typed-cap-call :fs/app-data :string :string "/theme.json") output (highlight/render source grammar tokenizer theme)]
  (if (option-some?-of [:option :string] output)
   (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] output ""))] 42) 7)))
