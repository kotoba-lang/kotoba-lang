(ns site.native.home-deliberate-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.locale-catalog :as catalog] [site.native.home-section :as home] [site.native.home-deliberate :as deliberate]))
(defn- locale? [s :string] :bool
 (or (string=? s "en") (string=? s "ar") (string=? s "arz") (string=? s "bn") (string=? s "de")
     (string=? s "es") (string=? s "fr") (string=? s "hi") (string=? s "id") (string=? s "ja")
     (string=? s "ko") (string=? s "mr") (string=? s "pcm") (string=? s "pt") (string=? s "ru")
     (string=? s "ur") (string=? s "zh-Hans")))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0") which (typed-cap-call :cli/args :string :string "1") generator (typed-cap-call :fs/app-data :string :string "/generator.cljk")]
  (if (not (locale? tag)) 7
   (let [json (typed-cap-call :fs/app-data :string :string (string-concat "/site/i18n/" (string-concat tag ".json")))]
    (match-option (catalog/open-catalog json) [:option [:ref :site/catalog]]
     (none 7)
     (some state
      (let [a (cond (string=? which "typed-eval")
                (home/render-typed state tag generator (typed-cap-call :fs/app-data :string :string "/typed-eval.edn"))
               (string=? which "architecture")
                (home/render-architecture state tag generator (typed-cap-call :fs/app-data :string :string "/stack-architecture.edn"))
               (string=? which "proof") (home/render-proof state tag generator)
               (string=? which "defaults")
                (home/render-defaults state tag generator (typed-cap-call :fs/app-data :string :string "/product-defaults.edn"))
               (string=? which "release")
                (home/render-release state tag generator (typed-cap-call :fs/app-data :string :string "/docs-release.edn"))
               (string=? which "sponsor")
                (home/render-sponsor state tag generator (typed-cap-call :fs/app-data :string :string "/sponsorship.edn"))
               (string=? which "source")
                (home/render-source state tag generator (typed-cap-call :fs/app-data :string :string "/docs-release.edn")
                 (typed-cap-call :fs/app-data :string :string "/wasm-component-platform.edn") (typed-cap-call :fs/app-data :string :string "/elaboration-pipeline.edn"))
               (string=? which "why-fast")
                (home/render-why-fast state tag generator (typed-cap-call :fs/app-data :string :string "/embench-parity.json"))
               (string=? which "why-fast-validate")
                (if (home/check-ratios (typed-cap-call :fs/app-data :string :string "/embench-parity.json") 0 0 0)
                 (option-some-of [:option :string] "ok") (option-none-of [:option :string]))
               (string=? which "deliberate")
                (deliberate/render state tag generator (typed-cap-call :fs/app-data :string :string "/surface-status.edn"))
               :else (home/render-section state tag generator which))]
       (if (option-some?-of [:option :string] a)
        (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] a ""))] 42) 7))))))))
