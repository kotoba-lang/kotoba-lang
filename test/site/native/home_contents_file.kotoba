(ns site.native.home-contents-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.locale-catalog :as catalog] [site.native.home-contents :as home]))
(defn- locale? [s :string] :bool
 (or (string=? s "en") (string=? s "ar") (string=? s "arz") (string=? s "bn") (string=? s "de")
     (string=? s "es") (string=? s "fr") (string=? s "hi") (string=? s "id") (string=? s "ja")
     (string=? s "ko") (string=? s "mr") (string=? s "pcm") (string=? s "pt") (string=? s "ru")
     (string=? s "ur") (string=? s "zh-Hans")))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0") generator (typed-cap-call :fs/app-data :string :string "/generator.cljk")]
  (if (not (locale? tag)) 7
   (let [json (typed-cap-call :fs/app-data :string :string (string-concat "/site/i18n/" (string-concat tag ".json")))]
    (match-option (catalog/open-catalog json) [:option [:ref :site/catalog]]
     (none 7)
     (some state
      (let [a (home/contents state tag generator) b (home/rules state tag generator)]
       (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
        (let [out (string-concat "<div>" (string-concat (option-value-of [:option :string] a "") (string-concat (option-value-of [:option :string] b "") "</div>")))
              ignore (typed-cap-call :io/write :string :string out)] 42) 7))))))))
