;; Bounded document cases, not a whole-site or HTML parity qualification.
(ns site.native.locale-tree-test (:require [site.native.locale-tree :as tree] [site.native.locale-catalog :as catalog]) (:export [main]))
(defn main [] :i64
 (let [cat "{\"2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824\": \"こんにちは\", \"9b9a8d05a7ec353bda84f9c1bb3178c299de3001b5e970508ddc889c487f92ca\": \"読む\"}"
       input (document-vector (document-keyword :div) (document-map :title (document-string "Read") :href (document-string "/foo"))
               (document-string " hello ")
               (document-vector (document-keyword :code) (document-string "hello"))
               (document-vector (document-keyword :span) (document-map :translate (document-string "no")) (document-string "hello")))
       expected (document-vector (document-keyword :div) (document-map :title (document-string "読む") :href (document-string "/foo"))
               (document-string " こんにちは ")
               (document-vector (document-keyword :code) (document-string "hello"))
               (document-vector (document-keyword :span) (document-map :translate (document-string "no")) (document-string "hello")))
       all-attrs (document-vector (document-keyword :input)
                   (document-map :title (document-string "Read") :alt (document-string "Read") :aria-label (document-string "Read") :placeholder (document-string "Read") :data-count-template (document-string "Read") :data-verifying (document-string "Read") :data-success (document-string "Read") :data-error (document-string "Read") :href (document-string "/foo")))
       expected-attrs (document-vector (document-keyword :input)
                        (document-map :title (document-string "読む") :alt (document-string "読む") :aria-label (document-string "読む") :placeholder (document-string "読む") :data-count-template (document-string "読む") :data-verifying (document-string "読む") :data-success (document-string "読む") :data-error (document-string "読む") :href (document-string "/foo")))
       result (tree/map-text cat input)
       missing (tree/map-text "{}" input)
       indexed (match-option (catalog/open-catalog cat) [:option [:ref :site/catalog]]
                 (none false)
                 (some state
                   (and (document-equal? (option-value-of [:option :document] (tree/map-indexed state input) (document-null)) expected)
                        (document-equal? (option-value-of [:option :document] (tree/map-indexed state input) (document-null)) expected))))]
  (if (and indexed (option-some?-of [:option :document] result)
           (document-equal? (option-value-of [:option :document] result (document-null)) expected)
           (not (option-some?-of [:option :document] missing))
           (not (option-some?-of [:option :document] (tree/map-text "{bad" (document-vector (document-keyword :script) (document-string "safe")))))
           (document-equal? (option-value-of [:option :document] (tree/map-text cat all-attrs) (document-null)) expected-attrs)

           (document-equal? (option-value-of [:option :document] (tree/map-text "{}" (document-vector (document-keyword :script) (document-string "missing"))) (document-null)) (document-vector (document-keyword :script) (document-string "missing")))
           (document-equal? (option-value-of [:option :document] (tree/map-text "{}" (document-vector (document-keyword :hiccup/raw) (document-string "missing"))) (document-null)) (document-vector (document-keyword :hiccup/raw) (document-string "missing")))
           (document-equal? (option-value-of [:option :document] (tree/map-text "{}" (document-map :title (document-string "missing"))) (document-null)) (document-map :title (document-string "missing")))
           (document-equal? (option-value-of [:option :document] (tree/map-text cat (document-vector)) (document-null)) (document-vector (document-null)))
           (document-equal? (option-value-of [:option :document] (tree/map-text cat (document-list (document-string "Kotoba") (document-string "https://a"))) (document-null)) (document-list (document-string "Kotoba") (document-string "https://a")))
           (document-equal? (option-value-of [:option :document]
             (tree/map-text cat (document-list (document-string "hello")
               (document-vector (document-keyword :pre) (document-string "hello")))) (document-null))
             (document-list (document-string "こんにちは")
               (document-vector (document-keyword :pre) (document-string "hello"))))) 42 7)))
