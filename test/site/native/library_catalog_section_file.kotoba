(ns site.native.library-catalog-section-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.locale-catalog :as catalog] [site.native.library-catalog-section :as section]))
(defn- read [p :string] :string (typed-cap-call :fs/app-data :string :string p))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0")]
  (if (not (or (string=? tag "en") (string=? tag "ja"))) 7
   (match-option (catalog/open-catalog (read (string-concat "/site/i18n/" (string-concat tag ".json")))) [:option [:ref :site/catalog]]
    (none 7)
    (some state
     (let [result (section/render state tag (read "/generator.cljk") (read "/library-taxonomy.edn") (read "/library-catalog.edn") (read "/package-registry.edn") (read "/rows.html"))]
      (if (option-some?-of [:option :string] result) (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))))))
