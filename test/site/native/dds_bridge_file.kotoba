(ns site.native.dds-bridge-file (:export [main]) (:capabilities [:fs/app-data :io/write])
 (:require [site.native.dds-bridge-css :as bridge]))
(defn main [] :i64
 (let [source (typed-cap-call :fs/app-data :string :string "/tokens.cljk") result (bridge/bridge source)]
  (if (option-some?-of [:option :string] result)
   (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))
