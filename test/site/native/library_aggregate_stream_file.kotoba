(ns site.native.library-aggregate-stream-file (:export [main]) (:capabilities [:fs/app-data :io/write])
 (:require [site.native.library-aggregate-stream :as aggregate]))
(defn main [] :i64
 (let [catalog (typed-cap-call :fs/app-data :string :string "/library-catalog.edn")
       taxonomy (typed-cap-call :fs/app-data :string :string "/library-taxonomy.edn")
       summary (aggregate/compute catalog taxonomy)]
  (if (option-some?-of [:option :string] summary)
   (let [ignored (typed-cap-call :io/write :string :string (option-value-of [:option :string] summary ""))] 42) 7)))
