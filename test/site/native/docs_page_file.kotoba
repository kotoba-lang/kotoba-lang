(ns site.native.docs-page-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.input :as input] [site.native.docs-page :as docs] [multiformats.sha256 :as sha]))
(defn- at [d :document i :i64] :document (option-value-of [:option :document] (document-vector-at d i) (document-null)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- sources [tag :string pins :document] :document
 (if (or (not (= (document-kind pins) :vector)) (not (= (document-count pins) 14))) (document-null)
  (loop [i 0 out (document-vector)]
   (if (>= i 14) out
    (let [pin (text (at pins i)) path (string-concat "/docs-source/" (docs/source-name tag i)) content (input/read path)
          okay (arena-scope (and (= (string-byte-length pin) 64) (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 content))) pin)))]
     (if okay (recur (+ i 1) (document-vector-conj out (document-string content))) (document-null)))))))
(defn main [] :i64
 (let [mode (typed-cap-call :cli/args :string :string "0") tag (typed-cap-call :cli/args :string :string "1") name (typed-cap-call :cli/args :string :string "2")]
  (if (string=? mode "redirects")
   (let [out (string-concat (input/read "/page.html") "\n/docs /docs/amu/ 302\n/docs/ /docs/amu/ 302\n/ja/docs /ja/docs/amu/ 302\n/ja/docs/ /ja/docs/amu/ 302\n") ignored (typed-cap-call :io/write :string :string out)] 42)
  (if (string=? mode "integrate")
   (let [html (input/read "/page.html") out (docs/integrate html tag) ignored (typed-cap-call :io/write :string :string out)] 42)
   (if (and (string=? mode "render") (docs/valid-locale? tag))
    (let [pins (document-edn-read (input/read "/docs-pins.edn")) result (docs/render tag name (sources tag pins))]
     (if (option-some?-of [:option :string] result) (let [ignored (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)) 7)))))
