(ns site.native.home-benchmark-compose-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.input :as input] [site.native.home-benchmark-compose :as benchmark]))
(defn- read [path :string] :string (input/read path))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0")
       result (benchmark/compose tag (read "/manifest.edn") (read "/intro.html") (read "/cards.html") (read "/scaling.html") (read "/runtime.html") (read "/compile.html") (read "/remainder.html"))]
  (if (option-some?-of [:option :string] result)
   (let [ignored (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))
