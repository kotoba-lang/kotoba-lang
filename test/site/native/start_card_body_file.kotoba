(ns site.native.start-card-body-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.locale-catalog :as catalog] [site.native.start-card-body :as body]))
(defn- read [p :string] :string (typed-cap-call :fs/app-data :string :string p))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0")]
  (if (not (or (string=? tag "en") (string=? tag "ta") (string=? tag "uk"))) 7
   (match-option (catalog/open-catalog (read "/site/i18n/en.json")) [:option [:ref :site/catalog]]
    (none 7)
    (some state
     (let [result (body/render state tag (read "/generator.cljk") (read "/locales.cljk"))]
      (if (option-some?-of [:option :string] result)
       (let [ignored (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))))))
