(ns site.native.dds-palette-file (:export [main]) (:capabilities [:fs/app-data :io/write])
 (:require [site.native.dds-palette :as palette]))
(defn main [] :i64
 (let [source (typed-cap-call :fs/app-data :string :string "/dds.css") result (palette/snapshot source)]
  (if (option-some?-of [:option :string] result)
   (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))
