(ns site.native.library-classifier-stream-file (:export [main]) (:capabilities [:fs/app-data :io/write])
 (:require [site.native.library-classifier :as classifier] [site.native.library-catalog-stream :as scan] [multiformats.sha256 :as sha]))
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- item [d :document i :i64] :document (val (document-vector-at d i)))
(defn- getv [d :document k :keyword] :document (if (= (document-kind d) :map) (val (document-get d k)) (document-null)))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- topic [taxonomy :document i :i64] :string
 (let [planes (getv taxonomy :planes) domains (getv taxonomy :domains) n (document-count planes)]
  (text (getv (if (< i n) (item planes i) (item domains (- i n))) :topic))))
(defn- labels [taxonomy :document mask :i64 i :i64 total :i64 out :string] :string
 (if (>= i total) out
  (if (not (= (bit-and mask (i64-shift-left 1 i)) 0))
   (labels taxonomy mask (+ i 1) total (string-concat out (string-concat (if (string=? out "") "" " ") (topic taxonomy i))))
   (labels taxonomy mask (+ i 1) total out))))
(defn- safe-name? [s :string i :i64] :bool
 (if (>= i (string-byte-length s)) (> i 0)
  (let [c (string-code-point-at s i)]
   (if (or (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122)) (and (>= c 48) (<= c 57)) (= c 45) (= c 95) (= c 46))
    (safe-name? s (+ i 1)) false))))
(defn- emit-row [taxonomy :document repo :document total :i64] :i64
 (let [name (text (getv repo :name)) mask (classifier/classify taxonomy repo)]
  (if (not (safe-name? name 0)) 7
   (let [ignore (typed-cap-call :io/write :string :string (string-concat name (string-concat "\t" (string-concat (labels taxonomy mask 0 total "") "\n"))))] 0))))
(defn- rows [taxonomy :document catalog :string total :i64 pos :i64 count :i64] :i64
 (let [begin (scan/begin catalog pos)]
  (cond (= begin 0) (if (= count 2215) 42 7)
        (< begin 0) 7
        :else (let [end (scan/end catalog begin)]
                (if (<= end begin) 7
                 (let [status (arena-scope (emit-row taxonomy (document-edn-read (string-substring catalog begin end)) total))]
                  (if (= status 0) (rows taxonomy catalog total end (+ count 1)) 7)))))))
(defn- digest? [s :string expected :string] :bool
 (arena-scope (string=? (sha/digest-hex (vector-i64-from-bytes (string-to-utf8 s))) expected)))
(defn main [] :i64
 (let [catalog-text (typed-cap-call :fs/app-data :string :string "/library-catalog.edn")
       taxonomy-text (typed-cap-call :fs/app-data :string :string "/library-taxonomy.edn")
       ok (and (digest? catalog-text "154244b0400f3b87431ae24495c738675f2ba73bd4ba81af202f9e9b4c6e84fa")
               (digest? taxonomy-text "827d2160f70a25e4af638423da4d9e022a42669d174a15d2e4121d00774183d0"))
       taxonomy (if ok (document-edn-read taxonomy-text) (document-null))
       planes (getv taxonomy :planes) domains (getv taxonomy :domains)]
  (if (or (not ok) (not (classifier/taxonomy-valid? taxonomy))) 7
   (rows taxonomy catalog-text (+ (document-count planes) (document-count domains)) (scan/start catalog-text) 0))))
