(ns site.native.sponsor-main-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.locale-catalog :as catalog] [site.native.sponsor-main :as sponsor]))
(defn- read [p :string] :string (typed-cap-call :fs/app-data :string :string p))
(defn- known? [s :string] :bool
 (or (string=? s "en") (string=? s "ar") (string=? s "arz") (string=? s "bn") (string=? s "de") (string=? s "es")
     (string=? s "fr") (string=? s "hi") (string=? s "id") (string=? s "ja") (string=? s "ko") (string=? s "mr")
     (string=? s "pcm") (string=? s "pt") (string=? s "ru") (string=? s "ur") (string=? s "zh-Hans")))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0")]
  (if (not (known? tag)) 7
   (match-option (catalog/open-catalog (read (string-concat "/site/i18n/" (string-concat tag ".json")))) [:option [:ref :site/catalog]]
   (none 7)
   (some state
    (let [result (sponsor/render state tag (read "/generator.cljk") (read "/sponsorship.edn"))]
     (if (option-some?-of [:option :string] result)
      (let [ignored (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))))))
