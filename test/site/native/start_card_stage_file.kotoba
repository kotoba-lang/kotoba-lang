(ns site.native.start-card-stage-file (:export [main]) (:capabilities [:fs/app-data-bytes :process/spawn :cli/args])
 (:require [site.native.start-card-stage :as articles]))
(defn- bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- text [v :vector-i64] :string (string-from-utf8 (bytes-from-vector-i64 v)))
(defn- read [p :string] :vector-i64
 (let [nul (string-from-utf8 (bytes-from-vector-i64 [0])) tail (bytes (string-concat p nul)) n (vector-count tail)
       frame (loop [i 0 v (vector-alloc (+ n 7))] (if (= i 7) v (recur (+ i 1) (vector-assoc! v i (vector-at [0 65 77 85 72 1 1] i)))))
       request (loop [i 0 v frame] (if (= i n) v (recur (+ i 1) (vector-assoc! v (+ i 7) (vector-at tail i)))))]
  (vector-i64-from-bytes (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-from-vector-i64 request)))))
(defn main [] :i64
 (let [path (typed-cap-call :cli/args :string :string "0") private (typed-cap-call :cli/args :string :string "1") site (typed-cap-call :cli/args :string :string "2") r (read path)]
  (if (or (< (vector-count r) 1) (not (= (vector-at r 0) 0))) 7
   (let [n (- (vector-count r) 1) value (loop [i 0 v (vector-alloc n)] (if (= i n) v (recur (+ i 1) (vector-assoc! v i (vector-at r (+ i 1))))))]
    (if (articles/stage (document-edn-read (text value)) private site) 42 7)))))
