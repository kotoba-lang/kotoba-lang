(ns site.native.locale-mark-test (:export [main]) (:require [site.native.locale-mark :as m]))
(defn main [] :i64
 (let [input (document-vector (document-keyword :div)
   (document-vector (document-keyword :button) (document-map :data-language-selector-opener (document-bool true) :aria-label (document-string "old")) (document-string "Open"))
   (document-vector (document-keyword :span) (document-map :data-language-selector-current (document-bool true)) (document-string "old") (document-string "extra"))
   (document-vector (document-keyword :a) (document-map :hreflang (document-string "ja") :aria-current (document-string "old")) (document-string "日本語"))
   (document-vector (document-keyword :a) (document-map :hreflang (document-string "en") :data-current (document-bool true)) (document-string "English")))
  expected (document-vector (document-keyword :div)
   (document-vector (document-keyword :button) (document-map :data-language-selector-opener (document-bool true) :aria-label (document-string "Language: 日本語")) (document-string "Open"))
   (document-vector (document-keyword :span) (document-map :data-language-selector-current (document-bool true)) (document-string "日本語"))
   (document-vector (document-keyword :a) (document-map :hreflang (document-string "ja") :aria-current (document-string "page") :data-current (document-bool true)) (document-string "日本語"))
   (document-vector (document-keyword :a) (document-map :hreflang (document-string "en")) (document-string "English")))
  false-input (document-vector (document-keyword :span) (document-map :data-language-selector-current (document-bool false)) (document-string "unchanged"))]
  (if (and (document-equal? (m/mark-language input "ja") expected)
           (document-equal? (m/mark-language (document-list (document-map :hreflang (document-string "fr") :aria-current (document-string "stale"))) "fr")
             (document-list (document-map :hreflang (document-string "fr") :aria-current (document-string "page") :data-current (document-bool true))))
           (document-equal? (m/mark-language false-input "ja") false-input)
           (document-equal? (m/mark-language (document-vector (document-keyword :span) (document-map :data-language-selector-current (document-bool true)) (document-string "x")) "xx")
             (document-vector (document-keyword :span) (document-map :data-language-selector-current (document-bool true)) (document-string "xx")))) 42 7)))
