(ns site.native.locale-pages-test
  (:export [main])
  (:require [site.native.locale-pages :as pages]))

(defn- prefix [tag :string] :string (if (string=? tag "en") "" (string-concat "/" tag)))
(defn- link [tag :string path :string] :string
  (string-concat "hreflang=\"" (string-concat tag (string-concat "\" href=\"https://kotoba-lang.org"
    (string-concat (prefix tag) (string-concat path "\""))))))
(defn- links [path :string omit :string] :string
  (let [x0 (link "en" path) x1 (string-concat x0 (link "ar" path)) x2 (string-concat x1 (link "arz" path))
        x3 (string-concat x2 (link "bn" path)) x4 (string-concat x3 (link "de" path))
        x5 (string-concat x4 (link "es" path)) x6 (string-concat x5 (if (string=? omit "fr") "" (link "fr" path)))
        x7 (string-concat x6 (link "hi" path)) x8 (string-concat x7 (link "id" path))
        x9 (string-concat x8 (link "ja" path)) x10 (string-concat x9 (link "ko" path))
        x11 (string-concat x10 (link "mr" path)) x12 (string-concat x11 (link "pcm" path))
        x13 (string-concat x12 (link "pt" path)) x14 (string-concat x13 (link "ru" path))
        x15 (string-concat x14 (link "ur" path))]
    (string-concat x15 (link "zh-Hans" path))))
(defn- page [tag :string path :string body :string omit :string] :string
  (let [rtl (or (string=? tag "ar") (string=? tag "arz") (string=? tag "ur"))
        html (string-concat "<html lang=\"" (string-concat tag (if rtl "\" dir=\"rtl\">" "\">")))
        canonical (string-concat "rel=\"canonical\" href=\"https://kotoba-lang.org"
                    (string-concat (prefix tag) (string-concat path "\"")))]
    (string-concat html (string-concat canonical (string-concat (links path omit) body)))))
(defn main [] :i64
  (let [path "/blog/" en (page "en" path "<pre class=\"code\">(println 日本語)</pre>" "")
        ja (page "ja" path "<pre>(println 日本語)</pre>" "")
        ar (page "ar" path "<pre>(println 日本語)</pre>" "")
        altered (page "ja" path "<pre>(println changed)</pre>" "")
        truncated (page "ja" path "<pre>unfinished" "")
        missing (page "ja" path "<pre>(println 日本語)</pre>" "fr")]
    (if (and (pages/page-valid? en ja "ja" path)
             (pages/page-valid? en ar "ar" path)
             (not (pages/page-valid? en (string-concat ja "freebuff") "ja" path))
             (not (pages/page-valid? en altered "ja" path))
             (not (pages/page-valid? en truncated "ja" path))
             (not (pages/page-valid? en missing "ja" path))
             (not (pages/page-valid? en ja "ja" "/"))
             (not (pages/page-valid? en ja "ar" path))) 42 7)))
