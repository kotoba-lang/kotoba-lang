(ns site.native.library-document-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.input :as input] [site.native.home-document :as page]))
(defn- read [p :string] :string (input/read p))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0") result (page/compose tag (read "/document-manifest.edn") (read "/head.html") (read "/body.html"))]
  (if (option-some?-of [:option :string] result)
   (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))
