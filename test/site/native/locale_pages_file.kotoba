(ns site.native.locale-pages-file
  (:export [main])
  (:capabilities [:cli/args :fs/app-data])
  (:require [site.native.locale-pages :as pages]))

(defn- locale? [tag :string] :bool
  (or (= tag "en") (= tag "ar") (= tag "arz") (= tag "bn") (= tag "de") (= tag "es")
      (= tag "fr") (= tag "hi") (= tag "id") (= tag "ja") (= tag "ko")
      (= tag "mr") (= tag "pcm") (= tag "pt") (= tag "ru") (= tag "ur") (= tag "zh-Hans")))
(defn- route? [path :string] :bool
  (or (= path "/") (= path "/blog/infra-cost-measured-path/") (= path "/blog/csf2-attack-graphs/")
      (= path "/blog/") (= path "/libraries/") (= path "/legal/") (= path "/sponsor/")))

(defn main [] :i64
  (let [tag (typed-cap-call :cli/args :string :string "0")
        path (typed-cap-call :cli/args :string :string "1")]
    (if (or (not (locale? tag)) (not (route? path))) 7
      (let [prefix (if (= tag "en") "" (string-concat "/" tag))
            english-path (string-concat "/site/dist" (string-concat path "index.html"))
            local-path (string-concat "/site/dist" (string-concat prefix (string-concat path "index.html")))
            english (typed-cap-call :fs/app-data :string :string english-path)
            html (typed-cap-call :fs/app-data :string :string local-path)]
        (if (pages/page-valid? english html tag path) 42 7)))))
