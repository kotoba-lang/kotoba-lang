(ns site.native.home-body-compose-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.input :as input] [site.native.home-body-compose :as body]))
(defn- read [path :string] :string (input/read path))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0")
       result (body/compose tag (read "/manifest.edn") (read "/shell.html") (read "/hero.html") (read "/chapters.html") (read "/scripts.html"))]
  (if (option-some?-of [:option :string] result)
   (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))
