(ns site.native.locale-catalog-argv
  (:export [main])
  (:capabilities [:cli/args])
  (:require [site.native.locale-catalog :as catalog]))

(defn main [] :i64
  (let [source (typed-cap-call :cli/args :string :string "0")
        target (typed-cap-call :cli/args :string :string "1")]
    (if (catalog/catalogs-meet-minimum? source target 901) 42 7)))
