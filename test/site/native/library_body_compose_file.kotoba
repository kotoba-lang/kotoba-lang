(ns site.native.library-body-compose-file (:export [main]) (:capabilities [:fs/app-data :cli/args :io/write])
 (:require [site.native.library-body-compose :as body]))
(defn- read [path :string] :string (typed-cap-call :fs/app-data :string :string path))
(defn main [] :i64
 (let [tag (typed-cap-call :cli/args :string :string "0")
       result (body/compose tag (read "/manifest.edn") (read "/shell.html") (read "/hero.html") (read "/identity.html") (read "/publish.html") (read "/catalog.html") (read "/status.html") (read "/compare.html"))]
  (if (option-some?-of [:option :string] result)
   (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))
