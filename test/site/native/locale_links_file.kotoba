(ns site.native.locale-links-file (:export [main]) (:capabilities [:fs/app-data :cli/args])
 (:require [site.native.locale-links :as links]))
(defn- find-from [s :string part :string start :i64] :i64
 (let [i (string-index-of (string-substring s start (string-byte-length s)) part)] (if (< i 0) -1 (+ start i))))
(defn- decimal? [s :string] :bool
 (if (or (= (string-byte-length s) 0) (> (string-byte-length s) 4)) false
  (loop [i 0] (if (>= i (string-byte-length s)) true
   (let [c (string-code-point-at s i)] (if (and (>= c 48) (<= c 57)) (recur (+ i 1)) false))))))
(defn- check [data :string] :bool
 (loop [at 0 count 0]
  (if (>= at (string-byte-length data)) (> count 0)
   (let [a (find-from data "\t" at) b (if (< a 0) -1 (find-from data "\t" (+ a 1)))
         c (if (< b 0) -1 (find-from data "\t" (+ b 1))) d (if (< c 0) -1 (find-from data "\t" (+ c 1)))
         end (if (< d 0) -1 (find-from data "\n" (+ d 1)))]
    (if (< end 0) false
     (let [tag (string-substring data at a) base (string-substring data (+ a 1) b)
           href (string-substring data (+ b 1) c) expected (string-substring data (+ c 1) d)
           mode (string-substring data (+ d 1) end) got (links/resolve-link tag base href)
           valid (cond (string=? mode "accept") (and (option-some?-of [:option :string] got)
                       (string=? (option-value-of [:option :string] got "") expected))
                       (string=? mode "refuse") (not (option-some?-of [:option :string] got)) :else false)]
      (if valid (recur (+ end 1) (+ count 1)) false)))))))
(defn main [] :i64
 (let [index (typed-cap-call :cli/args :string :string "0")]
  (if (not (decimal? index)) 7
   (let [data (typed-cap-call :fs/app-data :string :string
               (string-concat "/fixtures/" (string-concat index ".txt")))]
    (if (check data) 42 7)))))
