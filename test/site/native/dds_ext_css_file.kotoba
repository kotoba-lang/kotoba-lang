(ns site.native.dds-ext-css-file (:export [main]) (:capabilities [:fs/app-data :io/write])
 (:require [site.native.dds-ext-css :as css]))
(defn main [] :i64
 (let [source (typed-cap-call :fs/app-data :string :string "/core.cljk") result (css/render source)]
  (if (option-some?-of [:option :string] result)
   (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))
