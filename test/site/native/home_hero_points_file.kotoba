(ns site.native.home-hero-points-file (:export [main]) (:capabilities [:fs/app-data :io/write])
 (:require [site.native.home-hero-svg :as hero]))
(defn main [] :i64
 (let [generator (typed-cap-call :fs/app-data :string :string "/generator.cljk") source (typed-cap-call :fs/app-data :string :string "/hero.cljk") output (hero/points generator source)]
  (if (option-some?-of [:option :string] output)
   (let [ignore (typed-cap-call :io/write :string :string (option-value-of [:option :string] output ""))] 42) 7)))
