(ns site.native.locale-message-ids-file
  (:export [main])
  (:capabilities [:fs/app-data])
  (:require [site.native.locale-catalog :as catalog]
            [site.native.locale-message :as message]))

;; This diagnostic inspects the validated index's documented slot layout.
;; Every present key must be the hash of its decoded, trimmed source value.
(defn- identities-match? [state [:ref :site/catalog]] :bool
  (let [raw (get state :source) index (get state :index)]
    (loop [slot 2 count 0]
      (if (>= slot 12290) (>= count 901)
        (let [key (vector-at index slot)]
          (if (= key 0) (recur (+ slot 3) count)
            (let [id (string-substring raw (- key 1) (+ key 63))
                  value (catalog/indexed-value state id)]
              (if (option-some?-of [:option :string] value)
                (if (string=? (message/message-id (option-value-of [:option :string] value "")) id)
                  (recur (+ slot 3) (+ count 1)) false)
                false))))))))

(defn main [] :i64
  (let [text (typed-cap-call :fs/app-data :string :string "/site/i18n/en.json")]
    (if (match-option (catalog/open-catalog text) [:option [:ref :site/catalog]]
          (none false)
          (some state (identities-match? state)))
      42 7)))
