(ns site.native.sitemap-file (:export [main]) (:capabilities [:fs/app-data :io/write])
 (:require [site.native.sitemap :as sitemap]))
;; Keep only bounded ASCII canonical bytes outside each page-read arena.
(defn- extract-into [path :string buffer :vector-i64 offset :i64] :i64
 (let [html (typed-cap-call :fs/app-data :string :string path) url (sitemap/canonical html) n (string-byte-length url)]
  (if (or (string=? url ":invalid") (> n 1024)) -1
   (loop [i 0]
    (if (>= i n) n (let [ignored (vector-assoc! buffer (+ (+ offset 1) i) (string-code-point-at url i))] (recur (+ i 1))))))))
(defn- collect [files :document i :i64 buffer :vector-i64] :vector-i64
 (if (>= i (document-count files)) buffer
  (let [file (option-value-of [:option :document] (document-vector-at files i) (document-null))
        path (option-value-of [:option :string] (document-string-value file) "") offset (* i 1025)
        n (arena-scope (extract-into path buffer offset))
        ignored (vector-assoc! buffer offset n)]
   (collect files (+ i 1) buffer))))
(defn main [] :i64
 (let [manifest (document-edn-read (typed-cap-call :fs/app-data :string :string "/manifest.edn"))
       count (if (= (document-kind manifest) :vector) (document-count manifest) 0)
       result (if (and (> count 0) (<= count 4096)) (sitemap/render (collect manifest 0 (vector-alloc (* count 1025))) count) (option-none-of [:option :string]))]
  (if (option-some?-of [:option :string] result)
   (let [ignored (typed-cap-call :io/write :string :string (option-value-of [:option :string] result ""))] 42) 7)))
