(ns site.native.locale-message-test
  (:export [main])
  (:require [site.native.locale-message :as message]))

(defn- long-as [n :i64] :string
  (loop [i 0 out ""] (if (>= i n) out (recur (+ i 1) (string-concat out "a")))))

(defn main [] :i64
  (let [catalog "{\"87dd9bbb3e2154cde4dd498e45e6c1c651736bec5e3252a8131094fe3d3829bc\":\"パフォーマンスゲート\"}"]
    (if (and
          (string=? (message/message-id "  hello \t") "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824")
          (string=? (message/message-id "　雪 ") "53058fe2e03c00d93c4ba9361889dd7569d7d7b9674ed172266ee66265208cc6")
          (string=? (message/message-id "　\t ") "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
          (string=? (message/message-id " 🧵 ") "36487e7e6add202ec033b4be5c5eabd06dcb177705d9228e7fd2cbe53f532ed4")
          (string=? (message/message-id " hello world ") "b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9")
          (string=? (message/message-id "hello") "3496c7c6f42b15b8a519c82c3a5e62189a5d838dc13dd6931bb42ba8800ce888")
          (string=? (message/message-id "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318")
          (string=? (message/message-id "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a")
          (string=? (message/message-id "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34")
          (string=? (message/message-id "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb")
          (string=? (message/message-id "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") "635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0")
          (string=? (message/message-id (long-as 1118)) "08cd1fa18fb1731f84d75e41cb7fbb6ffe176598d476c450026d02a3affe4eeb")
          (string=? (message/message-id "perfgate") "87dd9bbb3e2154cde4dd498e45e6c1c651736bec5e3252a8131094fe3d3829bc")
          (string=? (option-value-of [:option :string] (message/translate catalog "\tperfgate ") "missing") "\tパフォーマンスゲート ")
          (not (option-some?-of [:option :string] (message/translate catalog "missing"))))
      42 7)))
