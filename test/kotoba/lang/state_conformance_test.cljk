(ns kotoba.lang.state-conformance-test
  "Runs the state ability's conformance cases (lang/state-ability.edn, slice 1)
  through the frontend and KIR, so the contract's `:conformance` is something
  this repository measures rather than states.

  The positives execute on KIR and must answer the manifest's `:expect`, and no
  state head may survive elaboration. The negatives are pinned by their EXACT
  message (`=`, not `includes?`): a fixture refused for some other reason --
  an unbound symbol, a type error in the fixture -- would otherwise count as
  the refusal it was written to show. Every negative but one also carries a
  `:kotoba.error/state-*` code, asserted here; the one that does not is the
  pre-existing effect-ceiling refusal, which states :state and carries no code."
  (:require [kotoba.io :as kio]
            [kotoba.lang.edn :as edn]
            [kotoba.lang.coll :as set]
            [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is testing]]
            [kotoba.kir :as kir]
            [kotoba.sema :as sema]))

(def ^:private conformance-root "lang/conformance")

(defn- state-cases []
  (->> (:cases (edn/read-string (slurp (str conformance-root "/manifest.edn"))))
       (filter #(some-> (:entry %) (str/starts-with? "state/")))))

(defn- source-of [case]
  (slurp (str conformance-root "/" (:entry case))))

(defn- refusal-of [source]
  (try (do (sema/analyze source) nil)
       (catch #?(:clj Throwable :cljs :default) e e)))

(def ^:private state-heads
  '#{__kotoba_state_perform __kotoba_state_op __kotoba_state_handle
     __kotoba_state_with __kotoba_state_resume perform handle resume})

(deftest the-manifest-declares-the-cases-the-contract-lists
  (let [contract (edn/read-string (slurp "lang/state-ability.edn"))
        declared (into #{} (map :id) (state-cases))]
    (is (= (set (concat (get-in contract [:conformance :positive])
                        (get-in contract [:conformance :negative])))
           declared))
    ;; floors, so a set that lost its positives or negatives cannot pass as
    ;; an empty sweep
    (is (<= 8 (count (filter #(= :run (:kind %)) (state-cases)))))
    (is (<= 11 (count (filter #(= :expect-error (:kind %)) (state-cases)))))))

(deftest every-positive-case-executes-to-its-expected-value
  (let [ran (atom 0)]
    (doseq [case (filter #(= :run (:kind %)) (state-cases))]
      (testing (str (:id case))
        (is (= #{:kir} (:required-backends case)))
        (let [hir (sema/analyze (source-of case))
              value (kir/execute (kir/lower hir) (symbol (:function case)) (:args case))]
          (swap! ran inc)
          (is (= (str (get-in case [:expect :kotoba])) (str value)))
          (is (not-any? #(and (seq? %) (contains? state-heads (first %)))
                        (tree-seq coll? seq (mapv :body (:functions hir))))
              "no state head survives elaboration")
          (testing "main installs the handler and does not carry :state"
            (is (= #{} (:effects (first (filter #(= 'main (:name %)) (:functions hir))))))))))
    (println (str "EXECUTED\t" @ran "\tstate positives on KIR"))
    (is (<= 8 @ran))))

(deftest every-negative-case-is-refused-with-exactly-the-pinned-message
  (let [refused (atom 0)]
    (doseq [case (filter #(= :expect-error (:kind %)) (state-cases))]
      (testing (str (:id case))
        (let [refusal (refusal-of (source-of case))]
          (is (some? refusal) "the fixture was admitted")
          (when refusal
            (swap! refused inc)
            (is (= (:error-contains case) (ex-message refusal)))
            (when-not (= :state-slice-1-negative-ceiling-omits-state (:id case))
              (is (str/starts-with? (str (:kotoba.error/code (ex-data refusal)))
                                    ":kotoba.error/state-")
                  (pr-str (ex-data refusal))))))))
    (println (str "REFUSED\t" @refused "\tstate negatives by exact message"))
    (is (<= 11 @refused))))

(deftest the-fixture-directory-and-the-manifest-agree
  (let [on-disk (->> (kio/file-seq (kio/file (str conformance-root "/state")))
                     (filter #(kio/file? %))
                     (map #(subs (kio/path %) (inc (count conformance-root))))
                     set)
        declared (into #{} (map :entry) (state-cases))]
    (is (= on-disk declared)
        "every fixture is a case and every case is a fixture")))
