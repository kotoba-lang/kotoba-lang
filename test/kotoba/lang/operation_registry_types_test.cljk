(ns kotoba.lang.operation-registry-types-test
  "lang/operations.edn's TYPES against kotoba-sema (root ADR-2610092330 R1).

  R0 checks that each layer admits the operations the registry names, with
  the same arity. This checks what an operation is typed as, by asking the
  analyser itself rather than reading its source: kotoba-sema keeps the types
  in the cases of its infer function, not in a table, so a probe program per
  operation is the only reading that is both exact and independent of how the
  analyser is written.

  For an operation the registry calls :implemented on :kotoba-sema:
    1. a function whose parameters are the registry's :params and whose
       declared result is the registry's :result, calling the operation, is
       ADMITTED;
    2. the same function declaring a different result is REFUSED as a type
       mismatch -- so (1) is not passing because anything would;
    3. each parameter given a wrong type is REFUSED as a type mismatch.
  For one the registry calls :pending, the analyser answers \"unknown
  operation\" -- so the registry cannot lag behind a layer that has caught up.

  The analyser is the one on this repository's :test classpath. R0 reads
  kotoba-sema's source instead, because its tables can be read as data; types
  cannot, and the pin is the analyser this repository's other conformance
  runners use."
  (:require [clojure.edn :as edn]
            [clojure.walk :as walk]
            [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is testing]]
            [kotoba.sema :as sema]))

(def ^:private min-probes
  "A ratchet: raise it when a family joins, never lower it.
  2026-10-09: the document family (145), :bytes (180), :vector (221),
  :vector-f64 (254), :typed-map (292),
  :typed-set (319), :typed-list (331),
  :string (417), :f64 (520), :f32 (601), :i32 (634), :i64 (657), :compact-graph (686), :xml and :decimal (716)."
  716)

(defn- registry [] (edn/read-string (slurp "lang/operations.edn")))

(defn- literal?
  "[:literal-i64 lo hi]: an i64 admitted only as a literal in [lo, hi]. The
  probe writes hi in the call rather than taking a parameter."
  [t]
  (and (vector? t) (= :literal-i64 (first t))))

(defn- wrong-type [t]
  (cond (literal? t) (let [over (inc (nth t 2))] [:literal-i64 over over])
        (= t :i64) :string
        :else :i64))

(defn- other-result [t] (if (= t :i64) :bool :i64))

(defn- spell [t] (pr-str t))

(defn- probe-source
  "A module whose function `probe` takes PARAM-TYPES, declares RESULT, and
  answers (OP a0 a1 ...) -- or (OP TYPE-ARG a0 a1 ...) for a parametric
  operation, whose literal type comes first."
  ([op param-types result] (probe-source op nil param-types result))
  ([op type-arg param-types result]
   (let [names (map #(str "a" %) (range (count param-types)))
         typed (remove (comp literal? second) (map vector names param-types))
         args (map (fn [n t] (if (literal? t) (str (nth t 2)) n)) names param-types)]
     (str "(defn probe [" (str/join " " (map (fn [[n t]] (str n " " (spell t))) typed)) "] "
          (spell result) " (" op (when type-arg (str " " (spell type-arg)))
          (apply str (map #(str " " %) args)) "))\n"
          "(defn main [] 0)\n"))))

(def ^:private instantiation
  "The concrete types a parametric entry's type variables are probed at."
  '{K :keyword V :i64 T :i64})

(defn- instantiate [entry]
  (if (:type-params entry)
    (walk/postwalk-replace instantiation (dissoc entry :type-params))
    entry))

(defn- outcome [src]
  (try (sema/analyze src) :admitted
       (catch Throwable e (or (ex-message e) (str e)))))

(defn- signatures
  "Every concrete parameter-type vector the entry stands for: an [:or ...]
  parameter is tried with each alternative; a variadic entry is tried with two
  items (or one key/value pair)."
  [entry]
  (let [expand (fn [t] (if (and (vector? t) (= :or (first t))) (rest t) [t]))
        params (if-let [item (:item entry)]
                 (if (vector? item) [(first item) (second item)] [item item])
                 (:params entry))]
    (reduce (fn [acc t] (for [prefix acc alt (expand t)] (conj prefix alt)))
            [[]] params)))

(defn- probes [op entry]
  (let [entry (instantiate entry)
        result (:result entry)
        type-arg (:type-arg entry)
        probe-source (fn [op sig r] (probe-source op type-arg sig r))]
    (concat
     (for [sig (signatures entry)]
       {:what [:admits sig] :src (probe-source op sig result) :want :admitted})
     (for [sig (take 1 (signatures entry))]
       {:what [:result-is-exact sig] :src (probe-source op sig (other-result result))
        :want :type-mismatch})
     (for [sig (take 1 (signatures entry))
           i (range (count sig))
           :let [bad (assoc (vec sig) i (wrong-type (nth sig i)))]
           ;; a keyword-or-document key given an i64 is still refused, but
           ;; by the key rule rather than as a type mismatch
           :when (not= bad sig)]
       {:what [:param-is-checked i] :src (probe-source op bad result) :want :refused}))))

(defn- verdict [want got]
  (case want
    :admitted (= got :admitted)
    :type-mismatch (and (string? got) (str/includes? got "expression type mismatch"))
    :refused (string? got)))

(deftest the-registry-types-agree-with-kotoba-sema
  (let [r (registry)
        ran (atom 0)]
    (doseq [[op entry] (sort-by (comp str key) (:operations r))
            :let [status (get-in entry [:layers :kotoba-sema])]]
      (testing (str op)
        (case status
          :implemented
          (doseq [{:keys [what src want]} (probes op entry)]
            (let [got (outcome src)]
              (swap! ran inc)
              (is (verdict want got) (str what " wanted " want ", got " (pr-str got) "\n" src))))
          :pending
          (let [got (outcome (probe-source op (first (signatures entry)) (:result entry)))]
            (swap! ran inc)
            (is (and (string? got) (str/includes? got (str "unknown operation: " op)))
                (str "the registry says :pending, kotoba-sema answered " (pr-str got)
                     " -- flip the entry to :implemented")))
          nil)))
    (println (format "PROBED\t%d\toperation type probes against kotoba-sema" @ran))
    (is (>= @ran min-probes) (str "probed " @ran ", floor is " min-probes))))
