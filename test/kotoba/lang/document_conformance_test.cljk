(ns kotoba.lang.document-conformance-test
  "Executes the `document/` conformance cases on `:kir` (root ADR-2610092310 S0).

  `document/traversal.kotoba` walks a document with the operations that already
  exist; `document/sha256_anchors.kotoba` pins document-sha256 and
  document-print of the documents that exist today, before :document gains
  bytes and link kinds -- so adding them cannot move an existing identity
  unnoticed. Each fixture's `main` counts the test-* that pass, and the
  manifest's `:expect` is that count.

  The shape follows kotoba.lang.collections-conformance-test: every case this
  runner owns names it in `:executed-by :kir`, the executed set equals the
  declared set, and the directory and the manifest agree."
  (:require [kotoba.io :as kio] [clojure.edn :as edn]
            [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is testing]]
            [kotoba.kir :as kir]
            [kotoba.sema :as sema]))

(def ^:private conformance-root "lang/conformance")
(def ^:private prefix "document/")
(def ^:private this-runner "kotoba-lang/kotoba-lang kotoba.lang.document-conformance-test")

(def ^:private min-executed-run-cases
  "A ratchet: raise it when a case starts running, never lower it."
  2)

(defn- manifest []
  (edn/read-string (slurp (str conformance-root "/manifest.edn"))))

(defn- document-cases [m]
  (filter #(str/starts-with? (str (:entry %)) prefix) (:cases m)))

(deftest every-document-case-executes-to-its-expected-value
  ;; A case whose :kir is driven by ANOTHER runner is not run here, and must
  ;; name that runner: document/bytes_link.kotoba is run on KIR by amu test
  ;; --manifest, because this repository's own KIR (kotoba-kir a54916b on the
  ;; JVM classpath) predates the :bytes / :link kinds.
  (let [runs (filter #(= :run (:kind %)) (document-cases (manifest)))
        {cases true elsewhere false} (group-by #(= this-runner (get-in % [:executed-by :kir])) runs)
        executed (atom #{})]
    (doseq [case elsewhere]
      (testing (str (:id case))
        (is (string? (get-in case [:executed-by :kir]))
            "a document case not run here must name the runner that drives :kir")))
    (doseq [case cases]
      (testing (str (:id case))
        (let [hir (sema/analyze (slurp (str conformance-root "/" (:entry case))))
              value (kir/execute (kir/lower hir)
                                 (symbol (or (:function case) "main"))
                                 (vec (:args case)))]
          (is (= (get-in case [:expect :kotoba]) (long value)))
          (swap! executed conj (:id case)))))
    (println (format "EXECUTED\t%d\t%s :run cases on :kir" (count @executed) prefix))
    (is (>= (count @executed) min-executed-run-cases)
        (str "executed " (count @executed) ", floor is " min-executed-run-cases))
    (is (= (into #{} (map :id) cases) @executed) "a declared :run case did not execute")))

(deftest the-fixture-directory-and-the-manifest-agree
  (let [on-disk (->> (kio/file-seq (kio/file (str conformance-root "/document")))
                     (filter #(kio/file? %))
                     (map #(subs (kio/path %) (inc (count conformance-root))))
                     set)
        declared (into #{} (map :entry) (document-cases (manifest)))]
    (is (pos? (count on-disk)) "the fixture directory was not read")
    (is (= on-disk declared)
        (str "fixtures with no case: " (pr-str (sort (remove declared on-disk)))
             "; cases with no fixture: " (pr-str (sort (remove on-disk declared)))))))
