(ns kotoba.lang.ontology-compat-test
  "`lang/compat/kotoba/ontology.kotoba`, pinned structurally.

  The `kotoba-lang/ontology` repository no longer exists on GitHub, so the
  twin under `lang/compat` is the canonical copy (AWAI-3616), kept by a
  `keep` row in `lang/compat-twins.tsv`. The lost repository's
  `registry_test` cannot come back as it was (it ran the `.cljk` sources);
  this test pins the same contract instead: the registry data and the public
  shape of both namespaces, read out of the checked-in `.kotoba` text.

  What this test does NOT do is run the guest code: `conforms?`,
  `tag` and `tagged-conforms?` compute over guest maps, and executing them
  is the `amu check ... --source-path <this repo>/lang/compat --jvm-free`
  route named in `lang/compat.edn`. The negative controls below evaluate the
  rule the `conforms?` docstring states (every declared attribute key must
  be present) against the parsed registry, so a missing required key is red
  here and the guest runtime stays responsible for answering the same."
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            #?(:clj [clojure.edn :as edn]
               :cljs [cljs.reader :as edn])
            [clojure.string :as str]
            #?(:cljs ["node:fs" :as fs])))

(defn- slurp-repo-file [path]
  #?(:clj (slurp path)
     :cljs (.readFileSync fs path "utf8")))

;; The registry literal is valid EDN, but the module text as a whole is not
;; (the `conforms?` body holds a `#(...)` reader form), so only the single
;; `(def registry ...)` form is read.
(defn- registry-of [module-path]
  (let [source (slurp-repo-file module-path)
        start (.indexOf source "(def registry")]
    (when (neg? start)
      (throw (ex-info (str "no (def registry in " module-path) {})))
    (nth (edn/read-string (subs source start)) 2)))

(defn- public-defns [module-path]
  (set (map (comp symbol second) (re-seq #"\(defn\s+([^\s\[]+)" (slurp-repo-file module-path)))))

(def ^:private expected-tender
  {:id :tender
   :name "Procurement Tender / Opportunity"
   :attributes {:status :keyword}
   :key [:status]})

(def ^:private expected-jurisdiction
  {:id :jurisdiction
   :name "Jurisdiction"
   :attributes {:jurisdiction/code :string
                 :jurisdiction/kind :keyword}
   :key [:jurisdiction/code]})

(def ^:private expected-connectors
  [{:id :jp.kkj
    :name "kkj.go.jp 官公需情報ポータル 検索API"
    :object-type :tender
    :repo "https://github.com/kotoba-lang/goyoukiki"
    :status :implemented}
   {:id :jp.geps
    :name "GEPS 落札実績オープンデータ"
    :object-type :tender
    :repo "https://github.com/kotoba-lang/goyoukiki"
    :status :implemented}])

;; The rule the `conforms?` docstring states, over the parsed contract:
;; every attribute key the object type declares must be present in the fact.
(defn- conforms-to? [registry id fact]
  (when-let [type (some #(when (= id (:id %)) %) (:object-types registry))]
    (every? #(contains? fact %) (keys (:attributes type)))))

(deftest jurisdiction-type-is-declared-as-decided
  (let [registry (registry-of "lang/compat/kotoba/ontology.kotoba")]
    (testing "registry identity"
      (is (= :kotoba/ontology (:kotoba.registry/id registry)))
      (is (= 1 (:kotoba.registry/version registry))))
    (testing "exactly the two decided object types"
      (is (= #{:tender :jurisdiction} (set (map :id (:object-types registry))))))
    (testing ":tender is byte-for-byte the pre-existing entry"
      (is (= expected-tender
             (some #(when (= :tender (:id %)) %) (:object-types registry)))))
    (testing ":jurisdiction carries the energy-datoms join keys"
      (is (= expected-jurisdiction
             (some #(when (= :jurisdiction (:id %)) %) (:object-types registry)))))))

(deftest tender-and-connectors-are-unchanged
  (let [registry (registry-of "lang/compat/kotoba/ontology/connector.kotoba")
        onto (registry-of "lang/compat/kotoba/ontology.kotoba")
        type-ids (set (map :id (:object-types onto)))]
    (testing "connector registry identity"
      (is (= :kotoba/ontology-connectors (:kotoba.registry/id registry)))
      (is (= 1 (:kotoba.registry/version registry))))
    (testing "the two connectors are byte-for-byte the pre-existing entries"
      (is (= expected-connectors (:connectors registry))))
    (testing "every connector produces a known object type"
      (is (every? #(contains? type-ids (:object-type %)) (:connectors registry))))
    (testing "no connector in this repository produces jurisdictions"
      (is (empty? (filter #(= :jurisdiction (:object-type %)) (:connectors registry)))))
    (testing "public shapes are unchanged"
      (is (= '#{object-types by-id get-type conforms?}
             (public-defns "lang/compat/kotoba/ontology.kotoba")))
      (is (= '#{connectors by-id get-connector tag tagged-conforms?}
             (public-defns "lang/compat/kotoba/ontology/connector.kotoba"))))))

(deftest negative-controls
  (let [onto (registry-of "lang/compat/kotoba/ontology.kotoba")]
    (testing "a complete jurisdiction fact conforms"
      (is (true? (conforms-to? onto :jurisdiction
                               {:jurisdiction/code "JPN" :jurisdiction/kind :national}))))
    (testing "a fact missing :jurisdiction/kind does not conform"
      (is (false? (conforms-to? onto :jurisdiction {:jurisdiction/code "JPN"}))))
    (testing "a fact missing :jurisdiction/code does not conform"
      (is (false? (conforms-to? onto :jurisdiction {:jurisdiction/kind :national}))))
    (testing "an unknown object type does not conform"
      (is (nil? (conforms-to? onto :no-such-type {:jurisdiction/code "JPN"
                                                 :jurisdiction/kind :national}))))
    (testing ":tender still refuses a fact without its key attribute"
      (is (true? (conforms-to? onto :tender {:status :open})))
      (is (false? (conforms-to? onto :tender {}))))))

(deftest twins-manifest-keeps-both-namespaces
  (let [rows (into {}
                   (comp (remove str/blank?)
                         (remove #(str/starts-with? % "#"))
                         (map #(str/split % #"\t"))
                         (map (fn [cols] [(first cols) cols])))
                   (str/split-lines (slurp-repo-file "lang/compat-twins.tsv")))]
    (doseq [ns-sym ["kotoba.ontology" "kotoba.ontology.connector"]]
      (testing (str ns-sym " is a kept, hand-authored twin")
        (is (contains? rows ns-sym))
        (is (= "keep" (nth (get rows ns-sym) 5)))))))
