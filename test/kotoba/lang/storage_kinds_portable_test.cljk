(ns kotoba.lang.storage-kinds-portable-test
  "The storage byte plane's two capability kinds (superproject
  adr-2609232000-storage-kotoba-cloud-host decision 4a):
  `:object-read` / `:object-write` over `kotoba://storage/<namespace>`.

  Portable on purpose. `q2-catalog-is-the-executable-vocabulary` (the JVM
  suite) already requires `effect-for-kind` and the contract's `:kinds` to be
  one set; this file makes the same claim for these two kinds on the host the
  deployed consumer runs on (a Worker, via kbb's SCI engine), where the JVM
  suite does not run."
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            #?(:clj [clojure.edn :as edn]
               :cljs [cljs.reader :as edn])
            #?(:cljs ["node:fs" :as fs])
            [kotoba.lang.capability-values :as caps]))

(def ^:private semantics-path "lang/capability-semantics.edn")

(defn- semantics []
  (edn/read-string #?(:clj (slurp semantics-path)
                      :cljs (.readFileSync fs semantics-path "utf8"))))

(def ^:private storage-kinds [:object-read :object-write])
(def ^:private resource "kotoba://storage/photos")

(deftest storage-kinds-are-one-vocabulary-with-the-contract
  (let [s (semantics)]
    (doseq [kind storage-kinds]
      (testing (str kind)
        (is (contains? (:kinds s) kind) "named in lang/capability-semantics.edn :kinds")
        (is (= kind (get caps/effect-for-kind kind)) "and a canonical effect of its own")))
    (testing "read and write are separate effects"
      (is (not= (get caps/effect-for-kind :object-read)
                (get caps/effect-for-kind :object-write))))
    (testing "adding kinds did not touch the rules a consumer branches on"
      (is (= :statically-possible-intersect-requested-intersect-delegated-intersect-local-policy-intersect-runtime-available
             (get-in s [:rules :effective-scope])))
      (is (= :forbidden (get-in s [:rules :production-effective-wildcard]))))))

(defn- grant [kind]
  {:grant/kind kind :grant/resources #{resource} :grant/expires nil :grant/id "g"})

(deftest a-storage-grant-intersects-and-does-not-cross-kinds
  (testing "granted, not :unsupported-kind"
    (is (= :object-read
           (:cap/kind (caps/intersect-grants
                       {:requested (caps/make-cap :object-read resource)
                        :cacao-grants [(grant :object-read)]
                        :local-policy {:policy/allow {:object-read #{resource}}}
                        :now "2026-09-24"})))))
  (testing "a read grant does not reach a write"
    (is (= {:denied :empty-intersection}
           (caps/intersect-grants
            {:requested (caps/make-cap :object-write resource)
             :cacao-grants [(grant :object-read)]
             :local-policy {:policy/allow {:object-write #{resource}}}
             :now "2026-09-24"})))))
