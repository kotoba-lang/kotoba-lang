(ns kotoba.lang.lisp-machine-image-vectors-test
  "D2 frozen image vectors (lang/lisp-machine-image-vectors.edn).

  The rule is the one lang/code-identity-vectors.edn states for DefCID: every
  :canonical-hex and :image-cid below is recomputed here and the test fails if
  any one moves. A hand-edited hash turns a regression into a green build, so
  the digests live in a generated file and this namespace re-derives them.

  Expectation-only cases (unknown shape, expired lease, secret carrier) carry
  no digest on purpose: an invented hash only ever tests the rejection path."
  (:require [clojure.edn :as edn]
            [kotoba.io :as io]
            [kotoba.test :refer [deftest is testing]]
            [cbor.core :as cbor]
            [multiformats.core :as mf]
            [kotoba.lang.code-identity :as ci]
            [kotoba.lang.text :as str]))

(def ^:private hex-digits "0123456789abcdef")

(defn- byte->hex [b]
  (let [v (bit-and b 0xff)]
    (str (nth hex-digits (bit-shift-right v 4))
         (nth hex-digits (bit-and v 0x0f)))))

(defn- bytes->hex [bs]
  (apply str (map byte->hex (seq bs))))

(defn- canonical-bytes [payload]
  (cbor/encode (ci/normalize payload)))

(defn- image-cid [payload]
  (mf/cidv1-dag-cbor (canonical-bytes payload)))

(defn- fixture []
  ;; Same loading shape as lang/code-identity-vectors.edn in
  ;; code_identity_test: a repository-relative file, read once.
  (edn/read-string (slurp (io/file "lang/lisp-machine-image-vectors.edn"))))

(deftest fixture-was-scanned-not-assumed
  (let [f (fixture)]
    (is (= 1 (:kotoba.lang.lisp-machine-image-vectors/version f)))
    (is (= :measured (:digests f)))
    (is (= :tagged-dag-cbor-vector (:canonical-form f)))
    (is (= 9 (count (:vectors f))))
    (testing "the scan covered every vector (an incomplete scan and a clean one look identical)"
      (is (= 9 (count (:vectors f)))))))

(deftest every-digest-recomputes
  (let [vs (:vectors (fixture))
        measured (filter :payload vs)]
    (is (= 6 (count measured)) "6 rows carry payloads; the other 3 are expectation-only")
    (doseq [v measured]
      (testing (str (:id v))
        (is (= (:canonical-hex v) (bytes->hex (canonical-bytes (:payload v))))
            "canonical bytes must not move")
        (is (= (:image-cid v) (image-cid (:payload v)))
            "image CID must not move")))))

(deftest expectation-only-cases-carry-no-invented-hash
  (doseq [v (:vectors (fixture))
          :when (nil? (:payload v))]
    (testing (str (:id v))
      (is (nil? (:image-cid v)))
      (is (nil? (:canonical-hex v)))
      (is (map? (:expect v))))))

(deftest save-is-deterministic-and-rebind-moves-the-cid
  (let [vs (:vectors (fixture))
        by-id (into {} (map (juxt :id identity) vs))
        before (by-id :rebind-before)
        after (by-id :rebind-after)]
    (testing "encode twice: byte-identical, one CID (canonical-bytes-before-cid)"
      ;; hex compared, not the raw bytes: Uint8Array `=` is reference equality.
      (is (= (bytes->hex (canonical-bytes (:payload (by-id :save-canonical-deterministic))))
             (bytes->hex (canonical-bytes (:payload (by-id :restore-roundtrip))))))
      (is (= (:image-cid (by-id :save-canonical-deterministic))
             (:image-cid (by-id :restore-roundtrip)))))
    (testing "rebind(env-slot :main) changes the image CID"
      (is (not= (:image-cid before) (:image-cid after))))
    (testing "the running continuation keeps the old binding (spec property, D4)"
      (is (= (get-in before [:payload :image/code-environment :main])
             (get-in (by-id :save-canonical-deterministic)
                     [:payload :image/code-environment :main]))))))

(deftest cid-mismatch-is-detectable-before-decode
  (let [v (->> (:vectors (fixture))
               (filter #(= :restore-verify-cid-before-decode (:id %)))
               first)]
    (is (not= (:declared-cid (:expect v)) (:image-cid v))
        "the declared CID differs from the bytes' CID: verify-cid-before-decode must refuse")
    (is (= :refused (-> v :expect :outcome)))))

(deftest unresolved-lists-the-missing-cid
  (let [v (->> (:vectors (fixture))
               (filter #(= :restore-unresolved-dependency (:id %)))
               first)
        missing (-> v :expect :missing)]
    (is (= :unresolved (-> v :expect :outcome)))
    (is (= 1 (count missing)))
    (is (= (get-in v [:payload :image/world-root]) (first missing))
        "the missing CID is the referenced world root; 0 listed is not clean")))
