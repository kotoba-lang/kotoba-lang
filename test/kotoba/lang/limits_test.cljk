(ns kotoba.lang.limits-test
  "`lang/limits.edn` is the one table of Kotoba's limit values
  (adr-2609242100 P1). This test holds the table to its own shape and holds the
  copies of its numbers that live in THIS repository -- `lang/guest-grammar.edn`
  and `lang/surface-status.edn` -- to the table.

  The copies in other repositories (osaho, kotoba-sema, kotoba-script,
  kotoba-verifier, kotoba-wasm, amu's JS / C / manifests) are compared in amu
  `value_bounds_agreement_test`, against amu's vendored copy of this file:
  amu is the one repository with all of them on its classpath.

  Before P1 the two files here disagreed with the implementations: the grammar
  said `:max-set-items 16` and surface-status said a document has at most 256
  nodes, while every runtime enforced 32 and 4096. Nothing compared them."
  (:require [clojure.edn :as edn]
            [kotoba.test :refer [deftest is testing]]))

(def limits-path "lang/limits.edn")

(defn- read-file [path] (edn/read-string (slurp path)))

(def ^:private sections
  [:language/static :language/value :language/boundary])

(defn- entries
  "Every {:value ...} entry of the language sections, as [path entry]."
  [table]
  (for [section sections
        [k v] (get table section)
        :when (and (map? v) (contains? v :value))]
    [[section k] v]))

(deftest the-table-reads-and-every-entry-has-its-shape
  (let [table (read-file limits-path)
        es (entries table)]
    (println (str "SCANNED\t" (count es) "\tlanguage limit entries"))
    (is (= 1 (:kotoba.lang.limits/version table)))
    (is (< 20 (count es)) "an empty or truncated table would pass the checks below vacuously")
    (doseq [[path {:keys [value why copies]}] es]
      (testing (pr-str path)
        (is (and (integer? value) (pos? value)) "a limit is a positive integer")
        (is (and (string? why) (seq why)) "every limit says why")
        (is (vector? copies))
        (doseq [c copies]
          (is (string? (:repo c)))
          (is (or (:var c) (:pattern c) (:key c) (:name c))
              "a copy says how to find it"))))
    (testing "every target profile is present"
      (doseq [p [:profile/reference :profile/native :profile/wasm
                 :profile/esm :profile/cljs :profile/evm]]
        (is (map? (get table p)) (str p))
        (is (keyword? (get-in table [p :fuel :unit])) (str p " names its fuel unit"))))
    (testing "the boundary budget is the ADR's default"
      (is (= 65536 (get-in table [:language/boundary :traversal-nodes :value])))
      (is (= 1048576 (get-in table [:language/boundary :traversal-bytes :value]))))))

(defn- local-copies
  "Copies of a number that live in this repository's lang/ files."
  [table]
  (for [[path {:keys [value copies]}] (entries table)
        c copies
        :when (and (= "kotoba-lang/kotoba-lang" (:repo c)) (:key c)
                   (not= "prose" (:note c)))]
    {:limit path :value value :file (:path c) :key (:key c)}))

(deftest this-repositorys-copies-agree-with-the-table
  (let [table (read-file limits-path)
        files (into {} (map (fn [p] [p (read-file p)]))
                    ["lang/guest-grammar.edn" "lang/surface-status.edn"])
        copies (local-copies table)]
    (println (str "COMPARED\t" (count copies) "\tlang/ copies"))
    (is (<= 5 (count copies)) "the copies named in the table were not found")
    (doseq [{:keys [limit value file key]} copies]
      (is (= value (get-in (files file) key))
          (str file " " key " disagrees with lang/limits.edn " limit)))))

(deftest the-string-bound-sentence-names-the-table-value
  ;; The grammar states the literal bound inside a refusal sentence, so it is
  ;; compared as text: a number in prose is still a copy.
  (let [table (read-file limits-path)
        bound (get-in table [:language/static :string-literal-bytes :value])
        sentence (get-in (read-file "lang/guest-grammar.edn")
                         [:core-form-shapes :def :value :string-bound])]
    (is (string? sentence))
    (is (re-find (re-pattern (str "at most " bound " --")) sentence)
        "guest-grammar's :string-bound sentence names another number")))

(deftest the-admission-limits-are-referenced-not-copied
  (let [table (read-file limits-path)
        grammar (read-file "lang/guest-grammar.edn")
        {:keys [authority key copies]} (:language/admission table)
        limits (get grammar key)]
    (is (= "lang/guest-grammar.edn" authority))
    (is (map? limits))
    (is (every? limits (keys copies))
        "a referenced admission limit is missing from the grammar")
    (is (= (get-in table [:language/static :typed-set-items :value])
           (:max-set-items limits)))
    (is (= (get-in table [:language/static :callable-arity :value])
           (:max-parameters limits)))))

(deftest the-comparison-can-fail
  ;; Never green by construction: the same lookup against a number the table
  ;; does not hold must disagree.
  (let [table (read-file limits-path)
        {:keys [value file key]} (first (local-copies table))]
    (is (not= (inc value) (get-in (read-file file) key)))))
