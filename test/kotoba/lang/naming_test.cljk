(ns kotoba.lang.naming-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.naming :as naming]
            [kotoba.lang.library-import :as library]))

(deftest lisp-symbol-culture-is-not-the-id-alphabet
  (doseq [name ["_" "_unused" "+" "=" "not=" "!" "?" "valid?" "reset!"
                "*" "*context*" "-" "/" "->" "->>" "string->bytes" "value'"
                "snake_case" "+constant-name+" "%parse" "a+b" "Record" "値を読む"]]
    (is (true? (naming/lisp-name? name)) name)
    (is (false? (naming/project-id? (str "kotoba." name))) name))
  (doseq [name [nil "" "nil" "false" "true" "&" "%" "1" "-42" "+1"
                "#" "#_" "#=" "x#" "@x" "~x" "~@x" "`x" "'x"
                ":x" "^x" "a.b" "a/b" "a b" "a\tb" "a\nb" "a\u00a0b"
                "a\u0000b" "a,b" "a;b" "a(b" "a\\b"]]
    (is (false? (naming/lisp-name? name)) (pr-str name))))

(deftest identifiers-keep-the-established-spelling-profile
  (doseq [value ["kotoba.coll" "kotoba.docs.documentChange" "kotoba.a1B2"]]
    (is (naming/project-id? value))
    (is (= (library/library-id? value) (naming/project-id? value))))
  (is (naming/dotted-id? "example.contract"))
  (is (false? (naming/project-id? "example.contract")))
  (doseq [value [nil 1 'kotoba.coll "kotoba" "kotoba." ".kotoba.coll"
                 "kotoba..coll" "Kotoba.coll" "kotoba.Coll" "kotoba.foo-bar"
                 "kotoba.foo_bar" "kotoba.foo bar" "kotoba.値" "kotoba.a/b"
                 "kotoba.>" "kotoba.*" "kotoba.a#" "kotoba.a?" "kotoba.a!"
                 "kotoba.a\u3000" "kotoba.a\n"]]
    (is (false? (naming/project-id? value)) (pr-str value))))

(deftest qualification-keeps-operator-names-and-division-unambiguous
  (doseq [value ["coll/map-vals" "kotoba.lang.coll/map-vals" "my-lib.core/valid?"
                 "math/+" "math/=" "math//" "ctx/*context*" "自分/読む"]]
    (is (naming/qualified-name? value) value))
  (doseq [value ["/" "coll/" "/map-vals" "a/b/c" "a..b/c" "a/b.c" "a//x"
                 "a.b" "a /b" "a/@b" "a/#b" "a/~b"]]
    (is (false? (naming/qualified-name? value)) value)))

(deftest field-path-shorthand-is-typed-literal-selection
  (is (= {:ok? true :segments ["profile" "display-name"]}
         (naming/parse-field-path "profile.display-name")))
  (is (= {:ok? true :segments ["profile" "firstName"]}
         (naming/parse-field-path "profile.firstName")))
  (doseq [path [["profile" "display.name"] ["items" 0 "name"] ["0"] [""]
                ["*" ">" "a/b" "name with spaces" "日本語"]
                ["items" 9007199254740991]]]
    (is (= {:ok? true :segments path} (naming/parse-field-path path))))
  (doseq [path [nil "" [] '(["a"]) [:profile] ["items" -1] ["items" 1.5]
                ["items" 9007199254740992] ["a" nil] "items.0.name"
                "profile.*" "profile.>" "profile..name" ".name" "name."
                "profile/name" "profile.display\\.name" "profile.a b"
                "profile.a\u00a0b"]]
    (is (= {:ok? false :problem :naming/invalid-field-path}
           (naming/parse-field-path path)) (pr-str path))))

(deftest subject-selectors-have-exact-segment-meaning
  (doseq [[pattern subject result]
          [["kotoba.docs.document.changed" "kotoba.docs.document.changed" true]
           ["kotoba.docs.*.changed" "kotoba.docs.document.changed" true]
           ["kotoba.docs.*.changed" "kotoba.docs.changed" false]
           ["kotoba.docs.*.changed" "kotoba.docs.a.b.changed" false]
           ["kotoba.docs.>" "kotoba.docs.document" true]
           ["kotoba.docs.>" "kotoba.docs.document.changed" true]
           ["kotoba.docs.>" "kotoba.docs" false]
           ["kotoba.>" "kotoba.docs" true]
           ["kotoba.docs.>" "kotoba.Docs.changed" false]
           ["kotoba.docs.doc*" "kotoba.docs.document" false]
           ["kotoba.>.changed" "kotoba.docs.changed" false]
           ["kotoba.docs.*" "kotoba.docs.*" false]]]
    (is (= result (naming/subject-matches? pattern subject)) (str pattern " / " subject)))
  (doseq [pattern [">" "*" "*.docs" "kotoba..*" "kotoba.>.x" "kotoba.doc*"
                   "kotoba.docs.>.*" "kotoba.docs.* " "kotoba.docs.@x"]]
    (is (false? (naming/subscription-pattern? pattern)) pattern))
  (is (naming/subscription-pattern? "kotoba.docs.*"))
  (is (false? (naming/event-subject? "kotoba.docs.*"))))

(def declaration
  {:id "kotoba.docs.document.changed"
   :subject "kotoba.docs.document.changed"
   :payload-schema {:id "kotoba.docs.documentChange"}
   :publish {:operation-id "kotoba.docs.document.changed.publish"}
   :subscribe {:operation-id "kotoba.docs.document.changed.subscribe"
               :pattern "kotoba.docs.*.changed"}
   :field-path ["body" "display.name"]})

(deftest event-name-validation-runs-at-the-declaration-boundary
  (is (:ok? (naming/validate-event-names declaration)))
  (doseq [[path bad] [[[:id] "kotoba-docs"] [[:subject] "kotoba.docs.*"]
                      [[:payload-schema :id] "kotoba.docs.DocumentChange"]
                      [[:publish :operation-id] "kotoba.docs.publish!"]
                      [[:subscribe :operation-id] "kotoba.docs.subscribe?"]
                      [[:subscribe :pattern] "kotoba.docs.>.changed"]
                      [[:field-path] "body.*"]]]
    (is (= {:ok? false :problems [{:problem :naming/invalid-event-name :path path}]}
           (naming/validate-event-names (assoc-in declaration path bad)))))
  (is (false? (:ok? (naming/validate-event-names nil)))))

(deftest malformed-event-containers-refuse-without-throwing
  (doseq [value [42 "event" [] {} {:subscribe 42} {:publish false}
                 (assoc declaration :subscribe 42)]]
    (is (false? (:ok? (naming/validate-event-names value))))))

(deftest whitespace-check-does-not-rewrite-or-reject-reader-compatible-source
  (doseq [source ["(defn map-vals [f m]\n  (f m))\n"
                  "(str \"a\tb\r\n c\u00a0d\") ; comment\ttext\n"
                  "(str \"escaped \\\" quote\tinside\" x)"
                  (str "(vector \\tab \\space " "\\" "\"" " \\; \\))")
                  "; comment containing backslash \\ and quote \"\t\n(x)"]]
    (is (:ok? (naming/validate-source-whitespace source)) (pr-str source)))
  (doseq [source ["(f\tx)" "(f x)\r\n" "(f\u00a0x)" "(f\u3000x)"
                  "(str \"literal\t\"\tx)" "(f \\tab\tx)" (str "(f " "\\" "\"" "\tx)")
                  ";comment\n\t(f x)" ";comment\r\n"]]
    (let [result (naming/validate-source-whitespace source)]
      (is (false? (:ok? result)) (pr-str source))
      (is (every? #(= :naming/noncanonical-whitespace (:problem %)) (:problems result)))))
  (is (false? (:ok? (naming/validate-source-whitespace nil)))))

(deftest alias-compatibility-includes-names-outside-the-canonical-alphabet
  (let [aliases ["kotoba-lang/coll" "io.github.kotoba-lang/coll" "kotoba.lang.coll"
                 "old_lib+name" "retained alias"]
        package {:id "kotoba.coll" :kind :library :path "lib/kotoba.coll"
                 :source-paths ["src"] :aliases aliases}
        catalog {:kotoba.library-catalog/version 1 :packages [package]}]
    (doseq [alias aliases]
      (is (= package (:package (library/resolve-library catalog alias)))))
    (doseq [unknown ["kotoba-coll" "KOTOBA.COLL" " kotoba.coll" "kotoba.coll "
                     "old.lib.name" "retained-alias"]]
      (is (false? (:ok? (library/resolve-library catalog unknown)))))
    (testing "a legacy alias still cannot collide with another ID or alias"
      (is (false? (:ok? (library/validate
                         (update catalog :packages conj
                                 (assoc package :id "kotoba.other" :path "lib/kotoba.other")))))))))
