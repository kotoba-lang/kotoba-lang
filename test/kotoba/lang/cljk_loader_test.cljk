(ns kotoba.lang.cljk-loader-test
  (:require [clojure.test :refer [deftest is]]
            [kotoba.lang.cljk-loader :as loader]))

(deftest kotoba-namespace-attributes-are-data
  (let [n (gensym "compat.ns.")]
    (try
      (binding [*ns* *ns*]
        (eval (list 'ns n
                    {:kotoba/export '[not-yet-defined]
                     :kotoba/schemas '{Payload [:record [value :i64]]}
                     :description '(clojure.core/str "ordinary" " metadata")})))
      (is (= '[not-yet-defined] (:kotoba/export (meta (find-ns n)))))
      (is (= '{Payload [:record [value :i64]]}
             (:kotoba/schemas (meta (find-ns n)))))
      (is (= "ordinary metadata" (:description (meta (find-ns n)))))
      (finally (remove-ns n)))))
