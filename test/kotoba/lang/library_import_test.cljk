(ns kotoba.lang.library-import-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.library-import :as library]
            [kotoba.cli :as cli]))

(def catalog
  {:kotoba.library-catalog/version 1
   :packages [{:id "kotoba.coll" :kind :library :path "lib/kotoba.coll"
               :source-paths ["src"] :aliases ["kotoba-lang/coll" "kotoba.lang.coll"]}
              {:id "kotoba.json" :kind :library :path "lib/kotoba.json"
               :source-paths ["src"] :aliases ["io.github.kotoba-lang/json"]}]})

(deftest exact-names-select-one-source-without-altering-identity
  (doseq [package (:packages catalog) name (cons (:id package) (:aliases package))]
    (let [resolved (library/resolve-library catalog name)]
      (is (:ok? resolved))
      (is (= package (:package resolved)))
      (is (= name (:requested resolved)))))
  (doseq [name ["kotoba-coll" "Kotoba.coll" "app.kotoba.coll" "kotoba.*" "unknown"]]
    (is (= :library/not-found
           (get-in (library/resolve-library catalog name) [:problems 0 :problem])))))

(deftest invalid-catalog-never-yields-a-partial-classpath
  (doseq [bad [(update catalog :packages conj (first (:packages catalog)))
               (assoc-in catalog [:packages 1 :aliases] ["kotoba.coll"])
               (assoc-in catalog [:packages 0 :source-paths] ["../outside"])
               (assoc-in catalog [:packages 0 :aliases] [{:name "old" :target "new"}])]]
    (let [result (library/source-paths bad ["kotoba.coll"])]
      (is (false? (:ok? result)))
      (is (not (contains? result :paths)))))
  (is (= {:ok? true :ids ["kotoba.coll" "kotoba.json"]
          :paths ["lib/kotoba.coll/src" "lib/kotoba.json/src"]}
         (library/source-paths catalog ["kotoba-lang/coll" "kotoba.coll"
                                        "io.github.kotoba-lang/json"])))
  (is (not (:ok? (library/source-paths catalog ["kotoba.coll" "missing"])))))

(defn request [argv] (library/parse-argv argv))

(deftest source-import-requires-explicit-compatibility-runtime
  (is (= {:ok? true :runtime :kotoba} (library/source-request (request ["main.kotoba"]))))
  (is (= :library/runtime-required
         (:problem (library/source-request (request ["main.cljk" "--library" "kotoba.coll"])))))
  (is (= {:ok? true :runtime :sci :libraries ["kotoba.coll" "kotoba-lang/json"]
          :entry "main.cljk" :source-roots ["src"] :function "main" :arguments ["42"]}
         (library/source-request
           (request ["main.cljk" "--runtime" "sci" "--library" "kotoba.coll"
                     "--library" "kotoba-lang/json" "-S" "src" "--arg" "42"]))))
  (doseq [extra [["--policy" "allow.edn"] ["--package-lock" "lock.edn"]
                ["--target" "wasm"] ["--unknown"]]]
    (is (= :library/unsupported-option
           (:problem (library/source-request
                       (request (into ["main.cljk" "--runtime" "sci" "--library" "kotoba.coll"] extra)))))))
  (doseq [argv [["main.kotoba" "--runtime" "sci" "--library" "kotoba.coll"]
                ["main.cljk" "--runtime" "sci"]
                ["main.cljk" "--runtime" "sci" "--library"]
                ["main.cljk" "--runtime" "sci" "--library" "kotoba.coll" "--function"]
                ["main.cljk" "--runtime" "other"]]]
    (is (false? (:ok? (library/source-request (request argv)))))))

(deftest discovery-does-not-require-a-signed-store
  (is (= {:ok? true :libraries ["kotoba.coll" "kotoba-lang/json"]}
         (library/import-request (request ["import" "kotoba.coll" "kotoba-lang/json" "--json"]))))
  (doseq [argv [["import"] ["import" "kotoba.coll" "--store" "codebase"]
                ["import" "kotoba.coll" "--endpoint" "https://example.com"]]]
    (is (false? (:ok? (library/import-request (request argv)))))))

(deftest public-dispatch-reuses-the-import-contract
  (let [contract {:kotoba.cli.contract/commands [{:id :run} {:id :library}]}]
    (is (= :library/import-planned
           (:kotoba.cli/code (cli/dispatch contract ["library" "import" "kotoba-lang/coll"]))))
    (is (= :library/runtime-required
           (:kotoba.cli/code (cli/dispatch contract ["run" "main.cljk" "--library" "kotoba.coll"]))))
    (is (= :command/planned
           (:kotoba.cli/code (cli/dispatch contract ["run" "main.cljk" "--runtime" "sci"
                                                     "--library" "kotoba.coll"]))))))

(deftest option-shaping-preserves-negative-arguments-and-boolean-order
  (is (= {:positionals ["import" "kotoba.coll"] :options {:json true}}
         (library/parse-argv ["import" "--json" "kotoba.coll"])))
  (is (= ["-42" "{:a -1}"]
         (:arguments (library/source-request
                       (request ["--json" "main.cljk" "--runtime" "sci"
                                 "--library" "kotoba.coll" "--arg" "-42" "--arg" "{:a -1}"])))))
  (is (= :library/duplicate-option
         (:problem (library/source-request
                     (request ["main.cljk" "--runtime" "sci" "--runtime" "kotoba"
                               "--library" "kotoba.coll"]))))))

(def external-catalog
  {:kotoba.library-catalog/version 1
   :namespace-authorities [{:prefix "kotoba" :authority :kotoba-project :dns-authority? false}
                           {:prefix "org" :authority :external-reverse-domain :dns-authority? false}
                           {:prefix "gov" :authority :external-reverse-domain :dns-authority? false}]
   :packages [{:id "kotoba.coll" :kind :library :path "lib/kotoba.coll"
               :source-paths ["src"] :aliases []}
              {:id "org.ietf.cbor" :kind :library :path "lib/org.ietf.cbor"
               :source-paths ["src"] :aliases ["kotoba-lang/org-ietf-cbor"]}
              {:id "gov.nist.sha3" :kind :library :path "lib/gov.nist.sha3"
               :source-paths ["src"] :aliases ["kotoba-lang/org-nist-sha3"]}]})

(deftest declared-external-roots-admit-reverse-domain-library-ids
  (is (:ok? (library/validate external-catalog)))
  (doseq [name ["org.ietf.cbor" "gov.nist.sha3" "kotoba-lang/org-nist-sha3" "kotoba.coll"]]
    (is (:ok? (library/resolve-library external-catalog name)) name))
  (is (= {:ok? true :ids ["org.ietf.cbor"] :paths ["lib/org.ietf.cbor/src"]}
         (library/source-paths external-catalog ["org.ietf.cbor"])))
  (testing "a catalog without declared roots keeps the single kotoba root"
    (is (false? (:ok? (library/validate (dissoc external-catalog :namespace-authorities)))))
    (is (:ok? (library/validate catalog)))))

(deftest namespace-authority-declarations-are-checked
  (doseq [bad [(assoc external-catalog :namespace-authorities [])
               (assoc external-catalog :namespace-authorities "org")
               (assoc-in external-catalog [:namespace-authorities 1 :dns-authority?] true)
               (assoc-in external-catalog [:namespace-authorities 1 :authority] :kotoba-project)
               (assoc-in external-catalog [:namespace-authorities 0 :authority] :external-reverse-domain)
               (assoc-in external-catalog [:namespace-authorities 1 :prefix] "org-x")
               (assoc-in external-catalog [:namespace-authorities 2 :prefix] "org")
               (assoc external-catalog :namespace-authorities
                      [{:prefix "org" :authority :external-reverse-domain :dns-authority? false}])
               (update external-catalog :packages conj
                       {:id "org.ietf" :kind :library :path "lib/org.ietf" :source-paths ["src"] :aliases []})
               (update external-catalog :packages conj
                       {:id "com.adobe.cmap" :kind :library :path "lib/com.adobe.cmap"
                        :source-paths ["src"] :aliases []})]]
    (let [result (library/source-paths bad ["kotoba.coll"])]
      (is (false? (:ok? result)) (pr-str (:namespace-authorities bad)))
      (is (not (contains? result :paths))))))
