(ns kotoba.lang.operation-registry-test
  "lang/operations.edn against the tables kotoba-sema and osaho actually hold
  (root ADR-2610092330 R0).

  The tables are read from SOURCE, not from this repository's classpath. The
  classpath pins are weeks behind the layers' main branches, and on the JVM
  `kotoba.kir` resolves to the older kotoba-kir library's kir.cljc ahead of
  osaho's kir.cljk -- so a classpath read would check the registry against
  code no current program runs. Each table is a quoted literal (`'{...}` /
  `'#{...}`), read as data without evaluating anything.

  Where: KOTOBA_SEMA_DIR and OSAHO_DIR, defaulting to the sibling checkouts
  ../kotoba-sema and ../osaho that CI clones. A missing checkout FAILS: a run
  that compared nothing is not a run that found nothing wrong."
  (:require [clojure.edn :as edn]
            [kotoba.io :as kio]
            [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.operation-registry :as reg]))

(def ^:private min-compared
  "A ratchet: raise it when a family or a layer joins, never lower it.
  2026-10-09: 3 layers x the document family's 43 names."
  129)

(defn- env [k default]
  ;; JVM only, like the regex below: the suite runs on the JVM
  (let [v (System/getenv k)] (if (str/blank? v) default v)))

(defn- quoted-def
  "The literal bound by `(def NAME '...)` in TEXT (^:private and a docstring
  allowed), or nil."
  [text name]
  (let [m (re-find (re-pattern (str "\\(def\\s+(?:\\^:private\\s+)?" (java.util.regex.Pattern/quote name)
                                    "\\s+(?:\"(?:[^\"\\\\]|\\\\.)*\"\\s+)?'"))
                   text)]
    (when m
      (edn/read-string (subs text (+ (str/index-of text m) (count m)))))))

(defn- read-source [dir path]
  (let [f (kio/file (str dir "/" path))]
    (is (kio/file? f) (str "missing " (kio/path f) " -- set the checkout's directory"))
    (when (kio/file? f) (slurp f))))

(defn- layers []
  (let [sema (read-source (env "KOTOBA_SEMA_DIR" "../kotoba-sema") "src/kotoba/compiler/frontend.cljk")
        kir (read-source (env "OSAHO_DIR" "../osaho") "src/kotoba/kir.cljk")]
    (when (and sema kir)
      (let [fixed (quoted-def sema "document-fixed-operations")
            variadic (quoted-def sema "document-variadic-operations")
            kir-ops (quoted-def kir "non-string-typed-ops")
            native (quoted-def kir "native-document-operation-arities")]
        (is (map? fixed) "kotoba-sema document-fixed-operations was not read")
        (is (set? variadic) "kotoba-sema document-variadic-operations was not read")
        (is (set? kir-ops) "osaho non-string-typed-ops was not read")
        (is (map? native) "osaho native-document-operation-arities was not read")
        {:kotoba-sema (merge fixed
                             ;; sema keeps no arity for these; the registry
                             ;; says :any / :even, which is the shape they have
                             (zipmap variadic (repeat :admitted)))
         :kir (zipmap (filter #(str/starts-with? (str %) "document-") kir-ops) (repeat :admitted))
         :native native}))))

(defn- registry [] (edn/read-string (slurp "lang/operations.edn")))

(defn- check-vector-family
  "A vector family against kotoba-sema's typed table (+ its variadic NEW,
  which sema keeps out of the table), osaho's typed set (+ NEW, a core head
  there) and native-vector-operations (which carries both families)."
  [family sema-table new-op floor]
  (let [sema (read-source (env "KOTOBA_SEMA_DIR" "../kotoba-sema") "src/kotoba/compiler/frontend.cljk")
        kir (read-source (env "OSAHO_DIR" "../osaho") "src/kotoba/kir.cljk")]
    (when (and sema kir)
      (let [s-table (quoted-def sema sema-table)
            n-set (quoted-def kir "native-vector-operations")
            kir-ops (quoted-def kir "non-string-typed-ops")
            r (registry)
            names (into (reg/family-operations r family) (keys s-table))
            {:keys [problems compared]}
            (reg/check r family names
                       {:kotoba-sema (assoc s-table new-op :admitted)
                        :kir (assoc (zipmap (filter names kir-ops) (repeat :admitted)) new-op :admitted)
                        :native (zipmap (filter names n-set) (repeat :admitted))})]
        (is (map? s-table) (str "kotoba-sema " sema-table " was not read"))
        (is (set? n-set) "osaho native-vector-operations was not read")
        (println (format "COMPARED\t%d\toperation x layer pairs (%s family; %d problems)"
                         compared (name family) (count problems)))
        (is (empty? problems) (str/join "\n" (map pr-str problems)))
        (is (>= compared floor) (str "compared " compared ", floor is " floor))))))

(deftest the-vector-family-agrees-with-sema-and-osaho
  ;; R4. vector-new is outside osaho's typed set: KIR evaluates it as a core
  ;; head (vector/operations.kotoba runs it on KIR through amu test --manifest)
  (check-vector-family :vector "typed-vector-operations" 'vector-new 30))

(deftest the-vector-f64-family-agrees-with-sema-and-osaho
  (check-vector-family :vector-f64 "typed-f64-vector-operations" 'vector-f64-new 24))

(defn- check-typed-family
  "A parametric [:map K V] / [:set T] family against kotoba-sema's set of its
  heads (arity is checked by shape there), osaho's typed set, and osaho's
  native table (arity counting the type argument)."
  [family sema-set native-table floor]
  (let [sema (read-source (env "KOTOBA_SEMA_DIR" "../kotoba-sema") "src/kotoba/compiler/frontend.cljk")
        kir (read-source (env "OSAHO_DIR" "../osaho") "src/kotoba/kir.cljk")]
    (when (and sema kir)
      (let [s-set (quoted-def sema sema-set)
            n-table (quoted-def kir native-table)
            kir-ops (quoted-def kir "non-string-typed-ops")
            r (registry)
            names (into (reg/family-operations r family) s-set)
            {:keys [problems compared]}
            (reg/check r family names
                       {:kotoba-sema (zipmap s-set (repeat :admitted))
                        :kir (zipmap (filter names kir-ops) (repeat :admitted))
                        :native n-table})]
        (is (set? s-set) (str "kotoba-sema " sema-set " was not read"))
        (is (map? n-table) (str "osaho " native-table " was not read"))
        (println (format "COMPARED\t%d\toperation x layer pairs (%s family; %d problems)"
                         compared (name family) (count problems)))
        (is (empty? problems) (str/join "\n" (map pr-str problems)))
        (is (>= compared floor) (str "compared " compared ", floor is " floor))))))

(deftest the-typed-map-family-agrees-with-sema-and-osaho
  (check-typed-family :typed-map "canonical-typed-map-operations" "native-typed-map-operation-arities" 30))

(deftest the-typed-list-family-agrees-with-sema-and-osaho
  (check-typed-family :typed-list "canonical-list-operations" "native-typed-list-operation-arities" 9))

(deftest the-typed-set-family-agrees-with-sema-and-osaho
  (check-typed-family :typed-set "typed-set-operations" "native-typed-set-operation-arities" 21))

(deftest the-bytes-family-agrees-with-sema-and-osaho
  ;; R4: the :bytes family. Its names share no prefix (bytes-*, but also
  ;; vector-i64-from-bytes and string-from-utf8), so the family is the union
  ;; of the layers' own tables plus the registry's.
  (let [sema (read-source (env "KOTOBA_SEMA_DIR" "../kotoba-sema") "src/kotoba/compiler/frontend.cljk")
        kir (read-source (env "OSAHO_DIR" "../osaho") "src/kotoba/kir.cljk")]
    (when (and sema kir)
      (let [s-table (quoted-def sema "bytes-operations")
            n-table (quoted-def kir "native-bytes-operations")
            kir-ops (quoted-def kir "non-string-typed-ops")
            r (registry)
            names (into (reg/family-operations r :bytes) (concat (keys s-table) (keys n-table)))
            {:keys [problems compared]}
            (reg/check r :bytes names
                       {:kotoba-sema s-table
                        :kir (zipmap (filter names kir-ops) (repeat :admitted))
                        :native n-table})]
        (is (map? s-table) "kotoba-sema bytes-operations was not read")
        (is (map? n-table) "osaho native-bytes-operations was not read")
        (println (format "COMPARED\t%d\toperation x layer pairs (bytes family; %d problems)"
                         compared (count problems)))
        (is (empty? problems) (str/join "\n" (map pr-str problems)))
        (is (>= compared 24) (str "compared " compared ", floor is 24"))))))

(deftest the-verifier-admits-what-native-admits
  ;; R3: kotoba-verifier keeps its own native document table; it must agree
  ;; with the registry's :native column exactly as osaho's does (the same
  ;; known mismatch included)
  (when-let [src (read-source (env "KOTOBA_VERIFIER_DIR" "../kotoba-verifier") "src/kotoba/verifier.cljk")]
    (let [table (quoted-def src "document-operations")]
      (is (map? table) "kotoba-verifier document-operations was not read")
      (when (map? table)
        (let [r (registry)
              ;; the verifier answers to the :native column, under its own
              ;; layer name so its known mismatches are its own
              as-verifier (update r :operations
                                  (fn [ops] (into {} (map (fn [[op e]] [op (assoc-in e [:layers :verifier] (get-in e [:layers :native]))]))
                                                  ops)))
              {:keys [problems compared]} (reg/check as-verifier :document "document-" {:verifier table})]
          (println (format "COMPARED\t%d\tverifier operation pairs (%d problems)" compared (count problems)))
          (is (empty? problems) (str/join "\n" (map pr-str problems)))
          (is (>= compared 43)))))))

(deftest the-registry-agrees-with-sema-and-osaho
  (when-let [ls (layers)]
    (let [{:keys [problems compared]} (reg/check (registry) :document "document-" ls)]
      (println (format "COMPARED\t%d\toperation x layer pairs (document family; %d problems)"
                       compared (count problems)))
      (is (empty? problems) (str/join "\n" (map pr-str problems)))
      (is (>= compared min-compared)
          (str "compared " compared ", floor is " min-compared)))))

(deftest the-comparison-sees-each-kind-of-disagreement
  ;; the check is only worth what it catches: one registry, one layer, every
  ;; problem type produced on purpose
  (let [r {:operations {'a {:family :f :arity 1 :layers {:l :implemented}}
                        'b {:family :f :arity 1 :layers {:l :implemented}}
                        'c {:family :f :arity 1 :layers {:l :pending}}
                        'd {:family :f :arity 1 :layers {:l {:status :refused :why "x"}}}
                        'e {:family :f :arity 2 :layers {:l :implemented}}}}
        layer {'a 1 'c 1 'd 1 'e 3 'f-new 1}
        types (into #{} (map :type) (:problems (reg/check r :f "" {:l layer})))]
    (is (= #{:registry-implemented-but-layer-lacks :registry-pending-but-layer-admits
             :layer-admits-refused :arity-mismatch :layer-admits-unregistered}
           types)))
  (testing "a known mismatch suppresses its own problem and must still occur"
    (let [r {:operations {'e {:family :f :arity 2 :layers {:l :implemented}}}
             :known-mismatches {[:l 'e :arity] {:as-of "x"}}}]
      (is (empty? (:problems (reg/check r :f "" {:l {'e 3}}))))
      (is (= [:known-mismatch-no-longer-occurs]
             (map :type (:problems (reg/check r :f "" {:l {'e 2}})))))))
  (testing "another family's run does not see a known mismatch"
    (let [r {:operations {'e {:family :f :arity 2 :layers {:l :implemented}}
                          'g {:family :h :arity 1 :layers {:l :implemented}}}
             :known-mismatches {[:l 'e :arity] {:as-of "x"}}}]
      (is (empty? (:problems (reg/check r :h #{'g} {:l {'g 1}})))))))

(deftest every-entry-has-the-shape-the-header-describes
  (let [r (registry)
        layers (:checked-layers r)]
    (is (pos? (count (:operations r))))
    (doseq [[op entry] (:operations r)]
      (testing (str op)
        (is (contains? (:families r) (:family entry)))
        (is (or (nat-int? (:arity entry)) (contains? #{:any :even :some} (:arity entry))))
        (is (if (keyword? (:arity entry)) (contains? entry :item) (vector? (:params entry))))
        (when (vector? (:params entry))
          ;; the arity counts a parametric operation's literal type argument
          (is (= (:arity entry) (+ (count (:params entry)) (if (:type-arg entry) 1 0)))))
        (is (some? (:result entry)))
        (is (= layers (set (keys (:layers entry)))) "every checked layer is stated")
        (doseq [[_ v] (:layers entry)]
          (is (or (contains? #{:implemented :pending} v)
                  (and (= :refused (:status v)) (string? (:why v))))))))))
