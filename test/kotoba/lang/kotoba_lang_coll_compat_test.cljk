(ns kotoba.lang.kotoba-lang-coll-compat-test
  "`lang/compat/kotoba/lang/coll.kotoba`, checked against the HOST
  `kotoba.lang.coll` -- the `.cljk` library in `kotoba-lang/coll` that this
  module stands in for on the self-host route (adr-2609111900).

  The oracle is the real function: `coll/set-union`, `coll/set-intersection`,
  `coll/set-difference`, `coll/subset?` and `coll/superset?`, required from
  the host library a `.cljk` author wrote against, and called on every pair
  of subsets of a five-element universe (32 x 32 = 1,024 pairs per function)
  while the Kotoba text answers the same pairs on the KIR interpreter. That
  sweep contains every boundary the five definitions have -- both operands
  empty, one empty, equal sets, disjoint sets, a proper subset each way --
  without anyone having to think of them. Whether clojure.set agrees with
  the host coll is a separate question with its own test
  (`clojure_set_compat_test`).

  The module is a TEMPLATE (`(:params [elem :keyword])`), and this
  repository has no project linker to instantiate it, so this test does what
  amu's linker does and nothing more: substitutes the bound type for the
  parameter symbol inside every keyword-headed vector and drops the `ns`
  form -- the same harness as `clojure_set_compat_test`.

  Sets cross the interpreter boundary as BIT MASKS over the universe
  `[:a :b :c :d :e]`: the harness builds a keyword set from an i64 and reads
  one back to an i64, so the interpreter is only ever asked for an integer.
  Portable: runs on nbb (run-tests.cljk) and, where the `.cljk` sources can
  be loaded, on the JVM."
  (:require #?(:clj [clojure.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            #?(:clj [clojure.edn :as edn]
               :cljs [cljs.reader :as edn])
            #?(:cljs ["node:fs" :as fs])
            [clojure.set :as set]
            [clojure.walk :as walk]
            [kotoba.lang.coll :as coll]
            [kotoba.lang.text :as str]
            [kotoba.kir :as kir]
            [kotoba.sema :as sema]))

(defn- slurp-repo-file [path]
  #?(:clj (slurp path)
     :cljs (.readFileSync fs path "utf8")))

(def ^:private module-path "lang/compat/kotoba/lang/coll.kotoba")
(def ^:private module (delay (slurp-repo-file module-path)))

(def ^:private universe [:a :b :c :d :e])

;; What amu's `kotoba.compiler.project/instantiate-forms` does for the one
;; type position this module uses: a parameter symbol inside a keyword-headed
;; vector is the bound type.
(defn- instantiate [forms binding]
  (walk/postwalk (fn [form]
                   (if (and (vector? form) (keyword? (first form)))
                     (mapv #(get binding % %) form)
                     form))
                 forms))

;; The reader answers integer literals as BigInt on this host, and `pr-str`
;; renders a BigInt as `#object[BigInt 0]`, which the reader then refuses on
;; the way back in. Printed as plain numbers; every integer in this module is
;; a small loop index.
(defn- readable-integers [forms]
  #?(:clj forms
     :cljs (walk/postwalk (fn [x] (if (and (some? x) (= js/BigInt (.-constructor x))) (js/Number x) x)) forms)))

(defn- forms-of [source binding]
  (->> (sema/read-forms source)
       (remove #(and (seq? %) (= 'ns (first %))))
       (#(instantiate % binding))
       readable-integers
       (map pr-str)
       (str/join "\n")))

;; `mk` builds a keyword set from a bit mask over the universe; `bits` reads
;; one back. The five entries under test take two masks and answer a mask
;; (or 0/1 for the predicates).
(def ^:private harness
  "(defn mk [b :i64] [:set :keyword]
     (let [s0 (typed-set-new [:set :keyword])
           s1 (if (= 1 (bit-and b 1)) (conj s0 :a) s0)
           s2 (if (= 2 (bit-and b 2)) (conj s1 :b) s1)
           s3 (if (= 4 (bit-and b 4)) (conj s2 :c) s2)
           s4 (if (= 8 (bit-and b 8)) (conj s3 :d) s3)]
       (if (= 16 (bit-and b 16)) (conj s4 :e) s4)))
   (defn bits [s [:set :keyword]] :i64
     (+ (if (typed-set-contains [:set :keyword] s :a) 1 0)
        (if (typed-set-contains [:set :keyword] s :b) 2 0)
        (if (typed-set-contains [:set :keyword] s :c) 4 0)
        (if (typed-set-contains [:set :keyword] s :d) 8 0)
        (if (typed-set-contains [:set :keyword] s :e) 16 0)))
   (defn u [x :i64 y :i64] :i64 (bits (set-union (mk x) (mk y))))
   (defn d [x :i64 y :i64] :i64 (bits (set-difference (mk x) (mk y))))
   (defn i [x :i64 y :i64] :i64 (bits (set-intersection (mk x) (mk y))))
   (defn sub [x :i64 y :i64] :i64 (if (subset? (mk x) (mk y)) 1 0))
   (defn sup [x :i64 y :i64] :i64 (if (superset? (mk x) (mk y)) 1 0))
   (defn main [] :i64 0)")

(def ^:private lowered
  (delay (kir/lower (sema/analyze (str (forms-of @module {'elem :keyword}) "\n" harness)))))

(defn- to-long [v]
  #?(:clj (long v) :cljs (js/Number v)))

(defn- call [function x y]
  (to-long (kir/execute @lowered function [x y])))

(defn- decode [mask]
  (into #{} (keep-indexed (fn [index k] (when (pos? (bit-and mask (bit-shift-left 1 index))) k))) universe))

(defn- encode [s]
  (reduce + (keep-indexed (fn [index k] (when (contains? s k) (bit-shift-left 1 index))) universe)))

(def ^:private pairs (for [x (range 32) y (range 32)] [x y]))

(defn- disagreements [function oracle]
  (remove (fn [[x y]] (= (call function x y) (oracle x y))) pairs))

(deftest matches-the-host-coll-on-every-pair-of-subsets
  (doseq [[label function oracle]
          [["set-union" 'u (fn [x y] (encode (coll/set-union (decode x) (decode y))))]
           ["set-difference" 'd (fn [x y] (encode (coll/set-difference (decode x) (decode y))))]
           ["set-intersection" 'i (fn [x y] (encode (coll/set-intersection (decode x) (decode y))))]
           ["subset?" 'sub (fn [x y] (if (coll/subset? (decode x) (decode y)) 1 0))]
           ["superset?" 'sup (fn [x y] (if (coll/superset? (decode x) (decode y)) 1 0))]]]
    (testing label
      (let [bad (vec (disagreements function oracle))]
        (is (= 1024 (count pairs)))
        (is (empty? bad) (str label " disagrees with kotoba.lang.coll on " (pr-str (take 8 bad))))))))

(deftest the-boundaries-answer-what-the-host-coll-answers
  ;; Named, so a reader sees them without decoding the sweep: the empty set
  ;; is a subset of everything and of itself, and everything is a superset of
  ;; the empty set; difference of a set from itself is empty; a member absent
  ;; from s1 is a no-op for difference; superset? is subset? swapped.
  (is (= 1 (call 'sub 0 0)))
  (is (= 1 (call 'sub 0 31)))
  (is (= 0 (call 'sub 31 0)))
  (is (= 1 (call 'sup 0 0)))
  (is (= 1 (call 'sup 31 0)))
  (is (= 0 (call 'sup 0 31)))
  (is (= (call 'sub 5 7) (call 'sup 7 5)))
  (is (= 0 (call 'd 31 31)))
  (is (= 1 (call 'd 1 30)))
  (is (= 31 (call 'u 21 10)))
  (is (= 0 (call 'i 21 10)))
  ;; and the same four, asked of the host directly, so the oracle is seen
  ;; answering what the sweep compares against.
  (is (true? (coll/subset? #{} #{})))
  (is (true? (coll/superset? #{:a :b :c :d :e} #{})))
  (is (= #{} (coll/set-difference #{:a} #{:a})))
  (is (= #{:a} (coll/set-difference #{:a} #{:b :c :d :e}))))

(defn- public-names [source]
  (set (map (comp symbol second) (re-seq #"(?m)^\(defn\s+([^\s\[]+)" source))))

;; The host library's export list, read from the host itself where the host
;; can say (the `:kotoba/export` ns metadata on the JVM); on nbb the ns
;; metadata is not reachable, so the list is pinned here and the `:provides`
;; / `:absent` partition below has to cover exactly it.
(def ^:private host-exports
  '#{assoc-some bounded-postwalk bounded-prewalk deep-merge default-max-walk-depth
     filter-keys filter-vals index index-by join keywordize-keys map-keys map-vals
     postwalk postwalk-replace prewalk prewalk-replace project rename rename-keys
     select set-difference set-intersection set-union stringify-keys subset?
     superset? walk})

(deftest the-module-provides-exactly-what-the-contract-records
  (let [contract (edn/read-string (slurp-repo-file "lang/compat.edn"))
        entry (get-in contract [:modules :kotoba.lang.coll])]
    (testing "the provided names are the public defns, and nothing absent is provided"
      (is (= (:provides entry) (public-names @module)))
      (is (= '#{set-union set-intersection set-difference subset? superset?} (:provides entry)))
      (is (empty? (set/intersection (:provides entry) (set (keys (:absent entry)))))))
    (testing "the template declares the default binding the contract records"
      (is (re-find #"\(:params \[elem :keyword\]\)" @module))
      (is (= {'elem :keyword} (:default-binding entry))))
    (testing "every host export is either provided or absent with a reason"
      (let [recorded (set/union (:provides entry) (set (keys (:absent entry))))]
        (is (= host-exports recorded)
            (str "unrecorded: " (pr-str (set/difference host-exports recorded))
                 " extra: " (pr-str (set/difference recorded host-exports))))
        (is (every? (fn [[_ v]] (string? (:reason v))) (:absent entry)))))
    (testing "every provided name resolves on the host, as the function the oracle calls"
      (is (fn? coll/set-union))
      (is (fn? coll/set-intersection))
      (is (fn? coll/set-difference))
      (is (fn? coll/subset?))
      (is (fn? coll/superset?)))))
