(ns kotoba.lang.kotoba-lang-text-compat-test
  "`lang/compat/kotoba/lang/text.kotoba`, checked against the HOST
  `kotoba.lang.text` -- the `.cljk` library in `kotoba-lang/text` that this
  module stands in for on the self-host route (adr-2609111900).

  The oracle is the real function, required under the very alias the
  compiler's sources use (`[kotoba.lang.text :as str]`), and called on a
  shared input table. A `.cljk` author wrote against THAT function; whether
  clojure.string agrees with it is a separate question with its own test
  (`clojure_string_compat_test`) and, for `replace` on an empty match, a
  different answer (see `the-one-place-this-is-not-clojure-string`).

  The forwarders are one-line calls into `kotoba.string` / `kotoba.string.join`,
  so the behaviour under test is the canonical module's, source-concatenated
  here because the KIR reference interpreter has no project linker -- the
  same arrangement as `clojure_set_compat_test`. A separate assertion reads
  the forwarding module as TEXT and holds that every export is a single call
  to the same name, so a forwarder that drifted into an implementation of its
  own would be caught even though these behaviour tests never run it.

  Portable: runs on nbb (run-tests.cljk), which is the suite that runs now."
  (:require #?(:clj [clojure.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            #?(:clj [clojure.edn :as edn]
               :cljs [cljs.reader :as edn])
            #?(:cljs ["node:fs" :as fs])
            [clojure.set :as set]
            [clojure.string]
            [clojure.walk :as walk]
            [kotoba.lang.text :as str]
            [kotoba.kir :as kir]
            [kotoba.sema :as sema]))

(defn- slurp-repo-file [path]
  #?(:clj (slurp path)
     :cljs (.readFileSync fs path "utf8")))

(def ^:private forwarder-path "lang/compat/kotoba/lang/text.kotoba")
(def ^:private forwarder (delay (slurp-repo-file forwarder-path)))
(def ^:private canonical (delay (slurp-repo-file "lang/compat/kotoba/string.kotoba")))
(def ^:private join-module (delay (slurp-repo-file "lang/compat/kotoba/string/join.kotoba")))

;; Every forwarded name reached through an entry the host can call with
;; strings and integers. `join` takes a [:list :string], which can only be
;; CONSTRUCTED with a statically known item count, so one entry per arity.
;; The option-valued index functions cross as a presence flag and a value.
(def ^:private harness
  "(defn sw [s :string p :string] :i64 (if (starts-with? s p) 1 0))
   (defn ew [s :string p :string] :i64 (if (ends-with? s p) 1 0))
   (defn inc? [s :string p :string] :i64 (if (includes? s p) 1 0))
   (defn bl [s :string] :i64 (if (blank? s) 1 0))
   (defn tr [s :string] :string (trim s))
   (defn trl [s :string] :string (triml s))
   (defn trr [s :string] :string (trimr s))
   (defn rv [s :string] :string (reverse s))
   (defn present? [s :string v :string] :i64 (if-some [i (index-of s v)] 1 0))
   (defn value [s :string v :string] :i64 (if-some [i (index-of s v)] i -1))
   (defn last-present? [s :string v :string] :i64 (if-some [i (last-index-of s v)] 1 0))
   (defn last-value [s :string v :string] :i64 (if-some [i (last-index-of s v)] i -1))
   (defn rp [s :string m :string r :string] :string (replace s m r))
   (defn j0 [sep :string] :string (join sep (typed-list-new [:list :string])))
   (defn j1 [sep :string a :string] :string (join sep (typed-list-new [:list :string] a)))
   (defn j2 [sep :string a :string b :string] :string (join sep (typed-list-new [:list :string] a b)))
   (defn j3 [sep :string a :string b :string c :string] :string (join sep (typed-list-new [:list :string] a b c)))
   (defn main [] :i64 0)")

;; The reader answers integer literals as BigInt on this host, and `pr-str`
;; renders a BigInt as `#object[BigInt 0]`, which the reader then refuses on
;; the way back in (the same seam clojure_set_compat_test crosses). Printed as
;; plain numbers; every integer in these modules is a small offset or width.
(defn- readable-integers [forms]
  #?(:clj forms
     :cljs (walk/postwalk (fn [x] (if (and (some? x) (= js/BigInt (.-constructor x))) (js/Number x) x)) forms)))

(defn- forms-of [source]
  (->> (sema/read-forms source)
       (remove #(and (seq? %) (= 'ns (first %))))
       readable-integers
       (map pr-str)
       (str/join "\n")))

(def ^:private lowered
  (delay (kir/lower (sema/analyze (str (forms-of @canonical) "\n"
                                       (forms-of @join-module) "\n"
                                       harness)))))

(defn- to-long [v]
  #?(:clj (long v) :cljs (js/Number v)))

(defn- call [function & args]
  (kir/execute @lowered function (vec args) {:fuel 100000000}))

(defn- flag [function & args]
  (= 1 (to-long (apply call function args))))

;; ---------------------------------------------------------------------------
;; The shared input table. Multi-byte, astral, empty, and every whitespace
;; the host library's `java-whitespace?` names -- so a scan that counted
;; bytes, or UTF-16 units, or only ASCII blanks, disagrees with the oracle
;; somewhere in here.

(def ^:private strings
  ["" "a" "ab" "hello" "ababa" "あいう" "aあb" "日本語" "a😀b" "😀😀" "aあ😀"
   " " "\t" "\n" " a " "\t\ta\n" "\u3000a\u3000" "\u00a0a\u00a0" "\u2007a"
   "\u202fa\u202f" "\u0085a\u0085" "\u2028a\u2029" "\u1680a\u205f" " あ "
   "😀 " " 😀" "\u000b\u000c" "\u001c\u001f a" "x\u2007" "日本語\u3000" "\r\n" "a\u0301" "🇯🇵"])

(def ^:private needles
  ["" "a" "b" "ab" "he" "lo" "ba" "z" "あ" "い" "いう" "aあ" "あb" "本" "語" "😀" "😀b" " " "\u3000" "abc"])

(def ^:private pairs (for [s strings n needles] [s n]))

(defn- disagreements [f oracle inputs]
  (vec (for [input inputs
             :let [got (apply f input) want (apply oracle input)]
             :when (not= got want)]
         {:input input :kotoba got :host want})))

(deftest the-predicates-match-the-host-library
  (doseq [[label f oracle] [["starts-with?" #(flag 'sw %1 %2) str/starts-with?]
                            ["ends-with?" #(flag 'ew %1 %2) str/ends-with?]
                            ["includes?" #(flag 'inc? %1 %2) str/includes?]]]
    (testing label
      (let [bad (disagreements f oracle pairs)]
        (is (= (* (count strings) (count needles)) (count pairs)))
        (is (empty? bad) (str label " disagrees with kotoba.lang.text on " (pr-str (take 6 bad))))))))

(deftest blank-and-the-trims-and-reverse-match-the-host-library
  (doseq [[label f oracle] [["blank?" #(flag 'bl %) str/blank?]
                            ["trim" #(call 'tr %) str/trim]
                            ["triml" #(call 'trl %) str/triml]
                            ["trimr" #(call 'trr %) str/trimr]
                            ["reverse" #(call 'rv %) str/reverse]]]
    (testing label
      (let [bad (disagreements f oracle (map vector strings))]
        (is (empty? bad) (str label " disagrees with kotoba.lang.text on " (pr-str (take 6 bad))))))))

(defn- kotoba-index-of [s v]
  (when (flag 'present? s v) (to-long (call 'value s v))))

(defn- kotoba-last-index-of [s v]
  (when (flag 'last-present? s v) (to-long (call 'last-value s v))))

(deftest the-index-functions-match-the-host-library-including-the-nil
  (doseq [[label f oracle] [["index-of" kotoba-index-of str/index-of]
                            ["last-index-of" kotoba-last-index-of str/last-index-of]]]
    (testing label
      (let [bad (disagreements f oracle pairs)]
        (is (empty? bad) (str label " disagrees with kotoba.lang.text on " (pr-str (take 6 bad)))))))
  (testing "the astral case is where a byte or code-point count would be wrong"
    (is (= 3 (str/index-of "a😀b" "b")))
    (is (= 3 (kotoba-index-of "a😀b" "b")))))

;; ---------------------------------------------------------------------------
;; replace, the literal arity. New in kotoba.string on 2026-09-12; this is the
;; oracle its :absent entry said it needed.

(def ^:private replace-cases
  (vec (for [s ["" "a" "abc" "a.b.c" "ababa" "aaa" "あいう" "a/b/c" "日本語日本" "a😀b😀" "x$1y" "--a--"]
             m ["." "a" "ab" "aa" "/" "あ" "本" "😀" "-" "z" "$1" "abc"]
             r ["" "x" "/" "$1" "\\\\" "あ" "😀" "xyz"]]
         [s m r])))

(deftest replace-matches-the-host-library
  (let [bad (disagreements #(call 'rp %1 %2 %3) str/replace replace-cases)]
    (is (= 1152 (count replace-cases)))
    (is (empty? bad) (str "replace disagrees with kotoba.lang.text on " (pr-str (take 6 bad)))))
  (testing "the replacement is literal on both sides, as the host's string arity is"
    (is (= "x$1y" (call 'rp "x.y" "." "$1")))
    (is (= "x$1y" (str/replace "x.y" "." "$1"))))
  (testing "overlapping candidates are consumed left to right, non-overlapping"
    (is (= "xa" (call 'rp "aaa" "aa" "x")))
    (is (= "xa" (str/replace "aaa" "aa" "x")))))

(deftest the-one-place-this-is-not-clojure-string
  ;; `kotoba.lang.text/replace` answers `s` for an empty match; the builtin
  ;; underneath TRAPS on one; `clojure.string/replace` interleaves. The module
  ;; follows the library it forwards for, and this is why `clojure.string`'s
  ;; shim keeps `replace` absent.
  (is (= "abc" (call 'rp "abc" "" "x")))
  (is (= "abc" (str/replace "abc" "" "x")))
  (is (= "xaxbxcx" (clojure.string/replace "abc" "" "x"))
      "if clojure.string ever stopped interleaving, the shim's absent reason would be stale"))

(deftest join-matches-the-host-library
  (doseq [sep ["" "," ", " "あ" "😀"]]
    (testing (pr-str sep)
      (is (= (str/join sep []) (call 'j0 sep)))
      (is (= (str/join sep ["a"]) (call 'j1 sep "a")))
      (is (= (str/join sep ["a" "bb"]) (call 'j2 sep "a" "bb")))
      (is (= (str/join sep ["a" "" "日本"]) (call 'j3 sep "a" "" "日本")))
      (is (= (str/join sep ["😀" "あ" "b"]) (call 'j3 sep "😀" "あ" "b"))))))

;; ---------------------------------------------------------------------------
;; The forwarding module as text, and the contract.

(defn- public-names [source]
  (set (map (comp symbol second) (re-seq #"(?m)^\(defn\s+([^\s\[]+)" source))))

(defn- forwarder-targets [source]
  (into {} (map (fn [[_ name target]] [(symbol name) (symbol target)])
                (re-seq #"(?m)^\(defn\s+([^\s\[]+)[^\n]*\n?[^(]*\((?:ks|ksj)/([^\s)]+)" source))))

(deftest the-forwarder-forwards-every-export-to-the-same-name
  (let [targets (forwarder-targets @forwarder)]
    (is (= (public-names @forwarder) (set (keys targets)))
        "every public name must be a one-line forwarder, not an implementation")
    (is (every? (fn [[name target]] (= name target)) targets)
        (str "a forwarder points somewhere else: " (pr-str targets)))
    (is (every? (set/union (public-names @canonical) (public-names @join-module))
                (vals targets))
        "every target must exist in kotoba.string or kotoba.string.join")
    (is (re-find #"\(ns kotoba\.lang\.text\b" @forwarder)
        "the namespace must be the host library's, or the :require does not resolve to it")))

(deftest the-contract-records-exactly-this-surface
  (let [contract (edn/read-string (slurp-repo-file "lang/compat.edn"))
        entry (get-in contract [:modules :kotoba.lang.text])]
    (is (= forwarder-path (:path entry)))
    (testing "the provided names are the public defns, and nothing absent is provided"
      (is (= (:provides entry) (public-names @forwarder)))
      (is (empty? (set/intersection (:provides entry) (set (keys (:absent entry)))))))
    (testing "every export of the host library is either provided or absent with a reason"
      (let [host-names '#{blank-text? blank? capitalize codepoints ends-with? escape format
                          from-codepoints includes? index-of index-of-text join last-index-of
                          last-index-of-text lower pad-center-text pad-left pad-left-text
                          pad-right pad-right-text re-find re-matches re-quote re-seq
                          repeat-text replace replace-first replace-first-text reverse
                          reverse-text segment-count-text segment-text split split-lines
                          starts-with? trim trim-newline trim-newline-text trim-text triml
                          triml-text trimr trimr-text truncate upper}
            recorded (set/union (:provides entry) (set (keys (:absent entry))))]
        (is (= host-names recorded)
            (str "unrecorded: " (pr-str (set/difference host-names recorded))
                 " extra: " (pr-str (set/difference recorded host-names))))
        (is (every? (fn [[_ v]] (string? (:reason v))) (:absent entry)))))
    (testing "kotoba.string records replace as provided, not absent, and the alias carries it"
      (is (contains? (get-in contract [:modules :kotoba.string :provides]) 'replace))
      (is (not (contains? (get-in contract [:modules :kotoba.string :absent]) 'replace)))
      (is (contains? (get-in contract [:modules :kotoba.text :provides]) 'replace))
      (is (contains? (public-names @canonical) 'replace)))
    (testing "and clojure.string still does NOT carry replace, for the recorded reason"
      (is (not (contains? (get-in contract [:modules :clojure.string :provides]) 'replace)))
      (is (str/includes? (get-in contract [:modules :clojure.string :absent 'replace :reason]) "interleave")))))
