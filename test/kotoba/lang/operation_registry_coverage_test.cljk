(ns kotoba.lang.operation-registry-coverage-test
  "Every operation in lang/operations.edn is EXERCISED by a conformance case
  that a runner executes on each backend the language requires (root
  ADR-2610092330 R2).

  R0 and R1 check what each layer admits and how it types an operation; they
  say nothing about whether the operation RUNS. JS, Wasm and native keep no
  operation table to read -- they dispatch inside their emitters -- so the
  evidence that an operation runs there is a conformance case that names it
  and records a runner for that backend in :executed-by. Measured 2026-10-09:
  15 of the 43 document operations had no case on any backend;
  document/operations.kotoba closes that.

  An operation counts as exercised by a case when the case's fixture calls it
  -- `(op ` followed by whitespace or `)` -- and the case's :executed-by names
  the backend (a deferral is not execution)."
  (:require [clojure.edn :as edn]
            [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is testing]]))

(def ^:private backends
  "The backends every :pure-product-run case requires (manifest :case-classes)."
  [:kir :wasm32-kotoba-v1])

(def ^:private min-covered
  "A ratchet: operation x backend pairs exercised by an EXECUTED case (deferrals
  do not count). 2026-10-09: 43 x 2; 51 x 2 with :bytes (R4); 61 x 2 less
  the deferred vector-take on wasm with :vector (121); 69 x 2 less the two
  deferred takes with :vector-f64 (136); 79 x 2 less four deferrals with
  :typed-map (154); 86 x 2 less four with :typed-set (168); 89 x 2 less four with :typed-list (174); 110 x 2 less twelve with :string (208); 140 x 2 less twelve with :f64 (268); 163 x 2 less twelve with :f32 (314); 172 x 2 less twelve with :i32 (332); 178 x 2 less twelve with :i64 (344); 186 x 2 less twelve with :compact-graph (360); 193 x 2 less twelve with :xml and :decimal (374); 204 x 2 less twelve with :generic-option and :parametric-result (396); :typed-safe-value, whose
  twelve value-reader and :js-value heads run on kir only, wasm deferred (423);
  :heterogeneous-vector (433); :record and :variant (445)."
  445)

(defn- calls? [source op]
  (boolean (re-find (re-pattern (str "\\(" (java.util.regex.Pattern/quote (str op)) "[\\s)]")) source)))

(deftest every-registered-operation-runs-on-every-required-backend
  (let [registry (edn/read-string (slurp "lang/operations.edn"))
        manifest (edn/read-string (slurp "lang/conformance/manifest.edn"))
        cases (for [c (:cases manifest) :when (and (= :run (:kind c)) (:entry c))]
                (assoc c ::source (slurp (str "lang/conformance/" (:entry c)))))
        covered (atom 0)
        excused (atom [])]
    (doseq [op (sort-by str (keys (:operations registry)))
            backend backends]
      (testing (str op " on " backend)
        ;; executed, or else DEFERRED with a dated reason by a case that
        ;; calls it -- a deferral is accounted for, not covered, and the
        ;; runner reports it the day it starts passing
        (let [calling (filter #(calls? (::source %) op) cases)
              executed (filter #(get-in % [:executed-by backend]) calling)
              deferred (filter #(get-in % [:unexecuted-backends backend]) calling)]
          (cond (seq executed) (swap! covered inc)
                (seq deferred) (swap! excused conj [op backend]))
          (is (or (seq executed) (seq deferred))
              (str op " is registered but no case that calls it is executed on " backend
                   " or defers it with a reason")))))
    (println (format "DEFERRED\t%d\toperation x backend pairs deferred with a reason: %s"
                     (count @excused) (pr-str (sort-by str @excused))))
    (println (format "COVERED\t%d\toperation x backend pairs exercised by an executed case" @covered))
    (is (>= @covered min-covered) (str "covered " @covered ", floor is " min-covered))))
