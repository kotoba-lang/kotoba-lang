(ns kotoba.lang.clojure-set-compat-test
  "`lang/compat/clojure/set.kotoba`, checked against clojure.set itself.

  The oracle is the real function: every pair of subsets of a five-element
  universe (32 x 32 = 1,024 pairs) is handed to the Kotoba `union`,
  `difference`, `intersection` and `subset?` on the KIR interpreter and to
  clojure.set on the host, and the two answers are compared. That sweep
  contains every boundary the four definitions have -- both operands empty,
  one empty, equal sets, disjoint sets, a proper subset each way -- without
  anyone having to think of them.

  The module is a TEMPLATE (`(:params [elem :keyword])`), and this
  repository has no project linker to instantiate it, so this test does what
  amu's linker does and nothing more: substitutes the bound type for the
  parameter symbol inside every keyword-headed vector and drops the `ns`
  form. What is handed to the frontend is then the text an author could have
  written by hand for `[:set :keyword]`, which is what the linker hands it.

  Sets cross the interpreter boundary as BIT MASKS over the universe
  `[:a :b :c :d :e]`: the harness builds a keyword set from an i64 and reads
  one back to an i64, so the interpreter is only ever asked for an integer.
  Portable: runs on nbb (run-tests.cljk) and, where the `.cljk` sources can
  be loaded, on the JVM."
  (:require #?(:clj [clojure.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            #?(:clj [clojure.edn :as edn]
               :cljs [cljs.reader :as edn])
            #?(:cljs ["node:fs" :as fs])
            [clojure.set :as set]
            [clojure.walk :as walk]
            [kotoba.lang.text :as str]
            [kotoba.kir :as kir]
            [kotoba.sema :as sema]))

(defn- slurp-repo-file [path]
  #?(:clj (slurp path)
     :cljs (.readFileSync fs path "utf8")))

(def ^:private module-path "lang/compat/clojure/set.kotoba")
(def ^:private module (delay (slurp-repo-file module-path)))

(def ^:private universe [:a :b :c :d :e])

;; What amu's `kotoba.compiler.project/instantiate-forms` does for the one
;; type position this module uses: a parameter symbol inside a keyword-headed
;; vector is the bound type.
(defn- instantiate [forms binding]
  (walk/postwalk (fn [form]
                   (if (and (vector? form) (keyword? (first form)))
                     (mapv #(get binding % %) form)
                     form))
                 forms))

;; The reader answers integer literals as BigInt on this host, and `pr-str`
;; renders a BigInt as `#object[BigInt 0]`, which the reader then refuses on
;; the way back in (amu's `source-text` has the same seam). Printed as plain
;; numbers; every integer in this module is a small loop index.
(defn- readable-integers [forms]
  #?(:clj forms
     :cljs (walk/postwalk (fn [x] (if (and (some? x) (= js/BigInt (.-constructor x))) (js/Number x) x)) forms)))

(defn- forms-of [source binding]
  (->> (sema/read-forms source)
       (remove #(and (seq? %) (= 'ns (first %))))
       (#(instantiate % binding))
       readable-integers
       (map pr-str)
       (str/join "\n")))

;; `mk` builds a keyword set from a bit mask over the universe; `bits` reads
;; one back. The four entries under test take two masks and answer a mask
;; (or 0/1 for subset?).
(def ^:private harness
  "(defn mk [b :i64] [:set :keyword]
     (let [s0 (typed-set-new [:set :keyword])
           s1 (if (= 1 (bit-and b 1)) (conj s0 :a) s0)
           s2 (if (= 2 (bit-and b 2)) (conj s1 :b) s1)
           s3 (if (= 4 (bit-and b 4)) (conj s2 :c) s2)
           s4 (if (= 8 (bit-and b 8)) (conj s3 :d) s3)]
       (if (= 16 (bit-and b 16)) (conj s4 :e) s4)))
   (defn bits [s [:set :keyword]] :i64
     (+ (if (typed-set-contains [:set :keyword] s :a) 1 0)
        (if (typed-set-contains [:set :keyword] s :b) 2 0)
        (if (typed-set-contains [:set :keyword] s :c) 4 0)
        (if (typed-set-contains [:set :keyword] s :d) 8 0)
        (if (typed-set-contains [:set :keyword] s :e) 16 0)))
   (defn u [x :i64 y :i64] :i64 (bits (union (mk x) (mk y))))
   (defn d [x :i64 y :i64] :i64 (bits (difference (mk x) (mk y))))
   (defn i [x :i64 y :i64] :i64 (bits (intersection (mk x) (mk y))))
   (defn sub [x :i64 y :i64] :i64 (if (subset? (mk x) (mk y)) 1 0))
   (defn main [] :i64 0)")

(def ^:private lowered
  (delay (kir/lower (sema/analyze (str (forms-of @module {'elem :keyword}) "\n" harness)))))

(defn- to-long [v]
  #?(:clj (long v) :cljs (js/Number v)))

(defn- call [function x y]
  (to-long (kir/execute @lowered function [x y])))

(defn- decode [mask]
  (into #{} (keep-indexed (fn [index k] (when (pos? (bit-and mask (bit-shift-left 1 index))) k))) universe))

(defn- encode [s]
  (reduce + (keep-indexed (fn [index k] (when (contains? s k) (bit-shift-left 1 index))) universe)))

(def ^:private pairs (for [x (range 32) y (range 32)] [x y]))

(defn- disagreements [function oracle]
  (remove (fn [[x y]] (= (call function x y) (oracle x y))) pairs))

(deftest matches-clojure-set-on-every-pair-of-subsets
  (doseq [[label function oracle]
          [["union" 'u (fn [x y] (encode (set/union (decode x) (decode y))))]
           ["difference" 'd (fn [x y] (encode (set/difference (decode x) (decode y))))]
           ["intersection" 'i (fn [x y] (encode (set/intersection (decode x) (decode y))))]
           ["subset?" 'sub (fn [x y] (if (set/subset? (decode x) (decode y)) 1 0))]]]
    (testing label
      (let [bad (vec (disagreements function oracle))]
        (is (= 1024 (count pairs)))
        (is (empty? bad) (str label " disagrees with clojure.set on " (pr-str (take 8 bad))))))))

(deftest the-boundaries-answer-what-clojure-set-answers
  ;; Named, so a reader sees them without decoding the sweep: the empty set
  ;; is a subset of everything and of itself; difference of a set from
  ;; itself is empty; a member absent from s1 is a no-op for difference.
  (is (= 1 (call 'sub 0 0)))
  (is (= 1 (call 'sub 0 31)))
  (is (= 0 (call 'sub 31 0)))
  (is (= 0 (call 'd 31 31)))
  (is (= 1 (call 'd 1 30)))
  (is (= 31 (call 'u 21 10)))
  (is (= 0 (call 'i 21 10))))

(defn- public-names [source]
  (set (map (comp symbol second) (re-seq #"(?m)^\(defn\s+([^\s\[]+)" source))))

(deftest the-module-provides-exactly-what-the-contract-records
  (let [contract (edn/read-string (slurp-repo-file "lang/compat.edn"))
        entry (get-in contract [:modules :clojure.set])]
    (testing "the provided names are the public defns, and nothing absent is provided"
      (is (= (:provides entry) (public-names @module)))
      (is (empty? (set/intersection (:provides entry) (set (keys (:absent entry)))))))
    (testing "the template declares the default binding the contract records"
      (is (re-find #"\(:params \[elem :keyword\]\)" @module))
      (is (= {'elem :keyword} (:default-binding entry))))
    (testing "every clojure.set public name is either provided or absent with a reason"
      (let [clojure-set-names '#{union difference intersection subset? superset?
                                 select project rename-keys rename index map-invert join}
            recorded (set/union (:provides entry) (set (keys (:absent entry))))]
        (is (= clojure-set-names recorded)
            (str "unrecorded: " (pr-str (set/difference clojure-set-names recorded))
                 " extra: " (pr-str (set/difference recorded clojure-set-names))))
        (is (every? (fn [[_ v]] (string? (:reason v))) (:absent entry)))))))
