(ns kotoba.lang.cljk-loader
  "JVM compatibility load path for .cljk after adr-2609111500.

  Stock `clojure.lang.RT/load` only looks for `.clj` / `.cljc` / `__init.class`.
  The rename left no compatibility mirrors, so `clojure -M -m` and
  `cognitect.test-runner` cannot see the Clojure-shaped sources.

  This is the JVM compatibility surface, not a Kotoba compiler target.
  `.cljk` is exposed to RT as `.cljc` so former `.cljc` files keep `#?`
  branches under the `:clj` feature, and former `.clj` files (no
  conditionals) load unchanged.

  Bootstrap with `load-file` / `clojure -i` — those do not use RT's
  extension search — then `require` / `-m` can resolve `.cljk`."
  (:import [clojure.lang Compiler DynamicClassLoader]
           [java.util Collections]))

(defn- cljc->cljk
  "RT tries `path.clj` then `path.cljc`. Map only the cljc probe to .cljk
  so the file is compiled with reader-conditionals allowed."
  [^String name]
  (when (and name (.endsWith name ".cljc"))
    (str (subs name 0 (- (count name) 5)) ".cljk")))

(defn- cljk-classloader
  ^ClassLoader [^ClassLoader parent]
  (proxy [DynamicClassLoader] [parent]
    (getResource [name]
      (or (proxy-super getResource name)
          (when-let [alt (cljc->cljk name)]
            (proxy-super getResource alt))))
    (getResourceAsStream [name]
      (or (proxy-super getResourceAsStream name)
          (when-let [alt (cljc->cljk name)]
            (proxy-super getResourceAsStream alt))))
    (getResources [name]
      (let [found (enumeration-seq (proxy-super getResources name))
            extra (when-let [alt (cljc->cljk name)]
                    (enumeration-seq (proxy-super getResources alt)))]
        (Collections/enumeration
         (vec (distinct (concat found extra))))))))

(defn- maybe-patch-tools-namespace!
  "cognitect.test-runner discovers via tools.namespace, which hardcodes
  `.clj`/`.cljc`. When that library is on the classpath, add `.cljk`."
  []
  (when (try
          (require 'clojure.tools.namespace.find)
          (require 'clojure.tools.namespace.file)
          true
          (catch Exception _ false))
    (let [find-clj (ns-resolve 'clojure.tools.namespace.find 'clj)
          file-exts (ns-resolve 'clojure.tools.namespace.file 'clojure-extensions)
          add-ext (fn [exts]
                    (cond
                      (nil? exts) '(".cljk")
                      (some #{".cljk"} exts) exts
                      (list? exts) (concat exts '(".cljk"))
                      (set? exts) (conj exts ".cljk")
                      (vector? exts) (conj exts ".cljk")
                      :else (concat (seq exts) '(".cljk"))))]
      (when file-exts
        (alter-var-root file-exts add-ext))
      (when find-clj
        (alter-var-root find-clj
                        (fn [m]
                          (if (map? m)
                            (update m :extensions add-ext)
                            m)))))))

(defn install!
  "Install the JVM .cljk resource fallback and, when present, test discovery."
  []
  (let [parent (or (clojure.lang.RT/baseLoader)
                   (.getContextClassLoader (Thread/currentThread))
                   (.getClassLoader clojure.lang.RT))
        cl (cljk-classloader parent)]
    (.setContextClassLoader (Thread/currentThread) cl)
    (.bindRoot Compiler/LOADER cl)
    (maybe-patch-tools-namespace!)
    cl))

(defonce ^:private installed
  (install!))
