(ns kotoba.lang.cljk-loader
  "JVM compatibility load path for .cljk after adr-2609111500.

  Stock `clojure.lang.RT/load` only looks for `.clj` / `.cljc` / `__init.class`.
  The rename left no compatibility mirrors, so `clojure -M -m` and
  `cognitect.test-runner` cannot see the Clojure-shaped sources.

  This is the JVM compatibility surface, not a Kotoba compiler target.
  `.cljk` is exposed to RT as `.cljc` so former `.cljc` files keep `#?`
  branches under the `:clj` feature, and former `.clj` files (no
  conditionals) load unchanged.

  Bootstrap with `load-file` / `clojure -i` — those do not use RT's
  extension search — then `require` / `-m` can resolve `.cljk`."
  (:import [clojure.lang Compiler DynamicClassLoader]
           [java.util Collections]))

(defn- replace-ext
  [^String name ^String from ^String to]
  (when (and name (.endsWith name from))
    (str (subs name 0 (- (count name) (count from))) to)))

(defn- clj-probe?
  [^String name]
  (and name (.endsWith name ".clj") (not (.endsWith name ".cljc"))))

(defn- cljc-probe?
  [^String name]
  (and name (.endsWith name ".cljc")))

(defn- dual
  "The dual-platform name kept when both hosts had a file: `foo.clj` →
  `foo.clj.cljk`, `foo.cljc` → `foo.cljc.cljk`."
  [^String name]
  (when name (str name ".cljk")))

(defn- plain-cljk
  "The single-file rename: `foo.clj` / `foo.cljc` → `foo.cljk`."
  [^String name]
  (or (replace-ext name ".clj" ".cljk")
      (replace-ext name ".cljc" ".cljk")))

(defn wrap
  "Wrap any classloader with the JVM `.cljk` resource fallback.

  After the rename, `src/` no longer has mirrors. RT still probes `.clj`
  then `.cljc`. Resolve in this order:

  * `.clj` → `.clj.cljk` (dual-platform; must win so clj-before-cljc holds)
  * `.cljc` → `.cljc.cljk`, then `.cljk`
  * a lone `.cljk` hides the `.clj` probe so RT falls through and loads
    it as `.cljc` (reader conditionals, and so a repo `.cljk` beats a
    dependency `.cljc` such as kotoba-core-contracts' older
    `package_registry.cljc`)."
  ^ClassLoader [^ClassLoader parent]
  (proxy [DynamicClassLoader] [parent]
    (getResource [name]
      (cond
        (clj-probe? name)
        (let [dual-name (dual name)
              plain (plain-cljk name)]
          (cond
            (and dual-name (proxy-super getResource dual-name))
            (proxy-super getResource dual-name)
            (and plain (proxy-super getResource plain))
            nil
            :else
            (proxy-super getResource name)))
        (cljc-probe? name)
        (or (when-let [n (dual name)] (proxy-super getResource n))
            (when-let [n (plain-cljk name)] (proxy-super getResource n))
            (proxy-super getResource name))
        :else
        (proxy-super getResource name)))
    (getResourceAsStream [name]
      (when-let [url (.getResource this name)]
        (.openStream url)))
    (getResources [name]
      (cond
        (clj-probe? name)
        (let [dual-name (dual name)
              plain (plain-cljk name)]
          (cond
            (and dual-name (proxy-super getResource dual-name))
            (Collections/enumeration [(.getResource this name)])
            (and plain (proxy-super getResource plain))
            (Collections/emptyEnumeration)
            :else
            (proxy-super getResources name)))
        (cljc-probe? name)
        (let [found (vec (distinct
                          (keep identity
                                [(when-let [n (dual name)]
                                   (proxy-super getResource n))
                                 (when-let [n (plain-cljk name)]
                                   (proxy-super getResource n))])))]
          (if (seq found)
            (Collections/enumeration found)
            (proxy-super getResources name)))
        :else
        (proxy-super getResources name)))))

(defn- cljk-classloader
  ^ClassLoader [^ClassLoader parent]
  (wrap parent))

(defn- maybe-patch-tools-namespace!
  "cognitect.test-runner discovers via tools.namespace, which hardcodes
  `.clj`/`.cljc`. When that library is on the classpath, add `.cljk`."
  []
  (when (try
          (require 'clojure.tools.namespace.find)
          (require 'clojure.tools.namespace.file)
          true
          (catch Exception _ false))
    (let [find-clj (ns-resolve 'clojure.tools.namespace.find 'clj)
          file-exts (ns-resolve 'clojure.tools.namespace.file 'clojure-extensions)
          add-ext (fn [exts]
                    (cond
                      (nil? exts) '(".cljk")
                      (some #{".cljk"} exts) exts
                      (list? exts) (concat exts '(".cljk"))
                      (set? exts) (conj exts ".cljk")
                      (vector? exts) (conj exts ".cljk")
                      :else (concat (seq exts) '(".cljk"))))]
      (when file-exts
        (alter-var-root file-exts add-ext))
      (when find-clj
        (alter-var-root find-clj
                        (fn [m]
                          (if (map? m)
                            (update m :extensions add-ext)
                            m)))))))

(defn install!
  "Install the JVM .cljk resource fallback and, when present, test discovery."
  []
  (let [parent (or (clojure.lang.RT/baseLoader)
                   (.getContextClassLoader (Thread/currentThread))
                   (.getClassLoader clojure.lang.RT))
        cl (cljk-classloader parent)]
    (.setContextClassLoader (Thread/currentThread) cl)
    (.bindRoot Compiler/LOADER cl)
    (maybe-patch-tools-namespace!)
    cl))

(defonce ^:private installed
  (install!))
