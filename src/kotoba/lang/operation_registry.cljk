(ns kotoba.lang.operation-registry
  "Check a layer's operation tables against lang/operations.edn (root
  ADR-2610092330 R0).

  Pure: the registry and each layer's tables come in as data, problems come
  out. Reading the tables (from a layer's source, its classpath, or anything
  else) is the caller's business, so the same comparison serves every layer.

  The comparison runs in BOTH directions, because either one alone is the
  silent failure the ADR is about: a layer that admits an operation the
  registry does not name, or a registry that says :implemented for a layer
  whose table does not have it."
  (:require [kotoba.lang.text :as str]))

(defn layer-status
  "The registry's status for OP on LAYER: :implemented, :pending, :refused, or
  nil when the entry does not list the layer."
  [registry op layer]
  (let [v (get-in registry [:operations op :layers layer])]
    (if (map? v) (:status v) v)))

(defn family-operations
  "The names the registry gives FAMILY."
  [registry family]
  (into #{} (keep (fn [[op entry]] (when (= family (:family entry)) op)))
        (:operations registry)))

(defn problem-key [{:keys [layer op type]}]
  [layer op (if (= type :arity-mismatch) :arity type)])

(defn check-layer
  "Problems for one LAYER. LAYER-OPS maps each operation the layer admits (in
  the family under check) to its arity, or to :admitted when the layer's
  table carries no arity. UNIVERSE is the set of names under check: the
  registry's family plus whatever the layer admits with the family's prefix,
  so an unregistered operation is seen rather than filtered out."
  [registry layer layer-ops universe]
  (vec
   (for [op (sort-by str universe)
         :let [status (layer-status registry op layer)
               entry (get-in registry [:operations op])
               admitted? (contains? layer-ops op)
               arity (get layer-ops op)]
         problem
         (cond
           (and admitted? (nil? entry))
           [{:type :layer-admits-unregistered :layer layer :op op}]

           (and admitted? (= :refused status))
           [{:type :layer-admits-refused :layer layer :op op}]

           (and admitted? (= :pending status))
           [{:type :registry-pending-but-layer-admits :layer layer :op op}]

           (and (not admitted?) (= :implemented status))
           [{:type :registry-implemented-but-layer-lacks :layer layer :op op}]

           (and admitted? (= :implemented status)
                (not= :admitted arity) (not= arity (:arity entry)))
           [{:type :arity-mismatch :layer layer :op op
             :registry (:arity entry) :layer-arity arity}]

           :else [])]
     problem)))

(defn check
  "All problems across LAYERS, a map of layer -> admitted-ops, for the
  operations of FAMILY: those whose names start with PREFIX, or, when PREFIX
  is a set, those it contains (a family whose names share no prefix). Known mismatches in the
  registry suppress exactly their own problem, and each one must still
  occur: a known mismatch that no longer happens is itself a problem.
  Returns {:problems [...] :compared n}."
  [registry family prefix layers]
  (let [registered (family-operations registry family)
        in-family? (if (set? prefix) prefix #(str/starts-with? (str %) prefix))
        raw (vec (mapcat (fn [[layer ops]]
                           (let [seen (into #{} (filter in-family?) (keys ops))]
                             (check-layer registry layer ops (into registered seen))))
                         layers))
        known (:known-mismatches registry)
        occurring (into #{} (map problem-key) raw)
        open (vec (remove #(contains? known (problem-key %)) raw))
        ;; a known mismatch is checked only by the run that covers its layer
        ;; AND its operation's family -- another family's run cannot see it
        universe (into registered (comp (mapcat (fn [[_ ops]] (keys ops))) (filter in-family?)) layers)
        closed (vec (for [k (keys known)
                          :when (contains? (set (keys layers)) (first k))
                          :when (contains? universe (second k))
                          :when (not (contains? occurring k))]
                      {:type :known-mismatch-no-longer-occurs :key k}))]
    {:problems (into open closed)
     :compared (reduce + (map (fn [[_ ops]] (count (into registered (keys ops)))) layers))}))
