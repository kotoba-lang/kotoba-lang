#?(:kotoba
   (ns kotoba.lang.coll
     "Portable collection helpers for the kotoba foundational stdlib — the map/seq
     ops every actor otherwise re-rolls. Layer 1 (data): pure functions, no host
     capability, no third-party deps. Runs on JVM / SCI / ClojureScript / GraalVM /
     kotoba-WASM.
   
     These complement `clojure.core`: `clojure.core` already has `map`/`filter`/
     `reduce`/`merge`/`group-by`; this namespace adds the small map-shaping and
     recursive-merge helpers that are not in `clojure.core` but that every kotoba
     vertical lib re-implements."
     {:kotoba/export [assoc-some difference intersection map-invert union bounded-postwalk bounded-prewalk deep-merge default-max-walk-depth empty-queue filter-keys filter-vals index index-by index-of join keywordize-keys map-keys map-vals postwalk postwalk-replace prewalk prewalk-replace project queue queue? rename rename-keys select set-difference set-intersection set-union stringify-keys subset? superset? walk]}
     (:require [clojure.walk :as walk]))
   :default
(ns kotoba.lang.coll
  "Portable collection helpers for the kotoba foundational stdlib — the map/seq
  ops every actor otherwise re-rolls. Layer 1 (data): pure functions, no host
  capability, no third-party deps. Runs on JVM / SCI / ClojureScript / GraalVM /
  kotoba-WASM.

  These complement `clojure.core`: `clojure.core` already has `map`/`filter`/
  `reduce`/`merge`/`group-by`; this namespace adds the small map-shaping and
  recursive-merge helpers that are not in `clojure.core` but that every kotoba
  vertical lib re-implements."
  {:kotoba/export '[assoc-some difference intersection map-invert union bounded-postwalk bounded-prewalk deep-merge default-max-walk-depth empty-queue filter-keys filter-vals index index-by index-of join keywordize-keys map-keys map-vals postwalk postwalk-replace prewalk prewalk-replace project queue queue? rename rename-keys select set-difference set-intersection set-union stringify-keys subset? superset? walk]}
  (:refer-clojure :exclude [merge])))

;; R6QW3: the Kotoba reading (W3 re-port, WIP). The data model is :document (arbitrary
;; nested EDN). The callable type form is [:fn [[P ..] R]] -- the params are the TYPES
;; (unnamed; a vector whose first kid is a symbol is destructuring, R6H). The collection
;; growth is constrained (walk.kotoba measured model): grow = document-vector-conj /
;; document-assoc only; a list or set is rebuilt through its EDN text (the read
;; deduplicates). The walk family is the :document walk (unbounded) plus the
;; depth-bounded pair; the four key-coercion fns delegate to clojure.walk. The
;; not-yet-ported fns carry a fail-closed placeholder (nothing with a placeholder is
;; landed; the :default reading stays the oracle).
#?(:kotoba
   (defn- dgk [d :document k :document] :document
     (option-value-of [:option :document] (document-get d k) (document-null))))
;; the map entry fold: (f acc k v) over the entries of m (the pair = document-list-at 0/1)
#?(:kotoba
   (defn- kv-fold [f [:fn [[:document :document :document] :document]] acc :document m :document i :i64 n :i64] :document
     (if (>= i n)
       acc
       (let [entry (option-value-of [:option :document] (document-map-entry-at m i) (document-null))]
         (kv-fold f
                  (f acc
                     (option-value-of [:option :document] (document-list-at entry 0) (document-null))
                     (option-value-of [:option :document] (document-list-at entry 1) (document-null)))
                  m (+ i 1) n)))))
;; the vector fold: (f acc item)
#?(:kotoba
   (defn- vec-fold [f [:fn [[:document :document] :document]] acc :document v :document i :i64 n :i64] :document
     (if (>= i n)
       acc
       (vec-fold f (f acc (option-value-of [:option :document] (document-vector-at v i) (document-null))) v (+ i 1) n))))
;; the set model: the members are read by printing and reading #{..} back (the read
;; deduplicates). set-of builds the set of a vector items; set-items reads a set members
;; as a vector (the print/read pair of the language round-trip conformance).
#?(:kotoba
   (defn- set-of [items :document] :document
     (document-edn-read (string-concat (string-concat "#{" (items-text items 0 (document-count items) "")) "}"))))
#?(:kotoba
   (defn- items-text [items :document i :i64 n :i64 acc :string] :string
     (if (>= i n)
       acc
       (items-text items (+ i 1) n
                   (string-concat (string-concat acc (if (= i 0) "" " ")) (document-edn-print (option-value-of [:option :document] (document-vector-at items i) (document-null))))))))
#?(:kotoba
   (defn- set-items [s :document] :document
     (document-edn-read (string-concat (string-concat "[" (set-body (document-edn-print s) 1)) "]"))))
;; the printed set body: the text between #{ and } (the read of [..] gives the vector)
#?(:kotoba
   (defn- set-body [t :string i :i64] :string
     (string-substring t i (- (string-length t) 1))))
;; the set containment (the read-only membership of the model)
#?(:kotoba
   (defn- set-has? [s :document x :document] :bool
     (document-set-contains? s x)))
;; the :document walk (walk cond order): map entries as [k v] vectors, vectors/lists/sets
;; element-wise (sets deduplicated on rebuild), scalars as leaves.
#?(:kotoba
   (defn- d-kids [inner [:fn [[:document] :document]] x :document] :document
     (let [kd (document-kind x)]
       (cond (= :map kd) (d-map-kids inner x 0 (document-count x) (document-map))
             (= :vector kd) (d-vec-kids inner x 0 (document-count x) (document-vector))
             (= :list kd) (d-vec-kids inner x 0 (document-count x) (document-vector))
             (= :set kd) (set-of (d-vec-kids inner x 0 (document-count x) (document-vector)))
             :else x))))
#?(:kotoba
   (defn- d-map-kids [inner [:fn [[:document] :document]] m :document i :i64 n :i64 acc :document] :document
     (if (>= i n)
       acc
       (let [entry (option-value-of [:option :document] (document-map-entry-at m i) (document-null))
             k2 (inner (option-value-of [:option :document] (document-list-at entry 0) (document-null)))
             v2 (inner (option-value-of [:option :document] (document-list-at entry 1) (document-null)))]
         (d-map-kids inner m (+ i 1) n (document-assoc acc k2 v2))))))
#?(:kotoba
   (defn- d-vec-kids [inner [:fn [[:document] :document]] v :document i :i64 n :i64 acc :document] :document
     (if (>= i n)
       acc
       (d-vec-kids inner v (+ i 1) n (document-vector-conj acc (inner (option-value-of [:option :document] (document-vector-at v i) (document-null))))))))
;; the unbounded walk: inner on the children, then outer on the result
#?(:kotoba
   (defn- d-walk [inner [:fn [[:document] :document]] outer [:fn [[:document] :document]] form :document] :document
     (outer (d-kids inner form))))
;; the bounded walk: the depth ceiling, throw past it (the oracle walk-depth-exceeded!)
#?(:kotoba
   (defn- b-walk [f [:fn [[:document] :document]] form :document max-depth :i64 depth :i64 pre :i64] :document
     (if (> depth max-depth)
       (walk-depth-exceeded! max-depth)
       (if (= pre 1)
         (d-kids-b f (f form) max-depth depth pre)
         (f (d-kids-b f form max-depth depth pre))))))
#?(:kotoba
   (defn- d-kids-b [f [:fn [[:document] :document]] x :document max-depth :i64 depth :i64 pre :i64] :document
     (let [kd (document-kind x)]
       (cond (= :map kd) (d-map-kids-b f x 0 (document-count x) (document-map) max-depth depth pre)
             (= :vector kd) (d-vec-kids-b f x 0 (document-count x) (document-vector) max-depth depth pre)
             (= :list kd) (d-vec-kids-b f x 0 (document-count x) (document-vector) max-depth depth pre)
             (= :set kd) (set-of (d-vec-kids-b f x 0 (document-count x) (document-vector) max-depth depth pre))
             :else x))))
;; the bounded map walk (a tail loop; the item walk calls b-walk directly: an abort may
;; not live inside a fn literal)
#?(:kotoba
   (defn- d-map-kids-b [f [:fn [[:document] :document]] m :document i :i64 n :i64 acc :document max-depth :i64 depth :i64 pre :i64] :document
     (if (>= i n)
       acc
       (let [entry (option-value-of [:option :document] (document-map-entry-at m i) (document-null))
             k2 (b-walk f (option-value-of [:option :document] (document-list-at entry 0) (document-null)) max-depth (+ depth 1) pre)
             v2 (b-walk f (option-value-of [:option :document] (document-list-at entry 1) (document-null)) max-depth (+ depth 1) pre)]
         (d-map-kids-b f m (+ i 1) n (document-assoc acc k2 v2) max-depth depth pre)))))
#?(:kotoba
   (defn- d-vec-kids-b [f [:fn [[:document] :document]] v :document i :i64 n :i64 acc :document max-depth :i64 depth :i64 pre :i64] :document
     (if (>= i n)
       acc
       (d-vec-kids-b f v (+ i 1) n
                     (document-vector-conj acc (b-walk f (option-value-of [:option :document] (document-vector-at v i) (document-null)) max-depth (+ depth 1) pre))
                     max-depth depth pre))))
#?(:kotoba
   (defn map-vals [f [:fn [[:document] :document]] m :document] :document
     (kv-fold (fn [out k v] (document-assoc out k (f v)))
              (document-map) m 0 (document-count m)))
   :default
(defn map-vals
  "Return a map with the same keys as `m` and `f` applied to each value.
  Preserves the key's identity (objects/keywords/strings)."
  [f m]
  (reduce-kv (fn [out k v] (assoc out k (f v))) {} m)))
#?(:kotoba
   (defn map-keys [f [:fn [[:document] :document]] m :document] :document
     (kv-fold (fn [out k v] (document-assoc out (f k) v))
              (document-map) m 0 (document-count m)))
   :default
(defn map-keys
  "Return a map with `f` applied to each key and the same values. If `f`
  produces duplicate keys, later entries win."
  [f m]
  (reduce-kv (fn [out k v] (assoc out (f k) v)) {} m)))
#?(:kotoba
   (defn filter-vals [pred [:fn [[:document] :document]] m :document] :document
     (kv-fold (fn [out k v]
                (if (document-equal? (pred v) (document-bool true)) (document-assoc out k v) out))
              (document-map) m 0 (document-count m)))
   :default
(defn filter-vals
  "Return a map containing only the entries of `m` whose value satisfies
  `pred`."
  [pred m]
  (reduce-kv (fn [out k v]
               (if (pred v) (assoc out k v) out))
             {} m)))
#?(:kotoba
   (defn filter-keys [pred [:fn [[:document] :document]] m :document] :document
     (kv-fold (fn [out k v]
                (if (document-equal? (pred k) (document-bool true)) (document-assoc out k v) out))
              (document-map) m 0 (document-count m)))
   :default
(defn filter-keys
  "Return a map containing only the entries of `m` whose key satisfies `pred`."
  [pred m]
  (reduce-kv (fn [out k v]
               (if (pred k) (assoc out k v) out))
             {} m)))
#?(:kotoba
   (defn deep-merge
     ([a :document] :document a)
     ([a :document b :document] :document (dm-w a b))
     ([a :document b :document & more] :document (dm-acc (dm-w a b) more)))
   :default
(defn deep-merge
  "Recursively merge maps: when both values at a key are maps, they are merged
  recursively; otherwise the rightmost value wins. Scalars and collections that
  are not both maps are replaced (not concatenated) — this is merge semantics,
  not conj semantics."
  ([a] a)
  ([a b]
   (if (and (map? a) (map? b))
     (merge-with deep-merge a b)
     b))
  ([a b & more]
   (reduce deep-merge (deep-merge a b) more))))
#?(:kotoba
   (defn index-by [keyfn [:fn [[:document] :document]] coll :document] :document
     (vec-fold (fn [out item] (document-assoc out (keyfn item) item))
              (document-map) coll 0 (document-count coll)))
   :default
(defn index-by
  "Return a map from `(keyfn item)` to `item` for each `item` in `coll`. Later
  items win on key collision. Nil keys are dropped (a nil key would collapse
  entries)."
  [keyfn coll]
  (reduce (fn [out item]
            (let [k (keyfn item)]
              (if (nil? k) out (assoc out k item))))
          {} coll)))
#?(:kotoba
   (defn index-of [coll :document x :document] :document
     (idx-of-w coll x 0 (document-count coll)))
   :default
(defn index-of
  "The index of the first element of the sequential `coll` equal (`=`) to `x`,
  or -1 when none is -- what `java.util.List#indexOf` answers for a Clojure
  vector, list or seq on the JVM (APersistentVector / ASeq compare with
  `Util.equiv`, which is `=`), and what ClojureScript's `(.indexOf v x)`
  answers for its vectors and lists. `x` may be nil (the first nil's index).

  One deliberate difference: a nil `coll` answers -1 where
  `(.indexOf ^java.util.List nil x)` throws NullPointerException.

  For a string use kotoba.lang.text/index-of; a map or set is not sequential
  and has no index."
  [coll x]
  (loop [s (seq coll) i 0]
    (cond (nil? s) -1
          (= (first s) x) i
          :else (recur (next s) (inc i))))))
#?(:kotoba
   (defn assoc-some
     ([m :document k :document v :document] :document
      (if (document-equal? v (document-null)) m (document-assoc m k v)))
     ([m :document k :document v :document & kvs] :document
      (assoc-some-w (if (document-equal? v (document-null)) m (document-assoc m k v)) kvs)))
   :default
(defn assoc-some
  "Assoc `k` to `v` in `m` only when `v` is not nil. Useful for building option
  maps without (when ...) scaffolding at every call site."
  ([m k v]
   (if (nil? v) m (assoc m k v)))
  ([m k v & kvs]
   (let [m (assoc-some m k v)]
     (if (seq kvs)
       (recur m (first kvs) (second kvs) (nnext kvs))
       m)))))
#?(:kotoba
   (defn set-union
     ([] :document (set-of (document-vector)))
     ([s1 :document] :document (if (document-equal? s1 (document-null)) (set-of (document-vector)) s1))
     ([s1 :document s2 :document] :document
      (set-of (document-vector-conj (set-items (if (document-equal? s1 (document-null)) (set-of (document-vector)) s1))
                                    (set-items s2))))
     ([s1 :document s2 :document & sets] :document
      (set-union-w (set-union s1 s2) sets)))
   :default
(defn set-union
  "Union of zero or more sets. Mirrors clojure.set/union without the
  clojure.set dependency."
  ([] #{})
  ([s1] (or s1 #{}))
  ([s1 s2] (into (or s1 #{}) (or s2 #{})))
  ([s1 s2 & sets] (reduce set-union (set-union s1 s2) sets))))
#?(:kotoba
   (defn set-intersection
     ([s1 :document] :document s1)
     ([s1 :document s2 :document] :document (set-inter-w s1 s2 (set-items s1) 0 (document-count (set-items s1)) (set-of (document-vector))))
     ([s1 :document s2 :document & sets] :document
      (set-inter-acc (set-intersection s1 s2) sets)))
   :default
(defn set-intersection
  "Intersection of one or more sets. Mirrors clojure.set/intersection."
  ([s1] s1)
  ([s1 s2] (into (empty s1) (filter #(contains? s2 %)) s1))
  ([s1 s2 & sets] (reduce set-intersection (set-intersection s1 s2) sets))))
#?(:kotoba
   (defn set-difference
     ([s1 :document] :document s1)
     ([s1 :document s2 :document] :document (set-diff-w s1 s2 (set-items s1) 0 (document-count (set-items s1)) (set-of (document-vector))))
     ([s1 :document s2 :document & sets] :document
      (set-diff-acc s1 sets)))
   :default
(defn set-difference
  "Elements of s1 not present in any of the other sets. Mirrors
  clojure.set/difference."
  ([s1] s1)
  ([s1 s2] (into (empty s1) (remove #(contains? s2 %)) s1))
  ([s1 s2 & sets] (reduce set-difference (set-difference s1 s2) sets))))
#?(:kotoba
   (defn bubble-max-key [k [:fn [[:document] :document]] coll :document] :document
     (bmw k coll 0 (document-count coll) (document-null) (document-vector) 0))
   :default
(defn- bubble-max-key
  "Move a maximal element of coll according to fn k (which returns a
  number) to the front of coll."
  [k coll]
  (let [max (apply max-key k coll)]
    (cons max (remove #(identical? max %) coll)))))
#?(:kotoba
   (defn union
     ([] :document (set-of (document-vector)))
     ([s1 :document] :document s1)
     ([s1 :document s2 :document] :document (set-union s1 s2))
     ([s1 :document s2 :document & sets] :document (set-union-w (set-union s1 s2) sets)))
   :default
(defn union
  "Return a set that is the union of the input sets. clojure.set/union."
  ([] #{})
  ([s1] s1)
  ([s1 s2]
   (if (< (count s1) (count s2))
     (reduce conj s2 s1)
     (reduce conj s1 s2)))
  ([s1 s2 & sets]
   (let [bubbled-sets (bubble-max-key count (conj sets s2 s1))]
     (reduce into (first bubbled-sets) (rest bubbled-sets))))))
#?(:kotoba
   (defn intersection
     ([s1 :document] :document s1)
     ([s1 :document s2 :document] :document (set-intersection s1 s2))
     ([s1 :document s2 :document & sets] :document (set-inter-acc (set-intersection s1 s2) sets)))
   :default
(defn intersection
  "Return a set that is the intersection of the input sets.
  clojure.set/intersection."
  ([s1] s1)
  ([s1 s2]
   (if (< (count s2) (count s1))
     (recur s2 s1)
     (reduce (fn [result item]
               (if (contains? s2 item)
                 result
                 (disj result item)))
             s1 s1)))
  ([s1 s2 & sets]
   (let [bubbled-sets (bubble-max-key #(- (count %)) (conj sets s2 s1))]
     (reduce intersection (first bubbled-sets) (rest bubbled-sets))))))
#?(:kotoba
   (defn difference
     ([s1 :document] :document s1)
     ([s1 :document s2 :document] :document (set-difference s1 s2))
     ([s1 :document s2 :document & sets] :document (set-diff-acc s1 sets)))
   :default
(defn difference
  "Return a set that is the first set without elements of the remaining
  sets. clojure.set/difference."
  ([s1] s1)
  ([s1 s2]
   (if (< (count s1) (count s2))
     (reduce (fn [result item]
               (if (contains? s2 item)
                 (disj result item)
                 result))
             s1 s1)
     (reduce disj s1 s2)))
  ([s1 s2 & sets]
   (reduce difference s1 (conj sets s2)))))
#?(:kotoba
   (defn map-invert [m :document] :document
     (kv-fold (fn [out k v] (document-assoc out v k))
              (document-map) m 0 (document-count m)))
   :default
(defn map-invert
  "Returns the map with the vals mapped to the keys. clojure.set/map-invert."
  [m]
  (persistent!
   (reduce-kv (fn [m k v] (assoc! m v k))
              (transient {})
              m))))
#?(:kotoba
   (defn subset? [set1 :document set2 :document] :bool
     (set-sub-w set1 set2 (set-items set1) 0 (document-count (set-items set1))))
   :default
(defn subset?
  "True if every element of set1 is also in set2. Mirrors
  clojure.set/subset?. An empty set1 is a subset of any set2, including
  another empty set."
  [set1 set2]
  (and (<= (count set1) (count set2))
       (every? #(contains? set2 %) set1))))
#?(:kotoba
   (defn superset? [set1 :document set2 :document] :bool
     (set-sub-w set2 set1 (set-items set2) 0 (document-count (set-items set2))))
   :default
(defn superset?
  "True if every element of set2 is also in set1. Mirrors
  clojure.set/superset?."
  [set1 set2]
  (and (>= (count set1) (count set2))
       (every? #(contains? set1 %) set2))))
#?(:kotoba
   (defn select [pred [:fn [[:document] :document]] xrel :document] :document
     (set-of (sel-w pred (set-items xrel) 0 (document-count (set-items xrel)) (document-vector))))
   :default
(defn select
  "Return the subset of relation `xrel` (a set of maps) for which `pred` is
  true. Mirrors clojure.set/select. `xrel` need not be a relation -- select
  works over any set -- but is named `xrel` to match clojure.set's own
  parameter name, since that is its primary use."
  [pred xrel]
  (reduce (fn [s k] (if (pred k) s (disj s k))) xrel xrel)))
#?(:kotoba
   (defn project [xrel :document ks :document] :document
     (set-of (proj-w (set-items xrel) ks 0 (document-count (set-items xrel)) (document-vector))))
   :default
(defn project
  "Return a relation (set of maps) built from `xrel` by keeping only the
  keys in `ks` of each map. Mirrors clojure.set/project. Maps that become
  identical after projecting (because the dropped keys were the only
  difference) collapse into one entry, since the result is a set."
  [xrel ks]
  (set (map #(select-keys % ks) xrel))))
#?(:kotoba
   (defn rename-keys [m :document kmap :document] :document
     (ren-w m kmap 0 (document-count m) (document-map)))
   :default
(defn rename-keys
  "Return `m` with any key present in `kmap` renamed to that key's value in
  `kmap`; keys of `m` absent from `kmap` are left as-is. Mirrors
  clojure.set/rename-keys. Operates on a single map (not a relation) --
  `rename` below is the relation-wide form."
  [m kmap]
  (reduce
   (fn [out [old new]]
     (if (contains? m old)
       (assoc out new (get m old))
       out))
   (apply dissoc m (keys kmap))
   kmap)))
#?(:kotoba
   (defn rename [xrel :document kmap :document] :document
     (set-of (ren-rel-w (set-items xrel) kmap 0 (document-count (set-items xrel)) (document-vector))))
   :default
(defn rename
  "Return a relation (set of maps) built from `xrel` by applying
  `rename-keys` with `kmap` to every map in it. Mirrors clojure.set/rename."
  [xrel kmap]
  (set (map #(rename-keys % kmap) xrel))))
#?(:kotoba
   (defn index [xrel :document ks :document] :document
     (idx-w (set-items xrel) ks 0 (document-count (set-items xrel)) (document-map)))
   :default
(defn index
  "Return a map from the distinct values of `ks` (as a map holding just
  those keys) to the set of maps in relation `xrel` that have those values.
  Mirrors clojure.set/index."
  [xrel ks]
  (reduce
   (fn [m x]
     (let [ik (select-keys x ks)]
       (assoc m ik (conj (get m ik #{}) x))))
   {} xrel)))
#?(:kotoba
   (defn invert-map [m :document] :document
     (kv-fold (fn [out k v] (document-assoc out v k))
              (document-map) m 0 (document-count m)))
   :default
(defn- invert-map
  "Return `m` with each value mapped back to its key. Later entries win on a
  value collision. Private: mirrors clojure.set/map-invert but is not
  exported, since it is only needed here to implement the 3-arg `join`
  below and this namespace does not otherwise claim clojure.set/map-invert
  coverage."
  [m]
  (reduce (fn [out [k v]] (assoc out v k)) {} m)))
#?(:kotoba
   (defn join
     ([xrel :document yrel :document] :document (join-w xrel yrel (common-ks xrel yrel (set-items xrel) 0 (document-count (set-items xrel)) (set-of (document-vector))) 0 (document-count xrel) (set-of (document-vector))))
     ([xrel :document yrel :document km :document] :document (join-w xrel yrel km 0 (document-count xrel) (set-of (document-vector)))))
   :default
(defn join
  "Join two relations (sets of maps).

  2-arg form -- natural join: joins `xrel` and `yrel` on every key name
  they have in common, keeping rows where the values at those keys match.
  Returns the empty set if either relation is empty (there is nothing to
  match against, not an error).

  3-arg form -- explicit-mapping join: `km` is a map of {xrel-key
  yrel-key}, naming which key of `xrel` corresponds to which key of `yrel`
  when the two relations don't share key names (or share a name that
  doesn't mean the same column).

  Mirrors clojure.set/join exactly, including which relation gets indexed
  (the smaller one, by count) -- an implementation-detail optimization that
  does not affect the result, only performance."
  ([xrel yrel]
   (if (and (seq xrel) (seq yrel))
     (let [ks (set-intersection (set (keys (first xrel))) (set (keys (first yrel))))
           [r s] (if (<= (count xrel) (count yrel)) [xrel yrel] [yrel xrel])
           idx (index r ks)]
       (reduce (fn [ret x]
                 (if-let [found (idx (select-keys x ks))]
                   (reduce #(conj %1 (clojure.core/merge %2 x)) ret found)
                   ret))
               #{} s))
     #{}))
  ([xrel yrel km]
   (let [[r s k] (if (<= (count xrel) (count yrel))
                   [xrel yrel (invert-map km)]
                   [yrel xrel km])
         idx (index r (vals k))]
     (reduce (fn [ret x]
               (if-let [found (idx (rename-keys (select-keys x (keys k)) k))]
                 (reduce #(conj %1 (clojure.core/merge %2 x)) ret found)
                 ret))
             #{} s)))))
