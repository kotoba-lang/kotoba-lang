(ns kotoba.lang.cljk-lint
  "Lint .cljk files with the language clj-kondo used before the rename.

  Directory walks only see .clj/.cljs/.cljc. Forcing --lang cljc on every
  .cljk file treats former .clj sources as ClojureScript-shared and reports
  false unresolved `slurp` / `proxy` errors. Use cljk-origin.edn."
  (:require [clj-kondo.core :as kondo]
            [clojure.edn :as edn]
            [clojure.java.io :as io]))

(def ^:private origin-path "cljk-origin.edn")

(defn- repo-path
  ^String [^java.io.File file]
  (let [root (.toPath (.getCanonicalFile (io/file ".")))
        full (.toPath (.getCanonicalFile file))]
    (.toString (.relativize root full))))

(defn- cljk-files [roots]
  (->> roots
       (map io/file)
       (mapcat file-seq)
       (filter (fn [^java.io.File f]
                 (and (.isFile f)
                      (.endsWith (.getName f) ".cljk"))))
       sort
       vec))

(defn- lang-for
  "New .cljk files (no origin row) are JVM-only loaders; lint as clj."
  [path origins]
  (case (get origins path)
    ".cljc" :cljc
    ".cljs" :cljs
    :clj))

(defn- exit-for [summary]
  (if (pos? (or (:error summary) 0))
    3
    0))

(defn -main
  [& _args]
  (let [origins (:origins (edn/read-string (slurp origin-path)))
        grouped (->> (cljk-files ["src" "test"])
                     (group-by (fn [^java.io.File f]
                                 (lang-for (repo-path f) origins))))]
    (when (empty? grouped)
      (throw (ex-info "no .cljk files to lint under src/ or test/" {})))
    (let [code (reduce
                (fn [acc [lang files]]
                  (let [paths (mapv #(.getPath ^java.io.File %) files)
                        results (kondo/run! {:lint paths :lang lang})
                        _ (kondo/print! results)]
                    (max acc (exit-for (:summary results)))))
                0
                (sort-by (comp name key) grouped))]
      (System/exit code))))
