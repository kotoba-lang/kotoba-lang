(ns kotoba.lang.cljk-lint
  "Lint every .cljk file under src/ and test/ as .cljc.

  clj-kondo's directory walk only sees .clj/.cljs/.cljc/.edn. After the
  rename that walk is empty; pass the files explicitly."
  (:require [clj-kondo.main :as kondo]
            [clojure.java.io :as io]))

(defn- cljk-files [roots]
  (->> roots
       (map io/file)
       (mapcat file-seq)
       (filter (fn [^java.io.File f]
                 (and (.isFile f)
                      (.endsWith (.getName f) ".cljk"))))
       (map (fn [^java.io.File f] (.getPath f)))
       sort
       vec))

(defn -main
  [& args]
  (let [files (cljk-files ["src" "test"])]
    (when (empty? files)
      (throw (ex-info "no .cljk files to lint under src/ or test/" {})))
    (apply kondo/-main
           (concat ["--lang" "cljc" "--fail-level" "error" "--lint"]
                   files
                   args))))
