;; Differential probe for lang/compat/kotoba/compiler/refactor/cst.kotoba (scripts/cst-twin-diff/run.sh).
;; argv: dump <file>. Prints the twin's view of <file> in the line format host_dump.cljs prints for the host cst.cljk.
(ns probe.cst-dump
  (:require [kotoba.compiler.refactor.cst :as cst]))

(defn- argc [] :i64
  (let [s (typed-cap-call :cli/args :string :string "")]
    (loop [i 0 acc 0]
      (if (>= i (string-byte-length s)) acc (recur (+ i 1) (+ (* acc 10) (- (string-code-point-at s i) 48)))))))

(defn- arg [i :i64] :string (typed-cap-call :cli/args :string :string (string-from-i64 i)))
(defn- out [s :string] :i64 (let [r (typed-cap-call :io/write :string :string s)] 0))

(defn- kw [k :keyword] :string
  (cond (= k :list) "list" (= k :vec) "vec" (= k :map) "map" (= k :set) "set" (= k :fnlit) "fnlit"
        (= k :rc) "rc" (= k :prefix) "prefix" (= k :meta) "meta" (= k :sym) "sym" (= k :kw) "kw"
        (= k :num) "num" (= k :str) "str" (= k :char) "char" (= k :regex) "regex" (= k :nil) "nil"
        (= k :shared) "shared" (= k :kotoba) "kotoba" (= k :default) "default" :else "?"))

(defn- i [n :i64] :string (string-from-i64 n))
(defn- sp [a :string b :string] :string (string-concat a (string-concat " " b)))
(defn- orq [s :string] :string (if (string=? s "") "-" s))

(defn- visit-line [vs [:list [:ref :cst/visit]] k :i64] :string
  (let [v (typed-list-nth [:list [:ref :cst/visit]] vs k)
        n (cst/visit-node v)
        key (cst/visit-key v)
        fv (if (cst/call? n "defn") (cst/->fn-view n) (cst/nil-node))
        a1 (sp "V" (i k))
        a2 (sp a1 (i (cst/visit-parent v)))
        a3 (sp a2 (kw (cst/visit-region v)))
        a4 (sp a3 (i (cst/visit-index v)))
        a5 (sp a4 (kw (cst/node-type n)))
        a6 (sp a5 (i (cst/node-s n)))
        a7 (sp a6 (i (cst/node-e n)))
        a8 (sp a7 (orq (cst/node-prefix n)))
        a9 (sp a8 (if (cst/node-splice? n) "1" "0"))
        b1 (sp a9 (orq (cst/head-text n)))
        b2 (sp b1 (orq (cst/call-head-text n)))
        b3 (sp b2 (kw (cst/node-type (cst/strip-meta n))))
        b4 (sp b3 (if (cst/nil-node? key) "-" (cst/node-text key)))
        b5 (sp b4 (i (vector-count (cst/args n))))
        b6 (sp b5 (i (vector-count (cst/rc-branches n))))
        b7 (sp b6 (if (cst/nil-node? fv) "-" (i (vector-count (cst/node-kids fv)))))]
    (string-concat b7 "\n")))

(defn- dump [path :string] :i64
  (let [src (typed-cap-call :fs/app-data :string :string path)
        o (cst/parse src)
        vs (cst/walk-visits (cst/out-nodes o))
        w0 (out (string-concat (sp (sp "E" (orq (cst/out-err o))) (i (cst/out-at o))) "\n"))
        m (vector-count vs)]
    (loop [k 0]
      (if (>= k m) 0 (let [w (out (visit-line vs k))] (recur (+ k 1)))))))

(defn main [] :i64
  (if (< (argc) 2) 64 (dump (arg 1))))
