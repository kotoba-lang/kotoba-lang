;; prove-selfhost-native-red.cljk -- stages 2 and 3 of the selfhost distance
;; can go red, for the reason they name (AGENTS.md, the 8 questions: 5, 6, 7).
;;
;; Three runs of measure-selfhost-distance.cljk over ONE stage-1 pass,
;; amu's kotoba/compiler/host_integer.cljk, reusing stage 1 from the committed
;; lang/selfhost-distance.edn:
;;
;;   control      the file as it is: stage 2 :ok on both ISAs.
;;   unlowerable  a copy whose `safe-integer?` native reading calls `min`, which
;;                `amu check` admits (asserted here) and the native gate does
;;                not qualify: stage 2 must be :refused, code
;;                :kotoba/target-rejected, message naming `min`.
;;   wrong-value  a copy whose `narrow` native reading answers (+ x 1) while the
;;                host reading is untouched: stage 2 :ok, stage 3 must turn
;;                `narrow` from its control counts to :agree 0, with the case
;;                x = 0 answering native 1 / host 0, and every other export's
;;                counts equal to control's.
;;
;;   nbb --classpath "<kl>/src:<kl>/scripts:<text>/src:<kotoba-sema>/src:<amu>/src" \
;;     <kl>/scripts/prove-selfhost-native-red.cljk --amu <amu> --kl <kl> --work <dir> \
;;     --classpath "<same classpath>"
;;
;; Exit 0 = every assertion held; 1 = one did not (printed); 2 = could not run.

(ns prove-selfhost-native-red
  (:require ["node:fs" :as fs]
            ["node:path" :as path]
            ["node:child_process" :as cp]
            [cljs.reader :as reader]
            [kotoba.lang.text :as str]))

(def ^:private argv (vec (js->clj js/process.argv)))
(defn- opt [flag] (let [i (.indexOf (into-array argv) flag)] (when (nat-int? i) (nth argv (inc i) nil))))

(def amu (path/resolve (or (opt "--amu") (throw (js/Error. "--amu required")))))
(def kl (path/resolve (or (opt "--kl") (throw (js/Error. "--kl required")))))
(def work (path/resolve (or (opt "--work") (throw (js/Error. "--work required")))))
(def classpath (or (opt "--classpath") (throw (js/Error. "--classpath required"))))
(def target (path/join amu "src/kotoba/compiler/host_integer.cljk"))

(def failures (atom []))
(defn- check! [label ok? detail]
  (println (if ok? "PASS" "FAIL") label (if ok? "" (str "-- " detail)))
  (when-not ok? (swap! failures conj label)))

(defn- mutate [out old new]
  (let [src (fs/readFileSync target "utf8")]
    (when-not (str/includes? src old)
      (println "COULD-NOT-RUN: the mutation site is gone from" target ":" old)
      (js/process.exit 2))
    (fs/writeFileSync out (str/replace-first src old new))
    out))

(defn- measure [tag substitute]
  (let [out (path/join work (str tag ".edn"))
        r (cp/spawnSync "nbb"
                        (clj->js (concat ["--classpath" classpath
                                          (path/join kl "scripts/measure-selfhost-distance.cljk")
                                          "--amu" amu "--compat" (path/join kl "lang/compat")
                                          "--reuse-stage1" (path/join kl "lang/selfhost-distance.edn")
                                          "--native-only" "compiler/host_integer.cljk"
                                          "--native-work" (path/join work tag)
                                          "--output" out]
                                         (when substitute ["--substitute" (str target "=" substitute)])))
                        #js {:encoding "utf8" :cwd amu :maxBuffer (* 64 1024 1024)})]
    (when-not (and (zero? (.-status r)) (fs/existsSync out))
      (println "COULD-NOT-RUN:" tag "status" (.-status r) (subs (str (.-stderr r) (.-stdout r)) 0 600))
      (js/process.exit 2))
    (let [m (reader/read-string (fs/readFileSync out "utf8"))]
      {:s2 (first (get-in m [:native-compile :modules]))
       :s3 (first (get-in m [:native-differential :modules]))})))

(defn- fn-rows [s3 isa]
  (into {} (map (fn [f] [(:export f) f])
                (:functions (first (filter #(= isa (:isa %)) (get-in s3 [:stage3 :per-isa])))))))

(fs/mkdirSync work #js {:recursive true})

(def unlowerable
  (mutate (path/join work "host_integer_unlowerable.cljk")
          "     :default (<= (- max-safe) x max-safe)))"
          "     :default (<= (- max-safe) (min x max-safe) max-safe)))"))

(def wrong-value
  (mutate (path/join work "host_integer_wrong_value.cljk")
          "(defn narrow [x]\n  #?(:cljs (if (i64/bigint-value? x) (js/Number x) x)\n     :default x))"
          "(defn narrow [x]\n  #?(:cljs (if (i64/bigint-value? x) (js/Number x) x)\n     :default (+ x 1)))"))

;; Stage 1 still admits the unlowerable copy: the red below is stage 2's.
(let [cpr (cp/spawnSync "node" (clj->js [(path/join amu "node_modules/nbb/cli.js") "--classpath" (path/join amu "src")
                                         (path/join amu "scripts/print-classpath.cljk") amu])
                        #js {:encoding "utf8" :cwd amu :maxBuffer (* 16 1024 1024)})
      src-roots (concat (filter #(str/ends-with? % "/src") (str/split-lines (.-stdout cpr)))
                        [(path/join amu "src") (path/join kl "lang/compat")])
      r (cp/spawnSync "node" (clj->js (concat [(path/join amu "bin/amu") "check" unlowerable]
                                              (mapcat (fn [d] ["--source-path" d]) src-roots)
                                              ["--policy" (path/join kl "lang/selfhost-compiler-grant.edn")]))
                      #js {:encoding "utf8" :cwd amu :maxBuffer (* 16 1024 1024)})]
  (check! "stage 1 (amu check, project route) admits the unlowerable copy"
          (zero? (.-status r)) (subs (str (.-stdout r) (.-stderr r)) 0 400)))

(def control (measure "control" nil))
(def red2 (measure "unlowerable" unlowerable))
(def red3 (measure "wrong-value" wrong-value))

(check! "control: stage 2 :ok" (= :ok (get-in control [:s2 :stage2 :status])) (pr-str (get-in control [:s2 :stage2 :status])))
(doseq [row (get-in red2 [:s2 :stage2 :per-isa])]
  (check! (str "unlowerable " (:isa row) ": stage 2 :refused :kotoba/target-rejected naming `min`")
          (and (= :refused (:status row))
               (= ":kotoba/target-rejected" (:code row))
               (str/includes? (str (:message row)) "does not qualify `min`"))
          (pr-str (select-keys row [:status :code :message :detail]))))
(check! "unlowerable: stage 3 is :skipped, not a pass" (= :skipped (get-in red2 [:s3 :stage3 :status])) (pr-str (get-in red2 [:s3 :stage3 :status])))
(check! "wrong-value: stage 2 :ok" (= :ok (get-in red3 [:s2 :stage2 :status])) (pr-str (get-in red3 [:s2 :stage2 :status])))
(doseq [isa [:aarch64 :x86_64]]
  (let [c (fn-rows (:s3 control) isa)
        w (fn-rows (:s3 red3) isa)
        n (get w "narrow")]
    (check! (str "wrong-value " isa ": narrow :mismatch with :agree 0 (control :agree " (get-in c ["narrow" :counts :agree]) ")")
            (and (= :mismatch (:status n)) (zero? (get-in n [:counts :agree]))
                 (pos? (get-in c ["narrow" :counts :agree])))
            (pr-str (:counts n)))
    (check! (str "wrong-value " isa ": x = 0 answers native 1 / host 0")
            (= {:args ["0"] :native {:ok [:int "1"]} :host {:ok [:int "0"]}} (:first-counterexample n))
            (pr-str (:first-counterexample n)))
    (check! (str "wrong-value " isa ": every other export's counts equal control's")
            (= (dissoc (into {} (map (fn [[k v]] [k (:counts v)]) c)) "narrow")
               (dissoc (into {} (map (fn [[k v]] [k (:counts v)]) w)) "narrow"))
            "counts moved outside narrow")))

(println (str "CHECKS\t" (count @failures) " failed"))
(js/process.exit (if (seq @failures) 1 0))
