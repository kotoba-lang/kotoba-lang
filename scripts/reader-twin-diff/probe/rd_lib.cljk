(ns probe.rd-lib
  {:kotoba/export [hash-of dump]}
  (:require [kotoba.compiler.kotoba-reader :as rd])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                       [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
             :kotoba.reader/out [:record :kotoba.reader/out
                                 [[:forms [:list [:ref :form/r]]]
                                  [:err :string]
                                  [:at :i64]]]}))

(defn- m [h :i64 x :i64] :i64 (+ (* h 1099511628211) (+ x 7)))

(defn- str-hash [s :string h :i64] :i64
  (let [n (string-byte-length s)]
    (loop [i 0 acc h]
      (if (>= i n)
        acc
        (let [p (string-code-point-at s i)]
          (recur (+ i (if (< p 128) 1 (if (< p 2048) 2 (if (< p 65536) 3 4)))) (m acc p)))))))

(defn- tag-of [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :tag))
(defn- kids-of [f [:ref :form/r]] [:list [:ref :form/r]] (record-get [:ref :form/r] f :kids))
(defn- span-of [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :span))
(defn- s-of [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s))
(defn- n-of [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :n))
(defn- kid [xs [:list [:ref :form/r]] i :i64] [:ref :form/r]
  (typed-list-nth [:list [:ref :form/r]] xs i))

(defn- wrapper? [f [:ref :form/r]] :bool
  (and (= 6 (tag-of f))
       (= 3 (vector-count (kids-of f)))
       (= 5 (tag-of (kid (kids-of f) 0)))
       (string=? (s-of (kid (kids-of f) 0)) "kotoba.reader/meta")))

(defn- kids-ordered [xs [:list [:ref :form/r]] i :i64 acc :i64] :i64
  (if (>= i (vector-count xs)) acc (kids-ordered xs (+ i 1) (m acc (fh (kid xs i))))))

(defn- kids-sum [xs [:list [:ref :form/r]] i :i64 acc :i64] :i64
  (if (>= i (vector-count xs)) acc (kids-sum xs (+ i 1) (+ acc (fh (kid xs i))))))

(defn- pairs-sum [xs [:list [:ref :form/r]] i :i64 acc :i64] :i64
  (if (>= (+ i 1) (vector-count xs))
    acc
    (pairs-sum xs (+ i 2) (+ acc (m (fh (kid xs i)) (fh (kid xs (+ i 1))))))))

(defn- node-hash [f [:ref :form/r] span :i64] :i64
  (let [t (tag-of f)
        h0 (m 1469598103 t)
        h1 (if (>= t 5) (if (<= t 10) (m h0 span) h0) h0)
        ks (kids-of f)]
    (cond
      (= t 0) h1
      (or (= t 1) (= t 2) (= t 10)) (m h1 (n-of f))
      (or (= t 3) (= t 5)) (str-hash (s-of f) h1)
      (= t 4) (str-hash (s-of f) h1)
      (= t 6) (m (kids-ordered ks 0 h1) (vector-count ks))
      (= t 7) (m (kids-ordered ks 0 h1) (vector-count ks))
      (= t 8) (m (m h1 (kids-sum ks 0 0)) (vector-count ks))
      (= t 9) (m (m h1 (pairs-sum ks 0 0)) (vector-count ks))
      :else h1)))

(defn- unwrap-hash [f [:ref :form/r] span :i64] :i64
  (if (wrapper? f)
    (unwrap-hash (kid (kids-of f) 2) span)
    (node-hash f span)))

(defn- auto-kw? [f [:ref :form/r]] :bool
  (and (= 6 (tag-of f))
       (= 2 (vector-count (kids-of f)))
       (= 5 (tag-of (kid (kids-of f) 0)))
       (string=? (s-of (kid (kids-of f) 0)) "kotoba.reader/autokw")))

;; The host has no position for a `::x` keyword, so the tagged list is hashed without one.
(defn- fh [f [:ref :form/r]] :i64 (unwrap-hash f (if (auto-kw? f) 0 (span-of f))))

(defn- join-hashes [xs [:list [:ref :form/r]] i :i64 acc :string] :string
  (if (>= i (vector-count xs))
    acc
    (join-hashes xs (+ i 1) (str acc (string-from-i64 (fh (kid xs i))) ","))))

(defn hash-of [src :string] :string
  (let [o (rd/read-forms src)]
    (str (join-hashes (record-get [:ref :kotoba.reader/out] o :forms) 0 "")
         "|" (record-get [:ref :kotoba.reader/out] o :err)
         "|" (string-from-i64 (record-get [:ref :kotoba.reader/out] o :at)))))

(defn- dump-node [f [:ref :form/r] span :i64 acc :string] :string
  (if (wrapper? f)
    (dump-node (kid (kids-of f) 2) span acc)
    (let [t (tag-of f)
          line (str acc (string-from-i64 t) " "
                    (string-from-i64 (if (>= t 5) (if (<= t 10) span 0) 0)) " "
                    (if (or (= t 3) (= t 4) (= t 5)) (s-of f) (string-from-i64 (n-of f)))
                    " " (string-from-i64 (vector-count (kids-of f))) "\n")]
      (dump-kids (kids-of f) 0 line))))

(defn- dump-kids [xs [:list [:ref :form/r]] i :i64 acc :string] :string
  (if (>= i (vector-count xs))
    acc
    (dump-kids xs (+ i 1) (dump-node (kid xs i) (span-of (kid xs i)) acc))))

(defn dump [src :string] :string
  (let [o (rd/read-forms src)]
    (dump-kids (record-get [:ref :kotoba.reader/out] o :forms) 0 "")))
