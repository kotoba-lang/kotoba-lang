;; Regenerates the measured image vectors (D2 of
;; docs/adr/ADR-kotoba-lisp-machine-contract-decisions.md):
;;
;;   lang/lisp-machine-image-vectors.edn
;;
;; Every digest below is computed, never typed by hand -- the rule that
;; lang/code-identity-vectors.edn states for DefCID applies here verbatim:
;; a fixture with an invented hash only ever tests the rejection path, and a
;; hand-edited hash turns a regression into a green build.
;;
;; The image triple is encoded through the boundary's canonical form
;; (tagged dag-cbor, kotoba.protocol.boundary): `identity/normalize` then
;; `cbor/encode`, then CIDv1 dag-cbor + sha2-256 (`mf/cidv1-dag-cbor`) --
;; the same primitives kotoba.kir.definition-identity uses for DefCID.
;; A different canonical encoding would move every digest, which is exactly
;; why the encoding is named in the fixture and versioned.
;;
;;   kbb -M -e "(load-file \"scripts/gen_image_vectors_fixtures.cljk\")"

(require '[kotoba.lang.code-identity :as ci]
         '[cbor.core :as cbor]
         '[multiformats.core :as mf]
         '[kotoba.io :as io]
         '[kotoba.lang.text :as str])

(def ^:private hex-digits "0123456789abcdef")

(defn- byte->hex [b]
  (let [v (bit-and b 0xff)]
    (str (nth hex-digits (bit-shift-right v 4))
         (nth hex-digits (bit-and v 0x0f)))))

(defn- bytes->hex [bs]
  (apply str (map byte->hex (seq bs))))

(defn canonical-bytes [payload]
  (cbor/encode (ci/normalize payload)))

(defn image-cid [payload]
  (mf/cidv1-dag-cbor (canonical-bytes payload)))

;; Concrete fixture identities. All computed: two DefCIDs from real
;; definitions (the code-environment bindings), one world root, one absent
;; CID for the unresolved case.
(def base-def
  {:definition/profile-version 4
   :definition/desugar-contract-version 1
   :definition/kir {:op :const :value 1}
   :definition/effect-row #{}
   :definition/interface {:arity 0 :result :i64}
   :definition/dependencies []})

(def def-a (ci/definition-cid base-def))
(def def-b (ci/definition-cid (assoc base-def :definition/kir {:op :const :value 2})))

(def world-root
  (image-cid {:world/fixture "lisp-machine-image-vectors" :world/height 1}))

(def absent-root
  (image-cid {:world/fixture "lisp-machine-image-vectors" :world/height 2}))

(def t1
  {:image/kind :image
   :image/version 1
   :image/world-root world-root
   :image/code-environment {:main def-a}
   :image/open-leases [{:lease/id "lease-1"
                        :lease/definition def-a
                        :lease/expires-at 1792000000}]})

(def t1-rebound
  (assoc-in t1 [:image/code-environment :main] def-b))

(def t2
  (assoc-in t1 [:image/open-leases 0 :lease/expires-at] 1792000001))

(defn measured [id kind rule note payload expect]
  (let [bs (canonical-bytes payload)]
    {:id id
     :kind kind
     :rule rule
     :note note
     :payload payload
     :canonical-hex (bytes->hex bs)
     :image-cid (image-cid payload)
     :expect expect}))

(def vectors
  [(measured :save-canonical-deterministic :positive :canonical-bytes-before-cid
     "encode(t1) twice must be byte-identical and address one CID"
     t1 {:outcome :saved})
   (measured :restore-roundtrip :positive :verify-cid-before-decode
     "restore(save(t1)) must decode back to t1"
     t1 {:outcome :restored})
   (measured :rebind-before :positive :versioned-wire-keys-preserved
     "before rebind(env-slot :main, def-a, def-b); the running continuation keeps def-a"
     t1 {:outcome :saved})
   (measured :rebind-after :positive :versioned-wire-keys-preserved
     "after the rebind the image CID must differ from :rebind-before"
     t1-rebound {:outcome :saved})
   (measured :restore-verify-cid-before-decode :negative :canonical-bytes-before-cid
     "t2's bytes declared under t1's CID must be refused before decode"
     t2 {:outcome :refused :reason :cid-mismatch
         :declared-cid (image-cid t1)})
   (measured :restore-unresolved-dependency :negative :unknown-shape-fail-closed
     "an image referencing an absent CID must refuse with :unresolved listing it"
     (assoc t1 :image/world-root absent-root)
     {:outcome :unresolved :missing [absent-root]})
   {:id :restore-unknown-shape
    :kind :negative
    :rule :unknown-shape-fail-closed
    :note "unknown tag / shape: fail closed and record; never skipped. No digest on purpose -- an invented hash only ever tests the rejection path."
    :expect {:outcome :refused :reason :unknown-shape}}
   {:id :restore-does-not-revive-authority
    :kind :negative
    :rule :no-secrets
    :note "restore never revives authority: an expired lease stays expired. Expectation only -- authority is decided by grant, not by the wire."
    :expect {:outcome :effect-refused :reason :lease-expired}}
   {:id :save-carries-no-secrets
    :kind :negative
    :rule :no-secrets
    :note "raw bearer / private key / ambient host handle in the triple: encode refuses. Expectation only."
    :expect {:outcome :refused :reason :secret-carrier}}])

(def fixture
  (str
   ";; kotoba.lang.lisp-machine-image-vectors -- measured image vectors (D2 of\n"
   ";; docs/adr/ADR-kotoba-lisp-machine-contract-decisions.md).\n"
   ";;\n"
   ";; GENERATED by scripts/gen_image_vectors_fixtures.cljk. Every digest here is\n"
   ";; computed, never typed by hand. DO NOT hand-edit a hash to make a test pass.\n"
   ";;\n"
   ";; Canonical form: tagged dag-cbor (ci/normalize + cbor/encode), CIDv1\n"
   ";; dag-cbor + sha2-256. A different canonical encoding moves every digest;\n"
   ";; that is a versioned migration, not a fix.\n"
   ";;\n"
   ";; Regenerate:  kbb -M -e \"(load-file \\\"scripts/gen_image_vectors_fixtures.cljk\\\")\"\n"
   "\n"
   (pr-str {:kotoba.lang.lisp-machine-image-vectors/version 1
            :codec :dag-cbor
            :multihash :sha2-256
            :canonical-form :tagged-dag-cbor-vector
            :payload-version 1
            :digests :measured
            :vectors vectors})
   "\n"))

(defn- write! [path content]
  (io/make-parents (io/file path))
  (spit path content))

(write! "lang/lisp-machine-image-vectors.edn" fixture)
(println "wrote lang/lisp-machine-image-vectors.edn")
(doseq [v vectors]
  (println (:id v) (or (:image-cid v) "(expectation only)")))
