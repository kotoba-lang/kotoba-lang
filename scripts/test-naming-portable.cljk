(ns test-naming-portable
  "Run with a .cljk-capable SCI host and explicit portable dependency paths."
  (:require [cljs.test :as t]
            [kotoba.lang.naming-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [result]
  (when-not (t/successful? result) (set! (.-exitCode js/process) 1)))

(t/run-tests 'kotoba.lang.naming-test)
