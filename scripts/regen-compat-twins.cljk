#!/usr/bin/env kbb
;; scripts/regen-compat-twins.cljk -- regenerate the lang/compat .kotoba twins from their upstream .cljk/.cljc with
;; `amu refactor to-kotoba` (JUN-240). BOOTSTRAP-TOOL (nbb, host only: it picks inputs; every byte written is amu's).
;;
;; USAGE
;;   kbb --backend sci scripts/regen-compat-twins.cljk [--manifest lang/compat-twins.tsv] [--repos ~/github/kotoba-lang]
;;                                                     [--amu ../amu] [--only ns1,ns2] [--check] [--log FILE]
;;
;; The manifest (lang/compat-twins.tsv) names, per twin: the upstream repo, the upstream commit, the repo-relative
;; source path, and the action. `regen` rows are rebuilt: the source is read with `git show <sha>:<path>` from a local
;; clone (<repos>/<repo>; no network, no fallback revision -- a missing commit fails the row), converted with
;; `amu refactor to-kotoba <src> --out lang/compat/<twin>`, and amu's own round-trip check (re-parse + idempotence)
;; gates the write. `keep` rows are hand-authored or hand-fixed twins whose semantics are not upstream yet; they are
;; never written, and the note says what has to move upstream (as a :kotoba arm) before they can become `regen`.
;;
;; --check converts into a temp dir and reports DRIFT when a regen twin differs from what is checked in.
;; The log (default stdout) has one row per twin: ns, action, verdict, :rc map, :rc-no-arm count, note.
;;
;; EXIT CODES  0 every row converted (and, with --check, no drift)  1 --check found drift  2 a row failed

(ns regen-compat-twins
  (:require ["node:child_process" :as cp]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as path]
            [clojure.string :as str]))

(def argv (vec (drop 2 (js->clj (.-argv js/process)))))

(defn opt [name default]
  (let [i (.indexOf (clj->js argv) name)]
    (if (and (>= i 0) (< (inc i) (count argv))) (nth argv (inc i)) default)))

(def root (path/resolve "."))

(defn expand-home [p] (if (str/starts-with? p "~/") (path/join (os/homedir) (subs p 2)) p))

(defn run [cmd args cwd]
  (let [r (cp/spawnSync cmd (clj->js args) #js {:cwd cwd :maxBuffer (* 256 1024 1024)})]
    {:status (.-status r) :stdout (.-stdout r) :stderr (.-stderr r)}))

(defn -main []
  (let [manifest (path/resolve (opt "--manifest" (path/join root "lang" "compat-twins.tsv")))
        repos    (path/resolve (expand-home (opt "--repos" "~/github/kotoba-lang")))
        amu      (path/resolve (opt "--amu" (path/join root ".." "amu")))
        only     (set (remove str/blank? (str/split (opt "--only" "") #",")))
        check?   (some #{"--check"} argv)
        logf     (opt "--log" nil)
        compat   (path/join root "lang" "compat")
        tmp      (fs/mkdtempSync (path/join (os/tmpdir) "compat-regen-"))
        out-rows (atom [])
        drift    (atom 0)
        fail     (atom 0)
        emit     (fn [& cols] (swap! out-rows conj (str (str/join "\t" cols) "\n")))]
    (doseq [line (str/split-lines (fs/readFileSync manifest "utf8"))
            :when (and (not (str/blank? line)) (not (str/starts-with? line "#")))
            :let [[ns twin repo sha p action note] (str/split line #"\t")]
            :when (or (empty? only) (contains? only ns))]
      (if (not= action "regen")
        (emit ns action "KEPT" "-" "-" note)
        (let [src (path/join tmp "src" repo p)
              _   (fs/mkdirSync (path/dirname src) #js {:recursive true})
              g   (run "git" ["-C" (path/join repos repo) "show" (str sha ":" p)] root)]
          (if (not= 0 (:status g))
            (do (swap! fail inc)
                (emit ns "regen" "BLOCKED" "-" "-" (str "git show " (subs sha 0 8) ":" p " in " repo " failed")))
            (let [_    (fs/writeFileSync src (:stdout g))
                  dst  (path/join compat twin)
                  out  (if check? (path/join tmp "out" twin) dst)
                  _    (fs/mkdirSync (path/dirname out) #js {:recursive true})
                  r    (run (path/join amu "bin" "amu") ["refactor" "to-kotoba" src "--out" out] amu)
                  txt  (str (.toString (:stdout r) "utf8") (.toString (:stderr r) "utf8"))
                  rc   (or (second (re-find #":rc (\{[^}]*\})" txt)) "-")
                  noarm (count (re-seq #":kind :rc-no-arm" txt))
                  ok?  (and (str/includes? txt ":ok true")
                            (str/includes? txt ":roundtrip {:parse true, :idempotent true}")
                            (fs/existsSync out))]
              (if (not ok?)
                (do (swap! fail inc)
                    (emit ns "regen" "REFUSED" rc noarm
                          (let [one (str/join " " (str/split (str/trim txt) #"\s+"))]
                            (subs one 0 (min 300 (count one))))))
                (let [same? (or (not check?)
                                (and (fs/existsSync dst)
                                     (.equals (fs/readFileSync dst) (fs/readFileSync out))))]
                  (when-not same? (swap! drift inc))
                  (emit ns "regen" (if same? "PASS" "DRIFT") rc noarm "-"))))))))
    (fs/rmSync tmp #js {:recursive true :force true})
    (let [text (apply str @out-rows)]
      (if logf (fs/writeFileSync logf text) (.write (.-stdout js/process) text)))
    (.exit js/process (cond (pos? @fail) 2 (and check? (pos? @drift)) 1 :else 0))))

(-main)
