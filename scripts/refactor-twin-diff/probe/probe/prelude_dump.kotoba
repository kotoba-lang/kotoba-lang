;; Differential probe for lang/compat/kotoba/compiler/refactor/prelude.kotoba (scripts/refactor-twin-diff/run.sh).
(ns probe.prelude-dump
  (:require [kotoba.compiler.refactor.prelude :as p]))

(defn- out [s :string] :i64 (let [r (typed-cap-call :io/write :string :string s)] 0))

(defn- dump-order [xs [:list :string] k :i64] :i64
  (if (>= k (vector-count xs))
    0
    (let [w (out (string-concat "O " (string-concat (typed-list-nth [:list :string] xs k) "\n")))]
      (dump-order xs (+ k 1)))))

(defn- dump-name [n :string] :i64
  (let [w1 (out (string-concat "H " (string-concat n (string-concat " " (string-concat (if (p/has? n) "1" "0") "\n")))))
        w2 (out (string-concat "T " (string-concat n (string-concat "\n" (string-concat (p/text-of n) "\nEND\n")))))]
    0))

(defn- dump-names [xs [:list :string] k :i64] :i64
  (if (>= k (vector-count xs))
    0
    (let [w (dump-name (typed-list-nth [:list :string] xs k))]
      (dump-names xs (+ k 1)))))

(defn main [] :i64
  (let [o (p/order)
        w0 (dump-order o 0)
        w1 (dump-names o 0)
        w2 (dump-name "nope")
        w3 (dump-name "")]
    0))
