;; Differential probe for lang/compat/kotoba/compiler/refactor/edit.kotoba (scripts/refactor-twin-diff/run.sh).
;; argv: edit <src-file> <scenario-file>. Prints what host_edit.cljs prints for the host edit.cljk.
;; Scenario lines: `E s e text rule ord` (text/rule one token, `~` is the empty string, `_` a space... see gen.py).
(ns probe.edit-dump
  (:require [kotoba.compiler.refactor.edit :as ed]
            [kotoba.string.split :as sp]))

(defn- argc [] :i64
  (let [s (typed-cap-call :cli/args :string :string "")]
    (loop [i 0 acc 0]
      (if (>= i (string-byte-length s)) acc (recur (+ i 1) (+ (* acc 10) (- (string-code-point-at s i) 48)))))))

(defn- arg [i :i64] :string (typed-cap-call :cli/args :string :string (string-from-i64 i)))
(defn- out [s :string] :i64 (let [r (typed-cap-call :io/write :string :string s)] 0))
(defn- i [n :i64] :string (string-from-i64 n))
(defn- sp3 [a :string b :string c :string] :string (string-concat a (string-concat " " (string-concat b (string-concat " " c)))))

(defn- digit-sum [s :string] :i64
  (let [neg (= (string-code-point-at s 0) 45)]
    (loop [k (if neg 1 0) acc 0]
      (if (>= k (string-byte-length s))
        (if neg (- 0 acc) acc)
        (recur (+ k 1) (+ (* acc 10) (- (string-code-point-at s k) 48)))))))

(defn- untok [t :string] :string
  (cond (string=? t "~") "" :else t))

(defn- field [parts [:list :string] k :i64] :string (typed-list-nth [:list :string] parts k))

(defn- read-edits [lines [:list :string] k :i64 acc [:list [:ref :edit/e]]] [:list [:ref :edit/e]]
  (if (>= k (vector-count lines))
    acc
    (let [parts (sp/split (field lines k) " ")]
      (if (and (>= (vector-count parts) 6) (string=? (field parts 0) "E"))
        (read-edits lines (+ k 1)
                    (ed/edits-conj acc (ed/make-edit (digit-sum (field parts 1)) (digit-sum (field parts 2))
                                                             (untok (field parts 3)) (untok (field parts 4))
                                                             (digit-sum (field parts 5)))))
        (read-edits lines (+ k 1) acc)))))

(defn- dump-list [tag :string xs [:list [:ref :edit/e]] k :i64] :i64
  (if (>= k (vector-count xs))
    0
    (let [x (ed/edits-nth xs k)
          w (out (string-concat (sp3 tag (i (ed/edit-s x)) (i (ed/edit-e x))) (string-concat " " (string-concat (i (ed/edit-ord x)) (string-concat " " (string-concat (ed/edit-text x) (string-concat " " (string-concat (ed/edit-rule x) "\n"))))))))]
      (dump-list tag xs (+ k 1)))))

(defn- pairs [xs [:list [:ref :edit/e]] a :i64 b :i64] :i64
  (let [n (if (< (vector-count xs) 14) (vector-count xs) 14)]
    (if (>= a n)
      0
      (if (>= b n)
        (pairs xs (+ a 1) (+ a 2))
        (let [x (ed/edits-nth xs a) y (ed/edits-nth xs b)
              w (out (string-concat (sp3 "C" (i a) (i b))
                                    (string-concat " " (string-concat (if (ed/conflicts? x y) "1" "0")
                                                                      (string-concat " " (string-concat (if (ed/nested? x y) "1" "0")
                                                                                                        (string-concat " " (string-concat (if (ed/nested? y x) "1" "0") "\n"))))))))]
          (pairs xs a (+ b 1)))))))

(defn- dump-starts [starts [:list :i64] k :i64] :i64
  (if (>= k (vector-count starts))
    0
    (let [w (out (string-concat "L " (string-concat (i (typed-list-nth [:list :i64] starts k)) "\n")))]
      (dump-starts starts (+ k 1)))))

(defn- dump-offsets [src :string starts [:list :i64] off :i64 step :i64] :i64
  (if (> off (string-byte-length src))
    0
    (let [w (out (string-concat "O " (string-concat (i off) (string-concat " " (string-concat (i (ed/offset->line starts off))
              (string-concat " [" (string-concat (ed/line-indent src off) "]\n")))))))]
      (dump-offsets src starts (+ off step) step))))

(defn- run [src-path :string scen-path :string] :i64
  (let [src (typed-cap-call :fs/app-data :string :string src-path)
        scen (typed-cap-call :fs/app-data :string :string scen-path)
        edits (read-edits (sp/split-lines scen) 0 (ed/edits-new))
        res (ed/resolve-conflicts edits)
        kept (ed/split-kept res)
        d1 (dump-list "K" kept 0)
        d2 (dump-list "D" (ed/split-dropped res) 0)
        d3 (pairs edits 0 1)
        w1 (out (string-concat "A " (string-concat (ed/apply-edits src kept) "\nEND\n")))
        starts (ed/line-starts src)
        d4 (dump-starts starts 0)
        d5 (dump-offsets src starts 0 1)]
    0))

(defn main [] :i64
  (if (< (argc) 3) 64 (run (arg 1) (arg 2))))
