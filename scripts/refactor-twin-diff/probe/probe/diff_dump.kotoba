;; Differential probe for lang/compat/kotoba/compiler/refactor/diff.kotoba (scripts/refactor-twin-diff/run.sh).
;; argv: diff <old-file> <new-file>. Prints what host_diff.cljs prints for the host diff.cljk.
(ns probe.diff-dump
  (:require [kotoba.compiler.refactor.diff :as df]))

(defn- argc [] :i64
  (let [s (typed-cap-call :cli/args :string :string "")]
    (loop [i 0 acc 0]
      (if (>= i (string-byte-length s)) acc (recur (+ i 1) (+ (* acc 10) (- (string-code-point-at s i) 48)))))))

(defn- arg [i :i64] :string (typed-cap-call :cli/args :string :string (string-from-i64 i)))
(defn- out [s :string] :i64 (let [r (typed-cap-call :io/write :string :string s)] 0))
(defn- i [n :i64] :string (string-from-i64 n))
(defn- sp [a :string b :string] :string (string-concat a (string-concat " " b)))

(defn- dump-regions [rs [:list [:ref :diff/r]] k :i64] :i64
  (if (>= k (df/regions-count rs))
    0
    (let [r (df/regions-nth rs k)
          w (out (string-concat (sp (sp (sp (sp "R" (i (df/r-as r))) (i (df/r-ae r))) (i (df/r-bs r))) (i (df/r-be r))) "\n"))]
      (dump-regions rs (+ k 1)))))

(defn- dump-unified [path :string old :string new :string ctx :i64] :i64
  (let [w (out (string-concat (string-concat "U " (string-concat (i ctx) "\n")) (string-concat (df/unified path old new ctx) "ENDU\n")))]
    0))

(defn- run [a-path :string b-path :string] :i64
  (let [old (typed-cap-call :fs/app-data :string :string a-path)
        new (typed-cap-call :fs/app-data :string :string b-path)
        la (df/split-lines old)
        lb (df/split-lines new)
        w0 (out (string-concat (sp (sp "S" (i (vector-count la))) (i (vector-count lb))) "\n"))
        d0 (dump-regions (df/regions la lb) 0)
        cl (df/changed-lines old new)
        w1 (out (string-concat (sp (sp "CL" (i (df/cl-removed cl))) (i (df/cl-added cl))) "\n"))
        u3 (dump-unified "/src/a.cljk" old new 3)
        u0 (dump-unified "x.cljk" old new 0)
        u1 (dump-unified "x.cljk" old new 1)]
    0))

(defn main [] :i64
  (if (< (argc) 3) 64 (run (arg 1) (arg 2))))
