;; measure-selfhost-distance.cljk — how far is the Kotoba compiler from being
;; built by Kotoba?
;;
;; `lang/q9-inventory.edn` counts `.cljc` paths: 25,919 of them, every one
;; `:classification-status :unclassified`. Counting paths is not measuring
;; distance. Nothing in this repository has ever asked the compiler whether it
;; can read, link and admit its own source, and "we plan to migrate" and "we
;; are N files away" are different claims.
;;
;; This asks. It walks the compiler's own classpath, runs the two gates that
;; come before any semantics — the reader, then `amu check` — and writes a
;; histogram of what each file was refused for.
;;
;;   kbb --backend sci measure-selfhost-distance.cljk --amu <amu checkout> --output <file.edn>
;;
;; The result is a scoreboard, not a verdict: a file that reads is not a file
;; that compiles, and a file that `check` admits is not a file whose semantics
;; survive. The gates are reported separately for that reason.
;;
;; nbb rather than kbb: this drives `amu` as a subprocess and walks a
;; filesystem, and the fs/process capability kits are not qualified on any
;; backend yet (`amu/resources/kotoba/lang/capability-kits/`). It is a
;; migration candidate under the kbb-first rule, not an exception to it.

(ns measure-selfhost-distance
  (:require ["node:fs" :as fs]
            ["node:path" :as path]
            ["node:child_process" :as cp]
            [kotoba.lang.text :as str]
            [cljs.pprint]
            [cljs.reader :as reader]
            [kotoba.compiler.kotoba-reader :as kr]
            [selfhost-native :as native]))

(def ^:private argv (vec (js->clj js/process.argv)))

(defn- opt [flag]
  (let [i (.indexOf (into-array argv) flag)]
    (when (nat-int? i) (nth argv (inc i) nil))))

(def ^:private amu-root (or (opt "--amu") (throw (js/Error. "--amu <checkout> is required"))))
(def ^:private output (or (opt "--output") (throw (js/Error. "--output <file.edn> is required"))))
(def ^:private nbb-cli (path/join amu-root "node_modules" "nbb" "cli.js"))
;; One path segment, spelled with a slash on purpose: the 2026-09-11 kbb text
;; cutover (kotoba-lang 8152ceb) rewrote the segment pair `"nbb" "wasm_cli.cljk"`
;; into `"kbb" "--backend" "sci" "wasm_cli.cljk"` -- a CLI invocation pattern
;; matched inside a path/join -- and every check gate then failed to spawn.
;; The directory under src/kotoba/compiler is `nbb/`; nothing here invokes nbb.
(def ^:private entry (path/join amu-root "src/kotoba/compiler/nbb/wasm_cli.cljk"))
;; The compat root, on the project route only: `lang/compat` of THIS
;; repository, which is where `clojure.set` (a template with a default
;; binding, 2026-09-11) and `clojure.string` / `clojure.core` live. Without it
;; every module that requires one of them is refused `required module is
;; missing from the explicit source paths`, which is a fact about the
;; measurement's source paths, not about the language.
(def ^:private compat-root
  (let [root (path/resolve (or (opt "--compat") "lang/compat"))]
    ;; The default is cwd-relative, and the documented invocation runs from
    ;; the amu checkout. Measured 2026-09-12: run from there without
    ;; `--compat`, every source path list carried a directory that does not
    ;; exist and ALL 225 sources came back `project path is not readable` --
    ;; a harness that could not run, answering in the same shape as a
    ;; compiler that refused 225 times. Refuse here instead.
    (when-not (and (fs/existsSync root) (.isDirectory (fs/statSync root)))
      (throw (js/Error. (str "compat root is not a directory: " root
                             " -- pass --compat <kotoba-lang>/lang/compat"))))
    root))

;; The capability grant the compiler holds when it runs (adr-2609242330 S5):
;; a module that names an ability -- `(env/read ...)`, `(io/write ...)` -- is
;; checked with the authority the compiler actually has, so its refusal on
;; the scoreboard is a language wall and not "the measurement granted
;; nothing". Default: lang/selfhost-compiler-grant.edn beside the compat root.
(def ^:private grant-path
  (let [p (path/resolve (or (opt "--grant") (path/join compat-root ".." "selfhost-compiler-grant.edn")))]
    (when-not (fs/existsSync p)
      (throw (js/Error. (str "grant policy is not a file: " p
                             " -- pass --grant <kotoba-lang>/lang/selfhost-compiler-grant.edn"))))
    p))

;; NAMED EXCEPTION, not a silent skip (adr-2609242330 S5, section 1 (c)).
;; amu's nbb mechanism layer -- the Node handlers of the compiler's
;; abilities, and loading / event loop / exit -- is the one place a host
;; module is required by string, and by design it is never Kotoba source:
;; compiler modules require it only under #?(:cljs ...), and under Kotoba the
;; same calls elaborate to typed-cap-call whose handler the target profile
;; supplies. Its files are listed in the output under :excluded with this
;; reason and are not counted as passed or refused.
(def ^:private mechanism-layer
  {:dir "src/kotoba/compiler/nbb/host"
   :reason "nbb/Node handlers of the compiler's abilities and the entry mechanism (adr-2609242330 S5, section 1 (c)); required only under #?(:cljs ...), never compiled as Kotoba"})

(defn- mechanism-layer? [file]
  (str/starts-with? (path/resolve file)
                    (str (path/resolve (path/join amu-root (:dir mechanism-layer))) "/")))

(defn- classpath []
  (let [r (cp/spawnSync js/process.execPath
                        (clj->js [nbb-cli "--classpath" (path/join amu-root "src")
                                  (path/join amu-root "scripts" "print-classpath.cljk") amu-root])
                        #js {:encoding "utf8" :cwd amu-root :maxBuffer (* 16 1024 1024)})]
    (when-not (zero? (.-status r))
      (throw (js/Error. (str "classpath resolution failed: " (.-stderr r)))))
    (->> (str/split (.-stdout r) #"\r?\n") (remove str/blank?) vec)))

(defn- cljc-under
  "Source files under dir. `.cljk` since adr-2609111500 (2026-09-11); `.cljc`
  is kept because the git-dep pins on the classpath are older shas whose trees
  still carry the old name. `.clj.cljk` / `.cljs.cljk` are the platform halves
  the rename could not merge; they end in `.cljk` too and are counted -- they
  are part of the authored surface whether or not they are portable."
  [dir]
  (if (fs/existsSync dir)
    (mapcat (fn [e]
              (let [p (path/join dir e)]
                (cond (.isDirectory (fs/statSync p)) (cljc-under p)
                      (or (str/ends-with? e ".cljk") (str/ends-with? e ".cljc")) [p]
                      :else [])))
            (fs/readdirSync dir))
    []))

(def ^:private dispatch-forms
  {:set #"#\{" :reader-conditional #"#\?\(" :splicing-reader-conditional #"#\?@"
   :regex "#\"" :discard #"#_" :js-literal #"#js" :var-quote #"#'"})

(defn- read-gate [source]
  (try (kr/read-forms source) {:gate :read :ok true}
       (catch :default e {:gate :read :ok false :reason (str (.-message e))})))

(defn- check-gate
  "Single-file `check`, and -- when source-roots are given -- the project
  route (`--source-path` per root), which is the route the compiler's own
  modules actually take. The single-file refusal
  `:namespace-require-needs-project` is the harness, not the language; the
  project route is what turns it into the real next refusal."
  [cp-str file & [source-roots]]
  (let [r (cp/spawnSync js/process.execPath
                        (clj->js (concat ["--stack-size=4096" nbb-cli "--classpath" cp-str entry "check" file
                                          "--policy" grant-path]
                                         (mapcat (fn [d] ["--source-path" d]) source-roots)))
                        #js {:encoding "utf8" :maxBuffer (* 32 1024 1024)})
        out (str (.-stdout r) (.-stderr r))]
    (if (zero? (.-status r))
      {:gate :check :ok true}
      {:gate :check :ok false
       :reason (or (second (re-find #":code (:[^,}\s]+)" out))
                   (second (re-find #":error (:[^,}\s]+)" out))
                   :unclassified)
       ;; An :unclassified refusal is the harness failing to READ the answer,
       ;; not the compiler refusing; keep status, signal and the head of what
       ;; came back so a whole-run nil (measured 2026-09-11: 181/181 nil while
       ;; the entry path was wrong) cannot pass as a histogram.
       ;; The module the refusal came from: the project route reports the
       ;; first module in the link closure that fails, so the same wall is
       ;; counted once per importer; :by-source folds it back to its origin.
       ;; That fold holds only where amu attributes the refusal; for a
       ;; module-header refusal it did not until 2026-09-25 (see
       ;; :by-refusing-module).
       :source (second (re-find #":source \"([^\"]+)\"" out))
       :message (or (second (re-find #":message \"([^\"]{0,120})" out))
                    (str "UNCLASSIFIED status=" (.-status r) " signal=" (.-signal r) " "
                         (subs (str/replace out #"\s+" " ") 0 (min 400 (count out)))))})))

(defn- histogram [rows k]
  (->> rows (remove :ok) (map k) frequencies (sort-by val >) (into [])))

;; ---------------------------------------------------------------------------
;; Reachability: which sources the compiler's own entry points pull in.
;;
;; adr-2609242330 §4: the selfhost target is the closure of amu's
;; `kotoba.compiler.nbb.*_cli` entry points, not the whole classpath (security's
;; JVM tools, kotoba-component's composition/doctor and amu's ipld_adl are on
;; the classpath but are not the compiler). The scoreboard is therefore split
;; into :reachable and :unreachable; the classpath-wide totals stay as they
;; were so history is comparable.
;;
;; LIMITATION (stated in the output as well): the walk follows only the
;; `(:require ...)` entries the Kotoba reader sees -- feature `:kotoba`, else
;; `:default`. A require that lives only inside `#?(:clj ...)` / `#?(:cljs ...)`,
;; a string require (`["node:fs" ...]`), and a module started as a separate
;; script (e.g. `nbb/classpath.cljk` spawned by the CLI) are NOT followed, so
;; the closure is a lower bound of what the compiler runs.
;;
;; Deterministic: entries are the sorted list of `src/kotoba/compiler/nbb/*_cli.cljk`
;; under the amu checkout; a namespace defined by several source files (`.cljc`
;; and `.cljk` twins, `.clj.cljk` halves) reaches all of them; the result is sorted.

(def ^:private entry-glob "<amu>/src/kotoba/compiler/nbb/*_cli.cljk")

(defn- entry-files []
  (let [dir (path/join amu-root "src/kotoba/compiler/nbb")]
    (->> (fs/readdirSync dir) (map str)
         (filter #(str/ends-with? % "_cli.cljk"))
         sort
         (mapv #(path/join dir %)))))

(defn- ns-and-requires
  "[ns-symbol #{required ns symbols}] of SOURCE as the Kotoba reader sees it,
  or nil when the file does not read or has no ns form."
  [source]
  (try
    (let [forms (kr/read-forms source)
          nsf (first (filter #(and (seq? %) (= 'ns (first %))) forms))]
      (when nsf
        [(second nsf)
         (->> (rest nsf)
              (filter seq?)
              (filter #(= :require (first %)))
              (mapcat rest)
              (keep (fn [spec] (let [n (if (vector? spec) (first spec) spec)]
                                 (when (symbol? n) n))))
              set)]))
    (catch :default _ nil)))

(defn- reachable-set
  "Set of source files reachable from ENTRIES through Kotoba-visible requires."
  [sources entries]
  (let [info (into {} (map (fn [f] [f (ns-and-requires (fs/readFileSync f "utf8"))]) sources))
        by-ns (reduce (fn [m [f [n _]]] (if n (update m n (fnil conj []) f) m)) {} info)]
    (loop [seen #{} todo (vec (sort entries))]
      (if (empty? todo)
        seen
        (let [f (peek todo) todo (pop todo)]
          (if (seen f)
            (recur seen todo)
            (recur (conj seen f)
                   (into todo (sort (mapcat by-ns (second (get info f))))))))))))

(defn- gate-summary [rows]
  {:passed (count (filter :ok rows))
   :refused (count (remove :ok rows))
   :by-reason (histogram rows :reason)
   :by-message (->> rows (remove :ok) (map :message) frequencies (sort-by val >) (take 25) (into []))
   :by-source (->> rows (remove :ok) (keep :source) frequencies (sort-by val >) (take 25) (into []))
   ;; Two views of one wall (adr-2609242330 S5, 2026-09-25). :rows is the
   ;; per-importer count -- every checked file whose closure hits the wall,
   ;; the number :by-message has always carried, so history stays comparable.
   ;; :modules is the per-refusing-module view: the distinct `:source` labels
   ;; (file basenames) amu attributed the refusal to. Before amu attributed a
   ;; module HEADER refusal (a string host import, a malformed :require) to
   ;; that module, `:source` named the ROOT file, so :modules equalled the
   ;; importers; from the amu commit that attributes it, :modules names the
   ;; module that actually refused. A basename can name two files (io.cljk);
   ;; the label is what the CLI prints.
   :by-refusing-module (->> rows (remove :ok) (group-by :message)
                            (map (fn [[m rs]] [m {:rows (count rs)
                                                  :modules (->> rs (keep :source) distinct sort vec)}]))
                            (sort-by (fn [[_ v]] (- (:rows v))))
                            ;; Every wall, not the top 25: a wall that falls
                            ;; to one or two rows must stay visible.
                            (into []))
   :passed-files (->> rows (filter :ok) (map :file) sort vec)})

(defn- measure-stage-1
  "Stage 1 (read, single-file check, project check, reachability) over the
  whole classpath -- the v2 result map, unchanged."
  [cp-entries cp-str]
  (let [all-sources (->> (conj (filterv #(str/ends-with? % "/src") cp-entries)
                             (path/join amu-root "src"))
                       (mapcat cljc-under) sort vec)
      excluded (filterv mechanism-layer? all-sources)
      sources (filterv (complement mechanism-layer?) all-sources)
      _ (println "sources:" (count sources) "excluded (mechanism layer):" (count excluded))
      reads (mapv (fn [f] (assoc (read-gate (fs/readFileSync f "utf8")) :file f)) sources)
      checks (mapv (fn [f] (assoc (check-gate cp-str f) :file f)) sources)
      source-roots (-> (filterv #(str/ends-with? % "/src") cp-entries)
                       (conj (path/join amu-root "src"))
                       (conj compat-root))
      project-checks (mapv (fn [f] (assoc (check-gate cp-str f source-roots) :file f)) sources)
      entries (entry-files)
      reach (reachable-set sources entries)
      _ (println "reachable from" (count entries) "entries:" (count reach) "/" (count sources))
      amu-rel #(str/replace % (path/resolve amu-root) "<amu>")
      census (reduce (fn [acc [k re]]
                       (assoc acc k (count (filterv (fn [f] (re-find (re-pattern re) (fs/readFileSync f "utf8")))
                                                    sources))))
                     {} dispatch-forms)
      result {:kotoba.lang.selfhost/version 2
              ;; v2 additions (2026-09-25, adr-2609242330 S5): :grant (the
              ;; policy both check routes pass) and :excluded (the named
              ;; mechanism-layer exception); :reachable / :unreachable carry
              ;; :passed-files.
              :grant {:path (str/replace grant-path (path/resolve compat-root ".." "..") "<kotoba-lang>")
                      :text (fs/readFileSync grant-path "utf8")}
              :excluded {:mechanism-layer (assoc mechanism-layer
                                                 :files (mapv amu-rel excluded)
                                                 :count (count excluded))}
              ;; v2 (2026-09-24, adr-2609242330 S0): adds :reachability,
              ;; :reachable and :unreachable (the project-check gate split by the
              ;; entry closure) and :source per refusal. Every v1 key is kept with
              ;; its v1 meaning, so the classpath-wide totals stay comparable.
              :measured-at (subs (.toISOString (js/Date.)) 0 10)
              :plane :authored-input
              :question "Can the Kotoba compiler read, link and admit its own SOURCE TEXT?"
              :identity-authority "kotoba-lang/kotoba-lang lang/code-identity.edn"
              :does-not-measure
              ["Distance to self-hosting. Identity in this language is the
                definition CID -- typed KIR, effect row, interface and direct
                dependency CIDs -- and `:source-tree-cid` is `:not-implemented`
                and proves `:authored-input` only. This file measures that
                authored-input surface."
               "The interchange unit. `lang/definition-patch.edn` sets it to
                `:definition-cid-ops-and-name-mappings`, explicitly `:not`
                `:source-file-copy` / `:source-tree-bytes` / `:source-tree-cid`."
               "Whether a native binary can be produced without a source tree.
                It already can: `amu module-lock` then `amu compile
                --module-lock --blocks --target aarch64-macos --jvm-free`
                builds from content-addressed blocks alone (measured
                2026-09-08, artifact executed, answered 42)."]
              :amu-commit (let [r (cp/spawnSync "git" (clj->js ["-C" amu-root "rev-parse" "HEAD"])
                                                #js {:encoding "utf8"})]
                            (str/trim (str (.-stdout r))))
              :pins (into (sorted-map)
                          (keep (fn [e]
                                  (when-let [m (re-find #"/io\.github\.kotoba-lang/([^/]+)/([0-9a-f]{40})/" e)]
                                    [(nth m 1) (nth m 2)]))
                                cp-entries))
              :source-count (count sources)
              :line-count (reduce + (map (fn [f] (count (str/split (fs/readFileSync f "utf8") #"\n"))) sources))
              :read-gate {:passed (count (filter :ok reads))
                          :refused (count (remove :ok reads))
                          :by-reason (histogram reads :reason)}
              :check-gate {:passed (count (filter :ok checks))
                           :refused (count (remove :ok checks))
                           :by-reason (histogram checks :reason)}
              :project-check-gate {:route "amu check <file> --source-path <every src root on the classpath> --source-path lang/compat"
                                   :passed (count (filter :ok project-checks))
                                   :refused (count (remove :ok project-checks))
                                   :by-reason (histogram project-checks :reason)
                                   :by-message (->> project-checks (remove :ok) (map :message) frequencies (sort-by val >) (take 25) (into []))
                                   :passed-files (->> project-checks (filter :ok) (map (comp amu-rel :file)) sort vec)}
              :reachability {:entries-glob entry-glob
                             :entries (mapv amu-rel entries)
                             :follows "(:require ...) symbols the Kotoba reader sees (feature :kotoba, else :default)"
                             :limitation ["Requires only inside #?(:clj ...) or #?(:cljs ...) are not followed."
                                          "String requires (host modules) are not followed."
                                          "Modules started as separate scripts (e.g. nbb/classpath.cljk spawned by the CLI) are not followed."
                                          "The closure is therefore a lower bound of what the compiler runs."]
                             :reachable-count (count reach)
                             :unreachable-count (- (count sources) (count reach))}
              :reachable (let [rows (filterv #(reach (:file %)) project-checks)]
                           (assoc (update (gate-summary rows) :passed-files #(mapv amu-rel %))
                                  :route :project-check-gate
                                  :source-count (count rows)
                                  :files (->> rows (map (comp amu-rel :file)) sort vec)))
              :unreachable (let [rows (filterv #(not (reach (:file %))) project-checks)]
                             (assoc (update (gate-summary rows) :passed-files #(mapv amu-rel %))
                                    :route :project-check-gate
                                    :source-count (count rows)))
              :dispatch-census census
              :not-established
              ["A file that reads is not a file that compiles."
               "A file that `check` admits is not a file whose semantics survive lowering."
               "`check` is run per file. A file that declares (:require ...) is refused as needing a project; that refusal is this harness's single-file mode, not a language gap."]}]
  (println "read gate  :" (:passed (:read-gate result)) "/" (count sources))
  (println "check gate :" (:passed (:check-gate result)) "/" (count sources))
  (println "project    :" (:passed (:project-check-gate result)) "/" (count sources)
           " reachable" (:passed (:reachable result)) "/" (:source-count (:reachable result))
           " unreachable" (:passed (:unreachable result)) "/" (:source-count (:unreachable result)))
  result))

;; ---------------------------------------------------------------------------
;; Stages 2 and 3 (v3, 2026-09-26): native compile and native differential
;; execution, for every module stage 1 admitted. See scripts/selfhost_native.cljk.
;;
;;   --reuse-stage1 <selfhost-distance.edn>  take stage 1 from a committed
;;       file instead of re-running it (60-90 min). Refused unless its
;;       :amu-commit is the --amu checkout's HEAD: stage 1 of another compiler
;;       is not stage 1 of this one.
;;   --no-native                skip stages 2 and 3 (the output then says so)
;;   --native-only <a,b>        stage 2/3 only for stage-1 passes whose label
;;                              ends with one of these (red proofs, debugging)
;;   --substitute <file>=<copy> compile <copy> natively in place of <file>
;;                              (the host still reads <file>) -- the red proofs
;;   --native-work <dir>        where kexe / bin / loaders go (default: mkdtemp)
;;   --seed <n> --random <n>    stage-3 generator seed and random cases per fn

(defn- opts [flag]
  (keep-indexed (fn [i a] (when (and (= a flag) (< (inc i) (count argv))) (nth argv (inc i)))) argv))

(defn- git-head [dir]
  (str/trim (str (.-stdout (cp/spawnSync "git" (clj->js ["-C" dir "rev-parse" "HEAD"]) #js {:encoding "utf8"})))))

(defn- reused-stage-1 [file]
  (let [m (reader/read-string (fs/readFileSync file "utf8"))
        head (git-head amu-root)]
    (when-not (= (:amu-commit m) head)
      (println "REFUSE stage-1 reuse: file measured amu" (:amu-commit m) "but --amu is at" head)
      (js/process.exit 2))
    (when-not (seq (get-in m [:project-check-gate :passed-files]))
      (println "REFUSE stage-1 reuse: no :project-check-gate :passed-files in" file)
      (js/process.exit 2))
    m))

(let [cp-entries (classpath)
      cp-str (str/join ":" (conj cp-entries (path/join amu-root "src")))
      reuse (opt "--reuse-stage1")
      stage-1 (if reuse (reused-stage-1 reuse) (measure-stage-1 cp-entries cp-str))
      unlabel #(str/replace % "<amu>" (path/resolve amu-root))
      label #(str/replace % (path/resolve amu-root) "<amu>")
      passed (mapv unlabel (get-in stage-1 [:project-check-gate :passed-files]))
      reach-passed (set (map unlabel (get-in stage-1 [:reachable :passed-files])))
      only (some-> (opt "--native-only") (str/split #","))
      files (if only (filterv (fn [f] (some #(str/ends-with? (label f) %) only)) passed) passed)
      substitute (into {} (map (fn [s] (let [i (.indexOf s "=")]
                                         [(path/resolve (subs s 0 i)) (path/resolve (subs s (inc i)))]))
                               (opts "--substitute")))
      source-roots (-> (filterv #(str/ends-with? % "/src") cp-entries)
                       (conj (path/join amu-root "src"))
                       (conj compat-root))
      native? (not (some #{"--no-native"} argv))
      stages (when native?
               (println "stages 2/3 over" (count files) "stage-1 passes")
               (native/measure {:amu-root (path/resolve amu-root) :cp-str cp-str :source-roots source-roots
                                :grant grant-path :label label :reachable? reach-passed
                                :substitute substitute
                                :work (or (opt "--native-work") (native/tmp-work))
                                :seed (js/parseInt (or (opt "--seed") "20260926") 10)
                                :n-random (js/parseInt (or (opt "--random") "16") 10)}
                              files))
      top (fn [k]
            (let [s1 (get-in stage-1 [k :passed])
                  of (get-in stage-1 [k :source-count])
                  s2 (when stages (get-in stages [:native-compile k :stage2 :ok]))
                  s3 (when stages (get-in stages [:native-differential k :stage3 :ok]))]
              {:sources of :stage1 s1 :stage2 s2 :stage3 s3}))
      result (cond-> (assoc stage-1
                            :kotoba.lang.selfhost/version 3
                            :native-measured-at (when native? (subs (.toISOString (js/Date.)) 0 10))
                            :stage-1-provenance (if reuse
                                                  {:reused-from (path/basename reuse)
                                                   :measured-at (:measured-at stage-1)
                                                   :amu-commit (:amu-commit stage-1)}
                                                  {:measured :this-run})
                            :stages
                            {1 "amu check admits the module on the project route (:project-check-gate)"
                             2 "the module compiles as a native library for aarch64 AND x86_64, and the kotoba-verifier (extract-native) admits every export (:native-compile)"
                             3 "every export, driven through tools/kexe_loader.c with generated boundary + seeded random inputs, answers what the module's host (nbb) reading answers, on every stage-2 isa (:native-differential)"}
                            :top-line {:reachable (top :reachable) :unreachable (top :unreachable)})
               stages (assoc :native-compile (:native-compile stages)
                             :native-differential (:native-differential stages)
                             :native-scope (if only {:partial only :substitute (into {} (map (fn [[a b]] [(label a) b]) substitute))} :all-stage-1-passes))
               (not stages) (assoc :native-compile :not-run :native-differential :not-run))
      tl (:reachable (:top-line result))]
  (fs/writeFileSync output (with-out-str (cljs.pprint/pprint result)))
  (println (str "SCANNED\t" (if stages (:scanned stages) 0)))
  (println "reachable: stage1" (:stage1 tl) "/ stage2" (if stages (:stage2 tl) "NOT-RUN")
           "/ stage3" (if stages (:stage3 tl) "NOT-RUN") "(of" (:sources tl) "reachable sources)")
  (let [u (:unreachable (:top-line result))]
    (println "unreachable: stage1" (:stage1 u) "/ stage2" (:stage2 u) "/ stage3" (:stage3 u)))
  (println "wrote" output))
