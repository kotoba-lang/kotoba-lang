;; kotoba.test is clojure.test's surface forwarded to the host runner
;; (kotoba-lang/test src/kotoba/test.cljk: each macro expands to the host macro
;; of the same name with the same arguments). clj-kondo does not expand it, so
;; without this every deftest name, `thrown?` and `are` binding was reported as
;; an unresolved symbol: 514 errors from the day test/ moved to kotoba.test
;; (beb40e1, 2026-09-24), and `clojure -M:lint` has been red since.
;; `lint-as` gives the macros clojure.test's shapes; `thrown?` /
;; `thrown-with-msg?` are special only inside clojure.test/is itself, so they
;; are excluded inside kotoba.test/is by name.
{:lint-as {kotoba.test/deftest clojure.test/deftest
           kotoba.test/is clojure.test/is
           kotoba.test/are clojure.test/are
           kotoba.test/testing clojure.test/testing
           kotoba.test/use-fixtures clojure.test/use-fixtures
           kotoba.test/async cljs.test/async}
 :linters {:unresolved-symbol
           {:exclude [(kotoba.test/is [thrown? thrown-with-msg?])]}}
 ;; state_conformance_test.cljk (2f1cbaf) carries reader conditionals, so it
 ;; is linted as .cljc (cljk-origin.edn :lint-languages), and its unconditional
 ;; `slurp` is JVM-only there. The suite runs on the JVM; the file says so.
 :config-in-ns {kotoba.lang.state-conformance-test
                {:linters {:unresolved-symbol {:exclude [slurp]}}}}}
