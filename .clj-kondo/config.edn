;; Consumer copy of kotoba-lang/test's lint-as table, plus the
;; clojure.test-compatible surface this repo actually requires
;; (`[kotoba.test :refer [deftest is testing]]` since beb40e1).
;; kotoba-lang/test .clj-kondo/config.edn maps kotoba.lang.test/*;
;; call sites here use kotoba.test. Both shapes are listed.
;;
;; :lint alias uses :replace-deps, so clj-kondo never sees kotoba.test
;; source. Without this map, every deftest name is "unresolved symbol".
{:lint-as
 {kotoba.test/deftest clojure.test/deftest
  kotoba.test/is clojure.test/is
  kotoba.test/testing clojure.test/testing
  kotoba.test/are clojure.test/are
  kotoba.test/run-tests clojure.test/run-tests
  kotoba.test/use-fixtures clojure.test/use-fixtures
  kotoba.lang.test/deftest clojure.test/deftest
  kotoba.lang.test/is clojure.test/is
  kotoba.lang.test/testing clojure.test/testing
  kotoba.lang.test/are clojure.test/are}
 ;; clj-kondo wires (is (thrown? ...)) to the literal clojure.test/is var,
 ;; not to :lint-as targets. Same exclusion kotoba-lang/test ships.
 :linters {:unresolved-symbol {:exclude [thrown? thrown-with-msg?]}}}
