{:schema "kotoba.repository-role-rules.v0"
 :this-repo
 {:name "kotoba-lang"
  :tier :t1
  :role :library
  :must-not [:compile :execute-components :grant-runtime-authority]
  :depends-on ["kotoba-lang/io-multiformats"
               "kotoba-lang/org-ietf-ed25519"
               "kotoba-lang/kotoba-core-contracts"
               ;; Real production dependency (kotoba.lang.release-admission
               ;; consumes the central security controls). Declaring it makes a
               ;; genuine responsibility inversion visible instead of hiding it
               ;; by omission: this repo is T1 :library and security is T4
               ;; :assurance, and ADR-2607266000 lists assurance as a
               ;; dependency of T3 execution, not of T1 language libraries.
               ;; Recorded as :library->assurance in the :exceptions of the
               ;; workspace authority (root manifest/repository-rules.edn)
               ;; pending an owner decision. ADR-2607299000.
               "kotoba-lang/security"]}}
