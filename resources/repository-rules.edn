{:schema "kotoba.repository-role-rules.v0"
 :this-repo
 {:name "kotoba-lang"
  :tier :t1
  :role :library
  :must-not [:compile :execute-components :grant-runtime-authority]
  :depends-on [;; Not a source-level require: no namespace under `src` names
               ;; cbor. It is a deliberate co-pin -- DefCID's canonical block
               ;; is encoded inside kotoba-kir, and pinning the same codec sha
               ;; at the top level is what keeps this identity layer and
               ;; codebase's byte-for-byte agreed rather than letting a
               ;; transitive pin choose. It is in :deps and on the shipped
               ;; classpath, so it is declared.
               "kotoba-lang/dag-cbor"
               "kotoba-lang/kotoba-core-contracts"
               ;; `kotoba.lang.code-identity` is now a facade over
               ;; `kotoba.kir.definition-identity`; e0ea505 made that move and
               ;; swapped io-multiformats out of deps.edn for kotoba-kir
               ;; without touching this list, which is why io-multiformats
               ;; stood here for three days after it stopped being a
               ;; dependency at all.
               "kotoba-lang/kotoba-kir"]}}
