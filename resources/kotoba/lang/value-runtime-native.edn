{:kotoba.value-runtime-native/format :v1
 :authority "kotoba-lang/kotoba-lang"
 :semantic-abi :kotoba.value-runtime/v1
 :value-codec :kotoba.value.v1
 :identity {:value-cid {:cid-version 1 :codec :dag-cbor :hash :sha2-256}
            :runtime-handle {:representation :positive-i64
                             :zero :invalid
                             :capacity 4096
                             :reuse :never}
            :capability {:representation :aiueos-domain-owned-handle
                         :not-derived-from [:value-cid :runtime-handle]}}

 :operations
 {:value/intern {:request :canonical-value-bytes
                 :response :runtime-handle
                 :authority {:effect :object/put-block :compiler-wire-id 15}
                 :order [:validate-canonical :derive-value-cid
                         :authorize-put-block :persist-verified-block
                         :install-local-handle]}
  :value/hydrate {:request :value-cid-text
                  :response :runtime-handle
                  :authority {:effect :object/get-stream :compiler-wire-id 14}
                  :order [:validate-cid :authorize-get-stream :read-bounded-block
                          :verify-cid :validate-canonical :install-local-handle]}
  :value/resolve {:request :runtime-handle
                  :response :canonical-value-bytes
                  :authority :process-local}
  :value/cid-of {:request :runtime-handle
                 :response :value-cid-text
                 :authority :process-local}
  :value/release {:request :runtime-handle
                  :response :released
                  :authority :process-local}}

 :production-native
 {:execution-surface :aiueos-c-free-bare-metal-v1
  :artifact-target :x86_64-aiueos-user-v1
  :entry-contract :kotoba-sysv-context-r9-aiueos-runtime-v2
  :transport :typed-capability-syscall
  :syscall-number 5
  :capability-handle-offset 80
  :handle-table-owner :cpl3-process
  :handle-arena {:page-bytes 4096
                 :permissions [:read :write :no-execute]
                 :physical-slot-capacity 63
                 :logical-handle-maximum 4096
                 :synchronization :kotoba-kernel-compare-exchange-u32
                 :native-export "kotoba_aiueos_value_handle_arena"}
  :typed-dispatch {:request-bytes 96
                   :capability-table-bytes 4096
                   :trusted-profile [:arena-length :request-length
                                     :capability-table-length :current-domain]
                   :native-export "kotoba_aiueos_value_runtime_dispatch"
                   :provider-routes {:value/intern 15 :value/hydrate 14}}
  :normalized-entry {:raw-envelope-bytes 104
                     :user-page-bytes 4096
                     :request-offset-maximum 3992
                     :copy-range [0 56]
                     :expected-digest-range [24 56]
                     :capability-handle-range [56 64]
                     :raw-zero-range [64 104]
                     :normalized-zero-range [56 96]
                     :native-export "kotoba_aiueos_value_runtime_entry"}
  :sealed-provider-transport
  {:queue {:region :kernel-image-private :offset 1024 :bytes 512
           :slots 7 :slot-bytes 64
           :states [:free :pending :claimed]
           :ticket {:type :u32 :zero :invalid :reuse :never
                    :exhaustion :fail-closed}}
   :submit-owner :normalized-dispatch
   :claim-export "kotoba_aiueos_value_runtime_provider_claim"
   :complete-export "kotoba_aiueos_value_runtime_provider_complete"
   :expected-digest {:source :normalized-user-request :range [16 48]}
   :cas-scratch {:offset 1536 :bytes 384}
   :completion-match [:ticket :route :trusted-domain :sha2-256-digest]
   :user-completion :forbidden
   :request-bound-digest-verification :implemented
   :canonical-value-validation :pending}
  :cas-digest-verifier {:algorithm :sha2-256 :minimum-block-bytes 1
                        :maximum-block-bytes 12288 :digest-bytes 32
                        :native-export "kotoba_aiueos_value_runtime_cas_verify"
                        :request-bound true :canonical-value-validation false}
  :persistent-provider-owner :aiueos-capability-broker
  :hosted-context-callbacks :forbidden
  :c-loader-qualification :forbidden
  :foreign-code-receipt {:c-sources []
                         :foreign-objects []
                         :imports []
                         :dynamic-dependencies []}}

 :admission
 {:native :deny-until-qualified
  :required-evidence [:exact-kir-descriptors
                      :independent-verifier-rederivation
                      :bounded-rw-nx-handle-arena
                      :capability-owner-rights-generation-checks
                      :canonical-cid-positive-vector
                      :forged-handle-negative-vector
                      :cid-mismatch-negative-vector
                      :revoked-capability-negative-vector
                      :qemu-cpl3-semantic-vector
                      :empty-foreign-code-receipt]}

 :implementation-status
 {:reference-host :implemented
 :core-wasm-transport :implemented
  :aiueos-handle-arena-object :implemented
  :aiueos-c-free-normalized-dispatch :implemented
  :aiueos-c-free-entry-normalization :implemented
  :aiueos-c-free-kernel-image-link :implemented
  :aiueos-c-free-syscall-return-admission :implemented
  :aiueos-c-free-gdt-tss-kernel-stack :implemented
  :aiueos-c-free-scheduler-domain-publication :implemented
  :aiueos-c-free-capability-table-mutation :implemented
  :aiueos-c-free-provider-generation-policy :implemented
  :aiueos-live-entry-assembly :implemented
  :aiueos-sealed-provider-transport :implemented
  :aiueos-cas-digest-primitive :implemented
  :aiueos-request-bound-cas-digest :implemented
  :aiueos-cpl3-provider :pending}}
