{:kotoba.lang.guest-grammar/version 2
 :kotoba.lang.guest-grammar/profile-version 6
 :kotoba.lang.guest-grammar/status :p0-p1-in-progress
 :kotoba.lang.guest-grammar/authority "kotoba-lang/kotoba-lang"
 :kotoba.lang.guest-grammar/adr "adr-2607183900-kotoba-component-language-runtime-roles"
 :kotoba.lang.guest-grammar/transport-adr "adr-2607184000-kotoba-transport-provider-components"
 :kotoba.lang.guest-grammar/migration-adr "adr-2607279200-kotoba-clojure-shaped-safety-elaboration-migration"
 :kotoba.lang.guest-grammar/elaboration-pipeline "lang/elaboration-pipeline.edn"
 :kotoba.lang.guest-grammar/surface-status "lang/surface-status.edn"
 :kotoba.lang.guest-grammar/scope
 "Least-authority component grammar profile. The historical key name guest-grammar does not make .kotoba guest-only; provider components use the same admitted grammar plus declared imports."
 :kotoba.lang.guest-grammar/invariant
 "Expressiveness grows only via desugar to existing primitives or declared capability kits — never via ambient Clojure (host eval/require/atom/macros/interop)."

 :function-semantics
 {:named-multi-arity {:status :implemented-partial
                      :backends #{:compiler :kotoba-wasm :kotoba-cljs}
                      :arities {:min 0 :max 5}
                      :lowering "deterministic $arityN static function names"
                      :supports #{:direct-call :recursion :hof-callback :no-init-reduce}
                      :variadic "[fixed ... & rest] statically specialized through arity 5"
                      :abi-bound {:max-arity 5 :disposition :intentional-security-constraint}
                      :missing #{}}}

 :callable-type
 {:syntax "[:fn [parameter-types result-type] ...]"
  :clauses {:min 1 :max 5 :unique-by :arity}
  :arity {:min 0 :max 4}
  :parameter-types #{:i64}
  :result "one admitted non-callable, non-linear closure dispatcher result type"
  :physical-abi :i64
  :level "L3"
  :backends #{:compiler :kotoba-kir :restricted-esm :wasm32}
  :module-boundary :project-interface-preserved
  :note "Public source contract only: KIR/Wasm closure words remain i64 and carry checked closure refinements. Project linking assigns disjoint module lambda-ID ranges and routes through one bounded dispatcher per arity/result family; no synthetic fallback handle or ambient dynamic dispatch is admitted."}

 ;; P0 strict-grammar (ADR-2607180900): default ON for safe emit/run.
 ;; Unknown call heads not in admitted sets fail closed with a catalog hint.
 :strict-grammar
 {:default true
  :policy-key :kotoba.policy/strict-grammar
  :note "Set :kotoba.policy/strict-grammar false only for experimental hosts adding temporary surface before catalog update."}

 ;; Forms that survive to backends after desugar (core KIR / wasm core).
 :core-special-forms
 #{ns def defn defprotocol definterface defrecord extend-type extend-protocol let if do main}

 ;; The SHAPE each core form has after desugaring, and what a consumer that
 ;; reads it must do when it sees another shape.
 ;;
 ;; This is here because "one body form" used to be an assumption rather than a
 ;; rule. Six passes in the frontend destructured `(let [bindings body] ...)`,
 ;; two of them REBUILT the form from `body` alone, and the validator then
 ;; measured the already-shortened form and admitted it. Measured 2026-09-02
 ;; against amu b1fdaad2:
 ;;
 ;;   (defn run [n :i64] :i64 (let [x (+ n 1)] (+ x 10) (+ x 100)))
 ;;     -> :ok true, wasm32 answers 16   (should be 106)
 ;;   (defn run [n :i64] :i64 (if (> n 0) (+ n 10) (+ n 100) (+ n 1000)))
 ;;     -> :ok true, wasm32 answers 15   (should not compile)
 ;;
 ;; Truncating a form is never an admitted response to an unexpected shape: the
 ;; result is a shorter program that compiles clean. Refuse, or sequence.
 :core-form-shapes
 {:let {:arity 2
        :shape "(let BINDINGS BODY)"
        :body-forms 1
        :source-body :implicit-do
        :collapse do
        :never-collapse-to "nested let"
        :why-not-nested-let
        "A non-final body form encoded as a `let` binding is an UNUSED binding, and an unused binding is exactly what a later pass may drop. The forms that must survive are the effectful ones -- a kernel store, a cap-call. `do` is kept first-class through desugaring for this reason."
        :on-other-shape :refuse
        :refusal-codes {:several-body-forms :kotoba.error/let-body-multiple-forms
                        :empty-body :kotoba.error/let-body-empty}}
  :if {:arity 3
       :shape "(if TEST THEN ELSE)"
       :on-other-shape :refuse
       :refusal-codes {:wrong-arity :kotoba.error/if-arity}
       :note "No one-armed `if`. `when` / `when-not` supply the missing arm during desugaring."}
  :do {:arity :one-or-more
       :shape "(do FORM ...)"
       :value :last-form
       :on-other-shape :refuse
       :refusal-codes {:empty-body :kotoba.error/do-empty}}
  ;; The module constant. Until 2026-09-11 VALUE had to be a closed LITERAL
  ;; (integer / string / keyword / boolean / nil / vector / map / non-empty
  ;; keyword set), and `(def k (* 4 1024))` was refused `constant value must
  ;; be closed bounded integer/string/...` -- a sentence about closedness for
  ;; a value that is closed, only not yet spelled out. Measured 2026-09-11 at
  ;; amu a406845e (lang/selfhost-distance.edn, project route): 9 of the
  ;; compiler's own 210 sources were refused at such a def, every one a pure
  ;; expression over constants -- (set [...]), (into #{} ...), (str ...),
  ;; (merge a b), (* 4 1024).
  ;;
  ;; CLASSIFICATION (CLAUDE.md, "is it a property or implementation state"),
  ;; written before the change: the literal-only rule was IMPLEMENTATION
  ;; STATE. Nothing in this file, surface-status or safety-claims says a
  ;; module constant must be spelled as a literal; what they forbid at module
  ;; level is AMBIENT STATE and EFFECTS. That half is a property and stays
  ;; refused -- by its own name, not with the closedness sentence.
  :def {:shape "(def NAME DOCSTRING? VALUE)"
        :arity {:min 2 :max 3}
        :value {:literal "a closed literal, as before: integer, f64, string (portable byte bound), keyword, boolean, nil, a vector / map of literals, a non-empty keyword set, a type alias, or the name of another constant (an alias, acyclic)"
                :computed "a call form, or a vector / map / set literal holding one: analysed as a one-function probe module over the constants defined ABOVE it, required to have an EMPTY effect row, executed ONCE at analysis time on the reference interpreter (kotoba.kir/execute) under the KIR constant oracle's fuel (100000), and the RESULT is recorded as the constant -- spelled back as the literal the author could have written, or as the canonical constructor (typed-set-new / typed-map-new, items in the interpreter's canonical order) when the language has no literal for that value. From there the definition takes exactly the literal's path (substitution before desugaring), so (def k 4096) and (def k (* 4 1024)) are the same constant and mint the same definition CIDs for every function that reads them, and the constant's type is the type the literal's own inference gives it"
                :constructor-forms "(typed-set-new [:set T] item ...) and (typed-map-new [:map K V] k v ...) over literals are admitted as literals -- they are what a folded set or typed map is spelled as, and a def written that way folds nothing"
                :order "a computed def may read only the constants above it; a reference to a constant below it is refused by name, so the pool is built in declaration order and every fold sees resolved values"
                :quoted "`'datum` is data the author wrote, never a computation: the quote comes off and the datum is held to the literal rule; quoted data holding symbols -- `'#{if let}` (the compiler's own tables, 5 of its sources) and a quoted symbol `'name` (measured 2026-09-11: kotoba-native/string_index.cljk's `(def find-name 'kotoba$string-index-find)` was answered `constant alias must name a declared constant`, an alias lookup for a value the author quoted to keep a symbol) -- is refused `constant value is quoted data holding symbols: (quote ..) -- a symbol is not an admitted constant kind (integer/string/keyword/boolean/nil/vector/map/keyword-set); spell the entries as keywords`, checked BEFORE the literal rule so the bare symbol is never read as an alias; any other quoted non-literal keeps the closedness sentence"
                :string-bound "a string literal past the constant's portable byte bound is refused by the bound, not by closedness: `constant string exceeds the portable string byte limit: <n> bytes, at most 4096 -- a longer string is a value a function builds, or a file a capability reads` (measured 2026-09-11 on kotoba/abi/wit_data.cljk, a .wit file held in a def, which got the closedness sentence about a value that is closed)"
                :not-a-fold "a symbol that is not a constant and any other shape keep the closedness sentence: `constant value must be closed bounded integer/string/keyword/boolean/nil/vector/map or non-empty keyword-set data` (:kotoba.error/subset-reject)"}
        :refused-by-name
        {:stateful "(atom ...) (delay ...) (volatile! ...) (agent ...) (promise ...) (future ...) (cap-call ...) (typed-cap-call ...) at the head (`ref` is not here: `(ref name)` is the pure core's definition reference, and STM's `(ref x)` keeps its :kotoba.error/ambient-forbidden refusal through the probe): `def value is stateful/effectful: (<head> ...) -- move it into a function or a capability` -- a PROPERTY (module-level state / effects), :kotoba.error/def-value-stateful"
         :effect-row "a non-empty inferred effect row or named operation (a nested cap-call under a declared capability, local state): `def value of <name> is stateful/effectful: its effect row is #{...} -- a module-level constant must be effect-free; move it into a function or a capability`"
         :forward-reference "`def value of <name> refers to a later constant: <b> is defined after <name> -- a constant may read only the constants above it; reorder the definitions`"
         :recursion "`def value of <name> refers to itself: <name> -- a constant cannot be recursive; write the value out`"
         :module-function "`def value of <name> calls <f>, a function of this module -- a constant is evaluated before any function exists; compute it in a function or write the value out`"
         :loop "`def value of <name> contains a loop (__kotoba_loop_N): loop iterations are zero-charge on the reference interpreter, so the compile-time fuel cannot bound it -- write the value out or compute it in a function` -- measured 2026-09-11 before the refusal existed: an unbounded loop at a def ran PAST 100000 fuel without a trap (kotoba.kir T7.1 zero-charge self-tail re-entry); refused on the shape, bounded or not, because the count is what the interpreter cannot see"
         :handle "`def value of <name> evaluates through a heap handle (pair, ...): a closure, a list, a lazy sequence or a kgraph datom has no literal spelling and so cannot be a module constant -- compute it in a function` -- the number `execute` returns for these is an index into an arena that does not survive the probe, and spelling it as an integer would be a wrong answer that type-checks"
         :fuel "`def value of <name> exhausted the compile-time fuel (100000) -- a constant is evaluated once at analysis time; bound the computation or move it into a function` -- a backstop: every shape that would spend the fuel (a loop, a call to a module function, a closure) is refused by name before it runs"
         :trap "`def value of <name> trapped at compile time: <trap> -- the expression does not evaluate; fix it or move it into a function`"
         :unspellable "a closure, an option, a result, a variant, a nominal record, a list, a stream, a task, a document, bytes, a symbol: `def value of <name> evaluates to a <type>, which has no literal spelling and so cannot be a module constant -- compute it in a function`"
         :bounds "a result outside the constant bounds (the portable string byte limit, the item limits): `def value of <name> evaluates to a <type> that is outside the constant bounds (string byte limit, item limits) -- shorten it or compute it in a function`"
         :refusal-code :kotoba.error/def-value-not-constant}
        :spelling
        {:i64 :integer-literal :bool :boolean-literal :string :string-literal :keyword :keyword-literal :f64 :f64-literal
         :map "keyword keys, i64 values: the map literal"
         :vector-i64 :vector-literal
         [:set :keyword] :set-literal
         [:set :T] "(typed-set-new [:set T] item ...) sorted"
         [:map :K :V] "(typed-map-new [:map K V] k v ...) sorted by key"
         [:vector [:T ...]] :vector-literal
         [:record :kotoba.map-literal/keys :fields] "the keyword-keyed map literal it lowered from (see :sugar :map-literal :value-types :keyword-keys)"}
        :on-other-shape :refuse
        :measured "2026-09-11 on kotoba-sema, computed_constant_fold_test.cljk: the positives run to a value on the KIR interpreter through a function that reads the constant; (def k 4096) and (def k (* 4 1024)) analyse to equal HIR (the CID control); every refusal above is pinned by message"}
  ;; The module form, and the one clause added 2026-09-11: `(:params [sym ...])`.
  ;;
  ;; There is no type variable in this surface. A parameter is annotated with
  ;; a concrete value type or defaults to :i64, so a library generic over its
  ;; ELEMENT type (kotoba.set, twelve repositories mirroring clojure.set) had
  ;; no spelling -- measured 2026-09-11, `(defn f [s] (count s))` is refused
  ;; `count requires a bounded vector, a typed set or a canonical typed map;
  ;; got :i64`, and the same function annotated `[:set :i64]` is admitted.
  ;;
  ;; `:params` adds no typing to the language. A template module names its
  ;; parameters; an importer binds each to a concrete value type in the
  ;; require spec; amu's project linker instantiates the module ONCE PER
  ;; DISTINCT BINDING by textual substitution in type positions, before the
  ;; frontend reads it. The frontend never sees a parameter symbol. This is
  ;; the shape the linker already had for arity (`$arity$` clauses: one
  ;; lowered function per instantiation, one Definition CID each, the source
  ;; definition itself has none), so no identity decision moves.
  ;;
  ;; Measured before it was written, at amu b57284d6 with two instantiations
  ;; of kotoba.set.union at [:set :i64] and [:set :symbol] -- first as two
  ;; hand-written modules, then through this clause (amu PR #932): the two
  ;; wasm32-browser artifacts are BYTE-IDENTICAL (sha256 d5f18eca...), five
  ;; module functions mint five distinct CIDs, renaming the aliases moves no
  ;; CID, and `main` answers |{1 2} ∪ {2 3}| + |{x} ∪ {y}| = 5 when run.
  ;;
  ;; A bare symbol in a TYPE position outside a template stays refused
  ;; (frontend `validate-value-type!`), so a future type-variable spelling
  ;; remains open and no admitted program changes meaning.
  :ns {:shape "(ns NAME DOCSTRING? ATTR-MAP? CLAUSE ...)"
       :clauses {:export "(:export [sym ...]) -- exactly one, required in project mode"
                 :capabilities "(:capabilities #{:ns/kw ...}) -- at most one"
                 :schemas "(:schemas ...) -- at most one"
                 :require "(:require REQUIRE-SPEC ...) -- see :require-spec"
                 :params "(:params [sym ...]) -- at most one; declares this module a TEMPLATE"
                 :refer-clojure "(:refer-clojure :exclude [sym ...] | :only [sym ...]) -- at most one; a NO-OP, see :refer-clojure below"}
       ;; The ATTR-MAP is the position Clojure's `ns` already defines and
       ;; ignores, and it exists here for DUAL-RUNTIME source: a module that
       ;; must also load on nbb / Clojure cannot carry `(:export ...)` (SCI's
       ;; `ns` refuses it: "No matching clause: export"), and measured
       ;; 2026-09-11, 83 of the compiler's own 178 source files were refused
       ;; in project mode for that clause alone. Each key means exactly the
       ;; clause of the same name and is validated by the same code path (the
       ;; frontend rewrites the map into clauses before its clause loop).
       :attr-map {:position "after DOCSTRING?, before any CLAUSE; at most one"
                  :keys {:kotoba/export "(:export [...])"
                         :kotoba/capabilities "(:capabilities #{...})"
                         :kotoba/schemas "(:schemas {...})"
                         :kotoba/params "(:params [...]) -- project mode / linker only, as the clause is"}
                  :on-other-key :refuse
                  :on-other-key-note "a namespaced key nobody declared is not a comment; `{:author ...}` / `{:doc ...}` must not become an export, so the keys are namespaced and anything else is refused BY NAME"
                  :on-key-and-clause-both-present :refuse
                  :on-map-out-of-position :refuse
                  :refusal-codes {:other-key :kotoba.error/namespace-attr-map
                                  :out-of-position :kotoba.error/namespace-attr-map
                                  :declared-twice :kotoba.error/namespace-clause-duplicate}
                  :implemented-by "kotoba-sema kotoba.compiler.frontend/namespace-attr-map->clauses (public as kotoba.sema/namespace-attr-map->clauses); amu kotoba.compiler.project reads the same key table"}
       :params {:items :simple-unqualified-symbols
                :unique true
                :max-items 8
                :max-items-key [:admission-limits :max-template-parameters]
                :scope :type-positions-of-this-module
                :type-positions ["a keyword-headed vector, e.g. [:set elem]"
                                 "a defn parameter's type slot"
                                 "a defn result-type slot"
                                 "the :with values of this module's own :require specs (forwarding)"]
                :not-a-type-position "a value position: `(let [elem 7] ...)` binds a local named elem and is left alone"
                :instantiated-by "amu project linker, kotoba.compiler.project"
                :key [:namespace :binding]
                :dedupe "two importers with the same binding resolve to ONE instantiated module"}
       ;; `:refer-clojure` (2026-09-11): admitted as a NO-OP. On a Clojure
       ;; host `(:refer-clojure :exclude [..])` / `(:refer-clojure :only [..])`
       ;; only NARROWS what `ns` auto-refers from clojure.core; Kotoba refers
       ;; nothing from clojure.core, so the clause has no meaning and no
       ;; effect. Refusing it bought no safety and cost every dual-runtime
       ;; module that shadows a core name (measured 2026-09-11, project route:
       ;; 19 of the compiler's own 181 sources were refused for this clause
       ;; alone). IMPLEMENTATION STATE, not a property -- nothing in the
       ;; language changes when it is read -- so it is admitted, and a module
       ;; carrying it analyses identically to the same module without it
       ;; (same definition CIDs). `:rename` DOES change name resolution and
       ;; stays refused by name, as does any other option key.
       :refer-clojure {:shape "(:refer-clojure OPTION ...) where OPTION is :exclude [NAME ...] | :only [NAME ...], each at most once, either or both"
                       :examples ["(:refer-clojure :exclude [update])" "(:refer-clojure :only [inc])" "(:refer-clojure :exclude [read] :only [inc])"]
                       :meaning "none: a no-op on both routes; does not count toward the other clauses' limit"
                       :items :simple-unqualified-symbols
                       :max-items-key [:admission-limits :max-functions]
                       :on-rename :refuse
                       :on-rename-note "renaming clojure.core names changes name resolution; refused BY NAME, not as an unknown key"
                       :on-other-option-key :refuse
                       :on-non-symbol-entry :refuse
                       :on-second-clause :refuse
                       :refusal-codes {:rename :kotoba.error/namespace-refer-clojure-clause
                                       :other-option-key :kotoba.error/namespace-refer-clojure-clause
                                       :non-symbol-entry :kotoba.error/namespace-refer-clojure-clause
                                       :second-clause :kotoba.error/namespace-clause-duplicate
                                       :project-route :kotoba.error/project-link-failed}
                       :implemented-by "kotoba-sema kotoba.compiler.frontend/validate-refer-clojure-clauses! (single-module route: validated, then dropped before the clause loop); amu kotoba.compiler.project/module-info (project route: validated, then stripped with :require before the frontend reads the module)"}
       :on-other-shape :refuse
       :refusal-codes {:template-without-binding :kotoba.error/namespace-params-needs-instantiation
                       :unsubstituted-parameter :kotoba.error/project-link-failed
                       :other-clause :kotoba.error/project-link-failed}}
  ;; `:refer` (2026-09-11): a referred name is an alias-qualified name
  ;; spelled bare -- `[m :as a :refer [f]]` lets the module write `(f x)`
  ;; for `(a/f x)`, and `[m :refer [f]]` is the same with an alias the
  ;; author never sees. It is a SPELLING of the one resolution path, not a
  ;; second one: the linker rewrites every bare occurrence of a referred
  ;; name (a bound local still shadows it) into the qualified symbol before
  ;; anything else looks at the module, so stub, linked target, definition
  ;; CID and every downstream refusal are those of the qualified spelling
  ;; (measured: `amu definition-cids` mints the same CIDs for both). Admitted
  ;; because it is implementation state, not a property -- both hosts the
  ;; compiler's own sources load on already accept it -- so dual-runtime
  ;; source needs no change. `:refer :all` is refused: an open set is not a
  ;; declaration. The frontend never sees a `:require` clause on any route;
  ;; import resolution is the project linker's (`kotoba.compiler.project`).
  :require-spec {:shape "[NAMESPACE OPTION ...] where OPTION is :as ALIAS | :refer [NAME ...] | :with {PARAM TYPE ...}, each at most once, :as or :refer required"
                 :examples ["[m :as a]" "[m :refer [f g]]" "[m :as a :refer [f]]" "[m :as a :with {elem :i64}]"]
                 :namespace :simple-symbol
                 :on-string-namespace :refuse
                 :on-string-namespace-note "a string names a HOST module (node:fs, a JS package); refused by name as host interop"
                 :refer {:items :simple-unqualified-symbols
                         :unique true
                         :meaning "each NAME is (ALIAS/NAME) wherever it occurs bare and is not a bound local; the linker rewrites it before analysis"
                         :on-all :refuse
                         :on-name-not-exported-by-required-module :refuse
                         :on-name-defined-in-this-module :refuse
                         :on-name-referred-twice :refuse
                         :on-no-alias "a private alias is synthesised (kotoba_refer__<ns>); renaming an alias moves no CID"
                         :shadowing "a bound local (let / loop / fn / defn parameter / catch binder) shadows a referred name, as on both hosts"
                         :implemented-by "amu kotoba.compiler.project/rewrite-referred-symbols, check-referred-names!, check-referred-exports!"}
                 :with {:keys "every symbol the required module declares in (:params ...), each exactly once"
                        :values "a value type form the frontend admits (`validate-value-type!`)"
                        :on-non-template :refuse
                        :on-undeclared-or-missing-key :refuse}
                 :on-other-option-key :refuse
                 :on-other-shape :refuse
                 :refusal-codes {:not-alias-only :kotoba.error/project-link-failed
                                 :refer-all :kotoba.error/project-link-failed
                                 :refer-not-exported :kotoba.error/project-link-failed
                                 :refer-collision :kotoba.error/project-link-failed
                                 :string-namespace :kotoba.error/project-link-failed}}
  ;; Clause heads the `ns` form REFUSES BY NAME (2026-09-11), so a census of
  ;; refusals can tell host interop apart from a macro harness and from a
  ;; malformed admitted clause. None is admitted; none is a gap.
  ;; `:refer-clojure` left this set later the same day: with no clojure.core
  ;; to narrow, the clause is a no-op and is admitted as one (`:ns
  ;; :refer-clojure` above); only its `:rename` option is refused, by name.
  :ns-refused-clauses {:import "host interop (a Java / JS class) -- a property, not a gap"
                       :require-macros "macros are outside the language -- a property"
                       :use "an ambient unqualified namespace -- a property"
                       :load "run-time loading -- a property"
                       :gen-class "host interop -- a property"
                       :refusal "namespace clause <head> is not admitted: <reason>; the admitted clauses are :export, :capabilities, :schemas, :params and :require"
                       :refusal-codes {:project-route :kotoba.error/project-link-failed
                                       :single-module-route :kotoba.error/namespace-host-clause}}}

 ;; Heads whose SOURCE body is several forms, and what each one does with them.
 ;; Split by behaviour, because the two halves are different promises and a
 ;; reader who assumes one gets the other silently.
 :implicit-body-forms
 {:sequences #{let when when-not when-let}
  :refuses #{defn defn- fn loop try catch}
  :unmeasured #{when-some doseq dotimes}
  :not-body-taking #{if-let if-some}
  :note "`:sequences` collapse to `do`; `:refuses` take exactly one body expression and say so. Nothing truncates. Measured 2026-09-02: `let` was in neither set -- it accepted several forms and kept the first."
  ;; The first version of this entry put all nine heads in `:sequences`. Four
  ;; of them had not been measured, and writing the unmeasured ones next to
  ;; the measured ones is the same error this whole entry exists to record --
  ;; a claim that was never checked, sitting where a checked one belongs.
  ;;
  ;; `:sequences` is now only what was executed and compared to the expected
  ;; answer: `(when (> n 0) (+ n 10) (+ n 100))` and its `when-not` /
  ;; `when-let` twins each answered 105 on wasm32, and `let` answers 106.
  ;;
  ;; `:unmeasured` is not `:refuses`. `dotimes` and `doseq` compile with
  ;; several body forms, but their body's VALUE is discarded by construction,
  ;; so answering correctly does not show that the non-final forms ran -- the
  ;; measurement needs an observable effect and has not been made.
  ;; `when-some` was probed three times on 2026-09-02 and every probe was
  ;; refused for a reason about the probe (an `[:option T]` scrutinee this
  ;; author could not spell), never about the body.
  ;;
  ;; `:not-body-taking` is a separate correction: `if-let` and `if-some` take
  ;; a then and an else, each one expression. They were never candidates.
  :measurement {:as-of "2026-09-02"
                :method "amu compile --target wasm32 --jvm-free, artifact executed under Node WebAssembly, answer compared to the expected value"
                :sequences-evidence {let 106 when 105 when-not 105 when-let 105 do 105}}}

 ;; Surface sugar: admitted in source, must desugar before/during emit.
 :sugar
 {:bytes {:desugars-to "canonical bounded empty :bytes value"
          :level "L2" :backends #{:compiler :kotoba-wasm :kotoba-cljs}
          :note "zero arguments only; binary payloads otherwise enter through typed host/provider boundaries"}
  :-> {:desugars-to "nested calls with the value inserted after each call head"
       :level "L2" :backends #{:compiler :kotoba-wasm :kotoba-cljs}}
  :->> {:desugars-to "nested calls with the value inserted as each call's final argument"
        :level "L2" :backends #{:compiler :kotoba-wasm :kotoba-cljs}}
  :as-> {:desugars-to "sequential named let bindings"
         :level "L2" :backends #{:compiler :kotoba-wasm :kotoba-cljs}}
  :and {:desugars-to "nested let/if" :level "L2" :backends #{:kotoba-wasm :compiler}}
