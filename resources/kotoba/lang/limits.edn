  :why "The ADR's default traversal budget for an untrusted value (an entry argument, a capability result, a decoded value), replacing the per-value 64-node / depth-12 bounds that were re-checked on every internal value. Enforced since 2026-09-24 by P2 (reference interpreter) and P3 (ESM, cljs backend, browser Wasm host): one explicit-stack iterative walk per boundary crossing, named traps :budget/boundary-nodes and :budget/boundary-bytes. A caller may name its own budget per run (osaho execute :boundary-budget)."
  :traversal-nodes {:value 65536 :why "Nodes one boundary validation may visit, counted by an explicit-stack iterative walk."
                    :copies [{:repo "kotoba-lang/osaho" :path "src/kotoba/kir/value.cljk" :var kotoba.kir.value/boundary-traversal-node-limit}
                             {:repo "kotoba-lang/kotoba-script" :path "src/kotoba/script.cljk" :var kotoba.script/boundary-traversal-nodes}
                             {:repo "kotoba-lang/amu" :path "runtime/browser-host.mjs" :pattern "const BOUNDARY_TRAVERSAL_NODES = (\\d+);"}
                             {:repo "kotoba-lang/amu" :path "src/kotoba/compiler/backend/cljs.cljk" :pattern "\\(when \\(> nodes (\\d+)\\)"}]}
  :traversal-bytes {:value 1048576 :why "Payload bytes (1 MiB of string / keyword / bytes leaves) one boundary validation may read. It was osaho's canonical-indirect-byte-limit, a per-value aggregate, before P2."
                    :copies [{:repo "kotoba-lang/osaho" :path "src/kotoba/kir/value.cljk" :var kotoba.kir.value/boundary-traversal-byte-limit}
                             {:repo "kotoba-lang/kotoba-script" :path "src/kotoba/script.cljk" :var kotoba.script/boundary-traversal-bytes}
                             {:repo "kotoba-lang/amu" :path "runtime/browser-host.mjs" :pattern "const BOUNDARY_TRAVERSAL_BYTES = (\\d+);"}
                             {:repo "kotoba-lang/amu" :path "src/kotoba/compiler/backend/cljs.cljk" :pattern "\\(when \\(> bytes (\\d+)\\)"}]}}

