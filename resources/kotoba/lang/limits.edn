 ;; ---------------------------------------------------------------------
 ;; Per-target resource budgets. CURRENT effective defaults, recorded as
 ;; data (2026-09-24). P4 unifies them into four budgets -- fuel, cells,
 ;; bytes, frames -- with per-run overrides and named traps (:budget/fuel,
 ;; ...); until then each target's knobs are listed under the name the
 ;; target itself uses. `:fuel :unit` says what one unit of fuel counts:
 ;; the ADR's point 4 is that today there are three units.
 ;; ---------------------------------------------------------------------
 :profile/reference
 {:why "osaho's KIR interpreter: the oracle every target is compared against at compile time."
  :fuel {:unit :function-entry
         :default {:value 512 :copies [{:repo "kotoba-lang/osaho" :path "src/kotoba/kir.cljk" :var kotoba.kir/default-fuel}]}
         :max {:value 9007199254740991 :why "2^53-1: the last budget from which every decrement to zero is exact on a JS Number."
               :copies [{:repo "kotoba-lang/osaho" :path "src/kotoba/kir.cljk" :var kotoba.kir/max-fuel}
                        {:repo "kotoba-lang/kotoba-verifier" :path "src/kotoba/verifier.cljk" :var kotoba.verifier/max-native-fuel}]}}
  :cells nil :bytes nil
  :frames {:value nil :why "Host stack; exhausting it traps :fuel-exhausted with :host-stack-exhausted true today (the misnamed trap the ADR records). P2 adds a named frames budget."}}

 :profile/native
 {:why "A binary this machine runs (kexe loader / aiueos). The loader sandbox is defence in depth, not a language requirement. Every budget below is a per-run DEFAULT a caller may override through the named environment variable or bake into a packaged command."
  :fuel {:unit :function-entry
         :default {:value 512 :override "KEXE_FUEL" :copies [{:repo "kotoba-lang/amu" :path "tools/kexe_loader.c" :pattern "static uint64_t kexe_initial_fuel = (\\d+);"}]}
         :max {:value 9007199254740991
               :why "Same 2^53-1 as the reference interpreter. The loader checked only > 0 until 2026-09-24 (P1 added the ceiling)."
               :copies [{:repo "kotoba-lang/amu" :path "tools/kexe_loader.c" :pattern "#define KEXE_FUEL_MAX (\\d+)ull"}]}}
  :cells {:pair-arena {:value 4096 :override "KEXE_PAIRS" :copies [{:repo "kotoba-lang/amu" :path "tools/kexe_loader.c" :pattern "#define KEXE_PAIR_CAPACITY (\\d+)u"}]}
          :pair-arena-max {:value 67108864 :why "64 Mi handles: address space, not memory."}
          :vectors {:value 4096 :copies [{:repo "kotoba-lang/amu" :path "tools/kexe_loader.c" :pattern "#define KEXE_VECTOR_CAPACITY (\\d+)u"}]}
          :vector-items {:value 65536 :why "The item arena per run; a vector can never be longer than the run was packaged to hold." :copies [{:repo "kotoba-lang/amu" :path "tools/kexe_loader.c" :pattern "#define KEXE_VECTOR_ITEM_CAPACITY (\\d+)u"}]}}
  :bytes {:string-pool {:value 65536 :override "KEXE_STRING_POOL" :copies [{:repo "kotoba-lang/amu" :path "tools/kexe_loader.c" :pattern "#define KEXE_STRING_POOL_BYTES (\\d+)u"}]}
          :string-pool-max {:value 1073741824 :why "1 GiB of address space."}}
  :frames {:arena-scope-depth {:value 256 :copies [{:repo "kotoba-lang/amu" :path "tools/kexe_loader.c" :pattern "#define KEXE_ARENA_SCOPE_DEPTH (\\d+)u"}]}}
  :emergency-stop {:why "Outside the semantics: an OS bound on the child, not a language budget."
                   :cpu-seconds {:value 1 :override "KEXE_CPU_SECONDS"}
                   :wall-seconds {:value 3 :override "KEXE_WALL_SECONDS"}}}

 :profile/wasm
 {:why "An untrusted guest on a shared host (browser / Worker / WASI). Deterministic fuel is recommended."
