 ;; Source-size and program-size bounds are NOT restated here: they already
 ;; have one authority, lang/guest-grammar.edn :admission-limits (max-functions,
 ;; max-parameters, max-bindings, max-symbol-chars, max-expression-nodes,
 ;; max-list-items, max-set-items, max-source-bytes, max-reader-depth,
 ;; max-template-parameters). This names it and its copies instead of copying
 ;; its numbers; the agreement test reads the grammar for the values.
 :language/admission
 {:authority "lang/guest-grammar.edn"
  :key :admission-limits
  :why "Compile-time bounds on the source a module may be: checked once by the frontend, never at run time."
  :copies {:max-functions [{:repo "kotoba-lang/kotoba-sema" :var kotoba.compiler.frontend/max-functions}
                           {:repo "kotoba-lang/kotoba-verifier" :var kotoba.verifier/max-functions}]
           :max-parameters [{:repo "kotoba-lang/kotoba-sema" :var kotoba.compiler.frontend/max-parameters}
                            {:repo "kotoba-lang/kotoba-verifier" :var kotoba.verifier/max-parameters}]
           :max-bindings [{:repo "kotoba-lang/kotoba-sema" :var kotoba.compiler.frontend/max-bindings}
                          {:repo "kotoba-lang/kotoba-verifier" :var kotoba.verifier/max-bindings}]
           :max-symbol-chars [{:repo "kotoba-lang/kotoba-sema" :var kotoba.compiler.frontend/max-symbol-chars}
                              {:repo "kotoba-lang/kotoba-verifier" :var kotoba.verifier/max-symbol-chars}]
           :max-expression-nodes [{:repo "kotoba-lang/kotoba-sema" :var kotoba.compiler.frontend/max-expression-nodes}
