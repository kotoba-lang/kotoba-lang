           :max-reader-depth [{:repo "kotoba-lang/kotoba-sema" :var kotoba.compiler.frontend/max-reader-depth}]}}

 ;; ---------------------------------------------------------------------
 ;; Validating a value that arrives from outside (decode, host input,
 ;; capability result), once, at its boundary.
 ;; ---------------------------------------------------------------------
 :language/boundary
 {:status :target-default
  :why "The ADR's default traversal budget for an untrusted value, replacing the per-value 64-node / depth-12 bounds on internal values. RECORDED, NOT YET ENFORCED: P2 (reference interpreter) and P3 (ESM / cljs / Wasm hosts) implement it; a capability contract or export may name its own budget."
  :traversal-nodes {:value 65536 :why "Nodes one boundary decode may visit, counted by an explicit-stack iterative walk." :copies []}
  :traversal-bytes {:value 1048576 :why "Bytes (1 MiB) one boundary decode may read." :copies []}}

