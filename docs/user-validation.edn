{:kotoba.docs.user-validation/version 1
 :protocol
 {:participant-classes #{:external-user :agent-proxy :maintainer}
  :external-completion-requires
  {:minimum-participants 3
   :required-participant-class :external-user
   :required-task-pass-rate 0.8
   :required-tasks #{:install :first-run :capability-denial :error-recovery}}
  :tasks
  [{:id :install
    :prompt "Install a published Kotoba release from the documentation and verify the binary."
    :success "The participant runs kotoba --help without repository knowledge or an unverified download."}
   {:id :first-run
    :prompt "Compile and run the documented first expression and module."
    :success "The participant obtains the documented result and can identify the selected target."}
   {:id :capability-denial
    :prompt "Compile a capability-using module without a grant, then admit it with a least-authority policy."
    :success "The first attempt is denied with a stable code and the second succeeds without wildcard scope."}
   {:id :error-recovery
    :prompt "Recover from one syntax, type, or compatibility diagnostic using the reference."
    :success "The participant finds the diagnostic by code and fixes the input without source inspection."}]}

 :automation
 {:status :implemented
  :checks #{:generated-reference :embedded-search :keyboard-labels
            :broken-links :negative-fixture}}

 :observations []
 :external-gate
 {:status :pending
  :code :docs/external-validation-pending
  :reason "No external-user observations are recorded. Automated and agent-proxy checks cannot satisfy D6."}}
