;; docs/kotoba-lisp-machine-boundary.draft.edn — Kotoba Lisp machine の境界の形（boundary encoding）の草案。
;; Status: :proposed。正本ではない。設計の本文は docs/kotoba-lisp-machine-design.ja.md §4。
;; 正本の置き場は owner 決定待ち（本文 §4.5）。この草案は reader で読めることだけを保証する。
;; 判断・検査・実行はこの契約に含めない（境界の形は judgment-free）。

{:schema :kotoba.lisp-machine/boundary-draft-v1
 :status :proposed
 :date "2026-10-21"
 :document "docs/kotoba-lisp-machine-design.ja.md"
 :basis ["kototama/spec/kototama-vm-v1.edn"
         "aiueos: C marshals, Kotoba judges（ADR-0219 flat record、base + length）"
         "amu ADR 0065 / 0068 / 0070 / 0076（Canonical ABI layout、boundary で marshal）"
         "root ADR-2610082200（糸・布・機・紋）"
         "root ADR-2608038000（inga） / ADR-2610092330（awai L1 charter）"]

 :definition
 {:statement "境界の形（boundary encoding）は判断を持たない符号化である。pack / unpack / 長さ / 順序だけを扱い、valid か・許可されるか・走るかを決めない。"
  :not [:validation :authorization :execution :state-machine :policy]
  :judgment-owners [:rule-form :grant :authority]}

 :rules
 [{:id :judgment-free
   :rule "境界の形は述語・policy・capability 判定を含まない。含んだ時点で rule Form か grant の仕事に移す。"}
  {:id :unknown-shape-fail-closed
   :rule "未知の tag / shape / profile は拒否して記録する。読み飛ばさない。「飛ばした」と「合格した」を出力で区別する。"
   :like [:kototama.vm/unknown-effect-deny :kototama.vm/missing-origin-deny]}
  {:id :canonical-bytes-before-cid
   :rule "書き込みは canonical bytes を作ってから CID を付ける。読み込みは CID 検証後に decode する。"
   :like [:kototama.vm/write-canonical-bytes-before-cid :kototama.vm/read-verify-cid-before-decode]}
  {:id :versioned-wire-keys-preserved
   :rule "境界の形の spec は content-addressed。versioned migration まで既存の wire key / CID 規則を変えない。"}
  {:id :no-secrets
   :rule "raw bearer・秘密鍵・ambient host handle を境界符号化に載せない。discovery / receipt に secret を載せない。"
   :like [:kototama.vm/receipt-forbidden]}
  {:id :host-object-transparent
   :rule "host object は越えない。境界の形が host を呼ぶ回数は fuel / 仕事量に数える。"
   :like [:kototama.vm/host-object-false]}]

 :domains
 {:kernel-object {:carry "flat record" :shape "base + length、offset read"
                  :current ["aiueos ADR-0219" ".kotoba ヘッダ comment が layout の正本"]
                  :judgment "Kotoba object / grant"
                  :implementation "aiueos の packer（kernel profile の実装）"}
  :host-guest {:carry "typed import / export" :shape "lift / lower の Canonical ABI layout"
               :current ["amu ADR 0065 / 0068 / 0070 / 0076" "abi.component profile"]
               :judgment "host admission / authority"
               :implementation "amu lower / lift"}
  :value-wire {:carry ["value" "message" "receipt"] :shape :tagged-dag-cbor-vector
               :current ["kototama :canonical-form / :values / :message / :receipt"]
               :judgment :none
               :implementation "kotoba-protocol codec"}
  :cell-cell {:carry ["action" "op" "remote call"] :shape "署名 action + op"
              :current ["root ADR-2610082200（糸・布）" "kotoba-protocol planes"]
              :judgment "rule Form（validation） / grant"
              :implementation "kotoba-protocol / 機"}
  :domain-domain {:carry ["ordered write" "settlement"] :shape "message + receipt"
                  :current ["inga（ADR-2608038000）" "awai L1（ADR-2610092330）" "EVM adapter"]
                  :judgment "inga QC / 各 domain の規則"
                  :implementation "inga / settlement adapter"}}

 :owners-proposed
 {:descriptor "kotoba-core-contracts（kotoba.core.execution の隣）"
  :profile-layout "abi（Component profile は既存 Canonical ABI と連続）"
  :wire-codec "kotoba-protocol"
  :kernel-profile-implementation "aiueos packer"
  :host-guest-implementation "amu lower / lift"
  :note "新規 repo は作らない（target-neutral の方針）。独立 consumer と release 境界の確認まで新規 repo / 一括改名をしない。"}

 :non-claims
 ["実装・qualification の完了を意味しない。"
  "Holochain / EVM / awai chain との wire 互換を主張しない。"
  "image / 対話環境 / live redefinition の実装を主張しない（設計は本文 §5）。"
  "awai chain の段階（S0）を上げない。"]}
