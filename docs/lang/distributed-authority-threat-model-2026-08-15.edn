{:kotoba.security-review/version 1
 :scope
 [:captp-session :ocapn-third-party-handoff :incidence-replication
  :inga-total-order :did-vc-ucan-admission :tls-netlayer]
 :assets
 [:lexical-capability :organization-dataspace :identity-key
  :ordered-incidence-cid :durability-receipt]
 :trust-boundaries
 [{:boundary :edn-syrup-data-to-authority
   :rule "data never reconstructs authority; admission needs a live capability"}
  {:boundary :network-to-session
   :rule "both location signatures and the closed transcript result verify first"}
  {:boundary :replication-to-order
   :rule "set union remains replication; only a bound Inga QC mints ordered commit"}
  {:boundary :bundle-to-durable-store
   :rule "whole bundle validates before append and target append authority is rechecked"}]
 :threats
 [{:id :T01 :name :ambient-authority
   :mitigation [:opaque-runtime-values :lexical-injection :closed-host-abi]}
  {:id :T02 :name :session-key-or-location-forgery
   :mitigation [:ed25519-location-signature :session-id-key-binding
                :one-active-session-per-peer]}
  {:id :T03 :name :handoff-replay-or-confused-deputy
   :mitigation [:session-and-side-binding :gift-id-tombstone
                :handoff-count-tombstone :one-pending-waiter]}
  {:id :T04 :name :future-deposit-race
   :mitigation [:atomic-reservation :validate-before-reserve
                :callback-cannot-roll-back-commit]}
  {:id :T05 :name :fake-consensus-certificate
   :mitigation [:canonical-inga-block-hash :admitted-validator-set
                :distinct-witness-quorum :per-vote-signature
                :height-parent-entry-order-binding]}
  {:id :T06 :name :storage-forgery-or-partial-transfer
   :mitigation [:cid-filename-readback :fsync-atomic-move
                :whole-bundle-validation :bounded-input]}
  {:id :T07 :name :certificate-rotation-downgrade
   :mitigation [:explicit-overlap-pin-set :hostname-verification
                :retired-pin-rejection]}
  {:id :T08 :name :identity-or-delegation-revocation-bypass
   :mitigation [:did-resolution :vc-data-integrity
                :bitstring-status-list :ucan-proof-chain]}]
 :negative-evidence
 [{:case :forged-handoff-signature :expected :handoff/give-signature-invalid}
  {:case :gift-redeposit :expected :handoff/gift-replay}
  {:case :handoff-count-reuse :expected :handoff/count-replay}
  {:case :qc-envelope-tamper :expected :consensus/verification-invalid}
  {:case :unadmitted-validator :expected :consensus/verification-invalid}
  {:case :forged-bundle-entry :expected :incidence-store/bundle-invalid}
  {:case :retired-tls-pin :expected :tls-channel/peer-pin-mismatch}]
 :independent-review
 {:status :requested-not-completed
  :reviewer-requirements
  [:not-an-author-of-this-change :ocapn-or-ocap-experience
   :distributed-systems-and-cryptography]
  :review-checklist
  [:canonicalization-differentials :replay-races :key-compromise-and-rotation
   :quorum-set-confusion :crash-consistency :denial-of-service-bounds]
  :evidence-entrypoints
  ["docs/lang/ocapn-interop-2026-08-15.edn"
   "src/kotoba/lang/captp_runtime.cljc"
   "src/kotoba/lang/ocapn_handoff.cljc"
   "src/kotoba/lang/consensus_order.cljc"]}
 :claim-boundary
 "Implemented and self-tested is not an independent audit; production assurance remains gated until an external reviewer signs a report."}
