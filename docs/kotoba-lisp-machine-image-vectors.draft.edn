{:schema :kotoba.lisp-machine/image-vectors-draft-v1
 :status :proposed
 :date "2026-10-21"
 :adr "docs/adr/ADR-kotoba-lisp-machine-contract-decisions.md"
 :image-shape {:world-root :cid
               :code-environment :defcid-binding-map
               :open-leases :lease-receipt-chain}
 :digests {:status :measured
            :fixture "lang/lisp-machine-image-vectors.edn"
            :generated-by "scripts/gen_image_vectors_fixtures.cljk"
            :checked-by "test/kotoba/lang/lisp_machine_image_vectors_test.cljk"
            :codec :dag-cbor :multihash :sha2-256 :canonical-form :tagged-dag-cbor-vector}
 :note "ケースの骨格。計測済み digest は lang/lisp-machine-image-vectors.edn（生成物・CI で再計算検査）。この草案側には hash を書かない。"

 :cases
 [{:id :save-canonical-deterministic
   :kind :positive
   :rule :canonical-bytes-before-cid
   :input "同一の image 三つ組（world root × code environment × open leases）を 2 回 encode"
   :expected "canonical bytes が byte-identical、1 つの CID に一致"}
  {:id :restore-roundtrip
   :kind :positive
   :rule :verify-cid-before-decode
   :input "restore(save(image))"
   :expected "元の三つ組に一致。world root / 束縛 / lease 連鎖のいずれも欠落しない"}
  {:id :restore-unresolved-dependency
   :kind :negative
   :rule :unknown-shape-fail-closed
   :input "存在しない CID を参照する image"
   :expected {:outcome :unresolved
              :missing "不足している CID の列"
              :note "valid / invalid / unresolved の 3 値（root ADR-2610082200）。0 件を clean と読まない"}}
  {:id :restore-unknown-shape
   :kind :negative
   :rule :unknown-shape-fail-closed
   :input "未知の tag / shape を含む image bytes"
   :expected "fail closed で拒否して記録。読み飛ばさない"}
  {:id :restore-does-not-revive-authority
   :kind :negative
   :rule :no-secrets
   :input "失効した lease を open leases に含む image を restore し、その lease で effect を試みる"
   :expected "restore は権限を復活させない。effect は失効として拒否される（再 authorization か拒否）"}
  {:id :restore-verify-cid-before-decode
   :kind :negative
   :rule :canonical-bytes-before-cid
   :input "宣言 CID と bytes が一致しない image"
   :expected "CID 検証の段階で拒否。decode しない"}
  {:id :rebind-changes-image-cid
   :kind :positive
   :rule :versioned-wire-keys-preserved
   :input "rebind(env-slot, old DefCID, new DefCID) 後の image（ADR D4）"
   :expected "image CID は変わる。running な継続の実行中 DefCID は変わらない"}
  {:id :save-carries-no-secrets
   :kind :negative
   :rule :no-secrets
   :input "raw bearer / 秘密鍵 / ambient host handle を含む image 三つ組"
   :expected "encode を拒否（kototama :receipt :forbidden と同じ姿勢）"}]}
